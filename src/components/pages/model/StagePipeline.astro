---
import Icon from '../../system/Icon.astro';
import { STAGE_GROUPS } from './stagePipeline';

/**
 * TalentLEAP stage pipeline (WP17, item 13; WP24c grouping): the path a learner takes, drawn as five connected steps (Assess, Learn,
 * Prepare for Certification, Earn, Prosper) inside the three TalentLEAP stages they belong to (Learn, Earn, Prosper). The three Learn
 * steps share one "Learn" container whose stage label is its eyebrow; each card carries only its step name and text. Plain HTML and CSS in a
 * nested ordered list: it works without JavaScript, reads in order for assistive technology (each step names its stage in text, the
 * connectors are decorative), reflows to a vertical pipeline on phones and prints. The step wording restates the TalentLEAP page's own
 * steps; it carries no figure. The exam fee is stated here once ("exam fee included").
 * WP50 (cycle-25 review): the steps live in ./stagePipeline.ts, which the TalentLEAP page's structured data reads too; the last one ends "Further TalentLEAP levels are planned."
 */
interface Props {
  /** Heading level of the visible title (default 3). */
  level?: 2 | 3;
  title?: string;
  id?: string;
}
const { level = 3, title = 'The TalentLEAP Stage Pipeline', id = 'stage-pipeline' } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
// The steps are in ./stagePipeline.ts (WP50: one source for this pipeline and the TalentLEAP page's structured data).
const groups = STAGE_GROUPS;
let n = 0;
---

<figure class="sp" aria-labelledby={`${id}-h`}>
  <H class="sp__title t-heading-xl" id={`${id}-h`}>{title}</H>
  <ol class="sp__list" role="list">
    {
      groups.map((g) => (
        <li class:list={['sp__group', `sp__group--${g.stage.toLowerCase()}`]}>
          <p class="sp__stage">{g.stage}</p>
          <ol class="sp__steps" role="list">
            {g.steps.map((s) => {
              n += 1;
              return (
                <li class="sp__step">
                  <span class="sp__icon" aria-hidden="true"><Icon name={s.icon} size={26} strokeWidth={1.5} /></span>
                  <p class="sr-only">Step {n}, TalentLEAP stage {g.stage}</p>
                  <h4 class="sp__name">{s.name}</h4>
                  <p class="sp__text">{s.text}</p>
                </li>
              );
            })}
          </ol>
        </li>
      ))
    }
  </ol>
  <figcaption class="sp__caption">Assess, Learn and Prepare for Certification make up the Learn stage; Earn and Prosper follow.</figcaption>
</figure>

<style>
  .sp {
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }
  .sp__title {
    margin: 0;
    color: var(--secondary);
  }
  .sp__list,
  .sp__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: minmax(0, 1fr);
  }
  /* One container per TalentLEAP stage; its label is the eyebrow of the cards inside */
  .sp__group {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    padding: var(--space-sm) var(--space-sm) var(--space-sm);
    border-radius: var(--radius-default);
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
  }
  .sp__group > * {
    margin: 0;
  }
  .sp__stage {
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--on-primary-container);
    padding-inline: var(--space-xs);
  }
  .sp__step {
    position: relative;
    padding: var(--space-gutter);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--stack-title);
  }
  .sp__step > * {
    margin: 0;
  }
  .sp__icon {
    color: var(--primary);
    display: inline-flex;
  }
  .sp__name {
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    color: var(--secondary);
  }
  .sp__text {
    color: var(--on-surface-variant);
  }
  .sp__caption {
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
  @media (min-width: 1024px) {
    .sp__list {
      grid-template-columns: 3fr 1fr 1fr;
      align-items: stretch;
    }
    .sp__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      height: 100%;
    }
    .sp__group:not(.sp__group--learn) .sp__steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .sp__step {
      height: 100%;
    }
  }
</style>
