---
import Icon from '../../system/Icon.astro';

/**
 * TalentLEAP stage pipeline (WP17, item 13): the path a learner takes, drawn as five connected stages (Assess, Learn, Prepare for
 * Certification, Earn, Prosper) under the three TalentLEAP stages they belong to (Learn, Earn, Prosper). Plain HTML and CSS in an ordered
 * list: it works without JavaScript, reads in order for assistive technology (each step names its stage in text, the connectors and group
 * bars are decorative), reflows to a vertical pipeline on phones and prints. The step wording restates the TalentLEAP page's own steps;
 * it carries no figure.
 */
interface Props {
  /** Heading level of the visible title (default 3). */
  level?: 2 | 3;
  title?: string;
  /** Hide the visible title (the caller's heading names it). */
  id?: string;
}
const { level = 3, title = 'The TalentLEAP Stage Pipeline', id = 'stage-pipeline' } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const stages = [
  { group: 'Learn', name: 'Assess', icon: 'clipboard-check', text: 'A readiness assessment routes each applicant to a career or foundation track.' },
  { group: 'Learn', name: 'Learn', icon: 'graduation-cap', text: 'Skill units on a track set from employer demand, with hands-on labs.' },
  { group: 'Learn', name: 'Prepare for Certification', icon: 'award', text: 'Certification exam preparation, exam fee included.' },
  { group: 'Earn', name: 'Earn', icon: 'briefcase', text: 'Milestone-based mentoring and placement support toward the track’s work-entry goal.' },
  { group: 'Prosper', name: 'Prosper', icon: 'trending-up', text: 'Career paths, continuing development and the alumni network. Progressive levels are planned beyond the first published level.' },
];
---

<figure class="sp" aria-labelledby={`${id}-h`}>
  <H class="sp__title t-heading-xl" id={`${id}-h`}>{title}</H>
  <div class="sp__groups" aria-hidden="true">
    <span class="sp__group sp__group--learn">Learn</span>
    <span class="sp__group sp__group--earn">Earn</span>
    <span class="sp__group sp__group--prosper">Prosper</span>
  </div>
  <ol class="sp__list" role="list">
    {
      stages.map((s, i) => (
        <li class:list={['sp__step', `sp__step--${s.group.toLowerCase()}`]}>
          <span class="sp__icon" aria-hidden="true"><Icon name={s.icon} size={26} strokeWidth={1.5} /></span>
          <p class="sp__stage"><span class="sr-only">Step {i + 1}, TalentLEAP stage </span>{s.group}</p>
          <h4 class="sp__name">{s.name}</h4>
          <p class="sp__text">{s.text}</p>
          {i < stages.length - 1 && <span class="sp__arrow" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>}
        </li>
      ))
    }
  </ol>
  <figcaption class="sp__caption">Assess, Learn and Prepare for Certification make up the Learn stage; Earn and Prosper follow.</figcaption>
</figure>

<style>
  .sp {
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }
  .sp__title {
    margin: 0;
    color: var(--secondary);
  }
  .sp__groups {
    display: none;
  }
  .sp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  .sp__step {
    position: relative;
    padding: var(--space-gutter);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-top: 4px solid var(--secondary);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .sp__step--earn {
    border-top-color: var(--primary);
  }
  .sp__step--prosper {
    border-top-color: var(--tertiary);
  }
  .sp__step > * {
    margin: 0;
  }
  .sp__icon {
    color: var(--primary);
    display: inline-flex;
  }
  .sp__stage {
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--on-primary-container);
  }
  .sp__name {
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    color: var(--secondary);
  }
  .sp__text {
    color: var(--on-surface-variant);
  }
  /* The connector points to the next step: down on phones, across on the desktop. */
  .sp__arrow {
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-md) * -1 - 10px);
    transform: translateX(-50%) rotate(90deg);
    width: 20px;
    height: 20px;
    color: var(--primary);
    display: inline-flex;
  }
  .sp__caption {
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
  @media (min-width: 1024px) {
    .sp__groups {
      display: grid;
      grid-template-columns: 3fr 1fr 1fr;
      gap: var(--space-md);
    }
    .sp__group {
      padding: 6px var(--space-md);
      border-radius: var(--radius-pill);
      font-weight: var(--fw-bold);
      text-align: center;
      color: var(--on-secondary);
      background: var(--secondary);
    }
    .sp__group--earn {
      background: var(--primary);
      color: var(--on-primary);
    }
    .sp__group--prosper {
      background: var(--tertiary-container);
      color: var(--on-tertiary-container);
    }
    .sp__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .sp__arrow {
      left: auto;
      right: calc(var(--space-md) * -1 - 10px);
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
  }
</style>
