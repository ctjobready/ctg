---
import CertNote from '../../ui/CertNote.astro';

/**
 * TalentLEAP example: the Digital Marketing career path (IN-08). The competency levels
 * Competent → Proficient → Expert are named only on this page, as this career-path example. Only the published Level 1 is drawn;
 * WP122: the "Proficient and Expert levels are planned." card and arrow are gone (the page's opening says it once).
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<figure class:list={['lv', className]} data-fact="IN-08 IN-06">
  <ol class="lv__list" role="list">
    <li class="lv__item lv__item--first" data-reveal>
      <p class="eyebrow">Level 1 · Competent</p>
      <h3 class="lv__title">Introduction to Digital Marketing with Google and Meta Certifications</h3>
      <ul class="lv__bullets">
        <li>Three months of mentorship by an experienced professional</li>
        <li>Three months of membership in a digital-marketing expertise community</li>
        <li>Bonus mini-courses in essential business and leadership skills</li>
      </ul>
    </li>
  </ol>
  <CertNote />
  <figcaption class="lv__cap">Example only: the Digital Marketing career path.</figcaption>
</figure>

<style>
  .lv {
    margin: 0;
  }
  .lv__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  .lv__item {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    padding: var(--space-gutter);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
  }
  .lv__item--first {
    border-color: var(--primary);
  }
  .lv__item > :global(*) {
    margin: 0;
  }
  .lv__title {
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    color: var(--ctx-heading);
  }
  .lv__bullets {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-xs);
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
  }
  .lv__bullets li::marker {
    color: var(--primary);
  }
  .lv__cap {
    margin-top: var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--outline);
  }
</style>
