---
import FootnoteMarker from '../../facts/FootnoteMarker.astro';

/**
 * Renders a shared copy block (src/data/copy.ts) verbatim with the footnote markers of its facts and
 * `data-fact` for the status gate. Pages never retype these blocks.
 */
interface Props {
  block: { text: string; facts: string[] };
  as?: 'p' | 'div' | 'span';
  class?: string;
}
const { block, as: Tag = 'p', class: className } = Astro.props;
---

<Tag class={className} data-fact={block.facts.join(' ')}>{block.text}{block.facts.map((id) => <FootnoteMarker id={id} />)}</Tag>
