---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';

/**
 * Contracting and Accountability (WP17, item 10): the arrangements a procurement or due-diligence reader looks for, in one panel at the top of
 * /about/governance/ and linked from the partner pages (<InShort>): who contracts, who leads, how safeguarding and data are handled, how
 * outcome records are used, the due-diligence checklist and how to ask. Every statement restates the governance page's own sections
 * (the register facts ID-07, PD-12, PD-13, PD-08 and PD-09); no document is promised as ready.
 */
interface Props {
  /** The due-diligence request route (mailto), a text link here: the page's primary button is in its hero. */
  requestHref: string;
  requestLabel: string;
  id?: string;
}
const { requestHref, requestLabel, id = 'contracting' } = Astro.props;
const items = [
  { icon: 'building-2', title: 'Contracting Entities', text: 'CT USA, Inc. in the United States or CodersTrust Bangladesh Ltd. in Bangladesh. The entity that contracts depends on the program’s country and the funder’s requirements.', ids: 'ID-07 PD-13' },
  { icon: 'users', title: 'Leadership', text: 'The Chairman, Aziz Ahmad, and the CEO of CodersTrust Bangladesh, Md. Shamsul Haque, lead the organization.', ids: 'ID-03', link: { label: 'Who Leads CodersTrust', href: '#leadership' } },
  { icon: 'shield', title: 'Safeguarding and Data', text: 'Consent, protected records, grievance handling and referral pathways are agreed and documented for each program before enrollment.', ids: 'PD-12', link: { label: 'How People Are Protected', href: '#safeguarding' } },
  { icon: 'file-check', title: 'How Outcome Records Are Used', text: 'Tracer results are checked against documentary evidence where available. As agreed in the program scope, funders receive privacy-appropriate data and monthly reports.', ids: 'PD-08 PD-09 PD-12', link: { label: 'How Results Are Evidenced', href: '#anti-fraud' } },
  { icon: 'clipboard-list', title: 'Due-Diligence Checklist', text: 'The items we confirm with you in co-design, from the contracting entity to sanctions screening.', ids: 'PD-13', link: { label: 'See the Checklist', href: '#checklist' } },
  { icon: 'mail', title: 'How to Ask', text: 'Send the program or grant you are considering and the documents you need; we reply with what can be shared.', ids: 'PD-13', link: { label: requestLabel, href: requestHref, external: true } },
];
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="For Procurement and Due Diligence" title="Contracting and Accountability" lead="The arrangements funders ask about, in one place." />
  <ul class="cp" role="list">
    {
      items.map((it) => (
        <li class="cp__item" data-fact={it.ids} data-reveal>
          <Icon name={it.icon} size={28} strokeWidth={1.5} class="cp__icon" />
          <h3 class="cp__title t-heading-m">{it.title}</h3>
          <p class="cp__text">{it.text}</p>
          {it.link && (
            <a class="link cp__link" href={it.link.external ? it.link.href : it.link.href}>
              {it.link.label}
              <Icon name="arrow-right" size={16} />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .cp {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .cp {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .cp {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cp__item {
    padding: var(--space-gutter);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .cp__item > * {
    margin: 0;
  }
  .cp__item :global(.cp__icon) {
    color: var(--primary);
  }
  .cp__title {
    color: var(--secondary);
  }
  .cp__text {
    color: var(--on-surface-variant);
    flex: 1;
  }
  .cp__link {
    margin-top: var(--space-xs);
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding-block: 3px;
  }
</style>
