---
import Section from '../../ui/Section.astro';

/**
 * "On This Page" (WP18): compact jump links under the hero of an informational About page (About, governance, mentors, recognition, team).
 * Every href must be an in-page anchor that exists on the page.
 */
interface Props {
  links: { label: string; href: string }[];
}
const { links } = Astro.props;
---

<Section id="on-this-page" pad="sm" aria-labelledby="on-this-page-h">
  <nav class="pn" aria-label="On this page">
    <h2 class="pn__title t-heading-m" id="on-this-page-h">On This Page</h2>
    <ul class="pn__links" role="list">
      {links.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
</Section>

<style>
  .pn {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-lg);
  }
  .pn__title {
    margin: 0;
    color: var(--secondary);
  }
  .pn__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-md);
  }
  .pn__links li {
    display: inline-flex;
    align-items: center;
  }
  .pn__links li:not(:last-child)::after {
    content: '·';
    margin-left: var(--space-md);
    color: var(--outline);
  }
  .pn__links a {
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    padding-block: 3px;
    font-weight: var(--fw-medium);
  }
</style>
