---
import Section from '../../ui/Section.astro';
import Icon from '../../system/Icon.astro';
import Stat from '../../system/Stat.astro';
import StatusTag from '../../system/StatusTag.astro';
import CopyBlock from '../home/CopyBlock.astro';
import LeadershipStrip from './LeadershipStrip.astro';
import { EMPATHY, ORIGIN_LAUNCH } from '../../../data/copy';
import { fact } from '../../../data/facts';
import { governmentPartners } from '../../sections/copyText';
import { linkAttrs } from '../../../lib/url';

/**
 * C5 Guide (Investors), empathy first and before the vision (credibility before the future state, as on Home): empathy ([EMP] P8) → the launch line (ORIGIN_LAUNCH) → what has been delivered since 2014 (SC-01, SC-02, SC-03) →
 * four kinds of institutional relationship: governments, development partners, universities and private-sector partners (PA-02, PA-01, PA-05, PA-03; WP41, cycle-18 review: the heading no longer says "distribution", which read as
 * platform distribution channels) → the founders
 * (the cards carry ID-03; no separate sentence) → current leadership → TalentLEAP (IN-06).
 * WP38 (cycle-15 review): the origin is one line, as on the other audience pages; Home keeps the two-sentence history (ORIGIN).
 * WP42 (cycle-19 review): the delivered figures lead the band, before the institutional relationships and the leadership: "Delivered Since 2014" (the three tiles with their enrollment and location note) moved here from "Contracts,
 * Pipeline and Recognition" (#reach), which keeps the contract scope in its own labeled block, apart from what was delivered. The band shows SC-03's tile, so the origin line is the launch alone (ORIGIN_LAUNCH), as on Development
 * Partners: the count of countries and territories is the tile's, stated once. The relationships are one panel across the band (four across on a wide screen) in place of a tall column beside the heading.
 */
interface Props {
  id?: string;
}
const { id = 'guide' } = Astro.props;
const talentleap = linkAttrs('/our-model/talentleap/');
const channels = [
  { icon: 'landmark', label: 'Governments', fact: 'PA-02' },
  { icon: 'globe', label: 'Development Partners', fact: 'PA-01' },
  { icon: 'graduation-cap', label: 'Universities', fact: 'PA-05' },
  { icon: 'building-2', label: 'Private-Sector Partners', fact: 'PA-03' },
];
const delivered = ['SC-01', 'SC-02', 'SC-03'] as const;
const stat = (sid: string) => {
  const s = fact(sid).stat;
  if (!s) throw new Error(`InvestorGuide: ${sid} needs a stat`);
  return s;
};
// One note row under the delivered tiles: the register's detail lines for SC-02 and SC-03, read from it, so the tiles stay level.
const notes = (['SC-02', 'SC-03'] as const).map((sid) => {
  const detail = stat(sid).detail;
  if (!detail) throw new Error(`InvestorGuide: ${sid} needs a stat detail`);
  return detail;
});
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <div class="ig">
    <div class="ig__copy">
      <p class="eyebrow" data-reveal>Our Track Record</p>
      <p class="ig__empathy" data-reveal>{EMPATHY.investors}</p>
      <h2 id={`${id}-h`} data-reveal>A Record Built Since 2014, with Institutions That Reach Youth</h2>
      <CopyBlock block={ORIGIN_LAUNCH} class="ig__origin" />
      <p class="ig__method" data-fact="IN-06">
        TalentLEAP, our method, organizes skills into career paths with progressive levels.{' '}
        <a class="link" href={talentleap.href}>How TalentLEAP Works<Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
    <div class="ig__delivered" data-reveal>
      <h3 class="ig__h">Delivered Since 2014</h3>
      <div class="ig__tiles">
        {
          delivered.map((sid) => (
            <div class="ig__tile" data-fact={sid}>
              <StatusTag status="Delivered" />
              <Stat value={stat(sid).value} label={stat(sid).label} size="lg" count={stat(sid).numeric !== undefined} />
            </div>
          ))
        }
      </div>
      <p class="ig__notes" data-fact="SC-02 SC-03">{notes.join(' ')}</p>
    </div>
  </div>
  <div class="ig__channels" data-reveal>
    <h3 class="t-heading-l">Four Kinds of Institutional Relationship</h3>
    <ul role="list">
      {
        channels.map((c) => (
          <li data-fact={c.fact}>
            <Icon name={c.icon} size={28} strokeWidth={1.5} />
            <div>
              <p class="ig__label">{c.label}</p>
              <p class="ig__text">{c.fact === 'PA-02' ? governmentPartners() : fact(c.fact).text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  <h3 class="t-heading-l ig__lead-h" data-reveal>Founders</h3>
  <LeadershipStrip groups={['founders']} label="Founders" />
  <h3 class="t-heading-l ig__lead-h" data-reveal>Current Leadership</h3>
  <LeadershipStrip groups={['executive']} label="Current leadership" />
</Section>

<style>
  .ig {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .ig__copy {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .ig__copy > * {
    margin: 0;
  }
  .ig__empathy {
    font-size: var(--fs-heading-l);
    line-height: var(--lh-heading-l);
    font-weight: var(--fw-medium);
    color: var(--secondary);
    padding-left: var(--space-md);
    border-left: 4px solid var(--tertiary);
    max-width: 36rem;
  }
  .ig__origin {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface);
  }
  .ig__method {
    color: var(--on-surface-variant);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  /* what has been delivered: the band's figures, before the relationships (WP42) */
  .ig__delivered {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    min-width: 0;
  }
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h3.ig__h,
  h3.ig__lead-h {
    margin: 0;
    color: var(--secondary);
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  h3.ig__lead-h {
    margin: var(--space-lg) 0 var(--space-md);
  }
  /* three tiles across where the column allows, two and one below them otherwise (the 130,000+ at this size needs about 9.5rem) */
  .ig__tiles {
    display: grid;
    gap: var(--space-lg) var(--space-gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(9.5rem, 100%), 1fr));
  }
  .ig__tile {
    display: grid;
    gap: var(--stack-title);
    justify-items: start;
    align-content: start;
    min-width: 0;
  }
  .ig__notes {
    margin: 0;
    max-width: 52rem;
    color: var(--on-surface-variant);
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
  }
  .ig__channels {
    padding: var(--space-gutter);
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-lg);
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .ig__channels h3 {
    margin: 0;
    color: var(--secondary);
  }
  .ig__channels ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md) var(--space-lg);
  }
  .ig__channels li {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }
  .ig__channels li :global(.icon) {
    color: var(--primary);
    flex: none;
    margin-top: var(--space-xs);
  }
  .ig__channels p {
    margin: 0;
  }
  .ig__label {
    font-weight: var(--fw-bold);
    color: var(--on-surface);
  }
  .ig__text {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
  }
  @media (min-width: 768px) {
    h3.ig__h,
    h3.ig__lead-h {
      letter-spacing: -0.5px;
    }
    .ig__channels ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .ig {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      align-items: start;
    }
    .ig__channels ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
