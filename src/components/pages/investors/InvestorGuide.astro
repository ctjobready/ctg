---
import Section from '../../ui/Section.astro';
import Icon from '../../system/Icon.astro';
import Stat from '../../system/Stat.astro';
import StatusTag from '../../system/StatusTag.astro';
import CopyBlock from '../home/CopyBlock.astro';
import { EMPATHY, INVESTOR_PARTNERS, ORIGIN_LAUNCH } from '../../../data/copy';
import { fact } from '../../../data/facts';
import { linkAttrs } from '../../../lib/url';

/**
 * C5 Guide (Investors), empathy first and before the vision (credibility before the future state, as on Home): empathy ([EMP] P8) → the launch line (ORIGIN_LAUNCH) → what has been delivered since 2014 (SC-01, SC-02, SC-03) →
 * the institutions that work with CodersTrust, as one short paragraph by type (INVESTOR_PARTNERS: governments, development partners, universities, private-sector partners; PA-02, PA-01, PA-05, PA-03) → the link to the
 * leadership team → TalentLEAP (IN-06).
 * WP38 (cycle-15 review): the origin is one line, as on the other audience pages; Home keeps the two-sentence history (ORIGIN).
 * WP42 (cycle-19 review): the delivered figures lead the band, before the institutional relationships and the leadership: "Delivered Since 2014" (the three tiles with their enrollment and location note) moved here from "Contracts,
 * Pipeline and Recognition" (#reach), which keeps the contract scope in its own labeled block, apart from what was delivered. The band shows SC-03's tile, so the origin line is the launch alone (ORIGIN_LAUNCH), as on Development
 * Partners: the count of countries and territories is the tile's, stated once.
 * WP43 (cycle-20 review): the band was a directory interrupting the platform story (four relationship lists in a panel, then seven founder and leadership cards). The delivered tiles and the origin line stay; the relationship
 * lists are ONE compact paragraph by type, naming institutions the register names (src/data/copy.ts INVESTOR_PARTNERS), and the people entries are the "Meet the Leadership Team" link that closed the page's call-to-action band
 * (the team page has the biographies, as on Home's Guide band; no new biographies here).
 * WP47 (cycle-22 review): the heading is "A Record Built Since 2014"; the institutions it used to name in a trailing clause follow directly below it.
 */
interface Props {
  id?: string;
}
const { id = 'guide' } = Astro.props;
const talentleap = linkAttrs('/our-model/talentleap/');
const team = linkAttrs('/about/team/');
const delivered = ['SC-01', 'SC-02', 'SC-03'] as const;
const stat = (sid: string) => {
  const s = fact(sid).stat;
  if (!s) throw new Error(`InvestorGuide: ${sid} needs a stat`);
  return s;
};
// One note row under the delivered tiles: the register's detail lines for SC-02 and SC-03, read from it, so the tiles stay level.
const notes = (['SC-02', 'SC-03'] as const).map((sid) => {
  const detail = stat(sid).detail;
  if (!detail) throw new Error(`InvestorGuide: ${sid} needs a stat detail`);
  return detail;
});
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <div class="ig">
    <div class="ig__copy">
      <p class="eyebrow" data-reveal>Our Track Record</p>
      <p class="ig__empathy" data-reveal>{EMPATHY.investors}</p>
      <h2 id={`${id}-h`} data-reveal>A Record Built Since 2014</h2>
      <CopyBlock block={ORIGIN_LAUNCH} class="ig__origin" />
      <p class="ig__method" data-fact="IN-06">
        TalentLEAP, our method, organizes skills into career paths.{' '}
        <a class="link" href={talentleap.href}>How TalentLEAP Works<Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
    <div class="ig__delivered" data-reveal>
      <h3 class="ig__h">Delivered Since 2014</h3>
      <div class="ig__tiles">
        {
          delivered.map((sid) => (
            <div class="ig__tile" data-fact={sid}>
              <StatusTag status="Delivered" />
              <Stat value={stat(sid).value} label={stat(sid).label} size="lg" count={stat(sid).numeric !== undefined} />
            </div>
          ))
        }
      </div>
      <p class="ig__notes" data-fact="SC-02 SC-03">{notes.join(' ')}</p>
    </div>
  </div>
  <div class="ig__partners" data-reveal>
    <CopyBlock block={INVESTOR_PARTNERS} class="ig__names" />
    <p class="ig__leaders"><a class="link" href={team.href}>Meet the Leadership Team<Icon name="arrow-right" size={16} /></a></p>
  </div>
</Section>

<style>
  .ig {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .ig__copy {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .ig__copy > * {
    margin: 0;
  }
  /* WP50 (owner design rule 2026-10-16): no left-edge accent bar on the empathy line (it was a 4 px tertiary border with a left inset). */
  .ig__empathy {
    font-size: var(--fs-heading-l);
    line-height: var(--lh-heading-l);
    font-weight: var(--fw-medium);
    color: var(--secondary);
    max-width: 36rem;
  }
  .ig__origin {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface);
  }
  .ig__method {
    color: var(--on-surface-variant);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  /* what has been delivered: the band's figures, beside the copy (WP42) */
  .ig__delivered {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    min-width: 0;
  }
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h3.ig__h {
    margin: 0;
    color: var(--secondary);
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  /* three tiles across where the column allows, two and one below them otherwise (the 130,000+ at this size needs about 9.5rem) */
  .ig__tiles {
    display: grid;
    gap: var(--space-lg) var(--space-gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(9.5rem, 100%), 1fr));
  }
  .ig__tile {
    display: grid;
    gap: var(--stack-title);
    justify-items: start;
    align-content: start;
    min-width: 0;
  }
  .ig__notes {
    margin: 0;
    max-width: 52rem;
    color: var(--on-surface-variant);
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
  }
  /* the institutions, as one paragraph at the reading width the audience pages' Guide band uses (PartnerGuideBand: 48rem), and the link to the team one step (16px) under it (WP43). The paragraph is the shared
     CopyBlock, which does not carry this component's scope attribute, so it takes the body text size and color (no rule here would reach it). */
  .ig__partners {
    display: grid;
    gap: var(--stack-link);
    justify-items: start;
    max-width: 48rem;
  }
  @media (min-width: 768px) {
    h3.ig__h {
      letter-spacing: -0.5px;
    }
  }
  @media (min-width: 1024px) {
    .ig {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }
</style>
