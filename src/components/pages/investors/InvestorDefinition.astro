---
import Section from '../../ui/Section.astro';
import { fact } from '../../../data/facts';
import { DEFINITION_HEADING } from '../../../data/copy';

/**
 * GEO definition band for Investors: ID-01 verbatim, then the page lead sentence (IN-04 "being built as an
 * AI-native platform"). Page-local because DefinitionBand has one paragraph only.
 * WP38 (cycle-15 review): the second paragraph no longer closes on "a track record of 130,000+ learners trained since 2014"; the count is the first tile of "Delivered Since 2014" (#guide; WP42 moved the tiles there from #reach).
 */
interface Props {
  id?: string;
}
const { id = 'definition' } = Astro.props;
// The definition band look (two columns on a wide screen, stacked on a phone) is shared: .def in src/styles/utilities.css
---

<Section id={id} pad="sm" aria-labelledby={`${id}-h`}>
  <div class="def" data-fact="ID-01 IN-04">
    <h2 class="def__title" id={`${id}-h`}>{DEFINITION_HEADING}</h2>
    <p class="def__text">{fact('ID-01').text}</p>
    <p class="def__text">CodersTrust is building JobReady, an AI-native digital education and employment platform for emerging markets.</p>
  </div>
</Section>
