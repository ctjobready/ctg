---
import { INVESTOR_MARKET } from '../../../data/copy';

/**
 * Market opportunity (C6, Investors): the four sectors. The two context figures behind it (PX-08, PX-05) are stated once, in the thesis band above,
 * and are not repeated here (WP20c). NO market-size figures (TAM / SAM / SOM): sizing and method are shared under NDA (D2; IN-07 never renders).
 */
// WP24a: one plain sentence (the register's text has a dash and a lowercase opening). The sectors are read from the register's own list.
const sectors = INVESTOR_MARKET.text.match(/four sectors in emerging markets — (.+?)\.?$/)?.[1];
if (!sectors) throw new Error('INVESTOR_MARKET wording changed: update the sectors sentence on Investors');
// Colon and semicolons: the third item contains "and" itself.
const intro = `The four sectors involved, all in emerging markets: ${sectors.replace(/, HR tech and /, '; HR tech; and ').replace(/^skill training, /, 'skill training; ')}.`;
---

<div class="mk">
  <h3 class="t-heading-xl mk__title" data-reveal>The Sectors Involved</h3>
  <p class="mk__intro" data-reveal>{intro}</p>
</div>

<style>
  .mk {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--primary-fixed);
    display: grid;
    gap: var(--space-md);
  }
  .mk > * {
    margin: 0;
  }
  .mk__title {
    color: var(--secondary);
  }
  .mk__intro {
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--on-surface-variant);
    max-width: 48rem;
  }
  .mk__closing {
    font-weight: var(--fw-bold);
    color: var(--secondary);
    font-size: var(--fs-body-m);
  }
</style>
