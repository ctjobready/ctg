---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import FactStat from '../../facts/FactStat.astro';
import { fact } from '../../../data/facts';

/**
 * C4 Future state (Klein): the company vision (ID-05) and the company ambition (IN-05, an [E] projection,
 * shown as the tile, with its "targeted ... by the fiscal year ending June 30, 2032" label, and never beside SC-04).
 * WP37 (cycle-14 review): the 3M+ target is the tile's alone. The prose sentence that opened the band restated it and is gone, so the vision leads and
 * "A long-term ambition, not a commitment." qualifies the tile beside it.
 */
interface Props {
  id?: string;
}
const { id = 'vision' } = Astro.props;
// ID-05 in one sentence (the vision for a world with far less youth unemployment; owner, 2026-10-14).
const vision = `Our vision: ${fact('ID-05').text.replace(/^A /, 'a ')}`;
---

<Section id={id} tone="klein" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Where It Is Heading" title="The Ambition and the Vision" />
  <div class="vis">
    <div class="vis__copy" data-fact="ID-05" data-reveal>
      <p class="vis__lead">{vision}.</p>
      <p class="vis__note">A long-term ambition, not a commitment.</p>
    </div>
    <div class="vis__stat" data-reveal>
      <FactStat id="IN-05" tone="accent" size="lg" />
    </div>
  </div>
</Section>

<style>
  .vis {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  .vis__copy {
    display: grid;
    gap: var(--space-md);
  }
  .vis__copy > * {
    margin: 0;
  }
  .vis__lead {
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-medium);
    color: var(--ctx-heading);
    max-width: 36rem;
  }
  .vis__note {
    color: var(--ctx-text);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    font-weight: var(--fw-bold);
    max-width: 36rem;
  }
  .vis__stat {
    padding: var(--space-lg);
    border: 1px solid var(--ctx-border);
    border-radius: var(--radius-lg);
    background: var(--ctx-card);
  }
  @media (min-width: 900px) {
    .vis {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-xl);
    }
  }
</style>
