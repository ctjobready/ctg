---
import { getCollection } from 'astro:content';
import Img from '../../ui/Img.astro';
import { linkAttrs } from '../../../lib/url';

/**
 * Leadership strip: the founders (ID-03) and the executive team from the `team` collection, each linking to
 * their profile. Portraits carry `data-asset` (permissions gate, D13).
 */
interface Props {
  groups?: string[];
}
const { groups = ['founders', 'executive'] } = Astro.props;
const all = await getCollection('team');
const people = all
  .filter((p) => groups.includes(p.data.group))
  .sort((a, b) => groups.indexOf(a.data.group) - groups.indexOf(b.data.group) || a.data.order - b.data.order);
---

<ul class="lead-strip" role="list" aria-label="Leadership">
  {
    people.map((p) => {
      const a = linkAttrs(`/about/team/${p.data.slug}/`);
      return (
        <li class="lead-strip__item" data-reveal data-asset={`team-${p.data.slug}`}>
          <a class="lead-strip__link" href={a.href}>
            <span class="lead-strip__photo">
              {p.data.photo && <Img src={p.data.photo} alt="" width={160} height={160} widths={[80, 160]} sizes="72px" />}
            </span>
            <span class="lead-strip__text">
              <span class="lead-strip__name">{p.data.name}</span>
              <span class="lead-strip__role">{p.data.role}</span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .lead-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  .lead-strip__link {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-sm);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-card);
    height: 100%;
    transition: border-color var(--dur-base) ease, box-shadow var(--dur-base) ease;
  }
  .lead-strip__link:hover,
  .lead-strip__link:focus-visible {
    border-color: var(--primary);
    box-shadow: var(--shadow-card-hover);
  }
  .lead-strip__photo {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    overflow: hidden;
    background: var(--secondary-container);
  }
  .lead-strip__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .lead-strip__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .lead-strip__name {
    font-weight: var(--fw-bold);
    color: var(--on-surface);
  }
  .lead-strip__role {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
  }
  @media (min-width: 640px) {
    .lead-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* An odd last person takes the whole row in the two-column layout, instead of standing alone beside an empty cell. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .lead-strip > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .lead-strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
