---
import Icon from '../../system/Icon.astro';
import CopyBlock from '../home/CopyBlock.astro';
import Fact from '../../facts/Fact.astro';
import { fact } from '../../../data/facts';
import { PROGRAM_OPTIONS, SURVEY_EMPLOYMENT } from '../../../data/copy';

/**
 * Extras inside the Klein traction band on Investors (C7): the survey sentence ([SURVEY], dated and qualified), the path to
 * scale, and the AWS (PA-06) and HolonIQ (PA-08) badges. No investment, valuation or raise figure appears here or anywhere on the site.
 */
const badges = ['PA-06', 'PA-08'];

// Path to scale: built from figures the page already shows (GV-10 contract scopes; PD-05's National option), none typed here.
const scopes = fact('GV-10').text.match(/ranging from ([\d,]+\+ professionals to [\d,]+\+ digital-lab staff)/)?.[1];
if (!scopes) throw new Error('GV-10 wording changed: update the Path to Scale paragraph on Investors');
const nationalSize = PROGRAM_OPTIONS[2].size.split(' ')[0];
---

<div class="ipx">
  <CopyBlock block={SURVEY_EMPLOYMENT} class="ipx__survey" />
  <p class="ipx__onboard" data-fact="GV-10 PD-05"><strong>Path to scale.</strong> Delivery grows in phases from government contract training scopes ranging from {scopes}, through existing labs and certified local facilitators. A {nationalSize} program would require confirmed lab capacity, facilitator supply, funding and independent outcome measurement, agreed phase by phase.</p>
  <p class="ipx__onboard" data-fact="SC-04">Separately, and not counted in the traction above: <Fact id="SC-04" /></p>
  <div class="ipx__row">
    <ul class="ipx__badges" role="list">
      {
        badges.map((id) => (
          <li data-fact={id}>
            <Icon name="award" size={20} />
            <span>{fact(id).text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .ipx {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--ctx-border);
    display: grid;
    gap: var(--space-md);
  }
  .ipx > * {
    margin: 0;
  }
  .ipx__survey {
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--ctx-heading);
    max-width: 52rem;
  }
  .ipx__onboard {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--ctx-text);
    max-width: 52rem;
  }
  .ipx__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
  .ipx__badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .ipx__badges li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 6px var(--space-md);
    border: 1px solid var(--ctx-border);
    border-radius: var(--radius-pill);
    color: var(--ctx-heading);
    font-size: var(--fs-body-xs);
  }
  .ipx__badges :global(.icon) {
    color: var(--ctx-accent);
    flex: none;
  }
</style>
