---
import CopyBlock from '../home/CopyBlock.astro';
import { SURVEY_EMPLOYMENT } from '../../../data/copy';

/**
 * Extra inside the Klein evidence band on Investors (C7): the survey sentence ([SURVEY], dated and qualified), beside the trial it is kept apart from.
 * Reach (the SC tiles, the path to scale, the badges) is its own band, InvestorReach; the program results appear once, in Proof in Practice.
 */
---

<div class="ipx">
  <CopyBlock block={SURVEY_EMPLOYMENT} class="ipx__survey" />
</div>

<style>
  .ipx {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--ctx-border);
  }
  .ipx__survey {
    margin: 0;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--ctx-heading);
    max-width: 52rem;
  }
</style>
