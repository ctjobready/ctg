---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import { CONTRACTING_ENTITIES } from '../../../data/copy';
import { linkAttrs } from '../../../lib/url';

/**
 * C11 Offer (Investors): the offer is the deck request, shown once as one four-step sequence (WP24a, replacing the separate offer, low-risk and next-steps bands):
 * an introduction call, an NDA, the deck and data room, then your questions. Each step carries its own reassurance (the call commits neither side, you decide
 * whether to continue). Thesis and results only; no financial terms are published (D2).
 * WP49 (cycle-24 reviews): one due-diligence line under the steps, as the other route pages have theirs: it names the contracting entities as the register does (CONTRACTING_ENTITIES: ID-07, PD-13) and links Governance and Accountability;
 * the eyebrow is "Next Steps", the label the other pages give this band (it was "The Offer"; the band is a process, not an offer).
 * WP50 (cycle-25 review): the lead is "Four steps, at your pace." The sentence after it ("This page covers the thesis and results only.") read as an editorial stage direction and is gone; the page still publishes no financial terms (D2).
 */
interface Props {
  id?: string;
}
const { id = 'offer' } = Astro.props;
const steps = [
  { icon: 'phone', title: 'Introduction Call', text: 'A conversation about your funding priorities and the thesis. The call does not commit either side.' },
  { icon: 'file-lock', title: 'NDA', text: 'An NDA is in place before the deck and data room are shared.' },
  { icon: 'folder-open', title: 'Deck and Data Room', text: 'You receive the deck and access to the data room.' },
  { icon: 'message-circle', title: 'Your Questions', text: 'We answer your questions and agree what comes next. You decide whether to continue.' },
];
---

<Section id={id} tone="white" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Next Steps" title="What Happens After You Ask" lead="Four steps, at your pace." />
  <ol class="grid-cards io" role="list">
    {
      steps.map((s, i) => (
        <li class="card" data-reveal>
          <div class="card__body">
            <Icon name={s.icon} size={36} strokeWidth={1.5} class="io__icon" />
            <p class="eyebrow">Step {i + 1}</p>
            <h3 class="card__title">{s.title}</h3>
            <p class="card__text">{s.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="io__first" data-reveal>Your first step: an introduction call. In your inquiry, include two suitable times for it.</p>
  <p class="io__diligence" data-reveal data-fact="ID-07 PD-13">Due diligence: CodersTrust contracts through {CONTRACTING_ENTITIES}. <a class="link" href={linkAttrs('/about/governance/').href}>Governance and Accountability<Icon name="arrow-right" size={16} /></a></p>
</Section>

<style>
  .io {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .io :global(.io__icon) {
    color: var(--primary);
  }
  .io__first {
    margin: var(--space-lg) 0 0;
    font-weight: var(--fw-medium);
    color: var(--on-surface);
  }
  .io__diligence {
    margin: var(--space-sm) 0 0;
    color: var(--on-surface-variant);
  }
  @media (min-width: 1024px) {
    .io.io {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
