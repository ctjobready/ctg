---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import FactStat from '../../facts/FactStat.astro';
import { fact } from '../../../data/facts';
import { withSourceNote } from '../../../data/copy';

/**
 * C2–C3 (compressed, declared in doc 06 P8 v1.6): the investor view of the problem and its stakes in one band.
 * P1 educated young people aged 15–24 are not in work or training (PX-01); separately, university-educated
 * people of all working ages (ages 15+, a floor) are unemployed across South Asia, the Middle East and North Africa (MENA) and
 * Sub-Saharan Africa, named in full because "these regions" would have no antecedent (the PX-01 label above carries the register's
 * short form; PX-02, never a youth figure); globally, employers cannot find skills (PX-05). P2 learning needs to connect with work-entry support (mentoring and placement support); P3 AI is raising the bar for entry work (PX-06,
 * PX-08, which is global).
 * WP30c (owner direction 2026-10-14, "less is more"): no lead line under the heading (the three cards are the thesis), and the 19M+ floor figure and the ChatGPT posting
 * decline are gone from this band (the 62 million and 72% tiles and the AI-skills growth figure carry the thesis; the posting decline is on Home and in the FAQ).
 * WP48 (cycle-23 review): the closing stakes line ("Every trained young person who remains out of work is an opportunity employers and communities are not yet capturing.") is gone: it added no fact, so the band ends with its three cards.
 * WP50 (cycle-25 review): the second card is "Connect Learning to Paid Work" with one line about what JobReady is being built to do; it was "Online Learning Sells Content, Not Earnings" (a heading that read as absolute) over a sentence
 * about what many online courses lack ("... without the work-entry support that turns skills into income: mentoring, certification and placement").
 * WP58 (cycle-30 review, Claude S11): the third card is "AI Skills Are in Rising Demand" (it was "AI Is Raising the Bar for Entry Work", a heading about entry-level work over PX-08, which is about jobs that require AI skills at every level, against all jobs).
 */
interface Props {
  id?: string;
}
const { id = 'thesis' } = Astro.props;
// PX-08 is a global figure: the register's own sentence says "Globally" (claims rule 12), so it is shown as registered.
// WP57b (owner decision 2026-10-19): the sentence names its publisher and year inside it, "... with a 62% wage premium (PwC, 2026)." (withSourceNote, src/data/copy.ts)
const px08Text = fact('PX-08').text;
if (!/^globally\b/i.test(px08Text)) throw new Error('PX-08 no longer says "Globally": the investors thesis must keep the scope in the sentence (claims rule 12)');
const px08 = withSourceNote('PX-08', px08Text);
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <SectionHeader
    id={`${id}-h`}
    eyebrow="The Thesis"
    title="Skills and Work Are Not Connecting"
  />
  <div class="grid-cards th">
    <article class="card th__card" data-reveal>
      <div class="card__body">
        <Icon name="users" size={36} strokeWidth={1.5} class="th__icon" />
        <h3 class="card__title">Young People Need Work and Employers Need Skills</h3>
        <div class="th__stats">
          <FactStat id="PX-01" />
          <FactStat id="PX-05" />
        </div>
      </div>
    </article>
    <article class="card th__card" data-reveal>
      <div class="card__body">
        <Icon name="book-open" size={36} strokeWidth={1.5} class="th__icon" />
        <h3 class="card__title">Connect Learning to Paid Work</h3>
        <p class="card__text" data-fact="IN-04">JobReady is being built to connect learning with mentoring and placement support.</p>
      </div>
    </article>
    <article class="card th__card" data-reveal>
      <div class="card__body">
        <Icon name="cpu" size={36} strokeWidth={1.5} class="th__icon" />
        <h3 class="card__title">AI Skills Are in Rising Demand</h3>
        <p class="th__more" data-fact="PX-08">{px08}.</p>
      </div>
    </article>
  </div>
</Section>

<style>
  .th :global(.th__icon) {
    color: var(--primary);
  }
  .th__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }
  .th__more {
    color: var(--on-surface-variant);
    font-size: var(--fs-body-base);
  }
</style>
