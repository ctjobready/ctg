---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import Stat from '../../system/Stat.astro';
import EvidenceTag from '../../system/EvidenceTag.astro';
import Fact from '../../facts/Fact.astro';
import { fact } from '../../../data/facts';
import { CONTRACT_TOTAL_NOTE_INVESTORS } from '../../../data/copy';

/**
 * Contracts, Pipeline and Recognition (Investors; WP24a built it as "Reach to Date"): what is NOT delivered reach, apart from the outcome evidence (the trial and the survey) that follows it, so reach, scope and results are never
 * read as one group: the people in government contract scopes (SC-06, tagged "Contract Scope" as on every page since WP36: contract scope, never delivered reach), the National University pipeline (SC-04, not counted in the delivered reach)
 * and the AWS (PA-06) and HolonIQ (PA-08) badges. The program results (WSDFM, Kosovo, Her Power) are not tiles here: they are on the case studies, which the Independent Evidence band links (WP36 took the case-study cards off this page).
 * WP30c: the path-to-scale paragraph is gone (the scale FAQ answers it) and so are the heading's lead line and the pointer to Proof in Practice.
 * WP42 (cycle-19 review): "Delivered Since 2014" (SC-01, SC-02, SC-03 and their enrollment and location note) moved to the track-record band (#guide, InvestorGuide), which now opens with the delivered figures before the institutional
 * relationships and the leadership. This band keeps the id #reach and the contract scope in its own labeled block; its heading no longer says "Reach to Date", which the delivered figures it held were.
 * WP59 (cycle-31 review, GPT-6.1 Sol G1): the 30,000+ carries the note Home's government slide and the Governments tile print (CONTRACT_TOTAL_NOTE: contract scope, not a count of completers, and Her Power's national program with who trained how many), directly under
 * the figure and tied to the facts it rests on, so the total is explained the same way wherever it appears.
 */
interface Props {
  id?: string;
}
const { id = 'reach' } = Astro.props;
const contracted = 'SC-06';
const stat = (sid: string) => {
  const s = fact(sid).stat;
  if (!s) throw new Error(`InvestorReach: ${sid} needs a stat`);
  return s;
};
// WP130 (Opus High run 5, Minor): the AWS status (PA-06) is in the Scale and Partners paragraph just above, so this list keeps only the HolonIQ listing.
const badges = ['PA-08'];
// WP127 (Opus High run 2, kit 94, Polish): PA-08 is a sentence, so this list item reads like Home, About and Recognition write it ("Listed in the HolonIQ South Asia EdTech 100 in 2023 (STEAM category) and 2024."),
// not the register's Title Case; PA-06 is a name and stays as the register has it.
const pa08 = /^CodersTrust Was (Listed .+)$/.exec(fact('PA-08').text);
if (!pa08) throw new Error('InvestorReach: PA-08 no longer reads "CodersTrust Was Listed ..."');
const badgeText = (bid: string) => (bid === 'PA-08' ? `${pa08[1].replace('STEAM Category', 'STEAM category')}.` : fact(bid).text);
// WP102 (owner answer 2026-10-28): this page reads SC-04 whole. SC-04 says the NU learners are being onboarded, not learners trained by CodersTrust (WP90 had this page's own sentence for it).
const nuSentence = fact('SC-04').text;
---

<Section id={id} tone="white" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Beyond Delivered Reach" title="Contracts and Recognition" />
  <div class="ir__group" data-reveal>
    <h3 class="ir__h t-heading-l">Contracted Scope</h3>
    <div class="ir__tile" data-fact={contracted}>
      <EvidenceTag type="Contract Scope" />
      <Stat value={stat(contracted).value} label={stat(contracted).label} size="lg" count={stat(contracted).numeric !== undefined} />
      <p class="ir__note" data-fact={CONTRACT_TOTAL_NOTE_INVESTORS.facts.join(' ')}>{CONTRACT_TOTAL_NOTE_INVESTORS.text}</p>
    </div>
  </div>
  <p class="ir__p" data-fact="SC-04" data-reveal>Separately, and not counted in the delivered reach: {nuSentence}.</p>
  <ul class="ir__badges" role="list" data-reveal>
    {
      badges.map((bid) => (
        <li data-fact={bid}>
          <Icon name="award" size={20} />
          <span>{badgeText(bid)}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .ir__group {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    min-width: 0;
  }
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h3.ir__h {
    margin: 0;
    color: var(--secondary);
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  @media (min-width: 768px) {
    h3.ir__h {
      letter-spacing: -0.5px;
    }
  }
  .ir__tile {
    display: grid;
    gap: var(--stack-title);
    justify-items: start;
    align-content: start;
    min-width: 0;
  }
  /* the note under the figure, in the note type of the tiles that print it elsewhere (Governments: .pg__note) */
  .ir__note {
    margin: 0;
    max-width: 44ch;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
  }
  .ir__p {
    margin: var(--space-lg) 0 0;
    max-width: 52rem;
    color: var(--on-surface-variant);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
  }
  .ir__badges {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .ir__badges li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-pill);
    color: var(--on-surface);
    font-size: var(--fs-body-xs);
  }
  .ir__badges :global(.icon) {
    color: var(--primary);
    flex: none;
  }
</style>
