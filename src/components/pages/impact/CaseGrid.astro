---
import Icon from '../../system/Icon.astro';
import StatusTag from '../../system/StatusTag.astro';
import EvidenceTag from '../../system/EvidenceTag.astro';
import { evidenceOf, wsdfmFigureLabel } from './evidence';
import Img from '../../ui/Img.astro';
import HeroArt from '../../ui/HeroArt.astro';
import { fact } from '../../../data/facts';
import { linkAttrs } from '../../../lib/url';
import { CASE_STUDIES } from './case-studies';
import { caseCardPhoto } from '../../../data/photos';
import wsdfm from '../../../assets/images/pages/impact/wsdfm-training-group.jpg';
import herPower from '../../../assets/images/pages/impact/her-power-training-lab.jpg';

/** Grid of the four published case-study cards: outcome-first stat from the register, then the program. */
interface Props {
  /** Case-study slugs to exclude (for "more case studies" on a case-study page). */
  except?: string;
  class?: string;
}
const { except, class: className } = Astro.props;
const photos: Record<string, { src: ImageMetadata; alt: string; assetId: string }> = {
  'wsdfm-women-freelancers': { src: wsdfm, alt: 'Women trainees and a CodersTrust Bangladesh banner at a WSDFM training session', assetId: 'case-wsdfm-training-group' },
  'her-power': { src: herPower, alt: 'Women working on laptops in a Her Power training lab', assetId: 'case-her-power-training-lab' },
};
import type { ImageMetadata } from 'astro';
const cards = CASE_STUDIES.filter((c) => c.slug !== except).map((c) => {
  const s = fact(c.factId).stat;
  if (!s) throw new Error(`case card: ${c.factId} has no stat`);
  return { ...c, stat: s, resultLabel: c.factId === 'PR-01' ? wsdfmFigureLabel() : s.label, evidence: evidenceOf(c.factId), photo: photos[c.slug] ?? caseCardPhoto(c.slug) };
});
---

<div class:list={['grid-cards', 'grid-cards--2', className]} data-fact={cards.map((c) => c.factId).join(' ')}>
  {
    cards.map((c) => {
      const a = linkAttrs(c.path);
      return (
        <article class="card card--link case" data-reveal>
          <div class="card__media">
            {c.photo ? <Img src={c.photo.src} alt={c.photo.alt} width={720} height={480} widths={[360, 720]} sizes="(min-width:1024px) 560px, 90vw" assetId={c.photo.assetId} /> : <HeroArt seed={`case-${c.slug}`} shape="card" />}
          </div>
          <div class="card__body">
            <h3 class="card__title"><a class="card__link" href={a.href}>{c.name}</a></h3>
            <dl class="case__fields">
              <div><dt>Partner &amp; Place</dt><dd>{c.place}</dd></div>
              <div><dt>Who</dt><dd>{c.who}</dd></div>
              <div><dt>Scope &amp; Delivery</dt><dd>{c.scope}</dd></div>
              <div class="case__result">
                <dt>Result</dt>
                <dd>
                  <span class="case__tags"><StatusTag status="Delivered" />{c.evidence && <EvidenceTag type={c.evidence} />}</span>
                  <span class="case__value">{c.stat.value}</span>{' '}<span class="case__label">{c.resultLabel}</span>
                </dd>
              </div>
            </dl>
            <span class="card__more" aria-hidden="true">Read the Case Study<span class="sr-only">: {c.name}</span><Icon name="arrow-right" size={16} /></span>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  .case__fields {
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-sm) 0 0;
  }
  .case__fields > div {
    display: grid;
    gap: 2px;
  }
  .case__fields dt {
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secondary);
  }
  .case__fields dd {
    margin: 0;
    font-size: var(--fs-body-s, var(--fs-body-m));
    color: var(--on-surface-variant);
  }
  .case__result {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--outline-variant);
  }
  .case__result dd {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 4px;
  }
  .case__value {
    font-size: var(--fs-heading-2xl);
    line-height: 1.1;
    font-weight: var(--fw-bold);
    color: var(--primary);
    letter-spacing: -1px;
  }
  .case__label {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
    text-wrap: balance;
  }
  .case__evid {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-medium);
    color: var(--secondary);
  }
  .case__note {
    margin: var(--space-md) 0 0;
    font-size: var(--fs-body-xs);
    color: var(--ctx-muted);
  }
</style>
