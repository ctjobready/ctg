---
import Icon from '../../system/Icon.astro';
import Img from '../../ui/Img.astro';
import HeroArt from '../../ui/HeroArt.astro';
import FootnoteMarker from '../../facts/FootnoteMarker.astro';
import { fact, splitProgramLabel } from '../../../data/facts';
import { linkAttrs } from '../../../lib/url';
import { CASE_STUDIES } from './case-studies';
import wsdfm from '../../../assets/images/pages/impact/wsdfm-training-group.jpg';
import herPower from '../../../assets/images/pages/impact/her-power-training-lab.jpg';

/** Grid of the four published case-study cards: outcome-first stat from the register, then the program. */
interface Props {
  /** Case-study slugs to exclude (for "more case studies" on a case-study page). */
  except?: string;
  class?: string;
}
const { except, class: className } = Astro.props;
const photos: Record<string, { src: ImageMetadata; alt: string; assetId: string }> = {
  'wsdfm-women-freelancers': { src: wsdfm, alt: 'Women trainees and a CodersTrust Bangladesh banner at a WSDFM training session', assetId: 'case-wsdfm-training-group' },
  'her-power': { src: herPower, alt: 'Women working on laptops in a Her Power training lab', assetId: 'case-her-power-training-lab' },
};
import type { ImageMetadata } from 'astro';
// A program-results label (PR-01, PR-02, PR-05) ends with the register's program-data label, which is set on its own line below; only a
// figure whose register label has none (PR-03) takes a label here, so no figure carries two.
const ownEvidence: Record<string, string> = {
  'undp-yes-korail': 'Program data — in-work rate, denominator not stated',
};
const cards = CASE_STUDIES.filter((c) => c.slug !== except).map((c) => {
  const s = fact(c.factId).stat;
  if (!s) throw new Error(`case card: ${c.factId} has no stat`);
  const { text, evidence } = splitProgramLabel(s.label);
  return { ...c, stat: { ...s, label: text }, photo: photos[c.slug], evidence: evidence ?? ownEvidence[c.slug] };
});
---

<div class:list={['grid-cards', 'grid-cards--2', className]} data-fact={cards.map((c) => c.factId).join(' ')}>
  {
    cards.map((c) => {
      const a = linkAttrs(c.path);
      return (
        <article class="card card--link case" data-reveal>
          <div class="card__media">
            {c.photo ? <Img src={c.photo.src} alt={c.photo.alt} width={720} height={480} widths={[360, 720]} sizes="(min-width:1024px) 560px, 90vw" assetId={c.photo.assetId} /> : <HeroArt seed={`case-${c.slug}`} shape="card" />}
          </div>
          <div class="card__body">
            <p class="case__stat">
              <span class="case__value">{c.stat.value}</span>
              <span class="case__label">{c.stat.label}<FootnoteMarker id={c.factId} footnote="auto" /></span>
              {c.evidence && <span class="case__evid">{c.evidence}</span>}
            </p>
            <h3 class="card__title"><a class="card__link" href={a.href}>{c.name}</a></h3>
            <p class="card__meta">{c.program}</p>
            <p class="card__text">{c.summary}</p>
            <span class="card__more" aria-hidden="true">Read the case study<Icon name="arrow-right" size={16} /></span>
          </div>
        </article>
      );
    })
  }
</div>
<p class="case__note">Each figure carries its own evidence label. Placement figures are program data: gross in-work rates, not net of what would have happened without training.</p>

<style>
  .case__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .case__value {
    font-size: var(--fs-heading-2xl);
    line-height: 1.1;
    font-weight: var(--fw-bold);
    color: var(--primary);
    letter-spacing: -1px;
  }
  .case__label {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
  }
  .case__evid {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-medium);
    color: var(--secondary);
  }
  .case__note {
    margin: var(--space-md) 0 0;
    font-size: var(--fs-body-xs);
    color: var(--ctx-muted);
  }
</style>
