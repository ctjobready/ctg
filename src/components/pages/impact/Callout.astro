---
/** Short highlighted block: BLUF answer, reading note, caveat or context. */
interface Props {
  tone?: 'bluf' | 'note' | 'caveat';
  label?: string;
  class?: string;
}
const { tone = 'note', label, class: className } = Astro.props;
---

<aside class:list={['callout', `callout--${tone}`, className]}>
  {label && <p class="callout__label">{label}</p>}
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    padding: var(--space-md) var(--space-gutter);
    border-radius: var(--radius-default);
    border: 1px solid var(--primary-fixed);
    border-inline-start: 4px solid var(--primary);
    background: var(--surface-container-low);
    color: var(--on-surface);
    max-width: var(--measure);
  }
  .callout--bluf {
    background: var(--surface-container);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
  }
  .callout--caveat {
    background: var(--warning-subtle);
    border-color: var(--warning);
    border-inline-start-color: var(--tertiary);
  }
  .callout__label {
    margin: 0 0 var(--space-xs);
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secondary);
  }
  .callout__body {
    display: grid;
    gap: var(--space-sm);
  }
  .callout__body > :global(*) {
    margin: 0;
  }
</style>
