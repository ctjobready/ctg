---
import EvidenceTag from '../../system/EvidenceTag.astro';
import { fact } from '../../../data/facts';

/**
 * Paid-work pathways (WP29, Benchmark): the three pathways OC-04 registers (salaried employment, freelancing, business ownership), each before training and
 * at the October 2026 survey, as one compact comparison. Every figure is read from OC-04's own sentence, so none is typed here and no new number appears; the
 * block carries `data-fact="OC-04"` and the Surveyed Completers evidence tag. The share's base is on the Impact Survey 2026 page, which the band beside it links.
 * It uses the context tokens (`--ctx-*`), so it reads on the Klein evidence bands (Home, Employers) and on a light band alike. Plain server-rendered table:
 * the bars are decoration (aria-hidden), the figures are text.
 */
interface Props {
  id?: string;
  /** The block's h3. */
  heading?: string;
  /** One line under the heading, before the table. */
  note?: string;
  /** Fill the band's width (a band whose neighbours do) instead of the 62rem measure of the evidence lists. */
  wide?: boolean;
}
const { id = 'paid-work-pathways', heading = 'Paid-Work Pathways Among Surveyed Completers', note, wide = false } = Astro.props;

// OC-04: "Among surveyed completers, salaried employment rose from 38.3% before training to 53.3% at the October 2026 survey, freelancing from 6.2% to 14.0% (2.3×) and business ownership from 2.8% to 10.6% (3.8×)"
const oc04 = fact('OC-04').text;
const m = /salaried employment rose from ([\d.]+%) before training to ([\d.]+%) at the October 2026 survey, freelancing from ([\d.]+%) to ([\d.]+%)(?: \([\d.]+×\))? and business ownership from ([\d.]+%) to ([\d.]+%)/.exec(oc04);
if (!m) throw new Error(`PaidWorkPathways: OC-04 no longer reads "salaried employment rose from X before training to Y at the October 2026 survey, freelancing from X to Y and business ownership from X to Y": "${oc04}"`);
const pct = (v: string) => parseFloat(v);
// Bars share one scale (the largest value shown), so a share reads the same in every row.
const rows = [
  { label: 'Salaried Employment', before: m[1], after: m[2] },
  { label: 'Freelancing', before: m[3], after: m[4] },
  { label: 'Business Ownership', before: m[5], after: m[6] },
];
const max = Math.max(...rows.flatMap((r) => [pct(r.before), pct(r.after)]));
---

<div class:list={['pwp', wide && 'pwp--wide']} id={id} data-fact="OC-04" data-reveal>
  <div class="pwp__intro">
    <h3 class="pwp__title" id={`${id}-h`}>{heading}</h3>
    <EvidenceTag type="Surveyed Completers" />
    {note && <p class="pwp__note">{note}</p>}
  </div>
  <table class="pwp__table" aria-labelledby={`${id}-h`}>
    <thead>
      <tr>
        <th scope="col">Pathway</th>
        <th scope="col">Before Training</th>
        <th scope="col">October 2026 Survey</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            <td class="pwp__val" style={`--w:${(pct(r.before) / max) * 100}`}>
              <span class="pwp__num">{r.before}</span>
              <span class="pwp__bar pwp__bar--before" aria-hidden="true"></span>
            </td>
            <td class="pwp__val pwp__val--after" style={`--w:${(pct(r.after) / max) * 100}`}>
              <span class="pwp__num">{r.after}</span>
              <span class="pwp__bar pwp__bar--after" aria-hidden="true"></span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .pwp {
    margin-top: var(--space-lg);
    padding: var(--space-gutter);
    max-width: 62rem;
    background: var(--ctx-card, var(--surface-container-low));
    border: 1px solid var(--ctx-border, var(--primary-fixed));
    border-radius: var(--radius-default);
    display: grid;
    gap: var(--space-md) var(--space-lg);
    align-items: center;
  }
  .pwp--wide {
    max-width: none;
  }
  .pwp__intro {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    align-content: center;
  }
  .pwp__intro > * {
    margin: 0;
  }
  .pwp__title {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    font-weight: var(--fw-bold);
    color: var(--ctx-heading);
  }
  .pwp__note {
    font-size: var(--fs-body-base);
    line-height: var(--lh-body-base);
    color: var(--ctx-text);
  }
  .pwp__table {
    width: 100%;
    min-width: 0;
    border-collapse: collapse;
  }
  .pwp__table th,
  .pwp__table td {
    padding: 10px 0;
    text-align: left;
    vertical-align: bottom;
    border-bottom: 1px solid var(--ctx-border, var(--outline-variant));
    color: var(--ctx-text);
  }
  .pwp__table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .pwp__table thead th {
    padding-top: 0;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ctx-heading);
  }
  .pwp__table tbody th {
    padding-right: var(--space-sm);
    font-weight: var(--fw-medium);
    color: var(--ctx-heading);
  }
  .pwp__table td,
  .pwp__table thead th:not(:first-child) {
    padding-left: var(--space-sm);
  }
  /* 20px bold counts as large text (WCAG 1.4.3), which the accent figure needs on the Klein card at phone width (18px would be 4.47:1) */
  .pwp__num {
    display: block;
    font-size: 1.25rem;
    line-height: 1.2;
    font-weight: var(--fw-bold);
    color: var(--ctx-text);
  }
  .pwp__val--after .pwp__num {
    color: var(--ctx-accent, var(--primary));
  }
  .pwp__bar {
    display: block;
    height: 6px;
    margin-top: 6px;
    border-radius: var(--radius-full);
    width: calc(var(--w) * 1%);
    min-width: 6px;
    background: var(--ctx-muted, var(--outline));
    opacity: 0.55;
  }
  .pwp__bar--after {
    background: var(--ctx-accent, var(--primary));
    opacity: 1;
  }
  @media (min-width: 900px) {
    .pwp {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-lg) 56px;
    }
  }
  @media (max-width: 480px) {
    .pwp__table th,
    .pwp__table td {
      font-size: var(--fs-body-xs);
    }
    .pwp__table thead th {
      font-size: 0.6875rem;
      letter-spacing: 0.03em;
    }
  }
</style>
