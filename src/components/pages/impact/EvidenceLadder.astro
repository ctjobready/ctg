---
import Fact from '../../facts/Fact.astro';
import Icon from '../../system/Icon.astro';
import { linkAttrs } from '../../../lib/url';
import { fact } from '../../../data/facts';
import { BIGD_INSTITUTE, TRIAL_RUNG_NAME } from '../../../data/copy';
import EvidenceTag from '../../system/EvidenceTag.astro';
import { trialEmploymentLabel, wsdfmFigureLabel } from './evidence';

/**
 * Evidence ladder: four kinds of evidence, strongest for cause first. Each rung says what it shows,
 * what it does not show and gives a one-line methods note (planning v1.3, P21/P22).
 * The program-results rung shows PR-01 with the register's program-data label, once, on its own line; the rung's title and notes do not repeat it.
 * WP47 (cycle-22 review): when `links` is set the rung's NAME is the link (the matrix row header, the card title). It used to render the name, the evidence tag and a second link whose text repeated the name, and a screen reader read
 * all three as one row header ("Impact Survey 2026, Surveyed Completers, Impact Survey 2026").
 * WP48 (cycle-23 review, item 34): the first rung's name is TRIAL_RUNG_NAME ("Independent Randomized Trial (BIGD)", it was "Independent Evaluation by the BRAC Institute of Governance and Development (BIGD)") in both variants; the evaluator is spelled out once,
 * in that rung's "What It Shows" text, which the cards and the matrix share.
 */
interface Props {
  /** Link each rung to its page (hub) or leave plain (inside the report). */
  links?: boolean;
  headingLevel?: 3 | 4;
  class?: string;
  /** `matrix` (WP17): the same four rungs as one compact table (kind of evidence, key figure, what it shows, what it does not show). */
  variant?: 'cards' | 'matrix';
}
const { links = true, headingLevel = 3, class: className, variant = 'cards' } = Astro.props;
/** What each rung shows and does not show, once: the cards and the matrix read the same wording. */
const TEXT = {
  trial: { shows: `The effect of CodersTrust’s predecessor WSDFM program on women in Dhaka, evaluated by the ${BIGD_INSTITUTE} against a randomly chosen control group.`, not: 'Results for other countries, groups or today’s standard track.' },
  survey: { shows: 'What alumni who responded report about work and income after training.', not: 'Cause: respondents are not a random sample and may over-represent successful learners.' },
  records: { shows: 'What each named program recorded (in work, or a first job within three months), from CodersTrust program records.', not: 'What would have happened without training.' },
  // WP64 (cycle-36 review, Gemini): "...; some stories are outliers, and their cards say so." (it said "...; some are outliers and say so.", where "some" had no noun and "say so" no clear subject): the story cards carry the caveat ("Individual story; an outlier, not typical.", LearnerStory).
  stories: { shows: 'What the path can look like for one person.', not: 'A typical or promised outcome; some stories are outliers, and their cards say so.' },
};
const matrix = [
  // WP35 (cycle-12 review): the matrix is where the Impact page first names the evaluator; WP48: the name carries the abbreviation and the row's "What It Shows" text spells the evaluator out
  { n: 1, name: TRIAL_RUNG_NAME, tag: 'Randomized Trial' as const, text: TEXT.trial, href: '/impact/independent-evaluation/' },
  { n: 2, name: 'Impact Survey 2026', tag: 'Surveyed Completers' as const, text: TEXT.survey, href: '/impact/outcomes-2026/' },
  { n: 3, name: 'Program Results', tag: 'Program Record' as const, text: TEXT.records, href: '/impact/case-studies/' },
  { n: 4, name: 'Learner Stories', tag: 'Individual Story' as const, text: TEXT.stories, href: '/impact/stories/' },
];
const H = `h${headingLevel}` as 'h3' | 'h4';
const pr01Label = wsdfmFigureLabel();
/** The Learner Stories rung shows one real example from the register (ST-03), not a placeholder. */
const storyExample = fact('ST-03').text;
---

{variant === 'matrix' ? (
  <section class:list={['lm', className]} aria-label="Evidence ladder matrix" tabindex="0" data-scroll data-stack data-reveal>
    <table>
      <caption class="sr-only">The Evidence Ladder: What Each Kind of Evidence Shows and Does Not Show</caption>
      <thead>
        <tr>
          <th scope="col">Kind of Evidence</th>
          <th scope="col">What It Shows</th>
          <th scope="col">What It Does Not Show</th>
        </tr>
      </thead>
      <tbody>
        {matrix.map((r) => (
          <tr>
            <th scope="row"><span class="lm__n" aria-hidden="true">{r.n}</span> {links ? <a class="link lm__name" href={linkAttrs(r.href).href}>{r.name}<Icon name="arrow-right" size={16} /></a> : r.name}<span class="lm__tag"><EvidenceTag type={r.tag} /></span></th>
            <td data-label="What It Shows">{r.text.shows}</td>
            <td data-label="What It Does Not Show">{r.text.not}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
) : (
<div class:list={['ladder-box', className]}>
<ol class="ladder" role="list">
  <li class="ladder__rung" data-reveal>
    <span class="ladder__num" aria-hidden="true">1</span>
    <H class="ladder__title">{links ? <a class="link ladder__name" href={linkAttrs('/impact/independent-evaluation/').href}>{TRIAL_RUNG_NAME}<Icon name="arrow-right" size={16} /></a> : TRIAL_RUNG_NAME}</H>
    <EvidenceTag type="Randomized Trial" />
    <p class="ladder__fig"><Fact id="RC-02" field="value" /> <span>{trialEmploymentLabel()}</span></p>
    <dl class="ladder__dl">
      <dt>What it shows</dt>
      <dd>{TEXT.trial.shows}</dd>
      <dt>What it does not show</dt>
      <dd>{TEXT.trial.not}</dd>
    </dl>
  </li>
  <li class="ladder__rung" data-reveal>
    <span class="ladder__num" aria-hidden="true">2</span>
    <H class="ladder__title">{links ? <a class="link ladder__name" href={linkAttrs('/impact/outcomes-2026/').href}>Impact Survey 2026<Icon name="arrow-right" size={16} /></a> : 'Impact Survey 2026'}</H>
    <EvidenceTag type="Surveyed Completers" />
    <p class="ladder__fig"><Fact id="OC-01" field="value" /> <span><Fact id="OC-01" field="label" /></span></p>
    <dl class="ladder__dl">
      <dt>What it shows</dt>
      <dd>{TEXT.survey.shows}</dd>
      <dt>What it does not show</dt>
      <dd>{TEXT.survey.not}</dd>
    </dl>
  </li>
  <li class="ladder__rung" data-reveal>
    <span class="ladder__num" aria-hidden="true">3</span>
    <H class="ladder__title">{links ? <a class="link ladder__name" href={linkAttrs('/impact/case-studies/').href}>Program Results<Icon name="arrow-right" size={16} /></a> : 'Program Results'}</H>
    <EvidenceTag type="Program Record" />
    <p class="ladder__fig"><Fact id="PR-01" field="value" /> <span>{pr01Label}</span></p>
    <dl class="ladder__dl">
      <dt>What it shows</dt>
      <dd>{TEXT.records.shows}</dd>
      <dt>What it does not show</dt>
      <dd>{TEXT.records.not}</dd>
    </dl>
  </li>
  <li class="ladder__rung" data-reveal>
    <span class="ladder__num" aria-hidden="true">4</span>
    <H class="ladder__title">{links ? <a class="link ladder__name" href={linkAttrs('/impact/stories/').href}>Learner Stories<Icon name="arrow-right" size={16} /></a> : 'Learner Stories'}</H>
    <EvidenceTag type="Individual Story" />
    <p class="ladder__fig" data-fact="ST-03"><span><strong>Example:</strong> {storyExample}</span></p>
    <dl class="ladder__dl">
      <dt>What it shows</dt>
      <dd>{TEXT.stories.shows}</dd>
      <dt>What it does not show</dt>
      <dd>{TEXT.stories.not}</dd>
    </dl>
  </li>
</ol>
</div>
)}

<script>
  import '../../../scripts/tablestack';
</script>

<style>
  /* Matrix variant: one compact table; stacked cards at 640 px and below (utilities.css, data-stack). */
  .lm {
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .lm table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
  }
  .lm th,
  .lm td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-compact) var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
  }
  .lm thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
  }
  .lm tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
    min-width: 12rem;
  }
  .lm tbody tr:last-child th,
  .lm tbody tr:last-child td {
    border-bottom: 0;
  }
  .lm__n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-right: var(--space-xs);
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
    font-weight: var(--fw-bold);
    font-size: var(--fs-body-xs);
  }
  .lm__fig {
    color: var(--secondary);
    font-size: var(--fs-heading-m);
  }
  .lm__tag {
    display: block;
    margin-top: var(--space-sm);
  }
  /* the rung's name is the link: it flows on from the number badge like the plain name did, with the arrow after its last word */
  .lm__name {
    display: inline;
    font-weight: var(--fw-medium);
  }
  .lm__name :global(.icon) {
    margin-left: var(--space-xs);
    vertical-align: middle;
  }
  /* Four rungs sit as 1 × 4, 2 × 2 or 4 × 1, never 3 + 1: the columns follow the width of the space the ladder is in
     (the report page keeps a table of contents beside it), not the window. */
  .ladder-box {
    container-type: inline-size;
  }
  .ladder {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
  }
  @container (min-width: 540px) {
    .ladder {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container (min-width: 860px) {
    .ladder {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-md);
    }
  }
  .ladder__rung {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-gutter);
    padding-top: calc(var(--space-gutter) + var(--space-sm));
    background: var(--ctx-card);
    border: 1px solid var(--ctx-border);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    min-width: 0;
  }
  .ladder__rung > * {
    margin: 0;
  }
  .ladder__rung > :global(.evidence-tag) {
    align-self: flex-start;
  }
  .ladder__num {
    position: absolute;
    top: -14px;
    left: var(--space-gutter);
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--secondary);
    color: var(--on-secondary);
    font-weight: var(--fw-bold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .ladder__title {
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    color: var(--ctx-heading);
  }
  .ladder__fig {
    color: var(--ctx-text);
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
  }
  .ladder__fig > :global(.fact:first-child) {
    display: block;
    font-size: var(--fs-heading-2xl);
    line-height: 1.1;
    font-weight: var(--fw-bold);
    color: var(--primary);
    letter-spacing: -1px;
    margin-bottom: var(--space-xs);
  }
  .ladder__evid {
    display: block;
    margin-top: var(--space-xs);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--ctx-border);
    font-weight: var(--fw-medium);
    color: var(--secondary);
  }
  .ladder__dl {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--ctx-text);
  }
  .ladder__dl dt {
    font-weight: var(--fw-bold);
    color: var(--ctx-heading);
    margin-top: var(--space-xs);
  }
  .ladder__dl dd {
    margin: 0;
  }
  .ladder__name {
    font-size: inherit;
    line-height: inherit;
  }
  /* Four across: tighter cards, and the figure steps down so "711 of 1,000" stays on one line. */
  @container (min-width: 860px) {
    .ladder__rung {
      padding-inline: var(--space-md);
    }
    .ladder__num {
      left: var(--space-md);
    }
    .ladder__fig > :global(.fact:first-child) {
      font-size: var(--fs-heading-xl);
      letter-spacing: -0.5px;
    }
  }
</style>
