---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../system/Hero.astro';
import Button from '../../system/Button.astro';
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import CTABand from '../../ui/CTABand.astro';
import Icon from '../../system/Icon.astro';
import FactStat from '../../facts/FactStat.astro';
import EvidenceTag from '../../system/EvidenceTag.astro';
import { evidenceOf } from './evidence';
import Img from '../../ui/Img.astro';
import PhotoGallery from '../../ui/PhotoGallery.astro';
import { caseCardPhoto, galleryPhotos } from '../../../data/photos';
import { linkAttrs } from '../../../lib/url';
import { mayRender } from '../../../lib/permissions';
import type { ImageMetadata } from 'astro';
import { MICRO_COMMITMENT } from '../../../data/copy';
import { discoveryCta, articleNode, desc, title as chkTitle } from './page-utils';
import { caseBySlug } from './case-studies';

/**
 * Template for the five case-study pages (T5): outcome-first header (stat row) → context → challenges →
 * CodersTrust solution → results → learner story → related program → discovery CTA.
 * Slots: `context` (extra context), `solution-lead` (CodersTrust's own role, set above the generic practices), `results`, `story`, `after-results`.
 */
interface Props {
  slug: string;
  /** <title> without the suffix. */
  pageTitle: string;
  description: string;
  /**
   * Register facts whose stats form the outcome-first row. A program-results stat (PR-01, PR-02, PR-05) carries its evidence label from the
   * register, so it takes none here; `evidence` is for a stat whose register label has none (PR-03), and is shown under the figure.
   * WP125: `label` replaces the register's label on this page (FactStat's own `label`), as Her Power's tile reads the clause the cards use.
   */
  stats: { id: string; evidence?: string; label?: string }[];
  context: string[];
  challenges: string[];
  solution: string[];
  artSeed?: string;
  /**
   * One short line directly above the stat tiles (WSDFM: "Program records and a separate randomized trial of CodersTrust’s WSDFM program."), saying what kinds of evidence the tiles are; each tile also carries its own evidence tag.
   * No figure is typed in it (WP60: a count it names is read from the register and its fact is listed in `heroNoteFacts`). WP42 (cycle-19 review): it replaced the two paragraphs that stated the trial's plain-language reading and the program-record result in prose above the tiles that show them (the `plainLine` option
   * that printed the [PLAIN-LINE] here is gone; /impact/independent-evaluation/ keeps the sentence, and scripts/check-facts.mjs lists this case study as exempt from it).
   */
  heroNote?: string;
  /** WP60 (cycle-32 review, Claude S4): the register facts the note states, where it names a count (WSDFM: RC-07's 833); they go on the note's data-fact. */
  heroNoteFacts?: string[];
  /** The closing band's second link: the randomized trial's results (WSDFM only) or, by default, how to read the evidence. */
  trialLink?: boolean;
  /** Eyebrow of the learner-story section: "In a Learner’s Words" only where a direct quote follows the story; "Learner Experience" otherwise. */
  storyEyebrow?: string;
  /** Title of the learner-story band (default "A Learner Story"; "Two Learner Journeys" where two learners follow). */
  storyTitle?: string;
  /**
   * A real program photograph for the hero, in place of the generated art (D13: it renders on staging only when its permissions row allows it,
   * otherwise the art stands in). The photo is shown once, here; the page does not repeat it lower down.
   */
  heroPhoto?: { src: ImageMetadata; alt: string; assetId: string; width: number; height: number };
}
const { slug, pageTitle, description, stats, context, challenges, solution, artSeed, heroNote, heroNoteFacts, trialLink = false, heroPhoto, storyEyebrow = 'Learner Experience', storyTitle = 'A Learner Story' } = Astro.props;
// A case without its own hero photograph takes the one registered for its card (src/data/photos.ts).
const fallback = caseCardPhoto(slug);
const hero = heroPhoto ?? (fallback ? { src: fallback.src, alt: fallback.alt, assetId: fallback.assetId, width: fallback.src.width, height: fallback.src.height } : undefined);
const showPhoto = Boolean(hero) && mayRender(hero!.assetId);
const c = caseBySlug(slug);
const jsonLd = [articleNode({ path: c.path, headline: c.heading, description, datePublished: '2026-10-08', dateModified: c.dateModified ?? '2026-10-10', author: 'CodersTrust' })];
const related = linkAttrs(c.related.href);
const d = discoveryCta();
---

<BaseLayout
  title={chkTitle(pageTitle)}
  description={desc(description)}
  path={c.path}
  breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'Case Studies', href: '/impact/case-studies/' }, { label: c.name }]}
  jsonLd={jsonLd}
  ogType="article"
>
  <Hero variant="inner" eyebrow={`Case Study · ${c.program}`} title={c.heading} lead={c.summary} artSeed={artSeed ?? `case-${slug}`} mediaShape="landscape">
    {showPhoto && hero && <Img slot="media" src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} widths={[480, hero.width]} sizes="(min-width:1024px) 520px, 90vw" loading="eager" fetchpriority="high" assetId={hero.assetId} />}
    <Fragment slot="stats">
      {heroNote && <p class="cs__note" data-hero-note data-fact={heroNoteFacts?.join(' ')}>{heroNote}</p>}
      {
        stats.map((s) => (
          <div class="cs__stat">
            {evidenceOf(s.id) && <EvidenceTag type={evidenceOf(s.id)!} />}
            <FactStat id={s.id} label={s.label} />
            {s.evidence && <p class="cs__evidence">{s.evidence}</p>}
          </div>
        ))
      }
    </Fragment>
    <Fragment slot="actions">
      <Button variant="outline" href="#results">Jump to the Results</Button>
    </Fragment>
  </Hero>

  <Section aria-labelledby="context-h">
    <SectionHeader id="context-h" eyebrow="Context" title="Why This Program" />
    <div class="cs__prose">
      {context.map((p) => <p>{p}</p>)}
      <slot name="context" />
    </div>
  </Section>

  <Section tone="airy" aria-labelledby="solution-h">
    <div class="cs__two">
      <div data-reveal>
        <h2 class="t-heading-2xl" id="challenges-h">Challenges</h2>
        <ul class="cs__list" aria-labelledby="challenges-h">{challenges.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div data-reveal>
        <h2 class="t-heading-2xl" id="solution-h">What CodersTrust Did</h2>
        <slot name="solution-lead" />
        <ul class="cs__list" aria-labelledby="solution-h">{solution.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </Section>

  <Section id="results" aria-labelledby="results-h">
    <SectionHeader id="results-h" eyebrow="Results" title="What Happened" />
    <div class="cs__results"><slot name="results" /></div>
  </Section>
  <slot name="after-results" />

  {/* WP55: a case study with no learner story (Digital Jobs Albania: the World Bank's figures are enrollment, and no learner story is registered) leaves the band out instead of showing an empty one. */}
  {Astro.slots.has('story') && (
    <Section tone="airy" aria-labelledby="story-h">
      <SectionHeader id="story-h" eyebrow={storyEyebrow} title={storyTitle} lead="Individual stories, not typical or promised outcomes." />
      <slot name="story" />
    </Section>
  )}

  <PhotoGallery id="in-the-field" tone="white" eyebrow="In the Field" title="From the Program" photos={galleryPhotos(slug).filter((p) => p.assetId !== hero?.assetId)} />

  <Section aria-labelledby="related-h" pad="sm">
    <!-- WP25s: an eyebrow and a descriptive link label, so "All Case Studies" is not read as a heading of its own above the closing call to action -->
    <p class="eyebrow">Keep Reading</p>
    <h2 class="t-heading-2xl" id="related-h">Where the Model Runs Next</h2>
    <p class="cs__related"><a class="link" href={related.href}>{c.related.label}<Icon name="arrow-right" size={16} /></a><a class="link" href={linkAttrs('/impact/case-studies/').href}>Compare the Five Case Studies<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <CTABand id="cta" tone="klein" heading="Talk to Us About a First Cohort" cta={{ label: d.label, href: d.href }} secondary={trialLink ? { label: 'Read the Randomized Trial Results', href: '/impact/independent-evaluation/' } : { label: 'How to Read the Evidence', href: '/impact/#evidence-ladder' }} micro={MICRO_COMMITMENT} />

</BaseLayout>

<style>
  .cs__stat {
    display: grid;
    gap: var(--stack-title);
    align-content: start;
    justify-items: start;
    max-width: 15rem;
  }
  /* the first item of the stat row (a flex-wrap container): a row of its own, directly above the tiles it describes */
  .cs__note {
    flex: 1 1 100%;
    margin: 0;
    max-width: var(--measure);
    font-size: var(--fs-body-s, var(--fs-body-m));
    color: var(--on-surface-variant);
  }
  .cs__evidence {
    margin: 0;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--primary-fixed);
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-medium);
    color: var(--secondary);
  }
  .cs__prose {
    display: grid;
    gap: var(--space-md);
    max-width: var(--measure);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
  }
  .cs__prose > :global(*) {
    margin: 0;
  }
  .cs__two {
    display: grid;
    gap: var(--space-lg);
  }
  .cs__two h2 {
    margin: 0 0 var(--space-md);
    color: var(--secondary);
  }
  .cs__list {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: var(--space-sm);
    font-size: var(--fs-body-m);
  }
  .cs__list li::marker {
    color: var(--primary);
  }
  .cs__results {
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
  }
  .cs__results > :global(*) {
    margin: 0;
  }
  .cs__results :global(p),
  .cs__results :global(.callout) {
    max-width: var(--measure);
  }
  /* Two links side by side, or stacked when they do not fit: no separator character to be left dangling at the end of a line. */
  .cs__related {
    margin: var(--space-md) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }
  @media (min-width: 900px) {
    .cs__two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }
</style>
