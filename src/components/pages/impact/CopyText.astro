---
import type { CopyBlock } from '../../../data/copy';

/** Shared copy block (src/data/copy.ts) with its fact markers; never retype these blocks. */
interface Props {
  block: CopyBlock;
  as?: 'p' | 'span' | 'div';
  class?: string;
}
const { block, as: Tag = 'p', class: className } = Astro.props;
---

<Tag class={className} data-fact={block.facts.join(' ')}>{block.text}</Tag>
