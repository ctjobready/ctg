---
import Section from '../../ui/Section.astro';
import Icon from '../../system/Icon.astro';
import { linkAttrs } from '../../../lib/url';

/**
 * Purpose-labeled link between an audience page and its program page (WP20b, IA): the audience page says what the program page
 * holds ("See Campus Delivery Details"), and the program page points back ("University Partnership Overview"). A text link, never a button.
 * WP27: a program page's link is named for what it opens (the overview of the partnership route) and its `note` says where to act, so the two pages
 * never send a reader round in a circle.
 */
interface Props {
  /** What this link is for, in a few words ("See the Program"). */
  kicker: string;
  label: string;
  href: string;
  id?: string;
  /** One plain sentence after the link ("Ready to discuss this program? Use the inquiry action on this page."). */
  note?: string;
}
const { kicker, label, href, id = 'route-link', note } = Astro.props;
---

<Section id={id} tone="white" pad="sm" aria-label={kicker}>
  <p class="rl">
    <span class="rl__kicker">{kicker}</span>
    <a class="link" href={linkAttrs(href).href}>{label}<Icon name="arrow-right" size={16} /></a>
    {note && <span class="rl__note">{note}</span>}
  </p>
</Section>

<style>
  .rl {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-md);
  }
  .rl__kicker {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
  }
  .rl__note {
    color: var(--on-surface-variant);
  }
  .rl :global(.link) {
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
</style>
