---
/**
 * The two Foundations funding routes as a two-row comparison (WP29, Benchmark): one row per route, two columns, What It Supports and What the Evidence Covers (WP51, cycle-26 review: it was "Evidence Relationship").
 * Existing copy only: the sentences were the two route cards' own text in the C6 mechanism band, which now holds the route names and this table.
 * Route 2's evidence cell states the line the benchmark asked for ("Youth-program outcomes are not platform outcomes.") and nothing more (WP65, cycle-37 review, Gemini: the page's own second sentence, "The outcome evidence on this page comes from the
 * youth programs, not from the platform.", restated it and is gone). The platform's status sentence ("Live today: ... In pre-launch: ...") is IN-04's, so that cell carries IN-04.
 * WP47 (cycle-22 review): the live list is "partner portals and AI chat" (the subset the Investors page and the platform meta description use), where it named marketing automation and customer relationship management, internal-tool
 * jargon on a funder page; JobReady Platform, JobReady@Work and the Employers FAQ keep the full list.
 * Plain table; at 640 px and below it stacks to one card per route (the shared data-stack pattern, src/styles/utilities.css).
 * WP30c (cycle-7 IA review): `inquiries` are the two text links ("Discuss a YouthWIDE Cohort Grant", "Discuss a JobReady Platform Grant"), set directly under the
 * comparison they belong to; the hero keeps its one primary button.
 */
import Icon from '../../system/Icon.astro';
import { linkAttrs } from '../../../lib/url';

interface Props {
  id?: string;
  inquiries?: { label: string; href: string }[];
}
const { id = 'funding-routes', inquiries = [] } = Astro.props;
const links = inquiries.filter((i) => i.href).map((i) => ({ label: i.label, ...linkAttrs(i.href) }));
const rows = [
  {
    n: 'Funding Route 1',
    name: 'YouthWIDE Cohort Grants',
    supports: 'Co-fundable country programs designed for South Asia, the Middle East and North Africa, and Sub-Saharan Africa.',
    evidence: 'Builds on results from earlier programs in Bangladesh and Kosovo.',
    facts: undefined,
  },
  {
    n: 'Funding Route 2',
    name: 'JobReady Platform Grants',
    supports: 'A grant toward platform infrastructure, not toward cohorts. Live today: partner portals and AI chat. In pre-launch: the employer marketplace and the gig-work marketplace.',
    evidence: 'Youth-program outcomes are not platform outcomes.',
    facts: 'IN-04',
  },
];
---

<section id={id} class="fr" aria-label="The two funding routes compared" tabindex="0" data-scroll data-stack data-reveal>
  <table>
    <caption class="sr-only">The two funding routes, YouthWIDE Cohort Grants and JobReady Platform Grants: what each supports and how each relates to the outcome evidence.</caption>
    <thead>
      <tr>
        <th scope="col">Funding Route</th>
        <th scope="col">What It Supports</th>
        <th scope="col">What the Evidence Covers</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr data-fact={r.facts}>
            <th scope="row"><span class="fr__n">{r.n}</span>{' '}{r.name}</th>
            <td data-label="What It Supports">{r.supports}</td>
            <td data-label="What the Evidence Covers">{r.evidence}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>
{
  links.length > 0 && (
    <p class="cluster fr__inquire" data-reveal>
      {links.map((l) => (
        <a class="link" href={l.href} rel={l.rel}>
          {l.label}
          {l.srText && <span class="sr-only"> {l.srText}</span>}
          <Icon name="arrow-right" size={16} />
        </a>
      ))}
    </p>
  )
}

<script>
  import '../../../scripts/tablestack';
</script>

<style>
  .fr {
    position: relative;
    max-width: 100%;
    margin-top: var(--space-lg);
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  /* the row's layout is the shared .cluster utility; this only sets it apart from the table above it */
  .fr__inquire {
    margin: var(--space-md) 0 0;
  }
  table {
    width: 100%;
    min-width: 600px;
    border-collapse: separate;
    border-spacing: 0;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-md) var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
  }
  thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
  }
  tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-bold);
    min-width: 11rem;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .fr__n {
    display: block;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
  }
</style>
