---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import { linkAttrs } from '../../../lib/url';
import { factPart } from './partners';

/**
 * P3 per-contract table (R2-M5; C7), built only from GV-01 to GV-06 and GV-11.
 * Counts are contract training scopes (GV-10), never delivered scale. Every number comes from the register.
 * No Status column (visual polish, WP1p; confirmed 2026-10-12, item #29): the register states a status for no single contract (GV-10 says only that "some
 * contracts are still in progress"), so a column would read "Status to confirm" in every row. The note under the table says once that delivery
 * status is confirmed for each contract in a briefing (WP52; it said "per contract on request"). When a status is registered for a contract, add the column back.
 * No Curriculum-reach column: only Her Power has one, so its figures (the national program's training total and the manuals published) sit in
 * that row's Training Figure cell (WP41; they were in its scope text). A column returns when two or more contracts carry a value.
 * Abbreviations are expanded in the contract names (PMIS, NHRDF, NSDA, DoICT, BCC), and every scope count carries the "Contract scope:" prefix.
 * WP35 (cycle-12 review): the scope column uses plain words ("Training in digital technologies"; "Training for staff on the learning platform and lab operations"); GV-02 and GV-05 in the register keep their wording.
 * WP30c: one note under the table (delivery status; scopes are not delivered scale). The 31,200+ total is the Results at a Glance tile's, and the COVID-19
 * teacher-training line (SC-08, which does not say who trained the teachers) is gone from the page.
 * WP37 (cycle-14 review): the Her Power band that followed the table (and restated the Results at a Glance tile and the scale FAQ) is gone; the first row's program has its case study as a text link under the note (`more`).
 * WP39 (cycle-16 review): the last column reads "Training Figure", not "Direct Training": the column holds a delivered figure in one row (Her Power's women trained directly) and contract scopes in the others, and the cells (each
 * scope marked "Contract scope:") and the note say which is which.
 * WP41 (cycle-18 review): the scope column is a short phrase in every row (Her Power's was a sentence carrying three figures, which read as a report annex), and every number is in the "Training Figure" column: Her Power's cell
 * lists its three figures, one per line, each saying whose it is (the women CodersTrust trained directly; the national program's total; the manuals distributed).
 * WP48 (cycle-23 review): the last column reads "Scale and Outputs", not "Training Figure": its cells hold people (a delivered count in one row, contract scopes in the others) and distributed documents, which "Training Figure" did not
 * cover. The cells are unchanged.
 * WP50 (cycle-25 review): Her Power's three lines are full sentences with a full stop ("CodersTrust trained 2,500 women directly." / "The national program trained 25,125 women across 130 sub-districts (upazilas)." / "54,609 manuals and guidelines
 * were distributed."), still one per line, with a space between the items so a text export keeps them apart.
 * WP52 (cycle-27 reviews): the note sat beside Her Power's delivered figures yet said all scopes are "not delivered scale"; it now reads "Delivery status is confirmed for each contract in a briefing. Apart from the Her Power figures, scopes are contracted
 * scopes of work, not delivered scale." (two sentences; Claude m5, then Grok m2: "on request" read as a barrier, and the page's first step is a briefing), and the table's screen-reader caption makes the same exception.
 * WP54 (cycle-28 review, Claude S20): the NHRDF contract's name reads "..., implemented by the National Skills Development Authority, NSDA" (it was "Implemented by", a capital in the middle of a parenthesis; GV-04 words it "implemented by NSDA").
 * WP65 (cycle-37 review, Gemini, Kimi): the note's first sentence is active, "We confirm each contract’s delivery status in a briefing." (it said "Delivery status is confirmed for each contract in a briefing."); the second sentence is unchanged.
 */
interface Row {
  contract: string;
  facts: string[];
  scope: string;
  /** The "Scale and Outputs" cell: one text, or one line per figure (Her Power's three). */
  direct: string | string[];
}
const SCOPE = 'Contract scope:';

const rows: Row[] = [
  {
    contract: 'Her Power (Department of ICT (DoICT), ICT Division)',
    facts: ['GV-01', 'GV-11'],
    // GV-11's role: curriculum, training manuals and mentorship guidelines; Training of Trainers. The figures are GV-11's (women trained directly, manuals distributed) and GV-01's (the national program's total, which is the
    // program's, not CodersTrust's own).
    scope: 'Curriculum, manuals, mentorship guidelines and Training of Trainers',
    // WP50 (cycle-25 review, item 15): each figure is its own full sentence, so the three do not read as one run-on claim in a text export or to a screen reader (they were fragments: "2,500 women trained directly", "National program trained ...",
    // "54,609 manuals and guidelines distributed"). The numbers are still read from the register (GV-11 and GV-01); the register's strings are unchanged.
    direct: [
      `CodersTrust trained ${factPart('GV-11', /([\d,]+ women) trained directly/)} directly.`,
      // WP83 (owner answer 2026-10-23): the 25,125 was worded as the national program's target ("The national program’s target is to train 25,125 women across 130 sub-districts (upazilas)."). WP85 (owner update 2026-10-24: the government achieved 100% of the target): "The national program trained 25,125 women across 130 sub-districts (upazilas), meeting its target." (read from GV-01).
      `The national program trained ${factPart('GV-01', /national program that trained ([\d,]+ women across \d+ sub-districts \(upazilas\), meeting its target)/)}.`,
      `${factPart('GV-11', /([\d,]+ manuals and guidelines) distributed/)} were distributed.`,
    ],
  },
  {
    // PMIS is the Center for Project Management and Information Systems at the University of Dhaka (named in full in the EDGE news item).
    contract: 'EDGE: Center for Project Management and Information Systems (PMIS), University of Dhaka, with the Bangladesh Computer Council (BCC)',
    facts: ['GV-02'],
    scope: 'Training in digital technologies',
    direct: `${SCOPE} ${factPart('GV-02', /[\d,]+ youth/)}`,
  },
  {
    contract: 'SKIT Incubator (Bangladesh Hi-Tech Park Authority)',
    facts: ['GV-03'],
    scope: 'High-demand IT skills training, Barishal',
    direct: `${SCOPE} ${factPart('GV-03', /[\d,]+ people/)}`,
  },
  {
    contract: 'NHRDF (National Human Resource Development Fund, implemented by the National Skills Development Authority, NSDA)',
    facts: ['GV-04'],
    scope: 'Training service provider',
    // WP31: the scope first, then the first batch inside it (GV-04: "initial 200 trainees, scope 1,000+"); the 31,200+ total counts the scope.
    direct: `${SCOPE} ${factPart('GV-04', /scope ([\d,]+\+)/)} trainees, ${factPart('GV-04', /initial (\d+) trainees/)} in the first batch`,
  },
  {
    // WP69 (owner decision 2026-10-21): the contract was with the ICT Division, named as the other rows name their bodies.
    contract: 'Digital Lab Establishment Project, Phase II (ICT Division)',
    facts: ['GV-05'],
    scope: 'Training for staff on the learning platform and lab operations',
    direct: `${SCOPE} ${factPart('GV-05', /[\d,]+\+ staff/)}`,
  },
  {
    contract: 'Ministry of Power, Energy and Mineral Resources (via Bangladesh Petroleum Institute)',
    facts: ['GV-06'],
    scope: 'ICT, networking and cybersecurity training',
    direct: `${SCOPE} ${factPart('GV-06', /[\d,]+\+ professionals/)}`,
  },
];

interface Props {
  title: string;
  lead?: string;
  id?: string;
  /** A text link under the table's note (WP37: "Read the Her Power Case Study", the first row's program). */
  more?: { label: string; href: string };
}
const { title, lead, id = 'contracts', more } = Astro.props;
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Government Contracts" title={title} lead={lead} />
  <section class="ct" aria-label="Government contracts: CodersTrust scope and training scope" tabindex="0" data-scroll data-stack data-reveal>
    <table>
      <caption class="sr-only">Six government contracts: what CodersTrust does under each and the training scope. Apart from CodersTrust’s own Her Power figures, counts are contract training scopes, not delivered scale.</caption>
      <thead>
        <tr>
          <th scope="col">Contract</th>
          <th scope="col">CodersTrust Scope</th>
          <th scope="col">Scale and Outputs</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr data-fact={r.facts.join(' ')}>
              <th scope="row">{r.contract}</th>
              <td data-label="CodersTrust Scope">{r.scope}</td>
              <td class="ct__num" data-label="Scale and Outputs">{typeof r.direct === 'string' ? r.direct : <ul class="ct__lines" role="list">{r.direct.map((line) => <><li>{line}</li>{' '}</>)}</ul>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
  <div class="ct__notes" data-reveal>
    <p data-fact="GV-10">We confirm each contract’s delivery status in a briefing. Apart from the Her Power figures, the other rows give contracted scopes of work, not delivered scale.</p>
  </div>
  {more && <p class="ct__more" data-reveal><a class="link" href={linkAttrs(more.href).href}>{more.label}<Icon name="arrow-right" size={16} /></a></p>}
</Section>

<script>
  import '../../../scripts/tablestack';
</script>

<style>
  .ct {
    position: relative;
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  table {
    width: 100%;
    min-width: 620px;
    border-collapse: separate;
    border-spacing: 0;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-md) var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
  }
  thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
  }
  tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
    position: sticky;
    left: 0;
    background: var(--surface);
    min-width: 12rem;
    box-shadow: 1px 0 0 var(--outline-variant);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .ct__num {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
  }
  /* Her Power's three figures, one per line (WP41) */
  .ct__lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }
  .ct__notes {
    margin-top: var(--space-md);
    display: grid;
    gap: var(--space-xs);
    max-width: 62rem;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
  }
  .ct__notes > p {
    margin: 0;
  }
  .ct__more {
    margin: var(--space-md) 0 0;
  }
</style>
