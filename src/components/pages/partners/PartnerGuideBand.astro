---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import FactStat from '../../facts/FactStat.astro';
import PartnerStrip from '../../system/PartnerStrip.astro';
import Icon from '../../system/Icon.astro';
import WorldStrip from '../../ui/WorldStrip.astro';
import CopyText from './CopyText.astro';
import { WORLD_STRIP_SHORT } from '../../../data/globalStrip';
import { linkAttrs } from '../../../lib/url';
import { PARTNER_CAPTION, type PartnerGroup } from '../../../lib/logos';
import { originShortUnder, statLabelUnder } from '../../../data/copy';
import { fact } from '../../../data/facts';
import { endSentence, signedWith } from '../../sections/copyText';

/**
 * C5 Guide, empathy first: the audience's empathy line (EMPATHY[audience]), then the origin line (ORIGIN_SHORT), then
 * authority (stat tiles and register-backed statements), then the method signal and the logo strip.
 * Same visual structure as the shared GuideBand; it adds what that band cannot hold: the origin
 * line and authority statements that are sentences rather than numbers.
 * WP38 (cycle-15 review): the origin is one line (ORIGIN_SHORT), not the two-sentence history that Home keeps (ORIGIN); where the band showed SC-03's tile it was the launch alone ("Launched in Copenhagen in 2014.").
 * WP39 (cycle-16 review): a band with neither tiles nor statements (Universities: "The National University Partnership" states the NU relationship) has no proof column: the copy is one column at a reading width.
 * WP51 (cycle-26 reviews, Kimi P2 and Grok m1): every page's band states the same line, ORIGIN_SHORT ("Since 2014, from a Copenhagen launch to programs in 15 countries and territories."), Development Partners included (its band shows
 * SC-03's tile and used to carry the launch alone); Investors' own band (InvestorGuide) prints it too.
 * WP41 (cycle-18 review): Employers' band was a figure, a contract line, an AWS badge and an AIvolve note in a row of bullets. Its one delivered figure is now the band's headline stat (`statSize="lg"`), the two lines that
 * remain follow it, and the AWS credential is a short line under the logo strip, beside the AWS logo (`logoNote`; the strip's default slot).
 * WP54 (cycle-28 review, Kimi K3): that credential is a sentence of the logo strip's caption now (`captionNote`: "... These are working relationships, not endorsements. CodersTrust is an AWS Authorized Training Partner."), not a lone
 * paragraph under the logos; the strip's slot and this band's `.pg__logonote` style are gone.
 * WP64 rework RW2 (coordinator): the band's heading says the period ("We’ve Built This Path Since 2014"), so the origin line drops its "Since 2014," lead-in ("From a Copenhagen launch to work in 16 countries and territories.") and a tile whose label ends "since 2014" drops it
 * ("learners trained"): originShortUnder and statLabelUnder (src/data/copy.ts) read the heading, so a page that gives this band a heading without the year keeps both.
 * WP66 (owner request 2026-10-20): `signed` adds the audience's signed-agreement sentence (SC-11a to SC-11d) as the last item of the list ("CodersTrust has signed MOUs, agreements or contracts with 13 government bodies."); signedWith builds it under this band's heading,
 * so under "We’ve Built This Path Since 2014" it leaves the year to the heading, as the tiles and the origin line do, and under a heading without the year it says "since 2014" itself. A band with only this sentence (Universities) has a proof column of one line.
 */
interface Statement {
  /** Fact(s) behind the statement (data-fact and footnote markers). */
  facts: string[];
  /** Sentence to show; defaults to the canonical text of the first fact. */
  text?: string;
  /** Facts whose footnote markers follow the sentence; defaults to all of facts. */
  markers?: string[];
}
interface Props {
  title?: string;
  /** The empathy line that opens the band; a page that does not open with one (Development Partners, WP44; Foundations and Universities, WP50; Governments, WP52; Employers, WP61) leaves it out. */
  empathy?: string;
  /** Fact IDs rendered as stat tiles (need a stat). */
  stats?: string[];
  /** Size of the stat tiles (default md). A band whose one figure is its headline shows it large. */
  statSize?: 'md' | 'lg';
  statements?: Statement[];
  /** The signed-agreement fact of the page's audience (SC-11a to SC-11d), printed as the last sentence of the list (see the WP66 note above). */
  signed?: string;
  /** A registered credential as one more sentence in the logo strip's caption, instead of a bullet in the list above (same fields as a statement; the page gives the sentence in `text`). */
  captionNote?: Statement;
  method: { text: string; link?: { label: string; href: string } };
  partnerGroup?: PartnerGroup | PartnerGroup[];
  /** WP55 (owner decisions 2026-10-17/18): the three-tile "CodersTrust Around the World" strip (Copenhagen, Dubai, Kosovo) under the origin line, for the audience pages that open their track record with it. */
  strip?: boolean;
  id?: string;
}
const { title = 'We’ve Built This Path Since 2014', empathy, stats = [], statSize = 'md', statements = [], signed, captionNote, method, partnerGroup, strip = false, id = 'guide' } = Astro.props;
const listed: Statement[] = signed ? [...statements, { facts: [signed], text: signedWith(signed, title) }] : statements;
const hasProof = stats.length > 0 || listed.length > 0;
const origin = originShortUnder(title);
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Our Track Record" title={title} />
  <div class:list={['pg', !hasProof && 'pg--solo']}>
    <div class="pg__copy" data-reveal>
      {empathy && <p class="lead">{empathy}</p>}
      <CopyText block={origin} markers={[]} class="pg__origin" />
      <p class="pg__method">
        {method.text}{' '}
        {method.link && (
          <a class="link" href={linkAttrs(method.link.href).href}>{method.link.label}<Icon name="arrow-right" size={16} /></a>
        )}
      </p>
    </div>
    {
      hasProof && (
        <div class="pg__proof">
          {stats.length > 0 && <div class="pg__stats">{stats.map((s) => <FactStat id={s} size={statSize} label={statLabelUnder(title, fact(s).stat?.label)} />)}</div>}
          {
            listed.length > 0 && (
              <ul class="pg__list" role="list">
                {listed.map((s) => (
                  <li data-fact={s.facts.join(' ')}>
                    <Icon name="circle-check" size={20} />
                    <span>{endSentence(s.text ?? fact(s.facts[0]).text)}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      )
    }
  </div>
  {strip && <div class="pg__world"><WorldStrip tiles={WORLD_STRIP_SHORT} level={3} id="world" /></div>}
  <PartnerStrip
    variant="grid"
    group={partnerGroup}
    caption={PARTNER_CAPTION}
    captionNote={captionNote && { text: endSentence(captionNote.text ?? fact(captionNote.facts[0]).text), facts: captionNote.facts }}
  />
</Section>

<style>
  .pg {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  /* WP55: the short strip is one band's sub-block, a section step (32px) under the copy and tiles and above the logo strip */
  .pg__world {
    margin-bottom: var(--space-lg);
  }
  .pg__copy {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .pg__copy > * {
    margin: 0;
  }
  .pg__origin {
    color: var(--on-surface-variant);
    max-width: 48rem;
  }
  .pg__method {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    color: var(--on-surface-variant);
    max-width: 48rem;
  }
  .pg__proof {
    display: grid;
    gap: var(--space-lg);
    align-content: start;
  }
  .pg__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-gutter);
  }
  .pg__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }
  .pg__list li {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    color: var(--on-surface);
  }
  .pg__list :global(.icon) {
    color: var(--success);
    margin-top: var(--space-xs);
    flex: none;
  }
  @media (min-width: 1024px) {
    .pg {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-xl);
      align-items: start;
    }
    /* no tiles and no statements: the copy is the whole band, one column (its lines keep their reading width) */
    .pg--solo {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
