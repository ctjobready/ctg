---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Fact from '../../facts/Fact.astro';
import Stat from '../../system/Stat.astro';
import Icon from '../../system/Icon.astro';
import { fact } from '../../../data/facts';
import { linkAttrs } from '../../../lib/url';

/**
 * Offer paired with its most relevant evidence (WP17, item 8). The facts that bear on THIS offer come first (Employers and JobReady@Work:
 * AWS Authorized Training Partner, the AIvolve partnership, Grameenphone Academy enrollments; Universities and JobReady@Campus: the National
 * University partnership; SuperKids: learners since 2021); the broader evidence (the trial and the survey, which come from the youth programs)
 * follows as a compact linked block. Figures and sentences are read from the facts register.
 * WP32 (cycle-9 review): with no `items` the band is just the heading and the linked block, a slim "see also" strip. The Employers and JobReady@Work pages use it so the credentials
 * (AWS Authorized Training Partner, AIvolve, Grameenphone Academy enrollments) are stated once, in their Track Record band, and not again here.
 */
interface Item {
  /** Register fact id. */
  id: string;
  /** Small heading above the item. */
  label: string;
  /** Show the fact's stat tile (value and label) instead of its sentence. */
  stat?: boolean;
}
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  /** May be empty (WP32): the band is then its heading and the linked block only. */
  items: Item[];
  /** Compact links to the broader evidence. */
  broader?: { label: string; href: string }[];
  broaderLabel?: string;
  tone?: 'white' | 'airy' | 'ice';
  id?: string;
}
const {
  title,
  eyebrow = 'Evidence for This Offer',
  lead,
  items,
  broader = [
    { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' },
    { label: 'Impact Survey 2026', href: '/impact/outcomes-2026/' },
    { label: 'Case Studies', href: '/impact/case-studies/' },
  ],
  broaderLabel = 'Broader Evidence from Our Youth Programs',
  tone = 'airy',
  id = 'offer-evidence',
} = Astro.props;
const views = items.map((it) => {
  const f = fact(it.id);
  if (it.stat && !f.stat) throw new Error(`PairedEvidence: fact ${it.id} has no stat`);
  return { ...it, stat: it.stat ? f.stat : undefined };
});
const linksOnly = views.length === 0;
---

<Section id={id} tone={tone} pad={linksOnly ? 'sm' : 'md'} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow={eyebrow} title={title} lead={lead} />
  {
    !linksOnly && (
      <ul class="pe" role="list">
        {views.map((v) => (
          <li class="pe__item" data-fact={v.id} data-reveal>
            <p class="pe__label">{v.label}</p>
            {v.stat ? <Stat value={v.stat.value} label={v.stat.label} size="lg" count={false} /> : <p class="pe__text"><Fact id={v.id} /></p>}
          </li>
        ))}
      </ul>
    )
  }
  <nav class:list={['pe__more', linksOnly && 'pe__more--alone']} aria-label={broaderLabel}>
    {!linksOnly && <p class="pe__more-label">{broaderLabel}</p>}
    <ul role="list">
      {broader.map((b) => <li><a class="link" href={linkAttrs(b.href).href}>{b.label}<Icon name="arrow-right" size={16} /></a></li>)}
    </ul>
  </nav>
</Section>

<style>
  .pe {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .pe {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }
  .pe__item {
    padding: var(--space-gutter);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-top: 4px solid var(--secondary);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    display: grid;
    gap: var(--stack-title);
    align-content: start;
  }
  .pe__item > * {
    margin: 0;
  }
  .pe__label {
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--on-primary-container);
  }
  .pe__text {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface);
  }
  .pe__more {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--primary-fixed);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-lg);
  }
  /* No cards above it: the linked block is the band's content, so it has no rule or gap of its own. */
  .pe__more--alone {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .pe__more-label {
    margin: 0;
    font-weight: var(--fw-bold);
    color: var(--on-surface);
  }
  .pe__more ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
  }
  .pe__more a {
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-xs);
  }
</style>
