---
import Icon from '../../system/Icon.astro';
import { titleCase } from '../../../lib/titleCase.mjs';

/**
 * C2 gains and ranked pains (doc 04 matrices, 2a and 2b). Rendered inside ProblemBand's lead slot, so
 * the band keeps its heading and evidence cards. Pains are stated as outcomes ("Graduates struggle to find work"), the way Home and YouthWIDE state theirs (WP36, cycle-13 review:
 * the audience pages had them as questions; a question title is not an impactful heading, and an answer line that repeats it is left out).
 *
 * `gains` is optional: a page that already shows its gains in the future-state band (C4) can render the ranked pains alone, in three
 * columns (review round 14, M4: Home, YouthWIDE and the local-partners page). WP47: the audience pages carry no future-state band (Home has it), and every page renders the pains alone. A pain may carry an `id` ("P1" to "P3"), written to the
 * list item as `data-pain`; the C8 card that relieves it carries the same id as `data-relieves` (IncludesBand `painId`), and
 * scripts/check-facts.mjs checks the one-to-one map. `facts` ties a pain to the registered facts it rests on (`data-fact`).
 * WP35 (cycle-12 review): a pain's title is a card title, so it is set in Title Case here, wherever the band renders it ("Graduates Struggle to Find Work"); the pain's wording is written once,
 * in sentence case. (WP39: the C8 band is three short cards, one for each pain in the same order, with no concern label to repeat the wording.)
 */
interface Pain {
  /** The pain as a statement, in sentence case (set in Title Case here). */
  q: string;
  /** One line under the statement; omitted where it would only repeat the statement. */
  text?: string;
  id?: string;
  facts?: string[];
}
interface Props {
  gains?: string[];
  pains: Pain[];
  gainsHeading?: string;
  painsHeading?: string;
}
const { gains = [], pains, gainsHeading = 'What You Are Working Toward', painsHeading = 'What Gets in the Way' } = Astro.props;
const solo = gains.length === 0;
---

<div class:list={['gp', solo && 'gp--solo']}>
  {
    !solo && (
      <div class="gp__col">
        <h3 class="gp__h">{gainsHeading}</h3>
        <ul class="gp__gains" role="list">
          {gains.map((g) => <li><Icon name="circle-check" size={20} />{g}</li>)}
        </ul>
      </div>
    )
  }
  <div class="gp__col">
    <h3 class="gp__h">{painsHeading}</h3>
    <ol class="gp__pains" role="list" style={solo ? `--gp-cols:${Math.min(pains.length, 3)}` : undefined}>
      {
        pains.map((p, i) => (
          <li data-pain={p.id} data-fact={p.facts?.join(' ')}>
            <span class="gp__n" aria-hidden="true">{i + 1}</span>
            <div>
              <p class="gp__q">{titleCase(p.q)}</p>
              {p.text && <p class="gp__a">{p.text}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .gp {
    display: grid;
    gap: var(--space-lg);
    width: 100%;
    margin-top: var(--space-md);
  }
  .gp__h {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ctx-accent);
    margin: 0 0 var(--space-sm);
  }
  .gp__gains,
  .gp__pains {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  .gp__gains li {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    color: var(--on-surface);
  }
  .gp__gains :global(.icon) {
    color: var(--success);
    margin-top: var(--space-xs);
    flex: none;
  }
  .gp__pains li {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }
  .gp__n {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
    font-weight: var(--fw-bold);
    font-size: var(--fs-body-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .gp__q {
    margin: 0;
    font-weight: var(--fw-bold);
    color: var(--on-surface);
  }
  .gp__a {
    margin: var(--space-xs) 0 0;
    color: var(--on-surface-variant);
  }
  /* the ranked pains in the header slot run the full width of the band (the heading and lead keep their measure) */
  :global(.sh:has(> .gp)) {
    max-width: none;
  }
  :global(.sh:has(> .gp) > .sh__title) {
    max-width: 52rem;
  }
  @media (min-width: 900px) {
    .gp {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-lg) var(--space-xl);
    }
    /* pains alone: the ranked pains side by side, one compact row (three columns; WP46: two where a page states two, so the row is not left with an empty third) */
    .gp--solo {
      grid-template-columns: minmax(0, 1fr);
    }
    .gp--solo .gp__pains {
      grid-template-columns: repeat(var(--gp-cols, 3), minmax(0, 1fr));
      gap: var(--space-md) var(--space-lg);
    }
  }
</style>
