---
import Section from '../../ui/Section.astro';
import Icon from '../../system/Icon.astro';
import EvidenceTag from '../../system/EvidenceTag.astro';
import { fact } from '../../../data/facts';
import { labelWithoutUnit, spellUnit } from '../../../lib/format';
import { linkAttrs } from '../../../lib/url';

/**
 * Results at a Glance for the audience pages (WP24a): three lead tiles chosen for the audience, then the secondary tiles below under their own
 * heading. Every tile names the kind of evidence it rests on (EvidenceTag), so a trial figure, a survey figure, a program record and a contract
 * scope are never read as one undifferentiated group. Figures, labels and notes are read from the facts register (stat.value,
 * stat.glance ?? stat.label); a page may reword a label or add a caveat, never retype a number. WP45 (cycle-21 review): a figure in "pp" ("+10.3 pp") shows "+10.3" with "percentage points" on a line under it.
 * WP49 (cycle-24 review): a "More Results" heading over ONE tile is no heading at all, so a single secondary tile joins the main group (four tiles in one row from 1100 px, two by two from 720 px, stacked on a phone); the heading and
 * its own row stay where it introduces several tiles. (Foundations and Governments each have three lead tiles and one more; WP52, cycle-27 review: Development Partners has the three lead tiles alone, its ">4×" tile
 * having become the +10.3 tile's `note`.)
 * WP62 (cycle-34 review): the `qualifier` option (WP57: "about" before Foundations' +$27) is gone; its one user was that tile, which the WSDFM program-record tile replaced.
 */
type EvidenceType = 'Randomized Trial' | 'Surveyed Completers' | 'Program Record' | 'Contract Scope' | 'Individual Story';
interface Tile {
  id: string;
  href: string;
  /** Page-specific wording for the tile's label (the register's glance label is the default). */
  label?: string;
  /**
   * Page-level wording for the tile's note, in place of the register's glance note (WP51, cycle-26 review: Governments shows the first sentence of GV-12's note and points to its contracts table instead of repeating Her Power's two figures,
   * which that table states; Impact keeps the full note). The page derives it from the register's note, so a change to the register's first sentence stops the build there. A `caveat` still follows it.
   */
  note?: string;
  /** A short caveat after the register's note ("contracted scopes, not a delivered-training total"). */
  caveat?: string;
  /** Other facts the tile's note rests on, added to data-fact. */
  also?: string[];
  /** Evidence type; the default follows the fact id (RC trial, OC survey, PR program record, GV contract scope). */
  evidence?: EvidenceType;
}
interface Props {
  lead: [Tile, Tile, Tile];
  more: Tile[];
  title?: string;
  moreTitle?: string;
  id?: string;
}
const { lead, more, title = 'Results at a Glance', moreTitle = 'More Results', id = 'glance' } = Astro.props;
const defaultType = (fid: string): EvidenceType => {
  const kind = fid.slice(0, 2);
  if (kind === 'RC') return 'Randomized Trial';
  if (kind === 'OC') return 'Surveyed Completers';
  if (kind === 'PR') return 'Program Record';
  if (kind === 'GV' || kind === 'SC') return 'Contract Scope';
  throw new Error(`PartnerGlance: no default evidence type for ${fid}`);
};
const toTile = (t: Tile) => {
  const f = fact(t.id);
  if (!f.stat) throw new Error(`<PartnerGlance>: fact ${t.id} has no stat`);
  const note = [t.note ?? f.stat.glance?.note, t.caveat].filter(Boolean).join(' ');
  const { figure, unit } = spellUnit(f.stat.value);
  return {
    ...t,
    value: figure,
    unit,
    // "+10.3 percentage points ... in percentage points" says the unit twice: the unit line carries it.
    label: labelWithoutUnit(t.label ?? f.stat.glance?.label ?? f.stat.label),
    note: note || undefined,
    type: t.evidence ?? defaultType(t.id),
    facts: [t.id, ...(t.also ?? [])].join(' '),
  };
};
const leadTiles = lead.map(toTile);
const moreTiles = more.map(toTile);
// One secondary tile needs no heading of its own (WP49): it is the main group's fourth tile. Several keep "More Results" and their own row.
const single = moreTiles.length === 1;
const mainTiles = single ? [...leadTiles, ...moreTiles] : leadTiles;
const groupedTiles = single ? [] : moreTiles;
---

<Section class="pg" id={id} tone="white" pad="sm" aria-labelledby={`${id}-h`}>
  <h2 class="pg__title" id={`${id}-h`}>{title}</h2>
  <ul class:list={['pg__lead', mainTiles.length === 4 && 'pg__lead--four']} role="list">
    {
      mainTiles.map((t) => (
        <li>
          <a class="pg__tile pg__tile--lead" href={linkAttrs(t.href).href} data-fact={t.facts}>
            <EvidenceTag type={t.type} />
            <span class="pg__value">{t.value}{t.unit && <>{' '}<span class="fig-unit">{t.unit}</span></>}</span>
            <span class="pg__desc">{t.label}</span>
            {t.note && <span class="pg__note">{t.note}</span>}
            <Icon name="arrow-right" size={16} />
          </a>
        </li>
      ))
    }
  </ul>
  {
    groupedTiles.length > 0 && (
      <>
        <h3 class="pg__more-title">{moreTitle}</h3>
        <ul class="pg__more" role="list">
          {groupedTiles.map((t) => (
            <li>
              <a class="pg__tile" href={linkAttrs(t.href).href} data-fact={t.facts}>
                <EvidenceTag type={t.type} />
                <span class="pg__value pg__value--sm">{t.value}{t.unit && <>{' '}<span class="fig-unit">{t.unit}</span></>}</span>
                <span class="pg__desc">{t.label}</span>
                {t.note && <span class="pg__note">{t.note}</span>}
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Section>

<style>
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h2.pg__title {
    margin: 0 0 var(--space-sm);
    color: var(--secondary);
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  @media (min-width: 768px) {
    h2.pg__title {
      letter-spacing: -0.5px;
    }
  }
  .pg__more-title {
    margin: var(--space-lg) 0 var(--space-sm);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    font-weight: var(--fw-bold);
    color: var(--on-surface-variant);
  }
  .pg__lead,
  .pg__more {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
  }
  .pg__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--stack-title);
    height: 100%;
    padding: var(--space-md);
    padding-right: var(--space-xl);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--on-surface);
    text-decoration: none;
    border: 1px solid transparent;
  }
  .pg__tile:hover {
    border-color: var(--primary);
  }
  .pg__tile :global(svg:last-child) {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    color: var(--primary);
  }
  .pg__tile :global(.evidence-tag svg:last-child) {
    position: static;
  }
  .pg__value {
    margin-top: var(--space-xs);
    font-size: var(--fs-heading-2xl);
    line-height: 1.15;
    font-weight: var(--fw-bold);
    letter-spacing: -1px;
    color: var(--secondary);
    overflow-wrap: anywhere;
  }
  .pg__value--sm {
    font-size: var(--fs-heading-xl);
  }
  .pg__desc {
    font-size: var(--fs-body-sm, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
  }
  .pg__note {
    font-size: var(--fs-body-xs, 0.8125rem);
    color: var(--on-surface-variant);
  }
  @media (min-width: 720px) {
    .pg__lead {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* four tiles (three lead tiles and the one that would have been "More Results", WP49): two by two until the row has room for four */
    .pg__lead--four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pg__more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .pg__lead--four,
    .pg__more {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* A phone: the secondary tiles are a compact list (figure, evidence type and label; the notes stay on the detail page). */
  @media (max-width: 719px) {
    .pg__more .pg__note {
      display: none;
    }
  }
</style>
