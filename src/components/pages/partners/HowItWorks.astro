---
import SubBand from './SubBand.astro';
import StepFlow from '../../ui/StepFlow.astro';

/** C8d "How it works in 3 steps", tucked under the features table it belongs to. */
interface Props {
  steps: readonly { title: string; text?: string }[];
  heading?: string;
  id?: string;
}
const { steps, heading = 'How it works in 3 steps', id = 'how-it-works' } = Astro.props;
---

<SubBand pull id={id} aria-labelledby={`${id}-h`}>
  <h3 class="t-heading-xl" id={`${id}-h`}>{heading}</h3>
  <StepFlow steps={[...steps]} />
</SubBand>
