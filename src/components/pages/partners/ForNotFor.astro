---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';

/**
 * "Is This Right for You?" (WP20b, the YouthWIDE pattern): a two-card fit check near the top of each partner page. The
 * statements are the page's own existing "right for you if / not right if" lines, moved out of the FAQ lead; no new claim is added.
 */
interface Props {
  forText: string;
  notText: string;
  id?: string;
}
const { forText, notText, id = 'for-not-for' } = Astro.props;
---

<Section id={id} tone="white" pad="sm" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Fit" title="Is This Right for You?" />
  <div class="fnf">
    <article class="fnf__card fnf__card--for" data-reveal>
      <h3 class="fnf__h t-heading-m"><Icon name="circle-check" size={22} />Right for You If</h3>
      <p>{forText}</p>
    </article>
    <article class="fnf__card" data-reveal>
      <h3 class="fnf__h t-heading-m"><Icon name="info" size={22} />Not Right for You If</h3>
      <p>{notText}</p>
    </article>
  </div>
</Section>

<style>
  .fnf {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) {
    .fnf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .fnf__card {
    padding: var(--space-gutter);
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
  }
  .fnf__card > * {
    margin: 0;
  }
  .fnf__card > * + * {
    margin-top: var(--stack-title);
  }
  .fnf__h {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--secondary);
  }
  .fnf__h :global(.icon) {
    color: var(--primary);
    flex: none;
  }
</style>
