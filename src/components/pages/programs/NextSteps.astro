---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import StepFlow from '../../ui/StepFlow.astro';

/**
 * C14 Next steps: StepFlow plus the first-action line (C14-FIRST or an audience variant) and an
 * optional note slot (for example the PD-04 timing footnote).
 */
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  steps: { title: string; text?: string }[];
  /** One first-action line (the default), or ... */
  firstAction?: string;
  /** ... two or more short role-specific first actions under one shared sequence (YouthWIDE: governments and funders, WP24c). */
  roleActions?: { role: string; text: string }[];
  tone?: 'white' | 'airy';
  id?: string;
}
const { eyebrow = 'Next Steps', title = 'What Happens Next', lead, steps, firstAction, roleActions = [], tone = 'white', id = 'next-steps' } = Astro.props;
---

<Section id={id} tone={tone} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow={eyebrow} title={title} lead={lead} />
  <StepFlow steps={steps} />
  {firstAction && <p class="next__first" data-reveal><strong>First action.</strong> {firstAction}</p>}
  {
    roleActions.length > 0 && (
      <ul class="next__roles" role="list">
        {roleActions.map((r) => (
          <li class="next__first" data-reveal><strong>{r.role}.</strong> {r.text}</li>
        ))}
      </ul>
    )
  }
  <slot />
</Section>

<style>
  .next__roles {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  .next__roles > .next__first {
    margin: 0;
  }
  .next__first {
    margin: var(--space-lg) 0 0;
    padding: var(--space-md) var(--space-gutter);
    border-left: 4px solid var(--primary);
    background: var(--surface-container-low);
    border-radius: 0 var(--radius-default) var(--radius-default) 0;
    color: var(--on-surface);
    max-width: 46rem;
  }
</style>
