---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Accordion from '../../ui/Accordion.astro';
import { buildFaq, type FaqSource } from './faq';

/** C9 Objections. Accordion from FAQ v1.2 entries plus page-specific entries; default slot follows it. */
interface Props {
  sources: FaqSource[];
  title?: string;
  lead?: string;
  eyebrow?: string;
  id?: string;
  tone?: 'ice' | 'white' | 'airy';
}
const { sources, title = 'Questions people ask', lead, eyebrow = 'Objections, Answered', id = 'faq', tone = 'ice' } = Astro.props;
const items = buildFaq(sources);
---

<Section id={id} tone={tone} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow={eyebrow} title={title} lead={lead} />
  <Accordion items={items} name={`${id}-group`} />
  <slot />
</Section>
