---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import { linkAttrs } from '../../../lib/url';

/**
 * "Find Your Program" (Programs hub): a selection table in the order If You Are… · Choose… · Outcome to Track · Start With.
 * Every cell restates content the hub cards and the program pages already carry (audiences, "which means" lines, call-to-action labels);
 * it carries no figure. Above 640 px it is a plain table; at 640 px and below each row becomes a card (src/scripts/tablestack.ts).
 */
const rows = [
  { who: 'A Government, Development Partner or Funder', choose: 'YouthWIDE', href: '/programs/youthwide/', outcome: 'Young people in paid digital work, from monthly reports on paid-work outcomes', start: 'Request a Discovery Session or, for a ministry, a briefing' },
  { who: 'A University or College', choose: 'JobReady@Campus', href: '/programs/jobready-campus/', outcome: 'Certification attempts, completions and placement evidence from student tracer surveys', start: 'Bring JobReady@Campus to Your Institution' },
  { who: 'An Employer', choose: 'JobReady@Work', href: '/programs/jobready-work/', outcome: 'Your team learning on tasks from your own roles', start: 'Plan a Training Program' },
  { who: 'A School or Education Partner', choose: 'SuperKids', href: '/programs/superkids/', outcome: 'Young learners building STEAM, coding, robotics and digital art skills', start: 'Request a Discovery Session' },
  { who: 'A Degree Holder in Bangladesh', choose: 'NU Postgraduate Diploma', href: '/programs/nu-postgraduate-diploma/', outcome: 'Digital skills added to the degree you hold', start: 'Apply Now' },
];
---

<Section id="find" tone="airy" aria-labelledby="find-h">
  <SectionHeader id="find-h" eyebrow="Compare" title="Find Your Program" lead="Start from who you are." />
  <section class="pf" aria-label="Find your program" tabindex="0" data-scroll data-stack>
    <table>
      <caption class="sr-only">Find Your Program: Who You Are, the Program to Choose, the Outcome to Track and Where to Start</caption>
      <thead>
        <tr><th scope="col">If You Are…</th><th scope="col">Choose…</th><th scope="col">Outcome to Track</th><th scope="col">Start With</th></tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">{r.who}</th>
              <td data-label="Choose…"><a class="link" href={linkAttrs(r.href).href}>{r.choose}</a></td>
              <td data-label="Outcome to Track">{r.outcome}</td>
              <td data-label="Start With">{r.start}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
  <p class="pf__route">Deciding as an institution? <a class="link" href={linkAttrs('/partner-with-us/').href}>Start with Partner with Us.</a></p>
</Section>

<script>
  import '../../../scripts/tablestack';
</script>

<style>
  .pf {
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
  }
  .pf table {
    width: 100%;
    min-width: 640px;
    font-size: var(--fs-body-base);
  }
  .pf th,
  .pf td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
  }
  .pf thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
  }
  .pf__route {
    margin: var(--space-md) 0 0;
  }
  .pf tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
  }
</style>
