---
import Badge from '../../system/Badge.astro';
import StatusTag from '../../system/StatusTag.astro';
import Stat from '../../system/Stat.astro';
import { fact } from '../../../data/facts';

/**
 * YouthWIDE priority groups (Bangladesh national initiative) (IN-03), one card per group, each with ONE headline number (WP22) and exactly one tag:
 *  - "Priority Group": unemployed graduates (WP20c: the card describes who the surveyed completers are, not a delivered YouthWIDE result, so it
 *    does not carry a "Delivered" tag)
 *  - "Priority Group": madrasah, coastal and indigenous youth as well (WP25s: they are target GROUPS, not target figures, and the card number is
 *    population context, so a "Target" status tag would read as a goal for that number; the lead above the cards says YouthWIDE aims to reach them)
 *  - "Planned" (StatusTag): third-gender people (GV-07, a program to train a stated number; enrollment is not stated)
 * Each card's number, label and note restate its register fact (OC-09, PX-12, PX-11, PX-13, GV-07 with PX-14), word for word where a clause is kept;
 * nothing is added. Group sizes overlap and are never added together (IN-03 footnote). Women are a priority in every group.
 */
interface Group {
  title: string;
  /** A status tag for a group with a stated plan; the others get a plain "Priority Group" badge. */
  status?: 'Planned';
  /** The one headline number and what it counts. */
  value: string;
  label: string;
  /** Other registered detail, in one line. */
  note?: string;
  factIds: string[];
}
// Each clause below is checked against its register fact at build time, so the card cannot drift from the register.
const must = (id: string, clause: string) => {
  if (!fact(id).text.includes(clause)) throw new Error(`PriorityGroups: ${id} no longer contains "${clause}"`);
};
must('OC-09', '84.6% hold a bachelor’s degree or higher');
must('PX-12', '50,000+ madrasahs (one-third of the education system) with 5M+ students');
must('PX-12', 'only 14% of madrasahs have a computer lab');
must('PX-11', '19 coastal districts hold 44.8M people (28% of the population)');
must('PX-11', 'net out-migration of 20–24-year-olds reached 64.9% in Jhalokathi (census 2001–2011); Cyclone Amphan (2020) displaced 2.5M people');
must('PX-13', '54+ indigenous ethnic groups');
must('PX-13', '<30% of indigenous children complete secondary school; only 3% hold salaried jobs or businesses in the Chittagong Hill Tracts');
must('GV-07', 'to provide digital-skills training to 5,000 third-gender people');
must('PX-14', 'Population estimates vary: the official estimate is 10,000; other published estimates cited in CodersTrust’s Impact Report range from 200,000 to 1.5 million');
// The graduate-unemployment rate is stated once, in the challenge band above, and is not repeated in this card.
const groups: Group[] = [
  { title: 'Unemployed Graduates', value: '84.6%', label: 'of surveyed completers across CodersTrust programs hold a bachelor’s degree or higher (October 2026 survey)', factIds: ['OC-09'] },
  { title: 'Madrasah Youth', value: '5M+', label: 'students in 50,000+ madrasahs, one-third of the education system', note: 'Only 14% of madrasahs have a computer lab.', factIds: ['PX-12'] },
  { title: 'Climate-Vulnerable Coastal Youth', value: '44.8M', label: 'people live in Bangladesh’s 19 coastal districts, 28% of the population', note: 'Net out-migration of 20–24-year-olds reached 64.9% in Jhalokathi (census 2001–2011); Cyclone Amphan (2020) displaced 2.5M people.', factIds: ['PX-11'] },
  { title: 'Indigenous Communities', value: '54+', label: 'indigenous ethnic groups', note: '<30% of indigenous children complete secondary school; only 3% hold salaried jobs or businesses in the Chittagong Hill Tracts.', factIds: ['PX-13'] },
  { title: 'Third-Gender People', status: 'Planned', value: '5,000', label: 'third-gender people to be trained, in a planned program with the Bangladesh Computer Council and Bandhu Welfare Society', note: 'Population estimates vary: the official estimate is 10,000; other published estimates cited in CodersTrust’s Impact Report range from 200,000 to 1.5 million.', factIds: ['GV-07', 'PX-14'] },
];
---

<div class="pg">
  <h3 class="pg__title t-heading-xl" data-reveal>Five Priority Groups</h3>
  <p class="pg__lead" data-reveal data-fact="IN-03 GV-07">Women are a priority in every group. Beyond unemployed graduates, YouthWIDE aims to reach madrasah, coastal and indigenous youth; third-gender programming is planned.</p>
  <ul class="pg__grid" role="list">
    {
      groups.map((g) => (
        <li class="card pg__card" data-reveal data-fact={g.factIds.join(' ')}>
          <div class="card__body">
            <p>{g.status ? <StatusTag status={g.status} /> : <Badge tone="brand">Priority Group</Badge>}</p>
            <h3 class="card__title">{g.title}</h3>
            <Stat value={g.value} label={g.label} note={g.note} count={false} />
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .pg {
    margin-top: var(--space-xl, 56px);
    display: grid;
    gap: var(--space-md);
  }
  .pg__title {
    margin: 0;
    color: var(--secondary);
  }
  .pg__lead {
    margin: 0;
    max-width: 52rem;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--on-surface);
  }
  .pg__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
  }
  .pg__card .card__body > p {
    margin: 0;
  }
  .pg__foot {
    margin: 0;
    max-width: 52rem;
    color: var(--on-surface-variant);
  }
  @media (min-width: 768px) {
    .pg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* An odd last card takes the whole row in the two-column layout, instead of standing alone beside an empty cell. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .pg__grid > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  /* Five cards: three across, then two wider cards, so the last row has no empty cell (WP21). */
  @media (min-width: 1024px) {
    .pg__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .pg__grid > li {
      grid-column: span 2;
    }
    .pg__grid > li:nth-child(n + 4) {
      grid-column: span 3;
    }
  }
</style>
