---
import Badge from '../../system/Badge.astro';
import StatusTag from '../../system/StatusTag.astro';
import Fact from '../../facts/Fact.astro';
import { fact } from '../../../data/facts';
import { graduateRates } from '../../sections/copyText';

/**
 * YouthWIDE priority groups (Bangladesh national initiative) (IN-03), one card per group, each labeled with exactly one tag:
 *  - "Priority Group": unemployed graduates (WP20c: the card describes who the surveyed completers are, not a delivered YouthWIDE result, so it
 *    does not carry a "Delivered" tag)
 *  - "Planned" (StatusTag): third-gender people (GV-07, a program to train a stated number; enrollment is not stated)
 *  - "Target" (StatusTag): madrasah, coastal and indigenous youth (YouthWIDE aims to reach them; no delivered program is claimed)
 * Group sizes overlap and are never added together (IN-03 footnote). Women are a priority in every group.
 */
interface Group {
  title: string;
  /** A status tag for a group with a stated target or plan; the others get a plain "Priority Group" badge. */
  status?: 'Target' | 'Planned';
  /** Plain sentence (with data-fact IDs), or fact IDs rendered with their canonical wording. */
  note?: { text: string; factIds: string[]; source?: string[]; delivered?: { text: string; markerId: string } };
  factIds?: string[];
}
const rates = graduateRates();
// PX-12 without its "75% of 5M+ madrasah students unemployed or under-employed (study estimate)" clause: the register names no study
// for that figure, so it is not used on the page until it is sourced. WP21: nor without its "94–97% of those surveyed want training"
// clause: the register does not say who was surveyed, so the clause has no referent here (owner content: who was surveyed).
// The rest of the sentence is the register's wording; the source is shown on the card (a footnote would print the whole fact, 75% included).
const px12 = fact('PX-12');
const madrasah = px12.text
  .split('; ')
  .filter((part) => !/^75%/.test(part) && !/^94[–-]97%/.test(part))
  .join('; ');
const groups: Group[] = [
  // The graduate-unemployment rate is stated once, in the challenge band above, and is not repeated in this card.
  { title: 'Unemployed Graduates', note: { text: '', factIds: ['OC-09'], delivered: { text: 'Most surveyed completers across CodersTrust programs hold a bachelor’s degree or higher (84.6%).', markerId: 'OC-09' } } },
  { title: 'Madrasah Youth', status: 'Target', note: { text: `${madrasah}.`, factIds: ['PX-12'], source: px12.sourceIds } },
  { title: 'Climate-Vulnerable Coastal Youth', status: 'Target', factIds: ['PX-11'] },
  { title: 'Indigenous Communities', status: 'Target', factIds: ['PX-13'] },
  { title: 'Third-Gender People', status: 'Planned', factIds: ['GV-07', 'PX-14'] },
];
---

<div class="pg">
  <h3 class="pg__title t-heading-xl" data-reveal>Five Priority Groups</h3>
  <p class="pg__lead" data-reveal data-fact="IN-03 GV-07">Women are a priority in every group. Beyond unemployed graduates, YouthWIDE aims to reach madrasah, coastal and indigenous youth; third-gender programming is planned.</p>
  <ul class="pg__grid" role="list">
    {
      groups.map((g) => (
        <li class="card pg__card" data-reveal data-fact={[...(g.factIds ?? []), ...(g.note?.factIds ?? [])].join(' ')}>
          <div class="card__body">
            <p>{g.status ? <StatusTag status={g.status} /> : <Badge tone="brand">Priority Group</Badge>}</p>
            <h3 class="card__title">{g.title}</h3>
            {g.note?.text && <p class="card__text">{g.note.text}</p>}
            {g.note?.delivered && <p class="card__text">{g.note.delivered.text}</p>}
            {g.factIds?.map((id) => <p class="card__text"><Fact id={id} /></p>)}
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .pg {
    margin-top: var(--space-xl, 56px);
    display: grid;
    gap: var(--space-md);
  }
  .pg__title {
    margin: 0;
    color: var(--secondary);
  }
  .pg__lead {
    margin: 0;
    max-width: 52rem;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--on-surface);
  }
  .pg__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
  }
  .pg__card .card__body > p {
    margin: 0;
  }
  .pg__foot {
    margin: 0;
    max-width: 52rem;
    color: var(--on-surface-variant);
  }
  @media (min-width: 768px) {
    .pg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* An odd last card takes the whole row in the two-column layout, instead of standing alone beside an empty cell. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .pg__grid > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  /* Five cards: three across, then two wider cards, so the last row has no empty cell (WP21). */
  @media (min-width: 1024px) {
    .pg__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .pg__grid > li {
      grid-column: span 2;
    }
    .pg__grid > li:nth-child(n + 4) {
      grid-column: span 3;
    }
  }
</style>
