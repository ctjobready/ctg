---
import Icon from '../../system/Icon.astro';
import CertNote from '../../ui/CertNote.astro';

/**
 * Work-entry plan per track (enhancement 3, PD-19). Tracks come from the entry-level menu (PD-10) and the credential
 * column from PD-03: those two columns are the only per-track facts, so they are the table. Everything else the plan
 * covers (target work, employer and client channels, portfolio expectations, device access, payment and platform
 * eligibility) is the same "set in co-design, approved before enrollment" for every track, so it is said once, under the
 * table, instead of as five identical cells in every row. One table at every width (two columns fit a phone).
 */
const tracks = [
  { track: 'Digital marketing', credential: 'Meta Blueprint / Google Ads' },
  { track: 'Graphic design', credential: 'Adobe Certified Professional' },
  { track: 'Video editing', credential: 'Adobe Certified Professional' },
  { track: 'Web design and development', credential: 'CWP' },
  { track: 'Digital accounting', credential: 'QuickBooks Online ProAdvisor' },
  { track: 'Python programming', credential: 'PCEP' },
  { track: 'Data analysis', credential: 'Credential chosen in co-design', open: true },
];
---

<figure class="wep" data-fact="PD-19 PD-03 PD-10" data-reveal>
  <div class="wep__table">
    <table>
      <caption class="sr-only">Work-entry plan per track: the track and its certification</caption>
      <thead>
        <tr>
          <th scope="col">Track</th>
          <th scope="col">Certification</th>
        </tr>
      </thead>
      <tbody>
        {
          tracks.map((t) => (
            <tr>
              <th scope="row">{t.track}</th>
              <td class:list={[t.open && 'wep__open']}>{t.credential}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="wep__set">
    <Icon name="clipboard-check" size={22} />
    <span>
      <strong>Set in co-design for every track, and approved before enrollment:</strong> target work, employer and client channels, portfolio expectations, device access, and payment and platform eligibility.
    </span>
  </p>
  <CertNote />
  <figcaption class="wep__caption"><strong>Illustrative work-entry plan per track: a co-designed plan, not a guarantee.</strong></figcaption>
</figure>

<style>
  .wep {
    margin: 0;
    max-width: 52rem;
  }
  .wep__table {
    overflow: hidden;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-body-base);
  }
  th,
  td {
    padding: 12px var(--space-md);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
  }
  thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
    font-weight: var(--fw-bold);
    font-size: var(--fs-body-xs);
  }
  tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
    width: 46%;
  }
  td {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .wep__open {
    color: var(--on-surface-variant);
    font-weight: var(--fw-regular);
  }
  .wep__set {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    margin: var(--space-md) 0 0;
    padding: var(--space-md);
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    color: var(--on-surface-variant);
  }
  .wep__set :global(.icon) {
    color: var(--primary);
    flex: none;
    margin-top: 1px;
  }
  .wep__set strong {
    color: var(--on-surface);
  }
  .wep__caption {
    margin-top: var(--space-md);
    color: var(--on-surface);
  }
</style>
