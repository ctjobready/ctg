---
/**
 * Who does what in a partnership (RACI). R = responsible (does the work), A = accountable (decides and answers
 * for it), C = consulted, I = informed. The roles restate arrangements the register already states
 * (co-design of groups, tracks and scorecard; monthly reports; safeguarding agreed per program; expansion is
 * the funder's decision; independent evaluation welcome); nothing new is promised.
 */
type Role = 'R' | 'A' | 'C' | 'I';
const LABEL: Record<Role, string> = { R: 'Responsible', A: 'Accountable', C: 'Consulted', I: 'Informed' };
const rows: { activity: string; ct: Role[]; partner: Role[]; local: Role[] }[] = [
  { activity: 'Agree Priority Groups and Tracks (Discovery and Co-Design)', ct: ['R'], partner: ['A'], local: ['C'] },
  { activity: 'Agree the Indicative Budget and the Pilot Scorecard (Co-Design)', ct: ['R'], partner: ['A'], local: ['C'] },
  { activity: 'Outreach, Accessible Selection and the Readiness Assessment', ct: ['A'], partner: ['I'], local: ['R'] },
  { activity: 'Training and Certification Exam Preparation', ct: ['A', 'R'], partner: ['I'], local: ['C'] },
  { activity: 'Three Months of Mentoring', ct: ['A', 'R'], partner: ['I'], local: ['C'] },
  { activity: 'Placement Support', ct: ['A', 'R'], partner: ['I'], local: ['C'] },
  { activity: 'Outcome Tracking', ct: ['A', 'R'], partner: ['I'], local: ['C'] },
  { activity: 'Monthly Reports and Tracer Surveys', ct: ['A', 'R'], partner: ['I'], local: ['C'] },
  { activity: 'Safeguarding and Data Protection, Agreed Before Enrollment', ct: ['R'], partner: ['A'], local: ['C'] },
  { activity: 'The Decision to Expand After the Pilot', ct: ['C'], partner: ['A', 'R'], local: ['I'] },
  { activity: 'Independent Evaluation, Where the Funder Wants One', ct: ['C'], partner: ['A'], local: ['I'] },
];
const cols = [
  ['CodersTrust', 'ct'],
  ['Funder or Government Partner', 'partner'],
  ['Local Implementing Partner', 'local'],
] as const;
---

<section class="raci" aria-label="Who does what in a partnership" tabindex="0" data-scroll data-reveal>
  <table>
    <caption class="sr-only">Who Does What in a Partnership: Responsible, Accountable, Consulted and Informed by Role</caption>
    <thead>
      <tr>
        <th scope="col">Activity</th>
        {cols.map(([label]) => <th scope="col">{label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.activity}</th>
            {cols.map(([label, key]) => (
              <td>
                {r[key].map((role, i) => (
                  <>
                    {i > 0 && ' '}
                    <span class={`raci__pill raci__pill--${role}`} role="img" aria-label={LABEL[role]}>{role}</span>
                  </>
                ))}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</section>
<!-- Phone layout (≤ 640 px): one card per activity, with each party's role spelled out. The table is hidden at that width, so assistive technology reads one version. -->
<ul class="raci-cards" role="list" aria-label="Who does what in a partnership">
  {
    rows.map((r) => (
      <li class="raci-card">
        <p class="raci-card__title">{r.activity}</p>
        <dl class="raci-card__list">
          {cols.map(([label, key]) => (
            <div class="raci-card__row">
              <dt>{label}</dt>
              <dd>
                {r[key].map((role, i) => (
                  <>
                    {i > 0 && ' '}
                    <span class={`raci__pill raci__pill--${role}`} aria-hidden="true">{role}</span>
                  </>
                ))}
                <span class="raci-card__words">{r[key].map((role) => LABEL[role]).join(' and ')}</span>
              </dd>
            </div>
          ))}
        </dl>
      </li>
    ))
  }
</ul>
<ul class="raci__legend t-body-xs" role="list" aria-label="Legend">
  <li><b class="raci__pill raci__pill--R">R</b><span>Responsible: does the work</span></li>
  <li><b class="raci__pill raci__pill--A">A</b><span>Accountable: decides and answers for it</span></li>
  <li><b class="raci__pill raci__pill--C">C</b><span>Consulted</span></li>
  <li><b class="raci__pill raci__pill--I">I</b><span>Informed</span></li>
</ul>

<style>
  .raci {
    position: relative;
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: separate;
    border-spacing: 0;
  }
  th,
  td {
    text-align: left;
    vertical-align: middle;
    padding: 14px var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
  }
  thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
    font-weight: var(--fw-bold);
  }
  tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
    min-width: 16rem;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  td {
    white-space: nowrap;
  }
  .raci__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    margin-right: 6px;
    padding: 0 6px;
    border-radius: var(--radius-full);
    font-weight: var(--fw-bold);
    font-size: var(--fs-body-xs);
    background: var(--surface-container-high);
    color: var(--on-secondary-container);
  }
  .raci__pill--A {
    background: var(--secondary);
    color: var(--on-secondary);
  }
  .raci__pill--R {
    background: var(--primary);
    color: var(--on-primary);
  }
  .raci__pill--C {
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
  }
  .raci__pill--I {
    background: var(--surface-container-low);
    color: var(--on-surface-variant);
    border: 1px solid var(--outline-variant);
  }
  /* The legend wears the table's own pills, in a grid: each letter stays with its words (2 × 2 on a phone, one row from 900 px). */
  .raci__legend {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-md);
    color: var(--ctx-text);
  }
  .raci__legend li {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }
  .raci__legend .raci__pill {
    flex: none;
    margin: 0;
    height: 24px;
    min-width: 24px;
    padding: 0;
    font-size: 0.8125rem;
    line-height: 1;
  }
  .raci__legend li > span {
    padding-top: 2px;
  }
  .raci-cards {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-md);
  }
  .raci-card {
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .raci-card__title {
    margin: 0;
    padding: 12px var(--space-md);
    font-weight: var(--fw-bold);
    color: var(--secondary);
    background: var(--surface-container-low);
    border-bottom: 1px solid var(--primary-fixed);
  }
  .raci-card__list {
    margin: 0;
  }
  .raci-card__row {
    padding: 10px var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
  }
  .raci-card__row:last-child {
    border-bottom: 0;
  }
  .raci-card__row dt {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
    margin-bottom: 4px;
  }
  .raci-card__row dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    color: var(--on-surface);
  }
  .raci-card__words {
    margin-left: 4px;
  }
  @media (max-width: 640px) {
    .raci {
      display: none;
    }
    .raci-cards {
      display: grid;
    }
  }
  @media (min-width: 900px) {
    .raci__legend {
      grid-template-columns: repeat(4, auto);
      justify-content: start;
      gap: var(--space-sm) var(--space-lg);
    }
  }
</style>
