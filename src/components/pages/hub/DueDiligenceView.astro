---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import { cta } from '../../../lib/mailto';
import { linkAttrs } from '../../../lib/url';
import { TRACER_MONTHS } from '../partners/partners';
import { CONTRACTING_ENTITIES } from '../../../data/copy';

/**
 * "Due Diligence in One View" (WP24a, Benchmark): what a funder, ministry or procurement team asks first, each with the page that answers it.
 * Every item restates an arrangement the register already states (ID-07, PD-13, PD-08, PD-09, PD-12, RC-01); nothing new is promised. The hub shows
 * the full band; the Employers page shows the compact one (three short rows, no icons; WP57: its "Independent Evaluation Welcome" row is gone, see below).
 *
 * WP25s: the wording follows the page's audience. `funders` (the hub) uses the cohort-reporting set above. `employers` swaps the two youth-cohort rows (follow-up
 * surveys and cohort safeguarding) for what the JobReady@Work offer itself states: the needs assessment with success measures agreed before the start, and the
 * progress evaluation against them, and says "the contracting party" where the register says "the funder". No employer-team data-protection terms are registered,
 * so none are stated here.
 *
 * WP57 (cycle-29 review, GPT-6.1 Sol G7): the employer set has no "Independent Evaluation Welcome" row: it pointed again at the youth trial (the page's "Broader Evidence from Our Youth Programs" strip links it) and the "Start with a Pilot Team,
 * Then Decide on Evidence" band right after this one has the same item. The hub keeps the row. A set of three cards is laid out in three columns from 1100 px, and in two from 720 px with the third across the row.
 *
 * WP34 (cycle-11 review): `brief` is one short item for the development-partner, government, foundation, university and local-partner pages, whose own bands already
 * state reporting, safeguarding and independent evaluation (the four cards repeated them): a heading, one sentence and one link to Governance and Accountability.
 * The hub keeps the full view above.
 */
interface Props {
  /** Compact form (Employers): a four-row list with no lead. */
  compact?: boolean;
  /** One heading, one sentence and one link instead of the four rows (WP34). */
  brief?: boolean;
  tone?: 'white' | 'airy' | 'ice';
  id?: string;
  audience?: 'funders' | 'employers';
}
const { compact = false, brief = false, tone = 'ice', id = 'due-diligence', audience = 'funders' } = Astro.props;
const diligence = cta('diligence');
const entities = `${CONTRACTING_ENTITIES}, depending on the program’s country and`;
const contracting = { icon: 'building-2', title: 'Contracting Entities', text: `${entities} the ${audience === 'funders' ? 'funder' : 'contracting party'}’s requirements.`, href: '/about/governance/#contracting', link: 'Contracting and Accountability', ids: 'ID-07 PD-13' };
const independent = { icon: 'search-check', title: 'Independent Evaluation Welcome', text: 'We support third-party evaluation of outcomes, and the randomized trial of CodersTrust’s WSDFM program is public.', href: '/impact/independent-evaluation/', link: 'Independent Evaluation', ids: 'PD-08 RC-01' };
const funderItems = [
  contracting,
  // WP45 (cycle-21 review): the hub's "Monthly Reports and Quarterly Reviews" band (#review-cycle) is gone, so this card links to where Governance answers how outcomes are tracked and reported (its FAQ, #faq).
  { icon: 'file-check', title: 'Monthly Reports and Follow-Up Surveys', text: `Included for every cohort, as agreed in the program scope: follow-up surveys at ${TRACER_MONTHS} and monthly reports.`, href: '/about/governance/#faq', link: 'How We Track Outcomes', ids: 'PD-08 PD-09' },
  { icon: 'shield', title: 'Safeguarding Agreed per Program', text: 'Consent, protected records and grievance handling are specified for each program.', href: '/about/governance/#safeguarding', link: 'How People Are Protected', ids: 'PD-12' },
  independent,
];
const employerItems = [
  contracting,
  { icon: 'clipboard-check', title: 'Needs Assessment First', text: 'A needs assessment scopes the skills and team size, and success measures are agreed before you start.', href: '/programs/jobready-work/#mechanism', link: 'How a Program Is Built', ids: 'IN-10' },
  { icon: 'chart-bar', title: 'Progress Evaluation', text: 'A progress evaluation checks results against the measures you set, as agreed in the program scope.', href: '/programs/jobready-work/#next-steps', link: 'What Happens Next', ids: 'IN-10' },
];
const items = audience === 'employers' ? employerItems : funderItems;
---

{brief ? (
  <Section id={id} tone={tone} pad="sm" aria-labelledby={`${id}-h`}>
    <div class="ddb" data-reveal>
      <p class="eyebrow">Due Diligence</p>
      <h2 class="ddb__title" id={`${id}-h`}>Confirm Contracting, Safeguarding and Reporting</h2>
      {/* the sentence rests on the contracting entity (ID-07, PD-13), the safeguarding specification (PD-12) and the reporting plan (PD-08) */}
      <p class="lead" data-fact="ID-07 PD-13 PD-12 PD-08">The contracting entity, safeguarding arrangements and reporting plan are confirmed for your program.</p>
      <p class="cluster ddb__more"><a class="link" href={linkAttrs('/about/governance/').href}>Governance and Accountability<Icon name="arrow-right" size={16} /></a></p>
    </div>
  </Section>
) : (
<Section id={id} tone={tone} pad={compact ? 'sm' : undefined} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Due Diligence" title="Due Diligence in One View" lead={compact ? undefined : 'What a funder or procurement team asks first, with the page that answers it.'} />
  <ul class:list={['ddv', compact && 'ddv--compact', items.length === 3 && 'ddv--three']} role="list">
    {items.map((d) => (
      <li class="ddv__item" data-fact={d.ids} data-reveal>
        {!compact && <Icon name={d.icon} size={28} strokeWidth={1.5} class="ddv__icon" />}
        <h3 class="ddv__title t-heading-m">{d.title}</h3>
        <p class="ddv__text">{d.text}</p>
        <a class="link ddv__link" href={linkAttrs(d.href).href}>{d.link}<Icon name="arrow-right" size={16} /></a>
      </li>
    ))}
  </ul>
  {!compact && (
    <p class="cluster ddv__more">
      <a class="link" href={linkAttrs('/impact/outcomes-2026/').href}>Impact Survey 2026<Icon name="arrow-right" size={16} /></a>
      <a class="link" href={diligence.href}>{diligence.label}<Icon name="arrow-right" size={16} /></a>
    </p>
  )}
  {compact && (
    <p class="cluster ddv__more">
      <a class="link" href={diligence.href}>{diligence.label}<Icon name="arrow-right" size={16} /></a>
    </p>
  )}
</Section>
)}

<style>
  /* Brief (WP34): the section header's rhythm (eyebrow 8, heading 12) with the link row one step (16px) under the sentence. */
  .ddb {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--stack-eyebrow);
    max-width: 52rem;
  }
  .ddb > * {
    margin: 0;
  }
  .ddb__title {
    margin-top: calc(var(--stack-heading) - var(--stack-eyebrow));
    color: var(--ctx-section-heading);
  }
  .ddb__more {
    margin-top: calc(var(--stack-link) - var(--stack-eyebrow));
  }
  .ddv {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .ddv {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .ddv {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Three cards (Employers, WP57): three columns where the four-column grid has room, else two with the odd third card across the row, so no cell is left empty */
  @media (min-width: 720px) and (max-width: 1099px) {
    .ddv--three > :last-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1100px) {
    .ddv--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ddv__item {
    padding: var(--space-gutter);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--stack-title);
  }
  .ddv__item > * {
    margin: 0;
  }
  .ddv__item :global(.ddv__icon) {
    color: var(--primary);
  }
  .ddv__title {
    color: var(--secondary);
  }
  .ddv__text {
    flex: 1;
    color: var(--on-surface-variant);
  }
  .ddv__link {
    align-self: flex-start;
    min-height: 24px;
  }
  .ddv__more {
    margin: var(--space-md) 0 0;
    gap: var(--space-xs) var(--space-lg);
  }
  /* Compact: tighter cards, the explanatory text in the small body size. */
  .ddv--compact {
    gap: var(--space-md);
  }
  .ddv--compact .ddv__item {
    padding: var(--space-md);
    box-shadow: none;
  }
  .ddv--compact .ddv__text {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
  }
</style>
