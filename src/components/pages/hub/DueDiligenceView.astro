---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import { cta } from '../../../lib/mailto';
import { linkAttrs } from '../../../lib/url';
import { TRACER_MONTHS } from '../partners/partners';

/**
 * "Due Diligence in One View" (WP24a, Benchmark): what a funder, ministry or procurement team asks first, each with the page that answers it.
 * Every item restates an arrangement the register already states (ID-07, PD-13, PD-08, PD-09, PD-12, RC-01); nothing new is promised. The hub shows
 * the full band; every audience page shows the compact one (four short rows, no icons) so a diligence reader finds the same four answers on the page they landed on.
 */
interface Props {
  /** Compact form for the audience pages: a four-row list with a one-line lead. */
  compact?: boolean;
  tone?: 'white' | 'airy' | 'ice';
  id?: string;
}
const { compact = false, tone = 'ice', id = 'due-diligence' } = Astro.props;
const diligence = cta('diligence');
const items = [
  { icon: 'building-2', title: 'Contracting Entities', text: 'CT USA, Inc. in the United States or CodersTrust Bangladesh Ltd. in Bangladesh, depending on the program’s country and the funder’s requirements.', href: '/about/governance/#contracting', link: 'Contracting and Accountability', ids: 'ID-07 PD-13' },
  { icon: 'file-check', title: 'Monthly Reports and Tracers', text: `Planned for every cohort, as agreed in the program scope: tracers at ${TRACER_MONTHS} and monthly reports.`, href: '/partner-with-us/#review-cycle', link: 'What the Reports Cover', ids: 'PD-08 PD-09' },
  { icon: 'shield', title: 'Safeguarding Agreed per Program', text: 'Consent, protected records, grievance handling and referral pathways are agreed and documented before enrollment.', href: '/about/governance/#safeguarding', link: 'How People Are Protected', ids: 'PD-12' },
  { icon: 'search-check', title: 'Independent Evaluation Welcome', text: 'We support third-party evaluation of outcomes, and the randomized trial of a predecessor program is public.', href: '/impact/independent-evaluation/', link: 'Independent Evaluation', ids: 'PD-08 RC-01' },
];
---

<Section id={id} tone={tone} pad={compact ? 'sm' : undefined} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Due Diligence" title="Due Diligence in One View" lead={compact ? undefined : 'What a funder or procurement team asks first, with the page that answers it.'} />
  <ul class:list={['ddv', compact && 'ddv--compact']} role="list">
    {items.map((d) => (
      <li class="ddv__item" data-fact={d.ids} data-reveal>
        {!compact && <Icon name={d.icon} size={28} strokeWidth={1.5} class="ddv__icon" />}
        <h3 class="ddv__title t-heading-m">{d.title}</h3>
        <p class="ddv__text">{d.text}</p>
        <a class="link ddv__link" href={linkAttrs(d.href).href}>{d.link}<Icon name="arrow-right" size={16} /></a>
      </li>
    ))}
  </ul>
  {!compact && (
    <p class="cluster ddv__more">
      <a class="link" href={linkAttrs('/impact/outcomes-2026/').href}>Impact Survey 2026<Icon name="arrow-right" size={16} /></a>
      <a class="link" href={diligence.href}>{diligence.label}<Icon name="arrow-right" size={16} /></a>
    </p>
  )}
  {compact && (
    <p class="cluster ddv__more">
      <a class="link" href={diligence.href}>{diligence.label}<Icon name="arrow-right" size={16} /></a>
    </p>
  )}
</Section>

<style>
  .ddv {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .ddv {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .ddv {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ddv__item {
    padding: var(--space-gutter);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .ddv__item > * {
    margin: 0;
  }
  .ddv__item :global(.ddv__icon) {
    color: var(--primary);
  }
  .ddv__title {
    color: var(--secondary);
  }
  .ddv__text {
    flex: 1;
    color: var(--on-surface-variant);
  }
  .ddv__link {
    align-self: flex-start;
    min-height: 24px;
  }
  .ddv__more {
    margin: var(--space-md) 0 0;
    gap: var(--space-xs) var(--space-lg);
  }
  /* Compact: tighter cards, the explanatory text in the small body size. */
  .ddv--compact {
    gap: var(--space-sm);
  }
  .ddv--compact .ddv__item {
    padding: var(--space-md);
    box-shadow: none;
  }
  .ddv--compact .ddv__text {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
  }
</style>
