---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import { fact } from '../../../data/facts';
import { spellUnit } from '../../../lib/format';
import { linkAttrs } from '../../../lib/url';
import { signedWith } from '../../sections/copyText';

/**
 * "Why Partner with CodersTrust" (WP20b): a compact proof band under the route cards of /partner-with-us/. Three tiles, each read from the
 * facts register (never retyped): the randomized trial of a predecessor program (RC-02), the survey among surveyed completers (OC-01) and the reach (SC-16:
 * learners trained since 2014; WP49, cycle-24 review: it said "young people", but the 130,000+ includes teacher and staff enrollments). The trial and the survey stay apart and each carries its own label; the reach tile is labeled as it is on Home.
 * WP31: the 12-month outcome tracking (PD-02) is a commitment, not a result, so it left these tiles; the hero line states it.
 * WP32 (cycle-9 review): the reach tile came back as the third, so the strip reads trial, survey, reach.
 * WP45 (cycle-21 review): the trial tile shows "+10.3" with "percentage points" on a line under it, not the register's "pp".
 * WP62 (cycle-34 review, Gemini): the reach tile's kicker is "Reach Since 2014", so its label is the register's glance label without " since 2014" ("learners trained"); the Impact page's tile, which has no such kicker, keeps "learners trained since 2014".
 * WP66 (owner request 2026-10-20): one line under the tiles gives the organizations with signed MOUs, agreements or contracts (SC-11) with their four categories, as the register words them (signedWith, src/components/sections/copyText.ts).
 * It is a line of the band, not a fourth tile or a new band; it says "signed" and "since 2014" (the band's heading does not carry the year), so it never reads as partnerships that are active today.
 */
interface Props {
  id?: string;
}
interface Tile {
  kicker: string;
  value: string;
  /** The figure's unit, spelled out on its own line under it (a value in "pp"). */
  unit?: string;
  label: string;
  note?: string;
  href: string;
  link: string;
  ids: string;
}
const { id = 'why-partner' } = Astro.props;
const HEADING = 'Why Partner with CodersTrust';
const signed = signedWith('SC-11', HEADING);
const rc02 = fact('RC-02');
const oc01 = fact('OC-01');
const sc16 = fact('SC-16');
if (!rc02.stat || !oc01.stat || !sc16.stat) throw new Error('WhyPartner: RC-02, OC-01 and SC-16 need a stat');
const trialFigure = spellUnit(rc02.stat.value);
// The reach tile's label without "since 2014", which its kicker says. Read from the register, never retyped; the build stops if the glance label stops ending that way.
const reachGlance = sc16.stat.glance?.label ?? sc16.stat.label;
if (!reachGlance.endsWith(' since 2014')) throw new Error('WhyPartner: SC-16 glance label no longer ends "since 2014"; update the reach tile label');
const reachLabel = reachGlance.slice(0, -' since 2014'.length);
const tiles: Tile[] = [
  {
    kicker: 'Randomized Trial of a Predecessor Program',
    value: trialFigure.figure,
    unit: trialFigure.unit,
    label: 'more employment for women offered a place',
    href: '/impact/independent-evaluation/',
    link: 'The Randomized Trial',
    ids: 'RC-02',
  },
  {
    kicker: 'Impact Survey 2026',
    value: oc01.stat.value,
    label: oc01.stat.glance?.label ?? oc01.stat.label,
    note: oc01.stat.glance?.note,
    href: '/impact/outcomes-2026/',
    link: 'Impact Survey 2026',
    ids: 'OC-01',
  },
  {
    kicker: 'Reach Since 2014',
    value: sc16.stat.value,
    label: reachLabel,
    note: sc16.stat.glance?.note,
    href: '/impact/global-reach/',
    link: 'Global Reach',
    ids: 'SC-16',
  },
];
---

<Section id={id} tone="ice" pad="sm" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="The Evidence in Brief" title={HEADING} />
  <ul class="wp" role="list">
    {
      tiles.map((t) => (
        <li class="wp__tile" data-fact={t.ids} data-reveal>
          <p class="wp__kicker">{t.kicker}</p>
          <p class="wp__value">{t.value}{t.unit && <>{' '}<span class="fig-unit">{t.unit}</span></>}</p>
          <p class="wp__desc">{t.label}</p>
          {t.note && <p class="wp__note">{t.note}</p>}
          <a class="link wp__link" href={linkAttrs(t.href).href}>{t.link}<Icon name="arrow-right" size={16} /></a>
        </li>
      ))
    }
  </ul>
  <p class="wp__signed" data-fact="SC-11" data-reveal>{signed}</p>
</Section>

<style>
  .wp {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: minmax(0, 1fr);
  }
  /* Three tiles: one column on a phone; two columns with the third across the row from the tablet breakpoint (never 2 + 1 beside an empty cell); three from 1024 px. */
  @media (min-width: 768px) {
    .wp {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .wp > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .wp {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .wp__tile {
    display: flex;
    flex-direction: column;
    gap: var(--stack-title);
    padding: var(--space-md);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
  }
  .wp__tile > p {
    margin: 0;
  }
  .wp__kicker {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
  }
  .wp__value {
    font-size: var(--fs-heading-xl);
    line-height: 1.15;
    font-weight: var(--fw-bold);
    color: var(--primary);
  }
  .wp__desc {
    color: var(--on-surface);
  }
  .wp__note {
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
  /* WP66: the signed-agreements line is body text in the muted ground colour at the reading width, a 32px step (--space-lg) under the tiles, as About's "Meet the Full Team" link sits under its cards */
  .wp__signed {
    margin: var(--space-lg) 0 0;
    max-width: var(--measure);
    color: var(--on-surface-variant);
  }
  .wp__link {
    margin-top: auto;
    padding-top: var(--space-xs);
    align-self: flex-start;
    min-height: 24px;
  }
</style>
