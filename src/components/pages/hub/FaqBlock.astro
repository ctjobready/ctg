---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Accordion from '../../ui/Accordion.astro';
import Icon from '../../system/Icon.astro';
// Imported for its global .fn marker styles (answers carry footnote markers).
import '../../facts/FootnoteMarker.astro';
import { faqItems } from '../../../lib/faq';
import { linkAttrs } from '../../../lib/url';
import type { FaqAudience } from '../../../data/faqs';

/**
 * C9-style FAQ block over the questions tagged for `audience` in src/data/faqs.ts (`all` = the hub's full
 * Q1–Q14 list; `ids` restricts and orders). Optional default slot for a lead-in block (for example the
 * "is this right for you" fit cards on Investors). The page adds the FAQPage JSON-LD from the same
 * questions (`faqJsonLd(audience, path, ids)` in lib/faq).
 */
interface Props {
  audience: FaqAudience;
  ids?: string[];
  title: string;
  eyebrow?: string;
  lead?: string;
  tone?: 'white' | 'airy' | 'ice';
  allLink?: { label: string; href: string };
  id?: string;
}
const { audience, ids, title, eyebrow = 'Objections, answered', lead, tone = 'ice', allLink, id = 'faq' } = Astro.props;
const items = faqItems(audience, ids, Astro);
---

<Section id={id} tone={tone} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow={eyebrow} title={title} lead={lead} />
  <slot />
  <Accordion items={items} name={`${id}-group`} />
  {allLink && <p class="faqb__all"><a class="link" href={linkAttrs(allLink.href).href}>{allLink.label}<Icon name="arrow-right" size={16} /></a></p>}
</Section>

<style>
  .faqb__all {
    margin: var(--space-md) 0 0;
  }
</style>
