---
import NewsCard from '../../ui/NewsCard.astro';
import { TOPICS, TOPIC_KEYS, coverAlt, newsHref, type NewsEntry } from './news';

/**
 * Topic filter + card grid. The filter is radio buttons styled as chips and the grid is filtered with
 * CSS :has(), so it works with no JavaScript at all. A tiny script only adds a live result count (for
 * screen readers) and lets /news/#recognition (or /news/#nf-recognition, the chip's own id, which is a real
 * anchor) preselect a topic.
 */
interface Props {
  posts: NewsEntry[];
}
const { posts } = Astro.props;
const counts = Object.fromEntries(TOPIC_KEYS.map((k) => [k, posts.filter((p) => p.data.topic === k).length]));
const visibleKeys = TOPIC_KEYS.filter((k) => counts[k] > 0);
// The filter rules in <style> below are written out per topic (a <style> element cannot sit inside the markup).
// Adding a topic to src/data/newsTopics.ts therefore needs one more selector there; fail the build until it has one.
const FILTER_RULES = ['partnerships', 'recognition', 'programs-events', 'leadership-advocacy', 'insights'];
const unfiltered = TOPIC_KEYS.filter((k) => !FILTER_RULES.includes(k));
if (unfiltered.length) throw new Error(`NewsGrid: add a filter rule in <style> for the new topic(s): ${unfiltered.join(', ')}`);
---

<div class="nf" data-news-filter>
  <fieldset class="nf__chips">
    <legend class="nf__legend">Filter by topic</legend>
    <div class="nf__row">
      <input class="nf__radio" type="radio" name="news-topic" id="nf-all" value="all" checked />
      <label class="nf__chip" for="nf-all">All <span class="nf__n">{posts.length}</span></label>
      {
        visibleKeys.map((k) => (
          <>
            <input class="nf__radio" type="radio" name="news-topic" id={`nf-${k}`} value={k} />
            <label class="nf__chip" for={`nf-${k}`}>{TOPICS[k]} <span class="nf__n">{counts[k]}</span></label>
          </>
        ))
      }
    </div>
  </fieldset>
  <p class="nf__status" role="status" aria-live="polite" data-news-status></p>
  <div class="grid-cards nf__grid">
    {
      posts.map((p) => (
        <div class="nf__item" data-topic={p.data.topic}>
          <NewsCard title={p.data.title} date={p.data.date} topic={TOPICS[p.data.topic]} excerpt={p.data.excerpt} image={p.data.cover} imageAlt={coverAlt(p.data.coverAlt)} href={newsHref(p)} />
        </div>
      ))
    }
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-news-filter]');
  if (root) {
    const status = root.querySelector<HTMLElement>('[data-news-status]')!;
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name="news-topic"]')];
    const items = [...root.querySelectorAll<HTMLElement>('.nf__item')];
    const update = (announce: boolean) => {
      const sel = radios.find((r) => r.checked)!;
      const shown = items.filter((i) => sel.value === 'all' || i.dataset.topic === sel.value).length;
      const label = root.querySelector(`label[for="${sel.id}"]`)?.firstChild?.textContent?.trim() ?? '';
      status.textContent = announce ? `Showing ${shown} ${shown === 1 ? 'article' : 'articles'}${sel.value === 'all' ? '' : ` in ${label}`}.` : '';
    };
    const hash = decodeURIComponent(location.hash.slice(1));
    const preset = radios.find((r) => r.value === hash || r.id === hash);
    if (preset) preset.checked = true;
    radios.forEach((r) => r.addEventListener('change', () => update(true)));
    update(false);
  }
</script>

<style>
  /* Topic filter: hide the cards of every other topic while a chip is checked (one selector per topic, see FILTER_RULES). */
  .nf:has(#nf-partnerships:checked) .nf__item:not([data-topic='partnerships']),
  .nf:has(#nf-recognition:checked) .nf__item:not([data-topic='recognition']),
  .nf:has(#nf-programs-events:checked) .nf__item:not([data-topic='programs-events']),
  .nf:has(#nf-leadership-advocacy:checked) .nf__item:not([data-topic='leadership-advocacy']),
  .nf:has(#nf-insights:checked) .nf__item:not([data-topic='insights']) {
    display: none;
  }
  .nf__chips {
    border: 0;
    margin: 0 0 var(--space-md);
    padding: 0;
    min-width: 0;
  }
  .nf__legend {
    padding: 0;
    margin-bottom: var(--space-sm);
    font-weight: var(--fw-bold);
    color: var(--on-surface);
  }
  .nf__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .nf__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .nf__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--on-surface);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition: background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard);
  }
  .nf__chip:hover {
    border-color: var(--primary);
  }
  .nf__n {
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
  .nf__radio:checked + .nf__chip {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--on-primary);
  }
  .nf__radio:checked + .nf__chip .nf__n {
    color: var(--on-primary);
  }
  .nf__radio:focus-visible + .nf__chip {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--powder-blue);
  }
  .nf__status {
    margin: 0 0 var(--space-md);
    min-height: 1.5em;
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
