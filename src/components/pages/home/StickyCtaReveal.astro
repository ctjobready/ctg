/**
 * Retired: the mobile sticky CTA bar's behaviour now lives in one place for every page that has the bar
 * (LandingLayout + src/scripts/stickycta.ts): the bar steps aside, and goes inert, while the hero's primary CTA or an
 * in-flow CTA band (`#cta`, `.cta-band`) is in view, and shows everywhere else; without JavaScript it stays visible.
 * This component renders nothing. It is kept only so the pages that still render it
 * (`<StickyCtaReveal after="router" until="cta" />`) keep compiling; remove those usages, then this file.
 */
interface Props {
  /** Ignored (the old "appears after this section" anchor). */
  after?: string;
  /** Ignored (the old "steps aside at this CTA band" anchor; `#cta` and `.cta-band` are handled generally). */
  until?: string;
}
---
