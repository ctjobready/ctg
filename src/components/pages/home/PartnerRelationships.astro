---
import PartnerStrip from '../../system/PartnerStrip.astro';
import { PARTNER_CAPTION, PARTNER_CAPTION_SENTENCE } from '../../../lib/logos';

/**
 * The partner logo wall as relationship cards (WP24a, Benchmark): the same registered partner logos (src/data/partners.ts, PA-04), grouped by the kind of
 * relationship instead of one undifferentiated run: funders and development partners, government programs, education partners, employers and industry partners.
 * Relationships, not endorsements: the caption says so, and no card implies that an organization endorses CodersTrust. Logos follow the permissions rule
 * of PartnerStrip (a logo that may not render shows the organization's name).
 * WP54 (cycle-28 review, Kimi K1): the caption is PARTNER_CAPTION in full ("Organizations we have worked with, 2014–2026. These are working relationships, not endorsements."), the one caption every logo band prints; this band added the second sentence by hand before.
 * WP166-A (marketing review R1-05, owner approval of 21 November 2026): Home shows the funders' row directly under its hero (HomeHero), captioned with the caption's first sentence ("Organizations we have worked with,
 * 2014–2026."), so the Track Record band shows the other three cards (`omit`) and the caption's second sentence once, under the full wall (`captionLast`: "These are working relationships, not endorsements.").
 */
interface Props {
  /** Relationship groups left out (shown elsewhere on the page). */
  omit?: ('development' | 'government' | 'academic' | 'private')[];
  /** The caption after the cards instead of before them. */
  captionLast?: boolean;
}
const { omit = [], captionLast = false } = Astro.props;
const groups = ([
  { title: 'Funders and Development Partners', group: 'development', label: 'Funders and development partners' },
  { title: 'Government Programs', group: 'government', label: 'Government program partners' },
  { title: 'Education Partners', group: 'academic', label: 'Education partners' },
  // WP57 (cycle-29 review, GPT-6.1 Sol P1): the group holds AWS and BASIS beside the employers, so it is "Employers and Industry Partners" (the strip's landmark name follows the heading)
  { title: 'Employers and Industry Partners', group: 'private', label: 'Employers and industry partners' },
] as const).filter((g) => !omit.includes(g.group));
/** The caption's second sentence (K1), for the wall whose first sentence is printed above it elsewhere on the page. */
const caveat = PARTNER_CAPTION.slice(PARTNER_CAPTION_SENTENCE.length).trim();
if (!caveat || caveat === PARTNER_CAPTION) throw new Error('PartnerRelationships: PARTNER_CAPTION no longer opens with PARTNER_CAPTION_SENTENCE');
---

<div class="rel">
  {!captionLast && <p class="rel__caption" data-reveal>{PARTNER_CAPTION}</p>}
  <ul class="rel__cards" role="list">
    {
      groups.map((g) => (
        <li class="rel__card" data-reveal>
          <h3 class="rel__title">{g.title}</h3>
          <PartnerStrip variant="grid" group={g.group} caption={false} label={g.label} />
        </li>
      ))
    }
  </ul>
  {captionLast && <p class="rel__caption" data-reveal>{caveat}</p>}
</div>

<style>
  .rel {
    display: grid;
    gap: var(--space-md);
  }
  .rel__caption {
    margin: 0;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
  }
  .rel__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .rel__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .rel__card {
    padding: var(--space-md);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-lg);
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    min-width: 0;
  }
  .rel__title {
    margin: 0;
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    font-weight: var(--fw-medium);
    color: var(--secondary);
  }
</style>
