---
import Section from '../../ui/Section.astro';
import Icon from '../../system/Icon.astro';
import PartnerRelationships from './PartnerRelationships.astro';
import CopyBlock from './CopyBlock.astro';
import { ORIGIN } from '../../../data/copy';
import { linkAttrs } from '../../../lib/url';

/**
 * C5 Guide (Home): the H2, ORIGIN, the method signal (TalentLEAP) and the leadership link, then the partner logos grouped into relationship cards (WP24a; PartnerRelationships).
 * WP47 (owner decision 2026-10-15): the empathy line that used to open the band, between the eyebrow and the H2 ("You need more than enrollment numbers: ..."), is gone; the band opens with its heading.
 * WP30c: the geography line (130,000+ trained, 15 countries and territories) is gone from this band: the hero card states it (WP53: the carousel's reach slide is gone), so it
 * appears once in the hero and not again here.
 * WP38 (cycle-15 review): the two authority tiles (31,200+ contract scope and 1.5M+ National University learners) are gone too: the government slide (slide 2) of the results carousel states both. The copy is one column at a reading width.
 */
interface Props {
  id?: string;
}
const { id = 'guide' } = Astro.props;
const talentleap = linkAttrs('/our-model/talentleap/');
// Review round 15, enhancement 3: named accountable people matter to government and multilateral buyers; /investors/ already links the team the same way.
const team = linkAttrs('/about/team/');
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <div class="guide">
    <div class="guide__copy">
      <p class="eyebrow" data-reveal>Our Track Record</p>
      <h2 id={`${id}-h`} data-reveal>We’ve Built This Path Since 2014</h2>
      <CopyBlock block={ORIGIN} class="guide__origin" />
      <p class="guide__method" data-fact="IN-06">
        Our method organizes skills into career paths. We call it TalentLEAP.{' '}
        <a class="link" href={talentleap.href}>How TalentLEAP Works<Icon name="arrow-right" size={16} /></a>
      </p>
      <p class="guide__leaders" data-reveal>
        <a class="link" href={team.href}>Meet the Leadership Team<Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </div>
  <PartnerRelationships />
</Section>

<style>
  .guide {
    margin-bottom: var(--space-md);
  }
  .guide__copy {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    /* the reading width the audience pages' Guide band uses (PartnerGuideBand: 48rem) */
    max-width: 48rem;
  }
  .guide__copy > * {
    margin: 0;
  }
  /* The heading takes the section-heading color of every other Home band's title (SectionHeader). It was the one Home band title left in the body-heading color; with the empathy line above it gone (WP47) it sits directly under
     the eyebrow, as in the other bands. */
  .guide__copy h2 {
    color: var(--ctx-section-heading);
  }
  .guide__origin {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface);
  }
  .guide__method {
    color: var(--on-surface-variant);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
</style>
