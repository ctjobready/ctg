---
import Section from '../../ui/Section.astro';
import Icon from '../../system/Icon.astro';
import PartnerRelationships from './PartnerRelationships.astro';
import { signedWith } from '../../sections/copyText';
import { linkAttrs } from '../../../lib/url';
import type { CopyBlock } from '../../../data/copy';

/**
 * C5 Guide (Home): the H2, the method signal (TalentLEAP) and the leadership link, then the partner logos grouped into relationship cards (WP24a; PartnerRelationships).
 * WP47 (owner decision 2026-10-15): the empathy line that used to open the band, between the eyebrow and the H2 ("You need more than enrollment numbers: ..."), is gone; the band opens with its heading.
 * WP30c: the geography line (130,000+ trained, 15 countries and territories) is gone from this band: the hero card states it (WP53: the carousel's reach slide is gone), so it
 * appears once in the hero and not again here.
 * WP38 (cycle-15 review): the two authority tiles (31,200+ contract scope and 1.5M+ National University learners) are gone too: the government slide (slide 2) of the results carousel states both. The copy is one column at a reading width.
 * WP166-A (marketing review of 21 November 2026, owner approval item 1: Home consolidated to about twelve bands):
 *   R1-05  the band's lead is the signed-agreement sentence (SC-11, "CodersTrust has signed MOUs, agreements or contracts with 70+ organizations: ..."; the heading carries "Since 2014"), where it was the launch story (ORIGIN, told on About);
 *          the funders' logo row sits under the hero (HomeHero), so the wall here is the other three relationship cards, with "These are working relationships, not endorsements." once, under it.
 *   R1-18  the TalentLEAP method sentence is in the mechanism band, where the method is explained (HomeMechanism's foot), not here.
 *   R1-19  the recognition items (AWS and HolonIQ) and the world strip are this band's second half (the default slot), so Home has one credibility band, not three.
 * WP175 (owner decisions of 28 November 2026, Q2 (a): every C5 is empathy → ORIGIN → authority → method, one line each): the band carries the four elements again. `empathy` (EMPATHY.home) is the
 * first line under the H2, `origin` the one-line ORIGIN (ORIGIN_SHORT as originShortUnder words it; Home's hero card and world strip state the count of countries, so the page passes the
 * regions form), the signed-agreement sentence, the relationship cards, the recognition items and the world strip are the authority, and `method` (METHOD.home) is the band's last line,
 * after the slot. Home says the method once, here (the mechanism band no longer prints its TalentLEAP line). Each prop is optional, so the band without them renders as before.
 */
interface Props {
  id?: string;
  /** The empathy line that opens the band's copy, directly under the H2. */
  empathy?: string;
  /** ORIGIN in one line, with its facts (data-fact). */
  origin?: CopyBlock;
  /** The method line, the band's last line (data-fact), with its link. */
  method?: { text: string; facts: string[]; link?: { label: string; href: string } };
}
const { id = 'guide', empathy, origin, method } = Astro.props;
const heading = 'We’ve Built This Path Since 2014';
// Review round 15, enhancement 3: named accountable people matter to government and multilateral buyers; /investors/ already links the team the same way.
const team = linkAttrs('/about/team/');
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <div class="guide">
    <div class="guide__copy">
      <p class="eyebrow" data-reveal>Our Track Record</p>
      <h2 id={`${id}-h`} data-reveal>{heading}</h2>
      {empathy && <p class="guide__empathy lead" data-reveal>{empathy}</p>}
      {origin && <p class="guide__from" data-fact={origin.facts.join(' ')}>{origin.text}</p>}
      <p class="guide__origin" data-fact="SC-11">{signedWith('SC-11', heading)}</p>
      <p class="guide__leaders" data-reveal>
        <a class="link" href={team.href}>Meet the Leadership Team<Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </div>
  <PartnerRelationships omit={['development']} captionLast />
  <slot />
  {
    method && (
      <p class="guide__method" data-fact={method.facts.length ? method.facts.join(' ') : undefined}>
        {method.text}{' '}
        {method.link && <a class="link" href={linkAttrs(method.link.href).href}>{method.link.label}<Icon name="arrow-right" size={16} /></a>}
      </p>
    )
  }
</Section>

<style>
  .guide {
    margin-bottom: var(--space-md);
  }
  .guide__copy {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    /* the reading width the audience pages' Guide band uses (PartnerGuideBand: 48rem) */
    max-width: 48rem;
  }
  .guide__copy > * {
    margin: 0;
  }
  /* The heading takes the section-heading color of every other Home band's title (SectionHeader). It was the one Home band title left in the body-heading color; with the empathy line above it gone (WP47) it sits directly under
     the eyebrow, as in the other bands. */
  .guide__copy h2 {
    color: var(--ctx-section-heading);
  }
  .guide__origin {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface);
  }
  /* WP175: the origin line, in the audience pages' origin-line colour (PartnerGuideBand .pg__origin) */
  .guide__from {
    color: var(--on-surface-variant);
  }
  /* WP175: the method line closes the band, one section step under the world strip, at the band's reading width */
  .guide__method {
    margin: var(--space-xl) 0 0;
    max-width: 48rem;
    color: var(--on-surface-variant);
  }
  /* WP166-A (R1-19): the world strip closes the band, one section step under the recognition items */
  :global(.guide__world) {
    margin-top: var(--space-xl);
  }
</style>
