---
import Section from '../../ui/Section.astro';
import Icon from '../../system/Icon.astro';
import FactStat from '../../facts/FactStat.astro';
import { fact } from '../../../data/facts';
import PartnerStrip from '../../system/PartnerStrip.astro';
import CopyBlock from './CopyBlock.astro';
import { EMPATHY, ORIGIN, type CopyBlock as CopyBlockData } from '../../../data/copy';
import { linkAttrs } from '../../../lib/url';
import { PARTNER_CAPTION } from '../../../lib/logos';

/**
 * C5 Guide (Home), empathy first: the empathy line opens the band, then the H2, ORIGIN, the method signal
 * (TalentLEAP) and four authority figures with the partner logo marquee (the marquee is the partner line).
 */
interface Props {
  id?: string;
}
const { id = 'guide' } = Astro.props;
const talentleap = linkAttrs('/our-model/talentleap/');
// WP19, item 14: ONE geography line, in "young people" (SC-16's wording): the SC-01 and SC-03 tiles that said the same are gone. The count of other
// locations is SC-03's 15 less Bangladesh, so it is derived, not typed.
const reachFigure = fact('SC-16').stat?.value;
const locations = fact('SC-03').stat?.numeric;
if (!reachFigure || locations === undefined) throw new Error('HomeGuide: SC-16 or SC-03 no longer has the stat the geography line reads');
const reach: CopyBlockData = {
  text: `${reachFigure} young people trained since ${fact('ID-02').stat?.value}, most in Bangladesh; programs have also run in ${locations - 1} other countries and territories.`,
  facts: ['SC-16', 'SC-03'],
};
// Review round 15, enhancement 3: named accountable people matter to government and multilateral buyers; /investors/ already links the team the same way.
const team = linkAttrs('/about/team/');
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <div class="guide">
    <div class="guide__copy">
      <p class="eyebrow" data-reveal>Our Track Record</p>
      <p class="guide__empathy" data-reveal>{EMPATHY.home}</p>
      <h2 id={`${id}-h`} data-reveal>We’ve Built This Path Since 2014.</h2>
      <CopyBlock block={ORIGIN} class="guide__origin" />
      <p class="guide__method" data-fact="IN-06">
        TalentLEAP, our method, organizes skills into career paths with progressive levels.{' '}
        <a class="link" href={talentleap.href}>How TalentLEAP Works<Icon name="arrow-right" size={16} /></a>
      </p>
      <p class="guide__leaders" data-reveal>
        <a class="link" href={team.href}>Meet the Leadership Team<Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
    <div class="guide__panel" data-reveal>
      <CopyBlock block={reach} class="guide__reach" />
      <FactStat id="SC-06" />
      <FactStat id="SC-04" />
    </div>
  </div>
  <PartnerStrip variant="marquee" caption={PARTNER_CAPTION} />
</Section>

<style>
  .guide {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }
  .guide__copy {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .guide__copy > * {
    margin: 0;
  }
  .guide__empathy {
    font-size: var(--fs-heading-l);
    line-height: var(--lh-heading-l);
    font-weight: var(--fw-medium);
    color: var(--secondary);
    padding-left: var(--space-md);
    border-left: 4px solid var(--tertiary);
    max-width: 36rem;
  }
  .guide__origin {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface);
  }
  .guide__method {
    color: var(--on-surface-variant);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  .guide__panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-gutter);
    align-content: center;
    padding: var(--space-lg) var(--space-gutter);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  /* the SC-01 / SC-03 qualifier sits directly under the two tiles it qualifies and spans the panel */
  .guide__panel :global(.guide__reach) {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--fs-body-base);
    color: var(--on-surface-variant);
  }
  .guide__panel :global(.stat--lg .stat__value) {
    font-size: var(--fs-heading-3xl);
    line-height: 1.15;
  }
  @media (min-width: 1024px) {
    .guide {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 56px;
      align-items: center;
    }
    .guide__panel {
      padding: var(--space-lg);
    }
  }
</style>
