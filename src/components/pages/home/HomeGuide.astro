---
import Section from '../../ui/Section.astro';
import Icon from '../../system/Icon.astro';
import PartnerRelationships from './PartnerRelationships.astro';
import CopyBlock from './CopyBlock.astro';
import { EMPATHY, ORIGIN } from '../../../data/copy';
import { linkAttrs } from '../../../lib/url';

/**
 * C5 Guide (Home), empathy first: the empathy line opens the band, then the H2, ORIGIN, the method signal
 * (TalentLEAP) and the leadership link, then the partner logos grouped into relationship cards (WP24a; PartnerRelationships).
 * WP30c: the geography line (130,000+ trained, 15 countries and territories) is gone from this band: the hero card and the reach slide state it, so it
 * appears twice on the page and not three times.
 * WP38 (cycle-15 review): the two authority tiles (31,200+ contract scope and 1.5M+ National University learners) are gone too: slide 6 of the results carousel states both. The copy is one column at a reading width.
 */
interface Props {
  id?: string;
}
const { id = 'guide' } = Astro.props;
const talentleap = linkAttrs('/our-model/talentleap/');
// Review round 15, enhancement 3: named accountable people matter to government and multilateral buyers; /investors/ already links the team the same way.
const team = linkAttrs('/about/team/');
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <div class="guide">
    <div class="guide__copy">
      <p class="eyebrow" data-reveal>Our Track Record</p>
      <p class="guide__empathy" data-reveal>{EMPATHY.home}</p>
      <h2 id={`${id}-h`} data-reveal>We’ve Built This Path Since 2014</h2>
      <CopyBlock block={ORIGIN} class="guide__origin" />
      <p class="guide__method" data-fact="IN-06">
        Our method organizes skills into career paths with progressive levels. We call it TalentLEAP.{' '}
        <a class="link" href={talentleap.href}>How TalentLEAP Works<Icon name="arrow-right" size={16} /></a>
      </p>
      <p class="guide__leaders" data-reveal>
        <a class="link" href={team.href}>Meet the Leadership Team<Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </div>
  <PartnerRelationships />
</Section>

<style>
  .guide {
    margin-bottom: var(--space-md);
  }
  .guide__copy {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    /* the reading width the audience pages' Guide band uses (PartnerGuideBand: 48rem) */
    max-width: 48rem;
  }
  .guide__copy > * {
    margin: 0;
  }
  .guide__empathy {
    font-size: var(--fs-heading-l);
    line-height: var(--lh-heading-l);
    font-weight: var(--fw-medium);
    color: var(--secondary);
    padding-left: var(--space-md);
    border-left: 4px solid var(--tertiary);
    max-width: 36rem;
  }
  .guide__origin {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface);
  }
  .guide__method {
    color: var(--on-surface-variant);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
</style>
