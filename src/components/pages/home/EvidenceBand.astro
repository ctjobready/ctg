---
import { titleCase } from '../../../lib/titleCase.mjs';
import Section from '../../ui/Section.astro';
import Stat from '../../system/Stat.astro';
import BeforeAfter from '../../ui/BeforeAfter.astro';
import Icon from '../../system/Icon.astro';
import { fact } from '../../../data/facts';
import { RCT_COMPARISON, TRIAL_BAND_HEADING, TRIAL_LINE, TRIAL_SENTENCE } from '../../../data/copy';
import { linkAttrs } from '../../../lib/url';
import { endSentence } from '../../sections/copyText';

/**
 * C7 evidence band (Klein). Page-local variant of the shared ProofBand with one difference: where a survey
 * figure rests on a small analytic base (OC-02: "n = 47 completers (34 earning)"), the base is printed inside
 * the stat label itself ("… — 34 of 47 surveyed completers"), not only in the footnote (review round 5).
 * Everything else matches ProofBand: the RCT headline is the H2 (RC-01), FactStats with automatic footnotes,
 * a before→after chart derived from OC-01, evidence links and a slot for extras. The named slot `ladder` sits between the
 * figures and the links: Home puts the compact evidence ladder there (review round 9, enhancement 1).
 */
interface Props {
  title: string;
  lead?: string;
  /** Trial tiles, under their own heading ("From the Randomized Trial"); may be empty (the Programs hub states the trial as one line, `trialLine`). */
  statIds: string[];
  /** Survey tiles, under their own heading ("From the October 2026 Survey"), apart from the trial (WP17, item 4). */
  surveyStatIds?: string[];
  /**
   * Which chart the band carries. `survey` (default): the before/after employment of surveyed completers, from `chartId` (OC-01).
   * `trial`: the randomized trial's comparison, employment at follow-up for the control group beside women offered a place
   * (RC-02; figures read from its text by RCT_COMPARISON). Home used `trial` (review round 13, enhancement 2); the survey chart
   * stays on /impact/ and /impact/outcomes-2026/. `none` (WP41, cycle-18 review): no chart, and the band is one column; the Programs hub states the trial result as one line instead.
   */
  chart?: 'survey' | 'trial' | 'none';
  chartId?: string;
  chartTitle?: string;
  /** `trial` chart only: draw the "+10.3 percentage points" chip on the chart. Off when a tile beside it already states the difference. */
  chip?: boolean;
  headlineFact?: string;
  /**
   * WP32 (YouthWIDE): state the trial result once, as the single sentence TRIAL_SENTENCE, in place of the RC-01 headline, which said it twice in a row.
   * The tiles, the chart and the links stay.
   */
  trialSentence?: boolean;
  /**
   * WP41 (Programs hub, cycle-18 review): state the trial result as ONE line, TRIAL_LINE (the employment result in plain words), and nothing more of the trial: pass `chart="none"` and no `statIds`, so there is no tile and no chart.
   * (The [PLAIN-LINE] that `plainLine` used to print here is required only on /impact/independent-evaluation/ and the WSDFM case study, scripts/check-facts.mjs.)
   */
  trialLine?: boolean;
  links?: { label: string; href: string }[];
  /** Show each survey tile's detail line under its label (default true). The Programs hub leaves them out (WP31): its tile states the result alone. */
  surveyNotes?: boolean;
  /**
   * Home (WP19, item 25): the band's H2 is `bandHeading` ("Trial and Survey Evidence") and the trial gets its own sub-heading `trialHeading`
   * ("An Independent Randomized Trial") over its headline, plain line and chart, so the survey tiles under their own sub-heading are never
   * nested under the trial heading. Without them the H2 is the trial heading.
   */
  bandHeading?: string;
  trialHeading?: string;
  id?: string;
}
const { title, lead, statIds, surveyStatIds = [], chart = 'survey', chartId = 'OC-01', chartTitle, headlineFact, trialSentence = false, trialLine = false, chip = true, links = [], surveyNotes = true, bandHeading, trialHeading, id = 'proof-band' } = Astro.props;
const split = !!trialHeading;
const trial = chart === 'trial';
const showChart = chart !== 'none';
// Same structure as ProofBand: a short H2 when the randomized trial heads the band.
const heading = bandHeading ?? (headlineFact ? TRIAL_BAND_HEADING : titleCase(title));
const headlineText = headlineFact ? (fact(headlineFact).headline ?? fact(headlineFact).text) : undefined;
const employmentLine: string | undefined = undefined; // RC-01's headline now leads with the +10.3 pp employment result (WP7).
// The one statement of the trial result, by option: the single sentence (YouthWIDE), the one-line employment result (the Programs hub) or the register's RC-01 headline.
const statement: { text: string; facts: string } | undefined = trialSentence
  ? { text: TRIAL_SENTENCE.text, facts: TRIAL_SENTENCE.facts.join(' ') }
  : trialLine
    ? { text: TRIAL_LINE.text, facts: TRIAL_LINE.facts.join(' ') }
    : headlineFact && headlineText
      ? { text: headlineText, facts: headlineFact }
      : undefined;

const tile = (sid: string) => {
  const f = fact(sid);
  if (!f.stat) throw new Error(`EvidenceBand: fact ${sid} has no stat`);
  const label = f.stat.label;
  return { id: sid, value: f.stat.value, numeric: f.stat.numeric !== undefined, label, detail: f.stat.detail };
};
const stats = statIds.map(tile);
const surveyStats = surveyStatIds.map(tile);

// Survey chart: OC-01's before → after. Trial chart: RC-02's control group and women offered a place (a comparison of two groups at follow-up).
const cf = fact(trial ? 'RC-02' : chartId);
let after: number | undefined;
let before: number | undefined;
let delta: string;
if (trial) {
  before = RCT_COMPARISON.control;
  after = RCT_COMPARISON.offered;
  delta = RCT_COMPARISON.delta;
} else {
  after = cf.stat?.numeric;
  before = cf.stat?.from ? parseFloat(cf.stat.from.replace(/[^0-9.]/g, '')) : undefined;
  if (after === undefined || before === undefined) throw new Error(`EvidenceBand: fact ${chartId} needs stat.numeric and stat.from`);
  delta = `+${(after - before).toFixed(cf.stat?.decimals ?? 1)} pp`;
}
const unit = trial ? '%' : (cf.stat?.suffix ?? '%');
const chartHeading = chartTitle ?? (trial ? 'Employment at Follow-Up (Nov–Dec 2021), Randomized Trial' : 'Self-Reported Employment Among Surveyed Completers');
---

<Section id={id} tone="klein" aria-labelledby={`${id}-h`}>
  <header class="eb__head" data-reveal data-fact={headlineFact}>
    <p class="eyebrow">The Evidence</p>
    <h2 class="eb__title" id={`${id}-h`}>{heading}</h2>
    {!split && statement && <p class="lead eb__headline" data-fact={statement.facts}>{statement.text}</p>}
    {employmentLine && <p class="lead eb__employment" data-fact="RC-02">{employmentLine}</p>}
    {lead && <p class="lead">{lead}</p>}
  </header>
  <div class:list={['eb', !showChart && 'eb--single']}>
    <div class="eb__group">
      {split && <h3 class="eb__sub t-heading-l">{trialHeading}</h3>}
      {!split && surveyStats.length > 0 && <h3 class="eb__sub t-heading-l">From the Randomized Trial</h3>}
      {split && statement && <p class="lead eb__headline" data-fact={statement.facts}>{statement.text}</p>}
      {
        stats.length > 0 && (
          <div class="eb__stats">
            {stats.map((s, i) => (
              <div class="eb__stat" data-fact={s.id}>
                <Stat value={s.value} label={s.label} note={s.detail} tone={i % 2 === 0 ? 'dark' : 'accent'} size="lg" count={s.numeric}>
                </Stat>
              </div>
            ))}
          </div>
        )
      }
    </div>
    {
      showChart && (
        <div class="eb__chart">
          {trial ? (
            <>
              <BeforeAfter
                mode="comparison"
                title={chartHeading}
                before={{ label: 'Control Group', value: before }}
                after={{ label: 'Offered a Place', value: after }}
                delta={delta}
                chip={chip}
                unit={unit}
                tone="dark"
              />
              <p class="eb__fn" data-fact="RC-02">Chart data: employment at follow-up, women offered a place and the control group.</p>
            </>
          ) : (
            <>
              <BeforeAfter
                title={chartHeading}
                before={{ label: 'Before', value: before, caption: 'Before Training' }}
                after={{ label: 'October 2026 Survey', value: after, caption: 'Surveyed Completers' }}
                delta={delta}
                unit={unit}
                tone="dark"
              />
              <p class="eb__fn">Chart data: {endSentence(cf.stat?.label ?? '')}</p>
            </>
          )}
        </div>
      )
    }
  </div>
  {
    surveyStats.length > 0 && (
      <div class="eb__survey" data-reveal>
        <h3 class="eb__sub t-heading-l">From the October 2026 Survey</h3>
        <div class="eb__stats eb__stats--survey">
          {surveyStats.map((s, i) => (
            <div class="eb__stat" data-fact={s.id}>
              <Stat value={s.value} label={s.label} note={surveyNotes ? s.detail : undefined} tone={i % 2 === 0 ? 'dark' : 'accent'} size="lg" count={s.numeric} />
            </div>
          ))}
        </div>
      </div>
    )
  }
  <slot name="ladder" />
  {
    links.length > 0 && (
      <ul class="eb__links" role="list">
        {links.map((l) => <li><a class="link" href={linkAttrs(l.href).href}>{l.label}<Icon name="arrow-right" size={16} /></a></li>)}
      </ul>
    )
  }
  <slot />
</Section>

<style>
  .eb__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    max-width: 52rem;
  }
  .eb__head > * {
    margin: 0;
  }
  .eb__title {
    color: var(--ctx-section-heading);
  }
  .eb {
    display: grid;
    gap: var(--space-lg);
  }
  .eb__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-gutter);
    align-content: start;
  }
  .eb__stat {
    min-width: 0;
  }
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h3.eb__sub {
    margin: 0 0 var(--space-md);
    color: var(--ctx-section-heading);
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  @media (min-width: 768px) {
    h3.eb__sub {
      letter-spacing: -0.5px;
    }
  }
  .eb__group > .eb__headline {
    margin: 0 0 var(--space-md);
  }
  /* the trial line with no tile under it ends its group (WP41) */
  .eb__group > .eb__headline:last-child {
    margin-bottom: 0;
  }
  .eb__survey {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--ctx-border);
  }
  @media (min-width: 720px) {
    .eb__stats--survey {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .eb__fn {
    margin: var(--space-xs) 0 0;
    font-size: var(--fs-body-xs);
    color: var(--ctx-muted);
  }
  .eb__links {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }
  /* a band with no chart (`chart="none"`, WP41) is one column: the trial line has no tile or chart beside it */
  @media (min-width: 1024px) {
    .eb:not(.eb--single) {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      align-items: center;
    }
  }
</style>
