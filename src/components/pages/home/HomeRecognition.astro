---
import Section from '../../ui/Section.astro';
import AsCoveredBy from '../../ui/AsCoveredBy.astro';
import Icon from '../../system/Icon.astro';
import { linkAttrs } from '../../../lib/url';
import { fact } from '../../../data/facts';

/**
 * Third-party recognition, one quiet band after the program case cards (WP17, item 4). WP30c (cycle-7 review, GLM): it leads with the strongest current
 * third-party proof the site holds (the university partners, PA-05, and the AWS Authorized Training Partner status, PA-06) and keeps the
 * HolonIQ listing (PA-08) third. The 2014–2016 press list (PA-09) no longer opens the band: it lives on the Recognition and Media page, one link away.
 */
interface Props {
  id?: string;
}
const { id = 'recognition' } = Astro.props;
// PA-05 reads "University partners: National University (...); University for Peace (UPEACE), the UN-mandated university; The City College of New York (CCNY), a memorandum of understanding (MoU) partner since 2024".
// The band's heading names the group, so the sentence keeps the register's list without its "University partners: " lead-in.
const pa05 = /^University partners: (.+)$/.exec(fact('PA-05').text);
if (!pa05) throw new Error('HomeRecognition: PA-05 no longer reads "University partners: ..."');
// PA-08 reads "CodersTrust Was Listed in the HolonIQ South Asia EdTech 100 in 2023 (STEAM Category) and 2024": the sentence keeps the register's dates and category,
// and the list's name moves into the heading above it.
const pa08 = /^CodersTrust Was Listed in the HolonIQ South Asia EdTech 100 (in 2023 \(STEAM Category\) and 2024)$/.exec(fact('PA-08').text);
if (!pa08) throw new Error('HomeRecognition: PA-08 no longer reads "CodersTrust Was Listed in the HolonIQ South Asia EdTech 100 in 2023 (STEAM Category) and 2024"');
// PA-06 reads "AWS Authorized Training Partner". WP52 (cycle-27 review, Kimi m2): the badge title is that name and the line under it is the status as a sentence ("CodersTrust is an AWS Authorized Training Partner."), as the two items beside it have a line under their titles.
const pa06 = fact('PA-06').text;
if (pa06 !== 'AWS Authorized Training Partner') throw new Error('HomeRecognition: PA-06 no longer reads "AWS Authorized Training Partner"');
const items = [
  // WP63 (cycle-35 review, Gemini M3): "University Partners" (it said "University and UN-Mandated Partners", but only UPEACE is UN-mandated; PA-05's own line under the heading still says so).
  { id: 'PA-05', icon: 'landmark', title: 'University Partners', text: `${pa05[1]}.` },
  { id: 'PA-06', icon: 'cloud', title: pa06, text: `CodersTrust is an ${pa06}.` },
  { id: 'PA-08', icon: 'award', title: 'HolonIQ South Asia EdTech 100', text: `CodersTrust was listed ${pa08[1].replace('STEAM Category', 'STEAM category')}.` },
];
---

<Section id={id} tone="white" pad="sm" aria-labelledby={`${id}-h`}>
  <h2 class="rec__title t-heading-l" id={`${id}-h`}>Partners and Recognition</h2>
  {
    items.map((i) => (
      <div class="rec__badge" data-fact={i.id}>
        <Icon name={i.icon} size={20} />
        <div>
          <h3 class="rec__badge-title">{i.title}</h3>
          {i.text && <p class="rec__badge-text">{i.text}</p>}
        </div>
      </div>
    ))
  }
  <!-- WP55 (synthesis 3.5): the press line under the three badges. WP62 (cycle-34 review): one pointer sentence to Recognition and Media, where the outlets and the World Bank pages are listed with their links (it was that list, as text links). -->
  <AsCoveredBy variant="pointer" class="rec__covered" />
  <p class="rec__press">
    <a class="link" href={linkAttrs('/about/recognition/').href}>See All Recognition and Media<Icon name="arrow-right" size={16} /></a>
  </p>
</Section>

<style>
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h2.rec__title {
    margin: 0 0 var(--space-sm);
    color: var(--secondary);
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  @media (min-width: 768px) {
    h2.rec__title {
      letter-spacing: -0.5px;
    }
  }
  .rec__badge {
    margin: 0 0 var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-lg);
    color: var(--on-surface);
    max-width: max-content;
  }
  .rec__badge-title {
    margin: 0;
    font: var(--fw-bold) var(--fs-body-base) / var(--lh-body-base) var(--font-sans);
    color: var(--secondary);
  }
  .rec__badge-text {
    margin: 0;
    font-size: var(--fs-body-xs);
  }
  .rec__badge :global(.icon) {
    color: var(--primary);
    flex: none;
  }
  .rec__press {
    margin: 0;
    color: var(--on-surface);
  }
  /* WP55: the press line sits one step (16px) under the badges, and the link row one step under it */
  :global(.rec__covered) {
    margin: var(--space-md) 0 var(--space-md);
  }
</style>
