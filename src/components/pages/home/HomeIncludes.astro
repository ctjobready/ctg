---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';

/**
 * C8 What Your Partnership Includes (Home): three short cards, each a heading and one or two sentences (WP38, cycle-15 review).
 * The shared FeaturesTable lays a concern, an inclusion and a benefit out in labelled parts ("Funder Concern Addressed", "What Is Included", "Practical Benefit"), which reads as a matrix; it stays on the
 * audience and program pages. Home states what the partnership includes, once.
 * The cards still answer the three ranked pains of the C2 band (#problem), in that order: each carries `data-relieves` ("P1" to "P3"), so scripts/check-facts.mjs keeps its one-to-one map, and `data-fact` ties the card to
 * the register facts its sentences rest on. The band keeps its id (#features) and its place.
 */
interface Card {
  icon: string;
  title: string;
  text: string;
  /** The ranked pain (C2 band) this card answers: "P1" to "P3". */
  painId: string;
  /** Register fact ids the card rests on. */
  facts: string[];
}
interface Props {
  title: string;
  cards: Card[];
  id?: string;
}
const { title, cards, id = 'features' } = Astro.props;
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="What You Get" title={title} />
  <ul class="grid-cards inc" role="list">
    {
      cards.map((c) => (
        <li class="card inc__card" data-relieves={c.painId} data-fact={c.facts.join(' ')} data-reveal>
          <div class="card__body">
            <Icon name={c.icon} size={36} strokeWidth={1.5} class="inc__icon" />
            <h3 class="card__title">{c.title}</h3>
            <p class="card__text">{c.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .inc {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .inc__card :global(.inc__icon) {
    color: var(--primary);
  }
</style>
