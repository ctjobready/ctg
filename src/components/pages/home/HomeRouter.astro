---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import CategoryCard from '../../system/CategoryCard.astro';
import Icon from '../../system/Icon.astro';
import { audiences } from '../../../data/nav';
import { fact } from '../../../data/facts';
import { COURSES_URL } from '../../../lib/site';
import { linkAttrs } from '../../../lib/url';

/**
 * Audience router: four large cards for the funder routes (doc 01 §3, doc 06 P1 row 3), one line of links for the other four
 * audiences, then a quiet text link for learners. Descriptions reuse nav.ts so the router and the menus never drift.
 */
interface Props {
  id?: string;
}
const { id = 'router' } = Astro.props;
const text = (aid: string) => audiences.find((a) => a.id === aid)?.text;
const investors = audiences.find((a) => a.id === 'investors');
if (!investors) throw new Error('HomeRouter: the investors audience is missing from nav.ts');
/** JobReady's definition, as IN-04 registers it ("JobReady is CodersTrust’s digital learning and earning platform, ..."); the build stops if the register stops opening with it. */
const jobready = /^JobReady is (CodersTrust’s digital learning and earning platform)\b/.exec(fact('IN-04').text)?.[1];
if (!jobready) throw new Error('HomeRouter: IN-04 no longer opens "JobReady is CodersTrust’s digital learning and earning platform"');
// WP19, item 9: the four funder routes are the cards; the other four audiences are one "Also for" line of links.
// WP166-A (marketing review R1-04, owner approval of 21 November 2026): Home's router is the page's main hand-off, so each card states the benefit its page opens with, in that page's own words (the Development Partners
// H1, the Governments H1, the Investors definition of JobReady), where three of the four listed inputs or used a name Home never defines ("JobReady's staged rollout"). The menus and the 404 router keep nav.ts's lines.
const cards = [
  { title: 'Development Partners and NGOs', icon: 'globe', text: 'Report youth employment results, not just training numbers', href: '/partner-with-us/development-partners/' },
  { title: 'Governments', icon: 'landmark', text: 'Build a national digital workforce through graduates and digital labs', href: '/partner-with-us/governments/' },
  { title: 'Foundations and CSR', icon: 'heart-handshake', text: text('foundations'), href: '/partner-with-us/foundations/' },
  // WP32 (cycle-9 review) called this card "Impact Investors" (the Investors page's audience, owner decision 2026-10-14). WP49 (cycle-24 review): it is "Investors", the title the menu, the footer and the partner hub use, read from nav.ts so they cannot differ.
  // WP109 (Opus Low run 1): Home's card was a fragment, "Back JobReady’s staged rollout"; WP166-A (R1-04): "Back JobReady, CodersTrust’s digital learning and earning platform" (IN-04's definition), so Home defines JobReady where it first names it.
  { title: investors.title, icon: 'trending-up', text: `Back JobReady, ${jobready}`, href: '/partner-with-us/investors/' },
];
const also = [
  { label: 'Local Partners', href: '/partner-with-us/local-partners/' },
  { label: 'Universities and Colleges', href: '/partner-with-us/universities/' },
  { label: 'Employers', href: '/partner-with-us/employers/' },
  { label: 'NU Post Graduate Diploma Applicants', href: '/programs/nu-postgraduate-diploma/' },
];
const learners = linkAttrs(COURSES_URL);
// Review round 15, enhancement 1: diligence teams reach /about/governance/ from the top of the funnel, not only from the footer or the About menu.
const governance = linkAttrs('/about/governance/');
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Your Next Step" title="What Brings You Here?" />
  <div class="grid-cards grid-cards--4 router">
    {cards.map((c) => <CategoryCard title={c.title} icon={c.icon} text={c.text} href={c.href} />)}
  </div>
  <p class="router__also" data-reveal>
    Also for:{' '}
    {also.map((a, i) => <><a class="link" href={linkAttrs(a.href).href}>{a.label}</a>{i < also.length - 1 ? ', ' : ''}</>)}
  </p>
  <p class="router__diligence" data-reveal>
    <a class="link" href={governance.href}>Conducting Due Diligence? See Our Governance and Evidence<Icon name="arrow-right" size={16} /></a>
  </p>
  <p class="router__learners" data-reveal>
    <a class="link" href={learners.href} rel={learners.rel}>
      Learners: Courses on JobReady.global<Icon name="arrow-up-right" size={16} />
      <span class="sr-only"> {learners.srText}</span>
    </a>
  </p>
</Section>

<style>
  .router__also {
    margin: var(--space-lg) 0 0;
    max-width: 60rem;
  }
  .router__diligence {
    margin: var(--space-md) 0 0;
  }
  .router__learners {
    margin: var(--space-sm) 0 0;
  }
</style>
