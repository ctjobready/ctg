---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import ModelDiagram from '../../ui/ModelDiagram.astro';
import Icon from '../../system/Icon.astro';
import PositioningStatement from '../../sections/PositioningStatement.astro';
import { WHERE_THEY_WORK_TEXT } from '../partners/partners';
import { DELIVERY_MODEL } from '../../../data/copy';
import { fact } from '../../../data/facts';
import { linkAttrs } from '../../../lib/url';

/**
 * C6 Mechanism (page-local variant of the shared MechanismBand). Same content and diagram, but the tone
 * is a prop: on Home the evidence band (C7) that follows is the Klein "impact moment", and the system
 * rule is that two dark bands never sit back to back, so the mechanism band stays light here.
 * WP39 (cycle-16 review): Investors' band carries no positioning statement any more (it restated the hero), so the `statementFirst` option, which opened that band with the statement, is gone.
 * WP62 (cycle-34 review, Gemini): the "Where They Work" card says how long outcomes are tracked, "... outcome tracking for 12 months after each course." (the months are PD-02's, as Development Partners reads them).
 * WP67 (cycle-38 review, Sonnet): the card's text is WHERE_THEY_WORK_TEXT (src/components/pages/partners/partners.ts), "... after each course, as agreed in the program scope."
 */
interface Props {
  title: string;
  lead?: string;
  /** C6a positioning statement (data/copy.ts POSITIONING), shown in the band header. */
  positioning?: { text: string; facts: string[] };
  tone?: 'white' | 'airy' | 'ice';
  blocks?: { label: string; title: string; text?: string; icon?: string }[];
  link?: { label: string; href: string };
  ribbon?: string[];
  /** A line under the ribbon that names what happens across the stages (Home, WP17). */
  ribbonLine?: string;
  eyebrow?: string;
  id?: string;
  /** WP166-A (R1-18): the TalentLEAP method sentence (IN-06) and its link, at the foot of the band beside the model link (it was in the Track Record band). */
  method?: boolean;
  /** WP166-A (R1-17): the page's one program-scope statement (PROGRAM_SCOPE_STATEMENT), under the band (the "Includes" band that printed it is gone from Home). */
  scope?: string;
}
const {
  title,
  lead,
  positioning,
  tone = 'white',
  eyebrow = 'How It Works',
  blocks = [
    { label: 'Who We Reach', title: 'Educated, Unemployed and Underemployed Youth', text: 'Outreach and selection with local partners.', icon: 'users' },
    // WP163 (owner answers of 3 November 2026): Home states the delivery model once, here (DELIVERY_MODEL, the AI-supported flipped classroom).
    { label: 'How We Reach Them', title: 'An AI-Supported Flipped Classroom', // WP167 (owner approval of 2026-11-23, R1-16): one name for the model in the card (the body says "flipped classroom")
    text: `Training in existing labs and colleges, led by facilitators trained by CodersTrust (Training of Trainers), with delivery designed to work where connectivity is limited. ${DELIVERY_MODEL.text}`, icon: 'graduation-cap' },
    // WP166-A (marketing review R1-17, owner approval of 21 November 2026): the card states the fuller sentence of the former "What a Supported Youth Cohort Includes" band (PD-01, PD-15, PD-19; the hours read from PD-01), which is gone from Home.
    { label: 'What We Deliver', title: 'Skills, Certification Preparation and Mentoring', text: `${fact('PD-01').stat?.value} training hours per certification, including exam preparation, followed by three months of milestone-based mentoring and placement support. Each track’s work-entry plan is agreed before enrollment.`, icon: 'award' },
    { label: 'Where They Work', title: 'Local, Remote and Global Work', text: WHERE_THEY_WORK_TEXT, icon: 'globe' },
  ],
  link,
  ribbon = ['Learn', 'Earn', 'Prosper'],
  ribbonLine,
  id = 'mechanism',
  method = false,
  scope,
} = Astro.props;
const talentleap = linkAttrs('/our-model/talentleap/');
---

<Section id={id} tone={tone} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow={eyebrow} title={title} lead={lead} leadLast={!!positioning}>
    {positioning && <PositioningStatement text={positioning.text} facts={positioning.facts} />}
  </SectionHeader>
  <ModelDiagram blocks={blocks} />
  <p class="mech__ribbon" data-reveal>
    {ribbon.map((r, i) => (<><span>{r}.</span>{i < ribbon.length - 1 && <Icon name="arrow-right" size={20} />}</>))}
  </p>
  {ribbonLine && <p class="mech__line">{ribbonLine}</p>}
  {link && <p class="mech__link"><a class="link" href={linkAttrs(link.href).href}>{link.label}<Icon name="arrow-right" size={16} /></a></p>}
  {
    method && (
      <p class="mech__method" data-fact="IN-06">
        Our method organizes skills into career paths. We call it TalentLEAP.{' '}
        <a class="link" href={talentleap.href}>How TalentLEAP Works<Icon name="arrow-right" size={16} /></a>
      </p>
    )
  }
  {scope && <p class="mech__scope">{scope}</p>}
  <slot />
</Section>

<style>
  .mech__ribbon {
    margin: var(--space-lg) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    font-size: var(--fs-heading-xl);
    font-weight: var(--fw-bold);
    letter-spacing: -0.5px;
    color: var(--secondary);
  }
  .mech__ribbon span:last-of-type {
    color: var(--primary);
  }
  .mech__ribbon :global(.icon) {
    color: var(--tertiary);
  }
  .mech__line {
    margin: var(--space-sm) 0 0;
    max-width: 48rem;
    color: var(--on-surface-variant);
  }
  .mech__link {
    margin: var(--space-md) 0 0;
  }
  .mech__method {
    margin: var(--space-md) 0 0;
    max-width: 48rem;
    color: var(--on-surface-variant);
  }
  .mech__scope {
    margin: var(--space-md) 0 0;
    max-width: 48rem;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
  }
</style>
