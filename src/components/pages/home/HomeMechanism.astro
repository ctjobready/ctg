---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import ModelDiagram from '../../ui/ModelDiagram.astro';
import Icon from '../../system/Icon.astro';
import PositioningStatement from '../../sections/PositioningStatement.astro';
import { linkAttrs } from '../../../lib/url';

/**
 * C6 Mechanism (page-local variant of the shared MechanismBand). Same content and diagram, but the tone
 * is a prop: on Home the evidence band (C7) that follows is the Klein "impact moment", and the system
 * rule is that two dark bands never sit back to back, so the mechanism band stays light here.
 * WP39 (cycle-16 review): Investors' band carries no positioning statement any more (it restated the hero), so the `statementFirst` option, which opened that band with the statement, is gone.
 */
interface Props {
  title: string;
  lead?: string;
  /** C6a positioning statement (data/copy.ts POSITIONING), shown in the band header. */
  positioning?: { text: string; facts: string[] };
  tone?: 'white' | 'airy' | 'ice';
  blocks?: { label: string; title: string; text?: string; icon?: string }[];
  link?: { label: string; href: string };
  ribbon?: string[];
  /** A line under the ribbon that names what happens across the stages (Home, WP17). */
  ribbonLine?: string;
  eyebrow?: string;
  id?: string;
}
const {
  title,
  lead,
  positioning,
  tone = 'white',
  eyebrow = 'How It Works',
  blocks = [
    { label: 'Who We Reach', title: 'Educated, Unemployed and Underemployed Youth', text: 'Outreach and selection with local partners.', icon: 'users' },
    { label: 'How We Reach Them', title: 'Blended Training', text: 'Labs, colleges and delivery that works where connectivity is limited.', icon: 'graduation-cap' },
    { label: 'What We Deliver', title: 'Skills, Certification Preparation and Mentoring', text: 'Industry certification exam preparation by track, then three months of milestone-based mentoring.', icon: 'award' },
    { label: 'Where They Work', title: 'Local, Remote and Global Work', text: 'Placement support and outcome tracking after each course.', icon: 'globe' },
  ],
  link,
  ribbon = ['Learn', 'Earn', 'Prosper'],
  ribbonLine,
  id = 'mechanism',
} = Astro.props;
---

<Section id={id} tone={tone} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow={eyebrow} title={title} lead={lead} leadLast={!!positioning}>
    {positioning && <PositioningStatement text={positioning.text} facts={positioning.facts} />}
  </SectionHeader>
  <ModelDiagram blocks={blocks} />
  <p class="mech__ribbon" data-reveal>
    {ribbon.map((r, i) => (<><span>{r}.</span>{i < ribbon.length - 1 && <Icon name="arrow-right" size={20} />}</>))}
  </p>
  {ribbonLine && <p class="mech__line">{ribbonLine}</p>}
  {link && <p class="mech__link"><a class="link" href={linkAttrs(link.href).href}>{link.label}<Icon name="arrow-right" size={16} /></a></p>}
  <slot />
</Section>

<style>
  .mech__ribbon {
    margin: var(--space-lg) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    font-size: var(--fs-heading-xl);
    font-weight: var(--fw-bold);
    letter-spacing: -0.5px;
    color: var(--secondary);
  }
  .mech__ribbon span:last-of-type {
    color: var(--primary);
  }
  .mech__ribbon :global(.icon) {
    color: var(--tertiary);
  }
  .mech__line {
    margin: var(--space-sm) 0 0;
    max-width: 48rem;
    color: var(--on-surface-variant);
  }
  .mech__link {
    margin: var(--space-md) 0 0;
  }
</style>
