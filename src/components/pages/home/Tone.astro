---
import { CMF_TAGS, isCmfTag, looksLikeCmfTag, type CmfTag } from '../../../data/cmf';

/**
 * Band rhythm helper (Home and Investors first; WP175: every conversion page wraps its bands in it). Several shared bands fix their own background (white, airy, ice, klein),
 * which can put two same-tone or two dark bands side by side. This wrapper re-maps the band's tone tokens
 * from the outside (the shared components stay untouched) and carries the CMF component id (`data-cmf`)
 * so the section order can be audited in the markup (tests/support/cmf.ts reads it).
 *
 *   tone: remap the direct-child `.band` to white | airy | ice (omit to keep the band's own tone)
 *   cmf:  the CMF component, declared compression or recorded row the band stands for (src/data/cmf.ts); a value that reads as a CMF component but is not one ("C6a",
 *         "C2-C4 (compresed)") stops the build. The partner hub, which is not a conversion page, labels its bands in its own words (HERO, AUDIENCES, …).
 *   join: two bands that read as one block (the second drops its top padding)
 */
interface Props {
  tone?: 'white' | 'airy' | 'ice';
  cmf?: CmfTag | (string & {});
  join?: boolean;
}
const { tone, cmf, join = false } = Astro.props;
if (cmf !== undefined && looksLikeCmfTag(cmf) && !isCmfTag(cmf)) throw new Error(`Tone: data-cmf "${cmf}" is not a CMF tag (${CMF_TAGS.join(', ')})`);
---

<div class:list={['tone', tone && `tone--${tone}`, join && 'tone--join']} data-cmf={cmf}><slot /></div>

<style is:global>
  .tone--white > .band.band {
    --band-bg: var(--surface);
    --ctx-muted: var(--outline);
    --ctx-border: var(--primary-fixed);
    --badge-brand-bg: initial;
    --badge-info-bg: initial;
  }
  .tone--airy > .band.band {
    --band-bg: var(--surface-container-low);
    --ctx-muted: var(--outline);
    --ctx-border: var(--primary-fixed);
    --badge-brand-bg: var(--primary-fixed);
    --badge-info-bg: initial;
  }
  .tone--ice > .band.band {
    --band-bg: var(--surface-container);
    --ctx-muted: var(--on-surface-variant);
    --ctx-border: var(--primary-fixed);
    --badge-info-bg: var(--surface);
    --badge-brand-bg: var(--surface);
  }
  .tone--join > .band.band:first-child {
    padding-bottom: 0;
  }
  .tone--join > .band.band:not(:first-child) {
    padding-top: var(--band-join);
  }
  /* Two wrappers whose bands end up on the same ground (the wrapper's own tone, or the band's when it is not re-mapped) read as one area:
     the second band's top padding drops to --band-join, the same rule src/styles/utilities.css applies to bands that are plain siblings. */
  :is(.tone--white, .tone:not(.tone--white, .tone--airy, .tone--ice):has(> .band--white)) + :is(.tone--white, .tone:not(.tone--white, .tone--airy, .tone--ice):has(> .band--white)) > .band:first-child:not(.band--pad-none),
  :is(.tone--airy, .tone:not(.tone--white, .tone--airy, .tone--ice):has(> .band--airy)) + :is(.tone--airy, .tone:not(.tone--white, .tone--airy, .tone--ice):has(> .band--airy)) > .band:first-child:not(.band--pad-none),
  :is(.tone--ice, .tone:not(.tone--white, .tone--airy, .tone--ice):has(> .band--ice)) + :is(.tone--ice, .tone:not(.tone--white, .tone--airy, .tone--ice):has(> .band--ice)) > .band:first-child:not(.band--pad-none),
  .tone:has(> .band--klein) + .tone:has(> .band--klein) > .band:first-child:not(.band--pad-none),
  .tone:has(> .band--deep-ink) + .tone:has(> .band--deep-ink) > .band:first-child:not(.band--pad-none) {
    padding-top: var(--band-join);
  }
</style>
