---
import Section from '../../ui/Section.astro';
import Stat from '../../system/Stat.astro';
import PlainLine from '../../facts/PlainLine.astro';
import Icon from '../../system/Icon.astro';
import PaidWorkPathways from '../impact/PaidWorkPathways.astro';
import { fact } from '../../../data/facts';
import { linkAttrs } from '../../../lib/url';

/**
 * Home C7 evidence band (Klein; WP25h, reordered in WP28, trimmed in WP30c, WP31 and WP33). It does not retell the trial or the survey: the hero's proof cards and the
 * "Results and Programs" carousel above already state them. The band holds two things, the strongest evidence first:
 *  1. The trial in one line (WP33, cycle-10 review: the trial's figure was stated three times on Home). The sub-heading, the registered plain-language sentence (the
 *     [PLAIN-LINE], RC-02) and one link to the trial's results. The chart, its data table and its note are gone (the trial page carries the full results). The sub-heading says the
 *     trial evaluated a predecessor program (the chart note carried that scope before). The sentence is the trial's measure, not the program records on the
 *     "Results by Program" slide (WSDFM program records: 71% in work).
 *  2. The survey area: the paid-work pathways as one compact comparison (OC-04: salaried employment, freelancing and business ownership, before training and at the
 *     October 2026 survey; Surveyed Completers) beside the one survey result the carousel does not carry, the 72.3% of surveyed completers with no prior income who were
 *     earning (OC-02), with its registered base in the "N of M" pattern ("34 of 47"), then the survey link. No note sits under the pathways table; there is no evidence
 *     ladder (the carousel, the case cards and the Impact page label each kind of evidence) and no scope line under the heading (the survey block carries its tag).
 * The other pages that carry a trial-and-survey band (Programs, YouthWIDE, Investors) keep using ./EvidenceBand.astro.
 */
interface Props {
  id?: string;
  /** The band's h2. */
  title: string;
  /** The trial's own sub-heading (h3) over its sentence; it names the predecessor program the trial evaluated. */
  trialHeading: string;
  /** The one link under the trial's sentence, to the trial's results. */
  trialLink?: { label: string; href: string };
  /** Scope of the two kinds of figure, stated once under the h2. */
  lead?: string;
  links?: { label: string; href: string }[];
}
const { id = 'proof-band', title, trialHeading, trialLink, lead, links = [] } = Astro.props;

// OC-02: "72.3% (34 of 47) of 2014–2023 completers who had no income before training were earning at the October 2026 survey". The tile's
// label states the base in front ("34 of 47 surveyed 2014–2023 completers with no prior income were earning ..."), read from the register's own text.
const oc = fact('OC-02');
const base = /\((\d+) of (\d+)\)/.exec(oc.text);
const LABEL_OPENING = 'of surveyed 2014–2023 completers';
if (!oc.stat || !base || !oc.stat.label.startsWith(LABEL_OPENING)) throw new Error('HomeEvidence: OC-02 no longer reads "N% (X of Y) ..." with a label starting "of surveyed 2014–2023 completers"');
const survey = { value: oc.stat.value, numeric: oc.stat.numeric !== undefined, label: `${base[1]} of ${base[2]} surveyed${oc.stat.label.slice('of surveyed'.length)}` };
---

<Section id={id} tone="klein" aria-labelledby={`${id}-h`}>
  <header class="he__head" data-reveal>
    <p class="eyebrow">The Evidence</p>
    <h2 class="he__title" id={`${id}-h`}>{title}</h2>
    {lead && <p class="lead">{lead}</p>}
  </header>

  {/* WP33: the trial in one line. Its figure was stated three times on Home (cycle-10 review), so the chart, its data table and its note are gone; the sub-heading names the predecessor program, as the chart note did. */}
  <div class="he__trial" data-fact="RC-02" data-reveal>
    <h3 class="he__sub t-heading-l">{trialHeading}</h3>
    <PlainLine />
    {trialLink && <a class="link" href={linkAttrs(trialLink.href).href}>{trialLink.label}<Icon name="arrow-right" size={16} /></a>}
  </div>

  <div class="he__top">
    <PaidWorkPathways />
    <div class="he__stat" data-fact="OC-02" data-reveal>
      <Stat value={survey.value} label={survey.label} tone="dark" size="lg" count={survey.numeric} />
    </div>
  </div>

  {
    links.length > 0 && (
      <ul class="he__links" role="list">
        {links.map((l) => <li><a class="link" href={linkAttrs(l.href).href}>{l.label}<Icon name="arrow-right" size={16} /></a></li>)}
      </ul>
    )
  }
</Section>

<style>
  .he__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    max-width: 52rem;
  }
  .he__head > * {
    margin: 0;
  }
  .he__title {
    color: var(--ctx-section-heading);
  }
  .he__top {
    display: grid;
    gap: var(--space-lg);
    align-items: stretch;
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--ctx-border);
  }
  /* the pathways block carries its own top margin for the places that stack it under a figure; here the grid gap spaces it */
  .he__top > :global(.pwp) {
    margin-top: 0;
  }
  /* the lead figure sits in a panel of the pathways block's own style, so the two carry equal weight side by side */
  .he__stat {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-gutter);
    background: var(--ctx-card, var(--surface-container-low));
    border: 1px solid var(--ctx-border, var(--primary-fixed));
    border-radius: var(--radius-default);
  }
  .he__stat :global(.stat__label) {
    max-width: 34ch;
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
  }
  /* the trial in one line: heading, sentence (its own measure) and link in one column, each sized to its content */
  .he__trial {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
  }
  .he__trial > :global(*) {
    margin: 0;
  }
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h3.he__sub {
    color: var(--ctx-section-heading);
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  @media (min-width: 768px) {
    h3.he__sub {
      letter-spacing: -0.5px;
    }
  }
  .he__links {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }
  @media (min-width: 1024px) {
    .he__top {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-xl);
    }
  }
</style>
