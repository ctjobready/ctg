---
import Section from '../../ui/Section.astro';
import Stat from '../../system/Stat.astro';
import PlainLine from '../../facts/PlainLine.astro';
import BeforeAfter from '../../ui/BeforeAfter.astro';
import Icon from '../../system/Icon.astro';
import PaidWorkPathways from '../impact/PaidWorkPathways.astro';
import { fact } from '../../../data/facts';
import { RCT_COMPARISON } from '../../../data/copy';
import { linkAttrs } from '../../../lib/url';

/**
 * Home C7 evidence band (Klein; WP25h, reordered in WP28). It no longer retells the trial and the survey, which the "Results and Programs"
 * carousel above already states (the trial slide, the survey slides). WP28 puts the strongest evidence first, as the band's own ladder says:
 * the trial in one sentence (the [PLAIN-LINE], RC-02) beside its chart, then the evidence ladder (what each kind of evidence shows), then
 * the one survey result the carousel does not carry, the 72.3% of surveyed completers with no prior income who were earning (OC-02), with
 * its registered base in the "N of M" pattern ("34 of 47"), then the links. There is no second survey block and no restatement of the
 * trial's income results (RC-01; the carousel's first slide states them).
 * WP29 (benchmark review): the survey area also carries the paid-work pathways as one compact comparison (OC-04: salaried employment, freelancing and
 * business ownership, before training and at the October 2026 survey; Surveyed Completers), below the ladder and the 72.3% tile.
 * The trial chart is labelled as the trial's follow-up for women offered a place, a different measure from the program records on the
 * "In-Work Results by Program" slide (WSDFM program records: 71% in work).
 * WP30c: the scope line under the heading was one short sentence (WP31 removed it: the survey block carries its "Surveyed Completers" tag and the chart note names the
 * predecessor program); no note under the pathways table; the
 * evidence ladder ("Four Kinds of Evidence, Strongest First") is gone from this band: the carousel, the case cards and the Impact page label each kind of evidence,
 * and the "Read the evidence" link leads to the full ladder. The pathways table sits beside the 72.3% tile, in the ladder's former place.
 * The other pages that carry a trial-and-survey band (Programs, YouthWIDE, Investors) keep using ./EvidenceBand.astro.
 */
interface Props {
  id?: string;
  /** The band's h2. */
  title: string;
  /** The trial's own sub-heading (h3) over its sentence and chart. */
  trialHeading: string;
  /** Scope of the two kinds of figure, stated once under the h2. */
  lead?: string;
  links?: { label: string; href: string }[];
}
const { id = 'proof-band', title, trialHeading, lead, links = [] } = Astro.props;

// OC-02: "72.3% (34 of 47) of 2014–2023 completers who had no income before training were earning at the October 2026 survey". The tile's
// label states the base in front ("34 of 47 surveyed 2014–2023 completers with no prior income were earning ..."), read from the register's own text.
const oc = fact('OC-02');
const base = /\((\d+) of (\d+)\)/.exec(oc.text);
const LABEL_OPENING = 'of surveyed 2014–2023 completers';
if (!oc.stat || !base || !oc.stat.label.startsWith(LABEL_OPENING)) throw new Error('HomeEvidence: OC-02 no longer reads "N% (X of Y) ..." with a label starting "of surveyed 2014–2023 completers"');
const survey = { value: oc.stat.value, numeric: oc.stat.numeric !== undefined, label: `${base[1]} of ${base[2]} surveyed${oc.stat.label.slice('of surveyed'.length)}` };

// The trial's follow-up employment, from RC-02 (control group, women offered a place and the difference).
const before = RCT_COMPARISON.control;
const after = RCT_COMPARISON.offered;
const delta = RCT_COMPARISON.delta;
---

<Section id={id} tone="klein" aria-labelledby={`${id}-h`}>
  <header class="he__head" data-reveal>
    <p class="eyebrow">The Evidence</p>
    <h2 class="he__title" id={`${id}-h`}>{title}</h2>
    {lead && <p class="lead">{lead}</p>}
  </header>

  <div class="he__trial" data-fact="RC-02">
    <div class="he__copy" data-reveal>
      <h3 class="he__sub t-heading-l">{trialHeading}</h3>
      <PlainLine />
    </div>
    <div class="he__chart">
      <BeforeAfter
        mode="comparison"
        title="Employment at Trial Follow-Up (Nov–Dec 2021): Women Offered a Place and Control Group"
        before={{ label: 'Control Group', value: before }}
        after={{ label: 'Offered a Place', value: after }}
        delta={delta}
        chip={false}
        tone="dark"
      />
      <!-- WP31: the band's scope line is gone (the survey block carries its evidence tag); the trial's scope, the predecessor program, stays with the chart note. -->
      <p class="he__fn">Chart data: employment at follow-up in the trial of the predecessor program, women offered a place and the control group.</p>
    </div>
  </div>

  <div class="he__top">
    <PaidWorkPathways />
    <div class="he__stat" data-fact="OC-02" data-reveal>
      <Stat value={survey.value} label={survey.label} tone="dark" size="lg" count={survey.numeric} />
    </div>
  </div>

  {
    links.length > 0 && (
      <ul class="he__links" role="list">
        {links.map((l) => <li><a class="link" href={linkAttrs(l.href).href}>{l.label}<Icon name="arrow-right" size={16} /></a></li>)}
      </ul>
    )
  }
</Section>

<style>
  .he__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    max-width: 52rem;
  }
  .he__head > * {
    margin: 0;
  }
  .he__title {
    color: var(--ctx-section-heading);
  }
  .he__top {
    display: grid;
    gap: var(--space-lg);
    align-items: stretch;
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--ctx-border);
  }
  /* the pathways block carries its own top margin for the places that stack it under a figure; here the grid gap spaces it */
  .he__top > :global(.pwp) {
    margin-top: 0;
  }
  /* the lead figure sits in a panel of the pathways block's own style, so the two carry equal weight side by side */
  .he__stat {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-gutter);
    background: var(--ctx-card, var(--surface-container-low));
    border: 1px solid var(--ctx-border, var(--primary-fixed));
    border-radius: var(--radius-default);
  }
  .he__stat :global(.stat__label) {
    max-width: 34ch;
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
  }
  .he__trial {
    display: grid;
    gap: var(--space-md) var(--space-lg);
  }
  .he__copy {
    display: grid;
    gap: var(--space-md);
    align-content: center;
  }
  .he__copy > :global(*) {
    margin: 0;
  }
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h3.he__sub {
    color: var(--ctx-section-heading);
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  @media (min-width: 768px) {
    h3.he__sub {
      letter-spacing: -0.5px;
    }
  }
  .he__fn {
    margin: var(--space-xs) 0 0;
    font-size: var(--fs-body-xs);
    color: var(--ctx-muted);
  }
  .he__links {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }
  @media (min-width: 1024px) {
    .he__top {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-xl);
    }
    .he__trial {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-md) var(--space-xl);
      /* the trial now opens the band: the sentence sits level with the middle of its chart, not above an empty column */
      align-items: center;
    }
  }
</style>
