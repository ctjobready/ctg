---
import { titleCase } from '../../../lib/titleCase.mjs';
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import { fact } from '../../../data/facts';
import { endSentence } from '../../sections/copyText';

/**
 * C3 Cost of waiting (Home): CLAIM / DATA / IMPLICATION blocks, then the value proposition. Page-local variant of the shared CostBand, which has no
 * slot for the value proposition under the blocks. WP40 (cycle-17 review): the transition line that used to open it ("It doesn’t have to be this way.") is gone.
 */
interface Block {
  icon: string;
  claim: string;
  factId: string;
  /** The data line, when the card states part of the fact only (WP38: one finding of PX-06's two); defaults to the register's text. */
  text?: string;
  implication: string;
}
interface Props {
  title: string;
  blocks: Block[];
  /** Shown directly under the blocks (the value proposition). */
  after?: string;
  id?: string;
}
const { title, blocks, after, id = 'cost' } = Astro.props;
// The register labels some context facts ("Context (external): …"); the label is for editors, not readers.
const clean = (t: string) => t.replace(/^[A-Za-z ]+ \((?:external|estimate)\):\s*/i, '').replace(/^./, (c) => c.toUpperCase());
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="The Cost of Waiting" title={title} />
  <div class:list={['grid-cards', blocks.length === 2 && 'grid-cards--2']}>
    {
      blocks.map((b) => (
        <article class="card cost" data-reveal>
          <div class="card__body">
            <Icon name={b.icon} size={36} strokeWidth={1.5} class="cost__icon" />
            <h3 class="card__title">{titleCase(b.claim)}</h3>
            <p class="cost__data" data-fact={b.factId}>
              {endSentence(clean(b.text ?? fact(b.factId).text))}
            </p>
            <p class="cost__impl"><span class="cost__tag">What It Means</span>{' '}{b.implication}</p>
          </div>
        </article>
      ))
    }
  </div>
  {
    after && (
      <div class="cost__turn" data-reveal>
        <p class="cost__after">{after}</p>
      </div>
    )
  }
</Section>

<style>
  .cost :global(.cost__icon) {
    color: var(--primary);
  }
  .cost__data {
    color: var(--on-surface);
    padding-left: var(--space-md);
    border-left: 4px solid var(--tertiary);
  }
  /* The implication follows its data at one fixed distance (it is not pushed to the card's bottom, which stretched a gap of any size
     between them in the shorter cards of a row). */
  .cost__impl {
    margin-top: var(--space-xs) !important;
    padding-top: var(--space-sm);
    color: var(--on-surface-variant);
  }
  .cost__tag {
    display: block;
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--on-primary-container);
  }
  /* The value proposition closes the band under a hairline. WP40: with the transition line gone it is the band's one closing statement, so it is set a step larger than body text, in the heading color (heading-l, medium). */
  .cost__turn {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--primary-fixed);
  }
  .cost__after {
    margin: 0;
    font-size: var(--fs-heading-l);
    line-height: var(--lh-heading-l);
    font-weight: var(--fw-medium);
    color: var(--secondary);
    max-width: 44rem;
  }
</style>
