---
import { titleCase } from '../../../lib/titleCase.mjs';
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import { fact } from '../../../data/facts';
import { endSentence } from '../../sections/copyText';

/**
 * C3 Cost of waiting (Home): CLAIM / DATA / IMPLICATION blocks. Page-local variant of the shared CostBand: each card carries the icon, and the finding can be one of the fact's findings (`text`).
 * WP40 (cycle-17 review): the transition line that used to open it ("It doesn’t have to be this way.") is gone.
 * WP47 (owner decision 2026-10-15): the audience pages no longer carry a cost-of-waiting band, so Home is where readers meet it, and it ends with its cards: the value-proposition line under them ("A first cohort can show who is earning, and you decide on
 * the evidence.") and its `after` prop and styles are gone.
 */
interface Block {
  icon: string;
  claim: string;
  factId: string;
  /** The data line, when the card states part of the fact only (WP38: one finding of PX-06's two); defaults to the register's text. */
  text?: string;
  implication: string;
}
interface Props {
  title: string;
  blocks: Block[];
  id?: string;
}
const { title, blocks, id = 'cost' } = Astro.props;
// The register labels some context facts ("Context (external): …"); the label is for editors, not readers.
const clean = (t: string) => t.replace(/^[A-Za-z ]+ \((?:external|estimate)\):\s*/i, '').replace(/^./, (c) => c.toUpperCase());
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="The Cost of Waiting" title={title} />
  <div class:list={['grid-cards', blocks.length === 2 && 'grid-cards--2']}>
    {
      blocks.map((b) => (
        <article class="card cost" data-reveal>
          <div class="card__body">
            <Icon name={b.icon} size={36} strokeWidth={1.5} class="cost__icon" />
            <h3 class="card__title">{titleCase(b.claim)}</h3>
            <p class="cost__data" data-fact={b.factId}>
              {endSentence(clean(b.text ?? fact(b.factId).text))}
            </p>
            <p class="cost__impl"><span class="cost__tag">What It Means</span>{' '}{b.implication}</p>
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .cost :global(.cost__icon) {
    color: var(--primary);
  }
  .cost__data {
    color: var(--on-surface);
    padding-left: var(--space-md);
    border-left: 4px solid var(--tertiary);
  }
  /* The implication follows its data at one fixed distance (it is not pushed to the card's bottom, which stretched a gap of any size
     between them in the shorter cards of a row). */
  .cost__impl {
    margin-top: var(--space-xs) !important;
    padding-top: var(--space-sm);
    color: var(--on-surface-variant);
  }
  .cost__tag {
    display: block;
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--on-primary-container);
  }
</style>
