---
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../system/Icon.astro';
import Badge from '../../system/Badge.astro';
import PilotScorecard from '../../ui/PilotScorecard.astro';
import CopyBlock from './CopyBlock.astro';
import { optionDuration } from '../../../lib/format';
import { PROGRAM_OPTIONS, PROGRAM_OPTIONS_FACTS, type CopyBlock as CopyBlockData } from '../../../data/copy';

/**
 * C11 Offer (funder-facing pages): three program options (PD-05, no prices), the ACCOUNTABILITY line directly after the options (round-3 enhancement 2),
 * the pilot scorecard, and one short block: how pricing works (two sentences). The standard inclusions are listed once, in "What a Supported Youth Cohort Includes";
 * the scale evidence (Her Power, the government contracts) is on the Governments page and in the carousel, and the National option card says it is a design option.
 * Page-local because the shared OfferBand has no slot for those blocks.
 */
interface Props {
  title?: string;
  lead?: string;
  id?: string;
}
const { title = 'Choose Where to Start', lead, id = 'offer' } = Astro.props;
const pricing: CopyBlockData = {
  text: 'Pricing is set per program, and we share an indicative budget in the discovery session. Devices, stipends, connectivity and independent evaluation are budgeted separately where a program needs them.',
  facts: ['PD-02', 'PD-02a'],
};

// WP25h: on Home the first option's size is scoped with us in the discovery session (the shared PROGRAM_OPTIONS entry keeps its own note for the other pages).
// WP63 (cycle-35 review, Grok R5): the option keeps the shared name, "Multi-Cohort Pilot Program", the one the audience pages use (Home called it "First Multi-Cohort Pilot").
const options = PROGRAM_OPTIONS.map((o, i) =>
  i === 0 ? { ...o, note: `${o.note} Scope the number of cohorts and trainees with us in the discovery session.` } : o,
);
---

<Section id={id} tone="white" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="The Offer" title={title} lead={lead} />
  <ol class="grid-cards offer" role="list" data-fact={PROGRAM_OPTIONS_FACTS.join(' ')}>
    {
      options.map((o, i) => (
        <li class="card offer__card" data-reveal>
          <div class="card__body">
            <p class="eyebrow">Option {i + 1}</p>
            <h3 class="card__title">{o.name}{o.name === 'National' && ' '}{o.name === 'National' && <Badge tone="sale" class="offer__badge">Design Option</Badge>}</h3>
            <p class="offer__size">{o.size}</p>
            <p class="card__meta offer__duration">{optionDuration(o.duration)}</p>
            <p class="card__text">{o.note}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <PilotScorecard />

  <div class="offer__two">
    <div class="offer__panel" data-reveal>
      <h3 class="t-heading-l"><Icon name="clipboard-list" size={24} strokeWidth={1.5} />How Pricing Works</h3>
      <CopyBlock block={pricing} />
    </div>
  </div>
</Section>

<style>
  .offer {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .offer :global(.offer__badge) {
    margin-left: var(--space-sm);
    vertical-align: middle;
  }
  .offer__size {
    font-size: var(--fs-heading-l);
    font-weight: var(--fw-bold);
    color: var(--primary);
    line-height: 1.2;
  }
  .offer__duration {
    color: var(--on-surface-variant);
    font-size: var(--fs-body-base);
  }
  /* WP50 (owner design rule 2026-10-16): no left-edge accent bar on the accountability note (it was a 4 px tertiary border). */
  .offer__acc {
    margin: var(--space-lg) 0 0;
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    padding: var(--space-md) var(--space-gutter);
    background: var(--tertiary-container);
    border-radius: var(--radius-default);
    color: var(--on-tertiary-container);
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    font-weight: var(--fw-medium);
  }
  .offer__acc :global(.icon) {
    flex: none;
    margin-top: var(--space-xs);
  }
  .offer__two {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
  }
  .offer__panel {
    padding: var(--space-gutter);
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
  }
  .offer__panel > * {
    margin: 0;
  }
  .offer__panel > * + * {
    margin-top: var(--space-sm);
  }
  .offer__panel h3 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--secondary);
  }
  .offer__panel h3 :global(.icon) {
    color: var(--primary);
    flex: none;
  }
</style>
