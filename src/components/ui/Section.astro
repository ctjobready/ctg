---
/**
 * Section ➕ — a full-bleed band with the system's rhythm:
 * white → airy → ice → klein (impact moment) → deep-ink. Re-maps contextual tokens so
 * headings, stats, links, focus rings and cards adapt on dark grounds.
 * Never place two dark bands (klein / deep-ink) back to back.
 */
interface Props {
  tone?: 'white' | 'airy' | 'ice' | 'klein' | 'deep-ink';
  id?: string;
  /** Vertical padding scale. */
  pad?: 'none' | 'sm' | 'md' | 'lg';
  /** Container width. */
  width?: 'content' | 'wide' | 'narrow' | 'full';
  /** Fade/rise the content in when it enters the viewport. */
  reveal?: boolean;
  /**
   * Skip rendering while offscreen (content-visibility:auto) — for long, below-the-fold bands only. Never on a band that holds an in-page
   * link target (a section id the table of contents points to, the Notes list a footnote marker jumps to, an answer with a footnote marker):
   * the first jump into a skipped band lands short or long (tests/anchor-jumps.spec.ts holds the Outcomes 2026, independent-evaluation and
   * TalentLEAP pages to this).
   */
  defer?: boolean;
  'aria-labelledby'?: string;
  'aria-label'?: string;
  class?: string;
}
const { tone = 'white', id, pad = 'md', width = 'content', reveal = false, defer = false, class: className, ...aria } = Astro.props;
const container = width === 'full' ? '' : width === 'wide' ? 'container container--wide' : width === 'narrow' ? 'container container--narrow' : 'container';
---

<section class:list={['band', `band--${tone}`, `band--pad-${pad}`, defer && 'band--defer', className]} id={id} {...aria}>
  <div class={container} data-reveal={reveal ? '' : undefined}>
    <slot />
  </div>
</section>

<style>
  .band {
    background: var(--band-bg);
    color: var(--ctx-text);
  }
  .band--white {
    --band-bg: var(--surface);
  }
  .band--airy {
    --band-bg: var(--surface-container-low);
    --ctx-muted: var(--outline);
    --ctx-border: var(--primary-fixed);
    --badge-brand-bg: var(--primary-fixed);
  }
  .band--ice {
    --band-bg: var(--surface-container);
    --ctx-muted: var(--on-surface-variant);
    --badge-info-bg: var(--surface);
    --badge-brand-bg: var(--surface);
  }
  .band--klein {
    --band-bg: var(--secondary);
    --ctx-text: var(--primary-fixed);
    --ctx-muted: var(--primary-fixed);
    --ctx-heading: var(--on-secondary);
    --ctx-section-heading: var(--on-secondary);
    --ctx-link: var(--on-secondary);
    --ctx-accent: var(--tertiary-light);
    --ctx-stat: var(--on-secondary);
    --ctx-focus: var(--on-secondary);
    --ctx-border: color-mix(in srgb, var(--on-secondary) 28%, transparent);
    --ctx-card: color-mix(in srgb, var(--on-secondary) 8%, var(--secondary));
    --ctx-num-bg: var(--tertiary-light);
    --ctx-num-fg: var(--on-tertiary-fixed);
    --ba-before: var(--secondary-fixed-dim);
    --ba-after: var(--tertiary-light);
  }
  .band--deep-ink {
    --band-bg: var(--inverse-surface);
    --ctx-text: var(--inverse-on-surface);
    --ctx-muted: var(--surface-container-highest);
    --ctx-heading: var(--inverse-on-surface);
    --ctx-section-heading: var(--inverse-on-surface);
    --ctx-link: var(--inverse-primary);
    --ctx-accent: var(--tertiary-light);
    --ctx-stat: var(--inverse-on-surface);
    --ctx-focus: var(--inverse-primary);
    --ctx-border: color-mix(in srgb, var(--inverse-on-surface) 22%, transparent);
    --ctx-card: color-mix(in srgb, var(--inverse-on-surface) 8%, var(--inverse-surface));
    --ctx-num-bg: var(--tertiary-light);
    --ctx-num-fg: var(--on-tertiary-fixed);
  }
  .band--pad-none {
    padding-block: 0;
  }
  /* Section padding follows --band-pad (tokens.css): 40px on a phone up to 80px on a wide screen (DESIGN.md §3, 40–80px between major bands); sm is 0.6 of it, lg 1.35 of it but never above 80px. */
  .band--pad-sm {
    padding-block: var(--band-pad-sm);
  }
  .band--pad-md {
    padding-block: var(--band-pad);
  }
  .band--pad-lg {
    padding-block: var(--band-pad-lg);
  }
  /* A band that follows a band on the same ground (its top padding drops to --band-join) is handled in src/styles/utilities.css: the
     neighbours are often wrapped in a plain div or a .tone, and a scoped selector cannot see across the wrapper. */
  /* Opt-in: offscreen bands skip rendering work (INP/LCP) */
  .band--defer {
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }
</style>
