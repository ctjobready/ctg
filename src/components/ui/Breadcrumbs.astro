---
import { linkAttrs } from '../../lib/url';

interface Crumb {
  label: string;
  /** Omit on the last (current) item. */
  href?: string;
}
interface Props {
  /** Items after "Home". Last item is the current page. */
  items: Crumb[];
  /** Accessible name of the landmark. A page shows one trail; a gallery that shows a second one must name it differently. */
  label?: string;
  class?: string;
}
const { items, label = 'Breadcrumb', class: className } = Astro.props;
const all: Crumb[] = [{ label: 'Home', href: '/' }, ...items];
---

<nav class:list={['crumbs', className]} aria-label={label}>
  <ol class="container">
    {
      all.map((c, i) => {
        const last = i === all.length - 1;
        return (
          <li>
            {last || !c.href ? <span aria-current="page">{c.label}</span> : <a href={linkAttrs(c.href).href}>{c.label}</a>}
            {!last && <span class="crumbs__sep" aria-hidden="true">›</span>}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .crumbs {
    background: var(--surface);
    border-bottom: 1px solid var(--outline-variant);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-sm);
    margin: 0 auto;
    padding-block: 8px;
    list-style: none;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--outline);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 28px;
  }
  .crumbs a {
    color: var(--on-surface-variant);
    text-decoration: none;
    padding-block: 8px;
  }
  .crumbs a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .crumbs [aria-current='page'] {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
  }
  .crumbs__sep {
    color: var(--outline);
  }
</style>
