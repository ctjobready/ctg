---
import { COVERED_BY } from '../../data/press';

/**
 * AsCoveredBy (WP55, synthesis 3.5): Home's press line under the recognition badges. It began as one paragraph of text links to the seven outlets of PA-09 (Forbes' item is a contributor post, as the line said) and to the World Bank pages of PA-13;
 * WP57 (cycle-29 review, GPT-6.1 Sol P2) split it into two short sentences with every link kept.
 * WP62 (cycle-34 review, Kimi, GPT-6.1 Sol and Gemini): on Home it is one pointer sentence, "Early press coverage, 2014–2016, and World Bank coverage of our work in Kosovo are on the Recognition and Media page.", with the existing
 * "See All Recognition and Media" link directly under it. The outlets, their links and the other World Bank pages (the 2017 Kosovo country brief and the 2021 Albania press release) are no longer printed on Home; the Recognition and Media page lists
 * the 2014–2016 coverage with its logos and headlines, and `COVERED_BY` / `COVERED_BY_WORLD_BANK` (src/data/press.ts) keep the researched links. The sentence says "Kosovo" alone because that page carries the World Bank's 2016 Kosovo story and not
 * its Albania release; naming Albania here would send a reader to a page without it.
 * The 2014–2016 span is read from the data (the years of PA-09's outlets), so the lead-in cannot drift from it.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const years = COVERED_BY.map((c) => Number(c.year));
const first = Math.min(...years);
const last = Math.max(...years);
const span = first === last ? `${first}` : `${first}–${last}`;
---

<p class:list={['cov', className]} data-fact="PA-09 PA-13">
  Early press coverage, {span}, and World Bank coverage of our work in Kosovo are on the Recognition and Media page.
</p>

<style>
  .cov {
    max-width: 60rem;
    font-size: var(--fs-body-base);
    line-height: var(--lh-body-base);
    color: var(--on-surface-variant);
  }
</style>
