---
import { COVERED_BY, COVERED_BY_WORLD_BANK } from '../../data/press';
import { linkAttrs } from '../../lib/url';

/**
 * AsCoveredBy (WP55, synthesis 3.5): the press line, one paragraph, no logos and no photographs. It has two forms, which share its data, its class and its fact markers (PA-09 and PA-13):
 *   - `list` (the default): one paragraph of text links, as WP57 rendered it on Home. The seven outlets are PA-09's (Forbes' item is a contributor post, as the line says; PA-09's eighth item, the World Bank's 2016 Kosovo feature story, is in the World Bank
 *     sentence); the World Bank pages are PA-13 (the Kosovo feature story and country brief, the Albania press release). Links leave the site, so each carries the rel from linkAttrs and a screen-reader "(opens host)" suffix like every other external link.
 *     It is printed on the Recognition and Media page (WP62 rework R1), under the logo list: "Early press coverage, 2014–2016: Gulf News, TechCrunch, Forbes (contributor post), The Wall Street Journal, USA Today, Tech in Asia and The Times of India.
 *     World Bank coverage: Kosovo (2016, 2017) and Albania (2021)."
 *   - `pointer` (Home): one sentence with no link of its own, "Early press coverage, 2014–2016, and World Bank coverage of our work in Kosovo and Albania are on the Recognition and Media page.", directly above the
 *     existing "See All Recognition and Media" link. The years and the places are read from the same data as the list, so the sentence cannot drift from what the page it names prints.
 * WP57 (cycle-29 review, GPT-6.1 Sol P2): the line was one overpacked sentence ("As covered by Gulf News (2014), TechCrunch (2014), ...; and by the World Bank on Kosovo (2016, 2017) and Albania (2021)."). It is two short ones now: "Early press coverage,
 * 2014–2016: ..." (the outlets, named once, under the span of their years, which is read from the data; Forbes keeps its "contributor post" qualifier) and "World Bank coverage: Kosovo (2016, 2017) and Albania (2021)." Every link stays. The World Bank
 * years stay as the link texts: Kosovo has two pages, so the year is what tells the two links apart.
 * WP62 (cycle-34 review, Kimi, GPT-6.1 Sol and Gemini): Home's line became the pointer sentence (it was the list). The first WP62 pass named Kosovo alone, because the Recognition and Media page had no Albania release and left the ten links on no page;
 * the rework (R1, R2) prints the list there, so the pointer names both places again.
 */
interface Props {
  class?: string;
  variant?: 'list' | 'pointer';
}
const { class: className, variant = 'list' } = Astro.props;
const media = COVERED_BY.map((c) => ({ ...c, a: linkAttrs(c.href) }));
const wb = COVERED_BY_WORLD_BANK.map((w) => ({ place: w.place, pages: w.pages.map((p) => ({ ...p, a: linkAttrs(p.href) })) }));
// The span of the outlets' years ("2014–2016"), so the lead-in cannot drift from the data.
const years = COVERED_BY.map((c) => Number(c.year));
const first = Math.min(...years);
const last = Math.max(...years);
const span = first === last ? `${first}` : `${first}–${last}`;
/** What follows item `i` of `n` in a list read aloud: a comma, "and" before the last item, nothing after it. */
const after = (i: number, n: number) => (i < n - 2 ? ',' : i === n - 2 ? ' and' : '');
/** The World Bank places in the order the list prints them, read aloud ("Kosovo and Albania"). */
const placeNames = COVERED_BY_WORLD_BANK.map((w) => w.place);
const places = placeNames.length < 2 ? placeNames.join('') : `${placeNames.slice(0, -1).join(', ')} and ${placeNames[placeNames.length - 1]}`;
---

{
  variant === 'pointer' ? (
    <p class:list={['cov', className]} data-fact="PA-09 PA-13">
      Early press coverage, {span}, and World Bank coverage of our work in {places} are on the Recognition and Media page.
    </p>
  ) : (
    <p class:list={['cov', className]} data-fact="PA-09 PA-13">
      Early press coverage, {span}:
      {
        media.map((c, i) => (
          <>
            {' '}
            <a href={c.a.href} rel={c.a.rel}>{c.outlet}<span class="sr-only"> {c.a.srText}</span></a>{c.note && ` (${c.note})`}{after(i, media.length)}
          </>
        ))
      }. World Bank coverage:
      {
        wb.map((w, i) => (
          <>
            {' '}{w.place} (
            {w.pages.map((p, j) => (
              <>
                {j > 0 && ', '}
                <a href={p.a.href} rel={p.a.rel}>{p.year}<span class="sr-only"> {p.a.srText}</span></a>
              </>
            ))}
            ){after(i, wb.length)}
          </>
        ))
      }.
    </p>
  )
}

<style>
  .cov {
    max-width: 60rem;
    font-size: var(--fs-body-base);
    line-height: var(--lh-body-base);
    color: var(--on-surface-variant);
  }
</style>
