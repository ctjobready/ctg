---
import Icon from '../system/Icon.astro';
import Badge from '../system/Badge.astro';
import Img from './Img.astro';
import HeroArt from './HeroArt.astro';
import { linkAttrs } from '../../lib/url';
import { formatDate, isoDate } from '../../lib/format';
import { mayRender } from '../../lib/permissions';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  date: Date | string;
  topic?: string;
  excerpt?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  href: string;
  /** D13 asset ID of the cover photo. Defaults to news-<slug> for a /news/<slug>/ link. */
  assetId?: string;
  class?: string;
}
const { title, date, topic, excerpt, image, imageAlt = '', href, assetId: assetIdProp, class: className } = Astro.props;
const a = linkAttrs(href);
const slug = /^\/news\/([^/]+)\/?$/.exec(href)?.[1];
const assetId = assetIdProp ?? (slug ? `news-${slug}` : undefined);
// Staging never renders a cover whose asset is sensitive or was not published on coderstrust.global: the illustration stands in.
const showImage = Boolean(image) && (!assetId || mayRender(assetId));
---

<article class:list={['card card--link news', className]} data-reveal>
  <div class="card__media">
    {showImage && image ? <Img src={image} alt={imageAlt} width={720} height={480} widths={[360, 720]} sizes="(min-width:1024px) 380px, 90vw" assetId={assetId} /> : <HeroArt seed={title} shape="card" />}
  </div>
  <div class="card__body">
    <p class="card__meta news__meta">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      {topic && <Badge tone="brand">{topic}</Badge>}
    </p>
    <h3 class="card__title"><a class="card__link" href={a.href} rel={a.rel}>{title}</a></h3>
    {excerpt && <p class="card__text">{excerpt}</p>}
    <span class="card__more" aria-hidden="true">Read more<Icon name="arrow-right" size={16} /></span>
  </div>
</article>

<style>
  .news__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }
</style>
