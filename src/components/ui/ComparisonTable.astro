---
import Icon from '../system/Icon.astro';

/**
 * ComparisonTable ➕ — "approaches and trade-offs" (planning v1.2 §B), not verdicts. Cells are text.
 * A check icon (labelled "Included" for assistive technology, with no text twin) marks only the highlighted organisation's own
 * inclusions (`included: true`); other approaches never get verdict icons (no ✗ / ⚠). "—" is
 * announced as "Not applicable". The first column is sticky on small screens.
 */
interface Cell {
  text: string;
  /** The row's item is part of this column's offer (CodersTrust's own inclusions only). */
  included?: boolean;
  /** Fact whose caveat footnote marker follows the text (e.g. RC-01, RC-06). */
  factId?: string;
}
interface Props {
  caption: string;
  /** Column headings; the first is the criteria column. */
  columns: string[];
  rows: { label: string; cells: (string | Cell)[] }[];
  /** 0-based index among data columns (excluding criteria) to emphasise, e.g. CodersTrust. */
  highlight?: number;
  /** Fact IDs the table cites (written to data-fact for the status gate). */
  facts?: string[];
  class?: string;
}
const { caption, columns, rows, highlight, facts = [], class: className } = Astro.props;

function norm(c: string | Cell): Cell {
  const cell = typeof c === 'string' ? { text: c } : c;
  return { ...cell, text: cell.text.trim() };
}
const isNone = (t: string) => t === '—' || t === '-';
const dataFacts = [...new Set([...facts, ...rows.flatMap((r) => r.cells.map(norm).map((c) => c.factId).filter((f): f is string => !!f))])].join(' ');
---

<section class:list={['cmp', className]} aria-label={caption} tabindex="0" data-scroll data-reveal data-fact={dataFacts || undefined}>
  <table>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        {columns.map((c, i) => <th scope="col" class:list={[i === 0 && 'cmp__corner', highlight !== undefined && i - 1 === highlight && 'is-hl']}>{c}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {r.cells.map((raw, i) => {
              const c = norm(raw);
              return (
                <td class:list={[highlight === i && 'is-hl']} data-label={columns[i + 1]}>
                  {isNone(c.text) ? (
                    <span role="img" aria-label="Not applicable">—</span>
                  ) : (
                    <>
                      {c.included && (
                        <span class="cmp__mark" role="img" aria-label="Included">
                          <Icon name="circle-check" size={20} />
                        </span>
                      )}
                      {c.included && ' '}
                      <span class="cmp__text">{c.text}</span>
                      
                    </>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<!-- Phone layout (≤ 640 px): one card per approach, listing what it typically includes, in the table's own order. The table above is hidden at that width, so assistive technology reads one version. -->
<ul class:list={['cmp-cards', className]} role="list" aria-label={caption}>
  {
    columns.slice(1).map((col, ci) => (
      <li class:list={['cmp-card', highlight === ci && 'is-hl']}>
        <p class="cmp-card__title">{col}</p>
        <dl class="cmp-card__list">
          {rows.map((r) => {
            const c = norm(r.cells[ci] ?? '');
            return (
              <div class="cmp-card__row">
                <dt>{r.label}</dt>
                <dd>
                  {isNone(c.text) ? (
                    <span role="img" aria-label="Not applicable">—</span>
                  ) : (
                    <>
                      {c.included && (
                        <span class="cmp__mark" role="img" aria-label="Included">
                          <Icon name="circle-check" size={20} />
                        </span>
                      )}
                      {c.included && ' '}
                      <span class="cmp__text">{c.text}</span>
                    </>
                  )}
                </dd>
              </div>
            );
          })}
        </dl>
      </li>
    ))
  }
</ul>

<style>
  .cmp-cards {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-md);
  }
  .cmp-card {
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .cmp-card.is-hl {
    border-color: var(--secondary);
  }
  .cmp-card__title {
    margin: 0;
    padding: 12px var(--space-md);
    font-weight: var(--fw-bold);
    color: var(--secondary);
    background: var(--surface-container-low);
    border-bottom: 1px solid var(--primary-fixed);
  }
  .cmp-card.is-hl .cmp-card__title {
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
  }
  .cmp-card__list {
    margin: 0;
  }
  .cmp-card__row {
    padding: 10px var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
  }
  .cmp-card__row:last-child {
    border-bottom: 0;
  }
  .cmp-card__row dt {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
    margin-bottom: 2px;
  }
  .cmp-card__row dd {
    margin: 0;
    color: var(--on-surface-variant);
  }
  @media (max-width: 640px) {
    .cmp {
      display: none;
    }
    .cmp-cards {
      display: grid;
    }
  }
</style>

<style>
  .cmp {
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  table {
    width: 100%;
    min-width: 880px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-body-base);
  }
  th,
  td {
    padding: 14px var(--space-md);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
  }
  thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
    font-weight: var(--fw-bold);
    position: sticky;
    top: 0;
  }
  tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
    background: var(--surface);
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 11rem;
    box-shadow: 1px 0 0 var(--outline-variant);
  }
  thead .cmp__corner {
    left: 0;
    z-index: 2;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .is-hl {
    background: var(--surface-container-low);
  }
  thead .is-hl {
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
  }
  .cmp__mark {
    display: inline-flex;
    vertical-align: -4px;
    margin-right: 6px;
    color: var(--success);
  }
  .cmp:focus-visible {
    outline-offset: 2px;
  }
</style>
