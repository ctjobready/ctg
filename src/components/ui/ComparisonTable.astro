---
import Icon from '../system/Icon.astro';
import FootnoteMarker from '../facts/FootnoteMarker.astro';

/**
 * ComparisonTable ➕ — "approaches and trade-offs" (planning v1.2 §B), not verdicts. Cells are text.
 * A check icon (+ visually-hidden "Included:") marks only the highlighted organisation's own
 * inclusions (`included: true`); other approaches never get verdict icons (no ✗ / ⚠). "—" is
 * announced as "Not applicable". The first column is sticky on small screens.
 */
interface Cell {
  text: string;
  /** The row's item is part of this column's offer (CodersTrust's own inclusions only). */
  included?: boolean;
  /** Fact whose caveat footnote marker follows the text (e.g. RC-01, RC-06). */
  factId?: string;
}
interface Props {
  caption: string;
  /** Column headings; the first is the criteria column. */
  columns: string[];
  rows: { label: string; cells: (string | Cell)[] }[];
  /** 0-based index among data columns (excluding criteria) to emphasise, e.g. CodersTrust. */
  highlight?: number;
  /** Fact IDs the table cites (written to data-fact for the status gate). */
  facts?: string[];
  class?: string;
}
const { caption, columns, rows, highlight, facts = [], class: className } = Astro.props;

function norm(c: string | Cell): Cell {
  const cell = typeof c === 'string' ? { text: c } : c;
  return { ...cell, text: cell.text.trim() };
}
const isNone = (t: string) => t === '—' || t === '-';
const dataFacts = [...new Set([...facts, ...rows.flatMap((r) => r.cells.map(norm).map((c) => c.factId).filter((f): f is string => !!f))])].join(' ');
---

<div class:list={['cmp', className]} role="region" aria-label={caption} tabindex="0" data-reveal data-fact={dataFacts || undefined}>
  <table>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        {columns.map((c, i) => <th scope="col" class:list={[i === 0 && 'cmp__corner', highlight !== undefined && i - 1 === highlight && 'is-hl']}>{c}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {r.cells.map((raw, i) => {
              const c = norm(raw);
              return (
                <td class:list={[highlight === i && 'is-hl']}>
                  {isNone(c.text) ? (
                    <>
                      <span class="sr-only">Not applicable</span>
                      <span aria-hidden="true">—</span>
                    </>
                  ) : (
                    <>
                      {c.included && (
                        <span class="cmp__mark">
                          <Icon name="circle-check" size={20} />
                          <span class="sr-only">Included: </span>
                        </span>
                      )}
                      <span class="cmp__text">{c.text}</span>
                      {c.factId && <FootnoteMarker id={c.factId} footnote="auto" />}
                    </>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .cmp {
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  table {
    width: 100%;
    min-width: 880px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-body-base);
  }
  th,
  td {
    padding: 14px var(--space-md);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
  }
  thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
    font-weight: var(--fw-bold);
    position: sticky;
    top: 0;
  }
  tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
    background: var(--surface);
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 11rem;
    box-shadow: 1px 0 0 var(--outline-variant);
  }
  thead .cmp__corner {
    left: 0;
    z-index: 2;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .is-hl {
    background: var(--surface-container-low);
  }
  thead .is-hl {
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
  }
  .cmp__mark {
    display: inline-flex;
    vertical-align: -4px;
    margin-right: 6px;
    color: var(--success);
  }
  .cmp:focus-visible {
    outline-offset: 2px;
  }
</style>
