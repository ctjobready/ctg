---
import Section from './Section.astro';
import Button from '../system/Button.astro';
import { linkAttrs } from '../../lib/url';

/**
 * CTA band: ONE primary CTA + authentic urgency line + micro-commitment + secondary text link
 * (planning/04 §7–8). Slot = optional post-decision reinforcement (below the button).
 */
interface Props {
  heading: string;
  text?: string;
  cta: { label: string; href: string };
  urgency?: string;
  micro?: string;
  secondary?: { label: string; href: string };
  tone?: 'airy' | 'klein';
  id?: string;
}
const { heading, text, cta, urgency, micro, secondary, tone = 'airy', id } = Astro.props;
const dark = tone === 'klein';
---

<Section tone={tone} id={id} pad="lg" aria-labelledby={`${id ?? 'cta'}-h`}>
  <div class="cta-band">
    <h2 id={`${id ?? 'cta'}-h`} class="cta-band__title" data-reveal>{heading}</h2>
    {text && <p class="lead cta-band__text" data-reveal>{text}</p>}
    <div class="cta-band__actions" data-reveal>
      <Button variant={dark ? 'inverse' : 'primary'} href={cta.href} iconEnd="arrow-right">{cta.label}</Button>
      {
        secondary && (
          <a class="link" href={linkAttrs(secondary.href).href} rel={linkAttrs(secondary.href).rel}>
            {secondary.label}
          </a>
        )
      }
    </div>
    {(urgency || micro) && (
      <ul class="cta-band__notes" role="list" data-reveal>
        {urgency && <li>{urgency}</li>}
        {micro && <li>{micro}</li>}
      </ul>
    )}
    <slot />
  </div>
</Section>

<style>
  .cta-band {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    max-width: 46rem;
    margin-inline: auto;
  }
  .cta-band > * {
    margin: 0;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md) var(--space-lg);
  }
  .cta-band__notes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-lg);
    list-style: none;
    padding: 0;
    font-size: var(--fs-body-xs);
    color: var(--ctx-text);
  }
  .cta-band__title {
    color: var(--ctx-section-heading);
  }
</style>
