---
import Section from './Section.astro';
import Button from '../system/Button.astro';
import { linkAttrs } from '../../lib/url';
import EmailFallback from './EmailFallback.astro';

/**
 * CTA band: ONE primary CTA + authentic urgency line + micro-commitment + secondary text link
 * (planning/04 §7–8). Slot = optional post-decision reinforcement (below the button).
 */
interface Props {
  heading: string;
  text?: string;
  /** A small heading and a line between the lead and the button (Home, WP19: the timing sits before the ask). */
  plan?: { heading: string; text: string };
  cta: { label: string; href: string };
  urgency?: string;
  micro?: string;
  secondary?: { label: string; href: string };
  /** WP27: further text links on a line of their own under the action row (a way to the partnership routes from an evidence page). */
  more?: { label: string; href: string }[];
  /** One text line of other routes beside the single primary button, each a text link: "Governments: Request a Briefing for Your Ministry" (WP23). */
  routes?: { audience: string; label: string; href: string }[];
  /** C14 post-decision reinforcement lines (validate / transformation / first action). */
  reinforce?: string[];
  tone?: 'airy' | 'klein';
  id?: string;
  /** Who the fallback address belongs to when it is a specific team ("the Bangladesh team at"). */
  fallbackLabel?: string;
}
const { heading, text, plan, cta, urgency, micro, secondary, more = [], routes = [], reinforce = [], tone = 'airy', id, fallbackLabel } = Astro.props;
// A withheld route (empty href) is not drawn.
const shownRoutes = routes.filter((r) => r.href);
const dark = tone === 'klein';
// An empty href is a withheld call to action (src/lib/mailto.ts ctaWithheld): without its primary CTA the band has nothing to ask for.
const withheld = !cta.href;
---

{withheld ? null : (
<Section tone={tone} id={id} pad="lg" aria-labelledby={`${id ?? 'cta'}-h`}>
  <div class="cta-band">
    <h2 id={`${id ?? 'cta'}-h`} class="cta-band__title" data-reveal>{heading}</h2>
    {text && <p class="lead cta-band__text" data-reveal>{text}</p>}
    {
      plan && (
        <div class="cta-band__plan" data-reveal>
          <h3 class="cta-band__plan-title">{plan.heading}</h3>
          <p>{plan.text}</p>
        </div>
      )
    }
    <div class="cta-band__actions" data-reveal>
      <Button variant={dark ? 'inverse' : 'primary'} href={cta.href} iconEnd="arrow-right">{cta.label}</Button>
      {
        secondary?.href && (
          <a class="link" href={linkAttrs(secondary.href).href} rel={linkAttrs(secondary.href).rel}>
            {secondary.label}
          </a>
        )
      }
    </div>
    {
      more.length > 0 && (
        <p class="cta-band__more" data-reveal>
          {more.map((l) => (
            <a class="link" href={linkAttrs(l.href).href} rel={linkAttrs(l.href).rel}>{l.label}</a>
          ))}
        </p>
      )
    }
    {
      shownRoutes.length > 0 && (
        <p class="cta-band__routes" data-reveal>
          {shownRoutes.map((r, i) => (
            <>
              {i > 0 && ' '}
              <span class="cta-band__route">
                {r.audience}: <a class="link" href={linkAttrs(r.href).href} rel={linkAttrs(r.href).rel}>{r.label}</a>
              </span>
            </>
          ))}
        </p>
      )
    }
    {cta.href.startsWith('mailto:') && <EmailFallback href={cta.href} recipientLabel={fallbackLabel} />}
    {(urgency || micro) && (
      <ul class="cta-band__notes" role="list" data-reveal>
        {urgency && <li>{urgency}</li>}
        {micro && <li>{micro}</li>}
      </ul>
    )}
    {reinforce.length > 0 && (
      <ul class="cta-band__reinforce" role="list" data-reveal>
        {reinforce.map((r) => <li>{r}</li>)}
      </ul>
    )}
    <slot />
  </div>
</Section>
)}

<style>
  .cta-band {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    max-width: 46rem;
    margin-inline: auto;
  }
  .cta-band > * {
    margin: 0;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md) var(--space-lg);
  }
  .cta-band__more {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-lg);
    font-size: var(--fs-body-base);
  }
  .cta-band__routes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-lg);
    font-size: var(--fs-body-base);
    color: var(--ctx-text);
  }
  .cta-band__notes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-lg);
    list-style: none;
    padding: 0;
    font-size: var(--fs-body-xs);
    color: var(--ctx-text);
  }
  .cta-band__reinforce {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: var(--space-md) 0 0;
    border-top: 1px solid var(--ctx-border);
    display: grid;
    gap: var(--space-xs);
    font-size: var(--fs-body-base);
    color: var(--ctx-text);
    max-width: 40rem;
  }
  .cta-band__title {
    color: var(--ctx-section-heading);
  }
  .cta-band__plan {
    display: grid;
    gap: var(--space-xs);
    max-width: 40rem;
  }
  .cta-band__plan > * {
    margin: 0;
  }
  .cta-band__plan-title {
    font: var(--fw-bold) var(--fs-body-l) / var(--lh-body-l) var(--font-sans);
    color: var(--ctx-section-heading);
  }
</style>
