---
import Icon from '../system/Icon.astro';
---

<button class="btt" type="button" data-backtotop aria-label="Back to top">
  <svg class="btt__ring" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle class="btt__track" cx="24" cy="24" r="20" />
    <circle class="btt__bar" data-ring cx="24" cy="24" r="20" />
  </svg>
  <Icon name="arrow-up" size={20} />
</button>

<style>
  .btt {
    position: fixed;
    right: var(--space-gutter);
    bottom: calc(var(--space-gutter) + env(safe-area-inset-bottom));
    z-index: 90;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--primary);
    box-shadow: var(--shadow-card-hover);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--dur-base) ease, transform var(--dur-base) var(--ease-standard), visibility 0s linear var(--dur-base);
  }
  .btt.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .btt:hover {
    background: var(--primary);
    color: var(--on-primary);
  }
  .btt__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .btt__track,
  .btt__bar {
    fill: none;
    stroke-width: 3;
  }
  .btt__track {
    stroke: var(--primary-fixed);
  }
  .btt__bar {
    stroke: var(--primary);
    stroke-linecap: round;
    stroke-dasharray: 125.664;
    stroke-dashoffset: 125.664;
  }
  .btt:hover .btt__track {
    stroke: var(--blue-600);
  }
  .btt:hover .btt__bar {
    stroke: var(--on-primary);
  }
  @media (prefers-reduced-motion: reduce) {
    .btt {
      transform: none;
    }
    .btt__bar {
      display: none;
    }
  }
</style>

<script>
  import '../../scripts/backtotop';
</script>
