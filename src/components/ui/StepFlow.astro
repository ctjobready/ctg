---
/** StepFlow ➕ — numbered steps (Discovery → Co-design → Agreement → Launch). */
interface Props {
  steps: { title: string; text?: string }[];
  class?: string;
}
const { steps, class: className } = Astro.props;
---

<ol class:list={['steps', className]} role="list" style={`--n:${steps.length}`}>
  {
    steps.map((s, i) => (
      <li class="steps__item" data-reveal>
        <span class="steps__num" aria-hidden="true">{i + 1}</span>
        <div>
          <h3 class="steps__title"><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
          {s.text && <p class="steps__text">{s.text}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    counter-reset: step;
  }
  .steps__item {
    position: relative;
    display: flex;
    gap: var(--space-md);
  }
  .steps__num {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: var(--on-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-bold);
    font-size: var(--fs-heading-m);
    position: relative;
    z-index: 1;
  }
  .steps__title {
    font-size: var(--fs-heading-l);
    line-height: var(--lh-heading-l);
    color: var(--ctx-heading);
  }
  .steps__text {
    margin: 4px 0 0;
    color: var(--ctx-text);
  }
  /* mobile: vertical connector */
  .steps__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 21px;
    top: 44px;
    bottom: calc(var(--space-lg) * -1);
    width: 2px;
    background: var(--ctx-border);
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: var(--space-gutter);
    }
    .steps__item {
      flex-direction: column;
    }
    .steps__item:not(:last-child)::after {
      left: 44px;
      right: calc(var(--space-gutter) * -1);
      top: 21px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }
</style>
