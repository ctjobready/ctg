---
/** StepFlow ➕ — numbered steps (Discovery → Co-design → Agreement → Launch). */
interface Props {
  steps: { title: string; text?: string }[];
  class?: string;
  /** Heading level of each step: 3 under an H2 section, 4 when the steps follow their own H3 heading ("How it works in three steps"). */
  level?: 3 | 4;
}
const { steps, class: className, level = 3 } = Astro.props;
const Tag = level === 4 ? 'h4' : 'h3';
// step titles are often shared with body text (timelines, tables), so Title Case is applied here, for the heading only
import { titleCase } from '../../lib/titleCase.mjs';
// A numeric range in a heading ("6–8 Weeks") stays on one line: it never wraps after the en dash (the odd entries of the split are the ranges).
const headingParts = (title: string) => titleCase(title).split(/(\d+–\d+)/);
---

<ol class:list={['steps', className]} role="list" style={`--n:${steps.length}`}>
  {
    steps.map((s, i) => (
      <li class="steps__item" data-reveal>
        <span class="steps__num" aria-hidden="true">{i + 1}</span>
        <div>
          <Tag class="steps__title"><span class="sr-only">Step {i + 1}: </span>{headingParts(s.title).map((part, k) => (k % 2 ? <span class="steps__range">{part}</span> : part))}</Tag>
          {s.text && <p class="steps__text">{s.text}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    counter-reset: step;
  }
  .steps__item {
    position: relative;
    display: flex;
    gap: var(--space-md);
  }
  .steps__num {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: var(--on-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-bold);
    font-size: var(--fs-heading-m);
    position: relative;
    z-index: 1;
  }
  .steps__title {
    font-size: var(--fs-heading-l);
    line-height: var(--lh-heading-l);
    color: var(--ctx-heading);
  }
  .steps__range {
    white-space: nowrap;
  }
  .steps__text {
    margin: var(--stack-title) 0 0;
    color: var(--ctx-text);
  }
  /* mobile: vertical connector */
  .steps__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 21px;
    top: 44px;
    bottom: calc(var(--space-lg) * -1);
    width: 2px;
    background: var(--ctx-border);
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: var(--space-gutter);
    }
    .steps__item {
      flex-direction: column;
    }
    .steps__item:not(:last-child)::after {
      left: 44px;
      right: calc(var(--space-gutter) * -1);
      top: 21px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }
</style>
