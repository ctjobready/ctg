---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Accepts an imported ImageMetadata (optimised via astro:assets) or a plain URL string. */
type Source = ImageMetadata | string;
interface Props {
  src: Source;
  alt: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** D13: ID of a consent-dependent asset (learner photo etc.); written to data-asset for scripts/check-permissions.mjs. */
  assetId?: string;
  class?: string;
}
const { src, alt, width, height, widths, sizes, loading = 'lazy', fetchpriority, assetId, class: className } = Astro.props;
---

{
  typeof src === 'string' ? (
    <img class={className} data-asset={assetId} src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" fetchpriority={fetchpriority} />
  ) : (
    <Image
      class={className}
      data-asset={assetId}
      src={src}
      alt={alt}
      width={width}
      height={height}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      format="webp"
    />
  )
}
