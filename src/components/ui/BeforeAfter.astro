---
/**
 * BeforeAfter ➕ — two-bar chart (e.g. employment 47.4% → 77.9%). SVG with an accessible data table.
 * M4: the "before" bar grows, then the "after" bar, then the delta chip pops in.
 */
interface Point {
  label: string;
  value: number;
  /** Text under the bar (basis, e.g. "Before training"). */
  caption?: string;
}
interface Props {
  title: string;
  before: Point;
  after: Point;
  /** Delta chip text, e.g. "+30.5 pp". A trailing " pp" is spelled out ("percentage points") in the chip, the chart description and the data table. */
  delta?: string;
  unit?: string;
  /** Kept for API clarity: colors follow the surrounding Section band (--ctx-* tokens). */
  tone?: 'light' | 'dark';
  /** Source / base note shown under the chart. */
  note?: string;
  class?: string;
}
const { title, before, after, delta, unit = '%', note, class: className } = Astro.props;

const W = 480;
const H = 320;
const baseY = 262;
const maxH = 190;
const barW = 132;
const xs = [88, 260];
const bars = [
  { ...before, x: xs[0], cls: 'ba-before' },
  { ...after, x: xs[1], cls: 'ba-after' },
].map((b) => {
  const h = (Math.max(0, Math.min(100, b.value)) / 100) * maxH;
  return { ...b, h, y: baseY - h };
});
const fmt = (v: number) => `${v}${unit}`;
// "+30.5 pp" is shown as "+30.5" over "percentage points": no bare "pp" before it has been spelled out (doc 06 copy conventions).
const deltaUnit = delta?.endsWith(' pp') ? 'percentage points' : undefined;
const deltaValue = delta && deltaUnit ? delta.slice(0, -3) : delta;
const deltaFull = delta && deltaUnit ? `${deltaValue} ${deltaUnit}` : delta;
const desc = `${before.label}: ${fmt(before.value)}. ${after.label}: ${fmt(after.value)}.${deltaFull ? ` Change: ${deltaFull}.` : ''}`;
---

<div class:list={['ba', className]} data-reveal>
  <figure class="ba__fig">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}. ${desc}`}>
      <line class="ba-axis" x1="40" y1={baseY} x2={W - 40} y2={baseY} />
      {
        bars.map((b, i) => (
          <g class={b.cls} style={`--bi:${i}`}>
            <rect class="ba-bar" x={b.x} y={b.y} width={barW} height={b.h} rx="8" />
            <text class="ba-value" x={b.x + barW / 2} y={b.y - 12} text-anchor="middle">{fmt(b.value)}</text>
            <text class="ba-label" x={b.x + barW / 2} y={baseY + 26} text-anchor="middle">{b.label}</text>
            {b.caption && <text class="ba-cap" x={b.x + barW / 2} y={baseY + 46} text-anchor="middle">{b.caption}</text>}
          </g>
        ))
      }
      {
        delta && (
          <g class="ba-delta" transform={`translate(${W / 2 - 4} ${bars[1].y - (deltaUnit ? 72 : 62)})`}>
            {
              deltaUnit ? (
                <>
                  <rect x="-76" y="-24" width="152" height="54" rx="20" />
                  <text x="0" y="0" text-anchor="middle">{deltaValue}</text>
                  <text class="ba-unit" x="0" y="20" text-anchor="middle">{deltaUnit}</text>
                </>
              ) : (
                <>
                  <rect x="-48" y="-18" width="96" height="36" rx="18" />
                  <text x="0" y="6" text-anchor="middle">{delta}</text>
                </>
              )
            }
          </g>
        )
      }
    </svg>
    <figcaption class="ba__cap">
      <span class="ba__title">{title}</span>
      {note && <span class="ba__note">{note}</span>}
    </figcaption>
  </figure>
  <details class="ba__data">
    <summary>View chart data as a table</summary>
    <table>
      <caption class="sr-only">{title}</caption>
      <thead><tr><th scope="col">Measure</th><th scope="col">Value</th></tr></thead>
      <tbody>
        <tr><th scope="row">{before.label}{before.caption ? ` (${before.caption})` : ''}</th><td>{fmt(before.value)}</td></tr>
        <tr><th scope="row">{after.label}{after.caption ? ` (${after.caption})` : ''}</th><td>{fmt(after.value)}</td></tr>
        {deltaFull && <tr><th scope="row">Change</th><td>{deltaFull}</td></tr>}
      </tbody>
    </table>
  </details>
</div>

<style>
  .ba {
    margin: 0;
    max-width: 560px;
  }
  /* The figure holds the chart and its caption (figcaption must be its first or last child); the data table disclosure follows it. */
  .ba__fig {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .ba-axis {
    stroke: var(--ctx-border, var(--outline-variant));
    stroke-width: 2;
  }
  .ba-before .ba-bar {
    fill: var(--ba-before, var(--primary-fixed-dim));
  }
  .ba-after .ba-bar {
    fill: var(--ba-after, var(--brand-bright));
  }
  .ba-bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .ba-value {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -1px;
    fill: var(--ctx-heading);
  }
  .ba-after .ba-value {
    fill: var(--ctx-accent);
  }
  .ba-label {
    font-size: 17px;
    font-weight: 700;
    fill: var(--ctx-heading);
  }
  .ba-cap {
    font-size: 15px;
    fill: var(--ctx-text);
  }
  .ba-delta rect {
    fill: var(--tertiary-container);
    stroke: var(--tertiary);
    stroke-width: 1;
  }
  .ba-delta text {
    font-size: 20px;
    font-weight: 700;
    fill: var(--on-tertiary-container);
  }
  .ba-delta .ba-unit {
    font-size: 15px;
    font-weight: 600;
  }
  .ba-delta {
    transform-box: fill-box;
    transform-origin: center;
  }
  .ba__cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--space-sm);
  }
  .ba__title {
    font-weight: var(--fw-bold);
    color: var(--ctx-heading);
  }
  .ba__note {
    font-size: var(--fs-body-xs);
    color: var(--ctx-muted);
  }
  .ba__data {
    margin-top: var(--space-sm);
    font-size: var(--fs-body-xs);
  }
  .ba__data summary {
    color: var(--ctx-link);
    font-weight: var(--fw-medium);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .ba__data table {
    width: 100%;
    margin-top: var(--space-xs);
  }
  .ba__data th,
  .ba__data td {
    text-align: left;
    padding: 6px 0;
    border-bottom: 1px solid var(--ctx-border, var(--outline-variant));
  }
  /* M4 */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ba .ba-bar {
      transform: scaleY(0);
    }
    :global(.js) .ba .ba-value,
    :global(.js) .ba .ba-delta {
      opacity: 0;
    }
    :global(.js) .ba.is-visible .ba-bar {
      transform: scaleY(1);
      transition: transform 800ms var(--ease-emphasized) calc(150ms + var(--bi) * 650ms);
    }
    :global(.js) .ba.is-visible .ba-value {
      opacity: 1;
      transition: opacity 400ms ease calc(600ms + var(--bi) * 650ms);
    }
    :global(.js) .ba.is-visible .ba-delta {
      opacity: 1;
      animation: ct-pop 500ms var(--ease-emphasized) 1900ms backwards;
    }
  }
</style>
