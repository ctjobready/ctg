---
/** Timeline ➕ (2014 → 2026). Scroll-progress line fills as you scroll (M16, CSS scroll-driven). */
interface Props {
  items: { year: string; title: string; text?: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<div class:list={['timeline', className]}>
  <ol class="timeline__list" role="list">
    {
      items.map((it) => (
        <li class="timeline__item">
          <span class="timeline__dot" aria-hidden="true"></span>
          <p class="timeline__year">{it.year}</p>
          <h3 class="timeline__title">{it.title}</h3>
          {it.text && <p class="timeline__text">{it.text}</p>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .timeline__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 36px;
    --line: var(--primary-fixed);
  }
  .timeline__list::before,
  .timeline__list::after {
    content: '';
    position: absolute;
    left: 9px;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: var(--radius-full);
  }
  .timeline__list::before {
    background: var(--line);
  }
  .timeline__list::after {
    background: var(--primary);
    transform-origin: top;
  }
  .timeline__item {
    position: relative;
    padding-bottom: var(--space-lg);
  }
  .timeline__item:last-child {
    padding-bottom: 0;
  }
  .timeline__item > * {
    margin: 0;
  }
  .timeline__dot {
    position: absolute;
    left: -36px;
    top: 4px;
    width: 21px;
    height: 21px;
    border-radius: var(--radius-full);
    background: var(--primary);
    border: 4px solid var(--surface);
    box-shadow: 0 0 0 2px var(--primary);
  }
  .timeline__year {
    font-size: var(--fs-heading-xl);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: var(--primary);
  }
  .timeline__title {
    font-size: var(--fs-heading-m);
    margin-top: 2px !important;
  }
  .timeline__text {
    margin-top: var(--space-xs) !important;
    max-width: 52ch;
  }
  /* M16: line fills + milestones light up on scroll (progressive; static & fully lit otherwise) */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .timeline__list::after {
        animation: tl-fill linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 70%;
      }
      .timeline__dot {
        animation: tl-dot linear both;
        animation-timeline: view();
        animation-range: entry 40% entry 90%;
      }
      @keyframes tl-fill {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }
      @keyframes tl-dot {
        from {
          background: var(--surface);
        }
        to {
          background: var(--primary);
        }
      }
    }
  }
</style>
