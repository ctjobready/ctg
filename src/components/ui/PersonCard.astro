---
import Img from './Img.astro';
import { linkAttrs } from '../../lib/url';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  role: string;
  photo?: ImageMetadata | string;
  /** Profile link (T7). Omit for a non-linked card. */
  href?: string;
  bio?: string;
  /** D13: consent-dependent asset ID (portrait) → data-asset. */
  assetId?: string;
  class?: string;
}
const { name, role, photo, href, bio, assetId, class: className } = Astro.props;
const a = href ? linkAttrs(href) : undefined;
const initials = name
  .split(/\s+/)
  .map((w) => w[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<article class:list={['card person', a && 'card--link', className]} data-reveal data-asset={assetId}>
  <div class="person__photo">
    {photo ? <Img src={photo} alt={`Portrait of ${name}`} width={480} height={480} widths={[240, 480]} sizes="(min-width:1024px) 280px, 60vw" /> : <span class="person__initials" aria-hidden="true">{initials}</span>}
  </div>
  <div class="card__body">
    <h3 class="card__title">{a ? <a class="card__link" href={a.href} rel={a.rel}>{name}</a> : name}</h3>
    <p class="card__meta person__role">{role}</p>
    {bio && <p class="card__text">{bio}</p>}
  </div>
</article>

<style>
  .person__photo {
    aspect-ratio: 1 / 1;
    background: var(--secondary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .person__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .person__initials {
    font-size: var(--fs-display-4xl);
    font-weight: var(--fw-bold);
    color: var(--on-secondary-container);
    letter-spacing: -1px;
  }
  .person__role {
    color: var(--on-surface-variant);
    font-size: var(--fs-body-base);
  }
</style>
