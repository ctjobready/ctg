---
import Icon from '../system/Icon.astro';
import Img from './Img.astro';
import HeroArt from './HeroArt.astro';
import { linkAttrs } from '../../lib/url';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  program?: string;
  partner?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** D13 asset id of the photo (data-asset). */
  assetId?: string;
  /** Outcome-first headline stat; `evidence` is its evidence label, set on its own line under the label. */
  stat?: { value: string; label: string; evidence?: string | null };
  /**
   * WP37 (cycle-14 review): one line of delivery context in the stat's place, for a card whose figure the same page already shows elsewhere (Home: the Results carousel
   * states the Kosovo and Her Power results). The card then shows no figure. Used only when there is no `stat`.
   * WP57 (cycle-29 review, Gemini GM4): Home's Kosovo card puts its program-records line here ("Program records: 102 of 150 women in work.", KOSOVO_RECORDS), so the card shows both Kosovo figures (the World Bank's is its `note`).
   */
  context?: string;
  /** WP57: the register facts the `context` line states, when it states any (data-fact on the line; the Kosovo card's "Program records: ..." line is PR-02's). */
  contextFacts?: string[];
  /**
   * WP55 (owner decision 2026-10-17, "Show both"): one short line under the figure or the context, for a figure a second source reports for the same program. The Kosovo card says "World Bank: 77 trainees won at
   * least one online contract." under the program records (WB_KOSOVO, src/data/copy.ts); `facts` are the register facts the line states (data-fact).
   */
  note?: { text: string; facts: string[] };
  href: string;
  class?: string;
}
const { title, program, partner, image, imageAlt = '', assetId, stat, context, contextFacts, note, href, class: className } = Astro.props;
const a = linkAttrs(href);
---

<article class:list={['card card--link case', className]} data-reveal>
  <div class="card__media">
    {/* No photo: the design system's seeded HeroArt composition (decorative, aria-hidden), distinct per card. */}
    {image ? <Img src={image} alt={imageAlt} width={720} height={480} widths={[360, 720]} sizes="(min-width:1024px) 380px, 90vw" assetId={assetId} /> : <HeroArt seed={`case-${title}`} shape="card" />}
  </div>
  <div class="card__body">
    {stat && (
      <p class="case__stat">
        <span class="case__value">{stat.value}</span>{' '}
        <span class="case__label">{stat.label}</span>{' '}
        {stat.evidence && <span class="case__evid">{stat.evidence}</span>}
      </p>
    )}
    {!stat && context && <p class="case__context" data-fact={contextFacts?.length ? contextFacts.join(' ') : undefined}>{context}</p>}
    {note && <p class="case__note" data-fact={note.facts.join(' ')}>{note.text}</p>}
    <h3 class="card__title"><a class="card__link" href={a.href} rel={a.rel}>{title}</a></h3>
    {(program || partner) && <p class="card__meta">{[program, partner].filter(Boolean).join(' · ')}</p>}
    <span class="card__more" aria-hidden="true">Read the Case Study<span class="sr-only">: {title}</span><Icon name="arrow-right" size={16} /></span>
  </div>
</article>

<style>
  .case__stat {
    display: flex;
    flex-direction: column;
  }
  .case__value {
    font-size: var(--fs-heading-2xl);
    line-height: 1.15;
    font-weight: var(--fw-bold);
    color: var(--primary);
    letter-spacing: -1px;
  }
  .case__label {
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
    text-wrap: balance;
  }
  .case__evid {
    margin-top: var(--space-xs);
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-medium);
    color: var(--secondary);
  }
  /* the second source's line (WP55) sits under the figure in the label's small type */
  .case__note {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
  }
  /* the delivery-context line sits where the stat sits, set as a short statement in the system's body type */
  .case__context {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    font-weight: var(--fw-medium);
    color: var(--secondary);
    text-wrap: balance;
  }
</style>
