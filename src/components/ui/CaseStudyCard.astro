---
import Icon from '../system/Icon.astro';
import Img from './Img.astro';
import HeroArt from './HeroArt.astro';
import { linkAttrs } from '../../lib/url';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  program?: string;
  partner?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** Outcome-first headline stat; `evidence` is its evidence label, set on its own line under the label. */
  stat?: { value: string; label: string; evidence?: string | null };
  href: string;
  class?: string;
}
const { title, program, partner, image, imageAlt = '', stat, href, class: className } = Astro.props;
const a = linkAttrs(href);
---

<article class:list={['card card--link case', className]} data-reveal>
  <div class="card__media">
    {/* No photo: the design system's seeded HeroArt composition (decorative, aria-hidden), distinct per card. */}
    {image ? <Img src={image} alt={imageAlt} width={720} height={480} widths={[360, 720]} sizes="(min-width:1024px) 380px, 90vw" /> : <HeroArt seed={`case-${title}`} shape="card" />}
  </div>
  <div class="card__body">
    {stat && (
      <p class="case__stat">
        <span class="case__value">{stat.value}</span>
        <span class="case__label">{stat.label}</span>
        {stat.evidence && <span class="case__evid">{stat.evidence}</span>}
      </p>
    )}
    <h3 class="card__title"><a class="card__link" href={a.href} rel={a.rel}>{title}</a></h3>
    {(program || partner) && <p class="card__meta">{[program, partner].filter(Boolean).join(' · ')}</p>}
    <span class="card__more" aria-hidden="true">Read the case study<Icon name="arrow-right" size={16} /></span>
  </div>
</article>

<style>
  .case__stat {
    display: flex;
    flex-direction: column;
  }
  .case__value {
    font-size: var(--fs-heading-2xl);
    line-height: 1.15;
    font-weight: var(--fw-bold);
    color: var(--primary);
    letter-spacing: -1px;
  }
  .case__label {
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
    text-wrap: balance;
  }
  .case__evid {
    margin-top: 2px;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-medium);
    color: var(--secondary);
  }
</style>
