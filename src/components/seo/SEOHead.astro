---
import { canonicalUrl, url } from '../../lib/url';
import { SITE_NAME, ENTITY_DEFINITION, PRODUCTION_ORIGIN, CSP } from '../../lib/site';
import { truncate } from '../../lib/format';
import { FONT_PRELOADS, fontFaceCss } from '../../lib/fonts';
import { ogCardFor } from '../../lib/og';

interface Props {
  title: string;
  description?: string;
  /** Site path of this page (base-less), e.g. "/about/". */
  path: string;
  /** Add " | CodersTrust" to the title (default true; false for Home). */
  suffix?: boolean;
  /** Absolute or site-relative image for og:image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  /** Force noindex even in production (styleguide, 404, redirect stubs). */
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}
const {
  title,
  description = truncate(ENTITY_DEFINITION, 200),
  path,
  suffix = true,
  image: imageProp,
  imageAlt: imageAltProp,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

// A page that passes no image gets its section's card (src/lib/og.ts, rendered by scripts/build-og.mjs).
const card = ogCardFor(path);
const image = imageProp ?? card.src;
const imageAlt = imageAltProp ?? (imageProp ? 'CodersTrust — Learn. Earn. Prosper.' : card.alt);

const fullTitle = suffix && !title.includes(SITE_NAME) ? `${title} | ${SITE_NAME}` : title;
const canonical = canonicalUrl(path);
// Staging is always noindex (planning/08 §2): prevents duplicate-content indexing while WordPress is live.
const staging = __SITE_ENV__ !== 'production';
const robots = staging || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
// Social images always use the absolute production URL (they are fetched by crawlers, not by the visitor's browser).
const ogImage = image.startsWith('http') ? image : PRODUCTION_ORIGIN + (image.startsWith('/') ? image : '/' + image);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="theme-color" content="#002FA7" />
<meta http-equiv="Content-Security-Policy" content={CSP} />
<link rel="canonical" href={canonical} />
<link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<link rel="manifest" href={url('/site.webmanifest')} />

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{FONT_PRELOADS.map((f) => <link rel="preload" href={url('/' + f)} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={fontFaceCss()}></style>
