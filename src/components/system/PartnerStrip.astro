---
import Icon from './Icon.astro';
import Img from '../ui/Img.astro';
import { linkAttrs } from '../../lib/url';
import type { ImageMetadata } from 'astro';

interface Item {
  name: string;
  /** Logo image; when absent the name is set as text. */
  logo?: ImageMetadata | string;
  href?: string;
}
interface Props {
  title?: string;
  items: Item[];
  /** grid = static strip; marquee = continuous scroll (M13) */
  variant?: 'grid' | 'marquee';
  class?: string;
}
const { title, items, variant = 'grid', class: className } = Astro.props;
---

<section class:list={['partners', `partners--${variant}`, className]} aria-label={title ?? 'Partners'} data-marquee={variant === 'marquee' ? '' : undefined}>
  {title && <p class="partners__title">{title}</p>}
  {
    variant === 'grid' ? (
      <ul class="partners__row" role="list">
        {items.map((it) => (
          <li>{it.href ? <a href={linkAttrs(it.href).href} rel={linkAttrs(it.href).rel} class="partners__item">{it.logo ? <Img src={it.logo} alt={it.name} height={40} /> : it.name}</a> : <span class="partners__item">{it.logo ? <Img src={it.logo} alt={it.name} height={40} /> : it.name}</span>}</li>
        ))}
      </ul>
    ) : (
      <>
        <div class="marquee">
          <div class="marquee__inner">
            <ul class="partners__row marquee__track" role="list">
              {items.map((it) => (
                <li>{it.href ? <a href={linkAttrs(it.href).href} rel={linkAttrs(it.href).rel} class="partners__item">{it.logo ? <Img src={it.logo} alt={it.name} height={40} /> : it.name}</a> : <span class="partners__item">{it.logo ? <Img src={it.logo} alt={it.name} height={40} /> : it.name}</span>}</li>
              ))}
            </ul>
            <ul class="partners__row marquee__track marquee__clone" role="list" aria-hidden="true" inert>
              {items.map((it) => (
                <li><span class="partners__item">{it.logo ? <Img src={it.logo} alt="" height={40} /> : it.name}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <button class="marquee__toggle" type="button" hidden data-marquee-toggle aria-pressed="false" aria-label="Pause logo animation">
          <Icon name="pause" size={16} />
        </button>
      </>
    )
  }
</section>

<style>
  .partners {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-lg);
  }
  .partners__title {
    margin: 0;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--ctx-text);
    text-align: center;
  }
  .partners__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .partners__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    max-width: 160px;
    font-size: var(--fs-body-m);
    font-weight: var(--fw-bold);
    color: var(--ctx-text);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity var(--dur-base) ease, filter var(--dur-base) ease;
  }
  .partners__item :global(img) {
    max-height: 40px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: grayscale(1);
    transition: filter var(--dur-base) ease;
  }
  a.partners__item:hover,
  a.partners__item:focus-visible {
    opacity: 1;
  }
  a.partners__item:hover :global(img),
  a.partners__item:focus-visible :global(img) {
    filter: none;
  }

  /* ---- Marquee (M13) ---- */
  .marquee {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }
  .marquee__inner {
    display: flex;
    width: max-content;
  }
  .marquee__track {
    flex-wrap: nowrap;
    flex: none;
    padding-right: var(--space-lg);
  }
  .marquee__track .partners__item {
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee__inner {
      animation: marquee 40s linear infinite;
    }
    .marquee:hover .marquee__inner,
    .marquee:focus-within .marquee__inner,
    .partners.is-paused .marquee__inner {
      animation-play-state: paused;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .marquee__toggle {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--primary-fixed);
    color: var(--primary);
    background: var(--surface);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .marquee__toggle:hover {
    background: var(--surface-container-low);
  }
  /* Reduced motion: static wrapped grid, clone and pause control removed */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }
    .marquee__inner {
      width: auto;
      justify-content: center;
    }
    .marquee__track {
      flex-wrap: wrap;
      padding-right: 0;
    }
    .marquee__clone,
    .marquee__toggle {
      display: none !important;
    }
  }
</style>

<script>
  import '../../scripts/marquee';
</script>
