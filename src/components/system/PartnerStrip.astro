---
import Icon from './Icon.astro';
import Img from '../ui/Img.astro';
import { linkAttrs } from '../../lib/url';
import { partnerLogos, pressLogos, PARTNER_CAPTION, PRESS_CAPTION, type PartnerGroup } from '../../lib/logos';

/**
 * PartnerStrip — quiet credibility band. Logos come from src/data/partners.ts (relationships, not
 * endorsements, PA-04): grayscale + reduced opacity at rest, full color on hover/focus.
 * `grid` = static; `marquee` = continuous scroll (M13) with hover/focus pause + pause button.
 */
interface Item {
  name: string;
  logo?: ImageMetadata | string;
  href?: string;
  white?: boolean;
}
interface Props {
  /** partners (default) or press outlets ("As covered in"). */
  kind?: 'partners' | 'press';
  /** Filter partners by group. */
  group?: PartnerGroup | PartnerGroup[];
  /** Caption above the strip; defaults to the PA-04 caption (partners) or "As covered in" (press). */
  caption?: string | false;
  variant?: 'grid' | 'marquee';
  /** Override the data source with explicit items. */
  items?: Item[];
  /** Logos link to the partner's site (grid only). */
  link?: boolean;
  class?: string;
}
import type { ImageMetadata } from 'astro';
const { kind = 'partners', group, caption, variant = 'grid', items, link = false, class: className } = Astro.props;
const list: Item[] = items ?? (kind === 'press' ? pressLogos() : partnerLogos(group));
const cap = (caption === undefined ? (kind === 'press' ? PRESS_CAPTION : PARTNER_CAPTION) : caption);
const label = cap || (kind === 'press' ? 'Press coverage' : 'Partners');
---

<section class:list={['partners', `partners--${variant}`, className]} aria-label={label} data-marquee={variant === 'marquee' ? '' : undefined}>
  {cap && <p class="partners__title">{cap}</p>}
  {
    variant === 'grid' ? (
      <ul class="partners__row" role="list">
        {list.map((it) => {
          const a = link && it.href ? linkAttrs(it.href) : undefined;
          return (
            <li>
              {a ? (
                <a href={a.href} rel={a.rel} class:list={['partners__item', it.white && 'is-white']}>
                  {it.logo ? <Img src={it.logo} alt={it.name} height={40} /> : it.name}
                  <span class="sr-only">{a.srText}</span>
                </a>
              ) : (
                <span class:list={['partners__item', it.white && 'is-white']}>{it.logo ? <Img src={it.logo} alt={it.name} height={40} /> : it.name}</span>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <>
        <div class="marquee">
          <div class="marquee__inner">
            <ul class="partners__row marquee__track" role="list">
              {list.map((it) => (
                <li><span class:list={['partners__item', it.white && 'is-white']}>{it.logo ? <Img src={it.logo} alt={it.name} height={40} /> : it.name}</span></li>
              ))}
            </ul>
            <ul class="partners__row marquee__track marquee__clone" role="list" aria-hidden="true" inert>
              {list.map((it) => (
                <li><span class:list={['partners__item', it.white && 'is-white']}>{it.logo ? <Img src={it.logo} alt="" height={40} /> : it.name}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <button class="marquee__toggle" type="button" hidden data-marquee-toggle aria-pressed="false" aria-label="Pause logo animation">
          <Icon name="pause" size={16} class="marquee__ic-pause" />
          <Icon name="play" size={16} class="marquee__ic-play" />
        </button>
      </>
    )
  }
</section>

<style>
  .partners {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    min-width: 0;
    max-width: 100%;
  }
  .partners__title {
    margin: 0;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--ctx-text);
    text-align: center;
  }
  .partners__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .partners__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    min-width: 72px;
    max-width: 176px;
    padding: 6px 8px;
    border-radius: var(--radius-default);
    font-size: var(--fs-body-m);
    font-weight: var(--fw-bold);
    color: var(--ctx-text);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity var(--dur-base) ease;
  }
  /* Logos whose artwork has a solid white background sit on a white tile */
  .partners__item.is-white {
    background: var(--surface);
    border: 1px solid var(--outline-variant);
  }
  .partners__item :global(img) {
    max-height: 44px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.85;
    transition: filter var(--dur-base) ease, opacity var(--dur-base) ease;
  }
  .partners__item:hover,
  a.partners__item:focus-visible {
    opacity: 1;
  }
  .partners__item:hover :global(img),
  a.partners__item:focus-visible :global(img) {
    filter: none;
    opacity: 1;
  }

  /* ---- Marquee (M13) ---- */
  .marquee {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }
  .marquee__inner {
    display: flex;
    width: max-content;
  }
  .marquee__track {
    flex-wrap: nowrap;
    flex: none;
    padding-right: var(--space-lg);
  }
  .marquee__track .partners__item {
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee__inner {
      animation: marquee 60s linear infinite;
    }
    .marquee:hover .marquee__inner,
    .marquee:focus-within .marquee__inner,
    .partners.is-paused .marquee__inner {
      animation-play-state: paused;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .marquee__toggle {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--primary-fixed);
    color: var(--primary);
    background: var(--surface);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .marquee__toggle :global(.marquee__ic-play),
  .partners.is-paused .marquee__toggle :global(.marquee__ic-pause) {
    display: none;
  }
  .partners.is-paused .marquee__toggle :global(.marquee__ic-play) {
    display: inline-block;
  }
  .marquee__toggle:focus-visible {
    outline: 2px solid var(--ctx-focus);
    outline-offset: 2px;
  }
  .marquee__toggle:hover {
    background: var(--surface-container-low);
  }
  /* Reduced motion: static wrapped grid, clone and pause control removed */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }
    .marquee__inner {
      width: auto;
      justify-content: center;
    }
    .marquee__track {
      flex-wrap: wrap;
      padding-right: 0;
    }
    .marquee__clone,
    .marquee__toggle {
      display: none !important;
    }
  }
</style>

<script>
  import '../../scripts/marquee';
</script>
