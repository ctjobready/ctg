---
interface Props {
  /** 0–100 */
  value: number;
  label: string;
  /** Text shown at the right ("77.9%"); defaults to value + "%". */
  valueLabel?: string;
  tone?: 'default' | 'bright';
  class?: string;
}
const { value, label, valueLabel, tone = 'default', class: className } = Astro.props;
const clamped = Math.max(0, Math.min(100, value));
---

<div class:list={['progress', tone === 'bright' && 'progress--bright', className]} data-reveal style={`--p:${clamped}`}>
  <div class="progress__head">
    <span>{label}</span>
    <b>{valueLabel ?? `${clamped}%`}</b>
  </div>
  <!-- The drawn bar is decoration; the native <progress> (visually hidden) carries the value for assistive technology. -->
  <div class="progress__track" aria-hidden="true">
    <div class="progress__fill"></div>
  </div>
  <progress class="sr-only" max="100" value={clamped} aria-label={label}>{valueLabel ?? `${clamped}%`}</progress>
</div>

<style>
  .progress {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .progress__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--ctx-text);
  }
  .progress__head b {
    color: var(--primary);
    font-weight: var(--fw-bold);
  }
  .progress__track {
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    overflow: hidden;
  }
  /* Fill animates transform: scaleX (origin left), never width. Final state is the default. */
  .progress__fill {
    height: 100%;
    background: var(--primary);
    transform: scaleX(calc(var(--p) / 100));
    transform-origin: left center;
  }
  .progress--bright .progress__fill {
    background: var(--brand-bright);
  }
  /* M3: fill 0 → value (800ms, transform only) once the bar is revealed. Only with JS + motion allowed; reduced motion = final state. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .progress .progress__fill {
      transform: scaleX(0);
    }
    :global(.js) .progress.is-visible .progress__fill {
      transform: scaleX(calc(var(--p) / 100));
      transition: transform 800ms var(--ease-emphasized) 150ms;
    }
  }
</style>
