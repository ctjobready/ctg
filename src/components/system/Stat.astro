---
import { parseFigure } from '../../lib/format';

interface Props {
  /** Display value, e.g. "77.9%", "130,000+", "15". Final text is always in the HTML. */
  value: string;
  label: string;
  /** default: Primary figure on light grounds; dark: white numerals on Klein/Deep Ink; accent: orange numerals on dark. */
  tone?: 'default' | 'dark' | 'accent';
  size?: 'md' | 'lg';
  align?: 'start' | 'center';
  /** Count up when it enters the viewport (M2). */
  count?: boolean;
  /** Footnote / source marker or short note under the label. */
  note?: string;
  /** Evidence label under the label, set apart by a rule (e.g. the register's program-data label); used by <FactStat>. */
  evidence?: string;
  class?: string;
}
const { value, label, tone = 'default', size = 'md', align = 'start', count = true, note, evidence, class: className } = Astro.props;
const fig = count ? parseFigure(value) : null;
// Reserve width for the final value: D-DIN has no tabular figures.
const widthCh = value.length;
---

<div class:list={['stat', `stat--${tone}`, `stat--${size}`, `stat--${align}`, className]}>
  <p class="stat__value">
    {
      fig ? (
        <>
          <span
            class="stat__num"
            aria-hidden="true"
            data-countup
            data-value={fig.num}
            data-prefix={fig.prefix}
            data-suffix={fig.suffix}
            data-decimals={fig.decimals}
            data-grouped={fig.grouped}
            style={`min-width:${widthCh}ch`}
          >
            {value}
          </span>
          <span class="sr-only">{value}</span>
        </>
      ) : (
        <span class="stat__num" style={`min-width:${widthCh}ch`}>{value}</span>
      )
    }
  </p>
  <p class="stat__label">{label}<slot /></p>
  {evidence && <p class="stat__evidence">{evidence}</p>}
  {note && <p class="stat__note">{note}</p>}
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    --stat-color: var(--ctx-stat);
    --stat-label: var(--ctx-text);
  }
  .stat--dark {
    --stat-color: var(--on-secondary);
    --stat-label: var(--primary-fixed);
  }
  .stat--accent {
    --stat-color: var(--tertiary-light);
    --stat-label: var(--primary-fixed);
  }
  .stat--center {
    align-items: center;
    text-align: center;
  }
  .stat__value {
    margin: 0;
    font-size: var(--fs-heading-2xl);
    line-height: 1.25;
    font-weight: var(--fw-bold);
    letter-spacing: -1px;
    color: var(--stat-color);
  }
  .stat--lg .stat__value {
    font-size: var(--fs-display-5xl);
    line-height: 1.15;
  }
  .stat__num {
    display: inline-block;
    text-align: inherit;
    white-space: nowrap;
  }
  .stat--start .stat__num {
    text-align: left;
  }
  .stat--center .stat__num {
    text-align: center;
  }
  .stat__label {
    margin: 0;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--stat-label);
    max-width: 28ch;
    /* Even line lengths for a two- or three-line label at 390 px (no one-word last line); <FactStat> renders its label through this class. */
    text-wrap: balance;
  }
  .stat__evidence {
    margin: 2px 0 0;
    padding-top: 4px;
    border-top: 1px solid var(--stat-rule, var(--primary-fixed));
    max-width: 28ch;
    text-wrap: balance;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-medium);
    color: var(--stat-evidence, var(--secondary));
  }
  .stat--dark .stat__evidence,
  .stat--accent .stat__evidence {
    --stat-rule: rgb(255 255 255 / 0.3);
    --stat-evidence: var(--primary-fixed);
  }
  .stat__note {
    margin: 0;
    font-size: var(--fs-body-xs);
    color: var(--ctx-muted);
  }
  .stat--dark .stat__note,
  .stat--accent .stat__note {
    color: var(--primary-fixed);
  }
</style>

<script>
  import '../../scripts/countup';
</script>
