---
import Icon from './Icon.astro';
import { linkAttrs } from '../../lib/url';

interface Props {
  title: string;
  icon?: string;
  /** Short supporting line ("count" in the system). */
  text?: string;
  href: string;
  active?: boolean;
  class?: string;
}
const { title, icon = 'users', text, href, active = false, class: className } = Astro.props;
const a = linkAttrs(href);
---

<a class:list={['cat', active && 'is-active', className]} href={a.href} rel={a.rel} data-reveal>
  <Icon name={icon} size={40} strokeWidth={1.5} class="cat__icon" />
  <span class="cat__title">{title}</span>
  {text && <span class="cat__text">{text}</span>}
  {a.srText && <span class="sr-only">{a.srText}</span>}
</a>

<style>
  /* Phone: a compact row — icon beside the title and its line — so a stack of eight cards is not a wall of empty white. */
  .cat {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'icon title'
      'icon text';
    align-items: center;
    column-gap: var(--space-md);
    row-gap: 2px;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    color: var(--on-surface);
    text-decoration: none;
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease,
      border-color var(--dur-base) ease;
  }
  .cat :global(.cat__icon) {
    grid-area: icon;
    align-self: start;
    width: 32px;
    height: 32px;
    color: var(--primary);
    transition: color var(--dur-base) ease;
  }
  .cat__title {
    grid-area: title;
    align-self: end;
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    font-weight: var(--fw-medium);
  }
  .cat__text {
    grid-area: text;
    align-self: start;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
    transition: color var(--dur-base) ease;
  }
  /* From 768 px: the roomier card. Icon on top, title directly under it (top-aligned, never pushed to the bottom), then the line.
     Where the browser supports subgrid, the cards of a row share their icon, title and text rows, so titles of one and two lines
     keep one baseline and the lines under them start together. */
  @media (min-width: 768px) {
    .cat {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'icon'
        'title'
        'text';
      grid-template-rows: auto auto 1fr;
      align-content: start;
      row-gap: var(--space-md);
      min-height: 197px;
      padding: 30px 30px 25px;
    }
    .cat :global(.cat__icon) {
      width: 40px;
      height: 40px;
    }
    .cat__title {
      align-self: start;
      font-size: var(--fs-heading-l);
      line-height: var(--lh-heading-l);
    }
  }
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 768px) {
      .cat {
        grid-row: span 3;
        grid-template-rows: subgrid;
        row-gap: var(--space-sm);
        min-height: 0;
      }
      .cat :global(.cat__icon) {
        margin-bottom: var(--space-sm);
      }
    }
  }
  .cat:hover,
  .cat:focus-visible,
  .cat.is-active {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--on-primary);
    --ctx-focus: var(--primary);
  }
  .cat:hover :global(.cat__icon),
  .cat:focus-visible :global(.cat__icon),
  .cat.is-active :global(.cat__icon),
  .cat:hover .cat__text,
  .cat:focus-visible .cat__text,
  .cat.is-active .cat__text {
    color: var(--on-primary);
  }
  /* M6: icon bounces once on hover/focus */
  @media (prefers-reduced-motion: no-preference) {
    .cat:hover :global(.cat__icon),
    .cat:focus-visible :global(.cat__icon) {
      animation: ct-bounce 600ms var(--ease-emphasized) 1;
    }
  }
</style>
