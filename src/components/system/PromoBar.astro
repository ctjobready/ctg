---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { linkAttrs } from '../../lib/url';

interface Props {
  /** Bold lead-in ("Impact Report 2026:"). */
  lead?: string;
  /** Message text; the default slot may be used instead. */
  message?: string;
  /** A shorter message for a phone (up to 575 px); the full message is not rendered there (display: none, so a screen reader reads only what is shown). */
  shortMessage?: string;
  actionLabel?: string;
  href?: string;
  /** Text links after the message (secondary actions: never a button). */
  links?: { label: string; href: string }[];
  dismissible?: boolean;
  /** Storage key: change it to show a new announcement to people who dismissed the old one. */
  storageKey?: string;
  /** Register fact the message states (data-fact, for the status gate). */
  factId?: string;
  /** Accessible name of the region; only a page that shows a second bar needs another one. */
  label?: string;
}
const { lead, message, shortMessage, actionLabel, href, links = [], dismissible = true, storageKey = 'ct-promo-v2', factId, label = 'Announcement' } = Astro.props;
---

<section class="promo-bar" data-promo data-promo-key={storageKey} data-fact={factId} aria-label={label}>
  <div class="promo-bar__inner">
    <p class="promo-bar__text">
      {lead && <strong>{lead}</strong>}{lead && message ? ' ' : ''}{shortMessage ? <><span class="promo-bar__long">{message}</span><span class="promo-bar__short">{shortMessage}</span></> : message}<slot />
      {links.map((l) => <>{' '}<a class="promo-bar__link" href={linkAttrs(l.href).href}>{l.label}<Icon name="arrow-right" size={14} /></a></>)}
    </p>
    {actionLabel && href && <Button variant="promo" href={href}>{actionLabel}</Button>}
  </div>
  {
    dismissible && (
      <button class="promo-bar__close" type="button" data-promo-close aria-label="Dismiss announcement">
        <Icon name="x" size={18} />
      </button>
    )
  }
</section>

<style>
  .promo-bar {
    position: relative;
    background: var(--promo-strip);
    color: var(--on-primary);
    --ctx-focus: var(--surface);
  }
  .promo-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    padding: 6px 52px 6px var(--space-gutter);
    min-height: 44px;
  }
  .promo-bar__text {
    margin: 0;
    font: var(--fw-medium) var(--fs-body-xs) / 1.43 var(--font-sans);
    text-align: center;
  }
  .promo-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: var(--space-sm);
    padding: 2px;
    font: var(--fw-bold) var(--fs-body-xs) / 1.43 var(--font-sans);
    color: var(--on-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .promo-bar__link:hover {
    text-decoration-thickness: 2px;
  }
  /* a real space follows the lead-in (text extraction and screen readers read "2026: among"); this only widens it slightly */
  .promo-bar__text strong {
    margin-right: 0.1em;
  }
  .promo-bar__close {
    position: absolute;
    top: 50%;
    right: 6px;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    color: var(--on-primary);
  }
  .promo-bar__close:hover {
    background: var(--blue-600);
  }
  /* A two-part announcement (WP19): on a wide screen the text stops short of the full width, so its action sits beside it, not on a row of its own. */
  @media (min-width: 900px) {
    .promo-bar__text {
      max-width: 62rem;
    }
  }
  .promo-bar__short {
    display: none;
  }
  @media (max-width: 575px) {
    .promo-bar__long {
      display: none;
    }
    .promo-bar__short {
      display: inline;
    }
    .promo-bar__inner {
      justify-content: flex-start;
      padding-right: 56px;
    }
    .promo-bar__text {
      text-align: left;
    }
  }
</style>

<script>
  import '../../scripts/promo';
</script>
