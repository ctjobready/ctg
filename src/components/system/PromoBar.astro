---
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  /** Bold lead-in ("Impact Report 2026:"). */
  lead?: string;
  /** Message text; the default slot may be used instead. */
  message?: string;
  actionLabel?: string;
  href?: string;
  dismissible?: boolean;
  /** Storage key: change it to show a new announcement to people who dismissed the old one. */
  storageKey?: string;
  /** Register fact the message states (data-fact, for the status gate). */
  factId?: string;
}
const { lead, message, actionLabel, href, dismissible = true, storageKey = 'ct-promo-v2', factId } = Astro.props;
---

<div class="promo-bar" data-promo data-promo-key={storageKey} data-fact={factId} role="region" aria-label="Announcement">
  <div class="promo-bar__inner">
    <p class="promo-bar__text">
      {lead && <strong>{lead}</strong>}
      {message}<slot />
    </p>
    {actionLabel && href && <Button variant="promo" href={href}>{actionLabel}</Button>}
  </div>
  {
    dismissible && (
      <button class="promo-bar__close" type="button" data-promo-close aria-label="Dismiss announcement">
        <Icon name="x" size={18} />
      </button>
    )
  }
</div>

<style>
  .promo-bar {
    position: relative;
    background: var(--promo-strip);
    color: var(--on-primary);
    --ctx-focus: var(--surface);
  }
  .promo-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    padding: 6px 52px 6px var(--space-gutter);
    min-height: 44px;
  }
  .promo-bar__text {
    margin: 0;
    font: var(--fw-medium) var(--fs-body-xs) / 1.43 var(--font-sans);
    text-align: center;
  }
  .promo-bar__text strong {
    margin-right: 0.35em;
  }
  .promo-bar__close {
    position: absolute;
    top: 50%;
    right: 6px;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    color: var(--on-primary);
  }
  .promo-bar__close:hover {
    background: var(--blue-600);
  }
  @media (max-width: 575px) {
    .promo-bar__inner {
      justify-content: flex-start;
      padding-right: 56px;
    }
    .promo-bar__text {
      text-align: left;
    }
  }
</style>

<script>
  import '../../scripts/promo';
</script>
