---
import HeroArt from '../ui/HeroArt.astro';
import Img from '../ui/Img.astro';
import { heroPhoto } from '../../data/photos';
import { mayRender } from '../../lib/permissions';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Fact IDs the lead states (data-fact on the lead paragraph), for a lead that states a registered status or figure. */
  leadFacts?: string[];
  /** home = display-5xl H1; inner = display-4xl H1 */
  variant?: 'home' | 'inner';
  /** Render generated HeroArt when no `media` slot is given. Set false for a text-only hero. */
  art?: boolean;
  artSeed?: string;
  /** Heading element for the title (1 on real pages; 2 in galleries that already have an h1). */
  headingLevel?: 1 | 2;
  /** Frame of the `media` slot: portrait (4:5, the default, for generated art and portraits) or landscape (3:2, for a program photograph). */
  mediaShape?: 'portrait' | 'landscape';
  class?: string;
}
const { eyebrow, title, lead, leadFacts, variant = 'inner', art = true, artSeed, headingLevel = 1, mediaShape = 'portrait', class: className } = Astro.props;
const Title = `h${headingLevel}` as 'h1' | 'h2';
// A real photograph from the page's registry entry (src/data/photos.ts) takes the place of the generated art when the D13 rule lets it render.
const candidate = art && !Astro.slots.has('media') ? heroPhoto(artSeed) : undefined;
const photo = candidate && mayRender(candidate.assetId) ? candidate : undefined;
const hasMedia = Astro.slots.has('media') || art;
const landscape = Astro.slots.has('media') ? mediaShape === 'landscape' : Boolean(photo);
---

<section class:list={['hero', variant === 'home' && 'hero--home', !hasMedia && 'hero--text', landscape && hasMedia && 'hero--landscape', className]}>
  <div class="hero__inner container">
    <div class="hero__copy">
      {eyebrow && <p class="hero__eyebrow" data-hero-in>{eyebrow}</p>}
      <Title class:list={['hero__title', variant === 'home' ? 't-display-5xl' : 't-display-4xl']} data-hero-in>{title}</Title>
      {lead && <p class="hero__lead" data-hero-in data-fact={leadFacts?.join(' ')}>{lead}</p>}
      <slot />
      {Astro.slots.has('actions') && <div class="hero__actions" data-hero-in><slot name="actions" /></div>}
      {Astro.slots.has('stats') && <div class="hero__stats" data-hero-in><slot name="stats" /></div>}
    </div>
    {
      hasMedia && (
        <div class:list={['hero__media', photo && 'hero__media--photo']} data-hero-in>
          {
            Astro.slots.has('media') ? (
              <slot name="media" />
            ) : photo ? (
              <Img src={photo.src} alt={photo.alt} width={1120} widths={[480, 800, 1120]} sizes="(min-width:1024px) 560px, 100vw" loading="eager" fetchpriority="high" assetId={photo.assetId} />
            ) : (
              <HeroArt seed={artSeed ?? title} />
            )
          }
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--hero-gradient-edge);
    padding-block: var(--space-section-mobile);
  }
  /* M11 (WCAG 2.2.2): the gradient lives on a pseudo-element so its one entrance movement animates transform only (no
     repaint of a gradient). It settles once, ends after 3 s and never repeats; reduced motion renders it at rest. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -12%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 85% 120% at 50% 50%, var(--hero-gradient-center), var(--hero-gradient-edge));
  }
  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-section-desktop) calc(var(--space-section-desktop) * 0.8);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero::before {
      animation: ct-hero-settle 3s var(--ease-emphasized) both;
    }
  }
  .hero__inner {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    grid-template-columns: minmax(0, 1fr);
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-gutter);
    min-width: 0;
  }
  .hero__copy > * {
    margin: 0;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 var(--space-md);
    border-radius: var(--radius-pill);
    border: 1px solid var(--primary-fixed);
    background: var(--surface);
    color: var(--secondary);
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-medium);
  }
  .hero__title {
    color: var(--on-surface);
    max-width: 26ch;
  }
  .hero--home .hero__title {
    max-width: 24ch;
  }
  .hero__lead {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface-variant);
    max-width: 34em;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    padding-top: var(--space-sm);
  }
  .hero__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 420px;
    justify-self: center;
    box-shadow: var(--shadow-card);
    background: var(--surface-container-low);
  }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Brand treatment for a real photograph: a soft Klein-blue wash that deepens toward the base, so the photo sits in the system's palette. */
  .hero__media--photo {
    position: relative;
  }
  .hero__media--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, color-mix(in srgb, var(--secondary) 34%, transparent), color-mix(in srgb, var(--secondary) 6%, transparent) 55%, transparent);
  }
  @media (max-width: 767px) {
    .hero__media {
      max-width: 320px;
      justify-self: start;
    }
  }
  @media (min-width: 768px) {
    .hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-lg);
    }
    .hero--text .hero__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__media {
      justify-self: end;
      max-height: 480px;
    }
  }
  /* A program photograph keeps its landscape frame (no portrait crop of a room full of people). */
  .hero--landscape .hero__media {
    aspect-ratio: 3 / 2;
    max-width: 560px;
    max-height: none;
  }
  @media (max-width: 767px) {
    .hero--landscape .hero__media {
      max-width: 100%;
      justify-self: stretch;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero::before {
      animation: none;
    }
  }
</style>
