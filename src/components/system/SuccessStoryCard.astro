---
import Icon from './Icon.astro';
import Img from '../ui/Img.astro';
import { linkAttrs } from '../../lib/url';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** Outcome-led sentence (the quote). */
  outcome: string;
  name: string;
  role?: string;
  href?: string;
  /** Show a play mark (story has a video). */
  video?: boolean;
  /** D13: consent-dependent asset ID (learner name, quote, photo) → data-asset. */
  assetId?: string;
  class?: string;
}
const { image, imageAlt = '', outcome, name, role, href, video = false, assetId, class: className } = Astro.props;
const a = href ? linkAttrs(href) : undefined;
---

<article class:list={['story', className]} data-reveal data-asset={assetId}>
  <div class="story__media">
    {image ? <Img src={image} alt={imageAlt} width={600} height={450} widths={[300, 600]} sizes="(min-width:1024px) 360px, 90vw" /> : !video && <Icon name="user" size={56} strokeWidth={1.25} class="story__ph" />}
    {video && <span class="story__play" aria-hidden="true"><Icon name="play" size={22} /></span>}
  </div>
  <div class="story__body">
    <p class="story__outcome">{outcome}</p>
    <p class="story__name">
      {
        a ? (
          <a class="story__link" href={a.href} rel={a.rel}>
            {name}
            {video && <span class="sr-only"> (video story)</span>}
          </a>
        ) : (
          name
        )
      }
    </p>
    {role && <p class="story__role">{role}</p>}
  </div>
</article>

<style>
  .story {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--dur-base) ease, transform var(--dur-base) var(--ease-standard);
  }
  .story:hover,
  .story:focus-within {
    box-shadow: var(--shadow-card-hover);
  }
  .story__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--surface-variant);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--on-surface-variant);
    overflow: hidden;
  }
  .story__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 300ms ease;
  }
  /* M22: grayscale photo → color */
  .story:hover .story__media :global(img),
  .story:focus-within .story__media :global(img) {
    filter: grayscale(0);
  }
  .story__play {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .story__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-gutter) var(--space-gutter);
    flex: 1;
  }
  .story__body > p {
    margin: 0;
  }
  .story__outcome {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    font-weight: var(--fw-medium);
    color: var(--on-surface);
  }
  .story__name {
    margin-top: auto !important;
    padding-top: var(--space-sm);
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    font-weight: var(--fw-medium);
    color: var(--on-surface);
  }
  .story__link {
    color: inherit;
    text-decoration: none;
  }
  .story__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .story__link:hover {
    color: var(--primary);
  }
  .story__link:focus-visible {
    outline-offset: -2px;
  }
  .story__role {
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
  @media (prefers-reduced-motion: reduce) {
    .story__media :global(img) {
      transition: none;
    }
  }
</style>
