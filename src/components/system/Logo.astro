---
import colorSvg from '../../assets/images/brand/coderstrust-wordmark.svg?raw';
import whiteSvg from '../../assets/images/brand/coderstrust-wordmark-white.svg?raw';
import { url } from '../../lib/url';

/**
 * Vector wordmark, inlined (no request, crisp at any size). Color (#023E8A) on light grounds,
 * white on Klein / Deep Ink / photos. Aspect ratio 2400:286.
 */
interface Props {
  variant?: 'color' | 'white';
  /** Rendered width in CSS px (height follows the aspect ratio). */
  width?: number;
  /** Wrap in a link to Home. */
  link?: boolean;
  class?: string;
  /** Kept for API compatibility with the raster version. */
  loading?: 'eager' | 'lazy';
}
const { variant = 'color', width = 190, link = false, class: className } = Astro.props;
const svg = (variant === 'white' ? whiteSvg : colorSvg).replace('<svg ', '<svg class="logo__svg" aria-hidden="true" focusable="false" ');
const height = Math.round((width * 286) / 2400);
---

{
  link ? (
    <a class:list={['logo', className]} href={url('/')} style={`--logo-w:${width}px`} aria-label="CodersTrust — home">
      <span class="logo__img" role="img" aria-label="CodersTrust" style={`aspect-ratio:2400/286;`} data-h={height} set:html={svg} />
    </a>
  ) : (
    <span class:list={['logo', className]} style={`--logo-w:${width}px`}>
      <span class="logo__img" role="img" aria-label="CodersTrust" style={`aspect-ratio:2400/286;`} data-h={height} set:html={svg} />
    </span>
  )
}

<style is:global>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .logo__img {
    display: block;
    width: var(--logo-w, 190px);
    max-width: 100%;
  }
  .logo__svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
