---
import { fact } from '../../data/facts';
import { footnotesFor, needsFootnote } from '../../lib/footnotes';

/** Superscript marker linking to the page's Sources list. Registers the fact in render order. */
interface Props {
  id: string;
  /** auto (default): only when the fact carries a caveat/base/note. true: always. false: never. */
  footnote?: boolean | 'auto';
}
const { id, footnote = 'auto' } = Astro.props;
const f = fact(id);
const show = footnote === 'auto' ? needsFootnote(f) : footnote;
const reg = show ? footnotesFor(Astro).register(id) : null;
---

{
  reg && (
    <sup class="fn" data-fact={id}>
      <a href={`#fn-${reg.n}`} id={`fn-ref-${reg.n}-${reg.k}`} aria-label={`Note ${reg.n}`}>
        {reg.n}
      </a>
    </sup>
  )
}

<style is:global>
  .fn {
    font-size: 0.7em;
    line-height: 0;
    margin-left: 1px;
    font-weight: var(--fw-bold);
  }
  /* The <sup> has line-height 0, which would give the link a 0px-tall box and collapse its 2px focus ring into a thin strip.
     The link gets a real box (line-height 1 plus vertical padding) and equal negative vertical margins, so its margin box is
     still zero tall: the text keeps its baseline and the line height does not grow. */
  .fn a {
    display: inline-block;
    min-width: 1.4em;
    line-height: 1;
    text-align: center;
    color: var(--ctx-link);
    text-decoration: none;
    border-radius: var(--radius-sm);
    padding: 0.1em 2px;
    margin-block: -0.6em;
  }
  .fn a:hover {
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
  }
  [id^='fn-ref-']:target {
    outline: 2px solid var(--tertiary);
  }
</style>
