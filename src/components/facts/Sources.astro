---
import { footnotesFor } from '../../lib/footnotes';
import Icon from '../system/Icon.astro';
import { linkAttrs } from '../../lib/url';

/**
 * Numbered notes for every footnote marker rendered earlier on the page (deduplicated). Place once, after the last
 * <Fact>/<FactStat>. M21: target note flashes on jump. Renders nothing when the page registered no notes.
 *
 * Numbers and order: this component lists the notes in the order the page registered them. The reading order (markers and notes
 * numbered by first appearance in the page body) is applied to the finished page by orderFootnotes() in src/lib/postprocess.ts,
 * which src/middleware.ts runs for every page. The same pass keeps the first note that carries a caveat as the only one that prints
 * it and turns the later ones into "Same caveat as note N." (linked), so every caveat paragraph is rendered in full here and tagged
 * with data-caveat (the caveat's identity) for that pass.
 *
 * An empty band: pages wrap this component in a labelled <Section aria-label="Notes and sources">. When there are no notes the
 * same pass removes the empty band, so no empty landmark reaches the page.
 *
 * Landmarks: most pages wrap this block in `<Section aria-label="Notes and sources">`, which is the page's one
 * landmark for it, so the <section> here is not exposed as a second (nested, same-named) region. Pass `landmark`
 * when the block is NOT inside a labelled wrapper and should be the region itself.
 */
interface Props {
  title?: string;
  id?: string;
  class?: string;
  landmark?: boolean;
}
const { title = 'Notes and sources', id = 'sources', class: className, landmark = false } = Astro.props;
const notes = footnotesFor(Astro).notes();
// A named <section> is a "region" landmark; role="none" (with no aria-labelledby, which would override it) keeps the
// element and its structure for scripts and the facts gate without adding a nested landmark.
const landmarkAttrs = landmark ? { 'aria-labelledby': `${id}-h` } : { role: 'none' as const };
---

{
  notes.length > 0 && (
    <section class:list={['sources', className]} id={id} {...landmarkAttrs}>
      <h2 class="sources__title t-heading-m" id={`${id}-h`}>{title}</h2>
      <ol class="sources__list">
        {notes.map((n) => (
          <li class="sources__note" id={`fn-${n.n}`} tabindex="-1" data-fact={n.id}>
            <p class="sources__claim">{n.claim}</p>
            {n.caveat && <p class="sources__caveat" data-caveat={n.caveatKey}>{n.caveat}</p>}
            {n.footnote && <p>{n.footnote}</p>}
            {n.base && <p>Base: {n.base}.</p>}
            {n.sources.length > 0 && (
              <p class="sources__cite">
                <span>Source{n.sources.length > 1 ? 's' : ''}: </span>
                {n.sources.map((s, i) => (
                  <>
                    {s.url ? <a href={s.url} rel={linkAttrs(s.url).rel}>{s.citation}</a> : s.citation}
                    {i < n.sources.length - 1 ? ' · ' : ''}
                  </>
                ))}
              </p>
            )}
            <p class="sources__back">
              {Array.from({ length: n.refs }, (_, k) => (
                <a href={`#fn-ref-${n.n}-${k + 1}`} aria-label={`Back to reference ${n.n}${n.refs > 1 ? `.${k + 1}` : ''}`}>
                  <Icon name="corner-up-left" size={14} />
                  <span>Back{n.refs > 1 ? ` ${k + 1}` : ''}</span>
                </a>
              ))}
            </p>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .sources {
    font-size: var(--fs-body-xs);
    line-height: 1.5;
    color: var(--ctx-text);
    max-width: var(--measure);
  }
  .sources__title {
    color: var(--ctx-heading);
    margin-bottom: var(--space-md);
  }
  .sources__list {
    margin: 0;
    padding-left: 1.6em;
    display: grid;
    gap: var(--space-md);
  }
  .sources__note {
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .sources__note::marker {
    font-weight: var(--fw-bold);
    color: var(--ctx-link);
  }
  .sources__note > p {
    margin: 0 0 4px;
  }
  .sources__claim {
    font-weight: var(--fw-medium);
    color: var(--ctx-heading);
  }
  .sources__back a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-right: var(--space-md);
    min-height: 24px;
    color: var(--ctx-link);
  }
  .sources :global(a) {
    color: var(--ctx-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* M21: highlight flash when a marker jumps here (static highlight under reduced motion) */
  .sources__note:target {
    background: var(--tertiary-container);
    color: var(--on-tertiary-container);
  }
  .sources__note:target .sources__claim,
  .sources__note:target :global(a) {
    color: var(--on-tertiary-container);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sources__note:target {
      animation: ct-flash 1800ms ease-out 1;
    }
  }
  @keyframes ct-flash {
    0% {
      background: var(--tertiary-fixed-dim);
    }
    100% {
      background: var(--tertiary-container);
    }
  }
</style>
