---
import { CERT_FACT_IDS, fact } from '../../data/facts';
import { dropTitleEcho, terminalStop } from '../../lib/format';
import CertNote from '../ui/CertNote.astro';

/**
 * Renders a Facts Register entry. Numbers are never typed into pages: use <Fact id="OC-01" />.
 * field: text (canonical sentence, default) | headline | value | from | label | prefix/suffix not needed (value includes them)
 *
 * A sentence (field text or headline) always ends with its period: register wording is often a caption without one, and the
 * reader should not meet "…during the course This is a timing measure only." The period is added and never doubled when the text already ends with punctuation. It is written as <span class="fact__stop">; when a page types its
 * own punctuation straight after the fact (`<Fact id="X" />.`, `<Fact id="X" />, which…`), the finished-page pass
 * (dropDoubledStops in src/lib/postprocess.ts) removes the added one, so a page that already punctuated its own sentence keeps
 * exactly one mark.
 * WP128: `drop` removes a phrase from a sentence that the band around it already says (a lead that carries the same disclaimer); it throws when the register no longer holds the phrase, so a change to the register cannot leave a stale
 * edit behind. The fact id stays on the element.
 * WP136: `swap` ([from, to]) puts a phrase of the sentence in other words (Outcomes 2026 says "surveyed new earners" where the register's text spells the term out); it throws, like `drop`, when the register no longer holds the phrase.
 */
interface Props {
  id: string;
  field?: 'text' | 'headline' | 'value' | 'from' | 'label';
  /** Wrapper element (default span). */
  as?: 'span' | 'p' | 'strong' | 'b' | 'div';
  /** The heading printed above this sentence in a card: the sentence's own "Heading: …" lead-in is not printed again (dropTitleEcho). */
  under?: string;
  /** A phrase left out of the printed sentence (WP128); it must be in the register text. */
  drop?: string;
  /** A phrase of the printed sentence said in other words (WP136); `from` must be in the register text. */
  swap?: [from: string, to: string];
  class?: string;
}
const { id, field = 'text', as: Tag = 'span', under, drop, swap, class: className } = Astro.props;
const f = fact(id);
let out: string;
if (drop !== undefined && !f.text.includes(drop)) throw new Error(`<Fact id="${id}" drop="${drop}">: the register text no longer holds that phrase`);
if (swap !== undefined && !f.text.includes(swap[0])) throw new Error(`<Fact id="${id}" swap="${swap[0]}">: the register text no longer holds that phrase`);
const dropped = drop !== undefined ? f.text.replace(drop, '') : f.text;
const base = swap !== undefined ? dropped.replace(swap[0], swap[1]) : dropped;
if (field === 'text') out = under ? dropTitleEcho(under, base) : base;
else if (field === 'headline') out = f.headline ?? f.text;
else {
  const v = f.stat?.[field];
  if (v === undefined) throw new Error(`<Fact id="${id}" field="${field}">: fact has no stat.${field}`);
  // A value in "pp" ("+10.3 pp") is spelled out where it runs inline (WP45, cycle-21 review: no bare "pp").
  out = field === 'value' ? v.replace(/ pp$/, ' percentage points') : v;
}
// Facts that name vendor certifications (PD-03, IN-08) carry the non-affiliation note, once per page (rule 13).
const namesVendors = CERT_FACT_IDS.includes(id) && (field === 'text' || field === 'headline');
// Sentences get a terminal period; figures and labels (value, from, label) never do.
const stop = field === 'text' || field === 'headline' ? terminalStop(out) : null;
---

<Tag class:list={['fact', className]} data-fact={id}>{stop ? stop.body : out}{stop && <span class="fact__stop">.</span>}{stop?.close}</Tag>{namesVendors && <CertNote as="span" />}
