---
import Stat from '../system/Stat.astro';
import { fact } from '../../data/facts';
import { withSourceNote } from '../../data/copy';

/**
 * Stat bound to a fact: value, label, count-up (when numeric). A program-results label (PR-01, PR-02,
 * PR-05) ends with the register's program-data label; it is set on its own ruled line under the label, once.
 * <FactStat> has no label element of its own: the label and the evidence line are Stat's .stat__label and .stat__evidence, which set
 * `text-wrap: balance` (src/components/system/Stat.astro), so every fact tile wraps its label in even lines.
 * The register's detail line (stat.detail) is the tile's note; `detail={false}` leaves it off a tile whose page states it in context elsewhere (WP33: Outcomes 2026, "Results in Brief").
 * WP57b (owner decision 2026-10-19): the four external statistics (PX-01, PX-02, PX-05, PX-08) carry "(Publisher, Year)" at the end of the label (withSourceNote, src/data/copy.ts).
 * WP60 (cycle-32 review, Grok R4): `label` replaces the register's label on one page, as the At a Glance tiles' `label` does, where that page needs to say more than the register's label (the JobReady Platform page's "In the Pipeline" tile adds that the 1.5M+ are not learners trained by CodersTrust).
 * The page builds it from the register's own label, so no figure is typed and the label keeps its source.
 */
interface Props {
  id: string;
  tone?: 'default' | 'dark' | 'accent';
  size?: 'md' | 'lg';
  align?: 'start' | 'center';
  count?: boolean;
  detail?: boolean;
  label?: string;
  class?: string;
}
const { id, tone = 'default', size = 'md', align = 'start', count, detail = true, label, class: className } = Astro.props;
const f = fact(id);
if (!f.stat) throw new Error(`<FactStat id="${id}">: fact has no stat`);
// Only count up values with a clean numeric target (not "6–8 weeks").
const doCount = count ?? f.stat.numeric !== undefined;
---

<!-- display:contents keeps the wrapper out of the parent's flex/grid layout while carrying data-fact for the status gate. -->
<div class="factstat" data-fact={id}>
  <Stat value={f.stat.value} label={withSourceNote(id, label ?? f.stat.label)} note={detail ? f.stat.detail : undefined} tone={tone} size={size} align={align} count={doCount} class={className}>
  </Stat>
</div>

<style>
  .factstat {
    display: contents;
  }
  /* the detail line (stat.detail) is read under the label, so it wraps at the same measure */
  .factstat :global(.stat__note) {
    max-width: 28ch;
    text-wrap: balance;
    margin-top: var(--space-xs);
  }
</style>
