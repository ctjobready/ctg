---
import { CERT_FACT_IDS, fact } from '../../data/facts';
import { withSourceNote } from '../../data/copy';
import CertNote from '../ui/CertNote.astro';

/**
 * Stat + label + source line (problem/context facts). The number comes from the register.
 * WP57b (owner decision 2026-10-19): the four external statistics (PX-01, PX-02, PX-05, PX-08) carry "(Publisher, Year)" at the end of the label (withSourceNote, src/data/copy.ts).
 */
interface Props {
  id: string;
  /** Show the full canonical sentence under the figure (for facts without a stat). */
  showText?: boolean;
  class?: string;
}
const { id, showText, class: className } = Astro.props;
const f = fact(id);
const useText = showText ?? !f.stat;
---

<article class:list={['card factcard', className]} data-reveal data-fact={id}>
  <div class="card__body">
    {f.stat && <p class="factcard__value">{f.stat.value}</p>}
    <p class:list={['factcard__label', useText && 'factcard__label--text']}>
      {withSourceNote(id, (useText ? f.text : f.stat?.label) ?? '')}    </p>
    {useText && CERT_FACT_IDS.includes(id) && <CertNote />}
  </div>
</article>

<style>
  .factcard__value {
    font-size: var(--fs-display-4xl);
    line-height: 1.1;
    font-weight: var(--fw-bold);
    letter-spacing: -1px;
    color: var(--primary);
  }
  .factcard__label {
    color: var(--on-surface);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
  }
  .factcard__label--text {
    font-size: var(--fs-body-base);
  }
  /* The stat label (not the full-sentence variant) wraps in even lines. */
  .factcard__label:not(.factcard__label--text) {
    text-wrap: balance;
  }
</style>
