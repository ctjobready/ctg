---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Img from '../ui/Img.astro';
import HeroArt from '../ui/HeroArt.astro';
import { mayRender } from '../../lib/permissions';
import type { Photo } from '../../data/photos';
import type { ImageMetadata } from 'astro';

/** C4 Future state: three vignettes (functional / emotional / social) with images. */
interface Vignette {
  kind: 'Functional' | 'Emotional' | 'Social' | string;
  title: string;
  text: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
}
interface Props {
  title: string;
  lead?: string;
  vignettes: Vignette[];
  id?: string;
  /** One real photograph per vignette, in order (src/data/photos.ts). A vignette's own `image` wins; without either, the generated art stands in. */
  photos?: Photo[];
}
const { title, lead, vignettes, id = 'future', photos = [] } = Astro.props;
const media = vignettes.map((v, i) => {
  const p = photos[i];
  if (v.image) return { src: v.image, alt: v.imageAlt ?? '', assetId: undefined as string | undefined };
  return p && mayRender(p.assetId) ? p : undefined;
});
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="What success looks like" title={title} lead={lead} />
  <div class="grid-cards">
    {
      vignettes.map((v, i) => (
        <article class="card" data-reveal>
          <div class="card__media">
            {media[i] ? <Img src={media[i]!.src} alt={media[i]!.alt} width={720} height={480} widths={[360, 720]} sizes="(min-width:1024px) 380px, 90vw" assetId={media[i]!.assetId} /> : <HeroArt seed={v.title} shape="card" />}
          </div>
          <div class="card__body">
            <p class="eyebrow">{v.kind}</p>
            <h3 class="card__title">{v.title}</h3>
            <p class="card__text">{v.text}</p>
          </div>
        </article>
      ))
    }
  </div>
  {media.some((m) => m && m.assetId) && <p class="fb__note">Photographs are from past CodersTrust programs, shown for context.</p>}
</Section>

<style>
  .fb__note {
    margin: var(--space-md) 0 0;
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
