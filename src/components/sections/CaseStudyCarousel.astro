---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Carousel from '../system/Carousel.astro';
import CaseStudyCard from '../ui/CaseStudyCard.astro';
import { fact } from '../../data/facts';
import { casePhoto } from '../pages/home/caseStudies';
import type { ImageMetadata } from 'astro';

/** C7 Proof in practice: scroll-snap carousel of case-study cards, each with an outcome stat from the register. */
interface Item {
  title: string;
  program?: string;
  partner?: string;
  /** Fact ID whose stat is the outcome (PR-01 … PR-05). */
  factId: string;
  /** The stat's caption when the register's own label should be restated for the card (the same figures, in a simpler order). */
  statLabel?: string;
  href: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** D13 asset id of the photo. */
  assetId?: string;
}
interface Props {
  title: string;
  lead?: string;
  items: Item[];
  /** The small label over the heading (default "Program Results", so it never repeats a heading titled "Proof in Practice"). */
  eyebrow?: string;
  id?: string;
}
const { title, lead, items, eyebrow = 'Program Results', id = 'cases' } = Astro.props;
const cards = items.map((it) => {
  const s = fact(it.factId).stat;
  if (!s) throw new Error(`CaseStudyCarousel: fact ${it.factId} has no stat`);
  // No picture given: the card takes the case study's own photograph (matched on the slug in its link).
  const own = it.image ? undefined : casePhoto(/case-studies\/([^/]+)/.exec(it.href)?.[1] ?? '');
  return { ...it, ...(own && { image: own.src, imageAlt: own.alt, assetId: own.assetId }), stat: { value: s.value, label: it.statLabel ?? s.label } };
});
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow={eyebrow} title={title} lead={lead} />
  <div data-fact={items.map((i) => i.factId).join(' ')}>
    <Carousel label="Case Studies" perView={3} count={cards.length}>
      {cards.map((c) => <CaseStudyCard title={c.title} program={c.program} partner={c.partner} image={c.image} imageAlt={c.imageAlt} assetId={c.assetId} stat={c.stat} href={c.href} />)}
    </Carousel>
  </div>
  {Astro.slots.has('more') && <p class="csc__more"><slot name="more" /></p>}
</Section>

<style>
  /* the band's own "see all" link sits inside the band, like Learner Journeys' (WP30 merge review) */
  .csc__more {
    margin: var(--space-md) 0 0;
  }
</style>
