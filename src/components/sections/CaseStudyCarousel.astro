---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Carousel from '../system/Carousel.astro';
import CaseStudyCard from '../ui/CaseStudyCard.astro';
import { fact } from '../../data/facts';
import { CASE_CARD_LABELS, casePhoto } from '../pages/home/caseStudies';
import type { ImageMetadata } from 'astro';

/** C7 Proof in practice: scroll-snap carousel of case-study cards, each with an outcome stat from the register (or, per card, a line of delivery context in its place: Home). */
interface Item {
  title: string;
  program?: string;
  partner?: string;
  /** Fact ID whose stat is the outcome (PR-01 … PR-05). On a card with `context` it only names the program's fact; its stat is not read. */
  factId: string;
  /** The stat's caption when the register's own label should be restated for the card (the same figures, in a simpler order). Without one, the shared caption for the fact (CASE_CARD_LABELS) or the register's label. */
  statLabel?: string;
  /**
   * WP37 (cycle-14 review): one line of delivery context shown in place of the stat, for a card whose figure the page already states elsewhere (Home). The card then shows no figure, and
   * its fact is not named in the band's data-fact (the card states none of it).
   */
  context?: string;
  /** WP55: a second source's line for the same program, shown under the figure or the context (the Kosovo card's World Bank figure, WB_KOSOVO); its facts are named in the band's data-fact. */
  note?: { text: string; facts: string[] };
  href: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** D13 asset id of the photo. */
  assetId?: string;
}
interface Props {
  title: string;
  lead?: string;
  items: Item[];
  /** The small label over the heading (default "Program Results", so it never repeats a heading titled "Proof in Practice"). */
  eyebrow?: string;
  id?: string;
}
const { title, lead, items, eyebrow = 'Program Results', id = 'cases' } = Astro.props;
const cards = items.map((it) => {
  // A card with a context line shows no figure; any other card needs its fact's stat.
  const s = it.context ? undefined : fact(it.factId).stat;
  if (!it.context && !s) throw new Error(`CaseStudyCarousel: fact ${it.factId} has no stat`);
  // No picture given: the card takes the case study's own photograph (matched on the slug in its link).
  const own = it.image ? undefined : casePhoto(/case-studies\/([^/]+)/.exec(it.href)?.[1] ?? '');
  return { ...it, ...(own && { image: own.src, imageAlt: own.alt, assetId: own.assetId }), stat: s && { value: s.value, label: it.statLabel ?? CASE_CARD_LABELS[it.factId] ?? s.label } };
});
// The facts the band states: those of the cards that show a figure, and those a card's note states (WP55).
const stated = [...items.filter((i) => !i.context).map((i) => i.factId), ...items.flatMap((i) => i.note?.facts ?? [])].join(' ') || undefined;
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow={eyebrow} title={title} lead={lead} />
  <div data-fact={stated}>
    <Carousel label="Case Studies" perView={3} count={cards.length}>
      {cards.map((c) => <CaseStudyCard title={c.title} program={c.program} partner={c.partner} image={c.image} imageAlt={c.imageAlt} assetId={c.assetId} stat={c.stat} context={c.context} note={c.note} href={c.href} />)}
    </Carousel>
  </div>
  {Astro.slots.has('more') && <p class="csc__more"><slot name="more" /></p>}
</Section>

<style>
  /* the band's own "see all" link sits inside the band, like Learner Journeys' (WP30 merge review); WP48 (cycle-23 review): Home's row holds three links (the case studies and the two evidence pages), so it wraps as a row */
  .csc__more {
    margin: var(--space-md) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }
</style>
