---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../system/Icon.astro';

/**
 * C8 "What You Get": three short cards, each a heading and one or two sentences (WP38, cycle-15 review: Home; WP39, cycle-16 review: every audience and program page).
 * The shared FeaturesTable lays a concern, an inclusion and a benefit out in labelled parts ("Funder Concern Addressed", "What Is Included", "Practical Benefit"), which reads as a matrix; it stays on Investors only,
 * where its rows are a status table (live, pre-launch, roadmap). Everywhere else the band states what the partnership includes, once, in this component.
 * The cards answer the page's three ranked pains (the C2 band) in that order. On Home, YouthWIDE and the local-partners page a card carries `data-relieves` ("P1" to "P3"), so scripts/check-facts.mjs keeps its
 * one-to-one map; `data-fact` ties a card to the register facts its sentences rest on (the status gate and the production holds read it). The band keeps its id (#features) and its place.
 */
interface Card {
  icon: string;
  title: string;
  text: string;
  /** The ranked pain (C2 band) this card answers: "P1" to "P3". Only the three pages in scripts/check-facts.mjs' pain map need it. */
  painId?: string;
  /** Register fact ids the card rests on. */
  facts?: string[];
}
interface Props {
  title: string;
  cards: Card[];
  id?: string;
  /** The band's ground: white (the table's own) on the audience pages, airy on Home. */
  tone?: 'white' | 'airy' | 'ice';
}
const { title, cards, id = 'features', tone = 'white' } = Astro.props;
---

<Section id={id} tone={tone} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="What You Get" title={title} />
  <ul class="grid-cards inc" role="list">
    {
      cards.map((c) => (
        <li class="card inc__card" data-relieves={c.painId} data-fact={c.facts?.length ? c.facts.join(' ') : undefined} data-reveal>
          <div class="card__body">
            <Icon name={c.icon} size={36} strokeWidth={1.5} class="inc__icon" />
            <h3 class="card__title">{c.title}</h3>
            <p class="card__text">{c.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .inc {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .inc__card :global(.inc__icon) {
    color: var(--primary);
  }
</style>
