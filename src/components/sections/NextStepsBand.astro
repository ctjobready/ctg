---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import StepFlow from '../ui/StepFlow.astro';
import { fact } from '../../data/facts';
import FootnoteMarker from '../facts/FootnoteMarker.astro';

/** C14 Next steps: Discovery → Co-design → Agreement → First cohort; timing comes from PD-04. */
interface Props {
  title?: string;
  lead?: string;
  id?: string;
}
const { title = 'What happens next', lead = 'For grant-funded pilots. Public procurement follows the agency’s own timeline.', id = 'next-steps' } = Astro.props;
const pd04 = fact('PD-04');
// Week labels are parsed from PD-04 ("Discovery wk 1 → Co-design wk 2 → Agreement wk 3") so timings are never retyped.
const wk = [...pd04.text.matchAll(/(Discovery|Co-design|Agreement) wk (\d)/g)].map((m) => ({ name: m[1], wk: m[2] }));
const cohort = pd04.stat?.value ?? '';
const steps = [
  { title: `Discovery · week ${wk[0]?.wk}`, text: 'A conversation about your goals, priority groups and timeline.' },
  { title: `Co-design · week ${wk[1]?.wk}`, text: 'We shape tracks, cohorts, safeguarding and reporting with you.' },
  { title: `Agreement · week ${wk[2]?.wk}`, text: 'Scope, schedule and success measures are agreed.' },
  { title: `First cohort · ${cohort}`, text: 'Training starts within this window after signing (grant-funded pilots).' },
];
---

<Section id={id} tone="airy" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Next steps" title={title} lead={lead} />
  <StepFlow steps={steps} />
  <p class="next__fn text-muted t-body-xs">Timing<FootnoteMarker id="PD-04" footnote={false} />: {pd04.text}</p>
</Section>
