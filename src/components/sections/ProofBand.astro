---
import Section from '../ui/Section.astro';
import FactStat from '../facts/FactStat.astro';
import PlainLine from '../facts/PlainLine.astro';
import BeforeAfter from '../ui/BeforeAfter.astro';
import Icon from '../system/Icon.astro';
import { fact } from '../../data/facts';
import { linkAttrs } from '../../lib/url';
import { titleCase } from '../../lib/titleCase.mjs';
import { TRIAL_BAND_HEADING } from '../../data/copy';

/** C7 Proof (Klein band): FactStats + before→after chart derived from a fact + evidence links. */
interface Props {
  title: string;
  lead?: string;
  /** Up to 4 stat facts. */
  statIds: string[];
  /** Fact with stat.from + stat.numeric (e.g. OC-01) for the before→after chart. */
  chartId?: string;
  chartTitle?: string;
  /** Fact whose authoritative `headline` replaces `title` (e.g. RC-01, the randomized-trial headline). */
  headlineFact?: string;
  /** Show the [PLAIN-LINE] (RC-02 in plain language) directly after the randomized-trial headline. */
  plainLine?: boolean;
  /** Relevance line set directly under the randomized-trial headline: which program the trial evaluated, and which it did not (TRIAL_SCOPE in src/data/copy.ts). */
  trialScope?: string;
  links?: { label: string; href: string }[];
  id?: string;
  /** Small label above the heading; defaults to "The Evidence". */
  eyebrow?: string;
}
const { title, lead, statIds, chartId = 'OC-01', chartTitle = 'Employment Among Surveyed Completers', headlineFact, plainLine = false, trialScope, links = [], id = 'proof-band', eyebrow = 'The Evidence' } = Astro.props;
// A band headed by the randomized trial carries a short H2; the fact's own headline is body text below it. RC-01's headline leads with the
// +10.3 pp employment result (WP7), so no separate RC-02 sentence is printed before it; the [PLAIN-LINE] still follows where a page asks for it.
const heading = headlineFact ? TRIAL_BAND_HEADING : titleCase(title);
const headlineText = headlineFact ? (fact(headlineFact).headline ?? fact(headlineFact).text) : undefined;
const employmentLine: string | undefined = undefined;
const cf = fact(chartId);
const after = cf.stat?.numeric;
const before = cf.stat?.from ? parseFloat(cf.stat.from.replace(/[^0-9.]/g, '')) : undefined;
if (after === undefined || before === undefined) throw new Error(`ProofBand: fact ${chartId} needs stat.numeric and stat.from`);
const unit = cf.stat?.suffix ?? '%';
const delta = `+${(after - before).toFixed(cf.stat?.decimals ?? 1)} pp`;

// Order (review round 3): the randomized-trial results come first, with the percentage-point result (RC-02) ahead of the income result (RC-01);
// the alumni-survey results (OC-*) sit below them, beside the survey chart, so the survey never reads as the headline evidence.
const rank = (id: string) => (id === 'RC-02' ? 0 : id.startsWith('RC-') ? 1 : 2);
const leading = statIds.filter((s) => !s.startsWith('OC-')).sort((a, b) => rank(a) - rank(b));
const survey = statIds.filter((s) => s.startsWith('OC-'));
// One-line lead-in for the survey chart, built from the chart fact (figures are not typed here).
const chartLead = `Among surveyed completers, employment was ${cf.stat?.value} at the October 2026 survey, against ${cf.stat?.from} before training.`;
---

<Section id={id} tone="klein" aria-labelledby={`${id}-h`}>
  <!-- Own header (not SectionHeader) so the RCT headline keeps its own markup (RC-01). -->
  <header class="proofband__head" data-reveal data-fact={headlineFact}>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="proofband__title" id={`${id}-h`}>{heading}</h2>
    {plainLine && <PlainLine />}
    {employmentLine && <p class="lead proofband__employment" data-fact="RC-02">{employmentLine}</p>}
    {headlineFact && headlineText && <p class="lead proofband__headline" data-fact={headlineFact}>{headlineText}</p>}
    {trialScope && <p class="proofband__scope" data-trial-scope>{trialScope}</p>}
    {lead && <p class="lead">{lead}</p>}
  </header>
  {
    leading.length > 0 && (
      <div class="proofband__lead-stats">
        {leading.map((s, i) => <FactStat id={s} tone={i % 2 === 0 ? 'dark' : 'accent'} size="lg" />)}
      </div>
    )
  }
  <p class="proofband__sub eyebrow">Alumni Survey Results</p>
  <div class:list={['proofband', survey.length === 0 && 'proofband--solo']}>
    {
      survey.length > 0 && (
        <div class="proofband__stats">
          {survey.map((s, i) => <FactStat id={s} tone={(leading.length + i) % 2 === 0 ? 'dark' : 'accent'} size="lg" />)}
        </div>
      )
    }
    <div class="proofband__chart">
      <p class="proofband__chartlead">{chartLead}</p>
      <BeforeAfter
        title={chartTitle}
        before={{ label: 'Before', value: before, caption: 'Before Training' }}
        after={{ label: 'October 2026 Survey', value: after, caption: 'Surveyed Completers' }}
        delta={delta}
        diffLabel="Difference"
        unit={unit}
        tone="dark"
      />
      <p class="proofband__fn">Chart data: {cf.stat?.label}</p>
    </div>
  </div>
  {
    links.length > 0 && (
      <ul class="proofband__links" role="list">
        {links.map((l) => <li><a class="link" href={linkAttrs(l.href).href}>{l.label}<Icon name="arrow-right" size={16} /></a></li>)}
      </ul>
    )
  }
  <slot />
</Section>

<style>
  .proofband__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    max-width: 52rem;
  }
  .proofband__head > * {
    margin: 0;
  }
  .proofband__title {
    color: var(--ctx-section-heading);
  }
  .proofband__scope {
    max-width: var(--measure);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    font-weight: var(--fw-medium);
    color: var(--ctx-text);
  }
  .proofband__lead-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-gutter);
    margin-bottom: var(--space-xl, 56px);
  }
  @media (min-width: 1024px) {
    .proofband__lead-stats {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }
  .proofband__sub {
    margin: 0 0 var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--ctx-border);
  }
  .proofband__chartlead {
    margin: 0 0 var(--space-sm);
    max-width: var(--measure);
    font-size: var(--fs-body-base);
    color: var(--ctx-text);
  }
  .proofband {
    display: grid;
    gap: var(--space-lg);
  }
  .proofband__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-gutter);
    align-content: start;
  }
  .proofband__fn {
    margin: var(--space-xs) 0 0;
    font-size: var(--fs-body-xs);
    color: var(--ctx-muted);
  }
  .proofband__links {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }
  @media (min-width: 1024px) {
    .proofband {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: center;
    }
    .proofband--solo {
      grid-template-columns: minmax(0, 40rem);
    }
  }
</style>
