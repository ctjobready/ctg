---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ComparisonTable from '../ui/ComparisonTable.astro';

/**
 * C10 Comparison = approaches and trade-offs, not verdicts (planning v1.2 §B). Categories, never named
 * competitors (D8). Always includes a "Doing nothing" column. Cells are text; a check icon marks only
 * CodersTrust's own inclusions (`included`), never a verdict on another approach.
 */
type Cell = string | { text: string; included?: boolean; factId?: string };
interface Props {
  title?: string;
  lead?: string;
  columns?: string[];
  rows?: { label: string; cells: Cell[] }[];
  /** Fact IDs the default cells rest on (data-fact for the status gate). */
  facts?: string[];
  id?: string;
}
const {
  title = 'Approaches to getting into digital work, and their trade-offs',
  lead = 'Different routes suit different people. This is what each one typically includes.',
  columns = ['Approach', 'CodersTrust supported cohort', 'Conventional skills programs', 'Self-paced course platforms', 'Freelance marketplaces alone', 'Doing nothing'],
  rows = [
    { label: 'Track choice', cells: [{ text: 'Set from current employer demand; work-entry plan approved before enrollment', included: true }, 'Varies by program design', 'Learner chooses', 'Learner looks for work directly', '—'] },
    { label: 'Certification', cells: [{ text: 'Certification exam preparation (exam terms set per program)', included: true }, 'Varies', 'Often sold separately', 'Varies by platform', '—'] },
    { label: 'Mentoring', cells: [{ text: 'Three months of milestone-based mentoring', included: true }, 'Varies', 'Varies; often self-directed', 'Marketplace matching is the core service; additional support varies.', '—'] },
    { label: 'Work entry', cells: [{ text: 'Placement support into local, remote and global work', included: true }, 'Varies', 'Work-entry support depends on the provider and package.', 'Marketplace matching is the core service; additional support varies.', '—'] },
    { label: 'Outcome tracking', cells: [{ text: 'Tracers at 3, 6 and 12 months; monthly reports', included: true }, 'Varies', 'Reporting emphasis varies; check whether employment outcomes are included.', 'Platform activity', '—'] },
    {
      label: 'Independent evidence',
      cells: [
        { text: 'A randomized trial by BIGD of a CodersTrust program (WSDFM)', included: true, factId: 'RC-01' },
        { text: 'Varies — a review of nine randomized trials of vocational training found only three with significant employment impacts', factId: 'RC-06' },
        'Varies',
        'Varies',
        '—',
      ],
    },
    { label: 'Cost', cells: ['Pricing set per program', 'Varies', 'Content-only access can cost less than a supported cohort; actual prices vary', 'Varies', 'No fee — but forgone earnings'] },
  ],
  facts = ['PD-10', 'PD-19', 'PD-02', 'PD-01', 'PD-15', 'PD-08', 'PD-09', 'RC-01', 'RC-06'],
  id = 'compare',
} = Astro.props;
if (!columns.some((c) => /doing nothing/i.test(c))) throw new Error('ComparisonBand needs a "Doing nothing" column');
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Compare approaches" title={title} lead={lead} />
  <ComparisonTable caption="Approaches to getting into digital work: what each typically includes" columns={columns} rows={rows} highlight={0} facts={facts} />
</Section>
