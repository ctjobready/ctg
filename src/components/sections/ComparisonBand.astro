---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ComparisonTable from '../ui/ComparisonTable.astro';

/**
 * C10 Comparison = approaches and trade-offs, not verdicts (planning v1.2 §B). Categories, never named
 * competitors (D8). Includes a "Doing Nothing" column unless `withoutDoingNothing` is set (Home, WP17). Cells are text; a check icon marks only
 * CodersTrust's own inclusions (`included`), never a verdict on another approach.
 * WP42 (cycle-19 review): every cell is a fragment in one style, in CodersTrust's column and in the comparison columns alike: sentence case (the heading cells are Title Case, the cells are running text) and no trailing period.
 * Home's own "Independent Evidence" cell (a page-specific `ownCells` wording) follows the same rule.
 * WP54 (cycle-28 review, Claude S25): the "Track Choice" cell says the work-entry plan is "agreed before enrollment" (it said "approved"), as every other page words PD-19.
 */
type Cell = string | { text: string; included?: boolean; factId?: string };
interface Props {
  title?: string;
  lead?: string;
  columns?: string[];
  rows?: { label: string; cells: Cell[] }[];
  /** Fact IDs the default cells rest on (data-fact for the status gate). */
  facts?: string[];
  /** Home (WP17): drop the "Doing Nothing" column and add the line that invites the reader to compare their current program. */
  withoutDoingNothing?: boolean;
  /** Show only these rows, in the order given (Investors, WP18b: only the capabilities a platform investor weighs). */
  onlyRows?: string[];
  /** Drop these columns (Home, WP19: a column whose cells are mostly "Varies" says nothing). Matched on the heading. */
  dropColumns?: string[];
  /**
   * Page-specific wording for CodersTrust's own cell in a row, keyed by the row's label (Home shortens "Independent Evidence", WP31). The cell keeps its check mark
   * and its fact marker; every other cell, and every other page, keeps the shared text.
   */
  ownCells?: Record<string, string>;
  /** A line under the table. */
  note?: string;
  id?: string;
}
const {
  title = 'Approaches to Getting into Digital Work, and Their Trade-Offs',
  lead = 'Different routes suit different people. This is what each one typically includes.',
  columns = ['Approach', 'CodersTrust Supported Cohort', 'Conventional Skills Programs', 'Self-Paced Course Platforms', 'Freelance Marketplaces Alone', 'Doing Nothing'],
  rows = [
    { label: 'Track Choice', cells: [{ text: 'Set from current employer demand; work-entry plan agreed before enrollment', included: true }, 'Varies by program design', 'Learner chooses', 'Learner looks for work directly', 'No training'] },
    { label: 'Certification', cells: [{ text: 'Certification exam preparation (exam fee included)', included: true }, 'Varies', 'Often sold separately', 'Varies by platform', 'No credential'] },
    { label: 'Mentoring', cells: [{ text: 'Three months of milestone-based mentoring', included: true }, 'Varies', 'Varies; often self-directed', 'Mentoring is not the core service; support varies by marketplace', 'No mentoring'] },
    { label: 'Work Entry', cells: [{ text: 'Placement support into local, remote and global work', included: true }, 'Varies', 'Work-entry support depends on the provider and package', 'Marketplace matching is the core service; additional support varies', 'No new connections'] },
    // WP51 (cycle-26 review): scoped like every other tracking and reporting statement on the site ("as agreed in the program scope"); the reports come first, as the positioning statement and the cards say them.
    { label: 'Outcome Tracking', cells: [{ text: 'Included for every cohort, as agreed in the program scope: monthly reports and follow-up surveys at 3, 6 and 12 months' }, 'Varies', 'Reporting emphasis varies; check whether employment outcomes are included', 'Platform activity', 'No tracking'] },
    {
      label: 'Independent Evidence',
      cells: [
        { text: 'Available: one randomized trial of a predecessor program (200 hours, women in Dhaka); independent evaluation of your cohort is welcome; where a program needs one, it is budgeted separately from the standard inclusions', factId: 'RC-01' },
        { text: 'Varies — a review of nine randomized trials of vocational training found only three with significant employment impacts', factId: 'RC-06' },
        'Varies',
        'Varies',
        'None',
      ],
    },
    { label: 'Cost', cells: ['Pricing set per program', 'Varies', 'Content-only access can cost less than a supported cohort; actual prices vary', 'Varies', 'No fee — but forgone earnings'] },
  ],
  facts = ['PD-10', 'PD-19', 'PD-02', 'PD-02a', 'PD-01', 'PD-15', 'PD-08', 'PD-09', 'RC-01', 'RC-06'],
  withoutDoingNothing = false,
  onlyRows,
  dropColumns = [],
  ownCells = {},
  note,
  id = 'compare',
} = Astro.props;
if (!withoutDoingNothing && !columns.some((c) => /doing nothing/i.test(c))) throw new Error('ComparisonBand needs a "Doing Nothing" column');
const nothing = columns.findIndex((c) => /doing nothing/i.test(c));
const dropped = new Set<number>(dropColumns.map((c) => columns.indexOf(c)));
if (dropped.has(-1) || dropped.has(0)) throw new Error(`ComparisonBand: dropColumns names an unknown column or the criteria column: ${dropColumns.join(', ')}`);
if (withoutDoingNothing && nothing > 0) dropped.add(nothing);
const shownColumns = columns.filter((_, i) => !dropped.has(i));
for (const label of Object.keys(ownCells)) if (!rows.some((r) => r.label === label)) throw new Error(`ComparisonBand: ownCells names an unknown row: ${label}`);
// CodersTrust's own cell is the first one after the criteria label; a page's wording replaces its text and keeps its check mark and fact marker.
const ownRows = rows.map((r) => {
  const text = ownCells[r.label];
  if (text === undefined) return r;
  const first = r.cells[0];
  return { ...r, cells: [typeof first === 'string' ? { text } : { ...first, text }, ...r.cells.slice(1)] };
});
const droppedNothing = ownRows.map((r) => ({ ...r, cells: r.cells.filter((_, i) => !dropped.has(i + 1)) }));
const shownRows = onlyRows ? onlyRows.map((l) => droppedNothing.find((r) => r.label === l)).filter((r): r is NonNullable<typeof r> => !!r) : droppedNothing;
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Compare Approaches" title={title} lead={lead} />
  <ComparisonTable caption="Approaches to Getting into Digital Work: What Each Typically Includes" columns={shownColumns} rows={shownRows} highlight={0} facts={facts} />
  {note && <p class="cmpb__note">{note}</p>}
</Section>

<style>
  .cmpb__note {
    margin: var(--space-md) 0 0;
    max-width: 52rem;
    font-weight: var(--fw-medium);
    color: var(--on-surface);
  }
</style>
