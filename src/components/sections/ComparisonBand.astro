---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ComparisonTable from '../ui/ComparisonTable.astro';

/**
 * C10 Comparison: categories, never named competitors (Decision D8). Always includes a
 * "Doing nothing" column. Status is shown as icon + visually-hidden text, never colour alone.
 * Default content is the compressed table from planning/04 §6.
 */
interface Props {
  title?: string;
  lead?: string;
  columns?: string[];
  rows?: { label: string; cells: string[] }[];
  id?: string;
}
const {
  title = 'Not another training program.',
  lead,
  columns = ['Criterion', 'CodersTrust model', 'Conventional skills programs', 'Self-paced course platforms', 'Doing nothing'],
  rows = [
    { label: 'Tracks chosen from current employer demand', cells: ['✅', '⚠️ Often supply-led', '⚠️ Learner picks', '❌'] },
    { label: 'Industry certification, exam fee included', cells: ['✅', '⚠️ Varies', '⚠️ Paid separately', '❌'] },
    { label: 'One-to-one mentoring into first income', cells: ['✅', '❌ Rare', '❌', '❌'] },
    { label: 'Placement into local, remote and global work', cells: ['✅', '⚠️ Mostly local', '❌', '❌'] },
    { label: 'Outcomes tracked after the course', cells: ['✅', '⚠️ Often completion only', '❌', '❌'] },
  ],
  id = 'compare',
} = Astro.props;
if (!columns.some((c) => /doing nothing/i.test(c))) throw new Error('ComparisonBand needs a "Doing nothing" column');
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Why CodersTrust" title={title} lead={lead} />
  <ComparisonTable caption="How the CodersTrust model compares with other approaches" columns={columns} rows={rows} highlight={0} />
</Section>
