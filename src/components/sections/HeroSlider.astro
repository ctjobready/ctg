---
/**
 * Home "Results" carousel (WP13; headed "Results and Programs" until WP53, when the programs slide went and the carousel became four slides; layout and photographs reworked in WP13b; WP17: it sits directly below the stable hero, so every
 * slide heading is a level 2, the photographs load lazily and the slide links are text links; the hero owns the page's h1 and the primary button).
 * Each slide has a copy column (eyebrow, heading, lead or register sentence, named results or figures, links) and a visual column (one cleared
 * photograph; the evidence slide adds a Klein-blue proof band: a card over the photograph on the desktop visual column, under it on phones). Every slide is in the markup. Without JavaScript the slides
 * stack, with no controls (print prints them in order). With JavaScript, html.js is set before first paint (BaseLayout), so the carousel
 * layout is in place from the first paint: the slides share one grid cell, the showing one is `.is-active`, and the controls keep their space.
 * The region therefore never changes height when src/scripts/heroSlider.ts runs. The script sets `is-ready` (the controls show), the
 * active slide, the dots, the inert state of the hidden slides and the live region.
 * Pattern: WAI-ARIA Authoring Practices carousel (region, slides with roledescription "slide", a labelled previous and next, a slide picker,
 * a pause control). Figures come from the facts register (src/data/facts.ts) and carry data-fact for the facts gate.
 */
import Icon from '../system/Icon.astro';
import Stat from '../system/Stat.astro';
import Fact from '../facts/Fact.astro';
import HeroArt from '../ui/HeroArt.astro';
import Img from '../ui/Img.astro';
import { fact } from '../../data/facts';
import { photo } from '../../data/photos';
import type { HeroSlide, HeroSlideStat } from '../../data/heroSlides';
import { mayRender } from '../../lib/permissions';
import { linkAttrs } from '../../lib/url';

interface Props {
  /** The region's id; the track and the controls are named after it. */
  id?: string;
  /** Accessible name of the carousel region. */
  label: string;
  slides: HeroSlide[];
  /** Visible section heading (an h2 above the carousel region); the region is named after it. */
  heading?: string;
  /** One framing sentence under the heading (WP23): what the slides are, said once for the whole carousel. */
  intro?: string;
}
const { id = 'hero', label, slides, heading, intro } = Astro.props;
if (slides.length < 2) throw new Error('HeroSlider: needs at least two slides');
const total = slides.length;
const headingId = `${id}-h`;
const trackId = `${id}-slides`;

/** The figure a tile shows, read from the register (throws when the fact has no stat, so a bad id fails the build). */
const figure = (s: HeroSlideStat) => {
  const f = fact(s.factId);
  if (!f.stat) throw new Error(`HeroSlider: fact ${s.factId} has no stat`);
  return { factId: s.factId, value: f.stat.value, label: s.caption ? s.caption(f) : f.stat.label };
};

const views = slides.map((s, i) => {
  const p = photo(s.photo);
  return {
    s,
    i,
    first: i === 0,

    picture: mayRender(p.assetId) ? p : undefined,
    stats: (s.stats ?? []).map(figure),
    proof: s.proof ? figure(s.proof) : undefined,
  };
});
---

<div class="hs-shell">
{
  heading && (
    <div class="hs__head container">
      <h2 class="hs__heading" id={headingId}>{heading}</h2>
      {intro && <p class="hs__intro">{intro}</p>}
    </div>
  )
}
<section class="hs" id={id} aria-roledescription="carousel" aria-label={heading ? undefined : label} aria-labelledby={heading ? headingId : undefined} data-hero-slider>
  <div class="hs__track" id={trackId} data-hs-track aria-live="polite">
    {
      views.map(({ s, i, first, picture, stats, proof }) => (
        <div class:list={['hs__slide', first && 'is-active']} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${total}: ${s.title}`} data-hs-slide>
          <div class="hs__inner container">
            <div class="hs__copy">
              {s.audience && (
                <nav class="hs__audience" aria-label="Choose your audience" data-hero-in={first ? '' : undefined}>
                  <ul>
                    {s.audience.map((a) => (
                      <li>
                        <a class="link" href={linkAttrs(a.href).href}>{a.label}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )}
              {s.eyebrow && <p class="hs__eyebrow" data-hero-in={first ? '' : undefined}>{s.eyebrow}</p>}
              <h2 class="hs__title t-display-4xl" data-fact={s.titleFacts?.join(' ')}>{s.title}</h2>
              {s.fact ? (
                <Fact id={s.fact.id} field={s.fact.field} as="p" class="hs__lead" />
              ) : (
                s.lead && <p class="hs__lead" data-hero-in={first ? '' : undefined} data-fact={s.leadFacts?.join(' ')}>{s.lead}</p>
              )}
              {s.lines && (
                <ul class="hs__lines">
                  {s.lines.map((l) => (
                    <li data-fact={l.factIds.join(' ')}>{l.text}</li>
                  ))}
                </ul>
              )}
              {stats.length > 0 && (
                <div class="hs__stats">
                  {stats.map((v) => (
                    <div class="hs__stat" data-fact={v.factId}>
                      <Stat value={v.value} label={v.label} size="lg" count={false} />
                    </div>
                  ))}
                </div>
              )}
              {s.links && (
                <div class="hs__actions" data-hero-in={first ? '' : undefined}>
                  {s.links.map((l) => (
                    <a class="link hs__link" href={linkAttrs(l.href).href}>
                      {l.label}
                      <Icon name="arrow-right" size={16} />
                    </a>
                  ))}
                </div>
              )}
            </div>
            <div class="hs__visual">
              {picture ? (
                <div class="hs__media" data-hero-in={first ? '' : undefined}>
                  <Img src={picture.src} alt={picture.alt} width={1120} widths={[480, 800, 1120]} sizes="(min-width:1024px) 560px, 100vw" loading="lazy" assetId={picture.assetId} />
                </div>
              ) : (
                <div class="hs__media">
                  <HeroArt seed={s.id} />
                </div>
              )}
              {proof && (
                <div class="hs__proof" data-fact={proof.factId}>
                  <Stat value={proof.value} label={proof.label} size="lg" tone="dark" count={false} />
                </div>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="hs__controls container" data-hs-bar>
    <div class="hs__nav">
      <button type="button" class="hs__arrow" data-hs-prev aria-controls={trackId} aria-label="Previous slide">
        <Icon name="chevron-left" size={20} />
      </button>
      <div class="hs__dots" role="group" aria-label="Choose a slide">
        {
          slides.map((s, i) => (
            <button
              type="button"
              class:list={['hs__dot', i === 0 && 'is-active']}
              data-hs-dot
              aria-controls={trackId}
              aria-label={`Show slide ${i + 1} of ${total}: ${s.title}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))
        }
      </div>
      <button type="button" class="hs__arrow" data-hs-next aria-controls={trackId} aria-label="Next slide">
        <Icon name="chevron-right" size={20} />
      </button>
    </div>
    <button type="button" class="hs__toggle" data-hs-toggle aria-controls={trackId}>
      <span data-hs-icon="pause"><Icon name="pause" size={16} /></span>
      <span data-hs-icon="play" hidden><Icon name="play" size={16} /></span>
      <span data-hs-toggle-label>Pause</span>
    </button>
  </div>
</section>
</div>

<style is:global>
  /* Hidden attributes win over the display rules below (the pause and play glyphs swap through [hidden]). */
  .hs [hidden] {
    display: none !important;
  }

  .hs-shell {
    background: var(--hero-gradient-edge);
  }
  .hs__head {
    padding-block: var(--space-lg) var(--space-md);
  }
  .hs__heading {
    margin: 0;
    color: var(--secondary);
  }
  .hs__intro {
    margin: var(--stack-heading) 0 0;
    max-width: 48rem;
    color: var(--on-surface-variant);
  }
  @media (min-width: 768px) {
    .hs__head {
      padding-block: var(--space-xl) var(--space-md);
    }
  }
  .hs__link {
    font-weight: var(--fw-bold);
  }
  .hs {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block-start: var(--space-md);
    background: var(--hero-gradient-edge);
  }
  /* The hero's settle entrance (Hero.astro): a transform-only gradient that plays once and never repeats. */
  .hs::before {
    content: '';
    position: absolute;
    inset: -12%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 85% 120% at 50% 50%, var(--hero-gradient-center), var(--hero-gradient-edge));
  }
  @media (prefers-reduced-motion: no-preference) {
    .hs::before {
      animation: ct-hero-settle 3s var(--ease-emphasized) both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs::before {
      animation: none;
    }
  }

  /* Slide: the copy column and the visual column. From the desktop breakpoint they sit side by side, centred vertically in the slide.
     Below it the copy stays at the top of the slide (the headings keep their place from slide to slide) and the photograph fills the rest
     of the region, so no slide has an empty band under its content. Without JavaScript the slides stack with room between them. */
  .hs__slide {
    min-width: 0;
    display: flex;
    align-items: stretch;
    padding-block: var(--space-lg);
  }
  .hs__inner {
    width: 100%;
    display: grid;
    gap: var(--space-lg);
    align-items: stretch;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
  }
  @media (min-width: 1024px) {
    .hs__slide {
      align-items: center;
    }
    .hs__inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      grid-template-rows: none;
      align-items: center;
      gap: var(--space-xl);
    }
  }
  .hs__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-gutter);
    min-width: 0;
  }
  .hs__copy > * {
    margin: 0;
  }
  .hs__audience ul {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-md);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-sm);
    row-gap: var(--space-xs);
    min-height: 32px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--primary-fixed);
    background: var(--surface);
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-medium);
  }
  .hs__audience li {
    display: inline-flex;
    align-items: center;
  }
  /* the separator trails each link, so a wrapped line ends with it rather than starting with it */
  .hs__audience li:not(:last-child)::after {
    content: '·';
    margin-left: var(--space-sm);
    color: var(--outline);
  }
  .hs__audience a {
    --ctx-link: var(--secondary);
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-xs);
  }
  .hs__eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 var(--space-md);
    border-radius: var(--radius-pill);
    border: 1px solid var(--primary-fixed);
    background: var(--surface);
    color: var(--secondary);
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-medium);
  }
  .hs__title {
    color: var(--on-surface);
    max-width: 38ch; /* WP23: the survey and reach headlines state a figure and are longer; two lines, not three */
  }
  .hs__lead {
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface-variant);
    max-width: 36em;
  }
  .hs__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  /* Evidence proof: one figure on a Klein-blue band (white numeral, pale label). Below the desktop breakpoint it sits under the photograph;
     on the desktop visual column it is a card over the foot of the photograph. */
  .hs__proof {
    padding: var(--space-md) var(--space-md);
    border-radius: var(--radius-lg);
    background: var(--secondary);
    box-shadow: var(--shadow-card);
  }
  .hs .hs__proof .stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hs .hs__proof .stat__label {
    max-width: none;
  }
  @media (min-width: 1024px) {
    .hs__proof {
      position: absolute;
      left: var(--space-md);
      bottom: var(--space-md);
      width: min(400px, calc(100% - 2 * var(--space-md)));
      padding: var(--space-md) var(--space-lg);
    }
  }
  /* Figure tiles: the numeral in Klein blue, and the label on the full width of the tile (no narrow column). */
  .hs__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    width: 100%;
  }
  .hs__stat {
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .hs .hs__stat .stat {
    --stat-color: var(--secondary);
  }
  .hs .hs__stat .stat__label {
    max-width: none;
  }

  /* Named results, one per line (the placement slide). WP50 (owner design rule 2026-10-16): no left-edge accent bar on the result cards (it was a 4 px secondary border); they keep their radius and shadow. */
  .hs__lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
    width: 100%;
  }
  .hs__lines li {
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--on-surface);
    font-size: var(--fs-body-l);
    font-weight: var(--fw-bold);
  }

  /* The photograph: a 4:3 frame on the desktop visual column; below the desktop breakpoint it fills the space the copy leaves (see the slide rule),
     with the Klein wash of Hero.astro. */
  .hs__visual {
    position: relative;
    min-width: 0;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .hs__media {
    position: relative;
    flex: 1 1 0;
    min-height: 180px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface-container-low);
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 1024px) {
    .hs__visual {
      display: block;
      min-height: 0;
    }
    .hs__media {
      flex: none;
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
  }
  /* The image is taken out of the flow, so its intrinsic height never sets the height of a slide: the frame's own size does. */
  .hs__media img,
  .hs__media svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hs__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, color-mix(in srgb, var(--secondary) 34%, transparent), color-mix(in srgb, var(--secondary) 6%, transparent) 55%, transparent);
  }

  /* Carousel (html.js is set before first paint): the slides share one grid cell from the start, so the region keeps its height
     when the script runs. The controls keep their space from the start and show once the script has run (is-ready). */
  .hs__controls {
    display: none;
  }
  .js .hs__track {
    display: grid;
  }
  .js .hs__slide {
    grid-area: 1 / 1;
    padding-block: 0;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--dur-slow) var(--ease-standard),
      visibility 0s linear var(--dur-slow);
  }
  .js .hs__slide.is-active {
    visibility: visible;
    opacity: 1;
    transition:
      opacity var(--dur-slow) var(--ease-standard),
      visibility 0s;
  }
  .js .hs__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
    margin-block-start: var(--space-md);
    padding-block-end: var(--space-lg);
    visibility: hidden;
  }
  .js .hs.is-ready .hs__controls {
    visibility: visible;
  }
  .hs__nav {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .hs__arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--primary-fixed);
    background: var(--surface);
    color: var(--primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease,
      border-color var(--dur-base) ease;
  }
  .hs__arrow:hover {
    background: var(--primary);
    color: var(--on-primary);
    border-color: var(--primary);
  }
  .hs__dots {
    display: flex;
    align-items: center;
  }
  /* 24 x 24 hit box (WCAG 2.2 target size); the visible dot is the ::before, and the active one (is-active, set by the script) widens. */
  .hs__dot {
    width: 24px;
    height: 24px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
  }
  .hs__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    transition:
      width var(--dur-base) var(--ease-standard),
      background-color var(--dur-base) ease;
  }
  .hs__dot.is-active::before {
    width: 24px;
    background: var(--primary);
  }
  .hs__toggle {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0 var(--space-md);
    border-radius: var(--radius-pill);
    border: 1px solid var(--primary-fixed);
    background: var(--surface);
    color: var(--primary);
    font: inherit;
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-medium);
    cursor: pointer;
  }
  .hs__toggle:hover {
    background: var(--primary);
    color: var(--on-primary);
    border-color: var(--primary);
  }
  /* Phone width: the arrows, the slide picker and the Pause control share one row (the arrows keep a 40 px target). */
  @media (max-width: 480px) {
    .hs__audience ul {
      padding-inline: var(--space-compact);
      column-gap: var(--space-sm);
    }
    .hs__audience li:not(:last-child)::after {
      margin-left: var(--space-sm);
    }
    .hs__stat {
      padding: var(--space-compact);
    }
    .hs__nav {
      gap: var(--space-xs);
    }
    .hs__arrow {
      width: 40px;
      height: 40px;
    }
    .hs__toggle {
      padding: 0 var(--space-compact);
      gap: var(--space-sm);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .hs__slide,
    .js .hs__slide.is-active {
      transition: none;
    }
  }

  /* Print: every slide prints in order (the carousel's stacking and the controls do not); calls to action, photographs and the controls do not. */
  @media print {
    .hs__track,
    .js .hs__track {
      display: block;
    }
    .hs__slide,
    .js .hs__slide,
    .js .hs__slide.is-active {
      grid-area: auto;
      padding-block: var(--space-md);
      visibility: visible;
      opacity: 1;
      transition: none;
      break-inside: avoid;
    }
    .hs__controls,
    .js .hs__controls,
    .js .hs.is-ready .hs__controls,
    .hs__actions,
    .hs__media {
      display: none !important;
    }
    .hs__visual {
      display: block;
      min-height: 0;
    }
    .hs__proof {
      position: static;
      width: auto;
      margin-block-start: var(--space-md);
      border: 1px solid #000;
      background: none;
      box-shadow: none;
    }
    .hs .hs__proof .stat {
      --stat-color: #000;
      --stat-label: #000;
    }
  }
</style>

<script>
  import '../../scripts/heroSlider';
</script>
