---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import FactCard from '../facts/FactCard.astro';

/** C2 Problem: BLUF sentence + FactCards from PX-* ids (each shows its source). */
interface Props {
  eyebrow?: string;
  title: string;
  /** Short BLUF sentence under the heading. */
  bluf?: string;
  factIds: string[];
  /**
   * WP175 (owner decision of 2026-11-28): the C3 transition line (C3_TRANSITION in src/data/copy.ts) as the band's last line, for a page that declares its C2 to C4 (or C2 to C3) compressed into this band.
   * Left out, the band ends with its cards, as before.
   */
  transition?: string;
  id?: string;
}
const { eyebrow = 'The Challenge', title, bluf, factIds, transition, id = 'problem' } = Astro.props;
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow={eyebrow} title={title} lead={bluf}><slot name="lead" /></SectionHeader>
  <div class:list={['grid-cards', factIds.length === 4 && 'grid-cards--4']}>
    {factIds.map((f) => <FactCard id={f} />)}
  </div>
  {transition && <p class="pb__transition" data-transition data-reveal>{transition}</p>}
</Section>

<style is:global>
  /* the same type as ProblemSection's transition line (the program pages) and CostBand's before WP40. Global, not scoped: a scoped style would add its scope attribute to the band's
     markup on every page, and a page that does not pass `transition` renders exactly as before. */
  .pb__transition {
    margin: var(--space-lg) 0 0;
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-bold);
    color: var(--secondary);
    letter-spacing: -0.5px;
  }
</style>
