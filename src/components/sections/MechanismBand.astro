---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ModelDiagram from '../ui/ModelDiagram.astro';
import Icon from '../system/Icon.astro';
import PositioningStatement from './PositioningStatement.astro';
import { linkAttrs } from '../../lib/url';

/** C6 Mechanism (Klein band): positioning statement + four-block model diagram (+ an optional slot under it, e.g. Foundations' funding-route comparison) + Learn → Earn → Prosper ribbon + link. */
interface Props {
  title: string;
  lead?: string;
  /** C6a positioning statement (data/copy.ts POSITIONING), shown in the band header. */
  positioning?: { text: string; facts: string[] };
  blocks?: { label: string; title: string; text?: string; icon?: string; factId?: string }[];
  /** Show the block diagram (default). A band whose own content is a comparison in the slot (Foundations' two funding routes, WP29) turns it off rather than repeat it. */
  diagram?: boolean;
  link?: { label: string; href: string };
  /** More links on the same line as `link` (Foundations: one link per funding route, in place of `link`). */
  moreLinks?: { label: string; href: string }[];
  ribbon?: string[];
  id?: string;
}
const {
  title,
  lead,
  positioning,
  blocks = [
    { label: 'Who We Reach', title: 'Educated, Unemployed and Underemployed Youth', text: 'Outreach and selection with local partners.', icon: 'users' },
    { label: 'How We Reach Them', title: 'Blended Training', text: 'Labs, colleges and learning that works with limited connectivity.', icon: 'graduation-cap' },
    { label: 'What We Deliver', title: 'Skills, Certification Preparation and Mentoring', text: 'Each track includes preparation for an industry certification; exam eligibility and attempts are agreed in the program scope. Then three months of milestone-based mentoring.', icon: 'award' },
    { label: 'Where They Work', title: 'Local, Remote and Global Work', text: 'Placement support and outcome tracking after each course.', icon: 'globe' },
  ],
  diagram = true,
  link,
  moreLinks = [],
  ribbon = ['Learn', 'Earn', 'Prosper'],
  id = 'mechanism',
} = Astro.props;
---

<Section id={id} tone="klein" aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="How It Works" title={title} lead={lead} leadLast={!!positioning}>
    {positioning && <PositioningStatement text={positioning.text} facts={positioning.facts} />}
  </SectionHeader>
  {diagram && <ModelDiagram blocks={blocks} />}
  <slot />
  <p class="mech__ribbon" data-reveal>
    {ribbon.map((r, i) => (<><span>{r}.</span>{i < ribbon.length - 1 && <Icon name="arrow-right" size={20} />}</>))}
  </p>
  {(link || moreLinks.length > 0) && (
    <p class="mech__link">
      {moreLinks.map((l) => <a class="link" href={linkAttrs(l.href).href}>{l.label}<Icon name="arrow-right" size={16} /></a>)}
      {link && <a class="link" href={linkAttrs(link.href).href}>{link.label}<Icon name="arrow-right" size={16} /></a>}
    </p>
  )}
</Section>

<style>
  .mech__ribbon {
    margin: var(--space-lg) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    font-size: var(--fs-heading-xl);
    font-weight: var(--fw-bold);
    letter-spacing: -0.5px;
    color: var(--ctx-heading);
  }
  .mech__ribbon span:last-of-type {
    color: var(--ctx-accent);
  }
  .mech__ribbon :global(.icon) {
    color: var(--ctx-accent);
  }
  .mech__link {
    margin: var(--space-md) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
  }
</style>
