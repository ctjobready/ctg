---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import FactStat from '../facts/FactStat.astro';
import PartnerStrip from '../system/PartnerStrip.astro';
import Icon from '../system/Icon.astro';
import { linkAttrs } from '../../lib/url';
import { PARTNER_CAPTION, type PartnerGroup } from '../../lib/logos';

/** C5 Guide: empathy (we have been here) + authority (fact stats) + method signal + partner logo marquee. */
interface Props {
  title: string;
  empathy: string;
  authorityIds: string[];
  /** Authority tiles that always carry their source note, even when the fact has no caveat of its own. */
  noted?: string[];
  method?: { text: string; link?: { label: string; href: string } };
  partnerGroup?: PartnerGroup | PartnerGroup[];
  variant?: 'marquee' | 'grid';
  id?: string;
}
const { title, empathy, authorityIds, noted = [], method, partnerGroup, variant = 'marquee', id = 'guide' } = Astro.props;
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Our track record" title={title} />
  <div class="guide">
    <div class="guide__copy" data-reveal>
      <p class="lead">{empathy}</p>
      {
        method && (
          <p class="guide__method">
            {method.text}{' '}
            {method.link && (
              <a class="link" href={linkAttrs(method.link.href).href}>{method.link.label}<Icon name="arrow-right" size={16} /></a>
            )}
          </p>
        )
      }
    </div>
    <div class="guide__stats">
      {authorityIds.map((s) => <FactStat id={s} footnote={noted.includes(s) ? true : 'auto'} />)}
    </div>
  </div>
  <PartnerStrip variant={variant} group={partnerGroup} caption={PARTNER_CAPTION} />
</Section>

<style>
  .guide {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .guide__copy > * {
    margin: 0;
  }
  .guide__copy {
    display: grid;
    gap: var(--space-md);
  }
  .guide__method {
    color: var(--on-surface-variant);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  .guide__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-gutter);
    align-content: start;
  }
  @media (min-width: 1024px) {
    .guide {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 56px;
      align-items: start;
    }
  }
</style>
