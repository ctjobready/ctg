---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import FactStat from '../facts/FactStat.astro';
import PartnerStrip from '../system/PartnerStrip.astro';
import Icon from '../system/Icon.astro';
import { linkAttrs } from '../../lib/url';
import { PARTNER_CAPTION, type PartnerGroup } from '../../lib/logos';
import { statLabelUnder } from '../../data/copy';
import { fact } from '../../data/facts';

/**
 * C5 Guide: empathy (we have been here) + authority (fact stats) + method signal + partner logo marquee.
 * WP49 (cycle-24 review): the empathy line is optional, as it is in PartnerGuideBand and GuideSection: Local Partners' band opens with its method paragraph (which names the Bangladesh team).
 * WP64 rework RW2 (coordinator): when the heading says the period (the component gallery's "We’ve Built This Path Since 2014"), a tile whose label ends "since 2014" drops it; Local Partners' heading does not, so its tiles are unchanged (statLabelUnder, src/data/copy.ts).
 */
interface Props {
  title: string;
  /** The empathy line that opens the band; a page that does not open with one leaves it out. */
  empathy?: string;
  authorityIds: string[];
  method?: { text: string; link?: { label: string; href: string } };
  partnerGroup?: PartnerGroup | PartnerGroup[];
  variant?: 'marquee' | 'grid';
  id?: string;
}
const { title, empathy, authorityIds, method, partnerGroup, variant = 'marquee', id = 'guide' } = Astro.props;
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="Our Track Record" title={title} />
  <div class="guide">
    <div class="guide__copy" data-reveal>
      {empathy && <p class="lead">{empathy}</p>}
      {
        method && (
          <p class="guide__method">
            {method.text}{' '}
            {method.link && (
              <a class="link" href={linkAttrs(method.link.href).href}>{method.link.label}<Icon name="arrow-right" size={16} /></a>
            )}
          </p>
        )
      }
    </div>
    <div class="guide__stats">
      {authorityIds.map((s) => <FactStat id={s} label={statLabelUnder(title, fact(s).stat?.label)} />)}
    </div>
  </div>
  <PartnerStrip variant={variant} group={partnerGroup} caption={PARTNER_CAPTION} />
</Section>

<style>
  .guide {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .guide__copy > * {
    margin: 0;
  }
  .guide__copy {
    display: grid;
    gap: var(--space-md);
  }
  .guide__method {
    color: var(--on-surface-variant);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  .guide__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-gutter);
    align-content: start;
  }
  @media (min-width: 1024px) {
    .guide {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }
</style>
