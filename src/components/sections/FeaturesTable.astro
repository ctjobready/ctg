---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Fact from '../facts/Fact.astro';
import Icon from '../system/Icon.astro';

/**
 * C8 Features → benefits: feature → "which means…" → outcome (fact or text); optional pain-reliever
 * column maps each feature 1:1 to a problem card.
 *
 * Review round 14, M4: on Home, YouthWIDE and the local-partners page the pain-reliever column is keyed to the ranked pains of the C2
 * band. A row with `painId` ("P1" to "P3") carries `data-relieves` and shows the pain's number in the same circle as the C2 list; a row
 * without one is a gain creator and shows the check icon. `facts` ties the row to the registered facts it rests on (`data-fact`, so the
 * status gate and the production holds see it). scripts/check-facts.mjs checks that each C2 pain has exactly one row.
 */
interface Row {
  feature: string;
  means: string;
  /** Fact ID rendered as the outcome (value + footnote), or plain text. */
  outcomeFactId?: string;
  outcome?: string;
  /** Pain relieved (mirror of a problem-band card). */
  relieves?: string;
  /** The C2 pain this row relieves, e.g. "P1". */
  painId?: string;
  /** Fact IDs the row rests on. */
  facts?: string[];
}
interface Props {
  title: string;
  lead?: string;
  rows: Row[];
  id?: string;
}
const { title, lead, rows, id = 'features' } = Astro.props;
const showPain = rows.some((r) => r.relieves);
const painNumber = (painId: string) => painId.replace(/^P/, '');
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="What you get" title={title} lead={lead} />
  <section class="ft" aria-label="Features and benefits" tabindex="0" data-scroll data-stack data-reveal>
    <table>
      <caption class="sr-only">{title}</caption>
      <thead>
        <tr>
          <th scope="col">Feature</th>
          <th scope="col">Which means…</th>
          <th scope="col">Outcome</th>
          {showPain && <th scope="col">Relieves</th>}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr data-relieves={r.painId} data-fact={r.facts?.join(' ')}>
              <th scope="row">{r.feature}</th>
              <td data-label="Which means…">{r.means}</td>
              <td data-label="Outcome">{r.outcomeFactId ? <Fact id={r.outcomeFactId} field="text" /> : r.outcome ?? '—'}</td>
              {showPain && (
                <td data-label="Relieves">
                  {r.relieves ? (
                    <span class="ft__pain">
                      {r.painId ? <span class="ft__n" aria-hidden="true">{painNumber(r.painId)}</span> : <Icon name="circle-check" size={16} />}
                      <span>{r.painId && <span class="sr-only">Pain {painNumber(r.painId)}: </span>}{r.relieves}</span>
                    </span>
                  ) : (
                    '—'
                  )}
                </td>
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Section>

<script>
  import '../../scripts/tablestack';
</script>

<style>
  .ft {
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 14px var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
  }
  thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
  }
  tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
    position: sticky;
    left: 0;
    background: var(--surface);
    min-width: 11rem;
    box-shadow: 1px 0 0 var(--outline-variant);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .ft__pain {
    display: inline-flex;
    gap: 6px;
    align-items: flex-start;
  }
  .ft__pain :global(.icon) {
    color: var(--success);
    margin-top: 4px;
    flex: none;
  }
  /* the pain's number: the same circle as the ranked list in the C2 band */
  .ft__n {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
    font-weight: var(--fw-bold);
    font-size: var(--fs-body-xs);
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
