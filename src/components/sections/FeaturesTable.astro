---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Fact from '../facts/Fact.astro';
import Icon from '../system/Icon.astro';

/**
 * C8 Features → benefits as concern-led cards (WP18b, review round 5 cycle 2: the four-column table read as a wall of cells).
 * Each card carries the concern it answers, what is included, and the practical benefit; the concern label maps each card 1:1 to a
 * problem card (Home, YouthWIDE, local partners).
 *
 * Review round 14, M4: on Home, YouthWIDE and the local-partners page the concern is keyed to the ranked pains of the C2 band. A row
 * with `painId` ("P1" to "P3") carries `data-relieves` and shows the pain's number in the same circle as the C2 list; a row without
 * one is a gain creator and shows "Added benefit". `facts` ties the row to the registered facts it rests on (`data-fact`, so the
 * status gate and the production holds see it). scripts/check-facts.mjs checks that each C2 pain has exactly one card.
 */
interface Row {
  feature: string;
  means: string;
  /** Fact ID rendered as the outcome (value + footnote), or plain text. */
  outcomeFactId?: string;
  outcome?: string;
  /** Pain relieved (mirror of a problem-band card). */
  relieves?: string;
  /** The C2 pain this row relieves, e.g. "P1". */
  painId?: string;
  /** Fact IDs the row rests on. */
  facts?: string[];
}
interface Props {
  title: string;
  lead?: string;
  rows: Row[];
  id?: string;
  /** Label above the concern ("Funder Concern Addressed" on funder pages). */
  concernLabel?: string;
}
const { title, lead, rows, id = 'features', concernLabel = 'Concern Addressed' } = Astro.props;
const showPain = rows.some((r) => r.relieves);
const painNumber = (painId: string) => painId.replace(/^P/, '');
---

<Section id={id} aria-labelledby={`${id}-h`}>
  <SectionHeader id={`${id}-h`} eyebrow="What You Get" title={title} lead={lead} />
  <ul class="fc" role="list" aria-label="Features and benefits" data-reveal>
    {
      rows.map((r) => (
        <li class="fc__card" data-relieves={r.painId} data-fact={r.facts?.join(' ')}>
          {showPain && (
            <div class="fc__concern">
              {r.relieves ? (
                <>
                  <p class="fc__label">{concernLabel}</p>
                  <p class="fc__pain">
                    {r.painId ? <span class="fc__n" aria-hidden="true">{painNumber(r.painId)}</span> : <Icon name="circle-check" size={16} />}
                    <span>{r.painId && <span class="sr-only">Concern {painNumber(r.painId)}: </span>}{r.relieves}</span>
                  </p>
                </>
              ) : (
                // WP19, item 16: a row that answers no ranked concern is a benefit, not a funder concern, so it carries its own label.
                <p class="fc__label fc__label--added">Added Benefit</p>
              )}
            </div>
          )}
          <div class="fc__part">
            <p class="fc__label">What Is Included</p>
            <p class="fc__included">{r.feature}</p>
          </div>
          <div class="fc__part">
            <p class="fc__label">Practical Benefit</p>
            <p class="fc__benefit">{r.outcomeFactId ? <Fact id={r.outcomeFactId} field="text" /> : r.outcome ?? 'See the feature'}</p>
            <p class="fc__means">{r.means}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .fc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .fc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .fc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .fc__card {
    display: grid;
    align-content: start;
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .fc__concern {
    padding: 12px var(--space-md);
    background: var(--surface-container-low);
    border-bottom: 1px solid var(--primary-fixed);
  }
  .fc__part {
    padding: 12px var(--space-md);
  }
  .fc__part + .fc__part {
    border-top: 1px solid var(--outline-variant);
  }
  .fc__card p {
    margin: 0;
  }
  .fc__label {
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
    margin-bottom: 4px !important;
  }
  .fc__label--added {
    margin-bottom: 0 !important;
  }
  .fc__pain {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    color: var(--secondary);
    font-weight: var(--fw-medium);
  }
  .fc__pain :global(.icon) {
    color: var(--success);
    margin-top: 3px;
    flex: none;
  }
  .fc__pain--added {
    color: var(--on-surface-variant);
  }
  .fc__included {
    color: var(--on-surface);
  }
  .fc__benefit {
    font-weight: var(--fw-bold);
    color: var(--secondary);
  }
  .fc__means {
    margin-top: 4px !important;
    color: var(--on-surface-variant);
  }
  /* the pain's number: the same circle as the ranked list in the C2 band */
  .fc__n {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
    font-weight: var(--fw-bold);
    font-size: var(--fs-body-xs);
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
