---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Button from '../../../components/system/Button.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import TeamCard from '../../../components/pages/about/TeamCard.astro';
import PageNav from '../../../components/pages/about/PageNav.astro';
import Icon from '../../../components/system/Icon.astro';
import { fact } from '../../../data/facts';
import { cta } from '../../../lib/mailto';
import { linkAttrs } from '../../../lib/url';
import { webPage } from '../../../lib/schema';

// Mentor photos are stored as path strings relative to src/content/ (see src/content.config.ts).
const photos = import.meta.glob<{ default: ImageMetadata }>('../../../assets/images/mentors/*.{jpg,png}', { eager: true });
const photoFor = (rel: string) => {
  const file = rel.split('/').pop()!;
  const key = Object.keys(photos).find((k) => k.endsWith('/' + file));
  return key ? photos[key].default : undefined;
};
// Light edit for the claims gate ("dashboard" is reserved wording): "Dashboard Design & Visualization" shows as "Data Visualization".
const tidyExpertise = (e: string) => e.replace(/^dashboard design\s*&\s*visualization$/i, 'Data Visualization');
const mentors = (await getCollection('mentors'))
  .map((m) => ({ ...m.data, expertise: m.data.expertise.map(tidyExpertise) }))
  .sort((a, b) => a.name.localeCompare(b.name));
// WP22: the cards are grouped by discipline. A mentor's discipline is the part of the role after the last comma ("Mentor, Digital Marketing" is
// Digital Marketing); disciplines are gathered into five headings, in this order. A mentor whose discipline is not listed fails the build.
// WP25s: Md. Hazrat Ali Nahid moved to accounting, which left "Education and Language" with one mentor (IELTS). A language mentor sits with content writing, so the
// two form one group and no category is a band of one card.
const DISCIPLINE_GROUPS = [
  { title: 'Digital Marketing, Content and Language', disciplines: ['Digital Marketing', 'Content Writing', 'Education', 'IELTS'] },
  { title: 'Design and Video', disciplines: ['Graphic Design', 'Video Editing'] },
  { title: 'Web Development and AI', disciplines: ['Web Development', 'Artificial Intelligence'] },
  { title: 'Accounting and Spreadsheets', disciplines: ['Digital Accounting', 'Advanced Excel'] },
];
const disciplineOf = (role: string) => role.slice(role.lastIndexOf(',') + 1).trim();
// WP24c: a person's role title and their field can differ. Md. Hazrat Ali Nahid is "Team Lead, Education", but his listed expertise is
// accounting software (QuickBooks, Xero, Zoho Books, Wave, FreshBooks, Sage 50, Payroll), so he sits under the accounting group.
const GROUP_OVERRIDE: Record<string, string> = { 'md-hazrat-ali-nahid': 'Accounting and Spreadsheets' };
const groupOf = (m: { id: string; role: string }) => GROUP_OVERRIDE[m.id] ?? DISCIPLINE_GROUPS.find((g) => g.disciplines.includes(disciplineOf(m.role)))?.title;
const slugOf = (t: string) => `mentors-${t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const groups = DISCIPLINE_GROUPS.map((g) => ({ ...g, id: slugOf(g.title), mentors: mentors.filter((m) => groupOf(m) === g.title) })).filter((g) => g.mentors.length > 0);
const ungrouped = mentors.filter((m) => !groups.some((g) => g.mentors.includes(m)));
if (ungrouped.length > 0) throw new Error(`Mentors: no discipline group for ${ungrouped.map((m) => `${m.name} (${m.role})`).join(', ')}`);
// SC-09 states two 150+ figures; they are shown as two sentences so neither reads as a total for the other.
const [coursesPart, mentorsPart] = fact('SC-09').text.split('; ');
if (!coursesPart || !mentorsPart || !/^150\+ skill courses and certification courses delivered$/.test(coursesPart) || !/^150\+ instructors and mentors$/.test(mentorsPart)) throw new Error('Mentors page: SC-09 wording changed; update the split');
const scLine = `${coursesPart.replace('skill courses and certification courses', 'skill and certification courses')}. ${mentorsPart}.`;
const apply = cta('mentor');
const discovery = cta('discovery');
const description = 'Meet CodersTrust mentors: practitioners in digital marketing, design, video, development and accounting who guide learners toward jobs and freelance work.';
const jsonLd = [
  {
    ...webPage({ path: '/about/mentors/', name: 'Instructors and Mentors', description, type: 'CollectionPage', breadcrumb: [{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }, { name: 'Mentors', path: '/about/mentors/' }] }),
    mainEntity: { '@type': 'ItemList', itemListElement: mentors.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.name })) },
  },
];
---

<BaseLayout title="Instructors and Mentors" description={description} breadcrumbs={[{ label: 'About', href: '/about/' }, { label: 'Mentors' }]} jsonLd={jsonLd}>
  <Hero eyebrow="About Us" title="Mentors Who Guide Learners into Work" lead="Practitioners who teach and mentor CodersTrust learners toward employment and freelance work." art={false}>
    <Fragment slot="actions">
      <Button href={apply.href} icon="mail">{apply.label}</Button>
      <a class="link" href={discovery.href}>{discovery.label}<Icon name="arrow-right" size={16} /></a>
    </Fragment>
  </Hero>

  <PageNav links={[
    { label: 'Our Mentors', href: '#mentors' },
    ...groups.map((g) => ({ label: g.title, href: `#${g.id}` })),
    { label: 'Become a Mentor', href: '#mentor-cta' },
  ]} />

  <Section id="mentors" aria-labelledby="mentors-h">
    <SectionHeader id="mentors-h" eyebrow="Our Practitioners" title="Meet Some of Our Mentors">
      <p class="lead" data-fact="SC-09">{scLine}</p>
    </SectionHeader>
    {
      groups.map((g) => (
        <div class="mn-group">
          <h2 class="mn-group__title t-heading-xl" id={g.id}>{g.title}</h2>
          <div class="grid-cards grid-cards--4">
            {g.mentors.map((m) => <TeamCard name={m.name} role={m.role} photo={photoFor(m.photo)} alt={m.photoAlt} assetId={`mentor-${m.id}`} expertise={m.expertise} chips={3} />)}
          </div>
        </div>
      ))
    }
  </Section>

  <CTABand
    id="mentor-cta"
    heading="Become a Mentor"
    text="Work in a digital field? Tell us about your experience and availability."
    cta={{ label: apply.label, href: apply.href }}
    secondary={{ label: 'See how mentoring works', href: '/our-model/talentleap/' }}
  />
</BaseLayout>

<style>
  .mn-group {
    margin-top: var(--space-lg);
  }
  .mn-group + .mn-group {
    margin-top: var(--space-xl);
  }
  .mn-group__title {
    margin: 0 0 var(--space-md);
    color: var(--secondary);
    scroll-margin-top: var(--space-xl);
  }
</style>
