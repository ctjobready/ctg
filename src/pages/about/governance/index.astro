---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Button from '../../../components/system/Button.astro';
import Icon from '../../../components/system/Icon.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import StepFlow from '../../../components/ui/StepFlow.astro';
import FAQBand from '../../../components/sections/FAQBand.astro';
import Fact from '../../../components/facts/Fact.astro';
import CopyBlock from '../../../components/pages/about/CopyBlock.astro';
import OfficeCard from '../../../components/pages/about/OfficeCard.astro';
import TeamCard from '../../../components/pages/about/TeamCard.astro';
import ContractingPanel from '../../../components/pages/about/ContractingPanel.astro';
import PageNav from '../../../components/pages/about/PageNav.astro';
import { diligenceCta } from '../../../components/pages/about/routes';
import { GOVERNANCE, SAFEGUARDING, RCT_HEADLINE } from '../../../data/copy';
import { faqJsonLd } from '../../../lib/faq';
import { formatDate, isoDate } from '../../../lib/format';
import { webPage } from '../../../lib/schema';
import { OFFICES } from '../../../lib/site';
import { linkAttrs } from '../../../lib/url';

const UPDATED = '2026-10-10';
const FAQ_IDS = ['Q3', 'Q9', 'Q10'];
const diligence = diligenceCta();
const [usa, bd] = OFFICES;
// RC-01's headline restated for a due-diligence reader: the intent-to-treat employment result only.
// WP22: the governance reader gets the employment result in one sentence and a link; the income detail is on the trial page (and on About).
const trialLine = RCT_HEADLINE.text.split(/(?<=\.)\s+(?=[A-Z])/)[0];
if (!/10\.3 percentage points more likely to be employed\.$/.test(trialLine)) throw new Error('Governance: RC-01 headline wording changed; update the trial line');
const leaders = (await getCollection('team', (e) => ['aziz-ahmad', 'shamsul-haque'].includes(e.id))).sort((a, b) => a.data.order - b.data.order);

// PD-13 list, restated as items confirmed with the funder during co-design (no document is promised as ready).
const checklist = [
  'Contracting entity and legal status',
  'Audited accounts',
  'Safeguarding policy',
  'Anti-fraud policy',
  'Data-protection policy',
  'Sanctions-screening policy',
];

const description = "CodersTrust’s offices, leadership, safeguarding and data-protection arrangements, and how funders can ask about due diligence.";
const jsonLd = [
  webPage({ path: '/about/governance/', name: 'Governance and Accountability', description, dateModified: UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }, { name: 'Governance', path: '/about/governance/' }] }),
  // Both offices are already on the Organization node of every page (organization() in src/lib/schema.ts).
  faqJsonLd('governments', '/about/governance/', FAQ_IDS),
];
---

<BaseLayout title="Governance and Accountability" description={description} breadcrumbs={[{ label: 'About', href: '/about/' }, { label: 'Governance' }]} jsonLd={jsonLd}>
  <div data-fact="ID-07 PD-13" id="hero">
    <Hero eyebrow="For Funders, Procurement Teams and Partners" title="Governance and Accountability" lead={GOVERNANCE.text} artSeed="governance">
      <p class="gov-updated">Last updated <time datetime={isoDate(UPDATED)}>{formatDate(UPDATED)}</time></p>
      <Fragment slot="actions">
        <Button href={diligence.href} iconEnd="arrow-right">{diligence.label}</Button>
        <a class="link" href="#offices">See the Offices<Icon name="arrow-right" size={16} /></a>
      </Fragment>
    </Hero>
  </div>

  <PageNav links={[
    { label: 'Contracting and Accountability', href: '#contracting' },
    { label: 'Offices', href: '#offices' },
    { label: 'Leadership', href: '#leadership' },
    { label: 'Safeguarding', href: '#safeguarding' },
    { label: 'Evidence', href: '#evidence' },
    { label: 'Due Diligence', href: '#checklist' },
  ]} />

  <ContractingPanel requestHref={diligence.href} requestLabel={diligence.label} />

  <Section id="offices" aria-labelledby="offices-h">
    <SectionHeader id="offices-h" eyebrow="Offices" title="Where to Find Us" lead="CodersTrust has offices in New York and Dhaka." />
    <div class="grid-cards grid-cards--2">
      <OfficeCard {...usa} city="New York · Office" />
      <OfficeCard {...bd} name="CodersTrust Bangladesh Ltd." city="Dhaka · Headquarters" note="Campuses in Mirpur (Dhaka) and Agrabad (Chattogram)." />
    </div>
  </Section>

  <Section id="leadership" tone="airy" aria-labelledby="lead-h">
    <SectionHeader id="lead-h" eyebrow="Leadership" title="Who Leads CodersTrust" lead="Aziz Ahmad is Chairman, and Md. Shamsul Haque is CEO of CodersTrust Bangladesh. Founders, advisors, the executive team and Bangladesh leadership are on the team page." />
    <div class="grid-cards grid-cards--2 gov-leaders" data-fact="ID-03">
      {leaders.map((p) => <TeamCard name={p.data.name} role={p.data.role} photo={p.data.photo} alt={p.data.photoAlt} assetId={`team-${p.id}`} href={`/about/team/${p.id}/`} />)}
    </div>
    <p class="gov-more"><a class="link" href={linkAttrs('/about/team/').href}>Leadership and Team<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <Section id="safeguarding" aria-labelledby="safe-h">
    <SectionHeader id="safe-h" eyebrow="Safeguarding" title="How People Are Protected" />
    <div class="gov-text">
      <CopyBlock class="lead" block={SAFEGUARDING} />
      <p data-fact="PD-12">Funders receive privacy-appropriate data.</p>
    </div>
  </Section>

  <Section id="anti-fraud" tone="ice" aria-labelledby="fraud-h">
    <SectionHeader id="fraud-h" eyebrow="Anti-Fraud and Data Protection" title="How Results Are Evidenced and Records Are Kept" />
    <div class="grid-cards grid-cards--2">
      <article class="card" data-reveal>
        <div class="card__body">
          <h3 class="card__title">Evidence of Results</h3>
          <p class="card__text"><Fact id="PD-09" /></p>
        </div>
      </article>
      <article class="card" data-reveal>
        <div class="card__body">
          <h3 class="card__title">Consent and Records</h3>
          <p class="card__text" data-fact="PD-12">Data collection is consent-based and records are protected, with harassment and fraud response and referral pathways agreed for each program. Policies are shared with partners during due diligence.</p>
        </div>
      </article>
    </div>
  </Section>

  <Section id="evidence" aria-labelledby="evid-h">
    <SectionHeader id="evid-h" eyebrow="Independent Evidence" title="Independent Evaluation and Funder Reporting" />
    <div class="gov-text">
      <p class="lead" data-fact="RC-01"><strong>Independent evaluation is welcome.</strong> {trialLine}</p>
      <p data-fact="PD-08">Funders also receive monthly reports from the first cohort.</p>
      <p><a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>The Randomized Trial<Icon name="arrow-right" size={16} /></a></p>
    </div>
  </Section>

  <FAQBand id="faq" audience="governments" ids={FAQ_IDS} title="Questions on Safeguarding, Evidence and Funding" />

  <Section id="checklist" tone="airy" aria-labelledby="check-h">
    <SectionHeader id="check-h" eyebrow="Due Diligence" title="What We Confirm with You in Co-Design" />
    <div class="gov-check" data-fact="PD-13">
      <p>This list is a checklist for the conversation: tell us which documents you need and by when, and we confirm what is available for your program.</p>
      <ul class="gov-check__list" role="list">
        {checklist.map((c) => <li>{c}</li>)}
      </ul>
      <p><a class="link" href={diligence.href}>{diligence.label}<Icon name="arrow-right" size={16} /></a></p>
      <div class="gov-print"><button type="button" class="link gov-print__btn" data-print><Icon name="printer" size={16} />Print This Checklist</button></div>
    </div>
  </Section>

  <Section id="next" aria-labelledby="next-h">
    <SectionHeader id="next-h" eyebrow="What Happens Next" title="From Your Question to a Clarification Call" />
    <StepFlow steps={[
      { title: 'Your Question', text: 'Tell us the organization, the program or grant under consideration and what you need.' },
      { title: 'Our Reply', text: 'We reply with what can be shared.' },
      { title: 'Clarification Call', text: 'We talk through anything that needs clarifying.' },
    ]} />
  </Section>

  <CTABand
    id="diligence-cta"
    heading="Ask About Due Diligence"
    text="Send the program or grant you are considering and the questions you need answered. We will reply with what can be shared."
    cta={{ label: diligence.label, href: diligence.href }}
    secondary={{ label: 'Read our evidence', href: '/impact/' }}
  />

</BaseLayout>

<script>
  document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
</script>

<style>
  .gov-updated {
    margin: 0;
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
  .gov-text {
    display: grid;
    gap: var(--space-md);
    max-width: var(--measure);
  }
  .gov-text > * {
    margin: 0;
  }
  .gov-leaders {
    max-width: 640px;
  }
  .gov-more {
    margin: var(--space-lg) 0 0;
  }
  .gov-check {
    display: grid;
    gap: var(--space-md);
    max-width: var(--measure);
    justify-items: start;
  }
  .gov-check > p {
    margin: 0;
  }
  .gov-check__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
    width: 100%;
  }
  .gov-check__list li {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 48px;
    padding: 0 var(--space-md);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    font-weight: var(--fw-medium);
    color: var(--on-surface);
  }
  .gov-check__list li::before {
    content: '';
    flex: none;
    width: 20px;
    height: 20px;
    border: 2px solid var(--primary);
    border-radius: var(--radius-sm);
  }
  /* The print button needs JavaScript, so it only shows when the page has set the js flag. */
  .gov-print {
    display: none;
  }
  .gov-print__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: var(--fw-medium);
    cursor: pointer;
    min-height: 24px;
  }
  :global(html.js) .gov-print {
    display: block;
  }
  @media print {
    :global(html.js) .gov-print {
      display: none;
    }
  }
</style>
