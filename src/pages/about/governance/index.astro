---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Button from '../../../components/system/Button.astro';
import Icon from '../../../components/system/Icon.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import FaqSection from '../../../components/pages/programs/FaqSection.astro';
import { faqNode, para, type FaqSource } from '../../../components/pages/programs/faq';
import Fact from '../../../components/facts/Fact.astro';
import CopyBlock from '../../../components/pages/about/CopyBlock.astro';
import OfficeCard from '../../../components/pages/about/OfficeCard.astro';
import TeamCard from '../../../components/pages/about/TeamCard.astro';
import ContractingPanel from '../../../components/pages/about/ContractingPanel.astro';
import PageNav from '../../../components/pages/about/PageNav.astro';
import { diligenceCta } from '../../../components/pages/about/routes';
import { BIGD_FULL, GOVERNANCE, SAFEGUARDING, RCT_HEADLINE, spellOutBigd } from '../../../data/copy';
import { formatDate, isoDate } from '../../../lib/format';
import { webPage } from '../../../lib/schema';
import { OFFICES } from '../../../lib/site';
import { linkAttrs } from '../../../lib/url';

const UPDATED = '2026-10-31'; // WP129 (owner rule 2026-10-31: any change to visible text moves the date, copy edits included): WP127 and WP128 changed the page's copy and meta description on 2026-10-30 (it was 2026-10-24).
// WP24c: Q3 reads "How Do You Track and Verify Outcomes?" here (the shared answer is kept)
// WP30e: two decision questions. Tracking gets the short answer (the shared Q3 reduced to its two claims); safeguarding is answered in its own section above.
const faqSources: FaqSource[] = [
  {
    q: 'How Do You Track and Verify Outcomes?',
    html: para('For every cohort, as agreed in the program scope, we plan a baseline at enrollment, follow-up surveys at 3, 6 and 12 months and monthly reports. Where available, offer letters, payslips, platform logs or bank receipts document work and earnings.'),
    evidence: ['PD-09', 'PD-08', 'RC-01'],
  },
  { audience: 'governments', id: 'Q10' },
];
const diligence = diligenceCta();
const [usa, bd] = OFFICES;
// RC-01's headline restated for a due-diligence reader: the intent-to-treat employment result only.
// WP22: the governance reader gets the employment result in one sentence and a link; the income detail is on the trial page (and on About).
// WP54 (cycle-28 review, GPT-6.1 Sol G8): this sentence is the page's one mention of the evaluator, so it is spelled out ("by the BRAC Institute of Governance and Development (BIGD)"); the register's headline says "by BIGD".
const trialLine = spellOutBigd(RCT_HEADLINE.text.split(/(?<=\.)\s+(?=[A-Z])/)[0]);
if (!/10\.3 percentage points more likely to be employed\.$/.test(trialLine)) throw new Error('Governance: RC-01 headline wording changed; update the trial line');
if (!trialLine.includes(BIGD_FULL)) throw new Error('Governance: the RC-01 headline no longer says "by BIGD"; update the expansion');
const leaders = (await getCollection('team', (e) => ['aziz-ahmad', 'shamsul-haque'].includes(e.id))).sort((a, b) => a.data.order - b.data.order);

// The checklist ("What We Confirm with You in Co-Design", below) restates PD-13 as three lines (owner decision 2026-10-16, WP53): the legal status (ID-12, built from the register), the audited accounts (they exist; shared on request) and the safeguarding,
// anti-fraud, data-protection and sanctions-screening arrangements, which are agreed for each program in co-design. The four policies are still being drafted for adoption, so no line names a policy document or promises one as ready.

const description = "CodersTrust’s offices and leadership, with its safeguarding and data-protection arrangements, set out for funders doing due diligence.";
const jsonLd = [
  webPage({ path: '/about/governance/', name: 'Governance and Accountability', description, dateModified: UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }, { name: 'Governance', path: '/about/governance/' }] }),
  // Both offices are already on the Organization node of every page (organization() in src/lib/schema.ts).
  faqNode(faqSources, '/about/governance/'),
];
---

<BaseLayout title="Governance and Accountability" description={description} breadcrumbs={[{ label: 'About', href: '/about/' }, { label: 'Governance' }]} jsonLd={jsonLd}>
  <div data-fact="ID-07 PD-13" id="hero">
    <Hero eyebrow="For Funders, Procurement Teams and Partners" title="Accountable by Design" lead={GOVERNANCE.text} artSeed="governance">
      <p class="gov-updated">Last updated <time datetime={isoDate(UPDATED)}>{formatDate(UPDATED)}</time></p>
      <Fragment slot="actions">
        <Button href={diligence.href} iconEnd="arrow-right">{diligence.label}</Button>
        <a class="link" href="#offices">See the Offices<Icon name="arrow-right" size={16} /></a>
      </Fragment>
    </Hero>
  </div>

  <PageNav links={[
    { label: 'Contracting and Accountability', href: '#contracting' },
    { label: 'Where to Find Us', href: '#offices' },
    { label: 'Who Leads CodersTrust', href: '#leadership' },
    { label: 'How People Are Protected', href: '#safeguarding' },
    { label: 'Independent Evaluation and Funder Reporting', href: '#evidence' },
    { label: 'Common Due-Diligence Questions', href: '#faq' },
    { label: 'What We Confirm with You in Co-Design', href: '#checklist' },
  ]} />

  <ContractingPanel requestHref={diligence.href} requestLabel={diligence.label} />

  <Section id="offices" aria-labelledby="offices-h">
    <SectionHeader id="offices-h" eyebrow="Offices" title="Where to Find Us" lead="CodersTrust is headquartered in New York, with a country office in Dhaka." />
    <div class="grid-cards grid-cards--2">
      <OfficeCard {...usa} city={`${usa.city} · ${usa.kind}`} />
      <OfficeCard {...bd} city={`${bd.city} · ${bd.kind}`} note="Campuses in Mirpur (Dhaka) and Agrabad (Chattogram)." />
    </div>
  </Section>

  <Section id="leadership" tone="airy" aria-labelledby="lead-h">
    <SectionHeader id="lead-h" eyebrow="Leadership" title="Who Leads CodersTrust" />
    <div class="grid-cards grid-cards--2 gov-leaders" data-fact="ID-03">
      {leaders.map((p) => <TeamCard name={p.data.name} role={p.data.role} photo={p.data.photo} alt={p.data.photoAlt} assetId={`team-${p.id}`} href={`/about/team/${p.id}/`} />)}
    </div>
    <p class="gov-more"><a class="link" href={linkAttrs('/about/team/').href}>Leadership and Team<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <Section id="safeguarding" aria-labelledby="safe-h">
    <SectionHeader id="safe-h" eyebrow="Safeguarding" title="How People Are Protected" />
    <div class="gov-text">
      <CopyBlock class="lead" block={SAFEGUARDING} />
    </div>
  </Section>

  <Section id="evidence" aria-labelledby="evid-h">
    <SectionHeader id="evid-h" eyebrow="Independent Evidence" title="Independent Evaluation and Funder Reporting" />
    <div class="gov-text">
      <p class="lead" data-fact="RC-01"><strong>Independent evaluation is welcome.</strong> {trialLine}</p>
      <p data-fact="PD-08">As agreed in the program scope, funders receive monthly reports from the first cohort.</p>
      <p><a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>The Randomized Trial<Icon name="arrow-right" size={16} /></a></p>
    </div>
  </Section>

  <FaqSection id="faq" sources={faqSources} title="Common Due-Diligence Questions" eyebrow="Questions" />

  <Section id="checklist" tone="airy" aria-labelledby="check-h">
    <SectionHeader id="check-h" eyebrow="Due Diligence" title="What We Confirm with You in Co-Design" />
    <div class="gov-check" data-fact="PD-13">
      <p>Tell us which documents you need and by when.</p>
      <ul class="gov-check__list" role="list">
        <li><span>Legal status: <Fact id="ID-12" /></span></li>
        <li data-fact="PD-13"><span>Audited accounts, on request.</span></li>
        <li data-fact="PD-12 PD-13"><span>Safeguarding, anti-fraud, data-protection and sanctions-screening arrangements, agreed for each program in co-design.</span></li>
      </ul>
      <div class="gov-print"><button type="button" class="link gov-print__btn" data-print><Icon name="printer" size={16} />Print This Checklist</button></div>
    </div>
  </Section>

  <CTABand
    id="diligence-cta"
    heading="Ask About Due Diligence"
    text="Send the program or grant you are considering and the questions you need answered. We will reply with what can be shared."
    cta={{ label: diligence.label, href: diligence.href }}
    secondary={{ label: 'Read our evidence', href: '/impact/' }}
  />

</BaseLayout>

<script>
  document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
</script>

<style>
  .gov-updated {
    margin: 0;
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
  .gov-text {
    display: grid;
    gap: var(--space-md);
    max-width: var(--measure);
  }
  .gov-text > * {
    margin: 0;
  }
  .gov-leaders {
    max-width: 640px;
  }
  .gov-more {
    margin: var(--space-lg) 0 0;
  }
  .gov-check {
    display: grid;
    gap: var(--space-md);
    max-width: var(--measure);
    justify-items: start;
  }
  .gov-check > p {
    margin: 0;
  }
  .gov-check__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
    width: 100%;
  }
  .gov-check__list li {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 48px;
    padding: var(--space-sm) var(--space-md);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    font-weight: var(--fw-medium);
    color: var(--on-surface);
  }
  .gov-check__list li::before {
    content: '';
    flex: none;
    width: 20px;
    height: 20px;
    border: 2px solid var(--primary);
    border-radius: var(--radius-sm);
  }
  /* The print button needs JavaScript, so it only shows when the page has set the js flag. */
  .gov-print {
    display: none;
  }
  .gov-print__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: var(--fw-medium);
    cursor: pointer;
    min-height: 24px;
  }
  :global(html.js) .gov-print {
    display: block;
  }
  @media print {
    :global(html.js) .gov-print {
      display: none;
    }
  }
</style>
