---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Button from '../../../components/system/Button.astro';
import Icon from '../../../components/system/Icon.astro';
import PageNav from '../../../components/pages/about/PageNav.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Img from '../../../components/ui/Img.astro';
import Quote from '../../../components/ui/Quote.astro';
import Fact from '../../../components/facts/Fact.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import AsCoveredBy from '../../../components/ui/AsCoveredBy.astro';
import PhotoGallery from '../../../components/ui/PhotoGallery.astro';
import { galleryPhotos } from '../../../data/photos';
import { COVERED_BY, COVERED_BY_WORLD_BANK, press } from '../../../data/press';
import { endorsements } from '../../../data/endorsements';
import { READ_THE_EVIDENCE } from '../../../data/copy';
import { fact } from '../../../data/facts';
import { ctaHref } from '../../../lib/mailto';
import { formatDate, isoDate, slugify } from '../../../lib/format';
import { webPage } from '../../../lib/schema';
import { linkAttrs, url } from '../../../lib/url';
import { newsHref } from '../../../components/pages/news/news';

const news = await getCollection('news');
const byId = new Map(news.map((n) => [n.id, n]));
const post = (id: string) => byId.get(id);

// Founder honors (PA-11): parsed from the fact so wording and years cannot drift; each links to its dated news post.
const HONOR_POSTS: [RegExp, string | null][] = [
  [/UPEACE/, 'aziz-ahmad-co-founder-and-global-chairman-of-coderstrust-appointed-as-global-upeace-ambassador'],
  [/SDG Life Achievement/, 'coderstrust-chairman-mr-aziz-ahmad-receives-sdg-life-achievement-award-from-the-unsgii'],
];
const honors = fact('PA-11')
  .text.split(': ')
  .slice(1)
  .join(': ')
  .split('; ')
  .map((s) => {
    const m = s.match(/^(.*?) \((\d{4})(?:, (.*))?\)$/);
    const label = m ? m[1] : s;
    const slug = HONOR_POSTS.find(([re]) => re.test(label))?.[1] ?? null;
    const note = m?.[3];
    return { label, year: m?.[2], note, post: slug ? post(slug) : undefined };
  });
// The NYNJMSDC Partnership Award was received by UTC Associates, the company Aziz Ahmad leads, so it is not one of his personal honors (owner decision, 2026-10-13).
// WP106 (owner 2026-10-29: the NOVA Award is "bio only"): PA-11 no longer lists it, so this list is the two dated appointments and honors that have a news post; the award is told in his profile.
// WP105 (owner 2026-10-29: "bio only"): the "Recognition Connected to Our Chairman’s Work" section that showed it as related recognition is gone from this page; the award is told in his profile and its dated news post.
const COMPANY_AWARD = /NYNJMSDC/;
const personalHonors = honors.filter((h) => !COMPANY_AWARD.test(h.label));

// Media coverage (PA-09): the eight registered items, with years, oldest first. Links only where the original URL is known.
const PA09 = ['Forbes', 'The Wall Street Journal', 'TechCrunch', 'Tech in Asia', 'Gulf News', 'USA Today', 'The Times of India', 'World Bank'];
// WP87 (CLR review, Opus XHigh run 1, Minor): each card's headline links to its article. `press` has the original URL for TechCrunch alone, so the others come from COVERED_BY (the links the research checked on 17-18 October 2026: a live page where one answers,
// otherwise the Wayback Machine copy); the World Bank card is the 2016 Kosovo feature story of COVERED_BY_WORLD_BANK. The build stops if a card has no link.
const cardHref = (p: (typeof press)[number]): string => {
  const href = p.url ?? (p.outlet === 'World Bank' ? COVERED_BY_WORLD_BANK.find((w) => w.place === 'Kosovo')?.pages.find((x) => x.year === '2016')?.href : COVERED_BY.find((c) => c.outlet === p.outlet)?.href);
  if (!href) throw new Error(`Recognition: the early-coverage card "${p.outlet}" has no article link`);
  return href;
};
const coverage = press
  .filter((p) => PA09.includes(p.outlet))
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((p) => ({ ...p, year: p.date.slice(0, 4), a: linkAttrs(cardHref(p)) }));
// WP25s: the World Bank item names a program only by its headline; one clause says it is CodersTrust's Women in Online Work program in Kosovo (PR-02: with the World Bank Group), with a link to the case study.
const CONTEXT: Record<string, { text: string; href: string; label: string; fact: string }> = {
  'World Bank': { text: 'About CodersTrust’s Women in Online Work program in Kosovo, with the World Bank Group.', href: '/impact/case-studies/kosovo-women-in-online-work/', label: 'Read the Case Study', fact: 'PR-02' },
};

// Forums and events: only those documented in a dated news post. Political posts (`political` front matter) stay under /news/.
const FORUMS = [
  'aziz-ahmad-advocates-technology-skills-for-peace-at-un-world-press-freedom-day',
  'coderstrust-attends-wsis20-forum-high-level-event',
  'coderstrust-chairman-mr-aziz-ahmad-speaks-on-cybersecurity-artificial-intelligence-at-united-nations-general-assembly-unga-2025',
  'coderstrust-chairman-mr-aziz-ahmad-joins-bciu-roundtable-in-washington-d-c',
  'coderstrust-chairman-and-co-founder-aziz-ahmad-participates-in-u-s-energy-security-panel',
]
  .map(post)
  .filter((p): p is NonNullable<typeof p> => !!p && !p.data.political);

// Public officials' endorsements stay out of evergreen pages: PA-10 (U.S. Department of State remarks) may appear only inside its
// dated news item. (The Danish ambassador's entry is removed from the dataset itself, with its photo and permission row.)
const OFFICIAL_ENDORSERS = new Set(['james-gardiner']);
const quotes = endorsements.filter((e) => !OFFICIAL_ENDORSERS.has(e.id));
// Quotes are verbatim; the migration glued some sentences together ("tomorrow.Thank"), so only the spacing after a full stop is restored.
const tidy = (q: string) => q.replace(/^[“"]\s*/, '').replace(/\s*[”"]$/, '').replace(/([a-z]{2})\.([A-Z])/g, '$1. $2');

const kit = [
  { file: 'coderstrust-wordmark', label: 'Wordmark', note: 'For light backgrounds', dark: false, w: 1200, h: 143 },
  { file: 'coderstrust-wordmark-white', label: 'Wordmark, white', note: 'For dark and Klein Blue backgrounds', dark: true, w: 1200, h: 143 },
  { file: 'coderstrust-monogram', label: 'CT monogram', note: 'For small spaces and avatars', dark: false, w: 1200, h: 725 },
];

const description = 'HolonIQ South Asia EdTech 100 listing, founder honors, media coverage from 2014 to 2016, and a press kit with logos and boilerplate for CodersTrust.';
const jsonLd = [webPage({ path: '/about/recognition/', name: 'Recognition and Media', description, dateModified: '2026-10-29', breadcrumb: [{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }, { name: 'Recognition and Media', path: '/about/recognition/' }] })];
const media = { href: ctaHref('media'), label: 'Media Inquiries' };
---

<BaseLayout title="Recognition and Media" description={description} breadcrumbs={[{ label: 'About', href: '/about/' }, { label: 'Recognition and Media' }]} jsonLd={jsonLd}>
  <!-- WP45 (cycle-21 review): the H1 states what the register supports (PA-08: listed in the HolonIQ South Asia EdTech 100 in 2023 and 2024), not "Recognized, Honored and Covered Worldwide", which claimed more than the listings, the founder's honors and the 2014 to 2016 press coverage show; the lead no longer repeats the listing (the Industry Recognition band below gives the years). -->
  <Hero eyebrow="About Us" title="Twice Listed in the HolonIQ South Asia EdTech 100" lead="CodersTrust’s co-founder and Chairman, Aziz Ahmad, has received appointments and honors, and its work has been covered in the press." art={false}>
    <Fragment slot="actions">
      <Button href={media.href} icon="mail">{media.label}</Button>
      <a class="link" href="#press-kit">Press Kit<Icon name="arrow-right" size={16} /></a>
    </Fragment>
  </Hero>

  <!-- WP86 (coordinator item 11): each entry is a section's own heading, and every section that renders gets one (the three conditional sections only when they render). -->
  <PageNav links={[
    { label: 'HolonIQ South Asia EdTech 100, 2023 and 2024', href: '#listing' },
    { label: 'Aziz Ahmad’s Appointments and Honors', href: '#honors' },
    ...(FORUMS.length > 0 ? [{ label: 'Where CodersTrust Has Taken Part', href: '#forums' }] : []),
    ...(quotes.length > 0 ? [{ label: 'What University for Peace Says', href: '#endorsements' }] : []),
    { label: 'Awards and Forums in Photographs', href: '#photos' },
    { label: 'Early Coverage of CodersTrust’s First Years, 2014–2016', href: '#coverage' },
    { label: 'Coverage of Our Work in Kosovo and Albania', href: '#world-bank' },
    { label: 'Press Kit', href: '#press-kit' },
  ]} />

  <Section id="listing" aria-labelledby="listing-h">
    <SectionHeader id="listing-h" eyebrow="Industry Recognition" title="HolonIQ South Asia EdTech 100, 2023 and 2024" />
    <div class="rec-listing">
      <span class="rec-listing__badge" aria-hidden="true"><Icon name="award" size={32} /></span>
      <div>
        <p class="lead" data-fact="PA-08">CodersTrust was listed in the HolonIQ South Asia EdTech 100 in 2023 (STEAM category) and 2024.</p>
        <p><a class="link" href={`${url('/news/')}#nf-recognition`}>More Recognition News<Icon name="arrow-right" size={16} /></a></p>
      </div>
    </div>
  </Section>

  <Section id="honors" tone="airy" aria-labelledby="honors-h">
    <SectionHeader id="honors-h" eyebrow="Founder Honors" title="Aziz Ahmad’s Appointments and Honors" lead="Co-Founder and Chairman." />
    <ul class="rec-honors" role="list" data-fact="PA-11">
      {
        personalHonors.map((h) => (
          <li class="card rec-honor" data-reveal>
            <div class="card__body">
              {h.year && <p class="eyebrow">{h.year}</p>}
              <h3 class="card__title">{h.label}</h3>
              {h.note && <p class="card__meta">{h.note}</p>}
              {
                h.post ? (
                  <p>
                    <a class="link" href={url(newsHref(h.post))}>Read the Announcement<Icon name="arrow-right" size={16} /></a>
                    <span class="card__meta rec-honor__date"> Published <time datetime={isoDate(h.post.data.date)}>{formatDate(h.post.data.date)}</time></span>
                  </p>
                ) : (
                  <p><a class="link" href={url('/about/team/aziz-ahmad/')}>In His Profile<Icon name="arrow-right" size={16} /></a></p>
                )
              }
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    FORUMS.length > 0 && (
      <Section id="forums" aria-labelledby="forums-h">
        <SectionHeader id="forums-h" eyebrow="Forums and Events" title="Where CodersTrust Has Taken Part" />
        <ul class="rec-forums" role="list">
          {FORUMS.map((f) => (
            <li>
              <a class="rec-forum" href={url(newsHref(f))}>
                <span class="rec-forum__date"><time datetime={isoDate(f.data.date)}>{formatDate(f.data.date)}</time></span>
                <span class="rec-forum__title">{f.data.title}</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    quotes.length > 0 && (
      <Section id="endorsements" tone="airy" aria-labelledby="end-h">
        <SectionHeader id="end-h" eyebrow="University Partnership" title="What University for Peace Says" />
        <div class="rec-quotes">
          {quotes.map((e) => (
            <figure class="rec-quote" data-asset={`endorsement-${e.id}`} data-reveal>
              <Img src={e.photo} alt={e.photoAlt} width={96} height={96} assetId={`endorsement-${e.id}`} class="rec-quote__photo" />
              <Quote cite={e.name} role={e.title}>{tidy(e.quote)}</Quote>
            </figure>
          ))}
        </div>
      </Section>
    )
  }

  <PhotoGallery id="photos" tone="white" eyebrow="In the Field" title="Awards and Forums in Photographs" photos={galleryPhotos('recognition')} />

  <Section id="coverage" tone="airy" aria-labelledby="coverage-h">
    <SectionHeader id="coverage-h" eyebrow="For Journalists" title="Early Coverage of CodersTrust’s First Years, 2014–2016" />
    <ul class="rec-press" role="list" data-fact="PA-09">
      {
        coverage.map((c) => (
          <li class="card rec-press__item" data-reveal>
            <div class="card__body">
              <div class="rec-press__logo">
                <Img src={c.logo} alt={c.logoAlt} height={36} assetId={`press-${slugify(c.outlet)}`} />
              </div>
              <p class="card__meta"><time datetime={c.year}>{c.year}</time></p>
              <h3 class="rec-press__headline">
                <a class="link" href={c.a.href} rel={c.a.rel}>{c.headline}<span class="sr-only"> {c.a.srText}</span></a>
              </h3>
              {CONTEXT[c.outlet] && (
                <p class="card__meta rec-press__context" data-fact={CONTEXT[c.outlet].fact}>
                  {CONTEXT[c.outlet].text} <a class="link" href={url(CONTEXT[c.outlet].href)}>{CONTEXT[c.outlet].label}<Icon name="arrow-right" size={16} /></a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
    <!-- WP87 (CLR review, Opus XHigh run 1): the paragraph "Early press coverage, 2014–2016: Gulf News, TechCrunch, ..." is gone (it repeated the eight outlets above only to carry their links, which the cards carry now). -->
    <aside class="rec-note" data-fact="ID-03" aria-label="Note on founder attribution">
      <Icon name="info" size={20} />
      <p>Some 2014 coverage described Morten Lund as a co-founder of CodersTrust. CodersTrust’s founders are Aziz Ahmad and Ferdinand Kjærulff.</p>
    </aside>
  </Section>

  <!-- WP87 (CLR review, Opus XHigh run 1): the World Bank pages (Kosovo 2016 and 2017, Albania 2021, PA-13) keep their links, in a section of their own so the 2021 release does not sit under the 2014–2016 heading. Home's pointer sentence still names this page for both. -->
  <Section id="world-bank" tone="white" pad="sm" aria-labelledby="wb-h">
    <SectionHeader id="wb-h" eyebrow="World Bank" title="Coverage of Our Work in Kosovo and Albania" />
    <AsCoveredBy class="rec-covered" />
  </Section>

  <Section id="press-kit" tone="ice" aria-labelledby="kit-h">
    <SectionHeader id="kit-h" eyebrow="For Journalists" title="Press Kit" lead="Logos, boilerplate and a media contact." />
    <div class="kit">
      <div class="kit__block">
        <h3 class="t-heading-m">Boilerplate</h3>
        <div class="kit__boiler">
          <p data-fact="ID-01"><Fact id="ID-01" /></p>
          <ul class="kit__facts" role="list">
            <li><Fact id="ID-02" /></li>
            <li><Fact id="SC-01" /></li>
            <li><Fact id="SC-03" /></li>
          </ul>
        </div>
        <p class="card__meta">CodersTrust, “Learn. Earn. Prosper.”</p>
      </div>
      <div class="kit__block">
        <h3 class="t-heading-m">Logo Files</h3>
        <ul class="kit__logos" role="list">
          {kit.map((k) => (
            <li class="card kit__logo">
              <div class:list={['kit__preview', k.dark && 'kit__preview--dark']}>
                <img src={url(`/press-kit/${k.file}.png`)} alt={`${k.label} logo preview`} width={k.w} height={k.h} loading="lazy" decoding="async" />
              </div>
              <div class="card__body">
                <p class="kit__name">{k.label}</p>
                <p class="card__meta">{k.note}</p>
                <p class="kit__dl">
                  <a class="link" href={url(`/press-kit/${k.file}.svg`)} download><Icon name="download" size={16} />SVG</a>
                  <a class="link" href={url(`/press-kit/${k.file}.png`)} download><Icon name="download" size={16} />PNG</a>
                </p>
              </div>
            </li>
          ))}
        </ul>
        <p class="card__meta">Do not recolor, stretch, rotate or add effects to the logos. Leave clear space around the logo at least as tall as the letter C.</p>
      </div>
      <div class="kit__block">
        <h3 class="t-heading-m">Media Contact</h3>
        <p>Write to the team with your outlet, your deadline and the topic.</p>
        <p><a class="link" href={media.href}>{media.label}<Icon name="arrow-right" size={16} /></a></p>
      </div>
    </div>
  </Section>

  <CTABand
    id="rec-cta"
    heading="Working on a Story About Youth Employment?"
    text="We can talk about what the evidence shows and what it does not."
    cta={{ label: media.label, href: media.href }}
    secondary={{ label: READ_THE_EVIDENCE, href: '/impact/' }}
  />
</BaseLayout>

<style>
  .rec-listing {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    max-width: var(--measure);
  }
  .rec-listing p {
    margin: 0 0 var(--space-sm);
  }
  .rec-listing__badge {
    flex: none;
    display: inline-flex;
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--tertiary-container);
    color: var(--on-tertiary-container);
  }
  .rec-honors,
  .rec-press,
  .rec-forums,
  .kit__logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-gutter);
  }
  @media (min-width: 768px) {
    .rec-honors,
    .rec-press {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .rec-honors {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .rec-press {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .kit__logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .rec-honor p,
  .rec-press__item p {
    margin: 0;
  }
  .rec-honor__date {
    display: block;
    margin-top: var(--space-xs);
  }
  .rec-press__logo {
    height: 44px;
    display: flex;
    align-items: center;
  }
  .rec-press__logo :global(img) {
    max-height: 36px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
  }
  .rec-press__headline {
    margin: 0;
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    font-weight: var(--fw-medium);
    color: var(--on-surface);
  }
  /* WP87: the World Bank line is the only content of its own section (it sat one large step under the card grid before); one medium step under the section header */
  :global(.rec-covered) {
    margin: var(--space-md) 0 0;
  }
  .rec-note {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background: var(--surface-container-low);
    border-radius: var(--radius-sm);
    max-width: var(--measure);
  }
  .rec-note p {
    margin: 0;
  }
  .rec-note :global(.icon) {
    flex: none;
    margin-top: var(--space-xs);
    color: var(--primary);
  }
  .rec-quotes {
    display: grid;
    gap: var(--space-lg);
  }
  @media (min-width: 900px) {
    .rec-quotes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .rec-quote {
    margin: 0;
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .rec-quote :global(.rec-quote__photo) {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    object-fit: cover;
    object-position: 50% 15%;
  }
  .rec-forums {
    gap: var(--space-sm);
  }
  .rec-forum {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    min-height: 56px;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    text-decoration: none;
    color: var(--on-surface);
    background: var(--surface);
  }
  .rec-forum:hover {
    border-color: var(--primary);
    background: var(--surface-container-low);
  }
  .rec-forum__date {
    flex: none;
    width: 9.5rem;
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
  .rec-forum__title {
    flex: 1;
    font-weight: var(--fw-medium);
  }
  @media (max-width: 640px) {
    .rec-forum {
      flex-wrap: wrap;
    }
    .rec-forum__date {
      width: 100%;
    }
  }
  .kit {
    display: grid;
    gap: var(--space-lg);
  }
  .kit__block > * + * {
    margin-top: var(--space-md);
  }
  .kit__block h3 {
    margin: 0;
  }
  .kit__boiler {
    max-width: var(--measure);
    padding: var(--space-md);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
  }
  .kit__boiler p {
    margin: 0;
  }
  .kit__facts {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }
  .kit__preview {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg) var(--space-md);
    min-height: 120px;
    background: var(--surface);
    border-bottom: 1px solid var(--outline-variant);
  }
  .kit__preview--dark {
    background: var(--secondary);
  }
  .kit__preview img {
    width: 100%;
    max-width: 240px;
    height: auto;
    max-height: 90px;
    object-fit: contain;
  }
  .kit__name {
    margin: 0;
    font-weight: var(--fw-bold);
    color: var(--on-surface);
  }
  .kit__dl {
    margin: 0;
    display: flex;
    gap: var(--space-md);
  }
  .kit__dl a {
    min-height: 32px;
  }
</style>
