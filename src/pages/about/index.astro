---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Icon from '../../components/system/Icon.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Fact from '../../components/facts/Fact.astro';
import FactStat from '../../components/facts/FactStat.astro';
import StoryTimeline from '../../components/pages/about/StoryTimeline.astro';
import TeamCard from '../../components/pages/about/TeamCard.astro';
import PageNav from '../../components/pages/about/PageNav.astro';
import Stat from '../../components/system/Stat.astro';
import WorldStrip from '../../components/ui/WorldStrip.astro';
import { WORLD_STRIP } from '../../data/globalStrip';
import { fact } from '../../data/facts';
import { BIGD_FULL, IDENTITY, MICRO_COMMITMENT, RCT_HEADLINE, READ_THE_EVIDENCE, TRIAL_BAND_HEADING, spellOutBigd, withoutSince2014 } from '../../data/copy';
import { timeline } from '../../data/timeline';
import { ctaHref } from '../../lib/mailto';
import { linkAttrs } from '../../lib/url';
import { webPage } from '../../lib/schema';

const founders = (await getCollection('team', (e) => e.data.group === 'founders')).sort((a, b) => a.data.order - b.data.order);
// WP30b: a global organization (headquartered in New York, ID-11; work in 16 countries and territories, SC-03), not a Bangladesh one.
const countries = fact('SC-03').stat?.value;
// WP49 (cycle-24 review): "has trained and mentored ... across N countries and territories since 2014" (the count and the year are the register's, so the sentence reports a record, not a present-tense claim); 155 characters, the SEO limit.
// WP52 (cycle-27 review, GLM m4): the description names the group as ID-01 does ("educated, unemployed and underemployed youth") and keeps the register's year and count: "Since 2014, New York-headquartered CodersTrust has trained ... in 15 countries and
// territories." It is 153 characters; "and mentored" is out to make room within the 155 limit, which the guard below enforces.
// WP58 (cycle-30 reviews, Claude S1 d and GPT-6.1 Sol G1 i): the count is the countries and territories CodersTrust has worked in ("..., with work in N countries and territories."), not where the youth were trained (SC-16 and SC-03 say the same). The sentence is 11
// characters longer with "with work in", so "educated," is out to stay within the 155-character limit (the guard below): the group is "unemployed and underemployed youth", still ID-01's wording less its first adjective.
// WP61 (cycle-33 review, Kimi K2): the <title> is "About | CodersTrust" (it was "About Us | CodersTrust", which broke the "{Page} | CodersTrust" pattern the menu label and the other pages follow); the hero eyebrow "About Us" is unchanged.
// WP63 (cycle-35 review, Grok R6): "educated," is back, so the group is named as ID-01 names it ("educated, unemployed and underemployed youth"). It is ten characters longer, so "Since 2014," is out to stay within the 155-character limit (the guard below): 152 characters.
const description = `New York-headquartered CodersTrust has trained educated, unemployed and underemployed youth for digital work, with work in ${countries} countries and territories.`;
if (description.length > 155) throw new Error(`About meta description is ${description.length} characters (max 155)`);

// SC-01 (learners) and SC-02 (enrollments) sit side by side, so each tile names what it counts: learners trained, and course enrollments.
const sc02 = fact('SC-02');
const sc02Stat = sc02.stat!;
// WP65 (cycle-37 review, Sonnet, Grok): the tile is its number and label alone. Its detail line (WP50: "Including 111,268 direct enrollments and 40,043 through courseware.") is gone from About only;
// SC-02's register detail is unchanged, and Investors' tile still prints it (FactStat).
// WP64 (cycle-36 review, Grok): the two tiles sit side by side and neither the eyebrow ("At a Glance") nor the heading ("Where We Are Today") gives the period, so the learners tile keeps "since 2014" (SC-01's own label) and this tile drops it ("course enrollments"), said once.
// SC-02's label without " since 2014" is read from the register ("enrollments"). WP88 item 9: the "course" word is gone, so the tile reads "enrollments" as every other page does.
const sc02Label = withoutSince2014(sc02Stat.label);
// WP30e: the employment result in one sentence; the income detail is on the Independent Evaluation page.
// WP54 (cycle-28 review, GPT-6.1 Sol G8): this sentence is the page's one mention of the evaluator, so it is spelled out ("by the BRAC Institute of Governance and Development (BIGD)"); the register's headline says "by BIGD".
const trial = spellOutBigd(RCT_HEADLINE.text.split(/(?<=\.)\s+(?=[A-Z])/)[0]);
if (!/10\.3 percentage points more likely to be employed\.$/.test(trial)) throw new Error('About: RC-01 headline wording changed; update the trial line');
if (!trial.includes(BIGD_FULL)) throw new Error('About: the RC-01 headline no longer says "by BIGD"; update the expansion');

const principles = [
  {
    icon: 'target',
    title: 'Outcomes over Outputs',
    // WP43 (cycle-20 review): scoped to the youth-employment programs; "a program" also covered SuperKids and employer training, which the principle does not describe.
    text: 'We judge youth-employment programs by whether young people end up working and earning, not by how many attended.',
    link: { label: 'See the Outcomes', href: '/impact/' },
  },
  {
    icon: 'users',
    title: 'Inclusion by Design',
    // WP46 (cycle-22 review): scoped to the supported youth cohorts; "Programs" also covered the corporate, school and diploma programs, which the sentence does not describe.
    text: 'Supported youth cohorts are built so that people with fewer computer or English skills can still join, with women a priority in every group.',
    link: { label: 'How Our Model Works', href: '/our-model/' },
  },
  {
    icon: 'scale',
    title: 'Evidence Before Claims',
    text: 'We say what a randomized trial shows and what a survey only describes, and we keep the two apart.',
    link: { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' },
  },
  {
    icon: 'handshake',
    title: 'Partnership and Accountability',
    text: 'As agreed in the program scope, partners set the scorecard before the first cohort and receive monthly reports.',
    link: { label: 'Governance and Accountability', href: '/about/governance/' },
  },
];

const jsonLd = [
  webPage({
    path: '/about/',
    name: 'About CodersTrust',
    description,
    type: 'AboutPage',
    dateModified: '2026-10-29', // WP105: EDGE is expanded in the timeline entry
    breadcrumb: [{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }],
  }),
];
---

<BaseLayout title="About" description={description} breadcrumbs={[{ label: 'About' }]} jsonLd={jsonLd}>
  <Hero eyebrow="About Us" title="A Global Workforce Organization, Built on Evidence" lead={fact('ID-01').text} artSeed="about-codertrust">
    <!-- WP52 (cycle-27 review, Claude m10): where CodersTrust is based and how its entities relate (owner statement, ID-11) is the first thing under the lede, moved here from "Where We Are Today" (not repeated there).
         WP57b (cycle-29 review, GLM L8): the paragraph is ID-11 with its last sentence as "Additional country and regional offices are planned." (IDENTITY, src/data/copy.ts; the register's ID-11 adds "in the next few years") -->
    <div class="about-identity" data-hero-in><p class="fact" data-fact="ID-11">{IDENTITY.text}</p></div>
    <Fragment slot="actions">
      <a class="link" href={linkAttrs('/impact/').href}>See Our Impact<Icon name="arrow-right" size={16} /></a>
    </Fragment>
  </Hero>

  <!-- WP46 (cycle-22 review): the jump list is back under the hero (WP30e had cut it while the sub-pages and Impact kept theirs). Each label is the H2 it jumps to; the CTA band's id is its anchor.
       WP51 (cycle-26 review): the list had left out two existing H2s, "The People Who Started It" (#founders) and "Industry Recognition" (#recognition); it now links all eight, in page order. -->
  <PageNav links={[
    { label: 'Why We Exist', href: '#mission' },
    { label: 'Where We Are Today', href: '#glance' },
    { label: TRIAL_BAND_HEADING, href: '#proof' },
    { label: 'From a Copenhagen Launch to National Programs', href: '#story' },
    { label: 'The People Who Started It', href: '#founders' },
    { label: 'Four Principles Behind Every Program', href: '#how-we-work' },
    { label: 'Industry Recognition', href: '#recognition' },
    { label: 'Start a Conversation', href: '#about-cta' },
  ]} />

  <Section id="mission" tone="airy" aria-labelledby="mission-h">
    <SectionHeader id="mission-h" eyebrow="Mission and Vision" title="Why We Exist" />
    <div class="grid-cards grid-cards--2">
      <article class="card" data-reveal>
        <div class="card__body">
          <p class="eyebrow">Mission</p>
          <p class="about-statement"><Fact id="ID-04" /></p>
        </div>
      </article>
      <article class="card" data-reveal>
        <div class="card__body">
          <p class="eyebrow">Vision</p>
          <p class="about-statement"><Fact id="ID-05" /></p>
        </div>
      </article>
    </div>
  </Section>

  <Section id="glance" aria-labelledby="glance-h">
    <SectionHeader id="glance-h" eyebrow="At a Glance" title="Where We Are Today" />
    <!-- WP30b set where CodersTrust is based and how its entities relate (owner statement, ID-11) under these figures as a lead paragraph; WP52 (cycle-27 review) moved it to the hero, directly under the lede, so the figures stand alone here -->
    <!-- WP66 (owner request 2026-10-20): the SC-11 tile is the register's "70+" and label ("organizations with signed MOUs, agreements or contracts since 2014"; WP67 reworded it from "signed partnership agreements") with the register's detail line under it, the four categories (FactStat shows a fact's detail).
         Neither the eyebrow nor the heading gives the period, so the label keeps "since 2014": a count of signed agreements has to say since when, or it reads as partnerships that are active today. The tile is not beside SC-01's, the only other
         tile that says the period: the enrollments tile (SC-02), which is beside SC-01, drops it (WP64), and SC-02 and SC-03 sit between the two in the widest row. -->
    <div class="about-stats">
      <FactStat id="SC-01" />
      <div class="about-stats__tile" data-fact="SC-02"><Stat value={sc02Stat.value} label={sc02Label} count={sc02Stat.numeric !== undefined} /></div>
      {['SC-03', 'SC-11', 'SC-09'].map((id) => <FactStat id={id} />)}
    </div>
  </Section>

  <Section id="proof" tone="airy" aria-labelledby="proof-h">
    <SectionHeader id="proof-h" eyebrow="The Evidence" title={TRIAL_BAND_HEADING} />
    <p class="lead" data-fact="RC-01">{trial}</p>
    <p class="cluster">
      <a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>The Randomized Trial<Icon name="arrow-right" size={16} /></a>
      <a class="link" href={linkAttrs('/impact/outcomes-2026/').href}>Impact Survey 2026<Icon name="arrow-right" size={16} /></a>
    </p>
  </Section>

  <Section id="story" tone="ice" aria-labelledby="timeline-h">
    <SectionHeader id="timeline-h" eyebrow="Our Story" title="From a Copenhagen Launch to National Programs" />
    <StoryTimeline items={timeline} />
    <!-- WP55 (synthesis 3.1): the strip sits directly under the timeline, as a sub-heading of the Our Story band (an H3, so the jump list above keeps its eight H2s); its Copenhagen tile illustrates the 2014 entry. -->
    <div class="about-world"><WorldStrip tiles={WORLD_STRIP} level={3} id="world" /></div>
  </Section>

  <Section id="founders" aria-labelledby="founders-h">
    <SectionHeader id="founders-h" eyebrow="Founders" title="The People Who Started It" />
    <div class="grid-cards grid-cards--2 about-founders">
      {founders.map((p) => <TeamCard name={p.data.name} role={p.data.role} photo={p.data.photo} alt={p.data.photoAlt} assetId={`team-${p.id}`} href={`/about/team/${p.id}/`} />)}
    </div>
    <p class="about-more"><a class="link" href={linkAttrs('/about/team/').href}>Meet the Full Team<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <Section id="how-we-work" tone="airy" aria-labelledby="how-h">
    <SectionHeader id="how-h" eyebrow="How We Work" title="Four Principles Behind Every Program" />
    <div class="grid-cards grid-cards--2 grid-cards--stretch">
      {
        principles.map((p) => (
          <article class="card principle" data-reveal>
            <div class="card__body">
              <span class="principle__icon" aria-hidden="true"><Icon name={p.icon} size={24} /></span>
              <h3 class="card__title">{p.title}</h3>
              <p class="card__text">{p.text}</p>
              <a class="link principle__link" href={linkAttrs(p.link.href).href}>{p.link.label}<Icon name="arrow-right" size={16} /></a>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="recognition" tone="ice" aria-labelledby="rec-h">
    <SectionHeader id="rec-h" eyebrow="Recognition" title="Industry Recognition" />
    <div class="about-rec">
      <p class="lead" data-fact="PA-08">CodersTrust was listed in the HolonIQ South Asia EdTech 100 in 2023 (STEAM category) and 2024.</p>
      <!-- WP58 (cycle-30 review, Claude S9): the "As covered by" press line (WP55, synthesis 3.5) is no longer here: it was on Home, About and Recognition and Media. Home keeps it (HomeRecognition) and Recognition and Media keeps the full list, one link below. -->
      <a class="link" href={linkAttrs('/about/recognition/').href}>Recognition and Media<Icon name="arrow-right" size={16} /></a>
    </div>
  </Section>

  <CTABand
    id="about-cta"
    heading="Start a Conversation"
    text="Tell us your goals, and we will discuss the right partnership route."
    cta={{ label: 'Request a Discovery Session', href: ctaHref('discovery') }}
    secondary={{ label: READ_THE_EVIDENCE, href: '/impact/' }}
    micro={MICRO_COMMITMENT}
  />

</BaseLayout>

<style>
  /* WP52: the identity sentences (ID-11) sit directly under the hero's lede and are set like it: body-m, muted, the same measure as .hero__lead */
  .about-identity {
    max-width: 34em;
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
    color: var(--on-surface-variant);
  }
  .about-identity :global(p) {
    margin: 0;
  }
  .about-statement {
    margin: 0;
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    color: var(--on-surface);
  }
  /* Five figures: mobile 2 + 2 + 1; tablet 3 + 2; desktop 5 across. A short last row is centered under the full ones, never left with a hole beside it. */
  .about-stats {
    --cols: 2;
    --gap-x: var(--space-gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg) var(--gap-x);
  }
  /* FactStat's wrapper is display:contents, so the flex items are the .stat tiles themselves. */
  .about-stats__tile {
    display: contents;
  }
  .about-stats :global(.stat) {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap-x)) / var(--cols));
    min-width: 0;
  }
  @media (min-width: 768px) {
    .about-stats {
      --cols: 3;
    }
  }
  @media (min-width: 1100px) {
    .about-stats {
      --cols: 5;
    }
  }
  /* the two founder cards sit side by side across the band, each with the portrait beside its text (no empty right half) */
  @media (min-width: 640px) {
    .about-founders :global(.tc) {
      flex-direction: row;
    }
    .about-founders :global(.tc__photo) {
      flex: 0 0 38%;
      aspect-ratio: 4 / 5;
    }
    .about-founders :global(.tc .card__body) {
      justify-content: center;
    }
  }
  .about-more {
    margin: var(--space-lg) 0 0;
  }
  /* WP55: the strip sits one sub-section step (40px) under the last timeline entry */
  .about-world {
    margin-top: var(--space-xl);
  }
  .principle__icon {
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
  }
  .principle__link {
    margin-top: auto;
    align-self: flex-start;
  }
  .about-rec {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    max-width: var(--measure);
  }
  .about-rec > * {
    margin: 0;
  }
</style>
