---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Icon from '../../components/system/Icon.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Fact from '../../components/facts/Fact.astro';
import FactStat from '../../components/facts/FactStat.astro';
import StoryTimeline from '../../components/pages/about/StoryTimeline.astro';
import TeamCard from '../../components/pages/about/TeamCard.astro';
import PageNav from '../../components/pages/about/PageNav.astro';
import Stat from '../../components/system/Stat.astro';
import { fact } from '../../data/facts';
import { MICRO_COMMITMENT, RCT_HEADLINE, TRIAL_BAND_HEADING } from '../../data/copy';
import { timeline } from '../../data/timeline';
import { ctaHref } from '../../lib/mailto';
import { linkAttrs } from '../../lib/url';
import { webPage } from '../../lib/schema';

const founders = (await getCollection('team', (e) => e.data.group === 'founders')).sort((a, b) => a.data.order - b.data.order);
const since = fact('ID-02').stat?.value;
// WP30b: a global organization (headquartered in New York, ID-11; programs in 15 countries and territories, SC-03), not a Bangladesh one.
const countries = fact('SC-03').stat?.value;
// WP49 (cycle-24 review): "has trained and mentored ... across N countries and territories since 2014" (the count and the year are the register's, so the sentence reports a record, not a present-tense claim); 155 characters, the SEO limit.
const description = `Headquartered in New York, CodersTrust has trained and mentored educated, unemployed youth for digital work across ${countries} countries and territories since ${since}.`;
if (description.length > 155) throw new Error(`About meta description is ${description.length} characters (max 155)`);

// SC-01 (learners) and SC-02 (enrollments) sit side by side, so each tile names what it counts: learners trained, and course enrollments.
const sc02 = fact('SC-02');
const sc02Stat = sc02.stat!;
// WP50 (cycle-25 review): the tile keeps its number and label; its detail line is a sentence, "Including 111,268 direct enrollments and 40,043 through courseware." (it was "111,268 direct enrollments; 40,043 through courseware").
// Both figures are read from SC-02's text ("... 111,268 through direct training across 45 programs and 40,043 through CodersTrust courseware"), never typed here.
const sc02Direct = /([\d,]+) through direct training/.exec(sc02.text)?.[1];
const sc02Courseware = /([\d,]+) through CodersTrust courseware/.exec(sc02.text)?.[1];
if (!sc02Direct || !sc02Courseware) throw new Error('About: SC-02 no longer reads "N through direct training ... N through CodersTrust courseware"; update the enrollments tile');
const sc02Split = `Including ${sc02Direct} direct enrollments and ${sc02Courseware} through courseware.`;
// WP30e: the employment result in one sentence; the income detail is on the Independent Evaluation page.
const trial = RCT_HEADLINE.text.split(/(?<=\.)\s+(?=[A-Z])/)[0];
if (!/10\.3 percentage points more likely to be employed\.$/.test(trial)) throw new Error('About: RC-01 headline wording changed; update the trial line');

const principles = [
  {
    icon: 'target',
    title: 'Outcomes over Outputs',
    // WP43 (cycle-20 review): scoped to the youth-employment programs; "a program" also covered SuperKids and employer training, which the principle does not describe.
    text: 'We judge youth-employment programs by whether young people end up working and earning, not by how many attended.',
    link: { label: 'See the Outcomes', href: '/impact/' },
  },
  {
    icon: 'users',
    title: 'Inclusion by Design',
    // WP46 (cycle-22 review): scoped to the supported youth cohorts; "Programs" also covered the corporate, school and diploma programs, which the sentence does not describe.
    text: 'Supported youth cohorts are built so that people with fewer computer or English skills can still join, with women a priority in every group.',
    link: { label: 'How Our Model Works', href: '/our-model/' },
  },
  {
    icon: 'scale',
    title: 'Evidence Before Claims',
    text: 'We say what a randomized trial shows and what a survey only describes, and we keep the two apart.',
    link: { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' },
  },
  {
    icon: 'handshake',
    title: 'Partnership and Accountability',
    text: 'As agreed in the program scope, partners set the scorecard before the first cohort and receive monthly reports.',
    link: { label: 'Governance and Accountability', href: '/about/governance/' },
  },
];

const jsonLd = [
  webPage({
    path: '/about/',
    name: 'About CodersTrust',
    description,
    type: 'AboutPage',
    breadcrumb: [{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }],
  }),
];
---

<BaseLayout title="About Us" description={description} breadcrumbs={[{ label: 'About' }]} jsonLd={jsonLd}>
  <Hero eyebrow="About Us" title="A Global Workforce Organization, Built on Evidence" lead={fact('ID-01').text} artSeed="about-codertrust">
    <Fragment slot="actions">
      <a class="link" href={linkAttrs('/impact/').href}>See Our Impact<Icon name="arrow-right" size={16} /></a>
    </Fragment>
  </Hero>

  <!-- WP46 (cycle-22 review): the jump list is back under the hero (WP30e had cut it while the sub-pages and Impact kept theirs). Each label is the H2 it jumps to; the CTA band's id is its anchor.
       WP51 (cycle-26 review): the list had left out two existing H2s, "The People Who Started It" (#founders) and "Industry Recognition" (#recognition); it now links all eight, in page order. -->
  <PageNav links={[
    { label: 'Why We Exist', href: '#mission' },
    { label: 'Where We Are Today', href: '#glance' },
    { label: TRIAL_BAND_HEADING, href: '#proof' },
    { label: 'From a Copenhagen Launch to National Programs', href: '#story' },
    { label: 'The People Who Started It', href: '#founders' },
    { label: 'Four Principles Behind Every Program', href: '#how-we-work' },
    { label: 'Industry Recognition', href: '#recognition' },
    { label: 'Talk to the Team', href: '#about-cta' },
  ]} />

  <Section id="mission" tone="airy" aria-labelledby="mission-h">
    <SectionHeader id="mission-h" eyebrow="Mission and Vision" title="Why We Exist" />
    <div class="grid-cards grid-cards--2">
      <article class="card" data-reveal>
        <div class="card__body">
          <p class="eyebrow">Mission</p>
          <p class="about-statement"><Fact id="ID-04" /></p>
        </div>
      </article>
      <article class="card" data-reveal>
        <div class="card__body">
          <p class="eyebrow">Vision</p>
          <p class="about-statement"><Fact id="ID-05" /></p>
        </div>
      </article>
    </div>
  </Section>

  <Section id="glance" aria-labelledby="glance-h">
    <SectionHeader id="glance-h" eyebrow="At a Glance" title="Where We Are Today" />
    <!-- WP30b: where CodersTrust is based and how its entities relate (owner statement, ID-11), as the design system's lead paragraph (body-l, left-aligned) under the figures, spaced by the stack utility -->
    <div class="stack stack--lg">
      <div class="about-stats">
        <FactStat id="SC-01" />
        <div class="about-stats__tile" data-fact="SC-02"><Stat value={sc02Stat.value} label="course enrollments since 2014" note={sc02Split} count={sc02Stat.numeric !== undefined} /></div>
        {['SC-03', 'SC-11', 'SC-09'].map((id) => <FactStat id={id} />)}
      </div>
      <Fact id="ID-11" as="p" class="lead" />
    </div>
  </Section>

  <Section id="proof" tone="airy" aria-labelledby="proof-h">
    <SectionHeader id="proof-h" eyebrow="The Evidence" title={TRIAL_BAND_HEADING} />
    <p class="lead" data-fact="RC-01">{trial}</p>
    <p class="cluster">
      <a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>The Randomized Trial<Icon name="arrow-right" size={16} /></a>
      <a class="link" href={linkAttrs('/impact/outcomes-2026/').href}>Impact Survey 2026<Icon name="arrow-right" size={16} /></a>
    </p>
  </Section>

  <Section id="story" tone="ice" aria-labelledby="timeline-h">
    <SectionHeader id="timeline-h" eyebrow="Our Story" title="From a Copenhagen Launch to National Programs" />
    <StoryTimeline items={timeline} />
  </Section>

  <Section id="founders" aria-labelledby="founders-h">
    <SectionHeader id="founders-h" eyebrow="Founders" title="The People Who Started It" />
    <div class="grid-cards grid-cards--2 about-founders">
      {founders.map((p) => <TeamCard name={p.data.name} role={p.data.role} photo={p.data.photo} alt={p.data.photoAlt} assetId={`team-${p.id}`} href={`/about/team/${p.id}/`} />)}
    </div>
    <p class="about-more"><a class="link" href={linkAttrs('/about/team/').href}>Meet the Full Team<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <Section id="how-we-work" tone="airy" aria-labelledby="how-h">
    <SectionHeader id="how-h" eyebrow="How We Work" title="Four Principles Behind Every Program" />
    <div class="grid-cards grid-cards--2 grid-cards--stretch">
      {
        principles.map((p) => (
          <article class="card principle" data-reveal>
            <div class="card__body">
              <span class="principle__icon" aria-hidden="true"><Icon name={p.icon} size={24} /></span>
              <h3 class="card__title">{p.title}</h3>
              <p class="card__text">{p.text}</p>
              <a class="link principle__link" href={linkAttrs(p.link.href).href}>{p.link.label}<Icon name="arrow-right" size={16} /></a>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="recognition" tone="ice" aria-labelledby="rec-h">
    <SectionHeader id="rec-h" eyebrow="Recognition" title="Industry Recognition" />
    <div class="about-rec">
      <p class="lead" data-fact="PA-08">CodersTrust was listed in the HolonIQ South Asia EdTech 100 in 2023 (STEAM category) and 2024.</p>
      <a class="link" href={linkAttrs('/about/recognition/').href}>Recognition and Media<Icon name="arrow-right" size={16} /></a>
    </div>
  </Section>

  <CTABand
    id="about-cta"
    heading="Talk to the Team"
    text="Tell us your goals, and we will discuss the right partnership route."
    cta={{ label: 'Request a Discovery Session', href: ctaHref('discovery') }}
    secondary={{ label: 'Read the evidence', href: '/impact/' }}
    micro={MICRO_COMMITMENT}
  />

</BaseLayout>

<style>
  .about-statement {
    margin: 0;
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    color: var(--on-surface);
  }
  /* Five figures: mobile 2 + 2 + 1; tablet 3 + 2; desktop 5 across. A short last row is centered under the full ones, never left with a hole beside it. */
  .about-stats {
    --cols: 2;
    --gap-x: var(--space-gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg) var(--gap-x);
  }
  /* FactStat's wrapper is display:contents, so the flex items are the .stat tiles themselves. */
  .about-stats__tile {
    display: contents;
  }
  .about-stats :global(.stat) {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap-x)) / var(--cols));
    min-width: 0;
  }
  @media (min-width: 768px) {
    .about-stats {
      --cols: 3;
    }
  }
  @media (min-width: 1100px) {
    .about-stats {
      --cols: 5;
    }
  }
  /* the two founder cards sit side by side across the band, each with the portrait beside its text (no empty right half) */
  @media (min-width: 640px) {
    .about-founders :global(.tc) {
      flex-direction: row;
    }
    .about-founders :global(.tc__photo) {
      flex: 0 0 38%;
      aspect-ratio: 4 / 5;
    }
    .about-founders :global(.tc .card__body) {
      justify-content: center;
    }
  }
  .about-more {
    margin: var(--space-lg) 0 0;
  }
  .principle__icon {
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
  }
  .principle__link {
    margin-top: auto;
    align-self: flex-start;
  }
  .about-rec {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    max-width: var(--measure);
  }
  .about-rec > * {
    margin: 0;
  }
</style>
