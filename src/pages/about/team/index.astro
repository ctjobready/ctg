---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import PageNav from '../../../components/pages/about/PageNav.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import { ctaHref } from '../../../lib/mailto';
import TeamCard from '../../../components/pages/about/TeamCard.astro';
import { webPage, pageUrl } from '../../../lib/schema';
import { url } from '../../../lib/url';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
// No lead line for the advisors: what they do and how they are kept apart from procurement stays unpublished until
// confirm-list item #24 closes (register R8-M1). The cards keep their names and titles.
const groups = [
  { key: 'founders', title: 'Founders and Chair', lead: undefined },
  { key: 'advisors', title: 'Advisors', lead: undefined },
  { key: 'executive', title: 'Executive Team', lead: undefined },
  { key: 'management', title: 'Bangladesh Leadership', lead: undefined },
] as const;
/**
 * WP166-A (marketing review R1-31, owner approval of 21 November 2026): an executive's card shows the one credential that persuades, in place of three skill tags (the tags stay on the profile). Each line is the person's
 * own profile (src/content/team), word for word or shortened: Md. Shamsul Haque's post, Mahdee Zaman's AWS role, Shafqat Ullah's experience and degree, Asad Zaman's UNDP years, Rezaul Karim Khan's experience and AWS certification.
 */
const CREDENTIALS: Record<string, string> = {
  'shamsul-haque': 'Former Additional Secretary, Ministry of Foreign Affairs of Bangladesh',
  'mahdee-zaman': 'Led solutions architecture teams at Amazon Web Services',
  'shafqat-ullah': 'Software architect with 25+ years of experience; computer science graduate of the Indian Institute of Technology (IIT)',
  'asad-zaman': '20+ years of experience, including 14 years at UNDP',
  'rezaul-karim-khan': '20+ years in global ICT projects and startups; AWS Certified Solutions Architect - Associate',
};
// WP166-A (R1-30): the lead gives the reasons to trust the team (the careers and posts its leaders and advisors held, from their profiles), where it listed the page's sections.
const lead = 'Leaders with careers at UNDP, Amazon Web Services and Bangladesh’s Ministry of Foreign Affairs, advised by a former Principal Secretary and a former Executive Chairman of the National Skills Development Authority.';
const description = 'Meet the founders, advisors, executive team and Bangladesh leadership of CodersTrust, the workforce-development organization behind the JobReady platform.';
const jsonLd = [
  {
    ...webPage({ path: '/about/team/', name: 'Leadership and Team', description, type: 'CollectionPage', breadcrumb: [{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }, { name: 'Team', path: '/about/team/' }] }),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: team.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: pageUrl(`/about/team/${p.id}/`), name: p.data.name })),
    },
  },
];
---

<BaseLayout title="Leadership and Team" description={description} breadcrumbs={[{ label: 'About', href: '/about/' }, { label: 'Team' }]} jsonLd={jsonLd}>
  <Hero eyebrow="About Us" title="The Team Behind CodersTrust" lead={lead} art={false} />
  <PageNav links={[...groups.map((g) => ({ label: g.title, href: `#${g.key}` })), { label: 'Talk to the Team', href: '#team-cta' }]} />
  {
    groups.map((g, i) => {
      const people = team.filter((p) => p.data.group === g.key);
      // Rows come out even: 5 people are 3 + 2 (centered), never 4 + 1. perRow(n, max) = ceil(n / ceil(n / max)).
      const perRow = (max: number) => Math.max(1, Math.ceil(people.length / Math.ceil(people.length / max)));
      return (
        <Section id={g.key} tone={i % 2 ? 'airy' : 'white'} aria-labelledby={`${g.key}-h`}>
          <SectionHeader id={`${g.key}-h`} title={g.title} lead={g.lead} />
          <div class="team-grid" style={`--cols-md:${perRow(3)};--cols-lg:${perRow(4)}`}>
            {people.map((p) => (
              <div class="team-cell">
                <TeamCard name={p.data.name} role={p.data.role} photo={p.data.photo} alt={p.data.photoAlt} assetId={`team-${p.id}`} href={`/about/team/${p.id}/`} expertise={CREDENTIALS[p.id] ? [] : p.data.expertise} chips={3} credential={CREDENTIALS[p.id]} />
              </div>
            ))}
          </div>
        </Section>
      );
    })
  }
  <Section pad="sm" aria-label="Governance link">
    <p class="team-gov">Interested in joining the team? <a class="link" href={url('/careers/')}>Explore Careers</a>.</p>
  </Section>
  <CTABand
    id="team-cta"
    heading="Talk to the Team"
    text="Tell us your goals and two suitable times, and we will discuss the right partnership route."
    cta={{ label: 'Request a Discovery Session', href: ctaHref('discovery') }}
  />
</BaseLayout>

<style>
  .team-gov {
    margin: 0;
  }
  /* One column on a phone; from 768 px rows of up to 3, from 1024 px up to 4, balanced and centered (the last row is centered, not left-stranded). */
  .team-grid {
    --cols: 1;
    --gap: var(--space-gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
  }
  .team-cell {
    flex: 0 1 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    max-width: 320px;
    min-width: 0;
    display: flex;
  }
  .team-cell > :global(.card) {
    width: 100%;
  }
  @media (max-width: 767px) {
    .team-cell {
      flex-basis: 100%;
      max-width: 420px;
    }
  }
  @media (min-width: 768px) {
    .team-grid {
      --cols: var(--cols-md);
    }
  }
  @media (min-width: 1024px) {
    .team-grid {
      --cols: var(--cols-lg);
    }
  }
</style>
