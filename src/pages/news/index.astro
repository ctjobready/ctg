---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Img from '../../components/ui/Img.astro';
import HeroArt from '../../components/ui/HeroArt.astro';
import Badge from '../../components/system/Badge.astro';
import Icon from '../../components/system/Icon.astro';
import NewsGrid from '../../components/pages/news/NewsGrid.astro';
import NewsCard from '../../components/ui/NewsCard.astro';
import CTABand from '../../components/ui/CTABand.astro';
import { hasLiveBlogPosts } from '../../components/pages/blog/blog';
import { allNews, coverAlt, featuredNews, newsHref, NEWS_CTA, TOPICS } from '../../components/pages/news/news';
import { curlyApostrophes, formatDate, isoDate } from '../../lib/format';
import { pageUrl, webPage } from '../../lib/schema';
import { mayRender } from '../../lib/permissions';
import { url } from '../../lib/url';
import { ctaHref } from '../../lib/mailto';
import { CTAS } from '../../data/ctas';

const posts = await allNews();
const blogLive = await hasLiveBlogPosts();
const latest = posts[0];
// D13: the featured cover carries the same asset ID as on its card and article (news-<slug>); staging swaps in the illustration when the gate says so.
const latestAsset = `news-${latest.id}`;
const showLatestCover = Boolean(latest.data.cover) && mayRender(latestAsset);
// WP166-C (R5-01): four proof stories above the dated list (FEATURED_NEWS, news.ts); the dated list below is unchanged and still opens on "Latest".
const featured = featuredNews(posts);
// WP166-C (R5-02): the index ends on the general band the posts carry (NEWS_CTA.general), word for word, instead of dropping into the footer.
const closing = NEWS_CTA.general;
const closingCta = { label: CTAS[closing.cta].label, href: ctaHref(closing.cta) };
// WP166-C (R5-06, R5-07): a headline and lead that say what the archive holds; the two dating notes are one note under "Browse by Topic".
const description = 'CodersTrust news since 2014: government contracts, partnerships and MOUs, recognition and program events.';
const jsonLd = [
  {
    ...webPage({ path: '/news/', name: 'News', description, type: 'CollectionPage', breadcrumb: [{ name: 'Home', path: '/' }, { name: 'News', path: '/news/' }] }),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: pageUrl(newsHref(p)), name: p.data.title })),
    },
  },
];
---

<BaseLayout
  title="News: Partnerships, Recognition and Events"
  description={description}
  breadcrumbs={[{ label: 'News' }]}
  jsonLd={jsonLd}
>
  <Hero eyebrow="Newsroom" title="Contracts, Partnerships and Recognition Since 2014" lead="Government contracts, partnerships and MOUs, recognition and program events, from the 2014 launch in Copenhagen to this year." art={false}>
    {/* WP167 (owner approval of 2026-11-23, marketing review R7-16): the header carries one "News and Blog" item that opens here, so the Blog is one click from this page. */}
    {blogLive && <Fragment slot="actions"><a class="link" href={url('/blog/')}>Read the Blog: Essays by Aziz Ahmad<Icon name="arrow-right" size={16} /></a></Fragment>}
  </Hero>

  <Section id="featured" aria-labelledby="featured-h">
    <SectionHeader id="featured-h" title="Featured" />
    <div class="grid-cards">
      {featured.map((p) => <NewsCard title={p.data.title} date={p.data.date} topic={TOPICS[p.data.topic]} excerpt={p.data.excerpt} image={p.data.cover} imageAlt={coverAlt(p.data.coverAlt)} href={newsHref(p)} />)}
    </div>
  </Section>

  <Section id="archive" aria-labelledby="archive-h">
    <SectionHeader id="archive-h" eyebrow="All News" title="Browse by Topic" lead="Posts carry their publication date; posts written later from dated sources carry the event date. Older posts are lightly edited from the original, and each carries the dates its titles, offices and figures reflect." />
    <!-- The most recent post is the first, full-width item of the same list, so the topic counts cover every post and the filter applies to it too. -->
    <NewsGrid posts={posts}>
      <article slot="featured" class="feat card card--link" data-reveal>
        <div class="feat__media card__media">
          {showLatestCover && latest.data.cover ? <Img src={latest.data.cover} alt={coverAlt(latest.data.coverAlt)} width={900} height={600} widths={[480, 900]} sizes="(min-width:1024px) 560px, 100vw" loading="eager" assetId={latestAsset} /> : <HeroArt seed={latest.data.title} shape="card" />}
        </div>
        <div class="card__body feat__body">
          <p class="card__meta feat__meta">
            <Badge tone="eyebrow">Latest</Badge>{' '}
            <time datetime={isoDate(latest.data.date)}>{formatDate(latest.data.date)}</time>{' '}
            <Badge tone="brand">{TOPICS[latest.data.topic]}</Badge>
          </p>
          <h3 class="card__title feat__title"><a class="card__link" href={url(newsHref(latest))}>{curlyApostrophes(latest.data.title)}</a></h3>
          <p class="card__text">{curlyApostrophes(latest.data.excerpt)}</p>
          <span class="card__more" aria-hidden="true">Read More<span class="sr-only">: {latest.data.title}</span><Icon name="arrow-right" size={16} /></span>
        </div>
      </article>
    </NewsGrid>
  </Section>

  <CTABand id="cta" heading={closing.heading} text={closing.text} cta={closingCta} secondary={closing.offer} />
</BaseLayout>

<style>
  .feat {
    display: grid;
    height: auto;
  }
  .feat__media {
    aspect-ratio: 3 / 2;
  }
  .feat__body > * {
    margin: 0;
  }
  .feat__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }
  .feat__title {
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
  }
  @media (min-width: 900px) {
    .feat {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
    .feat__media {
      aspect-ratio: auto;
      min-height: 320px;
    }
    .feat__body {
      justify-content: center;
      padding: var(--space-lg);
    }
  }
</style>
