---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import ArticleShell from '../../components/pages/news/ArticleShell.astro';
import NewsCard from '../../components/ui/NewsCard.astro';
import Img from '../../components/ui/Img.astro';
import { allNews, newsHref, ogImageAlt, relatedNews, TOPICS, coverAlt, coverDuplicatesBody, coverRepeat } from '../../components/pages/news/news';
import { mayRender } from '../../lib/permissions';
import { stripBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await allNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const topic = TOPICS[d.topic];
// D13: one asset per post, news-<slug>, for the cover (hero, social image) and the photos in the body (tagged by
// rehypeNewsPhotos in astro.config.mjs). Staging drops a cover the gate does not allow; the branded section card stands in.
const asset = `news-${post.id}`;
const cover = d.cover && mayRender(asset) ? d.cover : undefined;
// First body image = the cover photo: it is shown once, as the hero (with the caption it had in the body), and the body drops it.
// A cover that only turns up later in the body keeps the older rule: no hero, the body shows it.
const repeat = coverRepeat(post);
const showHero = cover && (repeat.repeats || !coverDuplicatesBody(post));
const og = cover ? await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;
const related = relatedNews(all, post);
---

<ArticleShell
  headline={d.title}
  seoTitle={d.seoTitle}
  description={d.excerpt}
  path={`/news/${post.id}/`}
  date={d.date}
  updated={d.updated}
  topic={topic}
  image={og ? stripBase(og.src) : undefined}
  imageAlt={og ? ogImageAlt(d.coverAlt, d.title) : undefined}
  imageAsset={og ? asset : undefined}
  heroCaption={showHero && repeat.repeats ? repeat.caption : undefined}
>
  {showHero && cover && <Img slot="hero" src={cover} alt={coverAlt(d.coverAlt)} width={1100} widths={[640, 1100]} sizes="(min-width:1024px) 800px, 100vw" loading="eager" fetchpriority="high" assetId={asset} />}
  <Content />
  <Fragment slot="related">
    {
      related.map((p) => (
        <NewsCard title={p.data.title} date={p.data.date} topic={TOPICS[p.data.topic]} excerpt={p.data.excerpt} image={p.data.cover} imageAlt={coverAlt(p.data.coverAlt)} href={newsHref(p)} />
      ))
    }
  </Fragment>
</ArticleShell>
