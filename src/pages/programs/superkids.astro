---
// P14 — SuperKids /programs/superkids/ (T3 conversion page; derived from matrix 4.5 for schools and partners).
// Only registered facts are used (GV-08 agreements and targets, never delivered reach). Content the spec marks
// "to confirm with CodersTrust" is written as non-claim copy or omitted (see the page report): C3, C8 and C10.
// Declared compression (doc 06 P14, round 9 Mi3): no separate C3 band, and (WP30d, owner direction 2026-10-14: less is more) no In Short, definition, problem, "what your school
// receives" or separate partner band either: the hero lead, the glance table and the three course vignettes already say it. Robi (PA-03, per doc 06 P14) is no longer named on the page (a one-line partner sentence is not decision information);
// the general government logo strip stays out, because its logos are CodersTrust-wide relationships, not SuperKids partners.
// The C6 positioning statement (POSITIONING.superkids) has no "unlike … we …" clause: it states only what GV-08 registers.
// WP42 (cycle-19 review): it is two plain sentences: "SuperKids offers block coding, robotics and digital art through schools and education partners. DoICT and NCTB agreements set targets, not delivered reach." (the agreements block below says it in full).
import LandingLayout from '../../layouts/LandingLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Icon from '../../components/system/Icon.astro';
import HeroBand from '../../components/sections/HeroBand.astro';
import FutureBand from '../../components/sections/FutureBand.astro';
import FeatureCard from '../../components/ui/FeatureCard.astro';
import { futurePhotos, galleryPhotos } from '../../data/photos';
import GalleryDisclosure from '../../components/pages/programs/GalleryDisclosure.astro';
import StatusTag from '../../components/system/StatusTag.astro';
import Fact from '../../components/facts/Fact.astro';
import MechanismSection from '../../components/pages/programs/MechanismSection.astro';
import FaqSection from '../../components/pages/programs/FaqSection.astro';
import OfferSection from '../../components/pages/programs/OfferSection.astro';
import NextSteps from '../../components/pages/programs/NextSteps.astro';
import ProgramGlance from '../../components/pages/programs/ProgramGlance.astro';
import { fact } from '../../data/facts';
import { faqNode, type FaqSource } from '../../components/pages/programs/faq';
import { C14_FIRST, ctaFor, serviceNode } from '../../components/pages/programs/meta';
import { MICRO_COMMITMENT, POSITIONING, PRICING } from '../../data/copy';
import { COURSES_URL } from '../../lib/site';
import { formatDate, isoDate } from '../../lib/format';
import { webPage } from '../../lib/schema';
import { linkAttrs } from '../../lib/url';

const path = '/programs/superkids/';
const LAST_UPDATED = '2026-11-21'; // WP166-B (marketing review R2, owner approval of 21 November 2026): the parents' link in the hero, the shorter glance rows, the "The Program" band cut, the agreements as two lines under "Agreement Targets", the cost question in the FAQ and the gallery before the start band. Earlier: WP161 (owner answer 2026-11-02: SuperKids@School for schools and SuperKids courses for families; A-40: no template photo note). Earlier: WP157 (owner decision 2026-11-02: the four learner portraits are captioned "SuperKids learner", with no first names). Earlier: WP143: the glance row with the repeated 400+ figure is gone. WP129 (owner rule 2026-10-31: any change to visible text moves the date, copy edits included): the serial-comma, semicolon and copy edits of WP126 to WP128 and the WP129 edits. Earlier: WP104: the gallery's consent line was added. WP36: the cycle-13 wording changes (the two agreement targets, the safeguarding answer); WP20c had 2026-10-14 (PAGE_UPDATED.superkids is 2026-10-10)
const title = 'SuperKids: STEAM, Coding and Robotics';
// WP161 (WP160-B, owner answer 2026-11-02: "SuperKids D2C offer is for parents to enroll their kids. SuperKids@School is the B2B2C program with schools."): the meta description names both offers, in plain words (never "D2C" or "B2B2C").
const description = 'SuperKids brings STEAM, coding and robotics to young learners in schools and in courses for families on JobReady.global. 400+ learners since 2021.';
const inquiry = ctaFor('superkids');
const pricingFirst = PRICING.text.split('. ')[0] + '.';

// GV-08 in three sentences, built from the register's own wording so no figure is typed here: the DoICT agreement, the NCTB agreement,
// and the plain statement that these are agreement targets, not delivered reach.
// WP36 (cycle-13 review): the register gives two separate targets, each "20M+ students" (the DoICT agreement's "target reach 20M+ students through 9,000+ digital labs" and the NCTB agreement's
// "competency-based experiential learning for 20M+ students"); it does not say they are the same students, so each is labeled with its own agreement and neither reads as a total.
const gv08 = fact('GV-08').text.match(/agreements with DoICT \(([^;]+); target reach ([^)]+)\) and NCTB \(([^)]+?) for ([^)]+)\)/);
if (!gv08) throw new Error('GV-08 wording changed: update the SuperKids agreement sentences');
// WP64 (cycle-36 review, Kimi): the labs figure says where the labs are, "... through 9,000+ digital labs in Bangladesh", as GV-09 ("9,000+ government digital labs in Bangladesh") and the YouthWIDE and Local Partners tiles do (the page's visible text named no country).
// The agreement's party, DoICT, is named on the line itself ("DoICT agreement target"), so the line names its source already.
if (!gv08[2].endsWith('9,000+ digital labs') || !fact('GV-09').text.startsWith('9,000+ government digital labs in Bangladesh')) throw new Error('SuperKids: GV-08 no longer ends its DoICT target "... 9,000+ digital labs", or GV-09 no longer places the labs in Bangladesh; update the DoICT target line');
const doictReach = `${gv08[2]} in Bangladesh`;
const nctbReach = gv08[4];
// WP166-B (R2-29): each agreement's scope, from GV-08's own words, opens its line (the two "Agreement" cards that said them are folded in).
const doictScope = gv08[1];
const nctbScope = gv08[3].replace(/^C/, 'c');

// Only the safeguarding question (Q9) applies to SuperKids: Q1 ("Will this work in our country?") answers with the adult course menu
// and Q8 ("What does it cost?") with the adult program inclusions, and neither describes a K-12 program. Pricing is covered in C11.
// WP36 (cycle-13 review): the one-line safeguarding answer with a link to the governance page, which keeps the full account (the hub FAQ has the full Q9).
// WP166-B (marketing review R2-30): a principal's cost question is answered in the FAQ, with the one pricing sentence the start band printed (PRICING's first sentence; the adult inclusions of Q8 still do not apply here).
const faqSources: FaqSource[] = [
  { audience: 'variants' as const, id: 'Q9-route' },
  { q: 'What Does It Cost?', html: pricingFirst, evidence: ['PD-02'] },
];

const jsonLd = [
  webPage({ path, name: 'SuperKids', description, dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path: '/programs/' }, { name: 'SuperKids', path }] }),
  serviceNode({ path, name: 'SuperKids', description: 'STEAM, robotics, coding and digital art for young learners, offered through schools and education partners (SuperKids@School) and as courses for families on JobReady.global.', audience: 'Schools, Education Partners and Parents', areaServed: ['Bangladesh'] }),
  faqNode(faqSources, path),
];
const courses = linkAttrs(COURSES_URL);
---

<LandingLayout title={title} description={description} path={path} breadcrumbs={[{ label: 'Programs', href: '/programs/' }, { label: 'SuperKids' }]} jsonLd={jsonLd} stickyCta={inquiry}>
  <!-- WP166-B (marketing review R2-27): the hero tells parents they can enroll, so it gives them the link (a text link under the one button, as on JobReady@Work). -->
  <!-- C1. WP161 (WP160-B, owner answer 2026-11-02): the eyebrow and the lead name both offers, SuperKids@School for schools and SuperKids courses that parents buy on JobReady.global (two sentences: ", and parents ..." after a series reads as a serial comma to tests/wp127); the discovery session is in the SuperKids@School card below. -->
  <HeroBand
    audience="SuperKids · For Schools, Education Partners and Families"
    title="Bring Coding, Robotics and Digital Art into Your Classroom"
    lead="SuperKids@School brings block coding, robotics and graphic design for kids into schools. Parents can enroll their children in SuperKids courses on JobReady.global."
    cta={inquiry}
    routeLinks={[{ label: 'Parents: Explore SuperKids Courses at JobReady.global', href: COURSES_URL }]}
    artSeed="superkids"
  />

  <ProgramGlance
    title="SuperKids at a Glance"
    rows={[
      // WP166-B (marketing review R2-27): shorter rows (the course list is in the hero and the two offer cards; "details below" is gone). The 400+ figure stays once on the page, in "Delivery and Agreements" (WP143), so no "Delivered" row is added here.
      { label: 'Who It Is For', text: 'Schools and education partners that want young learners to build digital skills early.' },
      { label: 'Agreements', text: 'Department of ICT (DoICT) and National Curriculum and Textbook Board (NCTB).', facts: ['GV-08'] },
    ]}
  />

  <!-- WP161 (WP160-B): the two offers, one card each. The course names are the storefront's own (jobready.global, SuperKids STEAM section, checked 2026-11-03: "Introduction to Robotics (On-Campus Course)",
       "Graphics Design for Kids (Live Online Course)", "Fundamentals of Block Coding (Live Online Course)"). The school route (discovery session, agreements, safeguarding, the CTA) is unchanged. -->
  <Section id="two-ways" aria-labelledby="two-ways-h">
    <SectionHeader id="two-ways-h" eyebrow="Schools and Families" title="Two Ways to Join SuperKids" />
    <ul class="grid-cards grid-cards--stretch" role="list">
      <li>
        <FeatureCard icon="school" title="SuperKids@School" text="For schools and education partners: block coding, robotics and graphic design for kids in your classrooms, with courses shaped with you in a discovery session." />
      </li>
      <li>
        <FeatureCard icon="users" title="SuperKids Courses for Families" text="Parents can enroll their children in SuperKids courses on JobReady.global, including Introduction to Robotics on campus and Graphics Design for Kids and Fundamentals of Block Coding online.">
          <p class="two-ways__link"><a class="link" href={courses.href} rel={courses.rel}>Explore SuperKids Courses at JobReady.global<Icon name="arrow-up-right" size={16} /><span class="sr-only"> {courses.srText}</span></a></p>
        </FeatureCard>
      </li>
    </ul>
  </Section>

  <!-- C4 (C2 and C3 omitted: the hero already says why digital skills start early, and no register fact supports a cost-of-late-exposure statement). WP161 (A-40): no template photo note; the lead says the photographs are SuperKids' own. -->
  <FutureBand
    photos={futurePhotos('superkids')}
    note={false}
    title="A Classroom with Coding, Robotics and Digital Art"
    lead="Photographs from SuperKids workshops, events and school partnerships."
    vignettes={[
      { kind: 'Block Coding', title: 'Learners Build with Blocks', text: 'Visual coding with blocks is a first step into programming.' },
      { kind: 'Robotics', title: 'Ideas Become Things That Move', text: 'Learners design and program simple robots.' },
      { kind: 'Digital Art', title: 'Creativity Meets Technology', text: 'Graphic design for kids brings art into the digital classroom.' },
    ]}
  />

  <!-- C6 (the positioning statement opens the band; scripts/check-facts.mjs [POSITION] requires the band on this page). WP166-B (marketing review R2-28): the band is the statement alone; its line "Looking for a SuperKids course for your own child,
       or courses for older learners? Explore Courses at JobReady.global" is gone (the hero and the families card carry that link). The reviewer's cut of the whole band is not applied, because the gate needs it. -->
  <MechanismSection title="A School STEAM Program for Young Learners" positioning={POSITIONING.superkids} eyebrow="The Program" />

  <!-- C7: agreements and targets only -->
  <Section id="agreements" tone="airy" aria-labelledby="agreements-h">
    <SectionHeader id="agreements-h" eyebrow="What Is in Place" title="Delivery and Agreements" />
    <div class="agree">
      <h3 class="agree__h t-heading-xl" data-reveal>Delivered</h3>
      <div class="agree__delivered" data-reveal data-fact="SK-05"><StatusTag status="Delivered" /><p class="agree__num"><Fact id="SK-05" /></p></div>
      <!-- WP166-B (marketing review R2-29): headed "Agreement Targets" (it said "Agreed, Not Delivered", a heading about what has not been done); each agreement is one line, its scope and its target (GV-08's words), and the caveat is said once. -->
      <h3 class="agree__h agree__h--apart t-heading-xl" data-reveal>Agreement Targets</h3>
      <div class="agree__fact" data-reveal data-fact="GV-08">
        <p><strong>DoICT agreement</strong>, {doictScope}: target of {doictReach}.</p>
        <p><strong>NCTB agreement</strong>, {nctbScope}: target of {nctbReach}.</p>
        <p>These are agreement targets, not delivered reach.</p>
      </div>
    </div>
  </Section>

  <!-- C9 -->
  <FaqSection sources={faqSources} title="Questions Schools and Partners Ask" />

  <!-- WP166-B (marketing review R2-28): the gallery comes before the start band, so the three things to bring are followed directly by the button. -->
  <GalleryDisclosure id="in-the-field" eyebrow="In the Field" title="Inside SuperKids Classrooms and Events" lead="Workshops, certificate ceremonies and school agreements, in photographs." note="Photographs are used with the consent of those pictured or their guardians." photos={galleryPhotos('superkids')} visible={4} />

  <!-- C11. WP166-B (marketing review R2-30): headed "Three Things to Bring to the Discovery Session" (it said "Options Are Shaped with You in a Discovery Session", with the lead "Bring these three things to the conversation.", which the heading now says);
       the pricing sentence is the FAQ's cost answer. -->
  <OfferSection
    title="Three Things to Bring to the Discovery Session"
    cards={[
      { icon: 'school', title: 'Your School or Organization', text: 'Location, age groups and the approximate number of learners.' },
      { icon: 'target', title: 'Your Goals', text: 'Which of STEAM, coding, robotics and digital art you want to start with.' },
      { icon: 'calendar-check', title: 'Your Timeline', text: 'When you would like to begin.' },
    ]}
  />


  <!-- C12 (risk reversal) is the micro-commitment line under the C13 button. Safeguarding is stated once on this page, in the FAQ answer
       above (Q9); the former "Safeguarding Is Agreed Before Enrollment" card repeated it word for word. -->

  <!-- C13 -->
  <CTABand id="cta" heading="Bring SuperKids to Your School or Program" cta={inquiry} micro={MICRO_COMMITMENT} />

  <!-- C14 -->
  <NextSteps
    steps={[
      { title: 'Discovery Session', text: 'A conversation about your learners and goals.' },
      { title: 'Agreement', text: 'Scope and schedule are agreed together.' },
      { title: 'Pilot Classes', text: 'Classes begin with your learners.' },
    ]}
    firstAction={C14_FIRST}
  />

  <Section pad="sm" aria-label="Last updated">
    <p class="updated">Last updated <time datetime={isoDate(LAST_UPDATED)}>{formatDate(LAST_UPDATED)}</time></p>
  </Section>
</LandingLayout>

<style>
  .two-ways__link {
    margin: var(--space-sm) 0 0;
  }
  .agree {
    display: grid;
    gap: var(--space-lg);
  }
  .agree__fact {
    margin: 0;
    max-width: 52rem;
    padding: var(--space-gutter);
    background: var(--surface);
    border-radius: var(--radius-default);
    color: var(--on-surface);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
  }
  .agree__h {
    margin: 0;
    color: var(--secondary);
  }
  .agree__h--apart {
    margin-top: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--outline-variant);
  }
  .agree__delivered {
    max-width: 52rem;
    display: grid;
    gap: var(--stack-title);
    justify-items: start;
  }
  .agree__num {
    margin: 0;
    color: var(--on-surface);
    font-size: var(--fs-body-l, var(--fs-body-m));
    font-weight: var(--fw-medium);
  }
  .agree__fact > :global(p) {
    margin: 0 0 var(--space-xs);
  }
  .agree__fact > :global(p:last-child) {
    margin-bottom: 0;
  }
  .updated {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
