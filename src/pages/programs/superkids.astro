---
// P14 — SuperKids /programs/superkids/ (T3 conversion page; derived from matrix 4.5 for schools and partners).
// Only registered facts are used (GV-08 agreements and targets, never delivered reach). Content the spec marks
// "to confirm with CodersTrust" is written as non-claim copy or omitted (see the page report): C3, C8 and C10.
// Declared compression (doc 06 P14, round 9 Mi3): no separate C3 band, and (WP30d, owner direction 2026-10-14: less is more) no In Short, definition, problem, "what your school
// receives" or separate partner band either: the hero lead, the glance table and the three course vignettes already say it. Robi (PA-03, per doc 06 P14) is no longer named on the page (a one-line partner sentence is not decision information);
// the general government logo strip stays out, because its logos are CodersTrust-wide relationships, not SuperKids partners.
// The C6 positioning statement (POSITIONING.superkids) has no "unlike … we …" clause: it states only what GV-08 registers.
// WP42 (cycle-19 review): it is two plain sentences: "SuperKids offers block coding, robotics and digital art through schools and education partners. DoICT and NCTB agreements set targets, not delivered reach." (the agreements block below says it in full).
import LandingLayout from '../../layouts/LandingLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Icon from '../../components/system/Icon.astro';
import HeroBand from '../../components/sections/HeroBand.astro';
import FutureBand from '../../components/sections/FutureBand.astro';
import { futurePhotos, galleryPhotos } from '../../data/photos';
import GalleryDisclosure from '../../components/pages/programs/GalleryDisclosure.astro';
import StatusTag from '../../components/system/StatusTag.astro';
import Fact from '../../components/facts/Fact.astro';
import MechanismSection from '../../components/pages/programs/MechanismSection.astro';
import FaqSection from '../../components/pages/programs/FaqSection.astro';
import OfferSection from '../../components/pages/programs/OfferSection.astro';
import NextSteps from '../../components/pages/programs/NextSteps.astro';
import ProgramGlance from '../../components/pages/programs/ProgramGlance.astro';
import { fact } from '../../data/facts';
import { faqNode, type FaqSource } from '../../components/pages/programs/faq';
import { C14_FIRST, ctaFor, serviceNode } from '../../components/pages/programs/meta';
import { MICRO_COMMITMENT, POSITIONING, PRICING } from '../../data/copy';
import { COURSES_URL } from '../../lib/site';
import { formatDate, isoDate } from '../../lib/format';
import { webPage } from '../../lib/schema';
import { linkAttrs } from '../../lib/url';

const path = '/programs/superkids/';
const LAST_UPDATED = '2026-10-15'; // WP36: the cycle-13 wording changes (the two agreement targets, the safeguarding answer); WP20c had 2026-10-14 (PAGE_UPDATED.superkids is 2026-10-10)
const title = 'SuperKids: STEAM, Coding and Robotics';
const description = 'SuperKids brings STEAM, coding, robotics and digital art to young learners through schools. 400+ learners since 2021, plus DoICT and NCTB agreements.';
const inquiry = ctaFor('superkids');
const pricingFirst = PRICING.text.split('. ')[0] + '.';

// GV-08 in three sentences, built from the register's own wording so no figure is typed here: the DoICT agreement, the NCTB agreement,
// and the plain statement that these are agreement targets, not delivered reach.
// WP36 (cycle-13 review): the register gives two separate targets, each "20M+ students" (the DoICT agreement's "target reach 20M+ students through 9,000+ digital labs" and the NCTB agreement's
// "competency-based experiential learning for 20M+ students"); it does not say they are the same students, so each is labeled with its own agreement and neither reads as a total.
const gv08 = fact('GV-08').text.match(/agreements with DoICT \(([^;]+); target reach ([^)]+)\) and NCTB \(([^)]+?) for ([^)]+)\)/);
if (!gv08) throw new Error('GV-08 wording changed: update the SuperKids agreement sentences');
const doictScope = gv08[1];
// WP64 (cycle-36 review, Kimi): the labs figure says where the labs are, "... through 9,000+ digital labs in Bangladesh", as GV-09 ("9,000+ government digital labs in Bangladesh") and the YouthWIDE and Local Partners tiles do (the page's visible text named no country).
// The agreement's party, DoICT, is named on the line itself ("DoICT agreement target"), so the line names its source already.
if (!gv08[2].endsWith('9,000+ digital labs') || !fact('GV-09').text.startsWith('9,000+ government digital labs in Bangladesh')) throw new Error('SuperKids: GV-08 no longer ends its DoICT target "... 9,000+ digital labs", or GV-09 no longer places the labs in Bangladesh; update the DoICT target line');
const doictReach = `${gv08[2]} in Bangladesh`;
const nctbScope = gv08[3];
const nctbReach = gv08[4];

// Only the safeguarding question (Q9) applies to SuperKids: Q1 ("Will this work in our country?") answers with the adult course menu
// and Q8 ("What does it cost?") with the adult program inclusions, and neither describes a K-12 program. Pricing is covered in C11.
// WP36 (cycle-13 review): the one-line safeguarding answer with a link to the governance page, which keeps the full account (the hub FAQ has the full Q9).
const faqSources: FaqSource[] = [{ audience: 'variants' as const, id: 'Q9-route' }];

const jsonLd = [
  webPage({ path, name: 'SuperKids', description, dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path: '/programs/' }, { name: 'SuperKids', path }] }),
  serviceNode({ path, name: 'SuperKids', description: 'STEAM, robotics, coding and digital art for young learners, offered through schools and education partners.', audience: 'Schools and Education Partners', areaServed: ['Bangladesh'] }),
  faqNode(faqSources, path),
];
const courses = linkAttrs(COURSES_URL);
---

<LandingLayout title={title} description={description} path={path} breadcrumbs={[{ label: 'Programs', href: '/programs/' }, { label: 'SuperKids' }]} jsonLd={jsonLd} stickyCta={inquiry}>
  <!-- C1 -->
  <HeroBand
    audience="SuperKids · For Schools and Education Partners"
    title="Bring Coding, Robotics and Digital Art into Your Classroom"
    lead="SuperKids brings block coding, robotics and graphic design for kids into schools, with courses shaped with you in a discovery session, so children build digital skills early."
    cta={inquiry}
    artSeed="superkids"
  />

  <ProgramGlance
    title="SuperKids at a Glance"
    rows={[
      { label: 'Who It Is For', text: 'Schools and education partners that want young learners to build digital skills early, through block coding, robotics, and graphic design for kids.' },
      { label: 'Delivered So Far', text: `${fact('SK-05').text}.`, facts: ['SK-05'] },
      { label: 'Agreements', text: 'Agreements with the Department of ICT (DoICT) and the National Curriculum and Textbook Board (NCTB); details below.', facts: ['GV-08'] },
    ]}
  />

  <!-- C4 (C2 and C3 omitted: the hero already says why digital skills start early, and no register fact supports a cost-of-late-exposure statement) -->
  <FutureBand
    photos={futurePhotos('superkids')}
    title="A Classroom with Coding, Robotics and Digital Art"
    lead="Photographs from SuperKids workshops, events and school partnerships."
    vignettes={[
      { kind: 'Block Coding', title: 'Learners Build with Blocks', text: 'Visual coding with blocks is a first step into programming.' },
      { kind: 'Robotics', title: 'Ideas Become Things That Move', text: 'Learners design and program simple robots.' },
      { kind: 'Digital Art', title: 'Creativity Meets Technology', text: 'Graphic design for kids brings art into the digital classroom.' },
    ]}
  />

  <!-- C6 (the positioning statement opens the band) -->
  <MechanismSection title="A K-12 STEAM Program Offered Through Schools" positioning={POSITIONING.superkids} eyebrow="The Program">
    <p class="courses__more" data-reveal>
      Looking for courses for older learners? <a class="link" href={courses.href} rel={courses.rel}>Explore Courses at JobReady.global<Icon name="arrow-up-right" size={16} /><span class="sr-only"> {courses.srText}</span></a>
    </p>
  </MechanismSection>

  <!-- C7: agreements and targets only -->
  <Section id="agreements" tone="airy" aria-labelledby="agreements-h">
    <SectionHeader id="agreements-h" eyebrow="What Is in Place" title="Delivery and Agreements" />
    <div class="agree">
      <h3 class="agree__h t-heading-xl" data-reveal>Delivered</h3>
      <div class="agree__delivered" data-reveal data-fact="SK-05"><StatusTag status="Delivered" /><p class="agree__num"><Fact id="SK-05" /></p></div>
      <h3 class="agree__h agree__h--apart t-heading-xl" data-reveal>Agreed, Not Delivered</h3>
      <div class="agree__fact" data-reveal data-fact="GV-08">
        <p><strong>DoICT agreement target:</strong> {doictReach}, for {doictScope}.</p>
        <p><strong>NCTB agreement target:</strong> {nctbReach}, for {nctbScope}.</p>
        <p>These are agreement targets, not delivered reach.</p>
      </div>
      <div class="agree__cards">
        <article class="card" data-reveal>
          <div class="card__body">
            <p><StatusTag status="Agreement" /></p>
            <h3 class="card__title">DoICT</h3>
            <p class="card__text">Primary-school STEM and robotics.</p>
          </div>
        </article>
        <article class="card" data-reveal>
          <div class="card__body">
            <p><StatusTag status="Agreement" /></p>
            <h3 class="card__title">NCTB</h3>
            <p class="card__text">Competency-based experiential learning.</p>
          </div>
        </article>
      </div>
    </div>
  </Section>

  <!-- C9 -->
  <FaqSection sources={faqSources} title="Questions Schools and Partners Ask" />

  <!-- C11 -->
  <OfferSection
    title="Options Are Shaped with You in a Discovery Session"
    lead="Bring these three things to the conversation."
    cards={[
      { icon: 'school', title: 'Your School or Organization', text: 'Location, age groups and the approximate number of learners.' },
      { icon: 'target', title: 'Your Goals', text: 'Which of STEAM, coding, robotics and digital art you want to start with.' },
      { icon: 'calendar-check', title: 'Your Timeline', text: 'When you would like to begin, and two suitable times for a conversation.' },
    ]}
  >
    <p class="note note--key" data-fact="PD-02">{pricingFirst}</p>
  </OfferSection>

  <GalleryDisclosure id="in-the-field" eyebrow="In the Field" title="Inside SuperKids Classrooms and Events" lead="Workshops, certificate ceremonies and school agreements, in photographs." photos={galleryPhotos('superkids')} visible={4} />

  <!-- C12 (risk reversal) is the micro-commitment line under the C13 button. Safeguarding is stated once on this page, in the FAQ answer
       above (Q9); the former "Safeguarding Is Agreed Before Enrollment" card repeated it word for word. -->

  <!-- C13 -->
  <CTABand id="cta" heading="Bring SuperKids to Your School or Program" cta={inquiry} micro={MICRO_COMMITMENT} />

  <!-- C14 -->
  <NextSteps
    steps={[
      { title: 'Discovery', text: 'A conversation about your learners and goals.' },
      { title: 'Agreement', text: 'Scope and schedule are agreed together.' },
      { title: 'Pilot Classes', text: 'Classes begin with your learners.' },
    ]}
    firstAction={C14_FIRST}
  />

  <Section pad="sm" aria-label="Last updated">
    <p class="updated">Last updated <time datetime={isoDate(LAST_UPDATED)}>{formatDate(LAST_UPDATED)}</time></p>
  </Section>
</LandingLayout>

<style>
  .courses__more {
    margin: var(--space-lg) 0 0;
    color: var(--on-surface-variant);
  }
  .agree {
    display: grid;
    gap: var(--space-lg);
  }
  .agree__fact {
    margin: 0;
    max-width: 52rem;
    padding: var(--space-gutter);
    background: var(--surface);
    border-radius: var(--radius-default);
    color: var(--on-surface);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
  }
  .agree__h {
    margin: 0;
    color: var(--secondary);
  }
  .agree__h--apart {
    margin-top: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--outline-variant);
  }
  .agree__delivered {
    max-width: 52rem;
    display: grid;
    gap: var(--stack-title);
    justify-items: start;
  }
  .agree__num {
    margin: 0;
    color: var(--on-surface);
    font-size: var(--fs-body-l, var(--fs-body-m));
    font-weight: var(--fw-medium);
  }
  .agree__fact > :global(p) {
    margin: 0 0 var(--space-xs);
  }
  .agree__fact > :global(p:last-child) {
    margin-bottom: 0;
  }
  .agree__cards {
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
    max-width: 52rem;
  }
  @media (min-width: 768px) {
    .agree__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .updated {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
