---
// P14 — SuperKids /programs/superkids/ (T3 conversion page; derived from matrix 4.5 for schools and partners).
// Only registered facts are used (GV-08 agreements and targets, never delivered reach). Content the spec marks
// "to confirm with CodersTrust" is written as non-claim copy or omitted (see the page report): C3, C8 and C10.
// Declared compression (doc 06 P14, round 9 Mi3): no separate C3 band; C2 (the PX-08 sentence) carries the transition line "It doesn’t have to be this way."
// and leads straight into C4, because no registered fact supports a cost-of-late-exposure statement (comment only, nothing rendered).
// The C6 positioning statement (POSITIONING.superkids) has no "unlike … we …" clause: it states only what GV-08 registers.
// C5 names only the SuperKids agreements (DoICT, NCTB; GV-08) and Robi (PA-03, per doc 06 P14): the general government logo strip is not shown,
// because its logos are CodersTrust-wide relationships, not SuperKids partners.
import LandingLayout from '../../layouts/LandingLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import FeatureCard from '../../components/ui/FeatureCard.astro';
import Icon from '../../components/system/Icon.astro';
import HeroBand from '../../components/sections/HeroBand.astro';
import FutureBand from '../../components/sections/FutureBand.astro';
import { futurePhotos, galleryPhotos } from '../../data/photos';
import PhotoGallery from '../../components/ui/PhotoGallery.astro';
import Fact from '../../components/facts/Fact.astro';
import FactStat from '../../components/facts/FactStat.astro';
import DefinitionBlock from '../../components/pages/programs/DefinitionBlock.astro';
import ProblemSection from '../../components/pages/programs/ProblemSection.astro';
import GuideSection from '../../components/pages/programs/GuideSection.astro';
import MechanismSection from '../../components/pages/programs/MechanismSection.astro';
import FaqSection from '../../components/pages/programs/FaqSection.astro';
import OfferSection from '../../components/pages/programs/OfferSection.astro';
import NextSteps from '../../components/pages/programs/NextSteps.astro';
import ProgramGlance from '../../components/pages/programs/ProgramGlance.astro';
import { fact } from '../../data/facts';
import { faqNode, type FaqSource } from '../../components/pages/programs/faq';
import { C14_FIRST, PAGE_UPDATED, ctaFor, serviceNode } from '../../components/pages/programs/meta';
import { MICRO_COMMITMENT, ORIGIN, POSITIONING, PRICING } from '../../data/copy';
import { COURSES_URL } from '../../lib/site';
import { formatDate, isoDate } from '../../lib/format';
import { webPage } from '../../lib/schema';
import { linkAttrs } from '../../lib/url';

const path = '/programs/superkids/';
const LAST_UPDATED = PAGE_UPDATED.superkids;
const title = 'SuperKids: STEAM, Coding and Robotics';
const description = 'SuperKids brings STEAM, coding and robotics to young learners through schools and partners. 400+ learners since 2021; agreements with DoICT and NCTB set further targets.';
const inquiry = ctaFor('superkids');
const pricingFirst = PRICING.text.split('. ')[0] + '.';

// Only the safeguarding question (Q9) applies to SuperKids: Q1 ("Will this work in our country?") answers with the adult course menu
// and Q8 ("What does it cost?") with the adult program inclusions, and neither describes a K-12 program. Pricing is covered in C11.
const faqSources: FaqSource[] = ['Q9'].map((id) => ({ audience: 'foundations' as const, id }));

const jsonLd = [
  webPage({ path, name: 'SuperKids', description, dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path: '/programs/' }, { name: 'SuperKids', path }] }),
  serviceNode({ path, name: 'SuperKids', description: 'STEAM, robotics, coding and digital art for young learners, offered through schools and education partners.', audience: 'Schools and Education Partners', areaServed: ['Bangladesh'] }),
  faqNode(faqSources, path),
];
const courses = linkAttrs(COURSES_URL);
---

<LandingLayout title={title} description={description} path={path} breadcrumbs={[{ label: 'Programs', href: '/programs/' }, { label: 'SuperKids' }]} jsonLd={jsonLd} stickyCta={inquiry}>
  <!-- C1 -->
  <HeroBand
    audience="SuperKids · For Schools and Education Partners"
    title="Help Young Learners Explore Coding, Creativity and Robotics."
    lead="We help schools and partners bring STEAM, coding and robotics to young learners."
    cta={inquiry}
    artSeed="superkids"
  />

  <DefinitionBlock heading="What Is SuperKids?">
    <p>SuperKids is CodersTrust’s K-12 STEAM program: robotics, coding and digital art for young learners, offered through schools and education partners.</p>
  </DefinitionBlock>

  <ProgramGlance
    rows={[
      { label: 'Who It Is For', text: 'Schools and education partners that want young learners to build digital skills early.' },
      { label: 'Delivery', text: 'Courses taught through schools and education partners, shaped with you in a discovery session.' },
      { label: 'Courses', text: 'Block coding, robotics, and graphic design for kids.' },
      { label: 'Delivered So Far', text: `${fact('SK-05').text}.`, facts: ['SK-05'] },
      { label: 'Agreements', text: 'Agreements with the Department of ICT (DoICT) and the National Curriculum and Textbook Board (NCTB) set targets for reach; they are not delivered reach.', facts: ['GV-08'] },
      { label: 'Agreed Before You Start', text: 'Your location, age groups and approximate number of learners, your goals and your timeline. Prices are not published.', facts: ['PD-02'] },
    ]}
  />

  <!-- C2 -->
  <ProblemSection
    title="Young Learners Need a First Step into Digital Skills."
    bluf="SuperKids brings the first steps of STEAM, coding and robotics into the classroom."
    factIds={[]}
    transition="It doesn’t have to be this way."
  />

  <!-- C4 (C3 omitted: no register fact supports a cost-of-late-exposure statement) -->
  <FutureBand
    photos={futurePhotos('superkids')}
    title="A Classroom with Coding, Robotics and Digital Art"
    lead="Photographs from SuperKids workshops, events and school partnerships."
    vignettes={[
      { kind: 'Block Coding', title: 'Learners Build with Blocks', text: 'Visual coding with blocks is a first step into programming.' },
      { kind: 'Robotics', title: 'Ideas Become Things That Move', text: 'Learners design and program simple robots.' },
      { kind: 'Digital Art', title: 'Creativity Meets Technology', text: 'Graphic design for kids brings art into the digital classroom.' },
    ]}
  />

  <!-- C5 -->
  <GuideSection
    title="Public-Sector Agreements and a Private-Sector Partner"
    empathy="You want children to build digital skills early."
    origin={ORIGIN}
    statIds={['SK-05']}
    showPartners={false}
    method={{ text: 'TalentLEAP organizes skills into career paths with progressive levels.', factId: 'IN-06', link: { label: 'How TalentLEAP Works', href: '/our-model/talentleap/' } }}
  >
    <p data-fact="GV-08">SuperKids has agreements with the Department of ICT (DoICT) and the National Curriculum and Textbook Board (NCTB). These agreements set targets for reach; they are not delivered reach.</p>
    <p data-fact="PA-03">Private-sector partners include Robi.</p>
  </GuideSection>

  <!-- C6 -->
  <MechanismSection title="How SuperKids Runs" positioning={POSITIONING.superkids} lead="Courses for young learners, taught through schools and education partners." eyebrow="Courses">
    <div class="courses">
      <FeatureCard icon="blocks" title="Block Coding" text="Visual coding with blocks." />
      <FeatureCard icon="bot" title="Robotics" text="Building and programming simple robots." />
      <FeatureCard icon="palette" title="Graphic Design for Kids" text="Digital art and design." />
    </div>
    <p class="courses__more" data-reveal>
      Looking for courses for older learners? <a class="link" href={courses.href} rel={courses.rel}>Explore Courses at JobReady.global<Icon name="arrow-up-right" size={16} /><span class="sr-only"> {courses.srText}</span></a>
    </p>
  </MechanismSection>

  <!-- C7: agreements and targets only -->
  <Section id="agreements" tone="airy" aria-labelledby="agreements-h">
    <SectionHeader id="agreements-h" eyebrow="What Is in Place" title="What Has Been Delivered, and What Is Only Agreed" />
    <div class="agree">
      <div class="agree__delivered" data-reveal><FactStat id="SK-05" /></div>
      <p class="agree__fact" data-reveal data-fact="GV-08"><Fact id="GV-08" /></p>
      <div class="agree__cards">
        <article class="card" data-reveal>
          <div class="card__body">
            <p class="eyebrow">Agreement</p>
            <h3 class="card__title">DoICT</h3>
            <p class="card__text">Primary-school STEM and robotics.</p>
          </div>
        </article>
        <article class="card" data-reveal>
          <div class="card__body">
            <p class="eyebrow">Agreement</p>
            <h3 class="card__title">NCTB</h3>
            <p class="card__text">Competency-based experiential learning.</p>
          </div>
        </article>
      </div>
    </div>
  </Section>

  <!-- C9 -->
  <FaqSection sources={faqSources} title="Questions Schools and Partners Ask" />

  <!-- C11 -->
  <OfferSection
    title="Options Are Shaped with You in a Discovery Session."
    lead="We do not publish prices. Bring these three things to the conversation."
    cards={[
      { icon: 'school', title: 'Your School or Organization', text: 'Location, age groups and the approximate number of learners.' },
      { icon: 'target', title: 'Your Goals', text: 'Which of STEAM, coding, robotics and digital art you want to start with.' },
      { icon: 'calendar-check', title: 'Your Timeline', text: 'When you would like to begin, and two suitable times for a conversation.' },
    ]}
  >
    <p class="note note--key" data-fact="PD-02">{pricingFirst}</p>
  </OfferSection>

  <PhotoGallery id="in-the-field" eyebrow="In the Field" title="Inside SuperKids Classrooms and Events" lead="Workshops, certificate ceremonies and school agreements, in photographs." photos={galleryPhotos('superkids')} />

  <!-- C12 (risk reversal) is the micro-commitment line under the C13 button. Safeguarding is stated once on this page, in the FAQ answer
       above (Q9); the former "Safeguarding Is Agreed Before Enrollment" card repeated it word for word. -->

  <!-- C13 -->
  <CTABand id="cta" heading="Bring SuperKids to Your School or Program." cta={inquiry} micro={MICRO_COMMITMENT} />

  <!-- C14 -->
  <NextSteps
    steps={[
      { title: 'Discovery', text: 'A conversation about your learners and goals.' },
      { title: 'Agreement', text: 'Scope and schedule are agreed together.' },
      { title: 'Pilot Classes', text: 'Classes begin with your learners.' },
    ]}
    firstAction={C14_FIRST}
  />

  <Section pad="sm" aria-label="Last updated">
    <p class="updated">Last updated <time datetime={isoDate(LAST_UPDATED)}>{formatDate(LAST_UPDATED)}</time></p>
  </Section>
</LandingLayout>

<style>
  .courses {
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .courses {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .courses__more {
    margin: var(--space-lg) 0 0;
    color: var(--on-surface-variant);
  }
  .agree {
    display: grid;
    gap: var(--space-lg);
  }
  .agree__fact {
    margin: 0;
    max-width: 52rem;
    padding: var(--space-gutter);
    background: var(--surface);
    border-left: 4px solid var(--primary);
    border-radius: 0 var(--radius-default) var(--radius-default) 0;
    color: var(--on-surface);
    font-size: var(--fs-body-m);
    line-height: var(--lh-body-m);
  }
  .agree__delivered {
    max-width: 52rem;
  }
  .agree__cards {
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
    max-width: 52rem;
  }
  @media (min-width: 768px) {
    .agree__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .updated {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
