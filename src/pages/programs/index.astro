---
// P9 — Programs hub /programs/ (T2): six program cards, the shared path behind them, the headline evidence, and one discovery CTA.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Badge from '../../components/system/Badge.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import FeatureCard from '../../components/ui/FeatureCard.astro';
import StepFlow from '../../components/ui/StepFlow.astro';
import CTABand from '../../components/ui/CTABand.astro';
import ProofBand from '../../components/sections/ProofBand.astro';
import Sources from '../../components/facts/Sources.astro';
import DefinitionBlock from '../../components/pages/programs/DefinitionBlock.astro';
import { LAST_UPDATED, ctaFor, statValue } from '../../components/pages/programs/meta';
import { MICRO_COMMITMENT, STEPS, STEPS_FACTS } from '../../data/copy';
import { formatDate, isoDate } from '../../lib/format';
import { pageUrl, webPage } from '../../lib/schema';

const path = '/programs/';
const title = 'Programs: From Learning to Earning';
const description = 'Six CodersTrust programs for funders, governments, universities, employers, degree holders and schools, each built to move youth into paid digital work.';
const discovery = ctaFor('discovery');

const programs = [
  { icon: 'globe', href: '/programs/youthwide/', title: 'YouthWIDE', audience: 'Development partners and funders', text: 'A ready-to-fund country program for youth digital employment in South Asia, MENA and Sub-Saharan Africa.', means: 'funders see paid-work outcomes in monthly reports, not only enrollment.' },
  { icon: 'landmark', href: '/programs/nationwide/', title: 'NationWIDE', audience: 'Governments', text: `A Bangladesh initiative that aims to train ${statValue('IN-01')} vulnerable youth for digital employment by 2030.`, means: 'a ministry can follow a national target through to young people in work.' },
  { icon: 'graduation-cap', href: '/programs/jobready-campus/', title: 'JobReady@Campus', audience: 'Universities and colleges', text: 'Industry-oriented skills training in parallel with academic studies, using on-campus labs.', means: 'students add a recognized credential beside the degree.' },
  { icon: 'briefcase', href: '/programs/jobready-work/', title: 'JobReady@Work', audience: 'Employers', text: 'Corporate training custom-developed for each organization, plus access to job-ready talent.', means: 'your team learns on tasks from your own roles.' },
  { icon: 'book-open', href: '/nu-postgraduate-diploma/', title: 'NU Postgraduate Diploma', audience: 'Degree holders in Bangladesh', text: 'National University postgraduate diploma courses delivered by CodersTrust, in digital marketing and ICT.', means: 'you add digital skills to the degree you hold.' },
  { icon: 'blocks', href: '/programs/superkids/', title: 'SuperKids', audience: 'Schools and education partners', text: 'STEAM, coding and robotics for young learners.', means: 'a school can bring coding and robotics into the classroom.' },
];

const jsonLd = [
  webPage({ path, name: 'Programs that take youth from learning to earning', description, type: 'CollectionPage', dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path }] }),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl(path)}#programs`,
    name: 'CodersTrust programs',
    itemListElement: programs.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: pageUrl(p.href) })),
  },
];
---

<BaseLayout title={title} description={description} path={path} breadcrumbs={[{ label: 'Programs' }]} jsonLd={jsonLd}>
  <Hero
    eyebrow="Programs"
    title="Programs that take youth from learning to earning"
    lead="CodersTrust runs six programs, each for a different partner: funders and governments, universities, employers, degree holders and schools. All of them aim at the same result, young people in paid work."
    artSeed="programs-hub"
  >
    <Fragment slot="actions">
      <a class="link" href="#programs-grid">Compare the programs</a>
    </Fragment>
  </Hero>

  <DefinitionBlock />

  <Section id="programs-grid" aria-labelledby="programs-h">
    <SectionHeader id="programs-h" eyebrow="Six programs" title="Choose the program that fits you." lead="Each card says who the program is for and what it means in practice." />
    <ul class="grid-cards grid-cards--stretch hub" role="list" data-fact="IN-02 IN-01 IN-09 IN-10 SC-04">
      {
        programs.map((p) => (
          <li>
            <FeatureCard icon={p.icon} title={p.title} text={p.text} means={p.means} href={p.href}>
              <p class="hub__aud"><Badge tone="brand">{p.audience}</Badge></p>
            </FeatureCard>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="path" tone="airy" aria-labelledby="path-h">
    <SectionHeader id="path-h" eyebrow="The path behind every program" title="Train, mentor, place and report." lead="Funded programs share one path. Each program adapts it to its partner." />
    <div data-fact={STEPS_FACTS.join(' ')}>
      <StepFlow steps={STEPS.map((s) => ({ title: s.title, text: s.text }))} />
    </div>
  </Section>

  <ProofBand title="The evidence" headlineFact="RC-01" statIds={['RC-01', 'SC-01', 'SC-03']} links={[{ label: 'See the evidence', href: '/impact/' }, { label: 'The randomized trial', href: '/impact/independent-evaluation/' }]} />

  <CTABand
    id="cta"
    heading="Not sure which fits?"
    text="Tell us who you are and what you want to achieve, and we will point you to the right program."
    cta={discovery}
    micro={MICRO_COMMITMENT}
  />

  <Section pad="sm" aria-label="Notes and sources">
    <p class="updated">Last updated <time datetime={isoDate(LAST_UPDATED)}>{formatDate(LAST_UPDATED)}</time></p>
    <Sources />
  </Section>
</BaseLayout>

<style>
  .hub {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hub > li {
    display: flex;
  }
  .hub > li > :global(.card) {
    width: 100%;
  }
  .hub__aud {
    margin: 0;
  }
  .updated {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
