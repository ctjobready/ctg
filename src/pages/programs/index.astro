---
// P9 — Programs hub /programs/ (T2): five program cards, the headline evidence and one discovery CTA.
// WP30d (owner direction 2026-10-14: less is more): the selection table, the shared three-step path, the "What Is CodersTrust?" definition, the phase note and the safeguarding
// band are cut; the cards already say who each program is for, and the program pages and Our Model carry the rest.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Button from '../../components/system/Button.astro';
import Icon from '../../components/system/Icon.astro';
import StatusTag from '../../components/system/StatusTag.astro';
import Badge from '../../components/system/Badge.astro';
import FactStat from '../../components/facts/FactStat.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import FeatureCard from '../../components/ui/FeatureCard.astro';
import CTABand from '../../components/ui/CTABand.astro';
import EvidenceBand from '../../components/pages/home/EvidenceBand.astro';
import { ctaFor, statValue } from '../../components/pages/programs/meta';
import { NU_COURSE_ORDER, NU_COURSE_SUBJECT } from '../../components/pages/programs/nuPgd';
import { AIM_DEPENDENCY, MICRO_COMMITMENT, NU_ELIGIBILITY, withoutSince2014 } from '../../data/copy';
import { fact } from '../../data/facts';
import { joinList } from '../../lib/format';
import { linkAttrs } from '../../lib/url';
import { pageUrl, webPage } from '../../lib/schema';

const path = '/programs/';
// WP60 (cycle-32 review, Gemini GM1): the evidence band under the program cards is headed "Evidence from Youth-Employment Programs" and opens "These results are from youth-employment programs, not evidence for every program listed above." (it was "Trial and Survey Evidence",
// under a list that includes schools, universities and employers); the figures and the predecessor label (the trial line and the tile's label) are unchanged.
// WP60 (cycle-32 review, Claude S3): the YouthWIDE card's "..., depending on government and donor commitments" is AIM_DEPENDENCY (src/data/copy.ts), the clause every other page that states the 2 million 2030 aim now reads too (it was typed here only).
// WP67 (cycle-38 review, Gemini): the YouthWIDE card's "Best For" line names the three audiences its route links below it name, "Governments, Development Partners and Foundations" (it said "... and Funders", a word that is not one of the three routes).
// WP50 (cycle-25 review): the overview prints no "Last updated" line (it read as a draft stamp on a hub page); the date stays in the page's JSON-LD (dateModified). The program pages, the evidence pages and the legal pages keep theirs.
const LAST_UPDATED = '2026-10-15'; // WP31: the cycle-8 review wording changes (WP20c had set 2026-10-14; PAGE_UPDATED.programs is 2026-10-10)
// R10/WP11 F23: no sentence says that every program aims at the same result (SuperKids is a K-12 program and the NU Postgraduate Diploma
// is a diploma), so the H1 speaks of stages ("from classroom to career"), not of one outcome. The meta description is the plan's P9 wording.
// WP48 (cycle-23 review): the H1 is "Programs That Take Learners from Classroom to Career" (it was "Digital Skills for Every Stage, from Classroom to Career").
// WP50 (cycle-25 review): the H1 is "Digital Skills Programs, from School to Work" (the WP48 line did not cover SuperKids or people already employed).
const title = 'Programs';
const description = 'Explore CodersTrust programs, from school to the workplace: YouthWIDE, JobReady@Campus, JobReady@Work, SuperKids and the NU Postgraduate Diploma.';
const discovery = ctaFor('discovery');
// WP64 (cycle-36 review, Grok): the reach band is headed "Reach Since 2014", so its learners tile reads "130,000+ learners trained" (SC-01's label without " since 2014", read from the register); the register's label is unchanged.
const learnersLabel = withoutSince2014(fact('SC-01').stat?.label ?? '');

const programs = [
  { icon: 'globe', href: '/programs/youthwide/', title: 'YouthWIDE', audience: 'Governments, Development Partners and Foundations', text: `The youth digital-employment program, designed as co-funded country cohorts for South Asia, the Middle East and North Africa, and Sub-Saharan Africa. It builds on results from earlier programs in Bangladesh and Kosovo. In Bangladesh it aims to train ${statValue('IN-01')} vulnerable youth for digital employment by 2030, ${AIM_DEPENDENCY}.`, means: 'ministries can follow phased delivery from training to paid work, and funders get monthly reports on progress toward paid work, not only enrollment.', partner: [{ label: 'For Governments', href: '/partner-with-us/governments/' }, { label: 'For Development Partners', href: '/partner-with-us/development-partners/' }, { label: 'For Foundations', href: '/partner-with-us/foundations/' }] },
  { icon: 'graduation-cap', href: '/programs/jobready-campus/', title: 'JobReady@Campus', audience: 'Universities and Colleges', text: 'Industry-oriented skills training in parallel with academic studies, using on-campus labs.', means: 'students get a supported route to industry certification beside the degree.', partner: [{ label: 'For Universities', href: '/partner-with-us/universities/' }] },
  { icon: 'briefcase', href: '/programs/jobready-work/', title: 'JobReady@Work', audience: 'Employers', text: 'Corporate training custom-developed for each organization, plus a route to hire job-ready talent.', means: 'your team learns on tasks from your own roles.', partner: [{ label: 'For Employers', href: '/partner-with-us/employers/' }] },
  // WP76 (owner answer 2026-10-22: the diploma has four courses): the card names all four ("..., in digital marketing, ICT, cyber security and data analytics."; it said "... in digital marketing and ICT."), from the same list the diploma page and the menus use.
  { icon: 'book-open', href: '/programs/nu-postgraduate-diploma/', title: 'NU Postgraduate Diploma', audienceLabel: 'Eligibility', audienceFacts: 'NU-01', audience: NU_ELIGIBILITY, text: `National University postgraduate diploma courses delivered by CodersTrust, in ${joinList(NU_COURSE_ORDER.map((s) => NU_COURSE_SUBJECT[s]))}.`, means: 'you add digital skills to the qualification you hold.' },
  { icon: 'blocks', href: '/programs/superkids/', title: 'SuperKids', audience: 'Schools and Education Partners', text: 'STEAM, coding, robotics and digital art for young learners.', means: 'a school can bring STEAM, coding, robotics and digital art into the classroom.' },
];

const jsonLd = [
  webPage({ path, name: 'CodersTrust Programs', description, type: 'CollectionPage', dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path }] }),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl(path)}#programs`,
    name: 'CodersTrust Programs',
    itemListElement: programs.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: pageUrl(p.href) })),
  },
];
---

<BaseLayout title={title} description={description} path={path} breadcrumbs={[{ label: 'Programs' }]} jsonLd={jsonLd}>
  <Hero
    eyebrow="Programs"
    title="Digital Skills Programs, from School to Work"
    lead="CodersTrust offers four partner programs for institutions — YouthWIDE, JobReady@Campus, JobReady@Work and SuperKids — and the NU Postgraduate Diploma for individual learners."
    artSeed="programs-hub"
  >
    <Fragment slot="actions">
      <Button href={discovery.href} iconEnd="arrow-right">{discovery.label}</Button>
      <!-- WP25s: the learner route is visible at the top, as a text link under the one primary button (the diploma has no partner route). -->
      <p class="hub__nu">Applying for the NU Postgraduate Diploma? <a class="link" href={linkAttrs('/programs/nu-postgraduate-diploma/').href}>See the diploma.</a></p>
    </Fragment>
  </Hero>

  <Section id="programs-grid" aria-labelledby="programs-h">
    {/* WP51 (cycle-26 review, Grok P3): the eyebrow counts the five program cards below it ("Five Programs"; it read "Five Routes", the word the partner pages use for their audiences). */}
    <SectionHeader id="programs-h" eyebrow="Five Programs" title="Find the Program That Fits Where You Start" />
    <ul class="grid-cards grid-cards--stretch hub" role="list" data-fact="IN-02 IN-01 IN-09 IN-10 SC-04">
      {
        programs.map((p) => (
          <li>
            <FeatureCard icon={p.icon} title={p.title} text={p.text} means={p.means} href={p.href}>
              <p class="hub__aud" data-fact={p.audienceFacts}><strong>{p.audienceLabel ?? 'Best For'}:</strong> {p.audience}</p>
              {p.partner && (
                <p class="hub__aud hub__partner">
                  {p.partner.map((l) => (
                    <a class="link" href={linkAttrs(l.href).href}>{l.label}</a>
                  ))}
                </p>
              )}
            </FeatureCard>
          </li>
        ))
      }
    </ul>
    <p class="hub__more">Deciding as an institution? <a class="link" href={linkAttrs('/partner-with-us/').href}>Start with Partner with Us.</a> <a class="link" href={linkAttrs('/our-model/').href}>See How the Model Works<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <!-- WP31: the hub keeps the 78.2% tile without its detail line; the income paragraph (RC-01's headline) and the tile's detail line live on the evidence pages the band links.
       WP41 (cycle-18 review): the trial is ONE line (TRIAL_LINE: the employment result, the predecessor program named) under its heading, with the link to the trial page; the plain-language paragraph, the +10.3 pp tile, the chart
       and the lead that said "predecessor program" and "surveyed completers" a second time are gone (the line and the tile's label say both). -->
  <EvidenceBand
    id="proof-band"
    title="Evidence from Youth-Employment Programs"
    bandHeading="Evidence from Youth-Employment Programs"
    lead="These results are from youth-employment programs, not evidence for every program listed above."
    trialHeading="An Independent Randomized Trial"
    chart="none"
    trialLine
    surveyNotes={false}
    statIds={[]}
    surveyStatIds={['OC-01']}
    links={[{ label: 'See the Evidence', href: '/impact/' }, { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' }]}
  />

  <Section id="reach" pad="sm" aria-labelledby="reach-h">
    <SectionHeader id="reach-h" eyebrow="Reach" title="Reach Since 2014" />
    <!-- WP58 (cycle-30 reviews, Claude S1 a and GPT-6.1 Sol G1): the 16 is where CodersTrust has worked (a launch location, an announced cooperation and partnerships among them), so its tile carries a badge and no "Delivered" status; the 130,000+ learners trained keep theirs.
         WP61 (cycle-33 review, Kimi P1): the badge says "Where We Have Worked" (it said "Since 2014", which the band heading, "Reach Since 2014", already says). -->
    <div class="hub__reach">
      <div data-reveal><StatusTag status="Delivered" /><FactStat id="SC-01" label={learnersLabel} /></div>
      <div data-reveal><Badge tone="brand" class="hub__period">Where We Have Worked</Badge><FactStat id="SC-03" /></div>
    </div>
  </Section>

  <CTABand
    id="cta"
    heading="Not Sure Which Program Fits?"
    text="Tell us who you want to reach and your timeline, and we will point you to the right program."
    cta={discovery}
    micro={MICRO_COMMITMENT}
  />
</BaseLayout>

<style>
  .hub {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hub > li {
    display: flex;
  }
  .hub > li > :global(.card) {
    width: 100%;
  }
  .hub__aud {
    margin: 0;
  }
  .hub__nu {
    flex-basis: 100%;
    margin: 0;
    color: var(--on-surface-variant);
  }
  .hub__partner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-xs);
  }
  .hub__reach {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: minmax(0, 1fr);
  }
  .hub__reach > div {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    align-content: start;
  }
  /* WP58: the period badge is as tall as the 24 px status tag beside it, so the two figures start level */
  .hub__reach :global(.hub__period) {
    height: 24px;
  }
  @media (min-width: 768px) {
    .hub__reach {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .hub__more {
    margin: var(--space-lg) 0 0;
    color: var(--on-surface-variant);
  }
</style>
