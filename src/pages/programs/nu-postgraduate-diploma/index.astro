---
// P15 — NU Postgraduate Diploma /programs/nu-postgraduate-diploma/ (applicant admissions page; moved under /programs/ in WP20a, the old /nu-postgraduate-diploma/ paths are redirect stubs).
// Applicant template: key facts in the hero, the full "Before You Apply" table after the value band, one primary CTA (Apply Now) with admissions as a text link.
// "Apply Now" is a plain link to the standalone Google Form.
import LandingLayout from '../../../layouts/LandingLayout.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import StepFlow from '../../../components/ui/StepFlow.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import CourseCard from '../../../components/system/CourseCard.astro';
import { futurePhotos, nuBanner } from '../../../data/photos';
import Icon from '../../../components/system/Icon.astro';
import Fact from '../../../components/facts/Fact.astro';
import { linkAttrs } from '../../../lib/url';
import Hero from '../../../components/system/Hero.astro';
import Button from '../../../components/system/Button.astro';
import FutureBand from '../../../components/sections/FutureBand.astro';
import ProofBand from '../../../components/sections/ProofBand.astro';
import DefinitionBlock from '../../../components/pages/programs/DefinitionBlock.astro';
import ProblemSection from '../../../components/pages/programs/ProblemSection.astro';
import CostSection from '../../../components/pages/programs/CostSection.astro';
import GuideSection from '../../../components/pages/programs/GuideSection.astro';
import MechanismSection from '../../../components/pages/programs/MechanismSection.astro';
import FaqSection from '../../../components/pages/programs/FaqSection.astro';
import OfferSection from '../../../components/pages/programs/OfferSection.astro';
import RiskSection from '../../../components/pages/programs/RiskSection.astro';
import { anchor, faqNode, type FaqSource } from '../../../components/pages/programs/faq';
import { PAGE_UPDATED } from '../../../components/pages/programs/meta';
import { NU_APPLY, NU_CALL, NU_CALL_NUMBER, NU_CALL_TEXT, NU_COURSE_COPY, NU_LOCATION_NOTE, NU_NAME, NU_PATH, NU_SCHEDULE_NOTE, nuCourses, nuOverview } from '../../../components/pages/programs/nuPgd';
import { EMPATHY, HEADLINE, NU_ELIGIBILITY, ORIGIN, TRIAL_SCOPE, VALUE_PROPOSITION } from '../../../data/copy';
import { CLAIM_PX06 } from '../../../components/sections/copyText';
import { COURSES_URL } from '../../../lib/site';
import { formatDate, isoDate } from '../../../lib/format';
import { pageUrl, webPage } from '../../../lib/schema';

const path = NU_PATH;
const title = 'NU Postgraduate Diploma';
const description = 'Build practical digital skills after your degree with the National University postgraduate diploma, delivered by CodersTrust.';
const overview = await nuOverview();
const apply = { label: NU_APPLY.label, href: overview.data.applyUrl };
const applyLink = linkAttrs(apply.href);
const courses = await nuCourses();

const faqSources: FaqSource[] = [
  // WP27: admissions' own eligibility sentence (NU-01), not "if you hold a degree".
  { q: 'Is the NU Postgraduate Diploma Right for Me?', html: `Eligibility: ${NU_ELIGIBILITY}. It is right for you if you meet that and want a digital career. Not right if you want a short self-paced course: see ${anchor(COURSES_URL, 'JobReady.global')}.`, evidence: ['NU-01'] },
  { q: 'Who Delivers the Diploma?', html: 'CodersTrust has been National University’s official training partner for digital career skills and credentials since 2023, and delivers NU postgraduate diploma courses.', evidence: ['SC-04'] },
  { q: 'Where Do I Find Eligibility, Schedule and Fees?', html: `The eligibility, duration, fee, payment and recognition details are in Before You Apply above. ${NU_SCHEDULE_NOTE} ${NU_LOCATION_NOTE} To ask, call ${anchor(NU_CALL.href, NU_CALL_NUMBER)}.` },
  { q: 'How Do I Apply?', html: `Complete the ${anchor(apply.href, 'application form')}. Our admissions team contacts you with the next steps.` },
];

const jsonLd = [
  webPage({ path, name: NU_NAME, description, dateModified: PAGE_UPDATED.nu, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path: '/programs/' }, { name: 'NU Postgraduate Diploma', path }] }),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl(path)}#courses`,
    name: 'NU Postgraduate Diploma courses',
    itemListElement: courses.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, url: pageUrl(`${path}${c.slug}/`) })),
  },
  faqNode(faqSources, path),
];

const originShort = { text: ORIGIN.text.split('. ')[0] + '.', facts: ['ID-02'] };
---

<LandingLayout title={title} description={description} path={path} breadcrumbs={[{ label: 'Programs', href: '/programs/' }, { label: 'NU Postgraduate Diploma' }]} jsonLd={jsonLd} stickyCta={apply}>
  <!-- C1: one primary CTA (Apply Now); admissions is a text link; duration and fee sit in the hero, the full table (eligibility and delivery included, stated once) follows the value band -->
  <Hero eyebrow={NU_NAME} title={HEADLINE.nuPgd} lead={VALUE_PROPOSITION.nuPgd} artSeed="nu-pgd">
    <Fragment slot="actions">
      <Button href={apply.href} iconEnd="arrow-right">{apply.label}</Button>
      <a class="link" href={NU_CALL.href}>{NU_CALL_TEXT}</a>
      <!-- WP27: intake, schedule and location are not published; the link goes to the admissions contact block, where they are confirmed with each applicant -->
      <a class="link" href="#admissions-contact">Confirm Intake, Schedule and Location</a>
    </Fragment>
    <dl slot="stats" class="keyfacts">
      <div><dt>Duration</dt><dd><Fact id="NU-02" /></dd></div>
      <div><dt>Program Fee</dt><dd><Fact id="NU-03" /></dd></div>
    </dl>
  </Hero>

  <!-- WP22: the two course-choice cards sit directly under the hero (they were the C6 band) -->
  <MechanismSection id="courses" title="Choose Your Course" lead="Two courses, delivered by CodersTrust under National University’s official training partnership." eyebrow="The Courses" factIds={['SC-04']} tone="airy">
    <div class="courses" data-fact="SC-04">
      {
        courses.map((c) => (
          <CourseCard
            title={c.title}
            image={nuBanner(c.slug)?.src}
            imageAlt={nuBanner(c.slug)?.alt}
            assetId={nuBanner(c.slug)?.assetId}
            ratio="808 / 555"
            meta={NU_COURSE_COPY[c.slug].topics.map((t) => ({ icon: 'book-open', label: t }))}
            href={`${path}${c.slug}/`}
            actionLabel="View Course"
          />
        ))
      }
    </div>
  </MechanismSection>

  <DefinitionBlock heading="What Is the NU Postgraduate Diploma?">
    <p data-fact="SC-04">CodersTrust has been National University’s official training partner for digital career skills and credentials since 2023, and delivers NU postgraduate diploma courses.</p>
    <Fact id="NU-04" as="p" />
  </DefinitionBlock>

  <!-- C2 -->
  <ProblemSection
    title="A Degree Alone May Not Be Enough for Today’s Digital Jobs"
    bluf="You are aiming for interviews, a first digital job and credentials employers recognize."
    factIds={['PX-03', 'PX-05']}
    scope={{ 'PX-05': { label: 'of employers worldwide report difficulty finding the talent they need' } }}
    extra={[{ title: 'It Is Hard to Know Which Skills to Pick', text: 'Which skills and certifications to add next is not obvious, and the wrong choice costs time.' }]}
  />

  <!-- C3 -->
  <CostSection
    title="Employers Are Asking for Different Skills"
    lead="AI is shifting which entry-level skills employers ask for, and a degree alone does not show them."
    blocks={[
      { claim: CLAIM_PX06, factId: 'PX-06', implication: 'A degree alone does not show employers what you can do, so practical skills matter.' },
      { claim: 'AI Skills Are Growing in Demand', factId: 'PX-08', scope: 'Globally', implication: 'Employers look for AI skills alongside the degree.' },
    ]}
  />

  <!-- C4 -->
  <FutureBand
    photos={futurePhotos('nu-pgd')}
    title="A Clearer Route into Digital Work"
    lead="Illustrative: you finish with practical digital skills and a clearer route into work."
    vignettes={[
      { kind: 'Functional', title: 'Practical Digital Skills', text: 'You build skills employers ask for, in digital marketing or ICT.' },
      { kind: 'Emotional', title: 'A Clearer Idea of What to Add Next', text: 'A structured course replaces guesswork about which skills to pick.' },
      { kind: 'Social', title: 'A Route into Work You Can Explain', text: 'You can tell employers what you can do.' },
    ]}
  />

  <Section id="before-you-apply" aria-labelledby="before-h">
    <SectionHeader id="before-h" eyebrow="Admissions" title="Before You Apply" lead="Program details as stated for the National University Postgraduate Diploma." />
    <dl class="ba">
      <div class="ba__row"><dt>Eligibility</dt><dd><Fact id="NU-01" /></dd></div>
      <div class="ba__row"><dt>Duration</dt><dd><Fact id="NU-02" /></dd></div>
      <div class="ba__row"><dt>Credit Hours and Subjects (Each Course)</dt><dd><Fact id="NU-09" /></dd></div>
      <div class="ba__row"><dt>Schedule and Intake</dt><dd>{NU_SCHEDULE_NOTE}</dd></div>
      <div class="ba__row"><dt>Delivery</dt><dd><Fact id="NU-10" /></dd></div>
      <div class="ba__row"><dt>Teaching Location</dt><dd>{NU_LOCATION_NOTE}</dd></div>
      <div class="ba__row"><dt>Program Fee</dt><dd><Fact id="NU-03" /></dd></div>
      <div class="ba__row"><dt>Payment</dt><dd><Fact id="NU-05" /></dd></div>
      <div class="ba__row"><dt>Recognition</dt><dd><Fact id="NU-04" /></dd></div>
      <div class="ba__row" id="admissions-contact"><dt>How to Apply</dt><dd>Complete the <a class="link" href={applyLink.href} rel={applyLink.rel}>application form</a>. For help, call <a class="link" href={NU_CALL.href}>{NU_CALL_NUMBER}</a> or email <a class="link" href="mailto:hello@coderstrustbd.com">hello@coderstrustbd.com</a>.</dd></div>
    </dl>
  </Section>

  <!-- C5 -->
  <GuideSection
    eyebrow="Context"
    title="Delivered with National University"
    empathy={EMPATHY.nuPgd}
    origin={originShort}
    statIds={['SC-05']}
    partnerGroup="academic"
    method={{ text: 'Practical digital-skills courses, delivered by CodersTrust under National University’s training partnership.', factId: 'SC-04' }}
  >
    <p data-fact="SC-04">CodersTrust has been the official training partner of National University since 2023.</p>
  </GuideSection>

  <!-- C7 -->
  <ProofBand title="Outcomes from CodersTrust’s Wider Programs" eyebrow="From CodersTrust’s Wider Programs (Not This Diploma)" headlineFact="RC-01" trialScope={TRIAL_SCOPE.nuPgd.text} statIds={['RC-02']} compact links={[{ label: 'Impact Survey 2026', href: '/impact/outcomes-2026/' }, { label: 'Read the Full Findings', href: '/impact/' }]}>
    <div class="proof-notes">
      <p>These results come from CodersTrust’s wider training programs, not from the National University Postgraduate Diploma.</p>
    </div>
  </ProofBand>

  <!-- C8 -->
  <Section id="steps" tone="airy" aria-labelledby="steps-h">
    <SectionHeader id="steps-h" eyebrow="How It Works" title="How It Works in Three Steps" />
    <StepFlow
      steps={[
        { title: 'Apply', text: 'Complete the application form.' },
        { title: 'Learn', text: 'Attend the diploma courses.' },
        { title: 'Prepare for Work', text: 'Take your new skills into interviews, freelance work or your next role.' },
      ]}
    />
  </Section>

  <!-- C9 -->
  <FaqSection sources={faqSources} title="Questions Applicants Ask" />

  <!-- C11: Start band; the facts live in Before You Apply above and are not repeated here -->
  <OfferSection title="Start Your Application" lead="Eligibility, schedule, fee, payment and recognition are in Before You Apply above.">
    <p class="note note--key"><a class="link" href="#before-you-apply">Read Before You Apply<Icon name="arrow-right" size={16} /></a> or call <a class="link" href={NU_CALL.href}><Icon name="phone" size={16} />{NU_CALL_NUMBER}</a> to ask admissions.</p>
  </OfferSection>

  <!-- C12 -->
  <RiskSection
    title="Talk to Admissions Before You Decide"
    points={[
      { icon: 'phone', title: 'Ask First', text: 'Call with your eligibility and recognition questions before you apply.' },
      { icon: 'handshake', title: 'Applying Starts a Conversation', text: 'After you apply, our admissions team contacts you with the next steps.' },
    ]}
  />

  <!-- C13 + C14 (WP24c): "Ready to Apply?" and "What Happens After You Apply" are one band -->
  <CTABand id="cta" heading="Ready to Apply?" text="Submit the application form. Our admissions team will contact you with the next steps." cta={apply} secondary={NU_CALL}>
    <ol class="after" aria-label="What Happens After You Apply">
      <li><strong>Submit the Application Form.</strong> It takes you to the standalone application form.</li>
      <li><strong>Admissions Contacts You.</strong> Our admissions team shares the next steps.</li>
    </ol>
  </CTABand>

  <Section pad="sm" aria-label="Last updated">
    <p class="updated">Last updated <time datetime={isoDate(PAGE_UPDATED.nu)}>{formatDate(PAGE_UPDATED.nu)}</time></p>
  </Section>
</LandingLayout>

<style>
  .courses {
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) {
    .courses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .proof-notes {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-md);
    max-width: 56rem;
  }
  .proof-notes :global(p) {
    margin: 0;
    color: var(--ctx-text);
  }
  .after {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
    max-width: 40rem;
    text-align: left;
  }
  .after li {
    color: var(--ctx-text);
  }
  .after strong {
    color: var(--ctx-section-heading);
  }
  .keyfacts {
    margin: 0;
    display: grid;
    gap: var(--space-sm) var(--space-lg);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
  }
  .keyfacts div {
    display: grid;
    gap: 2px;
  }
  .keyfacts dt {
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
  }
  .keyfacts dd {
    margin: 0;
    color: var(--on-surface);
    font-weight: var(--fw-medium);
  }
  /* a figure in the key-facts row is a label, not a sentence: no full stop */
  .keyfacts :global(.fact__stop) {
    display: none;
  }
  @media (min-width: 768px) {
    .keyfacts {
      grid-template-columns: repeat(2, minmax(0, auto));
    }
  }
  .ba {
    margin: 0;
    display: grid;
    gap: var(--space-sm);
    max-width: 56rem;
  }
  .ba__row {
    display: grid;
    gap: 4px;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--outline-variant);
  }
  @media (min-width: 768px) {
    .ba__row {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-md);
      align-items: baseline;
    }
  }
  .ba dt {
    font-weight: var(--fw-bold);
    color: var(--secondary);
  }
  .ba dd {
    margin: 0;
    color: var(--on-surface);
  }
  .updated {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
