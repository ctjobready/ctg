---
// P16–P17 — NU PGD course pages /programs/nu-postgraduate-diploma/digital-marketing/, /ict/, /cyber-security/ and /data-analytics/ (T10), generated from the
// `nu-pgd` collection (kind: course). One H1 (the course name). Moved under /programs/ in WP20a. Every course-specific line (the FAQ answers,
// the related fields) is derived from the course's module list; nothing promises an outcome.
// WP76 (owner answer 2026-10-22: the diploma has four courses): Cyber Security and Data Analytics are added the same way (the same bands, the same Before You Apply rows, the same FAQ questions); "Also Consider", which named the one other course, names the other
// three (src/components/pages/programs/nuPgd.ts holds each course's copy), and the line under "What You Study" is the course's own (its last module differs).
// WP30d (owner direction 2026-10-14: less is more): the generic "What Is CodersTrust?" band, the instructors line, the wider-programs outcome band and the two FAQ answers that repeated the
// module list and the Before You Apply table are cut.
// WP46 (cycle-22 review): the "What You Will Work On" band (#why) is cut too: its points restated the module list in "What You Study" directly above. "Also Consider" turns white, so the bands
// keep alternating (airy "What You Study", white "Also Consider", ice FAQ) instead of two airy bands in a row.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Button from '../../../components/system/Button.astro';
import Icon from '../../../components/system/Icon.astro';
import NuNoticeLinks from '../../../components/pages/programs/NuNoticeLinks.astro';
import Fact from '../../../components/facts/Fact.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import FaqSection from '../../../components/pages/programs/FaqSection.astro';
import { anchor, faqNode, type FaqSource } from '../../../components/pages/programs/faq';
import { PAGE_UPDATED } from '../../../components/pages/programs/meta';
import { NU_APPLY, NU_CALL, NU_CALL_NUMBER, NU_CALL_TEXT, NU_COURSE_COPY, NU_LOCATION_NOTE, NU_NAME, NU_PATH, NU_SCHEDULE_NOTE, nuCourses, nuFitSentence, nuModuleFaqs, nuOverview } from '../../../components/pages/programs/nuPgd';
import { NU_ELIGIBILITY } from '../../../data/copy';
import { COURSES_URL } from '../../../lib/site';
import { formatDate, isoDate } from '../../../lib/format';
import { ORG_ID, course as courseNode, pageUrl, ref, webPage } from '../../../lib/schema';
import { linkAttrs, url } from '../../../lib/url';

export async function getStaticPaths() {
  const courses = await nuCourses();
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}
const { course: c } = Astro.props;
const slug = c.slug;
const copy = NU_COURSE_COPY[slug];
const path = `${NU_PATH}${slug}/`;
const overview = await nuOverview();
const apply = { label: NU_APPLY.label, href: overview.data.applyUrl };
const applyLink = linkAttrs(apply.href);
const LAST_UPDATED = PAGE_UPDATED.nuCourse;
// One eligibility rule on every NU page: the overview rule (NU-01), so the three pages never differ.
const eligibilityId = 'NU-01';

// WP76: "Also Consider" names the other three courses (it named the one other course), each after its own "Prefer ...?" question, in the diploma's course order.
const others = (await nuCourses()).filter((x) => x.slug !== slug);

const faqSources: FaqSource[] = [
  // "What Will I Study?" repeats the module list above; the second answer names concrete modules.
  ...nuModuleFaqs(c).slice(1),
  // WP27: admissions' own eligibility sentence (NU-01), the one every NU page states. WP49 (cycle-24 review): the sentence after it is the course's own (nuFitSentence: what the course teaches, from its module list), no longer the one both course pages shared.
  { q: 'Is This the Right Course for Me?', html: `Eligibility: ${NU_ELIGIBILITY}. ${nuFitSentence(c)} Not right if you want a short self-paced course: see ${anchor(COURSES_URL, 'JobReady.global')}.`, evidence: [eligibilityId] },
];

const jsonLd = [
  webPage({ path, name: c.title, description: copy.description, dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path: '/programs/' }, { name: 'NU Post Graduate Diploma', path: NU_PATH }, { name: c.title, path }] }),
  {
    ...courseNode({ path, name: c.title, description: copy.description }),
    offers: { '@type': 'Offer', category: 'Paid', price: '50000', priceCurrency: 'BDT', url: pageUrl(path) },
    provider: [ref(ORG_ID), { '@type': 'EducationalOrganization', name: 'National University, Bangladesh', url: 'https://www.nu.ac.bd' }],
  },
  faqNode(faqSources, path),
];
---

<BaseLayout title={copy.titleTag} description={copy.description} path={path} breadcrumbs={[{ label: 'Programs', href: '/programs/' }, { label: 'NU Post Graduate Diploma', href: NU_PATH }, { label: c.title }]} jsonLd={jsonLd}>
  <Hero eyebrow={NU_NAME} title={c.title} lead={copy.lead} artSeed={`nu-${slug}`}>
    <Fragment slot="actions">
      <Button href={apply.href} iconEnd="arrow-right">{apply.label}</Button>
      <a class="link" href={NU_CALL.href}>{NU_CALL_TEXT}</a>
      <!-- WP27: intake, schedule and location are not published; the link goes to the admissions contact block, where they are confirmed with each applicant -->
      <a class="link" href="#admissions-contact">Confirm Intake, Schedule and Location</a>
    </Fragment>
    <dl slot="stats" class="keyfacts">
      <div><dt>Duration</dt><dd><Fact id="NU-02" /></dd></div>
      <div><dt>Program Fee</dt><dd><Fact id="NU-03" /></dd></div>
    </dl>
  </Hero>

  <Section id="before-you-apply" aria-labelledby="before-h">
    <SectionHeader id="before-h" eyebrow="Admissions" title="Before You Apply" lead="Program details as stated for this course in the National University Post Graduate Diploma." />
    <dl class="ba">
      <div class="ba__row"><dt>Eligibility</dt><dd><Fact id={eligibilityId} /></dd></div>
      <div class="ba__row"><dt>Duration</dt><dd><Fact id="NU-02" /></dd></div>
      <div class="ba__row"><dt>Credit Hours and Subjects</dt><dd><Fact id="NU-09" /></dd></div>
      <div class="ba__row"><dt>Schedule and Intake</dt><dd>{NU_SCHEDULE_NOTE} <NuNoticeLinks /></dd></div>
      <div class="ba__row"><dt>Delivery</dt><dd><Fact id="NU-10" /></dd></div>
      <div class="ba__row"><dt>Teaching Location</dt><dd>{NU_LOCATION_NOTE}</dd></div>
      <div class="ba__row"><dt>Program Fee</dt><dd><Fact id="NU-03" /></dd></div>
      <div class="ba__row"><dt>Payment</dt><dd><Fact id="NU-05" /></dd></div>
      <div class="ba__row"><dt>Recognition</dt><dd><Fact id="NU-04" /></dd></div>
      <div class="ba__row" id="admissions-contact"><dt>How to Apply</dt><dd>Complete the <a class="link" href={applyLink.href} rel={applyLink.rel}>application form</a>. For help, call <a class="link" href={NU_CALL.href}>{NU_CALL_NUMBER}</a> or email <a class="link" href="mailto:hello@coderstrustbd.com">hello@coderstrustbd.com</a>.</dd></div>
    </dl>
  </Section>

  <Section id="who" aria-labelledby="who-h">
    <SectionHeader id="who-h" eyebrow="Who It Is For" title="For Learners Who Want a Digital Career" lead={`Eligibility: ${NU_ELIGIBILITY}. Right for you if you meet that and want to add practical digital skills. If you want a short self-paced course instead, see JobReady.global.`} />
    {
      c.roles.length > 0 && (
        <div class="roles" data-reveal>
          <h3 class="t-heading-l">Fields This Diploma Can Support</h3>
          <ul role="list">
            {c.roles.map((r) => <li>{r}</li>)}
          </ul>
          <p class="roles__note">These are related fields; role readiness depends on your experience, portfolio and local market.</p>
        </div>
      )
    }
  </Section>

  <Section id="curriculum" tone="airy" aria-labelledby="curriculum-h">
    <SectionHeader id="curriculum-h" eyebrow="Curriculum" title="What You Study" lead={copy.studyLead} />
    <details class="mods">
      <summary>View All {c.modules.length} Modules</summary>
      <ol class="modgrid" role="list" aria-label={`${c.title} modules`}>
        {c.modules.map((m, i) => (
          <li class="modgrid__item">
            <span class="modgrid__num" aria-hidden="true">{i + 1}</span>
            <span class="modgrid__name"><span class="sr-only">Module {i + 1}: </span>{m}</span>
          </li>
        ))}
      </ol>
    </details>
  </Section>

  <Section id="also-consider" aria-labelledby="also-h">
    <SectionHeader id="also-h" eyebrow="Also Consider" title="Other NU Post Graduate Diploma Courses" />
    <ul class="others" role="list">
      {others.map((o) => <li>{NU_COURSE_COPY[o.slug].prefer} The <a class="link" href={url(`${NU_PATH}${o.slug}/`)}>{o.title}</a> is the course for those modules.</li>)}
    </ul>
    <p><a class="link" href={url(NU_PATH)}>See the NU Post Graduate Diploma Overview<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <FaqSection sources={faqSources} title="Questions About This Course" />

  <!-- C13 + C14 (WP24c): "Ready to Apply?" and "What Happens After You Apply" are one band -->
  <CTABand id="cta" heading="Ready to Apply?" text="Submit the application form. Our admissions team will contact you with the next steps." cta={apply} secondary={NU_CALL}>
    <ol class="after" aria-label="What Happens After You Apply">
      <li><strong>Submit the Application Form.</strong> It takes you to the standalone application form.</li>
      <li><strong>Admissions Contacts You.</strong> Our admissions team shares the next steps.</li>
    </ol>
  </CTABand>

  <Section pad="sm" aria-label="Last updated">
    <p class="updated">Last updated <time datetime={isoDate(LAST_UPDATED)}>{formatDate(LAST_UPDATED)}</time></p>
  </Section>
</BaseLayout>

<style>
  .after {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
    max-width: 40rem;
    text-align: left;
  }
  .after li {
    color: var(--ctx-text);
  }
  .after strong {
    color: var(--ctx-section-heading);
  }
  .keyfacts {
    margin: 0;
    display: grid;
    gap: var(--space-sm) var(--space-lg);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
  }
  .keyfacts div {
    display: grid;
    gap: var(--space-xs);
  }
  .keyfacts dt {
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
  }
  .keyfacts dd {
    margin: 0;
    color: var(--on-surface);
    font-weight: var(--fw-medium);
  }
  /* a figure in the key-facts row is a label, not a sentence: no full stop */
  .keyfacts :global(.fact__stop) {
    display: none;
  }
  @media (min-width: 768px) {
    .keyfacts {
      grid-template-columns: repeat(2, minmax(0, auto));
    }
  }
  .mods > summary {
    cursor: pointer;
    font-weight: var(--fw-bold);
    color: var(--secondary);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .mods[open] > summary {
    margin-bottom: var(--space-md);
  }
  .modgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .modgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .modgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .modgrid__item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--surface);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    min-width: 0;
  }
  .modgrid__num {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: var(--on-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-bold);
    font-size: var(--fs-body-xs);
  }
  .modgrid__name {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
    overflow-wrap: anywhere;
  }
  .roles h3 {
    margin: 0 0 var(--space-sm);
    color: var(--secondary);
  }
  .roles ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .roles__note {
    margin: var(--space-sm) 0 0;
    color: var(--on-surface-variant);
    max-width: 52rem;
  }
  .roles li {
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-pill);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
    font-weight: var(--fw-medium);
    font-size: var(--fs-body-base);
  }
  .ba {
    margin: 0;
    display: grid;
    gap: var(--space-sm);
    max-width: 56rem;
  }
  .ba__row {
    display: grid;
    gap: var(--space-xs);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--outline-variant);
  }
  @media (min-width: 768px) {
    .ba__row {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-md);
      align-items: baseline;
    }
  }
  .ba dt {
    font-weight: var(--fw-bold);
    color: var(--secondary);
  }
  .ba dd {
    margin: 0;
    color: var(--on-surface);
  }
  .updated {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
  /* "Also Consider" (WP76): the other three courses, one sentence each, as plain text lines (no cards, no new elements) */
  .others {
    list-style: none;
    margin: 0 0 var(--space-md);
    padding: 0;
    display: grid;
    gap: var(--space-sm);
    max-width: 52rem;
    color: var(--on-surface);
  }
</style>
