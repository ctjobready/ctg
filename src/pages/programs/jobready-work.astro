---
// P13 — JobReady@Work /programs/jobready-work/ (T3 conversion page; doc 04 matrix 4.6 — employers; C1 → C14).
import LandingLayout from '../../layouts/LandingLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import StepFlow from '../../components/ui/StepFlow.astro';
import CTABand from '../../components/ui/CTABand.astro';
import FeatureCard from '../../components/ui/FeatureCard.astro';
import Button from '../../components/system/Button.astro';
import HeroBand from '../../components/sections/HeroBand.astro';
import FutureBand from '../../components/sections/FutureBand.astro';
import { futurePhotos } from '../../data/photos';
import ProofBand from '../../components/sections/ProofBand.astro';
import CaseStudyCarousel from '../../components/sections/CaseStudyCarousel.astro';
import FeaturesTable from '../../components/sections/FeaturesTable.astro';
import Fact from '../../components/facts/Fact.astro';
import ProgramGlance from '../../components/pages/programs/ProgramGlance.astro';
import InShort from '../../components/pages/partners/InShort.astro';
import PairedEvidence from '../../components/pages/partners/PairedEvidence.astro';
import CopyP from '../../components/pages/programs/CopyP.astro';
import DefinitionBlock from '../../components/pages/programs/DefinitionBlock.astro';
import ProblemSection from '../../components/pages/programs/ProblemSection.astro';
import CostSection from '../../components/pages/programs/CostSection.astro';
import GuideSection from '../../components/pages/programs/GuideSection.astro';
import MechanismSection from '../../components/pages/programs/MechanismSection.astro';
import PhaseList from '../../components/pages/programs/PhaseList.astro';
import FaqSection from '../../components/pages/programs/FaqSection.astro';
import OfferSection from '../../components/pages/programs/OfferSection.astro';
import RiskSection from '../../components/pages/programs/RiskSection.astro';
import NextSteps from '../../components/pages/programs/NextSteps.astro';
import { faqNode, type FaqSource } from '../../components/pages/programs/faq';
import { C14_FIRST, PAGE_UPDATED, ctaFor, serviceNode, statValue } from '../../components/pages/programs/meta';
import { EMPATHY, MICRO_COMMITMENT, ORIGIN, POSITIONING, PRICING, SURVEY_EMPLOYMENT, TRIAL_SCOPE, VALUE_PROPOSITION } from '../../data/copy';
import { fact } from '../../data/facts';
import { contractScope } from '../../components/sections/copyText';
import { formatDate, isoDate } from '../../lib/format';
import { webPage } from '../../lib/schema';

const path = '/programs/jobready-work/';
const LAST_UPDATED = PAGE_UPDATED.work;
const title = 'JobReady@Work: Upskill Teams, Hire Talent';
const description = `JobReady@Work builds custom AI-ready training for your team and sources job-ready talent. Globally, ${statValue('PX-05')} of employers report difficulty finding talent.`;
const work = ctaFor('work');
const talent = ctaFor('talent');
const pricingFirst = PRICING.text.split('. ')[0] + '.';

const faqSources: FaqSource[] = [
  { q: 'Is JobReady@Work Right for Us?', html: 'Right for you if you want tracks built around the skills your roles need. Talent requests are scoped against the experience and credentials available in the candidate pool.', evidence: ['IN-10', 'IN-04'] },
  { audience: 'employers', id: 'Q5' },
  { audience: 'employers', id: 'Q1' },
  { audience: 'employers', id: 'Q12' },
  { audience: 'variants', id: 'Q8-employer' },
  { audience: 'employers', id: 'Q11' },
];

const jsonLd = [
  webPage({ path, name: 'JobReady@Work', description, dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path: '/programs/' }, { name: 'JobReady@Work', path }] }),
  serviceNode({ path, name: 'JobReady@Work', description: fact('IN-10').text, audience: 'Employers and corporates' }),
  faqNode(faqSources, path),
];

const approach = [
  { title: 'Needs Assessment', text: 'Scopes the skills and team size.' },
  { title: 'Customized Solution', text: 'A program shaped around your roles.' },
  { title: 'Comprehensive Curriculum', text: 'Custom-developed for your organization.' },
  { title: 'Interactive Workshops', text: 'Your team learns on tasks from your own roles.' },
  { title: 'Progress Evaluation', text: 'Checked against the measures you set.' },
  { title: 'Post-Training Support', text: 'Support continues after the workshops.' },
  { title: 'Measurable Outcomes', text: 'Success measures are agreed before you start.' },
].map((s) => ({ ...s, factIds: ['IN-10'] }));
---

<LandingLayout title={title} description={description} path={path} breadcrumbs={[{ label: 'Programs', href: '/programs/' }, { label: 'JobReady@Work' }]} jsonLd={jsonLd} stickyCta={work}>
  <!-- C1 -->
  <HeroBand
    audience="JobReady@Work · For Employers"
    title="Build the Digital Capabilities Your Teams Need Now."
    lead={VALUE_PROPOSITION.employers}
    cta={work}
    artSeed="jobready-work"
  />

  <DefinitionBlock heading="What Is JobReady@Work?">
    <p data-fact="IN-10"><Fact id="IN-10" />.</p>
  </DefinitionBlock>

  <ProgramGlance
    rows={[
      { label: 'Who It Is For', text: 'Employers who want their teams upskilled for AI workflows, and job-ready digital talent for open roles.', facts: ['IN-10'] },
      { label: 'Delivery', text: 'A program custom-developed for each organization: a needs assessment, a customized curriculum and interactive workshops.', facts: ['IN-10'] },
      { label: 'Training', text: 'Soft-skills and hard-skills tracks, built around the tasks in your own roles; AI leadership programs with AIvolve.', facts: ['IN-10', 'PA-07'] },
      { label: 'Certification Preparation', text: 'Preparation for an industry certification where a track offers one; exam eligibility and attempts are agreed in the program scope.', facts: ['PD-03'] },
      { label: 'Talent', text: 'Job-ready candidates through CodersTrust’s placement team, scoped against the experience and credentials available.', facts: ['IN-04'] },
      { label: 'Measuring Progress', text: 'Post-training support and a progress evaluation against the measures you set.', facts: ['IN-10'] },
      { label: 'Agreed Before You Start', text: 'The skills and team size from the needs assessment, the success measures, and the scope and price of the program.', facts: ['IN-10', 'PD-02'] },
    ]}
  />

  <!-- C2 -->
  <ProblemSection
    title="You Cannot Find the Digital Talent You Need."
    bluf="Hiring alone is not closing the gap, and your teams need AI skills now."
    factIds={['PX-05']}
    scope={{ 'PX-05': { label: 'of employers worldwide report difficulty finding the talent they need' } }}
    extra={[
      { title: 'Hiring Alone Does Not Close the Skills Gap', text: `${statValue('PX-05')} of employers worldwide report difficulty finding the talent they need, so hiring alone does not close the gap.`, factIds: ['PX-05'] },
      { title: 'Your Teams Need Upskilling for AI Workflows', text: 'Training works best when it is built around the tasks in your own roles.', factIds: ['IN-10'] },
    ]}
  />

  <!-- C3 -->
  <CostSection
    title="AI Is Changing the Skills Your Teams Need."
    blocks={[
      { claim: 'Jobs That Need AI Skills Are Growing Fast.', factId: 'PX-08', scope: 'Globally', implication: 'Employers are creating roles that need AI skills, and training plans need to keep pace.' },
      { claim: 'AI Is Changing the Job Mix by 2030.', factId: 'PX-07', scope: 'Globally', implication: 'Upskilling now keeps your team ahead of the change.' },
    ]}
  />

  <!-- C4 -->
  <FutureBand
    photos={futurePhotos('jobready-work')}
    title="What Changes for Your Team"
    lead="Illustrative: a team applies AI tools in daily work, and job-ready candidates are sourced for open roles."
    vignettes={[
      { kind: 'Functional', title: 'A Team That Uses AI Tools Every Day', text: 'Workshops start from tasks in your own roles, so the skills carry straight into daily work.' },
      { kind: 'Emotional', title: 'A Job-Ready Candidate Pipeline', text: 'Candidates are sourced through CodersTrust’s placement team and scoped against the experience and credentials available for each role; those who pass an exam hold the industry certification.' },
      { kind: 'Social', title: 'Progress You Can Measure', text: 'Success measures are agreed before you start and checked in the progress evaluation.' },
    ]}
  />

  <!-- C5 -->
  <GuideSection
    title="Employers and Partners We Work With"
    empathy={EMPATHY.employers}
    origin={ORIGIN}
    statIds={['SC-15']}
    partnerGroup="private"
    method={{ text: 'JobReady@Work builds each program around a needs assessment, on the TalentLEAP model.', factId: 'IN-06', link: { label: 'How TalentLEAP Works', href: '/our-model/talentleap/' } }}
  >
    <ul class="guide-list" role="list">
      <li data-fact="PA-06"><Fact id="PA-06" />.</li>
      <li data-fact="PA-07"><Fact id="PA-07" />.</li>
      <li data-fact="GV-06">{contractScope('GV-06')}</li>
    </ul>
  </GuideSection>

  <!-- C6 -->
  <MechanismSection title="A Program Built Around Your Roles" positioning={POSITIONING.work} lead="JobReady@Work is custom-developed for each organization, in seven steps." eyebrow="How It Works">
    <PhaseList items={approach} cols={4} label="JobReady@Work approach" />
    <div class="tracks" data-fact="IN-10 PA-07 IN-04">
      <FeatureCard icon="layers" title="Soft-Skills and Hard-Skills Tracks" text="Programs combine both, depending on the roles you are building for." />
      <FeatureCard icon="sparkles" title="AI Leadership Programs" text="Offered in partnership with AIvolve Leadership Dynamics GmbH." />
      <FeatureCard icon="briefcase" title="Talent Through Our Placement Team" text="Job-ready candidates are supplied through CodersTrust’s placement team. The employer and gig-work (Earn) marketplace is in pre-launch and is designed to add a self-serve hiring channel." />
    </div>
  </MechanismSection>

  <!-- C8 -->
  <FeaturesTable
    title="Each Feature Maps to What Employers Ask For."
    rows={[
      { feature: 'A Placement Team Plus Trainees from Employer-Demand Certification Tracks', means: 'you get a short route to job-ready candidates.', outcome: 'Job-ready candidates for your roles', relieves: 'You cannot find the digital talent you need' },
      { feature: 'An AI-Ready Curriculum, with Each Track’s AI Content and Work-Entry Plan Agreed Before Enrollment', means: 'your training includes AI content agreed before enrollment.', outcome: 'People ready to work with AI tools', relieves: 'Hiring Alone Does Not Close the Skills Gap' },
      { feature: 'A Customized Curriculum and Interactive Workshops', means: 'your team learns on tasks from your own roles.', outcome: 'A team trained on its own tasks', relieves: 'Your teams need upskilling for AI workflows' },
    ]}
  />
  <Section id="steps" tone="airy" aria-labelledby="steps-h">
    <SectionHeader id="steps-h" eyebrow="How It Works" title="How It Works in Three Steps" lead="Success measures are agreed during the needs assessment, before the program starts." />
    <div data-fact="IN-10 PD-03">
      <StepFlow
        steps={[
          { title: 'Assess', text: 'A needs assessment scopes the skills and team size.' },
          { title: 'Prepare for Certification', text: 'Custom curriculum and workshops, including preparation for an industry certification where a track offers one; exam eligibility and attempts are agreed in the program scope.' },
          { title: 'Support and Measure', text: 'Post-training support and a progress evaluation against the measures you set.' },
        ]}
      />
    </div>
  </Section>

  <!-- C9 -->
  <FaqSection sources={faqSources} title="Questions Employers Ask" />


  <PairedEvidence
    title="The Delivery Record for Employers"
    items={[
      { id: 'PA-06', label: 'Cloud Training' },
      { id: 'PA-07', label: 'AI Leadership' },
      { id: 'SC-15', label: 'Corporate Delivery', stat: true },
    ]}
    broaderLabel="Broader Evidence from Our Youth Programs (Not Corporate Training)"
    broader={[
      { label: 'Evidence Below', href: '#proof-band' },
      { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' },
      { label: 'Outcomes 2026', href: '/impact/outcomes-2026/' },
    ]}
  />

  <!-- C11 -->
  <OfferSection
    title="A Training Program for Your Team, and Talent When You Need It"
    lead="Pick one or both."
    cards={[
      { icon: 'presentation', title: 'Train Your Team', text: 'A training program scoped to your team: needs assessment, a customized curriculum and interactive workshops.' },
      { icon: 'briefcase', title: 'Hire Job-Ready Talent', text: 'Access to job-ready candidates through CodersTrust’s placement team.' },
    ]}
  >
    <p class="note note--key" data-fact="PD-02">Pricing is set per program and shared after the needs assessment.</p>
  </OfferSection>

  <!-- C7, moved below the employer offer (review round 3): the employer journey leads with the employer facts; this is the youth-program evidence. -->
  <ProofBand title="The Evidence" eyebrow="From CodersTrust’s Youth Programs (Not Corporate Training)" headlineFact="RC-01" trialScope={TRIAL_SCOPE.work.text} statIds={['RC-02', 'RC-01', 'OC-03']} links={[{ label: 'Outcomes 2026', href: '/impact/outcomes-2026/' }, { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' }]}>
    <div class="proof-notes">
      <p data-fact="OC-07"><strong>From CodersTrust’s youth programs:</strong> <Fact id="OC-07" /></p>
      <CopyP block={SURVEY_EMPLOYMENT} lead="From CodersTrust’s youth programs:" />
      <p data-fact="PD-03 PD-10">Certification tracks are chosen from employer demand.</p>
    </div>
  </ProofBand>
  <CaseStudyCarousel
    title="Proof in Practice"
    items={[
      { title: 'Women’s Skill Development for Freelancing Marketplace (WSDFM)', program: 'Commissioned by Porticus', factId: 'PR-01', href: '/impact/case-studies/wsdfm-women-freelancers/' },
      { title: 'Women in Online Work, Kosovo', program: 'World Bank Group', factId: 'PR-02', href: '/impact/case-studies/kosovo-women-in-online-work/' },
      { title: 'Her Power', program: 'ICT Division / Department of ICT (DoICT)', factId: 'PR-05', href: '/impact/case-studies/her-power/' },
    ]}
  />

  <!-- C12 -->
  <RiskSection
    title="Start with a Pilot Team. Decide on Evidence."
    points={[
      { icon: 'users', title: 'A Pilot Team Comes First', text: 'Start with one team before you widen the program.', factIds: ['IN-10'] },
      { icon: 'target', title: 'Success Measures Set Up Front', text: 'Completion, certification and the skills you name are agreed before you start and checked in the progress evaluation.', factIds: ['IN-10'] },
      { icon: 'handshake', title: 'Scaling Up Is Your Decision', text: 'You choose whether and how far to scale.', factIds: ['IN-10'] },
      { icon: 'shield', title: 'Independent Evaluation Is Welcome', text: 'We support a third-party evaluation of outcomes.', factIds: ['PD-08'] },
    ]}
  />

  <!-- C13: one solid primary; the talent action is outline -->
  <CTABand id="cta" heading="Tell Us About Your Team and Your Roles." cta={work} micro={MICRO_COMMITMENT} secondary={{ label: talent.label, href: talent.href }} />

  <!-- C14 -->
  <NextSteps
    steps={[
      { title: 'Discovery Session', text: 'A conversation about your roles and goals.' },
      { title: 'Needs Assessment', text: 'We scope the skills and team size.' },
      { title: 'Agreement', text: 'Scope, schedule and success measures are agreed.' },
      { title: 'First Workshop or Cohort', text: 'Training starts on tasks from your roles.' },
      { title: 'Progress Evaluation', text: 'Results are checked against your measures.' },
    ]}
    firstAction={C14_FIRST}
  />

  <Section pad="sm" aria-label="Last updated">
    <p class="updated">Last updated <time datetime={isoDate(LAST_UPDATED)}>{formatDate(LAST_UPDATED)}</time></p>
  </Section>
</LandingLayout>

<style>
  .guide-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  .tracks {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .tracks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .proof-notes {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-md);
    max-width: 56rem;
  }
  .proof-notes :global(p) {
    margin: 0;
    color: var(--ctx-text);
  }
  .updated {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
