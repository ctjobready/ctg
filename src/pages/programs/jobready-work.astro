---
// P13 — JobReady@Work /programs/jobready-work/ (T3 conversion page; doc 04 matrix 4.6 — employers; C1 → C14).
// WP30d (owner direction 2026-10-14: less is more): In Short, the definition band, the seven-step process cards and the three track cards are cut; the approach is four
// short blocks (Scope, Deliver, Measure, Support) that keep the "measures you set" and "team capability" wording. #mechanism and #next-steps stay (linked from the employer due-diligence view).
// WP37 (cycle-14 review): the hero serves training and hiring ("Pick one or both"), so "Hire JobReady Talent" (the same prefilled inquiry as the call-to-action band) is a text link right under the one primary button.
import LandingLayout from '../../layouts/LandingLayout.astro';
import Section from '../../components/ui/Section.astro';
import CTABand from '../../components/ui/CTABand.astro';
import HeroBand from '../../components/sections/HeroBand.astro';
import RouteLink from '../../components/pages/partners/RouteLink.astro';
import Fact from '../../components/facts/Fact.astro';
import ProgramGlance from '../../components/pages/programs/ProgramGlance.astro';
import PairedEvidence from '../../components/pages/partners/PairedEvidence.astro';
import GuideSection from '../../components/pages/programs/GuideSection.astro';
import MechanismSection from '../../components/pages/programs/MechanismSection.astro';
import FaqSection from '../../components/pages/programs/FaqSection.astro';
import OfferSection from '../../components/pages/programs/OfferSection.astro';
import RiskSection from '../../components/pages/programs/RiskSection.astro';
import NextSteps from '../../components/pages/programs/NextSteps.astro';
import RouteBlock from '../../components/ui/RouteBlock.astro';
import StepFlow from '../../components/ui/StepFlow.astro';
import { faqNode, type FaqSource } from '../../components/pages/programs/faq';
import { C14_FIRST, PAGE_UPDATED, ctaFor, serviceNode, statValue } from '../../components/pages/programs/meta';
import { EMPATHY, EMPLOYER_HIRING_STEPS, EMPLOYER_PRICING, MICRO_COMMITMENT, POSITIONING } from '../../data/copy';
import { fact } from '../../data/facts';
import { contractScope } from '../../components/sections/copyText';
import { formatDate, isoDate } from '../../lib/format';
import { webPage } from '../../lib/schema';

const path = '/programs/jobready-work/';
const LAST_UPDATED = PAGE_UPDATED.work;
const title = 'JobReady@Work: Upskill Teams, Hire Talent';
// WP48 (cycle-23 review): the employer-shortage figure is dated ("In 2026, 72% of employers globally reported ..."; PX-05's survey is the 2026 one). The first sentence says "sources talent" (it said "job-ready talent", which the hero lead keeps) so the
// description stays within the 155 characters the SEO lint allows.
const description = `JobReady@Work builds custom AI-ready training for your team and sources talent. In 2026, ${statValue('PX-05')} of employers globally reported difficulty finding talent.`;
const work = ctaFor('work');
const talent = ctaFor('talent');

const faqSources: FaqSource[] = [
  { audience: 'variants', id: 'Q8-employer' },
  { audience: 'employers', id: 'Q11' },
];

const jsonLd = [
  webPage({ path, name: 'JobReady@Work', description, dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path: '/programs/' }, { name: 'JobReady@Work', path }] }),
  serviceNode({ path, name: 'JobReady@Work', description: fact('IN-10').text, audience: 'Employers and corporates' }),
  faqNode(faqSources, path),
];

// IN-10: needs assessment → customized solution → comprehensive curriculum → interactive workshops → progress evaluation → post-training support → measurable outcomes.
// WP25s: "checked against the measures you set" belongs to the progress evaluation; the measurable outcome is the team capability named in the needs assessment.
const approach = [
  { label: 'Scope', title: 'Needs Assessment, Then a Customized Solution', text: 'Scopes the skills and team size, then shapes a program around your roles.', icon: 'clipboard-check' },
  { label: 'Deliver', title: 'Custom Curriculum and Interactive Workshops', text: 'Your team learns on tasks from your own roles.', icon: 'presentation' },
  { label: 'Measure', title: 'Progress Evaluation', text: 'Checked against the measures you set.', icon: 'target' },
  { label: 'Support', title: 'Post-Training Support and Measurable Outcomes', text: 'Support continues after the workshops, toward team capability in the digital and AI tasks defined in the needs assessment.', icon: 'handshake' },
];
---

<LandingLayout title={title} description={description} path={path} breadcrumbs={[{ label: 'Programs', href: '/programs/' }, { label: 'JobReady@Work' }]} jsonLd={jsonLd} stickyCta={work}>
  <!-- C1 -->
  <HeroBand
    audience="JobReady@Work · For Employers"
    title="Build AI-Ready Teams Around Your Own Roles"
    lead="JobReady@Work builds custom AI-ready training for your team, from a needs assessment to interactive workshops, and sources job-ready talent through CodersTrust’s placement team. Pick one or both."
    cta={work}
    routeLinks={[{ label: talent.label, href: talent.href }]}
    artSeed="jobready-work"
  />

  <RouteLink kicker="The Partnership Route" label="Employer Partnership Overview" href="/partner-with-us/employers/" />

  <ProgramGlance
    title="JobReady@Work at a Glance"
    rows={[
      { label: 'Who It Is For', text: 'Employers who want their teams upskilled for AI workflows, and job-ready digital talent for open roles, introduced through CodersTrust’s placement team and scoped against the experience and credentials available.', facts: ['IN-10', 'IN-04'] },
      { label: 'Training', text: 'Soft-skills and hard-skills tracks, built around the tasks in your own roles; AI leadership programs with AIvolve. Certification preparation where a track offers one, with exam eligibility and attempts agreed in the program scope.', facts: ['IN-10', 'PA-07', 'PD-03'] },
      { label: 'Measuring Progress', text: 'Post-training support and a progress evaluation against the measures you set, for team capability in the digital and AI tasks defined in the needs assessment.', facts: ['IN-10'] },
    ]}
  />

  <!-- C5 -->
  <GuideSection
    title="Employers and Partners We Work With"
    empathy={EMPATHY.employers}
    statIds={['SC-15']}
    partnerGroup="private"
    method={{ text: 'JobReady@Work builds each program around a needs assessment, on the TalentLEAP model.', factId: 'IN-06', link: { label: 'How TalentLEAP Works', href: '/our-model/talentleap/' } }}
  >
    <ul class="guide-list" role="list">
      <li data-fact="PA-06"><Fact id="PA-06" />.</li>
      <li data-fact="PA-07"><Fact id="PA-07" />.</li>
      <li data-fact="GV-06">{contractScope('GV-06')}</li>
    </ul>
  </GuideSection>

  <!-- C6 -->
  <MechanismSection title="A Program Built Around Your Roles" positioning={POSITIONING.work} eyebrow="How It Works" blocks={approach} factIds={['IN-10']} />

  <!-- Evidence links directly after the mechanism (WP18b, WP31, WP32): the employer credentials (AWS Authorized Training Partner, the AIvolve partnership, the Grameenphone Academy enrollments) are stated once, in
       "Employers and Partners We Work With" above (cycle-9 review: they were repeated here). This strip is two links to the youth programs' evidence; no trial or survey figure is shown on this corporate offer page. -->
  <PairedEvidence
    title="Broader Evidence from Our Youth Programs"
    eyebrow=""
    items={[]}
    broader={[
      { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' },
      { label: 'Impact Survey 2026', href: '/impact/outcomes-2026/' },
    ]}
  />

  <!-- C9: only the questions about the program itself; the audience page answers the rest -->
  <FaqSection sources={faqSources} title="Questions About the Program" />

  <!-- C11 -->
  <OfferSection
    title="A Training Program for Your Team, and Talent When You Need It"
    lead="Pick one or both."
    cards={[
      { icon: 'presentation', title: 'Train Your Team', text: 'A training program scoped to your team: needs assessment, a customized curriculum and interactive workshops.' },
      { icon: 'briefcase', title: 'Hire Job-Ready Talent', text: 'Access to job-ready candidates introduced through CodersTrust’s placement team.' },
    ]}
  >
    <p class="note note--key" data-fact="PD-02">{EMPLOYER_PRICING}</p>
  </OfferSection>

  <!-- C12 -->
  <RiskSection
    title="Start with a Pilot Team, Then Decide on Evidence"
    points={[
      { icon: 'users', title: 'A Pilot Team Comes First', text: 'Start with one team before you widen the program.', factIds: ['IN-10'] },
      { icon: 'target', title: 'Success Measures Set Up Front', text: 'Completion, certification and the skills you name are agreed before you start and checked in the progress evaluation.', factIds: ['IN-10'] },
      { icon: 'handshake', title: 'Scaling Up Is Your Decision', text: 'You choose whether and how far to scale.', factIds: ['IN-10'] },
      { icon: 'shield', title: 'Independent Evaluation Is Welcome', text: 'We support a third-party evaluation of outcomes.', factIds: ['PD-08'] },
    ]}
  />

  <!-- C13: one solid primary; the talent action is outline -->
  <CTABand id="cta" heading="Tell Us About Your Team and Your Roles" cta={{ label: 'Plan Your First Team Program', href: work.href }} micro={MICRO_COMMITMENT} secondary={{ label: talent.label, href: talent.href }} />

  <!-- C14. WP34 (cycle-11 review): the page offers training and hiring, so the steps are labeled "For Team Training" and hiring has its own short route; the "Hire JobReady Talent" link stays in the C13 band above (and, WP37, in the hero).
       WP47 (cycle-22 review): the hiring route is the Employers page's two steps (EMPLOYER_HIRING_STEPS), in the same step component as the training route (it was one sentence beside five steps). -->
  <NextSteps
    route="For Team Training"
    steps={[
      { title: 'Discovery Session', text: 'A conversation about your roles and goals.' },
      { title: 'Needs Assessment', text: 'We scope the skills and team size.' },
      { title: 'Agreement', text: 'Scope, schedule and success measures are agreed.' },
      { title: 'First Workshop or Cohort', text: 'Training starts on tasks from your roles.' },
      { title: 'Progress Evaluation', text: 'Results are checked against your measures.' },
    ]}
    firstAction={C14_FIRST}
  >
    <RouteBlock label="For Hiring">
      <div data-fact="IN-04"><StepFlow level={4} steps={EMPLOYER_HIRING_STEPS} /></div>
    </RouteBlock>
  </NextSteps>

  <Section pad="sm" aria-label="Last updated">
    <p class="updated">Last updated <time datetime={isoDate(LAST_UPDATED)}>{formatDate(LAST_UPDATED)}</time></p>
  </Section>
</LandingLayout>

<style>
  .guide-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  .updated {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
