---
// P10 — YouthWIDE /programs/youthwide/ (T3 conversion page; doc 04 matrices 4.1, 4.2 and 4.3; C1 → C14).
// One page for both audiences (WP4c: NationWIDE was renamed YouthWIDE and merged in): governments and ministries (the Bangladesh national
// initiative, #governments) and funders and development partners (country cohorts, #funders). WP18b: C2–C6 are ONE shared sequence; each
// band carries two compact audience sub-blocks ("Government Delivery", "Funders and Development Partners") instead of two stacked journeys.
// The evidence, features, FAQ, comparison, offer, risk and call-to-action bands follow.
import InShort from '../../components/pages/partners/InShort.astro';
import ProgramGlance from '../../components/pages/programs/ProgramGlance.astro';
import ReviewPanels from '../../components/pages/hub/ReviewPanels.astro';
import LandingLayout from '../../layouts/LandingLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import SessionAgenda from '../../components/ui/SessionAgenda.astro';
import EmailFallback from '../../components/ui/EmailFallback.astro';
import Hero from '../../components/system/Hero.astro';
import Button from '../../components/system/Button.astro';
import StatusTag from '../../components/system/StatusTag.astro';
import EvidenceBand from '../../components/pages/home/EvidenceBand.astro';
import FutureBand from '../../components/sections/FutureBand.astro';
import { futurePhotos, galleryPhotos } from '../../data/photos';
import PhotoGallery from '../../components/ui/PhotoGallery.astro';
import CaseStudyCarousel from '../../components/sections/CaseStudyCarousel.astro';
import FeaturesTable from '../../components/sections/FeaturesTable.astro';
import ComparisonBand from '../../components/sections/ComparisonBand.astro';
import Icon from '../../components/system/Icon.astro';
import Badge from '../../components/system/Badge.astro';
import Fact from '../../components/facts/Fact.astro';
import FactStat from '../../components/facts/FactStat.astro';
import GainsPains from '../../components/pages/partners/GainsPains.astro';
import CopyP from '../../components/pages/programs/CopyP.astro';
import DefinitionBlock from '../../components/pages/programs/DefinitionBlock.astro';
import ProblemSection from '../../components/pages/programs/ProblemSection.astro';
import PriorityGroups from '../../components/pages/programs/PriorityGroups.astro';
import CostSection from '../../components/pages/programs/CostSection.astro';
import GuideSection from '../../components/pages/programs/GuideSection.astro';
import MechanismSection from '../../components/pages/programs/MechanismSection.astro';
import DeliveryGrid from '../../components/pages/programs/DeliveryGrid.astro';
import WorkEntryPlan from '../../components/pages/programs/WorkEntryPlan.astro';
import ExecutionRoadmap from '../../components/pages/programs/ExecutionRoadmap.astro';
import ReportingBlock from '../../components/pages/programs/ReportingBlock.astro';
import FaqSection from '../../components/pages/programs/FaqSection.astro';
import Raci from '../../components/pages/programs/Raci.astro';
import OfferSection from '../../components/pages/programs/OfferSection.astro';
import RiskSection from '../../components/pages/programs/RiskSection.astro';
import DecisionSheet from '../../components/pages/programs/DecisionSheet.astro';
import NextSteps from '../../components/pages/programs/NextSteps.astro';
import { faqNode, type FaqSource } from '../../components/pages/programs/faq';
import { C14_FIRST, PAGE_UPDATED, ROADMAP_PHASES, ctaFor, serviceNode, statValue } from '../../components/pages/programs/meta';
import { ACCOUNTABILITY, C14, EMPATHY, FUNDER_PAINS, MICRO_COMMITMENT, ORIGIN, POSITIONING, PRICING, PROGRAM_OPTIONS, SAFEGUARDING, SCALE, SCORECARD, SPEED, TRAINED_REACH, GOVERNANCE, painForList, painForRow } from '../../data/copy';
import { fact } from '../../data/facts';
import { CLAIM_PX06, CLAIM_PX11, CLAIM_RC06, contractScope, endSentence, graduateRates } from '../../components/sections/copyText';
import { formatDate, isoDate } from '../../lib/format';
import { pageUrl } from '../../lib/schema';
import { webPage } from '../../lib/schema';
import { url } from '../../lib/url';

const path = '/programs/youthwide/';
const LAST_UPDATED = '2026-10-14'; // WP20c: the day the review round 5 cycle 3 wording changes landed (PAGE_UPDATED.youthwide is 2026-10-11)
const target = statValue('IN-01');
const title = 'YouthWIDE: Youth Digital Employment Program';
const description = `YouthWIDE prepares educated, unemployed youth for paid digital work: a national initiative in Bangladesh and co-funded country cohorts elsewhere.`;
const discovery = ctaFor('discovery');
const briefing = ctaFor('briefing');
const cofunding = ctaFor('nationalFunding');
const nationalSize = PROGRAM_OPTIONS[2].size.split(' ')[0];
const rates = graduateRates();

const hours = statValue('PD-01');

const faqSources: FaqSource[] = [
  { q: 'Is YouthWIDE Right for Our Agency?', html: `Right for you if you want employment outcomes tracked after blended training delivered through existing government labs and colleges. YouthWIDE is not the right fit if you need a ${nationalSize} rollout delivered by one provider in a single phase; we plan national delivery phase by phase.`, evidence: ['PD-05'] },
  // Q9 (safeguarding) is not repeated here: the Safeguarding block in the governance section is the page's one statement of it.
  // WP24c: the six decision questions (fit, country, national scale, outcomes, speed, cost); the national-scale answer leads with Her Power, in short paragraphs.
  { audience: 'governments' as const, id: 'Q1' },
  {
    q: 'Can You Deliver at National Scale?',
    html: `Her Power, a national program of DoICT, the ICT Division, trained 25,125 women across 130 sub-districts (upazilas). CodersTrust provided the curriculum, training manuals and mentorship guidelines and trained 2,500 women directly.</p><p data-fact="GV-01 GV-11 SC-08">We scale in phases, starting from what we have done. Government contracts have training scopes ranging from 120+ professionals to 3,120+ digital-lab staff. Separately, 10,000 teachers were trained to teach online during COVID-19.</p><p data-fact="PD-06 GV-09 PD-05">Larger programs run hub-and-spoke: up to 10 cohorts in parallel, with certified local facilitators and blended delivery in existing labs and colleges. In Bangladesh, 9,000+ government digital labs could host blended learning; lab access and seats are confirmed per program. A 100,000+ phase is a design option; we have not yet delivered a program at that size.`,
    evidence: ['SC-06', 'GV-10'],
  },
  ...['Q3', 'Q7', 'Q8'].map((id) => ({ audience: 'foundations' as const, id })),
];

const jsonLd = [
  webPage({ path, name: 'YouthWIDE — Youth Digital Employment Program', description, dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Programs', path: '/programs/' }, { name: 'YouthWIDE', path }] }),
  serviceNode({ path, name: 'YouthWIDE', description: fact('IN-02').text, audience: 'Ministries, agencies, development partners and funders', areaServed: ['Bangladesh', 'South Asia', 'Middle East and North Africa', 'Sub-Saharan Africa'] }),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl(path)}#roadmap`,
    name: 'YouthWIDE execution roadmap',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: ROADMAP_PHASES.map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })),
  },
  faqNode(faqSources, path),
];

const measures = ['Completion', 'Certification', 'First paid work', 'Sustained work', 'Cost per completer and per verified outcome'];
---

<LandingLayout title={title} description={description} path={path} breadcrumbs={[{ label: 'Programs', href: '/programs/' }, { label: 'YouthWIDE' }]} jsonLd={jsonLd} stickyCta={discovery}>
  <!-- C1 -->
  <!-- WP20c: the ministry briefing is a text link beside the one primary button (not a second button) -->
  <div id="hero">
    <Hero
      eyebrow="YouthWIDE · Youth Digital Employment Program"
      title="Prepare Educated Youth for Paid Digital Work"
      lead="YouthWIDE is the program through which governments, development partners and funders prepare educated, unemployed youth for paid digital work: mentored, certification-focused training, placement support and outcome tracking as agreed in the program scope."
      artSeed="youthwide"
    >
      <Fragment slot="actions">
        <Button href={discovery.href} iconEnd="arrow-right">{discovery.label}</Button>
        <nav class="routes" aria-label="Other Ways to Start">
          {briefing.href && <a class="link" href={briefing.href}>{briefing.label}<Icon name="arrow-right" size={16} /></a>}
          <a class="link" href={url('/partner-with-us/development-partners/')}>For Development Partners: See the Partnership Route<Icon name="arrow-right" size={16} /></a>
          <a class="link" href={url('/partner-with-us/governments/')}>For Governments: See the Partnership Route<Icon name="arrow-right" size={16} /></a>
        </nav>
      </Fragment>
    </Hero>
  </div>
  <InShort
    bullets={[
      'YouthWIDE is the program through which funders and agencies deploy the CodersTrust model in a country, in phases, through existing labs and colleges.',
      'Priority groups are reached with outreach and accessible selection, with women a priority in every group.',
      'Results you can report: monthly reports, tracer surveys and documentary evidence of earnings where available.',
      'Start with a pilot; the scorecard and the decision to expand stay with you.',
    ]}
    links={[
      { label: 'How It Works', href: '#mechanism' },
      { label: 'Evidence', href: '#proof-band' },
      { label: 'What You Receive', href: '#features' },
      { label: 'Options', href: '#offer' },
      { label: 'Next Steps', href: '#next-steps' },
    ]}
    contracting={false}
  />

  <!-- GEO definition + page BLUF -->
  <DefinitionBlock heading="What Is YouthWIDE?">
    <p data-fact="IN-01 IN-02">YouthWIDE (Youth Workforce Inclusion for Digital Economy) is CodersTrust’s youth digital-employment program. In Bangladesh it is a national initiative with a 2030 target of training {target} vulnerable youth for digital employment; the target depends on government and donor commitments and is not a delivered figure. Elsewhere it runs as co-funded country cohorts, designed for South Asia, the Middle East and North Africa, and Sub-Saharan Africa. Current outcome evidence comes from Bangladesh and Kosovo.</p>
    <p data-fact="PD-01 PD-02">Each program combines mentored, certification-focused training, placement support and outcome tracking as agreed in the program scope; the training hours and mentoring are set out under Program at a Glance below.</p>
    <nav class="audience" aria-label="Choose Your Route">
      <a class="audience__link" href="#governments"><span class="audience__label">For Governments and Ministries</span><span class="audience__text">The Bangladesh national initiative: priority groups, government labs and phased delivery.</span><Icon name="arrow-right" size={16} /></a>
      <a class="audience__link" href="#funders"><span class="audience__label">For Funders and Development Partners</span><span class="audience__text">Co-funded country cohorts: delivery model, evidence, reporting and governance.</span><Icon name="arrow-right" size={16} /></a>
    </nav>
  </DefinitionBlock>

  <ProgramGlance
    rows={[
      { label: 'Who It Is For', text: 'Ministries, agencies, development partners and funders who want to report on educated, unemployed young people moving into paid digital work.' },
      { label: 'Delivery', text: 'Blended training in existing labs and colleges, with certified local facilitators; hub-and-spoke delivery for larger programs.', facts: ['PD-06'] },
      { label: 'Training and Mentoring', text: `${hours} training hours per certification, then three months of milestone-based mentoring.`, facts: ['PD-01'] },
      { label: 'Certification Preparation', text: 'Each track prepares learners for an industry certification, with the exam fee included.', facts: ['PD-02'] },
      { label: 'Placement Support', text: 'Placement support into local, remote and global work.', facts: ['PD-15'] },
      { label: 'Reporting', text: 'Monthly reports, tracer surveys and documentary evidence of earnings where available.', facts: ['PD-08', 'PD-09'] },
      { label: 'Agreed Before Enrollment', text: 'Priority groups, tracks, each track’s work-entry plan, safeguarding and the pilot scorecard.', facts: ['PD-11', 'PD-12'] },
    ]}
  />

  <!-- ===== C2–C6: ONE shared sequence for both audiences (WP18b). Each band carries two compact sub-blocks, "Government Delivery"
       (the Bangladesh national initiative, formerly NationWIDE; anchor #governments) and "Funders and Development Partners"
       (country cohorts; anchor #funders), each keeping its own content. ===== -->

  <!-- C2 -->
  <ProblemSection
    eyebrow="The Challenge"
    title="Educated Young People Struggle to Enter Work in Bangladesh and Across Three Regions"
    bluf="Tens of millions of educated young people aged 15–24 are not in employment, education or training across South Asia, MENA and Sub-Saharan Africa."
    factIds={['PX-01', 'PX-02']}
  >
    <div class="aud aud--stack">
      <div class="aud__col" id="governments">
        <h3 class="aud__h">Why Graduates Are a Priority</h3>
        <p class="aud__lead" data-fact="PX-03">In Bangladesh, graduate unemployment is {rates.graduate}, against {rates.ssc} for holders of the Secondary School Certificate (SSC). The national initiative works with five priority groups.</p>
        <PriorityGroups />
      </div>
      <div class="aud__col" id="funders">
        <h3 class="aud__h">Funders and Development Partners</h3>
        <GainsPains painsHeading="What Gets in the Way" pains={FUNDER_PAINS.map(painForList)} />
      </div>
    </div>
  </ProblemSection>

  <!-- C3 -->
  <CostSection
    title="Training Without Work Entry Spends the Budget Without the Result"
    blocks={[
      { claim: CLAIM_RC06, factId: 'RC-06', implication: 'Too many funders receive attendance and completion counts but little evidence of earnings.' },
      { claim: 'Each cohort is documented from a baseline at enrollment, with tracer results at 3, 6 and 12 months', factId: 'PD-09', implication: 'Without that record, an agency cannot see who entered work or began earning after training.' },
      { claim: CLAIM_PX06, factId: 'PX-06', implication: 'Tracks have to follow current employer demand, not last year’s job market.' },
    ]}
  />

  <!-- C5 -->
  <GuideSection
    title={`We Have Built This Path Since ${statValue('ID-02')}`}
    empathy={EMPATHY.developmentPartners}
    origin={ORIGIN}
    statIds={['SC-01', 'SC-03', 'SC-06', 'SC-04']}
    partnerGroup={['government', 'academic', 'development']}
    method={{ text: 'TalentLEAP organizes skills into career paths with progressive levels.', factId: 'IN-06', link: { label: 'How TalentLEAP Works', href: '/our-model/talentleap/' } }}
  >
    <div class="aud aud--stack">
      <div class="aud__col">
        <h3 class="aud__h">Government Delivery</h3>
        <p>{EMPATHY.governments}</p>
        <p data-fact="SC-04">CodersTrust has been National University’s official training partner for digital career skills and credentials since 2023.</p>
      </div>
      <div class="aud__col">
        <h3 class="aud__h">Funders and Development Partners</h3>
        <CopyP block={TRAINED_REACH} />
      </div>
    </div>
  </GuideSection>

  <!-- C4 -->
  <FutureBand
    photos={futurePhotos('youthwide')}
    title="What Your Reports Will Show"
    lead="Illustrative: monthly reports follow each cohort from enrollment to first earnings."
    vignettes={[
      { kind: 'Functional', title: 'Monthly Reports Your Board or Agency Can Read', text: 'Enrollment, completion, certification, placements and first earnings arrive every month, with women’s and priority-group shares reported.' },
      { kind: 'Emotional', title: 'Visibility into Whether the Budget Produced Earnings', text: 'You see who started earning, from jobs, freelance clients and businesses of their own, locally, remotely and abroad.' },
      { kind: 'Social', title: 'Evidence Your Evaluators Can Check', text: 'Tracer results are designed to be backed by payslips, offer letters, platform logs and bank receipts.' },
    ]}
  >
    <div class="aud">
      <div class="aud__col">
        <h3 class="aud__h">Government Delivery</h3>
        <ul class="aud__list" role="list">
          <li><strong>A Government Lab Becomes a Blended-Learning Center.</strong> Seats are confirmed per program in existing government digital labs and colleges.</li>
          <li><strong>Capacity That Can Stay in Your System.</strong> Where included in the program scope, trained facilitators and localized curricula remain after the program.</li>
        </ul>
      </div>
      <div class="aud__col">
        <h3 class="aud__h">Funders and Development Partners</h3>
        <ul class="aud__list" role="list">
          <li><strong>First Earnings by Priority Group.</strong> Reports show first earnings for each priority group agreed with you.</li>
          <li><strong>A Year of Tracer Surveys.</strong> Tracer surveys follow each cohort for a year after the course.</li>
        </ul>
      </div>
    </div>
  </FutureBand>

  <!-- C6 -->
  <MechanismSection
    title="One Delivery Model, from Selection to Paid Work"
    positioning={POSITIONING.youthwide}
    blocks={[
      { label: 'Who We Reach', title: 'Educated, Unemployed and Underemployed Youth', text: 'Priority groups are agreed with you in co-design. Women are a priority in every group.', icon: 'users' },
      { label: 'How We Reach Them', title: 'Accessible Selection, Blended Delivery', text: 'Outreach and an accessible readiness assessment, then training in existing labs and colleges.', icon: 'graduation-cap' },
      { label: 'What We Deliver', title: 'AI-Ready Training, Certification Preparation and Mentoring', text: 'Each track includes preparation for an industry certification; exam eligibility and attempts are agreed in the program scope. Then three months of milestone-based mentoring.', icon: 'award' },
      { label: 'Where They Work', title: 'Local, Remote, Overseas and Freelance Work', text: 'Placement support and outcome tracking after each course.', icon: 'globe' },
    ]}
    factIds={['PD-14', 'PD-06', 'PD-01', 'PD-02', 'PD-15']}
    link={{ label: 'How Our Model Works', href: '/our-model/' }}
  >
    <div class="aud">
      <div class="aud__col">
        <h3 class="aud__h">Government Delivery</h3>
        <p class="aud__lead" data-fact="GV-09">Delivered through the labs and colleges you already have; lab access and seats are confirmed per program.</p>
        <p class="aud__lead">Trained trainers deliver it: Training of Trainers, curriculum and manuals, and certified local facilitators. Reports to the agency are designed to show enrollment, completion, certification, placement and first earnings as each cohort progresses.</p>
        <div class="mech-target" data-reveal>
          <StatusTag status="Target" />
          <FactStat id="IN-01" />
          <p class="mech-target__note">A national ambition for 2030 that depends on government and donor commitments; not a delivered figure.</p>
        </div>
        <div class="mech-stats">
          <div class="mech-stat"><FactStat id="GV-09" /></div>
          <div class="mech-stat"><StatusTag status="Delivered" /><FactStat id="GV-13" /></div>
        </div>
        <p class="mech-target__note" data-fact="GV-01"><Fact id="GV-01" as="span" />. <a class="link" href="#cases">See the results under Proof in Practice</a>.</p>
      </div>
      <div class="aud__col">
        <h3 class="aud__h">Funders and Development Partners</h3>
        <p class="aud__lead">Country cohorts are designed with you: priority groups, tracks, safeguarding and the scorecard are agreed in co-design before enrollment.</p>
        <p class="aud__lead">Tracks come from the entry-level menu, set per country from employer demand. Before enrollment each track’s demand and work-entry plan is approved with you.</p>
      </div>
    </div>
    <DeliveryGrid
      heading="The Delivery Model in Detail"
      items={[
        { icon: 'graduation-cap', title: 'Training and Mentoring', factId: 'PD-01', text: 'Training hours per certification and milestone-based mentoring, as set out under Program at a Glance.' },
        { icon: 'award', title: 'Certifications by Track', factId: 'PD-03' },
        { icon: 'users', title: 'Cohorts in Parallel', factId: 'PD-06' },
        { icon: 'wifi', title: 'Connectivity-Light Delivery', factId: 'PD-07', text: 'Lessons run on a 1.5 Mbps connection, and 720p lessons can be downloaded for offline viewing.' },
        { icon: 'clipboard-check', title: 'Accessible Readiness Assessment', factId: 'PD-14', text: 'Selection and placement into a career or foundation track use a readiness assessment, a written test and an interview guide. A small number of applicants may not be selected, and the reasons are reported.' },
        { icon: 'layers', title: 'Foundation Tracks', factId: 'PD-17' },
        { icon: 'briefcase', title: 'Placement Support', factId: 'PD-15' },
        { icon: 'shield-check', title: 'Quality Assurance', factId: 'PD-16' },
      ]}
    />
    <div class="wep-block">
      <h3 class="t-heading-xl" data-reveal>Work-Entry Plan per Track</h3>
      <WorkEntryPlan />
    </div>
  </MechanismSection>
  <!-- C7 -->
  <EvidenceBand
    id="proof-band"
    title="Trial and Survey Evidence"
    bandHeading="Trial and Survey Evidence"
    trialHeading="An Independent Randomized Trial"
    headlineFact="RC-01"
    chart="trial"
    chip={false}
    plainLine
    lead="Trial figures are for a predecessor program. Survey figures are among surveyed completers, from the October 2026 survey."
    statIds={['RC-02']}
    surveyStatIds={['OC-03', 'OC-05']}
    links={[{ label: 'Impact Survey 2026', href: '/impact/outcomes-2026/' }, { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' }]}
  >
    <p class="proof-note" data-fact="OC-05">The {statValue('OC-05')} figure describes when earnings began, not what caused them.</p>
  </EvidenceBand>
  <CaseStudyCarousel
    id="cases"
    eyebrow="Proof in Practice"
    title="Results from Delivered Programs"
    items={[
      { title: 'Women’s Skill Development for Freelancing Marketplace (WSDFM)', program: 'Commissioned by Porticus', factId: 'PR-01', href: '/impact/case-studies/wsdfm-women-freelancers/' },
      { title: 'Women in Online Work, Kosovo', program: 'World Bank Group', factId: 'PR-02', href: '/impact/case-studies/kosovo-women-in-online-work/' },
      { title: 'Her Power', program: 'ICT Division / Department of ICT (DoICT)', factId: 'PR-05', href: '/impact/case-studies/her-power/' },
    ]}
  />

  <!-- C8 (review round 14, M4): one row per ranked pain of C2 (pain → how we relieve it → the registered feature), then the gain creators -->
  <FeaturesTable
    title="Each Feature Maps to What Funders and Agencies Ask For"
    concernLabel="Funder Concern Addressed"
    rows={[
      {
        ...painForRow(FUNDER_PAINS, 'P1'),
        feature: 'Placement Support, Three Months of Milestone-Based Mentoring and a Work-Entry Plan per Track Approved Before Enrollment',
        means: 'success is measured against agreed outcomes, including paid work, not attendance alone; completers are routed to local, remote and global work.',
        outcome: 'Results measured in paid work',
        facts: ['PD-15', 'PD-01', 'PD-19'],
      },
      {
        ...painForRow(FUNDER_PAINS, 'P2'),
        feature: 'As Agreed in the Program Scope: Baseline at Enrollment, Monthly Reports, Tracer Surveys at 3, 6 and 12 Months and Documentary Evidence Where Available',
        means: 'your evaluators can check results against documentary evidence where available, such as payslips, offer letters, platform logs or bank receipts.',
        outcome: 'Auditable results',
        facts: ['PD-08', 'PD-09'],
      },
      {
        ...painForRow(FUNDER_PAINS, 'P3'),
        feature: 'An AI-Ready Curriculum, with Entry-Level Tracks Set per Country from Employer Demand',
        means: 'courses are designed to keep pace with employer demand as AI changes entry-level tasks.',
        outcome: 'Tracks that follow what employers ask for',
        facts: ['PD-02', 'PD-10'],
      },
      { feature: 'Outreach and accessible selection; blended delivery in existing labs; safeguarding specified per program', means: 'priority groups can join a local lab and train for work that local employers want.', outcome: 'Training that reaches hard-to-reach groups' },
      { feature: 'Certification Exam Preparation (Exam Fee Included)', means: 'each track prepares learners for an industry certification.', outcome: 'A supported route to a recognized credential' },
      { feature: 'Training of Trainers, curriculum and manuals; certified local facilitators; hub-and-spoke delivery; blended learning in existing labs; connectivity-light delivery', means: 'capacity stays in your system and rural labs can take part.', outcome: 'Trainers and curricula that stay in your system' },
      { feature: 'Pilot scorecard with cost per completer and per verified outcome; monthly reports', means: 'your budget is judged against verified outcomes.', outcome: 'Spending tied to verified outcomes' },
    ]}
  />

  <!-- WP22: the roadmap and the reporting rhythm are one band (Delivery and Reporting); #roadmap and #reports stay as anchors inside it -->
  <Section id="delivery-reporting" tone="airy" aria-labelledby="delivery-reporting-h">
    <SectionHeader id="delivery-reporting-h" eyebrow="Delivery and Reporting" title="From Agreement to Monthly Reports" lead="Timings come from the program design and are confirmed with you in co-design. Each cohort is reported monthly and tracked for 12 months after each course; the reporting schedule shows what is measured, not a set of results." />
    <div id="roadmap" class="dr__block">
      <h3 class="t-heading-xl dr__title" data-reveal>Five Phases from Agreement to Parallel Cohorts</h3>
      <ExecutionRoadmap level={4} />
    </div>
    <div id="reports" class="dr__block">
      <h3 class="t-heading-xl dr__title" data-reveal>What Your Reports Show over Time</h3>
      <ReportingBlock intro={false} />
    </div>
  </Section>

  <PhotoGallery id="in-the-field" eyebrow="In the Field" title="Program Photographs from Bangladesh, Kosovo and Albania" lead="Laptop handovers, training rooms and a government agreement, in photographs." photos={galleryPhotos('youthwide')} />

  <!-- C9 -->
  <FaqSection sources={faqSources} title="Questions Funders and Agencies Ask" />
  <Section id="governance" tone="airy" aria-labelledby="governance-h">
    <SectionHeader id="governance-h" eyebrow="Safeguarding and Governance" title="Safeguarding, Governance and Reporting" />
    <div class="gov">
      <div class="gov__col" data-reveal>
        <h3 class="t-heading-l">Protected by Design</h3>
        <CopyP block={SAFEGUARDING} />
        <p><a class="link" href={url('/about/governance/')}>How Governance and Accountability Work<Icon name="arrow-right" size={16} /></a></p>
      </div>
      <div class="gov__col" data-reveal>
        <h3 class="t-heading-l">Governance</h3>
        <CopyP block={GOVERNANCE} />
      </div>
    </div>
    <h3 class="t-heading-xl gov__h" data-reveal>Who Does What</h3>
    <Raci />
    <p class="gov__eval" data-reveal>Independent evaluation is welcome and, where you want one, budgeted separately.</p>
  </Section>

  <!-- C10 -->
  <ComparisonBand title="Compare the Approaches" />

  <!-- C11 -->
  <OfferSection title="Three Ways to Start, Sized to Your Goals" lead="Each phase is planned with the agency or funder on the results of the one before. Program options are shown without prices; the indicative budget is shared in the discovery session." options={PROGRAM_OPTIONS}>
    <div class="note note--key"><span class="note__label">Accountability</span><CopyP block={ACCOUNTABILITY} /></div>
    <div class="note"><span class="note__label">Pricing</span><CopyP block={PRICING} /></div>
    <div class="note">
      <span class="note__label">Scale</span>
      <CopyP block={SCALE} />
    </div>
    <div class="note">
      <span class="note__label">Services Behind a Phase</span>
      <ul class="svc">
        <li data-fact="GV-11">{endSentence(fact('GV-11').text)}</li>
        <li data-fact="GV-05">{contractScope('GV-05')}</li>
      </ul>
    </div>
    <div class="note">
      <span class="note__label">Partners and Funders</span>
      <p>Development partners and foundations can also fund a phase in Bangladesh. <a class="link" href={cofunding.href}>{cofunding.label}<Icon name="arrow-right" size={16} /></a></p>
    </div>
  </OfferSection>

  <!-- C12 -->
  <RiskSection
    title="Start with a Pilot. Decide on Evidence"
  >
    <Fragment slot="lead">
      <CopyP block={SCORECARD} />
      <ul class="measures" role="list" aria-label="What the scorecard measures">
        {measures.map((m) => <li><Icon name="circle-check" size={18} />{m}</li>)}
      </ul>
    </Fragment>
    <p class="risk__pilot" data-fact="PD-05 PD-11">A pilot comes first: prove the model in your labs before you commit to a wider phase. Thresholds are agreed with you before the first cohort starts, and there is a review gate before each phase.</p>
    <ReviewPanels sample={{ label: 'See the Sample Monthly Report', href: '#reports' }} />
    <DecisionSheet />
  </RiskSection>

  <!-- C13 + C14 (WP24c): ONE "Choose Your Entry Point" chooser (the funders' discovery card holds the page's one primary button; the Bangladesh briefing for
       governments is a text link in its own card, so two primary buttons never stand in one view) and ONE shared "What Happens Next".
       The cards keep the ids #cta and #cta-governments (each carries its SESSION-AGENDA, checked by scripts/check-facts.mjs). -->
  <Section id="entry-point" tone="airy" aria-labelledby="entry-point-h">
    <SectionHeader id="entry-point-h" eyebrow="Get Started" title="Choose Your Entry Point" lead="Funders start with a discovery session. Governments start with a briefing that fits the agency’s timeline." />
    <div class="entry">
      {
        discovery.href && (
          <section id="cta" class="entry__card" aria-labelledby="cta-h" data-reveal>
            <h3 id="cta-h" class="t-heading-l entry__title">Funders: Talk to Us About a First Cohort</h3>
            <CopyP block={SPEED} class="cta-speed" />
            <div class="entry__actions">
              <Button href={discovery.href} iconEnd="arrow-right">{discovery.label}</Button>
              <a class="link" href={url('/impact/')}>Read the Evidence</a>
            </div>
            {discovery.href.startsWith('mailto:') && <EmailFallback href={discovery.href} />}
            <p class="entry__micro">{MICRO_COMMITMENT}</p>
            <SessionAgenda />
          </section>
        )
      }
      {
        briefing.href && (
          <section id="cta-governments" class="entry__card" aria-labelledby="cta-governments-h" data-reveal>
            <h3 id="cta-governments-h" class="t-heading-l entry__title">Governments: Start with a Briefing</h3>
            <p class="entry__text">Public procurement follows the agency’s own timeline, so we start with a briefing that fits it.</p>
            <p class="entry__actions">
              <a class="link" href={briefing.href}>{briefing.label}<Icon name="arrow-right" size={16} /></a>
            </p>
            {briefing.href.startsWith('mailto:') && <EmailFallback href={briefing.href} />}
            <SessionAgenda lead="briefing" />
          </section>
        )
      }
    </div>
  </Section>

  <NextSteps
    title="What Happens Next"
    steps={[
      { title: 'Briefing or Discovery', text: 'Governments start with a briefing; funders start with a discovery session about goals, priority groups and timeline.' },
      { title: 'Co-Design', text: 'Priority groups, tracks, labs, safeguarding, the scorecard and reporting are shaped together with you.' },
      { title: 'Agreement', text: 'Scope, schedule and success measures are agreed, on the agency’s own procurement timeline where it applies.' },
      { title: 'First Cohort', text: 'Training starts in existing labs and colleges within the window below after signing; seats are confirmed per program.' },
      { title: 'Monthly Reports', text: 'Monthly reports are designed to show enrollment, completion, certification, placement and first earnings as each cohort progresses.' },
    ]}
    roleActions={[
      { role: 'Governments', text: C14.variants.governments },
      { role: 'Funders', text: C14_FIRST },
    ]}
  >
    <p class="next-timing"><Icon name="clock" size={16} /> <span data-fact="PD-04">{fact('PD-04').text}.</span></p>
  </NextSteps>

  <Section pad="sm" aria-label="Last updated">
    <p class="updated">Last updated <time datetime={isoDate(LAST_UPDATED)}>{formatDate(LAST_UPDATED)}</time></p>
  </Section>
</LandingLayout>

