---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/system/Button.astro';
import Badge from '../components/system/Badge.astro';
import Icon from '../components/system/Icon.astro';
import Logo from '../components/system/Logo.astro';
import Hero from '../components/system/Hero.astro';
import Stat from '../components/system/Stat.astro';
import ProgressBar from '../components/system/ProgressBar.astro';
import CategoryCard from '../components/system/CategoryCard.astro';
import SuccessStoryCard from '../components/system/SuccessStoryCard.astro';
import Testimonial from '../components/system/Testimonial.astro';
import Carousel from '../components/system/Carousel.astro';
import CarouselControls from '../components/system/CarouselControls.astro';
import PartnerStrip from '../components/system/PartnerStrip.astro';
import CourseCard from '../components/system/CourseCard.astro';
import PromoBar from '../components/system/PromoBar.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import ProgramCard from '../components/ui/ProgramCard.astro';
import CaseStudyCard from '../components/ui/CaseStudyCard.astro';
import NewsCard from '../components/ui/NewsCard.astro';
import PersonCard from '../components/ui/PersonCard.astro';
import ComparisonTable from '../components/ui/ComparisonTable.astro';
import Accordion from '../components/ui/Accordion.astro';
import Timeline from '../components/ui/Timeline.astro';
import StepFlow from '../components/ui/StepFlow.astro';
import ModelDiagram from '../components/ui/ModelDiagram.astro';
import BeforeAfter from '../components/ui/BeforeAfter.astro';
import BarChart from '../components/ui/BarChart.astro';
import CTABand from '../components/ui/CTABand.astro';
import CopyEmail from '../components/ui/CopyEmail.astro';
import LiteVideo from '../components/ui/LiteVideo.astro';
import HeroArt from '../components/ui/HeroArt.astro';
import Quote from '../components/ui/Quote.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import HeroBand from '../components/sections/HeroBand.astro';
import DefinitionBand from '../components/sections/DefinitionBand.astro';
import RouterBand from '../components/sections/RouterBand.astro';
import ProblemBand from '../components/sections/ProblemBand.astro';
import CostBand from '../components/sections/CostBand.astro';
import FutureBand from '../components/sections/FutureBand.astro';
import GuideBand from '../components/sections/GuideBand.astro';
import MechanismBand from '../components/sections/MechanismBand.astro';
import ProofBand from '../components/sections/ProofBand.astro';
import CaseStudyCarousel from '../components/sections/CaseStudyCarousel.astro';
import FeaturesTable from '../components/sections/FeaturesTable.astro';
import FAQBand from '../components/sections/FAQBand.astro';
import ComparisonBand from '../components/sections/ComparisonBand.astro';
import OfferBand from '../components/sections/OfferBand.astro';
import RiskReversalBand from '../components/sections/RiskReversalBand.astro';
import NextStepsBand from '../components/sections/NextStepsBand.astro';
import NewsTeaserBand from '../components/sections/NewsTeaserBand.astro';
import Fact from '../components/facts/Fact.astro';
import FactStat from '../components/facts/FactStat.astro';
import FactList from '../components/facts/FactList.astro';
import FactCard from '../components/facts/FactCard.astro';
import Sources from '../components/facts/Sources.astro';
import WorldMap from '../components/ui/WorldMap.astro';
import { faqJsonLd } from '../lib/faq';
import { fact } from '../data/facts';
import tokens from '../../design-system/tokens.json';
import { audiences, promo } from '../data/nav';
import { cta } from '../lib/mailto';

// ---- Token data (AA theme) with computed contrast -----------------------------------------
type Tok = { name: string; value: string | { light: string; accessible: string }; usage: string };
const resolve = (t: Tok) => (typeof t.value === 'string' ? t.value : t.value.accessible);
const lum = (hex: string) => {
  const n = hex.replace('#', '');
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(n.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ratio = (a: string, b: string) => {
  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};
const grade = (r: number) => (r >= 7 ? 'AAA' : r >= 4.5 ? 'AA' : r >= 3 ? 'AA large / graphics' : 'fails text');
const all = tokens.color.tokens as Tok[];
const groups: [string, string[]][] = [
  ['Brand blue', ['primary', 'on-primary', 'blue-600', 'blue-700', 'primary-container', 'on-primary-container', 'inverse-primary', 'primary-fixed', 'primary-fixed-dim', 'powder-blue', 'enroll-bg', 'promo-strip']],
  ['Klein blue', ['secondary', 'on-secondary', 'klein-600', 'secondary-container', 'on-secondary-container', 'secondary-fixed', 'secondary-fixed-dim']],
  ['Career orange + cyan', ['tertiary', 'on-tertiary', 'orange-600', 'tertiary-container', 'on-tertiary-container', 'tertiary-fixed-dim', 'cyan', 'cyan-600', 'on-cyan']],
  ['Surfaces', ['surface', 'surface-container-low', 'surface-container', 'surface-container-high', 'surface-container-highest', 'surface-dim', 'surface-variant', 'inverse-surface', 'inverse-on-surface', 'hero-gradient-center', 'hero-gradient-edge']],
  ['Text + lines', ['on-surface', 'on-surface-variant', 'outline', 'outline-variant']],
  ['States', ['success', 'success-subtle', 'success-strong', 'warning', 'warning-subtle', 'warning-strong', 'error', 'error-container', 'on-error-container', 'info', 'info-subtle', 'sale-badge-bg', 'sale-badge-border']],
];
const byName = new Map(all.map((t) => [t.name, t]));
const swatchGroups = groups.map(([title, names]) => ({
  title,
  items: names
    .map((n) => byName.get(n))
    .filter((t): t is Tok => !!t)
    .map((t) => {
      const hex = resolve(t);
      const rw = ratio(hex, '#ffffff');
      const ri = ratio(hex, '#0e0f11');
      return { name: t.name, hex, rw, ri, note: t.usage.split('. ')[0].replace(/\.$/, '') };
    }),
}));
const extColors = [
  { name: 'brand-bright', hex: '#2682f9', note: 'Decoration and ≥24px display figures only' },
  { name: 'tertiary-light', hex: '#fca624', note: 'Orange marks/sparks; text only on Klein / Deep Ink' },
].map((c) => ({ ...c, rw: ratio(c.hex, '#ffffff'), ri: ratio(c.hex, '#0e0f11') }));

const typeScale = [
  ['display-5xl', '44/52 · 700', 't-display-5xl', 'Home hero H1'],
  ['display-4xl', '40/48 · 700', 't-display-4xl', 'Inner page H1'],
  ['heading-3xl', '36/44 · 600', 't-heading-3xl', 'Section H2'],
  ['heading-2xl', '32/40 · 600', 't-heading-2xl', 'Widget H2/H3'],
  ['heading-xl', '28/36 · 600', 't-heading-xl', 'Card group heading'],
  ['heading-l', '24/32 · 500', 't-heading-l', 'Card title'],
  ['heading-m', '20/28 · 500', 't-heading-m', 'Small heading'],
  ['body-l', '20/32 · 400', 't-body-l', 'Lead paragraph'],
  ['body-m', '18/26 · 400', 't-body-m', 'Long-form body'],
  ['body-base', '16/24 · 400', 't-body-base', 'UI text, buttons'],
  ['body-xs', '14/20 · 400', 't-body-xs', 'Metadata, captions'],
];

const spacing = (tokens.spacing.tokens as { name: string; value: string }[]).filter((t) => /^space-(xs|sm|md|gutter|lg)$/.test(t.name));
const radii = tokens.radius.tokens as { name: string; value: string }[];
const shadows = [...(tokens.shadow.tokens as { name: string; value: string }[]), { name: 'shadow-card-hover', value: 'extension' }];

// ---- Sample content -----------------------------------------------------------------
const partners = ['Example Partner 1', 'Example Partner 2', 'Example Partner 3', 'Example Partner 4', 'Example Partner 5', 'Example Partner 6', 'Example Partner 7'].map((name) => ({ name }));
const faqs = [
  { q: 'What does a styleguide FAQ item look like?', a: '<p>Answers can contain <strong>HTML</strong>, such as <a href="#accordion">links</a> and lists.</p>' },
  { q: 'Does the accordion animate?', a: '<p>Yes: height and chevron animate in 200 ms where <code>::details-content</code> is supported, with a Web Animations fallback. Reduced motion disables it.</p>' },
  { q: 'Is it keyboard accessible?', a: '<p>It is a native <code>details</code>/<code>summary</code>, so Enter and Space toggle it.</p>' },
];
const timeline = [
  { year: '2014', title: 'Founded', text: 'Sample milestone text for the styleguide.' },
  { year: '2018', title: 'Second milestone', text: 'Sample milestone text for the styleguide.' },
  { year: '2022', title: 'Third milestone', text: 'Sample milestone text for the styleguide.' },
  { year: '2026', title: 'Latest milestone', text: 'Sample milestone text for the styleguide.' },
];
const jsonLd = [faqJsonLd('home', '/styleguide/', ['Q1', 'Q2', 'Q3', 'Q5', 'Q7', 'Q8'])];
const sectionLinks = [
  ['tokens', 'Tokens'],
  ['type', 'Typography'],
  ['buttons', 'Buttons & badges'],
  ['hero', 'Hero'],
  ['cards', 'Cards'],
  ['proof', 'Proof'],
  ['data', 'Data & charts'],
  ['structure', 'Structure'],
  ['bands', 'Bands'],
  ['motion', 'Motion'],
  ['facts', 'Facts UI'],
  ['cmf', 'CMF bands'],
  ['partners', 'Partners & map'],
];
---

<BaseLayout
  title="Styleguide"
  description="Component and token gallery for QA: colors, type, components and section bands. Not indexed."
  breadcrumbs={[{ label: 'Styleguide' }]}
  jsonLd={jsonLd}
  noindex
  promo={false}
>
  <Section tone="airy" pad="sm">
    <div class="sg-intro">
      <p class="eyebrow">QA gallery · noindex</p>
      <h1>Styleguide</h1>
      <p class="lead">Every token, component, state and band variant of the CodersTrust Global design system (Accessible AA theme). Generated from <code>design-system/tokens.json</code>.</p>
      <nav aria-label="Styleguide sections">
        <ul class="cluster" role="list">
          {sectionLinks.map(([id, label]) => <li><a class="badge badge--eyebrow" href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    </div>
  </Section>

  <!-- ===================================== TOKENS ===================================== -->
  <Section id="tokens" aria-labelledby="tokens-h">
    <SectionHeader id="tokens-h" eyebrow="Foundations" title="Color tokens" lead="AA theme values. Contrast ratios are computed against white and Deep Ink; ‘large’ means ≥ 24px or bold 19px+." />
    {
      swatchGroups.map((g) => (
        <div class="sg-block">
          <h3>{g.title}</h3>
          <ul class="sg-swatches" role="list">
            {g.items.map((s) => (
              <li class="sg-sw">
                <span class="sg-sw__chip" style={`background:var(--${s.name})`} />
                <span class="sg-sw__body">
                  <b>--{s.name}</b>
                  <span>{s.hex}</span>
                  <span class="sg-sw__note">As text on white {s.rw.toFixed(2)}:1 ({grade(s.rw)}) · on Deep Ink {s.ri.toFixed(2)}:1 ({grade(s.ri)})</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="sg-block">
      <h3>Extension colors (light-theme values, decoration only)</h3>
      <ul class="sg-swatches" role="list">
        {extColors.map((s) => (
          <li class="sg-sw">
            <span class="sg-sw__chip" style={`background:var(--${s.name})`} />
            <span class="sg-sw__body">
              <b>--{s.name}</b>
              <span>{s.hex}</span>
              <span class="sg-sw__note">{s.note}. On white {s.rw.toFixed(2)}:1 · on Deep Ink {s.ri.toFixed(2)}:1</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="sg-block">
      <h3>Spacing, radius, elevation</h3>
      <ul class="sg-meta" role="list">
        {spacing.map((s) => <li><span class="sg-space" style={`width:var(--${s.name})`} /> <code>--{s.name}</code> {s.value}</li>)}
      </ul>
      <ul class="sg-meta" role="list">
        {radii.map((r) => <li><span class="sg-radius" style={`border-radius:var(--${r.name})`} /> <code>--{r.name}</code> {r.value}</li>)}
      </ul>
      <ul class="sg-meta" role="list">
        {shadows.map((s) => <li><span class="sg-shadow" style={`box-shadow:var(--${s.name})`} /> <code>--{s.name}</code></li>)}
      </ul>
    </div>
  </Section>

  <!-- ===================================== TYPE ===================================== -->
  <Section id="type" tone="airy" aria-labelledby="type-h">
    <SectionHeader id="type-h" eyebrow="Foundations" title="Typography" lead="D-DIN 400 and 700 (self-hosted, SIL OFL). Weight 500 resolves to Regular and 600 to Bold. Fluid sizes shown at the current viewport." />
    <ul class="sg-type" role="list">
      {typeScale.map(([name, spec, cls, use]) => (
        <li>
          <span class="sg-type__meta"><code>{name}</code> {spec} — {use}</span>
          <span class={cls}>Turn youth unemployment into digital employment</span>
        </li>
      ))}
    </ul>
    <div class="sg-block prose">
      <h3>Running text and links</h3>
      <p>Body copy uses <code>on-surface-variant</code>. An <a href="#type">inline link</a> grows its underline from the left on hover (M8). <strong>Bold</strong> uses the real D-DIN Bold — no synthesis.</p>
      <ul><li>List item with a primary marker</li><li>Second item</li></ul>
      <blockquote>A block quote in the prose style.</blockquote>
    </div>
  </Section>

  <!-- ===================================== BUTTONS ===================================== -->
  <Section id="buttons" aria-labelledby="btn-h">
    <SectionHeader id="btn-h" eyebrow="Components" title="Buttons, badges, icons, logo" />
    <div class="sg-block">
      <h3>Buttons — variants</h3>
      <div class="cluster">
        <Button variant="primary" iconEnd="arrow-right">Primary</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="outline">Outline</Button>
        <Button variant="enroll">Enroll</Button>
        <Button variant="promo">Promo</Button>
        <Button variant="primary" size="sm">Small</Button>
        <Button variant="primary" icon="mail">With icon</Button>
        <Button variant="primary" href="https://jobready.global/" iconEnd="arrow-up-right">External link</Button>
        <Button variant="primary" disabled>Disabled</Button>
      </div>
      <p class="text-muted t-body-xs">Hover, focus (Tab) and press states are live. One <code>primary</code> per viewport region.</p>
    </div>
    <div class="sg-block">
      <h3>Buttons on dark bands</h3>
      <div class="sg-dark">
        <Section tone="klein" pad="sm"><div class="cluster"><Button variant="inverse" iconEnd="arrow-right">Inverse (white) on Klein</Button><a class="link" href="#buttons">Text link on Klein</a></div></Section>
        <Section tone="deep-ink" pad="sm"><div class="cluster"><Button variant="inverse">Inverse on Deep Ink</Button><a class="link" href="#buttons">Text link on Deep Ink</a></div></Section>
      </div>
    </div>
    <div class="sg-block">
      <h3>CTA library (mailto)</h3>
      <div class="cluster">
        <Button variant="outline" size="sm" href={cta('discovery').href}>{cta('discovery').label}</Button>
        <Button variant="outline" size="sm" href={cta('investor').href}>{cta('investor').label}</Button>
        <Button variant="outline" size="sm" href={cta('nu-pgd').href}>{cta('nu-pgd').label}</Button>
      </div>
    </div>
    <div class="sg-block">
      <h3>Badges</h3>
      <div class="cluster">
        <Badge tone="brand">Brand</Badge><Badge tone="info">Info</Badge><Badge tone="success">Success</Badge><Badge tone="sale">Sale</Badge><Badge tone="eyebrow">Eyebrow</Badge>
      </div>
    </div>
    <div class="sg-block">
      <h3>Icons (Lucide, stroke 1.75)</h3>
      <ul class="sg-icons" role="list">
        {['arrow-right', 'arrow-up-right', 'chevron-down', 'search', 'menu', 'book-open', 'clock', 'video', 'play', 'shield', 'code', 'pen', 'user', 'star', 'users', 'globe', 'landmark', 'graduation-cap', 'briefcase', 'rocket', 'mail', 'phone', 'map-pin', 'copy', 'check', 'x', 'circle-check', 'triangle-alert', 'circle-x', 'facebook', 'linkedin', 'youtube'].map((n) => <li><Icon name={n} size={28} /><span>{n}</span></li>)}
      </ul>
    </div>
    <div class="sg-block">
      <h3>Logo</h3>
      <div class="sg-logos">
        <div class="sg-logo sg-logo--light"><Logo width={220} /></div>
        <div class="sg-logo sg-logo--dark"><Logo variant="white" width={220} loading="lazy" /></div>
      </div>
    </div>
    <div class="sg-block">
      <h3>PromoBar</h3>
      <PromoBar lead={promo.lead} message={promo.rest} actionLabel={promo.action.label} href={promo.action.href} factId={promo.factId} storageKey="sg-promo" dismissible={false} />
    </div>
    <div class="sg-block">
      <h3>Breadcrumbs</h3>
      <Breadcrumbs label="Breadcrumb (example)" items={[{ label: 'Impact', href: '/impact/' }, { label: 'Case studies', href: '/impact/case-studies/' }, { label: 'Example case study' }]} />
    </div>
  </Section>

  <!-- ===================================== HERO ===================================== -->
  <div id="hero">
    <Hero headingLevel={2} variant="home" eyebrow="For governments, development partners and funders" title="Turn youth unemployment into digital employment — at scale." lead="We help partners move educated, unemployed youth into paid digital work through mentored, certification-focused training." artSeed="styleguide-home">
      <Fragment slot="actions">
        <Button iconEnd="arrow-right" href="/contact/">Primary action</Button>
        <Button variant="outline" href="/impact/">Secondary action</Button>
      </Fragment>
      <Fragment slot="stats">
        <Stat value="61.5%" label="Sample stat — employed at the survey" />
        <Stat value="12,345+" label="Sample stat — youth trained" />
        <Stat value="15" label="Sample stat — countries" />
      </Fragment>
    </Hero>
    <Hero headingLevel={2} variant="inner" eyebrow="Inner page hero" title="Inner-page H1 with the display-4xl scale" lead="Text-only variant: no media column." art={false}>
      <Fragment slot="actions"><Button href="/contact/">Talk to us</Button></Fragment>
    </Hero>
  </div>

  <!-- ===================================== CARDS ===================================== -->
  <Section id="cards" aria-labelledby="cards-h">
    <SectionHeader id="cards-h" eyebrow="Components" title="Cards" lead="Audience router, programs, features, case studies, news and people. Hover or focus any linked card (M5)." />
    <h3 class="sg-h3">CategoryCard — audience router (M6)</h3>
    <div class="grid-cards">
      {audiences.map((a) => <CategoryCard title={a.title} icon={a.icon} text={a.text} href={a.href} />)}
    </div>

    <h3 class="sg-h3">ProgramCard · FeatureCard</h3>
    <div class="grid-cards">
      <ProgramCard title="Program name" text="One or two sentences describing the program and who it serves." icon="rocket" href="/programs/" meta={['For development partners', 'Cohort-based']} />
      <FeatureCard icon="shield" title="Feature with consequence" text="What the feature is, in one sentence." means="the partner gets a result they can verify." />
      <FeatureCard icon="target" title="Linked feature" text="A feature card that links somewhere." href="/our-model/" />
    </div>

    <h3 class="sg-h3">CaseStudyCard · NewsCard · PersonCard</h3>
    <div class="grid-cards">
      <CaseStudyCard title="Case study title that may wrap to two lines" program="Program" partner="Partner" stat={{ value: '88.8%', label: 'Sample outcome statistic' }} href="/impact/case-studies/" />
      <NewsCard title="News article headline that wraps onto two lines when long" date="2026-10-08" topic="Impact" excerpt="A short excerpt of the article, two lines at most, to help readers choose." href="/news/" />
      <PersonCard assetId="example-person-portrait" name="Person Name" role="Role / title" href="/about/team/" bio="Two-line bio teaser for the listing card." />
    </div>

    <h3 class="sg-h3">CourseCard</h3>
    <div class="grid-cards">
      <CourseCard title="Postgraduate Diploma in Digital Marketing" badge="Sample badge" meta={[{ icon: 'clock', label: '12 months' }, { icon: 'video', label: 'Online + lab' }, { icon: 'book-open', label: 'Internship' }]} href="/nu-postgraduate-diploma/" actionLabel="View course" />
      <CourseCard title="Course with fee hierarchy" price="Fee shown" oldPrice="Old fee" meta={[{ icon: 'clock', label: '6 months' }]} href="/nu-postgraduate-diploma/" />
    </div>
  </Section>

  <!-- ===================================== PROOF ===================================== -->
  <Section id="proof" tone="airy" aria-labelledby="proof-h">
    <SectionHeader id="proof-h" eyebrow="Components" title="Proof: stats, stories, testimonials, partners" />
    <h3 class="sg-h3">Stat (count-up M2) — on light</h3>
    <div class="cluster sg-stats">
      <Stat value="61.5%" label="Decimal percent" />
      <Stat value="12,345+" label="Grouped with suffix" />
      <Stat value="15" label="Plain integer" />
      <Stat value="33.3%" label="Left-aligned lg" size="lg" />
      <Stat value="12" label="Centered" align="center" count={false} />
    </div>

    <h3 class="sg-h3">Stat on Klein / Deep Ink band</h3>
    <div class="sg-inline-band"><Section tone="klein" pad="sm">
      <div class="cluster sg-stats">
        <Stat tone="dark" value="61.5%" label="White numerals on Klein" size="lg" />
        <Stat tone="accent" value="12,345+" label="Orange numerals on Klein" size="lg" />
        <Stat tone="dark" value="15" label="Countries" size="lg" />
      </div>
    </Section></div>

    <h3 class="sg-h3">ProgressBar (M3)</h3>
    <div class="sg-progress">
      <ProgressBar label="Sample rate A" value={61.5} valueLabel="61.5%" />
      <ProgressBar label="Sample rate B" value={33.3} valueLabel="33.3%" />
      <ProgressBar label="Sample rate C (bright)" value={62} tone="bright" />
    </div>

    <h3 class="sg-h3">SuccessStoryCard (photo grayscale → color, M22) · Testimonial</h3>
    <div class="grid-cards">
      <SuccessStoryCard assetId="example-story-1" outcome="Outcome-led sentence in the learner's voice." name="Learner Name" role="Role, location" href="/impact/stories/" />
      <SuccessStoryCard outcome="A story that has a video available." name="Another Learner" role="Role, location" href="/impact/stories/" video />
      <Testimonial assetId="example-testimonial" quote="A longer quote in a quiet, spacious layout, set in body-l with room to breathe." name="Person Name" role="Organization" rating={5} />
    </div>

    <h3 class="sg-h3">Carousel + CarouselControls (M14; scroll-snap, no autoplay)</h3>
    <Carousel label="Sample stories" perView={3}>
      {Array.from({ length: 6 }, (_, i) => <SuccessStoryCard outcome={`Story ${i + 1}: outcome-led sentence.`} name={`Learner ${i + 1}`} role="Role, location" href="/impact/stories/" />)}
    </Carousel>
    <p class="t-body-xs text-muted">Static controls (count known at build time):</p>
    <CarouselControls count={5} index={2} label="demo" />

    <h3 class="sg-h3">PartnerStrip — grid and marquee (M13)</h3>
    <PartnerStrip caption="Organizations we have worked with, 2014–2026 (sample names)" items={partners} />
    <PartnerStrip variant="marquee" caption="Marquee variant — pauses on hover/focus and via the button" items={partners} />
  </Section>

  <!-- ===================================== DATA ===================================== -->
  <Section id="data" aria-labelledby="data-h">
    <SectionHeader id="data-h" eyebrow="Components" title="Data and charts" lead="Each chart has an accessible table fallback (open ‘View chart data’)." />
    <div class="sg-two">
      <BeforeAfter title="Employment among surveyed completers (sample)" before={{ label: 'Before', value: 33.3, caption: 'before training' }} after={{ label: 'October 2026 survey', value: 61.5, caption: 'surveyed completers' }} delta="+28.2 pp" note="Sample data for the styleguide." />
      <BarChart title="Horizontal bar chart (sample)" items={[{ label: 'First measure', value: 40.1 }, { label: 'Second measure', value: 30.2 }, { label: 'Third measure', value: 20.3 }, { label: 'Fourth measure', value: 9.4 }]} note="Sample data for the styleguide." />
    </div>

    <h3 class="sg-h3">ComparisonTable (approaches and trade-offs; sticky first column on mobile; icon only for our own inclusions)</h3>
    <ComparisonTable
      caption="Sample comparison of approaches"
      columns={['Aspect', 'Our model', 'Conventional programs', 'Self-paced platforms', 'Doing nothing']}
      highlight={0}
      rows={[
        { label: 'Track choice', cells: [{ text: 'Set from current employer demand', included: true }, 'Varies by program design', 'Learner chooses', '—'] },
