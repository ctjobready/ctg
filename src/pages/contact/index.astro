---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Button from '../../components/system/Button.astro';
import Icon from '../../components/system/Icon.astro';
import PartnerStrip from '../../components/system/PartnerStrip.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CopyEmail from '../../components/ui/CopyEmail.astro';
import StepFlow from '../../components/ui/StepFlow.astro';
import CopyBlock from '../../components/pages/about/CopyBlock.astro';
import OfficeCard from '../../components/pages/about/OfficeCard.astro';
import { contactRoutes } from '../../components/pages/about/routes';
import { FIRST_COHORT_REMINDER } from '../../components/pages/partners/partners';
import { ctaHref } from '../../lib/mailto';
import { OFFICES, SOCIAL } from '../../lib/site';
import { linkAttrs } from '../../lib/url';
import { webPage } from '../../lib/schema';

const routes = contactRoutes();
// Twelve-plus routes in three groups, partnership first. A route that is withheld (no href) is filtered out of `routes` already.
const GROUPS = [
  { id: 'partner', title: 'Partner or Fund', ids: ['discovery', 'briefing', 'funding', 'investor', 'local', 'diligence', 'report'] },
  { id: 'hire', title: 'Hire or Train', ids: ['campus', 'work', 'talent'] },
  { id: 'study', title: 'Study or Contact the Media', ids: ['nu-pgd', 'learners', 'media'] },
].map((g) => ({ ...g, routes: g.ids.map((id) => routes.find((r) => r.id === id)).filter((r): r is NonNullable<typeof r> => !!r) }));
const grouped = new Set(GROUPS.flatMap((g) => g.ids));
const ungrouped = routes.filter((r) => !grouped.has(r.id));
if (ungrouped.length > 0) throw new Error(`Contact: routes without a group: ${ungrouped.map((r) => r.id).join(', ')}`);
const description = 'Reach CodersTrust: pick the route for governments, funders, universities, employers, local partners, media or learners. Headquartered in New York.';
const jsonLd = [webPage({ path: '/contact/', name: "Let’s Talk", description, type: 'ContactPage', breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }] })];
---

<BaseLayout title="Contact" description={description} breadcrumbs={[{ label: 'Contact' }]} jsonLd={jsonLd}>
  <Hero eyebrow="Contact" title="Let’s Talk" lead="Choose the route that fits you. Each inquiry button opens a prefilled email to the CodersTrust team." artSeed="contact">
    <Fragment slot="actions">
      <a class="link" href="#offices">Offices and Phone<Icon name="arrow-right" size={16} /></a>
    </Fragment>
  </Hero>

  <Section id="routes" aria-labelledby="routes-h">
    <SectionHeader id="routes-h" eyebrow="Inquiry Routes" title="Choose Your Inquiry Route" lead="If your email app does not open, copy the address below." />
    <p class="ct-copy"><CopyEmail /></p>
    {
      GROUPS.map((g) => (
        <section class="ct-group" aria-labelledby={`ct-${g.id}-h`}>
          <h3 id={`ct-${g.id}-h`} class="ct-group__title t-heading-xl">{g.title}</h3>
          <ul class="ct-routes" role="list">
            {
              g.routes.map((r) => {
                const a = linkAttrs(r.cta.href);
                const s = r.secondary ? linkAttrs(r.secondary.href) : undefined;
                return (
                  <li class="card ct-route" data-reveal>
                    <div class="card__body">
                      <span class="ct-route__icon" aria-hidden="true"><Icon name={r.icon} size={22} /></span>
                      <h4 class="card__title">{r.who}</h4>
                      <p class="card__text">{r.text}</p>
                      <div class="ct-route__actions">
                        <Button variant="outline" size="sm" href={r.cta.href} iconEnd={a.external ? 'arrow-up-right' : undefined} icon={a.external ? undefined : 'mail'}>{r.cta.label}</Button>
                        {s && <a class="link" href={s.href} rel={s.rel}>{r.secondary!.label}{s.srText && <span class="sr-only"> {s.srText}</span>}</a>}
                      </div>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </section>
      ))
    }
  </Section>

  <Section id="offices" tone="airy" aria-labelledby="offices-h">
    <SectionHeader id="offices-h" eyebrow="Offices" title="Where We Work From" lead="CodersTrust is headquartered in New York, with a country office in Dhaka. Use the contact route above; the right team will respond." />
    <div class="grid-cards grid-cards--2">
      {OFFICES.map((o) => <OfficeCard {...o} city={`${o.city} · ${o.kind}`} note={o.id === 'bangladesh' ? 'Campuses in Mirpur (Dhaka) and Agrabad (Chattogram).' : undefined} />)}
    </div>
    <div class="ct-social">
      <h3 class="t-heading-m">Follow CodersTrust</h3>
      <ul class="cluster" role="list">
        {
          SOCIAL.map((s) => (
            <li>
              <a class="ct-social__link" href={s.href} rel={linkAttrs(s.href).rel}>
                <Icon name={s.id} size={20} />
                <span>{s.label}</span>
                <span class="sr-only"> (opens {new URL(s.href).hostname.replace('www.', '')})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="next" aria-labelledby="next-h">
    <SectionHeader id="next-h" eyebrow="After You Write" title="What Happens After Your Inquiry" lead="For program and funding inquiries, the first two steps are shared and the third follows your route." />
    <div class="ct-next">
      <StepFlow steps={[
        { title: 'Your Inquiry', text: 'In your inquiry, include two suitable times for a discovery conversation.' },
        { title: 'A Conversation', text: 'We talk through your goals, priority groups and timeline.' },
        // WP27: the third step follows the route chosen above; each line restates what that route's own page and contact card already say.
        { title: 'The Next Step Depends on Your Route', text: 'Development partners, governments, foundations, universities and local partners: a first cohort, designed with you. Employers training a team: a needs assessment of your roles. Impact investors: the deck and data room follow under NDA.' },
      ]} />
      <ul class="ct-c14" role="list">
        <li><CopyBlock block={FIRST_COHORT_REMINDER} /></li>
        <li data-fact="PD-04">Public procurement follows the agency’s own timeline.</li>
      </ul>
    </div>
    <PartnerStrip variant="grid" group="development" />
  </Section>

</BaseLayout>

<style>
  .ct-copy {
    margin: calc(-1 * var(--space-sm)) 0 var(--space-lg);
  }
  .ct-group + .ct-group {
    margin-top: var(--space-xl);
  }
  .ct-group__title {
    margin: 0 0 var(--space-md);
    color: var(--secondary);
  }
  .ct-routes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) {
    .ct-routes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .ct-routes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ct-route__icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
  }
  .ct-route__actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    padding-top: var(--space-sm);
  }
  /* Every route button is as wide as its card, so the long label ("Bring JobReady@Campus to Your Institution") is not the one button
     that stretches and wraps while its neighbors sit at their own width; a secondary link goes on the line below. A label that has to
     wrap does so in even lines. */
  .ct-route__actions :global(.btn) {
    flex: 1 1 100%;
    padding-inline: var(--space-compact);
    font-size: 0.9375rem;
  }
  .ct-route__actions :global(.btn__label) {
    text-wrap: balance;
  }
  .ct-social {
    margin-top: var(--space-lg);
  }
  .ct-social h3 {
    margin: 0 0 var(--space-sm);
  }
  .ct-social ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ct-social__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    color: var(--primary);
    font-weight: var(--fw-medium);
  }
  .ct-next {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .ct-c14 {
    list-style: none;
    margin: 0;
    padding: var(--space-md) 0 0;
    display: grid;
    gap: var(--space-sm);
    border-top: 1px solid var(--outline-variant);
    max-width: var(--measure);
    color: var(--on-surface-variant);
  }
  .ct-c14 :global(p) {
    margin: 0;
  }
</style>
