---
import { getEntry } from 'astro:content';
import CaseStudyPage from '../../../components/pages/impact/CaseStudyPage.astro';
import LearnerStory from '../../../components/pages/impact/LearnerStory.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import Fact from '../../../components/facts/Fact.astro';
import EvidenceTag from '../../../components/system/EvidenceTag.astro';
import photo from '../../../assets/images/pages/impact/her-power-training-lab.jpg';

const maria = await getEntry('stories', 'maria-dewan');
if (!maria) throw new Error('story maria-dewan missing');
// WP61 (cycle-33 review, GPT-6.1 Sol G6): the card’s narrative is two plain sentences, each resting on the story file, in place of the story’s second and third paragraphs ("... through her dedication and continuous enthusiasm for learning, was quickly initiated into the
// freelance marketplace ..."). The story file is unchanged (the Success Stories page builds its three steps from it, and checks the same phrases). The build stops if the story stops saying what the sentences say.
const storyText = (maria.body ?? '').replace(/\s+/g, ' ');
for (const phrase of [
  'Maria Dewan was a third-year Biology student when she first came across Her Power',
  'She enrolled in the Graphic Design course',
  'winning a company logo design on Freelancer.com',
  'with a growing portfolio, gradually winning more clients and higher-paying projects',
]) {
  if (!storyText.includes(phrase)) throw new Error(`story maria-dewan: "${phrase}" is not in the story text`);
}
const excerpt = 'Maria Dewan joined Her Power as a third-year Biology student. She studied Graphic Design, won logo-design work on Freelancer.com and built a portfolio with more clients and higher-paying projects.';
---

<CaseStudyPage
  slug="her-power"
  pageTitle="Her Power Case Study"
  description="Her Power, a project of Bangladesh’s ICT Division: 372 of 800 tracked women, from the 2,500 trained directly by CodersTrust, in work (47%)."
  stats={[{ id: 'PR-05' }]}
  heroPhoto={{ src: photo, alt: 'Women working on laptops in a Her Power training lab', assetId: 'case-her-power-training-lab', width: 1093, height: 714 }}
  context={[
    'Her Power is a project of the ICT Division of the Government of Bangladesh. It aims to help women become entrepreneurs and self-employed through digital skills, using technology safely.',
    'Within the national program, CodersTrust provided the curriculum, training manuals, mentorship guidelines and trainer training, and trained a cohort of women directly.',
  ]}
  challenges={[
    'Keeping students engaged and motivated.',
    'Giving feedback without face-to-face contact.',
    'Instructors and learners who were new to online tools.',
  ]}
  solution={[
    'Extra support to help learners adopt digital tools.',
    'Interactive, collaborative sessions.',
    'Regular check-ins and Q&A to keep learners on track.',
  ]}
>
  <!-- WP18b: the delivery band leads with CodersTrust's own role (GV-11), then the generic practices of the list below it. -->
  <Fragment slot="solution-lead">
    <p class="hp__role" data-fact="GV-11"><strong>CodersTrust’s role:</strong> <Fact id="GV-11" as="span" under="CodersTrust’s role" /></p>
  </Fragment>

  <Fragment slot="results">
    <Callout tone="bluf" label="Program Results">
      <EvidenceTag type="Program Record" />
      <Fact id="PR-05" as="p" />
    </Callout>
    <div class="hp__scale" data-fact="GV-01">
      <h3 class="t-heading-m">National Scale: A Different Measure</h3>
      <p>The in-work figure above covers 800 tracked women from the 2,500 that CodersTrust trained directly. The national program’s reach is counted separately: <Fact id="GV-01" as="span" /></p>
    </div>
  </Fragment>

  <Fragment slot="story">
    <LearnerStory
      factId="ST-06"
      name="Maria Dewan"
      program="Her Power"
      tag
      outcome="Won a company logo design on Freelancer.com, then built a freelance portfolio."
      excerpt={excerpt}
      image={maria.data.photo}
      imageAlt="Portrait of Maria Dewan"
      assetId="story-maria-dewan"
    />
  </Fragment>
</CaseStudyPage>

<style>
  .hp__scale {
    display: grid;
    gap: var(--space-xs);
    max-width: var(--measure);
  }
  /* WP50 (owner design rule 2026-10-16): no left-edge accent bar on the role box (it was a square 4 px tertiary border); the box has its 1 px outline and radius, as the other notes do. */
  .hp__role {
    margin: 0 0 var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
    color: var(--on-surface);
  }
  .hp__scale > :global(*) {
    margin: 0;
  }
</style>
