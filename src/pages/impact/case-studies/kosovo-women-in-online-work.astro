---
import CaseStudyPage from '../../../components/pages/impact/CaseStudyPage.astro';
import LearnerStory from '../../../components/pages/impact/LearnerStory.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import Fact from '../../../components/facts/Fact.astro';
import { fact } from '../../../data/facts';

// ST-05 is already an anonymized outcome line; the program is shown beside it, so the line is shortened to "A participant …".
const raw = fact('ST-05').text.split(' in Kosovo ')[1];
if (!raw) throw new Error('ST-05 text no longer has the expected "A … participant in Kosovo <outcome>" shape');
const outcome = `A participant ${raw.replace('; earning', ' and is earning')}.`;
---

<CaseStudyPage
  slug="kosovo-women-in-online-work"
  pageTitle="Kosovo Women in Online Work"
  description="Women in Online Work, a 2017 pilot in Kosovo with the World Bank Group: 102 of 150 women placed (68%). Placement is gross program data."
  stats={[{ id: 'PR-02', evidence: 'Program data — gross in-work rate among graduates, no comparison group' }]}
  context={[
    'In 2017 the World Bank Group sought market-oriented skills to help young refugee women in Kosovo find meaningful employment.',
    'The Women in Online Work (WoW) pilot tested whether online work suits young Kosovar women around the country.',
  ]}
  challenges={[
    'Weak infrastructure in a post-war country.',
    'Few child- and elder-care options, leaving little time to learn.',
    'Cultural attitudes that discourage women from working.',
    'Few training materials designed for online learning.',
  ]}
  solution={[
    'Two-phase delivery that built digital literacy first.',
    'Interactive, collaborative sessions to keep learners engaged.',
    'Accessible, engaging digital learning materials.',
    'Soft skills paired with career counseling.',
    'Marketplace integration: bidding on and doing real online work.',
  ]}
>
  <Fragment slot="results">
    <Callout tone="bluf" label="Program data — gross in-work rate among graduates, no comparison group">
      <Fact id="PR-02" as="p" />
    </Callout>
    <p>Women in Online Work was a pilot with the World Bank Group in 2017. The figures above are from CodersTrust program records.</p>
  </Fragment>

  <Fragment slot="story">
    <LearnerStory program="Women in Online Work, Kosovo" outcome={outcome} />
  </Fragment>
</CaseStudyPage>
