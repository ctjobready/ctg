---
import CaseStudyPage from '../../../components/pages/impact/CaseStudyPage.astro';
import LearnerStory from '../../../components/pages/impact/LearnerStory.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import EvidenceTag from '../../../components/system/EvidenceTag.astro';
import Fact from '../../../components/facts/Fact.astro';
import { fact, sources } from '../../../data/facts';
import { linkAttrs } from '../../../lib/url';
import { photo } from '../../../data/photos';
import Icon from '../../../components/system/Icon.astro';

// WP55: her portrait (the previous site's case study showed it beside her story; CodersTrust-owned, owner ruling 2026-10-18), with its own permissions row.
const portrait = photo('impact/kosovo-graduate-portrait');
// WP74: the World Bank and Ministry of Economic Development of Kosovo release of 13 February 2017, the source of the 77 in PR-02b.
// 2026-10-22: linked through the Ministry's own copy (MED17), which carries the 77; the World Bank page is gone (404) and its archived copy returns errors.
const release2017 = linkAttrs(sources.MED17.url ?? '');

// ST-05 names the learner as the previous site did (Erlisa Zherka, "Trainee, WOW Pilot"); the program is shown beside the name, so the line is shortened to the outcome.
const raw = fact('ST-05').text.split(' in Kosovo, ')[1];
if (!raw) throw new Error('ST-05 text no longer has the expected "<Name>, a … participant in Kosovo, <outcome>" shape');
const outcome = `She ${raw.replace('; earning', ' and is earning')}.`;

// PR-02 reads "<program>, 2017: <in work>; <earnings>; <contracts>; <ventures>". The page shows the first two as labeled lines.
// WP57b (owner decision 2026-10-19, "Remove the 56 item"): the contracts clause ("56 won online contracts (~180 jobs)") is not shown anywhere on the site: beside the World Bank's 77 trainees who won at least one online work contract it read as a
// second count of the same measure. PR-02 is shared with the lines that stay (102 of 150 in work, the earnings), so the register entry is unchanged and only what renders changes. The venture count is an owner-confirmation item.
const parts = fact('PR-02').text.split(': ')[1]?.split('; ');
if (!parts || parts.length < 3 || !/^102 of the 150 women trained were in work/.test(parts[0]) || !/earned/.test(parts[1])) throw new Error('PR-02 no longer has the expected "<in work>; <earnings>; <contracts>" shape');
const results = [
  { label: 'In Work', text: parts[0] },
  { label: 'Online Earnings', text: parts[1] },
];
---

<CaseStudyPage
  slug="kosovo-women-in-online-work"
  pageTitle="Kosovo Women in Online Work"
  description="Women in Online Work, a 2016–2017 pilot in Kosovo with the World Bank Group: 102 of the 150 women trained were in work (68%)."
  stats={[{ id: 'PR-02' }]}
  context={[
    'The World Bank Group sought market-oriented skills to help young women in Kosovo find meaningful employment.',
    'The Women in Online Work (WoW) pilot prepared young women in five municipalities in Kosovo for online work.',
  ]}
  challenges={[
    'Limited infrastructure.',
    'Few child- and elder-care options, leaving little time to learn.',
    'Cultural attitudes that discourage women from working.',
  ]}
  solution={[
    'Two phases: front-end web development first, then tracks in coding, graphic design and digital marketing.',
    'Interactive, collaborative sessions to keep learners engaged.',
    'Soft skills paired with career counseling.',
    'Marketplace integration: bidding on and doing real online work.',
  ]}
>
  <Fragment slot="results">
    <Callout tone="bluf" label="Program Results">
      <EvidenceTag type="Program Record" />
      <dl class="kw__results" data-fact="PR-02">
        {results.map((r) => <div><dt>{r.label}</dt><dd>{r.text}</dd></div>)}
      </dl>
    </Callout>
    <p>Women in Online Work was a pilot with the World Bank Group in 2016–2017. The figures above are from CodersTrust program records.</p>
    <!-- WP55 (owner decision 2026-10-17, "Show both"): the World Bank's own count for the same pilot, in its full sentence (PR-02b), directly after the program records. -->
    <p><Fact id="PR-02b" /></p>
    <!-- WP74 (Sonnet XHigh run 3): the World Bank's February 2017 release, the source of PR-02b's 77 (WBKOSOVO17); the page had no link to it. The link is in the results, beside the line it sources. -->
    <p><a class="link" href={release2017.href} rel={release2017.rel}>Read the February 2017 Release<span class="sr-only"> {release2017.srText}</span><Icon name="arrow-right" size={16} /></a></p>
  </Fragment>

  <Fragment slot="story">
    <LearnerStory factId="ST-05" name="Erlisa Zherka" assetId="story-erlisa-zherka" image={portrait.src} imageAlt={portrait.alt} imageAssetId={portrait.assetId} program="Women in Online Work, Kosovo, 2016–2017" outcome={outcome} tag />
  </Fragment>
</CaseStudyPage>

<style>
  .kw__results {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
  }
  .kw__results > div {
    display: grid;
    gap: var(--space-xs);
  }
  .kw__results dt {
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secondary);
  }
  .kw__results dd {
    margin: 0;
  }
</style>
