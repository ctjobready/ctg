---
import CaseStudyPage from '../../../components/pages/impact/CaseStudyPage.astro';
import Icon from '../../../components/system/Icon.astro';
import { sources } from '../../../data/facts';
import { linkAttrs } from '../../../lib/url';

/**
 * Digital Jobs Albania, a short case study (WP55, owner decision 2026-10-18; WP55 spec item 6). It follows the template of the other four, in the World Bank's own wording (press release, Tirana, 14 September 2021):
 * "a new World Bank initiative" that gives "women aged 16-35 years" an "intensive 3-month training in digital skills", "implemented in partnership with the Government of Albania, Coderstrust (an international digital
 * skills training provider), and EuroPartners Development (a local consulting company)". The owner's ruling (decision 2) is that this is CodersTrust's work, so the page says so and never names another company.
 * WP162 (owner, 2026-11-02/03; register deck sync 2026-11-03): CodersTrust took part in 2021 only (Learnio, which the World Bank's May 2022 blog names, is the former CodersTrust Global ApS), so the context says so and the years are 2021.
 * The World Bank's two May 2022 figures (PR-07, 500+ enrolled; PR-08, 5,000+ interested) count the whole program, so they are removed: the hero shows no stat tile, and the Results band says why no figure is shown
 * and keeps the links to the September 2021 release and the May 2022 update. No money amount, price or investment figure appears. There is no learner story, so the template leaves that band out (CaseStudyPage).
 */
const release = linkAttrs(sources.WBDJA21.url ?? '');
const update = linkAttrs(sources.WBBLOG22.url ?? '');
---

<CaseStudyPage
  slug="digital-jobs-albania"
  pageTitle="Digital Jobs Albania"
  description="Digital Jobs Albania, a World Bank initiative: an online three-month course in digital skills for women in Albania. CodersTrust took part in 2021."
  context={[
    'In September 2021, the World Bank launched Digital Jobs Albania to help women in Albania gain better access to online work and connect with the global economy.',
    'The initiative was implemented with the Government of Albania, CodersTrust and EuroPartners Development, a local consulting company. CodersTrust took part in 2021.',
  ]}
  challenges={[
    'Women’s labor force participation in Albania is lower than men’s.',
    'Online freelancing takes technical skills, and the soft skills to compete for project work.',
  ]}
  solution={[
    'An intensive three-month online training program in digital skills.',
    'Tracks in graphic design, web development and digital marketing.',
    'Mentorship, and help with the soft skills needed to compete for project work on online freelancer websites.',
  ]}
>
  <p slot="solution-lead" class="dja__lead">The World Bank names CodersTrust as the international digital skills training provider in the partnership. The initiative gave participants:</p>

  <Fragment slot="results">
    <p>The World Bank’s published figures cover the whole program, including the months after CodersTrust’s part ended in 2021, so they are not shown here as CodersTrust results.</p>
    <p><a class="link" href={release.href} rel={release.rel}>Read the World Bank Announcement<span class="sr-only"> (opens worldbank.org)</span><Icon name="arrow-right" size={16} /></a></p>
    <p><a class="link" href={update.href} rel={update.rel}>Read the World Bank’s May 2022 Update<span class="sr-only"> (opens web.archive.org)</span><Icon name="arrow-right" size={16} /></a></p>
  </Fragment>
</CaseStudyPage>

<style>
  .dja__lead {
    margin: 0 0 var(--space-md);
    color: var(--on-surface-variant);
  }
</style>
