---
import CaseStudyPage from '../../../components/pages/impact/CaseStudyPage.astro';
import LearnerStory from '../../../components/pages/impact/LearnerStory.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import Fact from '../../../components/facts/Fact.astro';
import EvidenceTag from '../../../components/system/EvidenceTag.astro';
import { fact } from '../../../data/facts';

// ST-01 and ST-02 name the learners as the previous site did (Aklima Akder, Shamim Ahmed); the reported outcome is the quoted part.
const quoteOf = (id: string) => {
  const m = fact(id).text.match(/“([^”]+)”/);
  if (!m) throw new Error(`${id} has no quoted outcome`);
  return m[1];
};
// ST-02 spells the quoted "$32K" out once, in brackets: "(about $32,000; …)".
const spelledOut = (id: string) => /\((about \$[\d,]+)/.exec(fact(id).text)?.[1];
const shamim = spelledOut('ST-02');
if (!shamim) throw new Error('ST-02 no longer spells out its quoted amount');
---

<CaseStudyPage
  slug="undp-yes-korail"
  pageTitle="UNDP YES Korail Case Study"
  storyEyebrow="In a Learner’s Words"
  storyTitle="Two Learner Journeys"
  description="UNDP YES, a 2017 program with UNDP in Korail, Dhaka: 350 enrolled, 97.5% completed, 67% of the 350 enrolled found a first job within three months."
  stats={[{ id: 'PR-03' }]}
  context={[
    'Young people in Dhaka’s urban informal settlements face limited access to education and training, discrimination and little exposure to careers or networks.',
    'In 2017 CodersTrust trained young people from the Korail settlement in Dhaka, with UNDP, the Government of Bangladesh and Swanirvar Bangladesh. Program completers went on to mentor local youth.',
  ]}
  challenges={[
    'Day labor pulled young people away from training.',
    'Limited access to electricity, computers and money to study.',
    'No computer literacy and too little English to work with clients.',
  ]}
  solution={[
    'An awareness campaign, courtyard meetings and parent counseling in Korail.',
    'A fully equipped lab to practice and work.',
    'A basic English communication module.',
    'One-to-one mentoring for students.',
  ]}
>
  <Fragment slot="results">
    <Callout tone="bluf" label="Program Results, 2017">
      <EvidenceTag type="Program Record" />
      <Fact id="PR-03" as="p" />
    </Callout>
  </Fragment>

  <Fragment slot="story">
    <LearnerStory factId="ST-01" name="Aklima Akder" assetId="story-aklima-akder" program="UNDP YES, Korail" outcome={`“${quoteOf('ST-01')}”`} excerpt="Reported by the learner." tag />
    <div class="uy__gap"></div>
    <LearnerStory factId="ST-02" name="Shamim Ahmed" assetId="story-shamim-ahmed" program="UNDP YES, Korail" outcome={`“${quoteOf('ST-02')}”`} excerpt={`Reported earnings of ${shamim} over three years.`} outlier tag />
  </Fragment>
</CaseStudyPage>

<style>
  .uy__gap {
    height: var(--space-md);
  }
</style>
