---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import Icon from '../../../components/system/Icon.astro';
import CaseGrid from '../../../components/pages/impact/CaseGrid.astro';
import { articleNode, desc, title, discoveryCta } from '../../../components/pages/impact/page-utils';
import { CASE_STUDIES } from '../../../components/pages/impact/case-studies';
import { MICRO_COMMITMENT } from '../../../data/copy';
import { itemList } from '../../../components/pages/impact/jsonld';
import { linkAttrs } from '../../../lib/url';
import { webPage } from '../../../lib/schema';

const path = '/impact/case-studies/';
// WP103 (Sonnet Medium run 2, kit 69): "figure", not "result", because Albania's figure was reported enrollment, not a result.
// WP162 (owner decision 2026-11-03) had made the description and the lead say "with the figures and bases where they exist", while the Albania case study had no figure.
// WP164 (owner decision 2026-11-03): every card has a figure again (Albania: PR-09, 100+ of 500 trained, partner-reported), so they say "each with its figure and its base" again.
const description = desc('Five CodersTrust case studies, each with its figure and its base: Women in Online Work, Digital Jobs Albania, WSDFM, UNDP YES and Her Power.');
// WP161-A (adversarial review A-04): the Article headline is the H1 (it was "CodersTrust Case Studies"); the CollectionPage and ItemList names stay.
const jsonLd = [
  webPage({ path, name: 'CodersTrust Case Studies', description, type: 'CollectionPage' }),
  itemList('CodersTrust case studies', CASE_STUDIES.map((c) => ({ name: c.name, path: c.path }))),
  articleNode({ path, headline: 'Five Programs Across Kosovo, Albania and Bangladesh', description, datePublished: '2026-10-08', dateModified: '2026-11-03', author: 'CodersTrust' }), // WP164 (2026-11-03): the lead, and the Albania card's years and figure (PR-09). Earlier: WP162 (2026-11-03): the lead, and the Albania card's years and figure. Earlier: WP142 (2026-11-01): the card label "Partner and Place" (it read "Partner & Place"), so the date moves (owner rule: any visible text change)
];
const d = discoveryCta();

---

<BaseLayout title={title('Case Studies: Kosovo, Albania and Bangladesh')} description={description} path={path} breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'Case Studies' }]} jsonLd={jsonLd}>
  <!-- WP60 (cycle-32 review, Kimi K1 and K2): the H1 was "Five Programs, from Kosovo to Bangladesh" (it said "Learners Reaching Paid Work, ...", but the Albania card shows an enrollment figure, not a work result) and the hero photograph is the Kosovo training room (HERO["case-studies-hub"] in
       src/data/photos.ts; it was the Bhutan inauguration, and no Bhutan case study exists). The grid's H2 is "Results First, Program by Program" (it said "Five Programs, Results First", which repeated the H1's and the lead's first words). The Albania card's figure was labelled "Reported Enrollment" (CaseGrid); WP162 (owner decision 2026-11-03) left the Albania card with no figure, and WP164 (owner decision 2026-11-03) gives it PR-09 as its "Result" (partner-reported, no "Delivered" tag).
       WP63 (cycle-35 review, Kimi K5; also Kimi in cycle 34): the H1 is "Five Programs Across Kosovo, Albania and Bangladesh" (the range "from Kosovo to Bangladesh" left Albania, one of the five, unnamed), as the Impact page's "Five Programs" band is headed; the <title> names the same three countries. -->
  <Hero variant="inner" eyebrow="Impact" title="Five Programs Across Kosovo, Albania and Bangladesh" lead="Five programs, each with its figure and its base." artSeed="case-studies-hub" />

  <Section aria-labelledby="cases-h">
    <SectionHeader id="cases-h" eyebrow="Case Studies" title="Results First, Program by Program" />
    <CaseGrid />
    <p class="ch__link"><a class="link" href={linkAttrs('/impact/#evidence-ladder').href}>See Where These Results Sit on the Evidence Ladder<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <CTABand id="cta" heading="Talk to Us About a First Cohort" text="In a discovery session, we start planning a first cohort for your own program. In your inquiry, include two suitable times." cta={{ label: d.label, href: d.href }} secondary={{ label: 'Read the Randomized Trial Results', href: '/impact/independent-evaluation/' }} micro={MICRO_COMMITMENT} />
</BaseLayout>

<style>
  .ch__link {
    margin: var(--space-md) 0 0;
  }
</style>
