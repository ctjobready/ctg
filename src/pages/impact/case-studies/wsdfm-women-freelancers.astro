---
import { getEntry } from 'astro:content';
import CaseStudyPage from '../../../components/pages/impact/CaseStudyPage.astro';
import LearnerStory from '../../../components/pages/impact/LearnerStory.astro';
import CopyText from '../../../components/pages/impact/CopyText.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import Fact from '../../../components/facts/Fact.astro';
import Img from '../../../components/ui/Img.astro';
import Icon from '../../../components/system/Icon.astro';
import EvidenceTag from '../../../components/system/EvidenceTag.astro';
import { fact } from '../../../data/facts';
import { BIGD_FULL, RCT_HEADLINE, TRIAL_OFFERED, WSDFM_ENROLLED } from '../../../data/copy';
import { linkAttrs } from '../../../lib/url';
import photo from '../../../assets/images/pages/impact/wsdfm-training-group.jpg';

// WP42 (cycle-19 review): the hero's two paragraphs (the plain-language trial line and the program-record line) are gone, because the three tiles under them show both results; one line directly above the tiles (heroNote) says
// what kinds of evidence they are. The detailed results and the chart below are unchanged, and scripts/check-facts.mjs lists this page as exempt from the [PLAIN-LINE] (the Independent Evaluation page keeps it).
// WP54 (cycle-28 review, GPT-6.1 Sol G8): the hero note is where the page first names the evaluator, so it spells it out (BIGD_FULL); the tiles' evidence lines, the trial sub-heading and the chart note below use the abbreviation it introduces.
// WP87 (CLR review, Opus XHigh run 1, Polish): the note says "the randomized trial by the BRAC Institute of Governance and Development (BIGD)" (it said "(BIGD)’s randomized trial") and "among the 1,000 women enrolled", so it has its antecedent while it still stands above the tiles (it must, so the evaluator is spelled out before the tiles say "BIGD", WP54 G8).
// WP60 (cycle-32 review, Claude S4; owner answer 2026-10-20, "711 of 1000 is correct. The BIGD study only studied 833."): the note above the tiles says the trial's count beside the records the first tile shows ("711 of 1,000"): "Program records and a separate randomized trial of 833 women in the
// CodersTrust’s WSDFM program, by ...". The 833 is RC-07's (TRIAL_WOMEN, src/data/copy.ts; the note's data-fact names RC-07), the trial's whole sample (425 offered a place, 408 control), so the note does not say the 833 are "of" the 1,000.
// WP76 (owner answer 2026-10-22: "the 1,000 are the women enrolled"): the first tile, the program-results sentence and the meta description name the base ("711 of the 1,000 women enrolled were in work"), all read from PR-01; the description says "WSDFM (Porticus)" (PR-06's wording) to stay within 155 characters.
// WP166-C (R4-05): the hero leads with the trial tiles (RC-02, then RC-01) and ends with the program record (PR-01), with the "Program records, not trial results" note directly under it (heroNoteAfter).
// The first tile is now the page's first mention of the evaluator, so its evidence line spells BIGD out (WP54 G8, settled) and the note, which spelled it out before, uses the abbreviation.
// WP172 (owner decision 2026-11-27): the trial figures are the published study's (Arman et al., Economic Development and Cultural Change 2026; EDCC26), not the May 2022 report's. The employment-status chart (RC-09, the report's)
// is not in the study and is gone; the results band keeps the program record, the trial's headline and the link to the Trial page. The meta description's income figure is RC-01's tile, read here (it said "41%", typed).
const incomeOffered = fact('RC-01').stat?.numeric;
if (incomeOffered === undefined) throw new Error('WSDFM case study: RC-01 no longer has a numeric stat (the meta description reads it)');
const PUBLISHED = 'published in Economic Development and Cultural Change (2026)';

const samina = await getEntry('stories', 'samina-tasneem-chowdhury');
if (!samina) throw new Error('story samina-tasneem-chowdhury missing');
// WP61 (cycle-33 review, GPT-6.1 Sol P1; same fix as Foundations, WP60 GM9): the card shows her outcome line alone, "Completed 90+ projects as a freelance graphic designer on Fiverr." The story’s sentence under it ("She has completed 90+ projects on Fiverr so far.",
// ST-03) said it a second time. The outcome line rests on that sentence, so the build stops if the story stops saying it.
if (!(samina.body ?? '').includes('She has completed 90+ projects on Fiverr so far.')) throw new Error('Samina story no longer has the 90+ projects sentence');
---

<CaseStudyPage
  slug="wsdfm-women-freelancers"
  pageTitle="WSDFM: Evaluated by a Randomized Trial"
  description={`WSDFM (Porticus): a randomized trial of the program found women offered a place had an estimated ${incomeOffered}% higher monthly income than the control group.`}
  heroNote={`Program records, not trial results; the ${TRIAL_OFFERED} women offered a place in the randomized trial by BIGD were among the ${WSDFM_ENROLLED} women enrolled.`}
  heroNoteFacts={['RC-07']}
  heroNoteAfter
  trialLink
  stats={[
    { id: 'RC-02', evidence: `Randomized trial by ${BIGD_FULL}, ${PUBLISHED}` },
    { id: 'RC-01', evidence: 'BIGD randomized trial, published study (2026)' },
    { id: 'PR-01' },
  ]}
  context={[
    'Porticus commissioned CodersTrust to run a skills project for women, focused on ICT skills for freelancing marketplaces and local jobs, and on women’s empowerment.',
    // WP99 (owner answers 2026-10-28, Q6 and the correction of the same day; register PR-01a): the funder is a specific foundation, written "Dutch Foundation" (singular); Manusher Jonno Foundation is named in text only (no logo: there is no permissions row for one).
    'The project was funded by the Dutch Foundation advised by Porticus, with Manusher Jonno Foundation as outreach partner.',
    'Women in Bangladesh have limited access to the skills and training needed to succeed in the workforce, which restricts their employment opportunities.',
  ]}
  challenges={[
    'Low awareness of freelancing reduced initial interest.',
    'Many trainees lacked basic computer literacy, a computer or an internet connection.',
    'Social obstacles drove dropout up.',
  ]}
  solution={[
    'Campus outreach, roadshows, seminars, parent counseling sessions and online campaigns.',
    'Basic computer literacy added to the curriculum.',
    'Family counseling and a stipend for active students.',
    'One-to-one mentoring support for students.',
  ]}
>
  <figure slot="context" class="wf__photo">
    <Img src={photo} alt="Women trainees and a CodersTrust Bangladesh banner at a WSDFM training session" width={977} height={568} widths={[480, 977]} sizes="(min-width:1024px) 560px, 90vw" assetId="case-wsdfm-training-group" />
    <figcaption>A WSDFM training session.</figcaption>
  </figure>

  <Fragment slot="results">
    <Callout tone="bluf" label="Program Results">
      <EvidenceTag type="Program Record" />
      <Fact id="PR-01" as="p" />
    </Callout>

    <div>
      <h3 class="t-heading-l">What the Randomized Trial Found</h3>
      <p class="wf__evid"><EvidenceTag type="Randomized Trial" /> BIGD randomized trial, {PUBLISHED}</p>
      <CopyText block={RCT_HEADLINE} class="wf__lead" />
    </div>

    <p><a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>Read the Randomized Trial Results<Icon name="arrow-right" size={16} /></a></p>
  </Fragment>

  <Fragment slot="story">
    <LearnerStory
      factId="ST-03"
      name="Samina Tasneem Chowdhury"
      program="WSDFM, first batch"
      tag
      outcome="Completed 90+ projects as a freelance graphic designer on Fiverr."
      image={samina.data.photo}
      imageAlt={samina.data.photoAlt}
      assetId="story-samina-tasneem-chowdhury"
    />
  </Fragment>
</CaseStudyPage>

<style>
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h3.t-heading-l {
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  @media (min-width: 768px) {
    h3.t-heading-l {
      letter-spacing: -0.5px;
    }
  }
  .wf__photo {
    margin: 0;
    max-width: 560px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--primary-fixed);
  }
  .wf__photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .wf__photo figcaption {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--outline);
  }
  .wf__evid {
    margin: var(--space-xs) 0 0;
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-medium);
    color: var(--secondary);
  }
  :global(.wf__lead) {
    margin: var(--space-sm) 0 0;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--on-surface);
  }
</style>
