---
import { getEntry } from 'astro:content';
import CaseStudyPage from '../../../components/pages/impact/CaseStudyPage.astro';
import LearnerStory from '../../../components/pages/impact/LearnerStory.astro';
import StackedBars from '../../../components/pages/impact/StackedBars.astro';
import CopyText from '../../../components/pages/impact/CopyText.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import Fact from '../../../components/facts/Fact.astro';
import Img from '../../../components/ui/Img.astro';
import Icon from '../../../components/system/Icon.astro';
import EvidenceTag from '../../../components/system/EvidenceTag.astro';
import { fact } from '../../../data/facts';
import { BIGD_FULL, RCT_HEADLINE, TRIAL_WOMEN } from '../../../data/copy';
import { linkAttrs } from '../../../lib/url';
import photo from '../../../assets/images/pages/impact/wsdfm-training-group.jpg';

// WP42 (cycle-19 review): the hero's two paragraphs (the plain-language trial line and the program-record line) are gone, because the three tiles under them show both results; one line directly above the tiles (heroNote) says
// what kinds of evidence they are. The detailed results and the chart below are unchanged, and scripts/check-facts.mjs lists this page as exempt from the [PLAIN-LINE] (the Independent Evaluation page keeps it).
// WP54 (cycle-28 review, GPT-6.1 Sol G8): the hero note is where the page first names the evaluator, so it spells it out (BIGD_FULL); the tiles' evidence lines, the trial sub-heading and the chart note below use the abbreviation it introduces.
// WP60 (cycle-32 review, Claude S4; owner answer 2026-10-20, "711 of 1000 is correct. The BIGD study only studied 833."): the note above the tiles says the trial's count beside the records the first tile shows ("711 of 1,000"): "Program records and a separate randomized trial of 833 women in the
// predecessor program, by ...". The 833 is RC-07's (TRIAL_WOMEN, src/data/copy.ts; the note's data-fact names RC-07), the trial's whole sample (425 offered a place, 408 control), so the note does not say the 833 are "of" the 1,000.
// RC-09 (BIGD employment status at follow-up). The chart values must match the register text.
const control = [47.2, 40.9, 11.9];
const offered = [36.9, 34.6, 28.5];
const rc09 = fact('RC-09').text;
for (const v of [...control, ...offered]) if (!rc09.includes(`${v.toFixed(1)}%`)) throw new Error(`RC-09 chart value ${v} is not in the register text`);

const samina = await getEntry('stories', 'samina-tasneem-chowdhury');
if (!samina) throw new Error('story samina-tasneem-chowdhury missing');
const paras = (samina.body ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
// Trimmed to the sentence the register backs (ST-03: 90+ projects on Fiverr); the story's generic sentence before it is left out.
const excerpt = paras[2].split(/(?<=\.)\s+/).find((x) => x.includes('90+ projects on Fiverr'));
if (!excerpt) throw new Error('Samina story no longer has the 90+ projects sentence');
---

<CaseStudyPage
  slug="wsdfm-women-freelancers"
  pageTitle="WSDFM Case Study"
  description="WSDFM, commissioned by Porticus: a randomized trial of the predecessor program found income rose for women offered a place; 711 of 1,000 women in work."
  heroNote={`Program records and a separate randomized trial of ${TRIAL_WOMEN} women in the predecessor program, by ${BIGD_FULL}.`}
  heroNoteFacts={['RC-07']}
  trialLink
  stats={[
    { id: 'PR-01' },
    { id: 'RC-02', evidence: 'BIGD randomized trial, May 2022' },
    { id: 'RC-01', evidence: 'BIGD randomized trial, May 2022' },
  ]}
  context={[
    'Porticus commissioned CodersTrust to run a skills project for women, focused on ICT skills for freelancing marketplaces and local jobs, and on women’s empowerment.',
    'Women in Bangladesh have limited access to the skills and training needed to succeed in the workforce, which restricts their employment opportunities.',
  ]}
  challenges={[
    'Low awareness of freelancing reduced initial interest.',
    'Many trainees lacked basic computer literacy, a computer or an internet connection.',
    'Social obstacles drove dropout up.',
  ]}
  solution={[
    'Campus activation, roadshows, seminars, parent counseling sessions and online campaigns.',
    'Basic computer literacy added to the curriculum.',
    'Family counseling and a stipend for active students.',
    'One-to-one mentoring support for students.',
  ]}
>
  <figure slot="context" class="wf__photo">
    <Img src={photo} alt="Women trainees and a CodersTrust Bangladesh banner at a WSDFM training session" width={977} height={568} widths={[480, 977]} sizes="(min-width:1024px) 560px, 90vw" assetId="case-wsdfm-training-group" />
    <figcaption>A WSDFM training session.</figcaption>
  </figure>

  <Fragment slot="results">
    <Callout tone="bluf" label="Program Results">
      <EvidenceTag type="Program Record" />
      <Fact id="PR-01" as="p" />
    </Callout>

    <div>
      <h3 class="t-heading-l">What the Randomized Trial Found</h3>
      <p class="wf__evid"><EvidenceTag type="Randomized Trial" /> BIGD randomized trial, May 2022</p>
      <CopyText block={RCT_HEADLINE} class="wf__lead" />
    </div>

    <div data-fact="RC-09">
      <StackedBars
        title="Employment Status at Follow-Up: Women Offered a Place vs. the Control Group"
        segments={['Unemployed', 'Other Employment', 'Freelancing']}
        rows={[
          { label: 'Control Group', values: control },
          { label: 'Women Offered a Place', values: offered },
        ]}
        note="BIGD randomized trial; women offered a place vs. control group (intent to treat). Follow-up November–December 2021."
      />
    </div>

    <p><a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>Read the Randomized Trial Results<Icon name="arrow-right" size={16} /></a></p>
  </Fragment>

  <Fragment slot="story">
    <LearnerStory
      factId="ST-03"
      name="Samina Tasneem Chowdhury"
      program="WSDFM, first batch"
      tag
      outcome="Completed 90+ projects as a freelance graphic designer on Fiverr."
      excerpt={excerpt}
      image={samina.data.photo}
      imageAlt={samina.data.photoAlt}
      assetId="story-samina-tasneem-chowdhury"
    />
  </Fragment>
</CaseStudyPage>

<style>
  /* a sub-section heading: heading-xl (28/36/600), DESIGN.md §3 "Supporting section or large card heading" */
  h3.t-heading-l {
    font-size: var(--fs-heading-xl);
    line-height: var(--lh-heading-xl);
    font-weight: var(--fw-semibold);
  }
  @media (min-width: 768px) {
    h3.t-heading-l {
      letter-spacing: -0.5px;
    }
  }
  .wf__photo {
    margin: 0;
    max-width: 560px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--primary-fixed);
  }
  .wf__photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .wf__photo figcaption {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--outline);
  }
  .wf__evid {
    margin: var(--space-xs) 0 0;
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-medium);
    color: var(--secondary);
  }
  :global(.wf__lead) {
    margin: var(--space-sm) 0 0;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--on-surface);
  }
</style>
