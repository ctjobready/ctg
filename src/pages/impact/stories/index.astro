---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import StoryGallery from '../../../components/pages/impact/StoryGallery.astro';
import type { StoryCardData } from '../../../components/pages/impact/story-types';
import { linkAttrs } from '../../../lib/url';
import { articleNode, desc, title, discoveryCta } from '../../../components/pages/impact/page-utils';
import { fact } from '../../../data/facts';
import { MICRO_COMMITMENT } from '../../../data/copy';
import { webPage } from '../../../lib/schema';

const path = '/impact/stories/';

// Stories from groups that need a documented release (UNDP YES Korail settlement residents; Kosovo participants, described
// by the program as refugee women) and the withheld STRONG-IT story are not kept in this public repository; the Korail
// and Kosovo outcomes appear below as register lines (ST-01, ST-02, ST-05) with the names the previous site published, and without photos.
// Photos of people whose age is not documented are replaced by the illustration.
const NO_PHOTO = new Set(['mysha-k-diya']);

// Positive, verbatim excerpts only (no hardship-led or personal-circumstance passages, and no income figures). Each must
// appear in the story file; an excerpt that stops before the end of its sentence is shown with an ellipsis. A card without
// an excerpt shows a plain role line from the story file, never an income headline.
const EXCERPTS: Record<string, string> = {
  'adrian-afraham': 'Following my completion of the course, I successfully secured my very first freelance job, which was followed by an enticing job offer.',
  'ashraful-alam-sani': 'I’m thrilled to announce that I’ve attained Fiverr Level One Seller rank!',
  'aysha-akter-bipasha': 'Their guidance has been instrumental in my ability to excel in this independent work style.',
  'mustafa-zabed': 'I am delighted to share that I successfully sold my first blog to an Upwork client',
  'mysha-k-diya': 'A paying job after only two months of Digital Accounting training is a huge accomplishment for me, made possible by the mentorship of CodersTrust.',
  'nushrat-jahan': 'I got my first job using Upwork and the client is overjoyed. He wants to collaborate with me more.',
  'zarin-tusnim-shifa': 'Finally, I have reached a truly remarkable milestone in my life: successfully completing my very first freelancing task.',
  'arfias-islam-rudro': 'I highly recommend CodersTrust to anyone seeking to thrive in the world of digital marketing.',
};

const all = await getCollection('stories');
for (const [id, ex] of Object.entries(EXCERPTS)) {
  const e = all.find((s) => s.id === id);
  if (!e?.data.quote?.includes(ex)) throw new Error(`excerpt for ${id} is not a verbatim part of the story quote`);
}
const cite = (ex: string) => (/[.!?]$/.test(ex) ? ex : `${ex}…`);
// An income figure may appear on a card only inside a verbatim register line (the anonymized lines below), marked as an individual result.
const INCOME = /[$€£]\s?\d|\b(?:BDT|Tk|taka)\b/i;
for (const s of all) {
  if (INCOME.test(EXCERPTS[s.id] ?? s.data.outcome)) throw new Error(`story card for ${s.id} shows an income figure; use a verbatim excerpt without one`);
}
const pathwayOf = (p: string): StoryCardData['pathway'] => (p === 'freelance' || p === 'job' || p === 'business' ? p : 'other');
const quoted = (id: string) => {
  const m = fact(id).text.match(/“([^”]+)”/);
  if (!m) throw new Error(`${id} has no quoted outcome`);
  return m[1];
};

const named = all;
const caseIds = ['samina-tasneem-chowdhury', 'maria-dewan'];
const toCard = (s: (typeof all)[number]): StoryCardData => {
  const ex = EXCERPTS[s.id];
  return {
    key: s.id,
    outcome: ex ? `“${cite(ex)}”` : s.data.outcome,
    name: s.data.name,
    role: s.data.program ?? s.data.role,
    pathway: pathwayOf(s.data.pathway),
    image: NO_PHOTO.has(s.id) ? undefined : s.data.photo,
    imageAlt: s.data.photoAlt,
    assetId: `story-${s.id}`,
  };
};
// Three fields (Starting Point · What They Did · Where They Are Now) only where the learner's story text supports all three: Samina Tasneem Chowdhury and Maria Dewan.
// Each field is built from the story file's own words; the phrases it rests on must appear in the file, or the build stops.
const STEPS: Record<string, { start: string; did: string; now: string; needs: string[] }> = {
  'samina-tasneem-chowdhury': {
    start: 'A trainee from the first batch of the WSDFM project, from a middle-income family in Bangladesh.',
    did: 'During the training period, she began offering her services as a graphic designer on the freelance marketplace Fiverr.',
    now: 'She continues to work as a freelancer and has completed 90+ projects on Fiverr so far.',
    needs: ['a trainee from the first batch', 'middle-income family in Bangladesh', 'During the training period, she began offering her services as a graphic designer on the freelance marketplace Fiverr.', 'She continues to work as a freelancer', 'She has completed 90+ projects on Fiverr so far.'],
  },
  'maria-dewan': {
    start: 'A third-year Biology student when she first came across the Her Power project implemented by CodersTrust.',
    did: 'She enrolled in the Graphic Design course and showed her skills by winning a company logo design on Freelancer.com.',
    now: 'She has continued her journey in the freelance space, with a growing portfolio, gradually winning more clients and higher-paying projects.',
    needs: ['was a third-year Biology student when she first came across the Her Power project implemented by CodersTrust', 'She enrolled in the Graphic Design course', 'She showed her skills by winning a company logo design on Freelancer.com', 'She has continued her journey in the freelance space, with a growing portfolio, gradually winning more clients and higher-paying projects.'],
  },
};
for (const [id, st] of Object.entries(STEPS)) {
  const body = (all.find((s) => s.id === id)?.body ?? '').replace(/\s+/g, ' ');
  for (const phrase of st.needs) if (!body.includes(phrase)) throw new Error(`story ${id}: "${phrase}" is not in the story text`);
}
const caseCards = caseIds.map((id) => {
  const c = toCard(named.find((s) => s.id === id)!);
  const st = STEPS[id];
  return { ...c, steps: { start: st.start, did: st.did, now: st.now } };
});
// WP18b: concrete examples lead (Samina’s 90+ projects, Maria’s first logo-design win, Erlisa’s full-time online contract, then the learners
// who report a first job, client or sale); the two endorsements whose excerpt praises the program without a concrete result follow last.
const ENDORSEMENTS = new Set(['aysha-akter-bipasha', 'arfias-islam-rudro']);
const legacyCards = named
  .filter((s) => !caseIds.includes(s.id))
  .sort((a, b) => Number(ENDORSEMENTS.has(a.id)) - Number(ENDORSEMENTS.has(b.id)) || a.data.name.localeCompare(b.data.name))
  .map(toCard);

const anon: StoryCardData[] = [
  { key: 'wow-erlisa-zherka', name: 'Erlisa Zherka', role: 'Women in Online Work, Kosovo, 2017', caveat: 'Individual story; not typical or promised', pathway: 'job', outcome: `She ${fact('ST-05').text.split(' in Kosovo, ')[1].replace('; earning', ' and is earning')}.`, assetId: 'story-erlisa-zherka' },
  { key: 'yes-aklima-akder', name: 'Aklima Akder', role: 'UNDP YES, Korail, 2017', caveat: 'Individual story; not typical or promised', pathway: 'freelance', outcome: `“${quoted('ST-01')}”`, assetId: 'story-aklima-akder' },
  { key: 'yes-shamim-ahmed', name: 'Shamim Ahmed', role: 'UNDP YES, Korail, 2017', caveat: 'Individual story; an outlier, not typical', pathway: 'freelance', outcome: `“${quoted('ST-02')}” (${/\((about \$[\d,]+)/.exec(fact('ST-02').text)?.[1]})`, assetId: 'story-shamim-ahmed' },
];
const cards = [...anon, ...legacyCards];
const description = desc('Learner stories and experiences from CodersTrust programs. Individual stories, not typical or promised outcomes.');
const jsonLd = [
  webPage({ path, name: 'CodersTrust success stories', description, type: 'CollectionPage' }),
  articleNode({ path, headline: 'Success Stories', description, datePublished: '2026-10-08', dateModified: '2026-10-08', author: 'CodersTrust' }),
];
const d = discoveryCta();
---

<BaseLayout title={title('Success Stories')} description={description} path={path} breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'Success Stories' }]} jsonLd={jsonLd}>
  <Hero variant="inner" eyebrow="Impact" title="Learners Turning Training into Paid Work" lead="Individual stories from CodersTrust learners, not typical or promised outcomes." artSeed="stories-hub" />

  <Section id="steps" aria-labelledby="steps-h">
    <SectionHeader id="steps-h" eyebrow="In Three Steps" title="Two Learner Journeys" />
    <StoryGallery cards={caseCards} filter={false} />
  </Section>

  <Section id="stories" tone="airy" aria-labelledby="stories-h">
    <SectionHeader id="stories-h" eyebrow="Learners" title="What Learners Report" />
    <StoryGallery cards={cards} visible={9} />
    <p class="st__notes">For results across a group of completers, see the <a class="link" href={linkAttrs('/impact/outcomes-2026/').href}>Impact Survey 2026</a> and the <a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>randomized trial</a>.</p>
  </Section>

  <CTABand id="cta" heading="Talk to Us About a First Cohort" cta={{ label: d.label, href: d.href }} secondary={{ label: 'How to Read the Evidence', href: '/impact/#evidence-ladder' }} micro={MICRO_COMMITMENT} />
</BaseLayout>

<style>
  .st__notes {
    margin: var(--space-lg) 0 0;
    max-width: var(--measure);
    font-size: var(--fs-body-xs);
    color: var(--outline);
  }
</style>
