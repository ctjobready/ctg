---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import LongformLayout from '../../../layouts/LongformLayout.astro';
import Icon from '../../../components/system/Icon.astro';
import EvidenceTag from '../../../components/system/EvidenceTag.astro';
import BarChart from '../../../components/ui/BarChart.astro';
import BeforeAfter from '../../../components/ui/BeforeAfter.astro';
import Fact from '../../../components/facts/Fact.astro';
import ReportSection from '../../../components/pages/impact/ReportSection.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import CopyText from '../../../components/pages/impact/CopyText.astro';
import FactStat from '../../../components/facts/FactStat.astro';
import EvidenceLadder from '../../../components/pages/impact/EvidenceLadder.astro';
import ColumnChart from '../../../components/pages/impact/ColumnChart.astro';
import PairedBars from '../../../components/pages/impact/PairedBars.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import { desc, title, val, discoveryCta, articleNode } from '../../../components/pages/impact/page-utils';
import * as D from '../../../components/pages/impact/outcomes-data';
import { fact } from '../../../data/facts';
import { SURVEY_EMPLOYMENT, MICRO_COMMITMENT } from '../../../data/copy';
import { dataset, webPage } from '../../../lib/schema';
import { canonicalUrl, url } from '../../../lib/url';

D.assertConsistent();
D.assertPublication();
// Every headline share in the data must appear in its register entry (the entry's own text, base and stat detail).
D.assertAgainstRegister((id) => {
  const f = fact(id);
  return [f.text, f.stat?.detail].filter(Boolean).join(' ');
});
// The downloadable CSV must be exactly what this module generates (published percentages and medians, no counts).
const csvPath = join(process.cwd(), 'public/data/outcomes-2026-aggregates.csv');
if (readFileSync(csvPath, 'utf8') !== D.csvText()) throw new Error('public/data/outcomes-2026-aggregates.csv is out of date; regenerate it from outcomes-data.ts');

const path = '/impact/outcomes-2026/';
const csvHref = url('/data/outcomes-2026-aggregates.csv');
const description = desc(`Surveyed completers: employment rose from ${val('OC-01', 'from')} to ${val('OC-01')} at the October 2026 survey.`);
const pc = D.percent;

const jsonLd = [
  webPage({ path, name: 'Impact Survey 2026: What Happened After Training', description, datePublished: D.DATE_PUBLISHED, dateModified: D.PAGE_LAST_REVIEWED }),
  articleNode({ path, headline: 'Impact Survey 2026: What Happened After Training', description, datePublished: D.DATE_PUBLISHED, dateModified: D.PAGE_LAST_REVIEWED, author: 'CodersTrust' }),
  {
    ...dataset({
      path,
      name: 'CodersTrust Impact Survey 2026 — published aggregates',
      description: 'Published aggregates from the CodersTrust Impact Survey, October 2026: employment, income, speed to earnings, career outcomes, learner experience and respondent profile among surveyed completers. Percentages and medians only, with no counts; districts under 3% are combined into Other districts.',
      datePublished: D.DATE_PUBLISHED,
      dateModified: D.PAGE_LAST_REVIEWED,
      methodology: 'Online alumni survey (LimeSurvey)',
      keywords: ['youth employment', 'digital skills training', 'Bangladesh', 'impact survey', 'freelancing'],
      variableMeasured: ['Employment rate before training and at the survey', 'Median monthly income', 'Direction of income change', 'Speed to first earnings', 'Career and education outcomes', 'Main income source', 'Recommendation score', 'Respondent profile'],
      spatialCoverage: 'Bangladesh',
      temporalCoverage: '2014/2026',
    }),
    distribution: { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: canonicalUrl('/data/outcomes-2026-aggregates.csv') },
  },
];

// Each label is the section's heading, word for word.
const toc = [
  { id: 'summary', label: 'Summary' },
  { id: 'ladder', label: 'Evidence Ladder and How to Read This Report' },
  { id: 'respondents', label: 'Who Responded' },
  { id: 'employment', label: 'Employment' },
  { id: 'speed', label: 'Speed to Earnings' },
  { id: 'income', label: 'Income: Three Separate Measures' },
  { id: 'careers', label: 'Career Outcomes' },
  { id: 'income-source', label: 'Main Income Source' },
  { id: 'experience', label: 'Learner Experience' },
  { id: 'no-prior-income', label: 'Completers with No Prior Income' },
  { id: 'methodology', label: 'Methodology and Limitations' },
  { id: 'download', label: 'Download the Data' },
];

// Every chart shows the published shares (percentages only; no count is held or derived). Districts under 3% are already combined.
const cell = (c: D.ShareCell) => ({ label: c.label, value: c.pct, display: `${c.pct.toFixed(1)}%` });
const districts = D.DISTRICTS.cells.map(cell);
const education = D.EDUCATION.cells.map(cell);
const career = [...D.CAREER.cells.slice(0, 7)].sort((a, b) => b.pct - a.pct).concat(D.CAREER.cells[7]).map(cell);
const source = D.SOURCE.cells.map(cell);
const ageItems = D.AGE.cells.map((c) => ({ label: c.label, value: c.pct }));
const speedItems = D.SPEED.map((c) => ({ label: c.label, value: c.pct }));
// Recommendation score: all eleven scores as published shares (percentages only, no fold); scores of 7 or higher are emphasized.
const recItems = D.RECOMMEND.cells.map((c) => ({ label: c.label, value: c.pct, emphasis: Number(c.label) >= 7 }));
const incomeItems = D.INCOME_DIRECTION.map(cell);
// OC-02 states its count (34 of 47), so the one derived share on the page is computed from that stated count.
const priorItems = [
  { label: `Earning at the October 2026 Survey (${D.NO_PRIOR.earning} of ${D.NO_PRIOR.base})`, n: D.NO_PRIOR.earning },
  { label: 'Not Earning', n: D.NO_PRIOR.base - D.NO_PRIOR.earning },
].map((c) => ({ label: c.label, value: pc(c.n, D.NO_PRIOR.base), display: `${pc(c.n, D.NO_PRIOR.base).toFixed(1)}%` }));
// One line for the recommendation chart: the register's share of scores of 7 or higher (OC-06), read from its text.
const sevenUp = /(\d+\.\d)% give a recommendation score of 7\+/.exec(fact('OC-06').text)?.[1];
if (!sevenUp) throw new Error('OC-06 no longer states the share of scores of 7 or higher');
const emp = fact('OC-01').stat!;
const before = parseFloat(emp.from!);
const after = emp.numeric!;
const typeRows = D.EMPLOYMENT_TYPES.map((t) => ({ label: t.label, before: t.before, after: t.after }));
// WP22: the direct answer under the H1 (40 to 60 words), read from OC-01 and OC-03: employment, income, and what the survey does not show.
const oc03 = fact('OC-03').stat!;
const directAnswer = `Among surveyed completers, employment rose from ${emp.from} before training to ${emp.value} at the October 2026 survey, and median monthly income rose from ${oc03.from} to ${oc03.value}. These are what respondents report: the survey describes outcomes among alumni who answered, and it does not show that training caused the change.`;
const answerWords = directAnswer.split(/\s+/).length;
if (answerWords < 40 || answerWords > 60) throw new Error(`Outcomes 2026 direct answer is ${answerWords} words (40 to 60)`);
const d = discoveryCta();
---

<LongformLayout
  title={title('Impact Survey 2026 Outcomes')}
  heading="Impact Survey 2026: What Happened After Training"
  eyebrow="Surveyed Completers"
  lead={directAnswer}
  description={description}
  path={path}
  updated={D.PAGE_LAST_REVIEWED}
  snapshot={D.SOURCE_SNAPSHOT}
  toc={toc}
  breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'Impact Survey 2026' }]}
  jsonLd={jsonLd}
>
  <ReportSection id="summary" title="Summary">
    <p class="ro__type"><EvidenceTag type="Surveyed Completers" /> <span>Every figure on this page is from the Impact Survey 2026.</span></p>
    <h3 class="t-heading-l ro__group">Earnings and Work</h3>
    <div class="ro__stats">
      <FactStat id="OC-03" />
      <FactStat id="OC-01" />
      <FactStat id="OC-02" />
      <FactStat id="OC-04" />
      <FactStat id="OC-07" />
      <FactStat id="OC-03b" />
    </div>
    <h3 class="t-heading-l ro__group">Speed to Earning</h3>
    <div class="ro__stats ro__stats--one">
      <FactStat id="OC-05" />
    </div>
    <h3 class="t-heading-l ro__group">Learner Experience</h3>
    <div class="ro__stats ro__stats--one">
      <FactStat id="OC-06" />
    </div>
  </ReportSection>

  <ReportSection id="ladder" title="Evidence Ladder and How to Read This Report">
    <p>This survey is the second rung of four kinds of evidence. It reports what surveyed completers say; it does not show that training caused any change.</p>
    <EvidenceLadder links={false} headingLevel={3} />
  </ReportSection>

  <ReportSection id="respondents" title="Who Responded" eyebrow="Chapter 1 of 4: The Respondents">
    <p data-fact="OC-01 OC-09">Nearly half of respondents were employed before training ({val('OC-01', 'from')}). <Fact id="OC-09" /></p>
    <p>Employment results rest on n = {D.EMPLOYMENT_BASE} paired answers and income results on n = {D.INCOME_BASE}.</p>
    <ColumnChart
      title="Respondents by Age Group"
      items={ageItems}
    />
    <BarChart
      title="Respondents by Highest Education"
      items={education}
      max={100}
    />
    <BarChart
      title="Respondents by District of Residence"
      items={districts}
      max={100}
    />
  </ReportSection>

  <ReportSection id="employment" title="Employment" eyebrow="Chapter 2 of 4: Work and Earnings">
    <p data-fact="OC-01">{val('OC-01')} of surveyed completers reported being employed at the October 2026 survey, compared with {val('OC-01', 'from')} before training. Separately, {D.EXIT.share}% of those employed before training reported that they were no longer employed.</p>
    <BeforeAfter
      title="Employment Before and After Training"
      before={{ label: 'Before', value: before, caption: 'Before Training' }}
      after={{ label: 'October 2026 Survey', value: after, caption: 'Surveyed Completers' }}
      delta={`+${(after - before).toFixed(1)} pp`}
    />
    <PairedBars
      title="Employment by Type, Before Training and at the October 2026 Survey"
      beforeLabel="Before Training"
      afterLabel="October 2026 Survey"
      rows={typeRows}
    />
    <p data-fact="OC-04" class="ro__src">Chart data: <Fact id="OC-04" field="label" /></p>
  </ReportSection>

  <ReportSection id="speed" title="Speed to Earnings">
    <p data-fact="OC-05"><Fact id="OC-05" /></p>
    <ColumnChart
      title="Cumulative Share of Surveyed Completers Who First Earned During or After Training, by When They Started Earning"
      items={speedItems}
      valueHeader="Cumulative Share"
    />
  </ReportSection>

  <ReportSection id="income" title="Income: Three Separate Measures">
    <p>Income is reported three ways.</p>
    <div class="ro__measure" data-fact="OC-03">
      <h3 class="t-heading-l">Median Monthly Income</h3>
      <p><Fact id="OC-03" /></p>
    </div>
    <div class="ro__measure" data-fact="OC-03b">
      <h3 class="t-heading-l">Direction of Income Change</h3>
      <BarChart title="Share of Completers by Direction of Income Change" items={incomeItems} />
      <p class="ro__src"><Fact id="OC-03b" /></p>
    </div>
    <div class="ro__measure" data-fact="OC-03c">
      <h3 class="t-heading-l">Median Individual Change</h3>
      <div class="ro__stats ro__stats--one"><FactStat id="OC-03c" /></div>
    </div>
  </ReportSection>

  <ReportSection id="careers" title="Career Outcomes" eyebrow="Chapter 3 of 4: Careers and Income Sources">
    <p data-fact="OC-08"><Fact id="OC-08" /></p>
    <BarChart title="Career and Education Outcomes Reported" items={career} max={100} />
  </ReportSection>

  <ReportSection id="income-source" title="Main Income Source">
    <p data-fact="OC-07"><Fact id="OC-07" /></p>
    <BarChart title="Share of Surveyed Completers by Main Income Source" items={source} max={100} />
  </ReportSection>

  <ReportSection id="experience" title="Learner Experience" eyebrow="Chapter 4 of 4: Experience and Method">
    <p data-fact="OC-06"><Fact id="OC-06" /></p>
    <ColumnChart
      title="Recommendation Score, 0 to 10, Among Surveyed Completers"
      items={recItems}
      emphasisNote={`Scores of 7 or higher: ${sevenUp}%`}
    />
  </ReportSection>

  <ReportSection id="no-prior-income" title="Completers with No Prior Income">
    <p data-fact="OC-02"><Fact id="OC-02" /></p>
    <BarChart title="Completers (2014–2023) with No Income Before Training" items={priorItems} max={100} />
  </ReportSection>

  <ReportSection id="methodology" title="Methodology and Limitations" anchorOnHeading>
    <ul class="ro__list">
      <li><strong>Survey.</strong> CodersTrust Impact Survey, October 2026: an online alumni survey (LimeSurvey survey 112268), fielded in October 2026.</li>
      <li><strong>Who the respondents are.</strong> {val('OC-09')} of respondents hold a bachelor’s degree or higher, so results describe a mostly graduate group.</li>
      <li><strong>What it does not show.</strong> Respondents are not a random sample and may over-represent successful learners, so the survey does not show that training caused any change.</li>
    </ul>
  </ReportSection>

  <ReportSection id="download" title="Download the Data">
    <p>The published aggregates are available as a CSV, with one row per published percentage or median.</p>
    <p><a class="ro__dl" href={csvHref} download>
      <Icon name="download" size={18} />Download outcomes-2026-aggregates.csv
    </a></p>
  </ReportSection>

  <CTABand id="cta" heading="Discuss the Evidence for Your Program" text="A discovery session sets priority groups, tracks and the pilot scorecard." cta={d} secondary={{ label: 'Read the Randomized Trial Results', href: '/impact/independent-evaluation/' }} more={[{ label: 'Find the Partnership Route for Your Organization', href: '/partner-with-us/' }]} micro={MICRO_COMMITMENT} />

</LongformLayout>

<style>
  .ro__stats {
    display: grid;
    gap: var(--space-lg) var(--space-gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
  }
  .ro__type {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    max-width: none;
    color: var(--on-surface-variant);
    font-size: var(--fs-body-sm);
  }
  .ro__group {
    margin: var(--space-lg) 0 var(--space-sm);
    color: var(--secondary);
  }
  .ro__stats--one {
    grid-template-columns: minmax(0, 260px);
  }
  .ro__list {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }
  .ro__list li::marker {
    color: var(--primary);
  }
  .ro__measure {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
    background: var(--surface);
  }
  .ro__measure > :global(*) {
    margin: 0;
  }
  .ro__base,
  .ro__src {
    font-size: var(--fs-body-xs);
    color: var(--outline);
  }
  .ro__dl {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--primary);
    border-radius: var(--radius-default);
    color: var(--primary);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
  .ro__dl:hover {
    background: var(--primary);
    color: var(--on-primary);
  }
  :global(.ro__sources) {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--outline-variant);
  }
</style>
