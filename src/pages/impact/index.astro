---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Badge from '../../components/system/Badge.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import FeatureCard from '../../components/ui/FeatureCard.astro';
import GlanceBand from '../../components/sections/GlanceBand.astro';
import ProofBand from '../../components/sections/ProofBand.astro';
import CaseStudyCarousel from '../../components/sections/CaseStudyCarousel.astro';
import Fact from '../../components/facts/Fact.astro';
import CopyText from '../../components/pages/impact/CopyText.astro';
import Callout from '../../components/pages/impact/Callout.astro';
import EvidenceLadder from '../../components/pages/impact/EvidenceLadder.astro';
import LearnerVoice from '../../components/pages/impact/LearnerVoice.astro';
import { articleNode, desc, title, discoveryCta } from '../../components/pages/impact/page-utils';
import { CASE_STUDIES } from '../../components/pages/impact/case-studies';
import PageNav from '../../components/pages/about/PageNav.astro';
import { IMPACT_ANSWER, MICRO_COMMITMENT } from '../../data/copy';

const path = '/impact/';
const description = desc('A randomized trial of a predecessor program: women offered a place were 10.3 percentage points more likely to be employed.');
const jsonLd = [articleNode({ path, headline: 'Impact and Evidence', description, datePublished: '2026-10-08', dateModified: '2026-10-10', author: 'CodersTrust' })];
const sdgs = [
  { n: 4, label: 'Quality Education', core: true },
  { n: 5, label: 'Gender Equality', core: true },
  { n: 8, label: 'Decent Work and Economic Growth', core: true },
  { n: 1, label: 'No Poverty', core: false },
  { n: 2, label: 'Zero Hunger', core: false },
  { n: 9, label: 'Industry and Innovation', core: false },
  { n: 10, label: 'Reduced Inequalities', core: false },
];
// Go Deeper, grouped by what kind of record each page is (WP20d).
const explore = [
  { group: 'Evidence', items: [
    { icon: 'bar-chart-3', title: 'Outcomes 2026', text: 'The Impact Survey 2026: employment, income and speed to earnings, each with its base.', href: '/impact/outcomes-2026/' },
    { icon: 'flask-conical', title: 'Independent Evaluation', text: 'The randomized trial by BIGD, with its design, limits and context.', href: '/impact/independent-evaluation/' },
  ] },
  { group: 'Program Evidence', items: [
    { icon: 'file-text', title: 'Case Studies', text: 'Four programs, results first, with what each result does and does not show.', href: '/impact/case-studies/' },
    { icon: 'globe', title: 'Global Reach', text: 'Every location where CodersTrust programs have run.', href: '/impact/global-reach/' },
  ] },
  { group: 'Human Stories and Field Record', items: [
    { icon: 'message-square-quote', title: 'Success Stories', text: 'Individual learner stories, not typical or promised outcomes.', href: '/impact/stories/' },
    { icon: 'image', title: 'In the Field', text: 'Photographs from programs, partner meetings and events, grouped by program collection.', href: '/impact/in-the-field/' },
  ] },
];
const onThisPage = [
  { label: 'In Short', href: '#summary' },
  { label: 'Evidence Ladder', href: '#evidence-ladder' },
  { label: 'At a Glance', href: '#glance' },
  { label: 'Independent Evidence', href: '#proof' },
  { label: 'Four Programs', href: '#cases' },
  { label: 'Go Deeper', href: '#explore' },
];
const d = discoveryCta();
---

<BaseLayout title={title('Impact and Evidence')} description={description} path={path} breadcrumbs={[{ label: 'Impact' }]} jsonLd={jsonLd}>
  <Hero variant="inner" eyebrow="Impact" title="Impact and Evidence" lead="What CodersTrust results show, what kind of evidence each one is, and what it does not show." artSeed="impact-hub" />

  <Section id="summary" pad="sm" aria-label="Summary">
    <div class="ih__bluf">
      <Callout tone="bluf" label="In Short">
        <CopyText block={IMPACT_ANSWER} />
      </Callout>
    </div>
  </Section>

  <PageNav links={onThisPage} />

  <Section id="evidence-ladder" pad="sm" aria-labelledby="ladder-h">
    <SectionHeader id="ladder-h" eyebrow="How to Read the Evidence" title="The Evidence Ladder: Four Kinds of Evidence" lead="Strongest for cause first. Each rung says what it shows and what it does not show." />
    <EvidenceLadder variant="matrix" />
  </Section>

  <GlanceBand
    id="glance"
    tone="ice"
    title="At a Glance"
    eyebrow="Headline Results"
    lead="The strongest results, grouped by what they show, each with its detail page. Trial figures are for a predecessor program; survey figures are among surveyed completers."
    groups={[
      { title: 'Reach', cols: 2, items: [
        { id: 'SC-16', href: '/impact/global-reach/' },
        { id: 'GV-12', href: '/partner-with-us/governments/', also: ['SC-06', 'GV-10'] },
      ] },
      { title: 'Speed to Earning', cols: 2, items: [
        { id: 'OC-05', href: '/impact/outcomes-2026/' },
        { id: 'PR-03', href: '/impact/case-studies/undp-yes-korail/' },
      ] },
      { title: 'Earnings and Work', cols: 3, items: [
        { id: 'OC-01', href: '/impact/outcomes-2026/' },
        { id: 'OC-03', href: '/impact/outcomes-2026/' },
        { id: 'OC-04', href: '/impact/outcomes-2026/', also: ['OC-07'] },
      ] },
      { title: 'Trial and Program Results', cols: 3, items: [
        { id: 'RC-13', href: '/impact/independent-evaluation/' },
        { id: 'RC-06a', href: '/impact/independent-evaluation/' },
        { id: 'PR-06', href: '/impact/case-studies/', also: ['PR-01', 'PR-02'] },
      ] },
    ]}
  />

  <GlanceBand
    id="heading"
    variant="strip"
    tone="white"
    cols={2}
    title="Where We Are Heading"
    items={[
      { id: 'IN-01', href: '/programs/youthwide/' },
      { id: 'IN-05', href: '/investors/' },
    ]}
  />

  <!-- No headlineFact here: the randomized-trial sentence is the "In Short" callout above, so this band is headed by what it shows (trial and survey figures). -->
  <ProofBand id="proof" eyebrow="Trial and Survey Evidence" title="Independent Evidence and Survey Results" statIds={['RC-01', 'RC-02', 'OC-01', 'OC-03']} links={[{ label: 'Outcomes 2026', href: '/impact/outcomes-2026/' }, { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' }, { label: 'How to Read This Evidence', href: '/impact/#evidence-ladder' }]} />

  <LearnerVoice story="adrian-afraham" excerpt="Following my completion of the course, I successfully secured my very first freelance job, which was followed by an enticing job offer." program="Graphic Designing course, CodersTrust Bangladesh" tone="white" />

  <CaseStudyCarousel
    id="cases"
    title="Four Programs, in Depth"
    items={CASE_STUDIES.map((c) => ({ title: c.name, program: c.program, factId: c.factId, href: c.path }))}
  />

  <Section id="explore" aria-labelledby="explore-h">
    <SectionHeader id="explore-h" eyebrow="More Impact Pages" title="Go Deeper" />
    {
      explore.map((g) => (
        <div class="ih__group">
          <p class="eyebrow ih__group-title">{g.group}</p>
          <div class="grid-cards grid-cards--2">
            {g.items.map((e) => <FeatureCard icon={e.icon} title={e.title} text={e.text} href={e.href} />)}
          </div>
        </div>
      ))
    }
  </Section>

  <Section tone="ice" aria-labelledby="sdg-h" pad="sm">
    <h2 class="t-heading-2xl" id="sdg-h">Alignment with the Sustainable Development Goals</h2>
    <p class="ih__sdgtext" data-fact="ID-09"><Fact id="ID-09" /></p>
    <ul class="ih__sdgs" role="list">
      {sdgs.map((s) => <li><Badge tone={s.core ? 'brand' : 'eyebrow'}>SDG {s.n} · {s.label}{s.core && ' (Core)'}</Badge></li>)}
    </ul>
  </Section>

  <CTABand id="cta" heading="Discuss the Evidence for Your Program." text="A discovery session sets priority groups, tracks and the pilot scorecard." cta={d} secondary={{ label: 'See the Impact Survey 2026', href: '/impact/outcomes-2026/' }} micro={MICRO_COMMITMENT} />
</BaseLayout>

<style>
  .ih__bluf {
    max-width: var(--measure);
  }
  .ih__group + .ih__group {
    margin-top: var(--space-xl, 2.5rem);
  }
  .ih__group-title {
    margin: 0 0 var(--space-sm);
  }
  .ih__sdgtext {
    margin: var(--space-sm) 0 var(--space-md);
    max-width: var(--measure);
  }
  .ih__sdgs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
