---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Badge from '../../components/system/Badge.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Icon from '../../components/system/Icon.astro';
import Fact from '../../components/facts/Fact.astro';
import CopyText from '../../components/pages/impact/CopyText.astro';
import Callout from '../../components/pages/impact/Callout.astro';
import EvidenceLadder from '../../components/pages/impact/EvidenceLadder.astro';
import LearnerVoice from '../../components/pages/impact/LearnerVoice.astro';
import ImpactGlance from '../../components/pages/impact/ImpactGlance.astro';
import { wsdfmFigureLabel } from '../../components/pages/impact/evidence';
import { articleNode, desc, title, discoveryCta } from '../../components/pages/impact/page-utils';
import { CASE_STUDIES } from '../../components/pages/impact/case-studies';
import PageNav from '../../components/pages/about/PageNav.astro';
import { AIM_DEPENDENCY, CONTRACT_TOTAL_NOTE, DISCOVERY_SESSION_LINE, IMPACT_ANSWER, MICRO_COMMITMENT, WB_KOSOVO, WSDFM_NOT_TRIAL_NOTE, defineNewEarners } from '../../data/copy';
import { fact } from '../../data/facts';
import { linkAttrs } from '../../lib/url';

const path = '/impact/';
const description = desc('A randomized trial of a predecessor program: women offered a place were 10.3 percentage points more likely to be employed.');
const jsonLd = [articleNode({ path, headline: 'Impact You Can Verify', description, datePublished: '2026-10-08', dateModified: '2026-10-10', author: 'CodersTrust' })];
const sdgs = [
  { n: 4, label: 'Quality Education', core: true },
  { n: 5, label: 'Gender Equality', core: true },
  { n: 8, label: 'Decent Work and Economic Growth', core: true },
  { n: 1, label: 'No Poverty', core: false },
  { n: 2, label: 'Zero Hunger', core: false },
  { n: 9, label: 'Industry and Innovation', core: false },
  { n: 10, label: 'Reduced Inequalities', core: false },
];
// WP57 (cycle-29 review, Kimi K3, item K1): the closing band's heading is one constant for the band and its last jump entry; the discovery CTA is read here, above the list, because a withheld CTA draws no band and so no entry.
const d = discoveryCta();
const CLOSING_HEADING = 'Discuss the Evidence for Your Program';
// WP31: the jump labels are the headings they jump to (a short form only where the heading is long: the part before the comma), and every heading has one.
// WP42 (cycle-19 review): the goals entry is the full heading, "Seven Global Goals, Three at the Core": its short form dropped the qualifier that says which goals are the focus.
const onThisPage = [
  { label: 'In Short', href: '#summary' },
  { label: 'Results at a Glance', href: '#glance' },
  { label: 'Five Programs', href: '#cases' },
  { label: 'Four Kinds of Evidence', href: '#evidence-ladder' },
  { label: 'Where We Are Heading', href: '#heading' },
  { label: 'Seven Global Goals, Three at the Core', href: '#sdg' },
  // the closing band is the last entry, as About's list ends on its own ("Start a Conversation"): its label is its heading, its id (#cta) the anchor
  ...(d.href ? [{ label: CLOSING_HEADING, href: '#cta' }] : []),
];
// WP58 (cycle-30 reviews, Claude S7 and Kimi K5): the Kosovo tile's note says "A 2016–2017 pilot with the World Bank Group." as the Global Reach table, the "Around the World" strip and the photograph captions do (it said "A 2017 pilot"); the closing band's line is
// "A discovery session agrees your priority groups, tracks and the pilot scorecard." (it said "sets"), as on the other Impact pages' closing bands.
// WP59 (cycle-31 review, GPT-6.1 Sol G2): that line is DISCOVERY_SESSION_LINE now (src/data/copy.ts), "A discovery session explores your goals, priority groups and possible program scope.", on every closing band that printed it.
// One formulation of the WSDFM program-record result, read from PR-01 (WP24b); the tile label adds only the measure.
const wsdfmLabel = wsdfmFigureLabel();
// WP52 (cycle-27 review, Grok m5): the page title is "Impact You Can Verify | CodersTrust", the H1's words (it was "Impact and Evidence You Can Verify | CodersTrust").
// WP52 (cycle-27 review): the 58.7% tile defines "surveyed new earners" where the figure appears ("... of the 172 surveyed new earners (completers who first earned during or after training) had started earning by six months after finishing the course,
// including 23.3% who first earned during the course"), so it is not read as a share of all completers. It is OC-05's glance label with the definition inserted (defineNewEarners); the register's labels are unchanged.
const oc05Label = defineNewEarners(fact('OC-05').stat?.glance?.label ?? '');
// WP60 (cycle-32 review, Claude S3): the "Where We Are Heading" tile for the 2 million 2030 aim carries the dependency clause the Programs hub card had (AIM_DEPENDENCY, src/data/copy.ts), in its note: "YouthWIDE in Bangladesh, depending on government and donor commitments. An ambition, not a result."
// (the register's glance note, "YouthWIDE in Bangladesh. An ambition, not a result.", is unchanged; the tile overrides its note for this page, as the Her Power and Kosovo tiles do).
const aimNote = `YouthWIDE in Bangladesh, ${AIM_DEPENDENCY}. An ambition, not a result.`;
// WP60 (cycle-32 review, Claude S4; owner answer 2026-10-20, "711 of 1000 is correct. The BIGD study only studied 833."): the WSDFM tile's note says how the records relate to the trial, "..., which studied 833 women." (RC-07's count, TRIAL_WOMEN in src/data/copy.ts; the tile's data-fact names RC-07).
// WP62 (cycle-34 review, rework R3): that note is WSDFM_NOT_TRIAL_NOTE (src/data/copy.ts), the string Foundations' WSDFM glance tile shows too; the tile's text is unchanged.
---

<BaseLayout title={title('Impact You Can Verify')} description={description} path={path} breadcrumbs={[{ label: 'Impact' }]} jsonLd={jsonLd}>
  <Hero variant="inner" eyebrow="Impact" title="Impact You Can Verify" lead="Program records from Kosovo and Bangladesh, an independent trial in Dhaka and a 2026 survey of completers. Each figure names its kind of evidence." artSeed="impact-hub" />

  <Section id="summary" pad="sm" aria-label="Summary">
    <div class="ih__bluf">
      <Callout tone="bluf" label="In Short">
        <CopyText block={IMPACT_ANSWER} />
      </Callout>
    </div>
  </Section>

  <PageNav links={onThisPage} />

  <!-- WP35 (cycle-12 review: the overview was overloaded): the trial group is one tile, the employment result for women offered a place (RC-02); the income results (+41%, +54%) and the comparison with nine trials (>4×) are on the Independent Evaluation page the tile links. The survey group says once that the survey is of surveyed completers in Bangladesh (OC-09: respondents live in 58 of the country's 64 districts). The contract-scope tile reads the register's own note for GV-12 (the figure is contract scope, not a count of completers; in Her Power, the national program trained 25,125 women; WP48, cycle-23 review). -->
  <ImpactGlance
    id="glance"
    title="Results at a Glance"
    eyebrow="Headline Results"
    groups={[
      { title: 'Trial Results, Predecessor Program', cols: 4, items: [{ id: 'RC-02', href: '/impact/independent-evaluation/' }] },
      { title: 'Survey Results, Among Surveyed Completers', cols: 4, items: [
        { id: 'OC-03', href: '/impact/outcomes-2026/' },
        { id: 'OC-01', href: '/impact/outcomes-2026/' },
        { id: 'OC-05', href: '/impact/outcomes-2026/', label: oc05Label },
        { id: 'OC-04', href: '/impact/outcomes-2026/' },
      ] },
      { title: 'Reach and Contract Scope', cols: 2, items: [
        { id: 'SC-16', href: '/impact/global-reach/', status: 'Delivered' },
        {
          id: 'GV-12',
          href: '/partner-with-us/governments/',
          also: ['SC-06', 'GV-10', 'GV-01', 'GV-11', 'SC-02'], // WP84: the shared note's overlap sentence names the 150,000+ enrollments (SC-02)
          label: 'people in the contracted scopes of six government programs',
          // WP82 (owner item, 2026-10-23): the tile carries the same contract-scope note as Home, Governments and Investors (CONTRACT_TOTAL_NOTE): the total includes Her Power's national program (25,125 women trained; CodersTrust trained 2,500 directly).
          note: CONTRACT_TOTAL_NOTE.text,
        },
      ] },
      { title: 'Program Results, by Named Program', cols: 4, items: [
        { id: 'PR-02', href: '/impact/case-studies/kosovo-women-in-online-work/', label: 'Women in Online Work, Kosovo: women in work (68%)', note: `A 2016–2017 pilot with the World Bank Group. ${WB_KOSOVO.text}`, also: ['PR-06', ...WB_KOSOVO.facts] },
        { id: 'PR-01', href: '/impact/case-studies/wsdfm-women-freelancers/', label: wsdfmLabel, note: WSDFM_NOT_TRIAL_NOTE, also: ['PR-06', 'RC-07'] },
        { id: 'PR-03', href: '/impact/case-studies/undp-yes-korail/', also: ['PR-06'], note: 'A 2017 program in Dhaka’s Korail settlement.' },
        { id: 'PR-05', href: '/impact/case-studies/her-power/', label: 'Her Power: tracked women in work (47%), from the 2,400 CodersTrust trained directly', note: 'Within the national program scope; the national program’s target is a separate figure.' }, // WP83 (owner answer 2026-10-23): the national program's 25,125 is a target, so "reach is counted separately" (it implied a count) became "target is a separate figure"
      ] },
    ]}
  />

  <!-- WP30e: link cards, one per case study (program, partner and place), Kosovo first. The results are in Results at a Glance, so no figure is repeated here.
       WP63 (cycle-35 review, Kimi K5): the band is headed "Five Programs Across Kosovo, Albania and Bangladesh" (it said "Five Programs, from Kosovo to Bangladesh"), as the Case Studies hub's H1 is. -->
  <Section id="cases" tone="airy" aria-labelledby="cases-h">
    <SectionHeader id="cases-h" eyebrow="Case Studies" title="Five Programs Across Kosovo, Albania and Bangladesh" />
    <ul class="grid-cards ih__cases" role="list">
      {
        CASE_STUDIES.map((c) => (
          <li>
            <article class="card card--link" data-reveal>
              <div class="card__body">
                <p class="eyebrow">{c.place}</p>
                <h3 class="card__title"><a class="card__link" href={linkAttrs(c.path).href}>{c.name}</a></h3>
                <p class="card__text">{c.scope}.</p>
                <span class="card__more" aria-hidden="true">Read the Case Study<span class="sr-only">: {c.name}</span><Icon name="arrow-right" size={16} /></span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="ih__all"><a class="link" href={linkAttrs('/impact/case-studies/').href}>See All Case Studies<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <LearnerVoice story="adrian-afraham" excerpt="Following my completion of the course, I successfully secured my very first freelance job, which was followed by an enticing job offer." program="Graphic Designing course, CodersTrust Bangladesh" tone="white" tag />

  <Section id="evidence-ladder" tone="ice" pad="sm" aria-labelledby="ladder-h">
    <SectionHeader id="ladder-h" eyebrow="How to Read the Evidence" title="Four Kinds of Evidence, Strongest First" lead="Each rung says what it shows and what it does not show." />
    <EvidenceLadder variant="matrix" />
  </Section>

  <ImpactGlance
    id="heading"
    tone="white"
    eyebrow="Aims"
    title="Where We Are Heading"
    groups={[
      { title: '', cols: 2, items: [
        { id: 'IN-01', href: '/programs/youthwide/', status: 'Target', note: aimNote },
        { id: 'IN-05', href: '/partner-with-us/investors/', status: 'Target' },
      ] },
    ]}
  />

  <Section id="sdg" tone="ice" aria-labelledby="sdg-h" pad="sm">
    <h2 class="t-heading-2xl" id="sdg-h">Seven Global Goals, Three at the Core</h2>
    <p class="ih__sdgtext" data-fact="ID-09"><Fact id="ID-09" />.</p>
    <ul class="ih__sdgs" role="list">
      {sdgs.map((s) => <li><Badge tone={s.core ? 'brand' : 'eyebrow'}>SDG {s.n} · {s.label}{s.core && ' (Core)'}</Badge></li>)}
    </ul>
  </Section>

  <CTABand id="cta" heading={CLOSING_HEADING} text={DISCOVERY_SESSION_LINE} cta={d} secondary={{ label: 'See the Impact Survey 2026', href: '/impact/outcomes-2026/' }} micro={MICRO_COMMITMENT} />
</BaseLayout>

<style>
  .ih__bluf {
    max-width: 60rem;
  }
  .ih__cases {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ih__cases > li {
    display: flex;
  }
  .ih__cases > li > :global(.card) {
    width: 100%;
  }
  .ih__all {
    margin: var(--space-md) 0 0;
  }
  .ih__sdgtext {
    margin: var(--space-sm) 0 var(--space-md);
    max-width: var(--measure);
  }
  .ih__sdgs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
