---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Badge from '../../components/system/Badge.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Icon from '../../components/system/Icon.astro';
import Fact from '../../components/facts/Fact.astro';
import EvidenceLadder from '../../components/pages/impact/EvidenceLadder.astro';
import LearnerStory from '../../components/pages/impact/LearnerStory.astro';
import Button from '../../components/system/Button.astro';
import ImpactGlance from '../../components/pages/impact/ImpactGlance.astro';
import { photo } from '../../data/photos';
import { wsdfmFigureLabel } from '../../components/pages/impact/evidence';
import { articleNode, desc, title, discoveryCta } from '../../components/pages/impact/page-utils';
import { CASE_STUDIES } from '../../components/pages/impact/case-studies';
import PageNav from '../../components/pages/about/PageNav.astro';
import { AIM_DEPENDENCY, AIM_SCOPE, CONTRACT_TOTAL_NOTE, DISCOVERY_SESSION_ASK, IMPACT_ANSWER, MICRO_COMMITMENT, WB_KOSOVO, WSDFM_NOT_TRIAL_NOTE } from '../../data/copy';
import { fact } from '../../data/facts';
import { linkAttrs } from '../../lib/url';

const path = '/impact/';
// WP166-A (marketing review R7-21): the page's own lead, not the trial sentence Home, the Trial page and two route pages also used as their description.
const description = desc('Program records from Kosovo and Bangladesh, an independent trial in Dhaka and a 2026 survey of completers. Each figure names its kind of evidence.');
const jsonLd = [articleNode({ path, headline: 'Impact You Can Verify', description, datePublished: '2026-10-08', dateModified: '2026-11-27', author: 'CodersTrust' })]; // WP172 (owner decision 2026-11-27: the trial figures are the published study's, Arman et al. 2026): the hero lead, the +10 pp tile and the evidence ladder's trial row. Earlier: WP168-B (2026-11-24: the 58.7% tile's label and note, marketing review R4-18). Earlier: WP166-C (2026-11-21: the marketing-effectiveness review: hero lead and actions, the benchmark note, the tile order, the case cards, the story and the closing heading). Earlier: WP164 (2026-11-03: the Albania case card says 2021–2022 again). Earlier: WP162 (2026-11-03: the Albania case card says 2021 and no longer quotes the World Bank's enrollment figure). Earlier: WP157 (2026-11-02: the SDG introduction names the three core goals). Earlier: WP147 (2026-11-01): the 30,000+ tile reads as the register's label everywhere
const sdgs = [
  { n: 4, label: 'Quality Education', core: true },
  { n: 5, label: 'Gender Equality', core: true },
  { n: 8, label: 'Decent Work and Economic Growth', core: true },
  { n: 1, label: 'No Poverty', core: false },
  { n: 2, label: 'Zero Hunger', core: false },
  { n: 9, label: 'Industry, Innovation and Infrastructure', core: false },
  { n: 10, label: 'Reduced Inequalities', core: false },
];
// WP57 (cycle-29 review, Kimi K3, item K1): the closing band's heading is one constant for the band and its last jump entry; the discovery CTA is read here, above the list, because a withheld CTA draws no band and so no entry.
const d = discoveryCta();
// WP166-C (R4-13): the closing band is headed as on the other Impact pages ("Talk to Us About a First Cohort"; it said "Discuss the Evidence for Your Program").
const CLOSING_HEADING = 'Talk to Us About a First Cohort';
// WP166-C (R4-04): the +10.3 tile carries the benchmark note Development Partners shows, read from RC-06a's glance label (never retyped).
const benchmark = /(more than four times the 2\.3-point average across nine vocational-training trials)$/.exec(fact('RC-06a').stat?.glance?.label ?? '')?.[1];
if (!benchmark) throw new Error('Impact: the RC-06a glance label no longer ends "... more than four times the 2.3-point average across nine vocational-training trials"; update the +10.3 tile\'s note');
const benchmarkNote = `${benchmark[0].toUpperCase()}${benchmark.slice(1)}.`;
// WP166-C (R4-17): the hub's contract-scope note is the shared note's first sentence; the overlap sentence ("Her Power’s 25,125 is the same group …") stays on Governments and Investors.
const contractNote = CONTRACT_TOTAL_NOTE.text.split(/(?<=\.) (?=Her Power’s 25,125 is the same group)/)[0];
if (contractNote === CONTRACT_TOTAL_NOTE.text) throw new Error('Impact: CONTRACT_TOTAL_NOTE no longer has its overlap sentence; update the 30,000+ tile\'s note');
// WP166-C (R4-16): the hub's one story is ST-05, the World Bank pilot in Kosovo (it was Adrian Afraham's Bangladesh course), rendered as on the Kosovo case study.
const erlisaTail = fact('ST-05').text.split(' in Kosovo, ')[1];
if (!erlisaTail) throw new Error('ST-05 text no longer has the expected "<Name>, a … participant in Kosovo, <outcome>" shape');
const erlisaOutcome = `She ${erlisaTail.replace('; earning', ' and is earning')}.`;
const erlisaPortrait = photo('impact/kosovo-graduate-portrait');
// WP31: the jump labels are the headings they jump to (a short form only where the heading is long: the part before the comma), and every heading has one.
// WP42 (cycle-19 review): the goals entry is the full heading, "Seven Global Goals, Three at the Core": its short form dropped the qualifier that says which goals are the focus.
// WP91 (triage A11): each entry is its heading's full text, so the list matches the headings it jumps to; "In Short" (a label above this list, not a heading) is gone.
const onThisPage = [
  { label: 'Results at a Glance', href: '#glance' },
  { label: 'Five Programs Across Kosovo, Albania and Bangladesh', href: '#cases' },
  { label: 'Four Kinds of Evidence, Strongest First', href: '#evidence-ladder' },
  { label: 'Where We Are Heading', href: '#heading' },
  { label: 'Seven Global Goals, Three at the Core', href: '#sdg' },
  // the closing band is the last entry, as About's list ends on its own ("Start a Conversation"): its label is its heading, its id (#cta) the anchor
  ...(d.href ? [{ label: CLOSING_HEADING, href: '#cta' }] : []),
];
// WP58 (cycle-30 reviews, Claude S7 and Kimi K5): the Kosovo tile's note says "A 2016–2017 pilot with the World Bank Group." as the Global Reach table, the "Around the World" strip and the photograph captions do (it said "A 2017 pilot"); the closing band's line is
// "A discovery session agrees your priority groups, tracks and the pilot scorecard." (it said "sets"), as on the other Impact pages' closing bands.
// WP59 (cycle-31 review, GPT-6.1 Sol G2): that line is DISCOVERY_SESSION_LINE now (src/data/copy.ts), "A discovery session explores your goals, priority groups and possible program scope.", on every closing band that printed it.
// One formulation of the WSDFM program-record result, read from PR-01 (WP24b); the tile label adds only the measure.
const wsdfmLabel = wsdfmFigureLabel();
// WP52 (cycle-27 review, Grok m5): the page title is "Impact You Can Verify | CodersTrust", the H1's words (it was "Impact and Evidence You Can Verify | CodersTrust").
// WP52 (cycle-27 review): the 58.7% tile defines "surveyed new earners" where the figure appears, so it is not read as a share of all completers. WP168-B (marketing review R4-18, owner approval of 24 November 2026): the definition and the 23.3%
// moved from the label into the tile's note, as the neighboring tiles split label and note: OC-05's glance label "of the 172 surveyed new earners had started earning by six months after finishing the course" and its note "New earners are completers
// who first earned during or after training; 23.3% first earned during the course." (the tile reads both from the register; it no longer overrides the label).
// WP60 (cycle-32 review, Claude S3): the "Where We Are Heading" tile for the 2030 aim carries the dependency clause the Programs hub card had (AIM_DEPENDENCY, src/data/copy.ts), in its note: "YouthWIDE in Bangladesh and similar countries in South Asia and the Middle East and North Africa, depending on government and donor commitments. An ambition, not a result." (WP99: the scope is IN-01's, AIM_SCOPE)
// (the register's glance note, "YouthWIDE in Bangladesh and similar countries in South Asia and the Middle East and North Africa. An ambition, not a result.", is unchanged; the tile overrides its note for this page, as the Her Power and Kosovo tiles do).
const aimNote = `YouthWIDE ${AIM_SCOPE}, ${AIM_DEPENDENCY}. An ambition, not a result.`;
// WP60 (cycle-32 review, Claude S4; owner answer 2026-10-20, "711 of 1000 is correct. The BIGD study only studied 833."): the WSDFM tile's note says how the records relate to the trial, "..., which studied 833 women." (RC-07's count, TRIAL_WOMEN in src/data/copy.ts; the tile's data-fact names RC-07).
// WP62 (cycle-34 review, rework R3): that note is WSDFM_NOT_TRIAL_NOTE (src/data/copy.ts), the string Foundations' WSDFM glance tile shows too; the tile's text is unchanged.
---

<BaseLayout title={title('Impact You Can Verify')} description={description} path={path} breadcrumbs={[{ label: 'Impact' }]} jsonLd={jsonLd}>
  <!-- WP166-C (R4-01): the "In Short" answer (IMPACT_ANSWER, register-exact) is the hero's lead, with its fact markers, followed by the line on evidence kinds; the separate In Short band and the inventory of sources are gone.
       WP166-C (R4-14): the hero carries the page's action (the discovery session, as on Home) and the text link to the trial. -->
  <Hero variant="inner" eyebrow="Impact" title="Impact You Can Verify" lead={`${IMPACT_ANSWER.text} Each figure names its kind of evidence.`} leadFacts={IMPACT_ANSWER.facts} artSeed="impact-hub">
    <Fragment slot="actions">
      {d.href && <Button href={d.href} iconEnd="arrow-right">{d.label}</Button>}
      <a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>Read the Trial Results<Icon name="arrow-right" size={16} /></a>
    </Fragment>
  </Hero>

  <PageNav links={onThisPage} />

  <!-- WP35 (cycle-12 review: the overview was overloaded): the trial group is one tile, the employment result for women offered a place (RC-02); the income results (+41%, +54%) and the comparison with nine trials (>4×) are on the Independent Evaluation page the tile links. The survey group says once that the survey is of surveyed completers in Bangladesh (OC-09: respondents live in 58 of the country's 64 districts). The contract-scope tile reads the register's own note for GV-12 (the figure is contract scope, not a count of completers; in Her Power, the national program trained 25,125 women; WP48, cycle-23 review). -->
  <ImpactGlance
    id="glance"
    title="Results at a Glance"
    eyebrow="Headline Results"
    groups={[
      { title: 'Trial Results, CodersTrust’s WSDFM Program', cols: 4, items: [{ id: 'RC-02', href: '/impact/independent-evaluation/', note: benchmarkNote, also: ['RC-06a'] }] },
      { title: 'Survey Results, Among Surveyed Completers', cols: 4, items: [
        { id: 'OC-03', href: '/impact/outcomes-2026/' },
        { id: 'OC-01', href: '/impact/outcomes-2026/' },
        { id: 'OC-05', href: '/impact/outcomes-2026/' },
        { id: 'OC-04', href: '/impact/outcomes-2026/' },
      ] },
      // WP166-C (R4-17): the program results follow the trial and the survey, so the three kinds of outcome read in one run; reach and contract scope come after them.
      { title: 'Program Results, by Named Program', cols: 4, items: [
        { id: 'PR-02', href: '/impact/case-studies/kosovo-women-in-online-work/', label: 'Women in Online Work, Kosovo: women in work (68%)', note: `A 2016–2017 pilot with the World Bank Group. ${WB_KOSOVO.text}`, also: ['PR-06', ...WB_KOSOVO.facts] },
        { id: 'PR-01', href: '/impact/case-studies/wsdfm-women-freelancers/', label: wsdfmLabel, note: WSDFM_NOT_TRIAL_NOTE, also: ['PR-06', 'RC-07'] },
        { id: 'PR-03', href: '/impact/case-studies/undp-yes-korail/', also: ['PR-06'], note: 'A 2017 program in Dhaka’s Korail settlement.' },
        { id: 'PR-05', href: '/impact/case-studies/her-power/', label: 'Her Power: tracked women in work (47%), from the 2,400 CodersTrust trained directly', note: 'The 2,400 are among the 25,125 women the national program trained.' }, // WP83 (owner answer 2026-10-23) made this "target is a separate figure"; WP85 (owner update 2026-10-24: the program trained its 25,125 and met its target); WP88 item 1: the 2,400 are among the 25,125
      ] },
      { title: 'Reach and Contract Scope', cols: 2, items: [
        // WP92 (Perplexity cycle 41, triage A4): the Delivered tile's note is its own; the 16 countries sentence stays on Global Reach, Home and the other pages as untagged items.
        { id: 'SC-16', href: '/impact/global-reach/', status: 'Delivered', note: 'Through 150,000+ enrollments.' },
        {
          id: 'GV-12',
          href: '/partner-with-us/governments/',
          also: ['SC-06', 'GV-10', 'GV-01', 'GV-11'], // WP166-C: the overlap sentence that named the 150,000+ enrollments (SC-02, WP84) is not on this page
          label: fact('GV-12').stat!.label, // WP147: one wording for the 30,000+ tile on Impact, Governments, Investors and JobReady Platform (the register's)
          // WP82 (owner item, 2026-10-23): the tile carries the contract-scope note of Home, Governments and Investors (CONTRACT_TOTAL_NOTE); WP166-C (R4-17): its first sentence only (contractNote).
          note: contractNote,
        },
      ] },
    ]}
  />

  <!-- WP30e: link cards, one per case study (program, partner and place), Kosovo first. The results are in Results at a Glance, so no figure is repeated here.
       WP63 (cycle-35 review, Kimi K5): the band is headed "Five Programs Across Kosovo, Albania and Bangladesh" (it said "Five Programs, from Kosovo to Bangladesh"), as the Case Studies hub's H1 is. -->
  <Section id="cases" tone="airy" aria-labelledby="cases-h">
    <SectionHeader id="cases-h" eyebrow="Case Studies" title="Five Programs Across Kosovo, Albania and Bangladesh" />
    <ul class="grid-cards ih__cases" role="list">
      {
        CASE_STUDIES.map((c) => (
          <li>
            <article class="card card--link" data-reveal>
              <div class="card__body">
                <p class="eyebrow">{c.place}</p>
                <h3 class="card__title"><a class="card__link" href={linkAttrs(c.path).href}>{c.name}</a></h3>
                {/* WP166-C (R4-15): no description line; the program-record tiles above carry the results, so the cards read as a partner strip. */}
                <span class="card__more" aria-hidden="true">Read the Case Study<span class="sr-only">: {c.name}</span><Icon name="arrow-right" size={16} /></span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="ih__all"><a class="link" href={linkAttrs('/impact/case-studies/').href}>See All Case Studies<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <!-- WP166-C (R4-16): the hub's story is Erlisa Zherka's (ST-05, the World Bank pilot in Kosovo), as the Kosovo case study renders it; it was Adrian Afraham's (Bangladesh). -->
  <Section id="learner-voice" tone="white" pad="sm" aria-label="Individual Learner Story">
    <LearnerStory factId="ST-05" name="Erlisa Zherka" assetId="story-erlisa-zherka" image={erlisaPortrait.src} imageAlt={erlisaPortrait.alt} imageAssetId={erlisaPortrait.assetId} program="Women in Online Work, Kosovo, 2016–2017" outcome={erlisaOutcome} tag />
    <p class="ih__all"><a class="link" href={linkAttrs('/impact/stories/').href}>More Learner Stories<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <Section id="evidence-ladder" tone="ice" pad="sm" aria-labelledby="ladder-h">
    <SectionHeader id="ladder-h" eyebrow="How to Read the Evidence" title="Four Kinds of Evidence, Strongest First" lead="Each rung says what it shows and what it does not show." />
    <EvidenceLadder variant="matrix" />
  </Section>

  <ImpactGlance
    id="heading"
    tone="white"
    eyebrow="Aims"
    title="Where We Are Heading"
    groups={[
      { title: '', cols: 2, items: [
        { id: 'IN-01', href: '/programs/youthwide/', status: 'Target', note: aimNote },
        { id: 'IN-05', href: '/partner-with-us/investors/', status: 'Target' },
      ] },
    ]}
  />

  <Section id="sdg" tone="ice" aria-labelledby="sdg-h" pad="sm">
    <h2 class="t-heading-2xl" id="sdg-h">Seven Global Goals, Three at the Core</h2>
    <p class="ih__sdgtext" data-fact="ID-09"><Fact id="ID-09" />.</p>
    <ul class="ih__sdgs" role="list">
      {sdgs.map((s) => <li><Badge tone={s.core ? 'brand' : 'eyebrow'}>SDG {s.n} · {s.label}{s.core && ' (Core)'}</Badge></li>)}
    </ul>
  </Section>

  <CTABand id="cta" heading={CLOSING_HEADING} text={DISCOVERY_SESSION_ASK} cta={d} secondary={{ label: 'See the Impact Survey 2026', href: '/impact/outcomes-2026/' }} micro={MICRO_COMMITMENT} />
</BaseLayout>

<style>
  .ih__cases {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ih__cases > li {
    display: flex;
  }
  .ih__cases > li > :global(.card) {
    width: 100%;
  }
  .ih__all {
    margin: var(--space-md) 0 0;
  }
  .ih__sdgtext {
    margin: var(--space-sm) 0 var(--space-md);
    max-width: var(--measure);
  }
  .ih__sdgs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
