---
import LongformLayout from '../../../layouts/LongformLayout.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import BarChart from '../../../components/ui/BarChart.astro';
import Icon from '../../../components/system/Icon.astro';
import EvidenceTag from '../../../components/system/EvidenceTag.astro';
import Fact from '../../../components/facts/Fact.astro';
import PlainLine from '../../../components/facts/PlainLine.astro';
import ReportSection from '../../../components/pages/impact/ReportSection.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import NextStep from '../../../components/pages/impact/NextStep.astro';
import { articleNode, desc, title, discoveryCta } from '../../../components/pages/impact/page-utils';
import { fact, sources } from '../../../data/facts';
import { BIGD_FULL, DISCOVERY_SESSION_ASK, MICRO_COMMITMENT, PROGRAM_SCOPE_TRACKING } from '../../../data/copy';
import { hostOf, linkAttrs } from '../../../lib/url';

const path = '/impact/independent-evaluation/';
// H1 (WP30e): the result, in words; the <title> stays "Randomized Trial Results". The scope (CodersTrust’s WSDFM program, women in Bangladesh; WP172: it said "women in Dhaka") is the first sentence under it.
const h1 = 'Randomized Trial: Women Offered a Place Were More Likely to Work';
// WP166-A (marketing review R7-21): BRAC, the name funders know, where "A BIGD trial" put two acronyms in six words. The reviewer's sentence dropped the program; the program stays named (the trial is never
// generalized beyond CodersTrust’s WSDFM program), so the evaluator reads "BRAC University (BIGD)" to stay within 155 characters (151).
// WP172 (owner decision 2026-11-27): the published study's figure, 10 percentage points (the 2022 report said 10.3).
const description = desc('A BRAC University (BIGD) randomized trial of CodersTrust’s WSDFM program: women offered a place were 10 percentage points more likely to be employed.');

// WP166-C (R4-10, owner approval of 21 November 2026, item 5): the page's freelancing exhibit is the randomized comparison (RC-09, women offered a place against the control group), as on the WSDFM case study;
// the classes-attended chart (RC-08, not randomized) is cut. The chart values must match the register text.
// WP172 (owner decision 2026-11-27): the figures are the published study's (EDCC26). RC-09 (employment status at follow-up, from the 2022 report) is not in the study and is withdrawn, so the exhibit is the study's
// employment effect by classes attended (RC-17, Table A6: women who attended, against the control group). The chart values must match the register text.
const classes = [
  { label: 'Attended at Least One Class', value: 24, words: 'at least one class' },
  { label: 'Attended at Least 10 Classes', value: 28, words: 'at least 10 classes' },
  { label: 'Attended All Classes', value: 71, words: 'all classes' },
];
const rc17 = fact('RC-17').text;
for (const c of classes) if (!rc17.includes(`${c.value}% higher`) || !rc17.includes(c.words)) throw new Error(`RC-17 chart value ${c.value}% (${c.words}) is not in the register text`);

// WP30e: one decision question with a short answer (the page itself answers "Is there independent evidence?"). The answer is the shared Q3 shortened to its two claims.
// WP107 (Sonnet XHigh run 3, Polish 5): one question does not make a FAQ, so the closing band is headed "How We Track Outcomes" and the answer sits directly under the H2 (no accordion, no FAQPage JSON-LD: the schema.org FAQPage needs a visible question and this page no longer prints one).
const trackingAnswer = 'For every cohort, we plan a baseline at enrollment, follow-up surveys at 3, 6 and 12 months and monthly reports. Where available, offer letters, payslips, platform logs or bank receipts document work and earnings.';
// WP73: the follow-up study is under way (BIGD's study page, BIGDSTUDY), so RC-10's sentence links that page.
const bigdStudy = sources.BIGDSTUDY;
// WP99 (owner answer 2026-10-28, Q2 option C): the peer-reviewed article that publishes the trial (RC-15, source EDCC26) has its own band below ("Published in a Peer-Reviewed Journal"), apart from the report figures above it, which are not labeled peer-reviewed.
// The band also shows the article's benefit/cost ratio (RC-16: an explicit owner exception to the no-ROI rule, for this page only). The five authors are named in the structured data as Crossref lists them (checked 2026-10-28); the visible citation uses surnames, as the register does.
const journal = sources.EDCC26;
// WP168-B (marketing review R4-09, owner approval of 24 November 2026): the band's heading states the figure the band attributes to the article (RC-16: on this page only, attributed to the article, beside the citation); it was "Published in a Peer-Reviewed Journal".
// The body is unchanged. The On This Page entry is the heading, word for word.
const JOURNAL_HEADING = 'Peer-Reviewed: The Article Estimates a Benefit/Cost Ratio of 3.01';
if (!fact('RC-16').text.includes('estimates a benefit/cost ratio of 3.01')) throw new Error('Trial page: RC-16 no longer says "estimates a benefit/cost ratio of 3.01"; update the journal band heading');
const journalAuthors = ['Mohammad Raied Arman', 'Anindita Bhattacharjee', 'Narayan Das', 'Mohima Gomes', 'Sakib Mahmood'];
const jsonLd = [
  articleNode({
    path,
    headline: h1,
    description,
    datePublished: '2026-10-08',
    dateModified: '2026-11-27', // WP172 (owner decision 2026-11-27: the trial figures are the published study's, EDCC26; the classes-attended exhibit replaces the employment-status chart; the report link and citation are gone). Earlier: WP168-B (2026-11-24: the journal band's heading states the article's benefit/cost ratio, marketing review R4-09). Earlier: WP166-C (2026-11-21: the lead, the section order, the freelancing exhibit, the household line, the funders paragraph and the hero link). Earlier: WP157 (2026-11-02: the nine-trials sentence no longer repeats its heading). Earlier: WP141 (2026-11-01: the program-scope qualifier is stated once per page). Earlier: WP134: WP133 changed the page text (owner rule 2026-10-31)
    author: 'CodersTrust',
    citation: [
      {
        '@type': 'ScholarlyArticle',
        name: 'Tackling Women’s Unemployment: Evidence from an Online Jobs Experiment in Bangladesh',
        author: journalAuthors.map((name) => ({ '@type': 'Person', name })),
        datePublished: '2026-10',
        isPartOf: { '@type': 'Periodical', name: 'Economic Development and Cultural Change' },
        pagination: '367–399',
        url: journal.url,
      },
    ],
  }),
];
// WP60 (cycle-32 review, Grok R6): the classes band is headed "Freelancing Share by Classes Attended" and says "In this study, freelancing was higher among women who attended more classes." (it said "More Classes, More Freelancing" and "... were more likely to be
// freelancing at follow-up", which reads as a dose effect; the trial randomized the offer of a place, not how many classes a woman attended). The anchor (#classes) is unchanged. The chart under it is titled "Share of Women Freelancing" (it was
// "Freelancing Share by Classes Attended", which the new heading would have printed twice, two lines apart); its data (RC-08) and its row labels are unchanged.
// The discovery CTA is read above the list: a withheld call to action draws no closing band and so no entry. The band's heading is one constant for the entry and the band.
const d = discoveryCta();
const CLOSING_HEADING = 'Talk to Us About a First Cohort';
// WP166-C (R4-02): the three facts a funder acts on (four times the benchmark, the journal, then the income and household effects) come right after the result; the text of each section is unchanged.
// WP172: the exhibit is the study's employment effect by classes attended (RC-17); it was the report's employment status at follow-up (RC-09), headed "Freelancing: Women Offered a Place vs. the Control Group".
const CLASSES_HEADING = 'Employment Effect by Classes Attended';
const toc = [
  { id: 'summary', label: 'The Result' },
  { id: 'context', label: 'Over Four Times the Average of Nine Training Trials' },
  { id: 'journal', label: JOURNAL_HEADING },
  { id: 'results', label: 'Income, Freelancing and Household Effects' },
  { id: 'classes', label: CLASSES_HEADING },
  { id: 'funders', label: 'What It Means for Funders' },
  { id: 'outcomes', label: 'How We Track Outcomes' },
  // WP135 (Opus High run 10, Polish 2): the list ends with the closing band's heading, as Impact's and About's do; a withheld call to action draws no band and so no entry.
  ...(d.href ? [{ id: 'cta', label: CLOSING_HEADING }] : []),
];
// How to read this trial (closed disclosure): what was evaluated, who took part and the design. The wording is the former Evidence-and-Fit Brief and RC-07.
const howToRead = `<ul>
<li data-fact="RC-07 PD-01"><strong>What was evaluated.</strong> CodersTrust’s 200-hour WSDFM program; today’s tracks are 100 hours.</li>
<li data-fact="RC-01"><strong>Who took part.</strong> Women in Bangladesh with a Secondary School Certificate (SSC) or above, most of them aged 18–35.</li>
<li data-fact="RC-07"><strong>Design.</strong> ${fact('RC-07').text.replace(/^Trial design: /, '')}.</li>
</ul>`;
// RC-13's own summary line (employment and freelancing for women who attended); its income figure is already in the headline, so only this detail is repeated here.
const attendedDetail = fact('RC-13').stat?.glance?.note;
if (!attendedDetail) throw new Error('RC-13 no longer has a glance note');
// WP172: the attenders' income in dollars is read from RC-13's tile label ("... about $34 a month)"), never typed (it was "Income about +$36 a month.", the 2022 report's figure).
const attendedDollars = /about \$(\d+) a month\)$/.exec(fact('RC-13').stat?.label ?? '')?.[1];
if (!attendedDollars) throw new Error('Independent evaluation: RC-13’s tile label no longer ends "about $N a month)"');
const attendedIncome = `Income about +$${attendedDollars} a month.`;
// WP22: the direct answer under the H1 (40 to 60 words): what the trial found, for which program, and what it does not measure. The callout below keeps the
// plain-language line (PlainLine) and the income results, so the 10.3-point result is stated formally once here and in plain words once there.
// WP50 (cycle-25 review): this lead is where the page first names the evaluator, so it spells it out (BIGD_FULL: "the BRAC Institute of Governance and Development (BIGD)"); the later "BIGD" on the page ("Read the BIGD Report (2022)") is the abbreviation it introduces.
// WP61 (cycle-33 review, GPT-6.1 Sol G5): the first sentence carried the evaluator, the program, its length, its population and the result ("A randomized trial by ... found that women offered a place in CodersTrust’s WSDFM program, a 200-hour program for women in
// Dhaka, were 10.3 percentage points more likely to be employed than the control group."). The result now comes first, with the evaluator; the second sentence says which program the trial evaluated and that it is not today’s 100-hour tracks. 46 words, inside the 40 to 60 above (45 since WP99, when the second sentence named CodersTrust’s WSDFM program).
// WP166-C (R4-03, owner approval of 21 November 2026, item 5): the lead says why the result matters (the nine-trial benchmark, in RC-06a's own words) in place of the scope caveat, which stays on the page in
// "How to Read This Trial" ("CodersTrust’s 200-hour WSDFM program; today’s tracks are 100 hours.", RC-07 and PD-01). 47 words. The reviewer's closing sentence, "The trial is published in a peer-reviewed journal.", is left out:
// the owner's WP99 answer (2026-10-28, Q2 option C) keeps the report figures apart from the peer-reviewed article, so no paragraph that names the journal carries a report figure (tests/wp99.spec.ts).
const BENCHMARK_CLAUSE = 'over four times the 2.3-point average across nine randomized trials of vocational training';
// WP172 (owner decision 2026-11-27): 10 percentage points, the published study's figure (it was the 2022 report's 10.3); the word count is unchanged.
const directAnswer = `In a randomized trial of CodersTrust’s WSDFM program by ${BIGD_FULL}, women offered a place were 10 percentage points more likely to be employed than the control group: ${BENCHMARK_CLAUSE}.`;
const answerWords = directAnswer.split(/\s+/).length;
if (answerWords < 40 || answerWords > 60) throw new Error(`Independent evaluation direct answer is ${answerWords} words (40 to 60)`);
if (!fact('RC-01').text.includes(' 10 percentage points') || !(fact('RC-06a').headline ?? '').includes(BENCHMARK_CLAUSE)) throw new Error('Independent evaluation direct answer: RC-01 or RC-06a changed');
if (!fact('RC-07').text.includes('200 hours') || fact('PD-01').stat?.value !== '100') throw new Error('Independent evaluation: the scope caveat under How to Read This Trial no longer matches RC-07 or PD-01');
const incomeLine = (fact('RC-01').headline ?? '').split(/(?<=\.)\s+(?=[A-Z])/).slice(1).join(' ');
if (!/^Their monthly income/.test(incomeLine)) throw new Error('Independent evaluation: RC-01 headline no longer has the income sentences');
---

<LongformLayout
  title={title('Randomized Trial: +10 Percentage Points')}
  lead={directAnswer}
  description={description}
  path={path}
  heading={h1}
  eyebrow="Independent Evaluation"
  updated="2026-11-27"
  toc={toc}
  breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'Independent Evaluation' }]}
  jsonLd={jsonLd}
>
  {/* WP166-C (R4-14): one text link from the hero to the closing band; a withheld call to action draws no band and so no link. */}
  {d.href && <Fragment slot="actions"><a class="link" href="#cta">{CLOSING_HEADING}<Icon name="arrow-right" size={16} /></a></Fragment>}
  <ReportSection id="summary" title="The Result">
    <p class="ie__type"><EvidenceTag type="Randomized Trial" /> <span>CodersTrust’s WSDFM program, women in Bangladesh</span></p>
    <Callout tone="bluf">
      <PlainLine />
      <p data-fact="RC-01">{incomeLine}</p>
    </Callout>
    {/* WP172 (owner decision 2026-11-27): the link is to the published study (EDCC26), which replaces the 2022 report (it was "Read the BIGD Report (2022)"). */}
    <p><a class="link" href={journal.url} rel={linkAttrs(journal.url!).rel}>Read the Published Study<Icon name="arrow-right" size={16} /><span class="sr-only"> (opens {hostOf(journal.url!)})</span></a></p>
    <Accordion items={[{ q: 'How to Read This Trial', a: howToRead }]} name="ie-method" />
  </ReportSection>

  <ReportSection id="context" title="Over Four Times the Average of Nine Training Trials">
    <p data-fact="RC-06a"><Fact id="RC-06a" field="headline" /></p>
  </ReportSection>

  <ReportSection id="journal" title={JOURNAL_HEADING}>
    <p data-fact="RC-15">The trial is also published in a peer-reviewed journal: Arman, Bhattacharjee, Das, Gomes and Mahmood (2026), “Tackling Women’s Unemployment: Evidence from an Online Jobs Experiment in Bangladesh,” <em>Economic Development and Cultural Change</em> 75(1): 367–399 (October 2026).{' '}
      <a href={journal.url} rel={linkAttrs(journal.url!).rel}>{journal.url}<span class="sr-only"> (opens {hostOf(journal.url!)})</span></a>
    </p>
    <p data-fact="RC-16"><Fact id="RC-16" /></p>
    <!-- WP166-C (R4-02): the report's income, household and freelancing results now follow this band, so the line no longer says "above" ("The results above come from BIGD’s report."). -->
    <!-- WP172 (owner decision 2026-11-27): the results on the page are the article's (it said "The other results on this page come from BIGD’s report. The article is a separate publication."). -->
    <p>The trial results on this page come from this article.</p>
  </ReportSection>

  <ReportSection id="results" title="Income, Freelancing and Household Effects">
    <h3 class="t-heading-l">Women Offered a Place</h3>
    <ul class="ie__list">
      <li data-fact="RC-04"><Fact id="RC-04" /></li>
    </ul>
    <h3 class="t-heading-l">Women Who Attended</h3>
    <ul class="ie__list">
      <!-- WP110 (Opus Low run 2, kit 76, Minor 3): the attenders' income is stated here once, as the plain figure the register's RC-04 no longer carries; RC-13 is its data-fact. -->
      <li data-fact="RC-13">{attendedIncome}</li>
      <li data-fact="RC-13">{attendedDetail}</li>
      <!-- WP166-C (R4-32, owner approval of 21 November 2026, item 5): the household line is RC-14, the register's verified household figure (it was RC-05's plain-words reading with no number, WP105). -->
      <li data-fact="RC-14"><Fact id="RC-14" /></li>
    </ul>
    <p data-fact="RC-04a">The published study gives these amounts in taka: <Fact id="RC-04a" />.</p>
  </ReportSection>

  <ReportSection id="classes" title={CLASSES_HEADING}>
    <p data-fact="RC-17">For women who attended, the estimated employment effect was larger the more classes they attended; how many classes a woman attended was not randomly assigned.</p>
    <div data-fact="RC-17">
      <BarChart
        title="Employment Against the Control Group, Women Who Attended"
        items={classes.map((c) => ({ label: c.label, value: c.value, display: `+${c.value}%` }))}
        note="Published study (Economic Development and Cultural Change, 2026); treatment-on-the-treated estimates by classes attended. Follow-up November–December 2021."
      />
    </div>
  </ReportSection>

  <ReportSection id="funders" title="What It Means for Funders">
    <!-- WP166-C (R4-08): the offer first (the scorecard agreed before the first cohort, independent evaluation welcome), then the limit and the methods note; the same facts and the same settled scorecard wording (WP138). -->
    <p>
      <strong>A new pilot starts from a scorecard agreed before the first cohort, with independent evaluation welcome.</strong> One trial in one population does not forecast a new country or a new track. The offered-place results are the closer guide to what a funded program can deliver, because they include women who were offered a place but did not attend.
    </p>
    <p data-fact="RC-10"><Fact id="RC-10" />.{' '}
      <a class="link" href={bigdStudy.url} rel={linkAttrs(bigdStudy.url!).rel}>See BIGD’s Follow-Up Study<Icon name="arrow-right" size={16} /><span class="sr-only"> (opens {hostOf(bigdStudy.url!)})</span></a>{' '}
      <a class="link" href={linkAttrs('/partner-with-us/').href}>See How Partnerships Work<Icon name="arrow-right" size={16} /></a>
    </p>
  </ReportSection>

  <ReportSection id="outcomes" title="How We Track Outcomes">
    <p data-fact="PD-09 PD-08 RC-01">{trackingAnswer} {PROGRAM_SCOPE_TRACKING}</p>
  </ReportSection>

  <NextStep
    id="cta"
    heading={CLOSING_HEADING}
    text={DISCOVERY_SESSION_ASK}
    cta={{ label: d.label, href: d.href }}
    secondary={{ label: 'See the Impact Survey 2026', href: '/impact/outcomes-2026/' }}
    more={[{ label: 'Find the Partnership Route for Your Organization', href: '/partner-with-us/' }]}
    micro={MICRO_COMMITMENT}
  />

</LongformLayout>

<style>
  .ie__type {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin: 0 0 var(--space-sm);
    color: var(--on-surface-variant);
    font-size: var(--fs-body-sm);
  }
  .ie__list {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }
  .ie__list li::marker {
    color: var(--primary);
  }
</style>
