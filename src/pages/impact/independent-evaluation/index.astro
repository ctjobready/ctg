---
import LongformLayout from '../../../layouts/LongformLayout.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import BarChart from '../../../components/ui/BarChart.astro';
import Icon from '../../../components/system/Icon.astro';
import Fact from '../../../components/facts/Fact.astro';
import FactStat from '../../../components/facts/FactStat.astro';
import PlainLine from '../../../components/facts/PlainLine.astro';
import ReportSection from '../../../components/pages/impact/ReportSection.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import FitBrief from '../../../components/pages/impact/FitBrief.astro';
import NextStep from '../../../components/pages/impact/NextStep.astro';
import { articleNode, desc, title, discoveryCta } from '../../../components/pages/impact/page-utils';
import { fact, sources } from '../../../data/facts';
import { MICRO_COMMITMENT } from '../../../data/copy';
import { faqItems, faqJsonLd } from '../../../lib/faq';
import { hostOf, linkAttrs } from '../../../lib/url';

const path = '/impact/independent-evaluation/';
// H1 (review round 15, F3): a short page name (the <title> stays "Randomized Trial Results"); the effect headline, RC-01, is the first sentence of the BLUF under it.
const h1 = 'A Randomized Trial of CodersTrust’s Training for Women in Dhaka';
const description = desc('A BIGD trial of a predecessor program: women offered a place were 10.3 percentage points more likely to be employed.');
const faqIds = ['Q4', 'Q3'];

// RC-08 chart values must match the register text.
const classes = [
  { label: 'Control Group', value: 12 },
  { label: 'Attended 1–10 Classes', value: 16 },
  { label: 'Attended 11–24 Classes', value: 21 },
  { label: 'Attended 25 or More Classes', value: 42 },
];
const rc08 = fact('RC-08').text;
for (const c of classes) if (!rc08.includes(`${c.value}%`)) throw new Error(`RC-08 chart value ${c.value}% is not in the register text`);

const bigdStudy = sources.BIGDSTUDY;
const jsonLd = [
  articleNode({
    path,
    headline: h1,
    description,
    datePublished: '2026-10-08',
    dateModified: '2026-10-10',
    author: 'CodersTrust',
    citation: [
      {
        '@type': 'ScholarlyArticle',
        name: 'Impact Evaluation Report of the WSDFM Program',
        author: { '@type': 'Organization', name: 'BRAC Institute of Governance and Development (BIGD), BRAC University' },
        datePublished: '2022-05',
        publisher: { '@type': 'Organization', name: 'BRAC University' },
      },
    ],
  }),
  faqJsonLd('foundations', path, faqIds),
];
const faq = faqItems('foundations', faqIds);
const toc = [
  { id: 'summary', label: 'The short answer' },
  { id: 'fit', label: 'Evidence-and-fit brief' },
  { id: 'design', label: 'How the trial worked' },
  { id: 'results', label: 'What it found' },
  { id: 'classes', label: 'Freelancing by classes attended' },
  { id: 'funders', label: 'What it means for funders' },
  { id: 'context', label: 'Context' },
  { id: 'faq', label: 'Questions' },
];
const d = discoveryCta();
---

<LongformLayout
  title={title('Randomized Trial Results')}
  description={description}
  path={path}
  heading={h1}
  eyebrow="Independent Evaluation"
  updated="2026-10-10"
  toc={toc}
  breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'Independent Evaluation' }]}
  jsonLd={jsonLd}
>
  <ReportSection id="summary" title="The Short Answer">
    <Callout tone="bluf">
      <p data-fact="RC-01 RC-02">
        <Fact id="RC-01" field="headline" /> <Fact id="RC-02" />
      </p>
      <PlainLine />
    </Callout>
    <div class="ie__stats">
      <FactStat id="RC-02" />
      <FactStat id="RC-01" />
      <FactStat id="RC-04" />
      <FactStat id="RC-03" />
    </div>
    <h3 class="t-heading-l" id="comparison">More Than Four Times the Typical Result</h3>
    <p data-fact="RC-06a"><Fact id="RC-06a" field="headline" /></p>
    <div class="ie__stats">
      <FactStat id="RC-06a" />
      <FactStat id="RC-13" />
      <FactStat id="RC-14" />
    </div>
    <p data-fact="RC-14"><Fact id="RC-14" /></p>
    <p><a class="link" href={bigdStudy.url} rel={linkAttrs(bigdStudy.url!).rel}>Read the BIGD Study<Icon name="arrow-right" size={16} /><span class="sr-only"> (opens {hostOf(bigdStudy.url!)})</span></a></p>
  </ReportSection>

  <div id="fit" class="ie__fit">
    <FitBrief />
  </div>

  <ReportSection id="design" title="How the Trial Worked">
    <p data-fact="RC-07"><Fact id="RC-07" /></p>
  </ReportSection>

  <ReportSection id="results" title="What the Trial Found">
    <h3 class="t-heading-l">Women Offered a Place</h3>
    <ul class="ie__list">
      <li data-fact="RC-02"><Fact id="RC-02" /></li>
      <li data-fact="RC-01"><Fact id="RC-01" /></li>
      <li data-fact="RC-04"><Fact id="RC-04" /></li>
    </ul>
    <h3 class="t-heading-l">Women Who Attended</h3>
    <ul class="ie__list">
      <li data-fact="RC-03"><Fact id="RC-03" /></li>
      <li data-fact="RC-13"><Fact id="RC-13" /></li>
      <li data-fact="RC-05"><Fact id="RC-05" /></li>
    </ul>
  </ReportSection>

  <ReportSection id="classes" title="Freelancing by Classes Attended">
    <BarChart
      title="Share Freelancing, by Classes Attended"
      items={classes.map((c) => ({ label: c.label, value: c.value }))}
    />
    <p data-fact="RC-08">Chart data: <Fact id="RC-08" as="span" /></p>
    <p data-fact="RC-10"><Fact id="RC-10" />.</p>
  </ReportSection>

  <ReportSection id="funders" title="What It Means for Funders">
    <p>
      The offered-place results are the closer guide to what a funded program can deliver, because they include women who were offered a place but did not attend. The study also reports results for women who attended.
    </p>
    <p>
      One trial in one population does not forecast a new country or a new track. That is why a new pilot starts from a scorecard agreed in co-design, with independent evaluation welcome.{' '}
      <a class="link" href={linkAttrs('/partner-with-us/').href}>How Partnerships Work<Icon name="arrow-right" size={16} /></a>
    </p>
  </ReportSection>

  <ReportSection id="context" title="Context: How This Compares">
    <p data-fact="RC-06"><strong>Context (external):</strong> <Fact id="RC-06" /></p>
    <p data-fact="RC-11"><strong>What the trial taught us about advising:</strong> <Fact id="RC-11" /></p>
  </ReportSection>

  <ReportSection id="faq" title="Questions About the Evidence">
    <Accordion items={faq} name="ie-faq" openFirst />
  </ReportSection>

  <NextStep
    heading="Talk to Us About a First Cohort."
    text="A discovery session sets priority groups, tracks and the pilot scorecard."
    cta={{ label: d.label, href: d.href }}
    secondary={{ label: 'See the Impact Survey 2026', href: '/impact/outcomes-2026/' }}
    micro={MICRO_COMMITMENT}
  />

</LongformLayout>

<style>
  .ie__stats {
    display: grid;
    gap: var(--space-lg) var(--space-gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  .ie__list {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }
  .ie__list li::marker {
    color: var(--primary);
  }
  .ie__fit {
    padding-block: var(--space-lg);
    border-top: 1px solid var(--outline-variant);
  }
</style>
