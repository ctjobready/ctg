---
import LongformLayout from '../../../layouts/LongformLayout.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import BarChart from '../../../components/ui/BarChart.astro';
import Icon from '../../../components/system/Icon.astro';
import EvidenceTag from '../../../components/system/EvidenceTag.astro';
import Fact from '../../../components/facts/Fact.astro';
import PlainLine from '../../../components/facts/PlainLine.astro';
import ReportSection from '../../../components/pages/impact/ReportSection.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import NextStep from '../../../components/pages/impact/NextStep.astro';
import { articleNode, desc, title, discoveryCta } from '../../../components/pages/impact/page-utils';
import { fact, sources } from '../../../data/facts';
import { BIGD_FULL, DISCOVERY_SESSION_LINE, MICRO_COMMITMENT } from '../../../data/copy';
import { hostOf, linkAttrs } from '../../../lib/url';

const path = '/impact/independent-evaluation/';
// H1 (WP30e): the result, in words; the <title> stays "Randomized Trial Results". The scope (CodersTrust’s WSDFM program, women in Dhaka) is the first sentence under it.
const h1 = 'Randomized Trial: Women Offered a Place Were More Likely to Work';
const description = desc('A BIGD trial of CodersTrust’s WSDFM program: women offered a place were 10.3 percentage points more likely to be employed.');

// RC-08 chart values must match the register text.
const classes = [
  { label: 'Control Group', value: 12 },
  { label: 'Attended 1–10 Classes', value: 16 },
  { label: 'Attended 11–24 Classes', value: 21 },
  { label: 'Attended 25 or More Classes', value: 42 },
];
const rc08 = fact('RC-08').text;
for (const c of classes) if (!rc08.includes(`${c.value}%`)) throw new Error(`RC-08 chart value ${c.value}% is not in the register text`);

// WP30e: one decision question with a short answer (the page itself answers "Is there independent evidence?"). The answer is the shared Q3 shortened to its two claims.
// WP107 (Sonnet XHigh run 3, Polish 5): one question does not make a FAQ, so the closing band is headed "How We Track Outcomes" and the answer sits directly under the H2 (no accordion, no FAQPage JSON-LD: the schema.org FAQPage needs a visible question and this page no longer prints one).
const trackingAnswer = 'For every cohort, as agreed in the program scope, we plan a baseline at enrollment, follow-up surveys at 3, 6 and 12 months and monthly reports. Where available, offer letters, payslips, platform logs or bank receipts document work and earnings.';
const bigdReport = sources.BIGD22;
// WP73: the follow-up study is under way (BIGD's study page, BIGDSTUDY), so RC-10's sentence links that page.
const bigdStudy = sources.BIGDSTUDY;
// WP99 (owner answer 2026-10-28, Q2 option C): the peer-reviewed article that publishes the trial (RC-15, source EDCC26) has its own band below ("Published in a Peer-Reviewed Journal"), apart from the report figures above it, which are not labeled peer-reviewed.
// The band also shows the article's benefit/cost ratio (RC-16: an explicit owner exception to the no-ROI rule, for this page only). The five authors are named in the structured data as Crossref lists them (checked 2026-10-28); the visible citation uses surnames, as the register does.
const journal = sources.EDCC26;
const journalAuthors = ['Mohammad Raied Arman', 'Anindita Bhattacharjee', 'Narayan Das', 'Mohima Gomes', 'Sakib Mahmood'];
const jsonLd = [
  articleNode({
    path,
    headline: h1,
    description,
    datePublished: '2026-10-08',
    dateModified: '2026-10-29',
    author: 'CodersTrust',
    citation: [
      {
        '@type': 'ScholarlyArticle',
        name: 'Impact Evaluation Report of the WSDFM Program',
        author: { '@type': 'Organization', name: 'BRAC Institute of Governance and Development (BIGD), BRAC University' },
        datePublished: '2022-05',
        publisher: { '@type': 'Organization', name: 'BRAC University' },
      },
      {
        '@type': 'ScholarlyArticle',
        name: 'Tackling Women’s Unemployment: Evidence from an Online Jobs Experiment in Bangladesh',
        author: journalAuthors.map((name) => ({ '@type': 'Person', name })),
        datePublished: '2026-10',
        isPartOf: { '@type': 'Periodical', name: 'Economic Development and Cultural Change' },
        pagination: '367–399',
        url: journal.url,
      },
    ],
  }),
];
// WP60 (cycle-32 review, Grok R6): the classes band is headed "Freelancing Share by Classes Attended" and says "In this study, freelancing was higher among women who attended more classes." (it said "More Classes, More Freelancing" and "... were more likely to be
// freelancing at follow-up", which reads as a dose effect; the trial randomized the offer of a place, not how many classes a woman attended). The anchor (#classes) is unchanged. The chart under it is titled "Share of Women Freelancing" (it was
// "Freelancing Share by Classes Attended", which the new heading would have printed twice, two lines apart); its data (RC-08) and its row labels are unchanged.
const toc = [
  { id: 'summary', label: 'The Result' },
  { id: 'results', label: 'Income, Freelancing and Household Effects' },
  { id: 'classes', label: 'Freelancing Share by Classes Attended' },
  { id: 'context', label: 'Over Four Times the Average of Nine Training Trials' },
  { id: 'journal', label: 'Published in a Peer-Reviewed Journal' },
  { id: 'funders', label: 'What It Means for Funders' },
  { id: 'outcomes', label: 'How We Track Outcomes' },
];
// How to read this trial (closed disclosure): what was evaluated, who took part and the design. The wording is the former Evidence-and-Fit Brief and RC-07.
const howToRead = `<ul>
<li data-fact="RC-07 PD-01"><strong>What was evaluated.</strong> CodersTrust’s 200-hour WSDFM program; today’s track is 100 hours.</li>
<li data-fact="RC-01"><strong>Who took part.</strong> Women in Dhaka with a Secondary School Certificate (SSC) or above, most of them aged 18–35.</li>
<li data-fact="RC-07"><strong>Design.</strong> ${fact('RC-07').text.replace(/^Trial design: /, '')}.</li>
</ul>`;
// RC-13's own summary line (employment and freelancing for women who attended); its income figure is already in the headline, so only this detail is repeated here.
const attendedDetail = fact('RC-13').stat?.glance?.note;
if (!attendedDetail) throw new Error('RC-13 no longer has a glance note');
// WP22: the direct answer under the H1 (40 to 60 words): what the trial found, for which program, and what it does not measure. The callout below keeps the
// plain-language line (PlainLine) and the income results, so the 10.3-point result is stated formally once here and in plain words once there.
// WP50 (cycle-25 review): this lead is where the page first names the evaluator, so it spells it out (BIGD_FULL: "the BRAC Institute of Governance and Development (BIGD)"); the later "BIGD" on the page ("Read the BIGD Report (2022)") is the abbreviation it introduces.
// WP61 (cycle-33 review, GPT-6.1 Sol G5): the first sentence carried the evaluator, the program, its length, its population and the result ("A randomized trial by ... found that women offered a place in CodersTrust’s WSDFM program, a 200-hour program for women in
// Dhaka, were 10.3 percentage points more likely to be employed than the control group."). The result now comes first, with the evaluator; the second sentence says which program the trial evaluated and that it is not today’s 100-hour tracks. 46 words, inside the 40 to 60 above (45 since WP99, when the second sentence named CodersTrust’s WSDFM program).
const directAnswer = `In a randomized trial by ${BIGD_FULL}, women offered a place were 10.3 percentage points more likely to be employed than the control group. The trial evaluated CodersTrust’s 200-hour WSDFM program for women in Dhaka, not today’s 100-hour tracks.`;
const answerWords = directAnswer.split(/\s+/).length;
if (answerWords < 40 || answerWords > 60) throw new Error(`Independent evaluation direct answer is ${answerWords} words (40 to 60)`);
if (!fact('RC-01').text.includes('10.3 percentage points') || !fact('RC-07').text.includes('200 hours') || fact('PD-01').stat?.value !== '100') throw new Error('Independent evaluation direct answer: RC-01, RC-07 or PD-01 changed');
const incomeLine = (fact('RC-01').headline ?? '').split(/(?<=\.)\s+(?=[A-Z])/).slice(1).join(' ');
if (!/^Their monthly income/.test(incomeLine)) throw new Error('Independent evaluation: RC-01 headline no longer has the income sentences');
const d = discoveryCta();
---

<LongformLayout
  title={title('Randomized Trial Results')}
  lead={directAnswer}
  description={description}
  path={path}
  heading={h1}
  eyebrow="Independent Evaluation"
  updated="2026-10-29"
  toc={toc}
  breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'Independent Evaluation' }]}
  jsonLd={jsonLd}
>
  <ReportSection id="summary" title="The Result">
    <p class="ie__type"><EvidenceTag type="Randomized Trial" /> <span>CodersTrust’s WSDFM program, women in Dhaka</span></p>
    <Callout tone="bluf">
      <PlainLine />
      <p data-fact="RC-01">{incomeLine}</p>
    </Callout>
    <p><a class="link" href={bigdReport.url} rel={linkAttrs(bigdReport.url!).rel}>Read the BIGD Report (2022)<Icon name="arrow-right" size={16} /><span class="sr-only"> (opens {hostOf(bigdReport.url!)})</span></a></p>
    <Accordion items={[{ q: 'How to Read This Trial', a: howToRead }]} name="ie-method" />
  </ReportSection>

  <ReportSection id="results" title="Income, Freelancing and Household Effects">
    <h3 class="t-heading-l">Women Offered a Place</h3>
    <ul class="ie__list">
      <li data-fact="RC-04"><Fact id="RC-04" /></li>
    </ul>
    <h3 class="t-heading-l">Women Who Attended</h3>
    <ul class="ie__list">
      <!-- WP110 (Opus Low run 2, kit 76, Minor 3): the attenders' income is stated here once, as the plain figure the register's RC-04 no longer carries; RC-13 is its data-fact. -->
      <li data-fact="RC-13">Income about +$36 a month.</li>
      <li data-fact="RC-13">{attendedDetail}</li>
      <!-- WP105 (Sonnet XHigh run 1, kit 71, Polish 2): the household line is the plain-words reading of RC-05, with no percentages (the six figures stay in the register and in the BIGD report); RC-05 stays the line's data-fact. -->
      <li data-fact="RC-05">Household effects for women who attended, against the control group: higher food and non-food spending, more of them with savings, fewer loans and less stress.</li>
    </ul>
    <p data-fact="RC-04a">The report gives these amounts in taka: <Fact id="RC-04a" />.</p>
  </ReportSection>

  <ReportSection id="classes" title="Freelancing Share by Classes Attended">
    <p>In this study, freelancing was higher among women who attended more classes.</p>
    <div data-fact="RC-08">
      <BarChart
        title="Share of Women Freelancing"
        items={classes.map((c) => ({ label: c.label, value: c.value }))}
      />
    </div>
  </ReportSection>

  <ReportSection id="context" title="Over Four Times the Average of Nine Training Trials">
    <p data-fact="RC-06a"><Fact id="RC-06a" field="headline" /></p>
  </ReportSection>

  <ReportSection id="journal" title="Published in a Peer-Reviewed Journal">
    <p data-fact="RC-15">The trial is also published in a peer-reviewed journal: Arman, Bhattacharjee, Das, Gomes and Mahmood (2026), “Tackling Women’s Unemployment: Evidence from an Online Jobs Experiment in Bangladesh”, <em>Economic Development and Cultural Change</em> 75(1): 367–399 (October 2026).{' '}
      <a href={journal.url} rel={linkAttrs(journal.url!).rel}>{journal.url}<span class="sr-only"> (opens {hostOf(journal.url!)})</span></a>
    </p>
    <p data-fact="RC-16"><Fact id="RC-16" /></p>
    <p>The results above come from BIGD’s report. The article is a separate publication.</p>
  </ReportSection>

  <ReportSection id="funders" title="What It Means for Funders">
    <p>
      The offered-place results are the closer guide to what a funded program can deliver, because they include women who were offered a place but did not attend. One trial in one population does not forecast a new country or a new track, so a new pilot starts from a scorecard agreed in co-design, with independent evaluation welcome.
    </p>
    <p data-fact="RC-10"><Fact id="RC-10" />.{' '}
      <a class="link" href={bigdStudy.url} rel={linkAttrs(bigdStudy.url!).rel}>See BIGD’s Follow-Up Study<Icon name="arrow-right" size={16} /><span class="sr-only"> (opens {hostOf(bigdStudy.url!)})</span></a>{' '}
      <a class="link" href={linkAttrs('/partner-with-us/').href}>See How Partnerships Work<Icon name="arrow-right" size={16} /></a>
    </p>
  </ReportSection>

  <ReportSection id="outcomes" title="How We Track Outcomes">
    <p data-fact="PD-09 PD-08 RC-01">{trackingAnswer}</p>
  </ReportSection>

  <NextStep
    heading="Talk to Us About a First Cohort"
    text={DISCOVERY_SESSION_LINE}
    cta={{ label: d.label, href: d.href }}
    secondary={{ label: 'See the Impact Survey 2026', href: '/impact/outcomes-2026/' }}
    more={[{ label: 'Find the Partnership Route for Your Organization', href: '/partner-with-us/' }]}
    micro={MICRO_COMMITMENT}
  />

</LongformLayout>

<style>
  .ie__type {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin: 0 0 var(--space-sm);
    color: var(--on-surface-variant);
    font-size: var(--fs-body-sm);
  }
  .ie__list {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }
  .ie__list li::marker {
    color: var(--primary);
  }
</style>
