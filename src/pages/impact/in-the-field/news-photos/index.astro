---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Hero from '../../../../components/system/Hero.astro';
import Icon from '../../../../components/system/Icon.astro';
import Section from '../../../../components/ui/Section.astro';
import CTABand from '../../../../components/ui/CTABand.astro';
import YearGallery from '../../../../components/pages/impact/YearGallery.astro';
import { newsGalleries } from '../../../../components/pages/impact/news-galleries';
import { linkAttrs } from '../../../../lib/url';
import { articleNode, desc, title, discoveryCta } from '../../../../components/pages/impact/page-utils';
import { DISCOVERY_SESSION_LINE, MICRO_COMMITMENT } from '../../../../data/copy';
import { webPage } from '../../../../lib/schema';

/**
 * News Photographs (WP20d, renamed WP24b): the photographs from the previous site's news posts, by year of the post, moved here from /impact/in-the-field/ so
 * that page holds the program, partner and recognition collections only. Plain, lazy-loaded, responsive images in lists, no script apart from
 * the disclosure helper below. Every picture has alt text that says what is visible and a short caption; a photograph the D13 rule does not let
 * render on a build is left out (PhotoGallery).
 */
const path = '/impact/in-the-field/news-photos/';
const description = desc('Photographs from CodersTrust news posts, by year, with the event named where the post gives one. Part of the In the Field photo collections.');
const jsonLd = [
  webPage({ path, name: 'News Photographs: CodersTrust news photographs by year', description, type: 'CollectionPage' }),
  articleNode({ path, headline: 'News Photographs', description, datePublished: '2026-10-14', dateModified: '2026-10-14', author: 'CodersTrust' }),
];

const byYear = await newsGalleries();
const jump = byYear.map((y) => ({ id: y.id, label: y.label }));
const d = discoveryCta();
---

<BaseLayout title={title('News Photographs')} description={description} path={path} breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'In the Field', href: '/impact/in-the-field/' }, { label: 'News Photographs' }]} jsonLd={jsonLd}>
  <Hero variant="inner" eyebrow="In the Field" title="News Photographs" lead="Photographs from CodersTrust news posts, by year of the post." artSeed="field-hub" />

  <Section pad="sm" aria-label="Jump to a year">
    <nav class="npa__jump" aria-label="Years of news photographs">
      <p class="eyebrow npa__label">Jump to a Year</p>
      <ul>
        {jump.map((j) => <li><a class="link" href={`#${j.id}`}>News {j.label}</a></li>)}
        <li><a class="link" href={linkAttrs('/impact/in-the-field/').href}>In the Field<Icon name="arrow-right" size={16} /></a></li>
      </ul>
    </nav>
  </Section>

  <!-- One native <details> disclosure per year, closed except the latest year. The disclosure carries the jump-link id and the script below opens it
       when a link, the address bar or the back button points at it or at a photograph inside it. -->
  {
    byYear.map((y, i) => (
      <details class="itf__year" id={y.id} open={i === 0}>
        <summary class="itf__sum"><h2 class="container itf__sum-in">News Photographs, {y.label}</h2></summary>
        <YearGallery id={`${y.id}-gallery`} label={`News photographs, ${y.label}, newest first`} photos={y.photos} tone={i % 2 === 0 ? 'white' : 'airy'} />
      </details>
    ))
  }

  <Section pad="sm" aria-label="About these photographs">
    <p class="npa__note">Photographs are used with the consent of those pictured.</p>
  </Section>

  <CTABand id="cta" heading="Talk to Us About a First Cohort" text={`Seen a program like the one you need? ${DISCOVERY_SESSION_LINE}`} cta={{ label: d.label, href: d.href }} secondary={{ label: 'How to Read the Evidence', href: '/impact/#evidence-ladder' }} micro={MICRO_COMMITMENT} />
</BaseLayout>

<script>
  // Open the year disclosure a link, the address bar or the back button points at (itself or anything inside it), then scroll to the target.
  function revealHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    const box = target?.closest('details.itf__year');
    if (target && box && !(box as HTMLDetailsElement).open) {
      (box as HTMLDetailsElement).open = true;
      requestAnimationFrame(() => target.scrollIntoView());
    }
  }
  revealHash();
  addEventListener('hashchange', revealHash);
</script>

<style>
  .itf__sum {
    cursor: pointer;
    list-style: none;
    border-top: 1px solid var(--outline-variant);
    background: var(--surface);
    color: var(--secondary);
    font-weight: var(--fw-bold);
    font-size: var(--fs-body-m);
    min-height: 44px;
  }
  .itf__sum::-webkit-details-marker {
    display: none;
  }
  .itf__sum:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
  }
  .itf__sum-in {
    margin: 0;
    font: inherit;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-md);
  }
  .itf__sum-in::after {
    content: '';
    flex: none;
    width: 0.6em;
    height: 0.6em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }
  .itf__year[open] > .itf__sum .itf__sum-in::after {
    transform: rotate(-135deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .itf__sum-in::after {
      transition: none;
    }
  }
  .itf__year > :global(.band) {
    border-top: 1px solid var(--outline-variant);
  }
  .npa__label {
    margin: 0 0 var(--space-xs);
  }
  .npa__jump ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
  }
  .npa__jump li a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .npa__note {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--fs-body-sm);
    color: var(--on-surface-variant);
  }
</style>
