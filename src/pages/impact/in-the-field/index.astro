---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Section from '../../../components/ui/Section.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import GalleryDisclosure from '../../../components/pages/programs/GalleryDisclosure.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Icon from '../../../components/system/Icon.astro';
import { photo, type Photo } from '../../../data/photos';
import { mayRender } from '../../../lib/permissions';
import { newsGalleries } from '../../../components/pages/impact/news-galleries';
import { linkAttrs } from '../../../lib/url';
import { articleNode, desc, title, discoveryCta } from '../../../components/pages/impact/page-utils';
import { DISCOVERY_SESSION_LINE, MICRO_COMMITMENT } from '../../../data/copy';
import { webPage } from '../../../lib/schema';

/**
 * In the field: a photo archive from the previous coderstrust.global site, grouped into program, partner and recognition collections. The dated
 * news galleries live on their own page, /impact/in-the-field/news-photos/ (the News Photo Archive, WP20d). Plain, lazy-loaded, responsive images (astro:assets) in lists: no script. Every picture has alt text that says what is
 * visible and a short caption (program, event or place; a year only where the source states it). People are named only where the old
 * site named them. A photograph the D13 rule does not let render on a build is left out (PhotoGallery).
 */
const path = '/impact/in-the-field/';
const description = desc('Photographs from CodersTrust programs, partner meetings and events, organized into program, partner and recognition collections.');
const jsonLd = [
  webPage({ path, name: 'In the field: CodersTrust programs in photographs', description, type: 'CollectionPage' }),
  articleNode({ path, headline: 'In the Field: Programs in Action', description, datePublished: '2026-10-11', dateModified: '2026-10-11', author: 'CodersTrust' }),
];

const reg = (keys: string[]): Photo[] => keys.map(photo);

// Programs, partners and recognition: the photo registry (src/data/photos.ts), one section each.
const groups: { id: string; eyebrow: string; title: string; lead: string; photos: Photo[] }[] = [
  {
    id: 'superkids',
    eyebrow: 'SuperKids',
    title: 'SuperKids: STEAM Learning for School Students',
    lead: 'SuperKids is CodersTrust’s school STEAM and digital-skills program for children.',
    photos: reg(['superkids/steam-workshop', 'superkids/robotics-session', 'superkids/robotics-desk', 'superkids/circuit-building', 'superkids/student-explains', 'superkids/classroom-uniform', 'superkids/students-seated', 'superkids/certificate-ceremony', 'superkids/art-competition', 'superkids/plaques-group', 'superkids/tree-planting', 'superkids/stem-group', 'superkids/mat-activity', 'superkids/event-audience', 'superkids/mou-signing', 'superkids/mou-signing-pen', 'superkids/learner-kolika', 'superkids/learner-zuhaina', 'superkids/learner-nihal', 'superkids/learner-zaeem']),
  },
  {
    id: 'nationwide',
    eyebrow: 'Classes and Campuses',
    title: 'Classes and Campuses: Classrooms, Examinations and Graduations',
    lead: 'Classes, an examination hall and a convocation.',
    photos: reg(['general/madrasa-students-lesson', 'general/madrasa-students-class', 'general/madrasa-students-hall', 'general/exam-hall', 'general/graduates-caps']),
  },
  {
    id: 'women',
    eyebrow: 'Programs',
    title: 'Women’s Programs: Kosovo and Bangladesh',
    lead: 'Training rooms and ceremonies from programs for women learners.',
    photos: reg(['general/kosovo-woman-training', 'general/kosovo-women-screens', 'general/kosovo-wow-group', 'general/her-power-laptops-1', 'general/her-power-laptops-2', 'general/her-power-group', 'impact/her-power-training-lab', 'impact/wsdfm-training-group', 'general/women-learners-classroom', 'general/lab-women-screen', 'general/empowering-women-event']),
  },
  {
    id: 'youth',
    eyebrow: 'People and Places',
    title: 'UNDP YES and Learner Communities',
    lead: 'Trainees from the UNDP YES (Youth Employment through Skills) program, and learners and program completers across programs.',
    photos: reg(['general/yes-trainees-group', 'general/yes-collage', 'general/woman-learner-laptop', 'general/learner-mosaic']),
  },
  {
    id: 'campus-work',
    eyebrow: 'Labs and Offices',
    title: 'Training Spaces and the CodersTrust Team',
    lead: 'Where learners train, and the offices and team behind the programs.',
    photos: reg(['general/students-campus-smiling', 'nu-pgd/students-laptops', 'general/computer-lab-rows', 'general/office-support-headset', 'general/office-meeting', 'general/office-exterior', 'general/team-tshirts', 'about/careers-team-falgun-celebration', 'about/careers-team-picnic']),
  },
  {
    id: 'partners',
    eyebrow: 'Partnerships',
    title: 'Partnerships and MOU Signings',
    lead: 'Agreements and affiliations with government bodies and universities.',
    photos: reg(['general/dict-hitech-mou', 'general/nctb-meeting', 'general/nu-affiliation-group', 'general/nu-affiliation-meeting', 'field/ccny-mou-signing']),
  },
  {
    id: 'recognition',
    eyebrow: 'Recognition',
    title: 'Recognition and Advocacy',
    lead: 'Awards, forums and meetings with institutions and leaders.',
    photos: reg(['recognition/speaking-students', 'recognition/supply-chain-award', 'recognition/nasdaq-sba', 'recognition/davos-sdg-lab', 'recognition/us-chamber', 'recognition/european-parliament', 'recognition/pope-francis', 'general/panel-international-forum', 'field/team-award-presentation', 'field/plaque-presentation']),
  },
];

// Program photographs lead, in this order: Women's Programs, UNDP YES, JobReady, SuperKids, then the national and campus group. Partnership and recognition collections sit after the "Partnerships, Recognition and News" heading.
const PROGRAM_ORDER = ['women', 'youth', 'campus-work', 'superkids', 'nationwide'];
const programGroups = PROGRAM_ORDER.map((id) => {
  const g = groups.find((x) => x.id === id);
  if (!g) throw new Error(`in-the-field: no photograph group "${id}"`);
  return g;
});
const laterGroups = groups.filter((g) => g.id === 'partners' || g.id === 'recognition');

const jump = [...programGroups, ...laterGroups].map((g) => ({ id: g.id, label: g.title.split(':')[0] }));
const newsHref = linkAttrs('/impact/in-the-field/news-photos/').href;
// The news photographs span the years of the posts in the archive (read from the data, so the line cannot drift from it).
const newsYears = (await newsGalleries()).flatMap((y) => y.label.split('–').map(Number));
const newsSpan = `${Math.min(...newsYears)}–${Math.max(...newsYears)}`;
// "View Full Collection (N Photographs)": N counts the photographs that may render on this build, the same rule the gallery applies.
const fullLabel = (g: { photos: Photo[] }) => `View Full Collection (${g.photos.filter((p) => mayRender(p.assetId)).length} Photographs)`;
const d = discoveryCta();
---

<BaseLayout title={title('In the Field: Programs in Action')} description={description} path={path} breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'In the Field' }]} jsonLd={jsonLd}>
  <Hero variant="inner" eyebrow="Impact" title="In the Field: Programs in Action" lead="Photographs from CodersTrust programs, partner meetings and events, from Kosovo to Bangladesh." artSeed="field-hub" />

  <Section pad="sm" aria-label="Jump to a collection">
    <nav class="itf__jump" aria-label="Collections of photographs">
      <ul>
        {jump.map((j) => <li><a class="link" href={`#${j.id}`}>{j.label}</a></li>)}
        <li><a class="link" href={newsHref}>News Photographs<Icon name="arrow-right" size={16} /></a></li>
      </ul>
    </nav>
  </Section>

  {programGroups.map((g, i) => <GalleryDisclosure id={g.id} eyebrow={g.eyebrow} title={g.title} lead={g.lead} photos={g.photos} visible={6} moreLabel={fullLabel(g)} tone={i % 2 === 0 ? 'white' : 'airy'} />)}

  <Section pad="sm" aria-labelledby="itf-later-h">
    <SectionHeader id="itf-later-h" eyebrow="More Collections" title="Partners, Forums and Recognition" lead="Signings, awards, forums and meetings." />
  </Section>

  {/* WP87 (CLR review, Opus XHigh run 1): the two collections are H3s under the "Partners, Forums and Recognition" H2 (it was followed by two sibling H2s and stood empty). */}
  {laterGroups.map((g, i) => <GalleryDisclosure id={g.id} eyebrow={g.eyebrow} title={g.title} lead={g.lead} photos={g.photos} visible={6} moreLabel={fullLabel(g)} tone={(programGroups.length + i) % 2 === 0 ? 'white' : 'airy'} level={3} />)}

  <Section pad="sm" aria-label="About these photographs">
    <p class="itf__news"><a class="link" href={newsHref}>News Photographs<Icon name="arrow-right" size={16} /></a> Photographs from news posts, {newsSpan}.</p>
    <p class="itf__note">Photographs are used with the consent of those pictured.</p>
  </Section>

  <CTABand id="cta" heading="Talk to Us About a First Cohort" text={`Seen a program like the one you need? ${DISCOVERY_SESSION_LINE}`} cta={{ label: d.label, href: d.href }} secondary={{ label: 'How to Read the Evidence', href: '/impact/#evidence-ladder' }} micro={MICRO_COMMITMENT} />
</BaseLayout>

<style>
  .itf__jump ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }
  .itf__news {
    margin: 0 0 var(--space-sm);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    align-items: center;
  }
  .itf__note {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--fs-body-sm);
    color: var(--on-surface-variant);
  }
</style>
