---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Section from '../../../components/ui/Section.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import PhotoGallery from '../../../components/ui/PhotoGallery.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import { allNews } from '../../../components/pages/news/news';
import { photo, type Photo } from '../../../data/photos';
import { FIELD_NEWS_LABEL, FIELD_NEWS_PHOTOS } from '../../../data/fieldNews';
import { linkAttrs } from '../../../lib/url';
import { articleNode, desc, title, discoveryCta } from '../../../components/pages/impact/page-utils';
import { MICRO_COMMITMENT } from '../../../data/copy';
import { webPage } from '../../../lib/schema';

/**
 * In the field: a photo archive from the previous coderstrust.global site, grouped by program, partner and event, and by year for the
 * news photographs. Plain, lazy-loaded, responsive images (astro:assets) in lists: no script. Every picture has alt text that says what is
 * visible and a short caption (program, event or place; a year only where the source states it). People are named only where the old
 * site named them. A photograph the D13 rule does not let render on a build is left out (PhotoGallery).
 */
const path = '/impact/in-the-field/';
const description = desc('Photographs from CodersTrust programs, partner meetings and events, grouped by program, partner and year, with captions and descriptions.');
const jsonLd = [
  webPage({ path, name: 'In the field: CodersTrust photo archive', description, type: 'CollectionPage' }),
  articleNode({ path, headline: 'In the Field', description, datePublished: '2026-10-11', dateModified: '2026-10-11', author: 'CodersTrust' }),
];

const reg = (keys: string[]): Photo[] => keys.map(photo);

// Programs, partners and recognition: the photo registry (src/data/photos.ts), one section each.
const groups: { id: string; eyebrow: string; title: string; lead: string; photos: Photo[] }[] = [
  {
    id: 'superkids',
    eyebrow: 'Programs',
    title: 'SuperKids: STEAM Learning for School Students',
    lead: 'SuperKids is CodersTrust’s school STEAM and digital-skills program for children. These photographs show workshops, classes, certificate ceremonies and events run by SuperKids by CodersTrust.',
    photos: reg(['superkids/steam-workshop', 'superkids/robotics-session', 'superkids/robotics-desk', 'superkids/circuit-building', 'superkids/student-explains', 'superkids/classroom-uniform', 'superkids/students-seated', 'superkids/certificate-ceremony', 'superkids/art-competition', 'superkids/plaques-group', 'superkids/tree-planting', 'superkids/stem-group', 'superkids/mat-activity', 'superkids/event-audience', 'superkids/mou-signing', 'superkids/mou-signing-pen', 'superkids/learner-kolika', 'superkids/learner-zuhaina', 'superkids/learner-nihal', 'superkids/learner-zaeem']),
  },
  {
    id: 'nationwide',
    eyebrow: 'Programs',
    title: 'Classes and Campuses: Madrasah Learners, Examinations and Graduates',
    lead: 'Classes, an examination hall and a graduation day. The previous site did not tie every photograph to a named program, so none is labeled with one here.',
    photos: reg(['general/madrasa-students-lesson', 'general/madrasa-students-class', 'general/madrasa-students-hall', 'general/exam-hall', 'general/graduates-caps']),
  },
  {
    id: 'women',
    eyebrow: 'Programs',
    title: 'Women’s Programs: Her Power, Kosovo, Albania and WSDFM',
    lead: 'Training rooms and ceremonies from programs for women learners.',
    photos: reg(['general/her-power-laptops-1', 'general/her-power-laptops-2', 'general/her-power-group', 'impact/her-power-training-lab', 'general/kosovo-woman-training', 'general/kosovo-women-screens', 'general/albania-trainees-group', 'impact/wsdfm-training-group', 'general/women-learners-classroom', 'general/lab-women-screen', 'general/empowering-women-event']),
  },
  {
    id: 'youth',
    eyebrow: 'Programs',
    title: 'UNDP YES and Learner Communities',
    lead: 'Trainees from the UNDP YES (Youth Employment through Skills) program, and learners and graduates across programs.',
    photos: reg(['general/yes-trainees-group', 'general/yes-collage', 'general/woman-learner-laptop', 'general/learner-mosaic']),
  },
  {
    id: 'campus-work',
    eyebrow: 'Programs',
    title: 'JobReady: Campuses, Labs and Workplaces',
    lead: 'Where learners train, and the offices and team behind the programs.',
    photos: reg(['general/students-campus-smiling', 'nu-pgd/students-laptops', 'general/computer-lab-rows', 'general/office-support-headset', 'general/office-meeting', 'general/office-exterior', 'general/team-tshirts', 'about/careers-team-falgun-celebration', 'about/careers-team-picnic']),
  },
  {
    id: 'partners',
    eyebrow: 'Partners',
    title: 'Partnerships and MoU Signings',
    lead: 'Agreements and affiliations with government bodies and universities.',
    photos: reg(['general/dict-hitech-mou', 'general/nctb-meeting', 'general/nu-affiliation-group', 'general/nu-affiliation-meeting', 'field/ccny-mou-signing']),
  },
  {
    id: 'recognition',
    eyebrow: 'Recognition',
    title: 'Recognition and Advocacy',
    lead: 'Awards, forums and meetings with institutions and leaders.',
    photos: reg(['recognition/speaking-students', 'recognition/supply-chain-award', 'recognition/nasdaq-sba', 'recognition/davos-sdg-lab', 'recognition/us-chamber', 'recognition/european-parliament', 'recognition/pope-francis', 'general/panel-international-forum', 'field/team-award-presentation', 'field/plaque-presentation']),
  },
];

// Program and training photographs lead; partnership, recognition and event groups sit after the "Leadership, Recognition and Events" heading.
const programGroups = groups.filter((g) => g.eyebrow === 'Programs');
const laterGroups = groups.filter((g) => g.eyebrow !== 'Programs');

// The news photographs, by year of the post: alt text from src/data/fieldNews.ts, caption = event + month and year, asset id of the post (D13).
const files = import.meta.glob<{ default: ImageMetadata }>('../../../assets/images/news/**/*.{jpg,png}', { eager: true });
const posts = (await allNews()).filter((p) => !p.data.political);
const month = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const years = new Map<number, { date: number; photo: Photo }[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  for (const e of FIELD_NEWS_PHOTOS.filter((x) => x.slug === post.id)) {
    const img = files[`../../../assets/images/news/${post.id}/${e.file}`]?.default;
    if (!img) throw new Error(`in-the-field: missing image ${post.id}/${e.file}`);
    const list = years.get(year) ?? [];
    const caption = e.caption ?? `${FIELD_NEWS_LABEL[post.id] ?? post.data.title}, ${month.format(post.data.date)}`;
    list.push({ date: post.data.date.getTime(), photo: { src: img, alt: e.alt, assetId: `news-${post.id}`, caption } });
    years.set(year, list);
  }
}
// A year with a single photograph is joined to the next year, so every gallery holds at least two pictures.
const byYear: { label: string; id: string; photos: Photo[] }[] = [];
let carry: { from: number; items: { date: number; photo: Photo }[] } | undefined;
for (const [year, list] of [...years.entries()].sort((a, b) => a[0] - b[0])) {
  const items = [...(carry?.items ?? []), ...list];
  const from = carry?.from ?? year;
  if (items.length < 2) {
    carry = { from, items };
    continue;
  }
  const label = from === year ? String(year) : `${from}–${year}`;
  // Newest post first within a gallery, like the years themselves; photographs of one post keep their order (stable sort).
  byYear.push({ label, id: `news-${label.replace('–', '-')}`, photos: [...items].sort((x, y) => y.date - x.date).map((x) => x.photo) });
  carry = undefined;
}
byYear.reverse();

const jump = [
  ...groups.map((g) => ({ id: g.id, label: g.title.split(':')[0] })),
  ...byYear.map((y) => ({ id: y.id, label: `News ${y.label}` })),
];
const d = discoveryCta();
---

<BaseLayout title={title('In the Field: Photo Archive')} description={description} path={path} breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'In the Field' }]} jsonLd={jsonLd}>
  <Hero variant="inner" eyebrow="Impact" title="In the Field" lead="Photographs from CodersTrust programs, partner meetings and events, grouped by program, partner and year. Each picture has a short caption and a description for screen readers." artSeed="field-hub" />

  <Section pad="sm" aria-label="Jump to a group">
    <nav class="itf__jump" aria-label="Groups of photographs">
      <ul>
        {jump.map((j) => <li><a class="link" href={`#${j.id}`}>{j.label}</a></li>)}
      </ul>
    </nav>
  </Section>

  {programGroups.map((g, i) => <PhotoGallery id={g.id} eyebrow={g.eyebrow} title={g.title} lead={g.lead} photos={g.photos} tone={i % 2 === 0 ? 'white' : 'airy'} />)}

  <Section pad="sm" aria-labelledby="itf-later-h">
    <SectionHeader id="itf-later-h" eyebrow="Later in the Archive" title="Leadership, Recognition and Events" lead="Partnership signings, awards, forums and meetings, then photographs from the news posts by year." />
  </Section>

  {laterGroups.map((g, i) => <PhotoGallery id={g.id} eyebrow={g.eyebrow} title={g.title} lead={g.lead} photos={g.photos} tone={(programGroups.length + i) % 2 === 0 ? 'white' : 'airy'} />)}

  {byYear.map((y, i) => <PhotoGallery id={y.id} eyebrow="News and Events" title={`Partners, Programs and Events,${y.label}`} lead="Photographs from the news posts of that year; each caption names the event and the month." photos={y.photos} tone={(groups.length + i) % 2 === 0 ? 'white' : 'airy'} />)}

  <Section pad="sm" aria-label="About these photographs">
    <p class="itf__note">Photographs are used with the consent of those pictured. The stories behind them are in <a class="link" href={linkAttrs('/news/').href}>the news</a> and on the <a class="link" href={linkAttrs('/impact/case-studies/').href}>case study</a> pages.</p>
  </Section>

  <CTABand id="cta" heading="Talk to Us About a First Cohort." cta={{ label: d.label, href: d.href }} secondary={{ label: 'Read the evidence', href: '/impact/' }} micro={MICRO_COMMITMENT} />
</BaseLayout>

<style>
  .itf__jump ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }
  .itf__note {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--fs-body-sm);
    color: var(--on-surface-variant);
  }
</style>
