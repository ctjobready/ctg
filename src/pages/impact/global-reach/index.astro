---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/system/Hero.astro';
import Icon from '../../../components/system/Icon.astro';
import WorldMap from '../../../components/ui/WorldMap.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import { articleNode, desc, title, discoveryCta, val } from '../../../components/pages/impact/page-utils';
import { fact } from '../../../data/facts';
import { locations } from '../../../data/countries';
import { MICRO_COMMITMENT } from '../../../data/copy';
import { linkAttrs } from '../../../lib/url';

// WP57 (cycle-29 review, Grok R1): the H1 is "Where We Have Worked: 16 Countries and Territories" (it said "Delivered in ...", while the table lists an announced cooperation (Iraq), the 2020 partnerships (Egypt, Benin) and the launch location (Denmark)); the lead is
// still SC-03's "Programs in 16 countries and territories ..."; a no-break space joins the count to "Countries", so the heading wraps after the colon and not between "16" and "Countries". The <title> stays "Global Reach: 16 Countries and Territories" (the H1's words and " | CodersTrust" are 64 characters, over the 60-character limit; the count is the same words), and the description is unchanged.
// WP58 (cycle-30 reviews, Claude S1 e and GPT-6.1 Sol G1 f to h): the lead is SC-03's sentence, which now reads "CodersTrust has worked in 16 countries and territories across Asia, Africa, Europe and the Americas, including Bangladesh since 2014." (it began "Programs in ..."), and the description
// begins the same way. The map section's eyebrow and the map's caption are "Where We Have Worked" (they said "Where Programs Have Run"); the note under the map says what a location is, that the table distinguishes training, partnerships and launch activity, and that New York is the headquarters, not one of the locations.
// WP60 (cycle-32 review, Grok R1): the note no longer says the table "distinguishes training, partnerships and launch activity" (seven rows have no note, so it did not, row by row). It says what the notes mark: "Rows that are a partnership, an announced cooperation or the launch say so in their note;
// the other rows are training programs." (Benin, Egypt, Uganda, Albania and Kosovo name a partner, Iraq an announced cooperation, Denmark the launch; Bangladesh's and Somaliland's notes describe training, so the rule is "says so", not "has a note".)
const path = '/impact/global-reach/';
const headline = `${fact('SC-03').text}.`;
// WP55 (owner decision 2026-10-18; 16 countries and territories since WP56 removed Somalia): the count in the description is SC-03's, and the number of locations beyond Bangladesh is that count less one, so neither is typed.
// WP58: "... and 15 international locations" (it was ", plus 15 international locations"), so the sentence stays within the 155-character limit after "CodersTrust has worked in" replaced "Programs in".
const count = val('SC-03');
const description = desc(`CodersTrust has worked in ${count} countries and territories: Bangladesh since 2014 and ${Number(count) - 1} international locations, with each location’s target group and skills.`);
const jsonLd = [articleNode({ path, headline: 'Global Reach', description, datePublished: '2026-10-08', dateModified: '2026-10-18', author: 'CodersTrust' })];
// WP30e: the footprint leads. The locations beyond Bangladesh are listed from the same data as the map and the table, so the list cannot drift from them.
const beyond = locations.filter((l) => l.id !== 'bangladesh').map((l) => l.name).sort((x, y) => x.localeCompare(y));
const beyondLine = `${beyond.slice(0, -1).join(', ')} and ${beyond[beyond.length - 1]}`;
const d = discoveryCta();
---

<BaseLayout title={title(`Global Reach: ${val('SC-03')} Countries and Territories`)} description={description} path={path} breadcrumbs={[{ label: 'Impact', href: '/impact/' }, { label: 'Global Reach' }]} jsonLd={jsonLd}>
  <Hero variant="inner" eyebrow="Impact" title={`Where We Have Worked: ${val('SC-03')}\u00a0Countries and Territories`} lead={headline} artSeed="global-reach" />

  <Section id="map" aria-labelledby="map-h">
    <SectionHeader id="map-h" eyebrow="Where We Have Worked" title="Beyond Bangladesh" lead={`${beyondLine}.`} />
    <div class="stack">
      <WorldMap />
      <Callout label="Locations Are Not Programs">
        <p data-fact="SC-03">A location is a country or territory where CodersTrust has worked; most rows do not say how many programs ran there, or how large they were. Rows that are a partnership, an announced cooperation or the launch say so in their note; the other rows are training programs. New York is the headquarters, not one of the {count} locations. Most delivery has been in Bangladesh.</p>
      </Callout>
      <p><a class="link" href={linkAttrs('/impact/case-studies/').href}>See the Case Studies, Starting with Kosovo<Icon name="arrow-right" size={16} /></a></p>
    </div>
  </Section>

  <CTABand id="cta" heading="Talk to Us About a First Cohort" text="Tell us the country and priority groups; we outline a first cohort in a discovery session." cta={{ label: d.label, href: d.href }} secondary={{ label: 'How to Read the Evidence', href: '/impact/#evidence-ladder' }} micro={MICRO_COMMITMENT} />
</BaseLayout>
