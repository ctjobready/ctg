---
/**
 * P6 Universities: /partner-with-us/universities/ (T3, implements doc 04 matrix 4.5).
 * C1 to C14 in order, as the numbered table in doc 06 P6.
 */
import InShort from '../../../components/pages/partners/InShort.astro';
import LandingLayout from '../../../layouts/LandingLayout.astro';
import HeroBand from '../../../components/sections/HeroBand.astro';
import DefinitionBand from '../../../components/sections/DefinitionBand.astro';
import ProblemBand from '../../../components/sections/ProblemBand.astro';
import CostSection from '../../../components/pages/programs/CostSection.astro';
import FutureBand from '../../../components/sections/FutureBand.astro';
import { futurePhotos } from '../../../data/photos';
import MechanismBand from '../../../components/sections/MechanismBand.astro';
import ProofBand from '../../../components/sections/ProofBand.astro';
import FeaturesTable from '../../../components/sections/FeaturesTable.astro';
import FAQBand from '../../../components/sections/FAQBand.astro';
import ComparisonBand from '../../../components/sections/ComparisonBand.astro';
import RiskReversalBand from '../../../components/sections/RiskReversalBand.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import Section from '../../../components/ui/Section.astro';
import PairedEvidence from '../../../components/pages/partners/PairedEvidence.astro';
import Fact from '../../../components/facts/Fact.astro';
import GainsPains from '../../../components/pages/partners/GainsPains.astro';
import PartnerGuideBand from '../../../components/pages/partners/PartnerGuideBand.astro';
import SubBand from '../../../components/pages/partners/SubBand.astro';
import Callout from '../../../components/pages/partners/Callout.astro';
import EvidenceList from '../../../components/pages/partners/EvidenceList.astro';
import ForNotFor from '../../../components/pages/partners/ForNotFor.astro';
import RouteLink from '../../../components/pages/partners/RouteLink.astro';
import OfferCards from '../../../components/pages/partners/OfferCards.astro';
import StepsBand from '../../../components/pages/partners/StepsBand.astro';
import Reinforcement from '../../../components/pages/partners/Reinforcement.astro';
import PageEnhancements from '../../../components/pages/partners/PageEnhancements.astro';
import { HOURS, LINKS, TRACER_MONTHS, TRACKING_MONTHS, factPart, meta, programOptions } from '../../../components/pages/partners/partners';
import { C14, EMPATHY, HEADLINE, POSITIONING, SCORECARD, SPEED_UNIVERSITIES, VALUE_PROPOSITION } from '../../../data/copy';
import { CLAIM_PX06, offerDurationText } from '../../../components/sections/copyText';
import { faqJsonLd } from '../../../lib/faq';
import { cta } from '../../../lib/mailto';
import { webPage } from '../../../lib/schema';

const PATH = '/partner-with-us/universities/';
const primary = cta('campus');

const degreeShare = factPart('OC-09', /84\.6% hold a bachelor’s degree or higher/);
const { title, description } = meta(
  'JobReady@Campus for Universities and Colleges',
  `JobReady@Campus helps degree holders prepare for digital work with mentoring. Among surveyed completers, ${degreeShare}.`,
);

const FAQ_IDS = ['Q1', 'Q10', 'Q8'];
const options = programOptions().filter((o) => o.name === 'Multi-Cohort Pilot Program' || o.name === 'Scale');
const optionText: Record<string, string> = {
  'Multi-Cohort Pilot Program': 'Prove the model with a first campus program.',
  Scale: 'Expand to more cohorts and campuses on the pilot’s results.',
};
const steps = [
  { title: 'Set Up', text: 'Agree tracks and campus labs in a discovery session.' },
  { title: 'Prepare for Certification', text: `${HOURS} training hours per certification.` },
  { title: 'Mentor and Place', text: 'Three months of milestone-based mentoring, placement support and tracers.' },
];
---

<LandingLayout
  title={title}
  description={description}
  path={PATH}
  breadcrumbs={[{ label: 'Partner with Us', href: LINKS.hub }, { label: 'Universities' }]}
  jsonLd={[webPage({ path: PATH, name: title, description }), faqJsonLd('universities', PATH, FAQ_IDS)]}
  stickyCta={{ label: primary.label, href: primary.href }}
>
  <!-- C1 · Identity hook -->
  <HeroBand
    audience="For Universities and Colleges"
    title={HEADLINE.universities}
    lead={VALUE_PROPOSITION.universities}
    cta={{ label: primary.label, href: primary.href }}
    artSeed="partners-universities"
  />
  <InShort
    bullets={[
      'Industry certification preparation runs beside the degree, in your own campus labs.',
      'Tracks are set from employer demand, and certified local facilitators keep the capacity on campus.',
      'Tracer surveys give your institution placement evidence from its own students.',
      'Start with a pilot; timing follows your academic calendar.',
    ]}
    links={[
      { label: 'How It Works', href: '#mechanism' },
      { label: 'Evidence', href: '#proof-band' },
      { label: 'What You Receive', href: '#features' },
      { label: 'Options', href: '#offer' },
      { label: 'Next Steps', href: '#next-steps' },
    ]}
  />
  <RouteLink kicker="See the Program" label="See Campus Delivery Details" href={LINKS.campus} />
  <!-- GEO · What is CodersTrust? -->
  <DefinitionBand />
  <ForNotFor
    forText="You want employer-demand tracks with certification preparation alongside degrees."
    notText="You want to replace the degree."
  />

  <!-- C2 · Problem -->
  <ProblemBand
    title="For Too Many Graduates, a Degree Is Not Turning into a Job."
    bluf="Capable students finish their degrees, and employers still say they cannot find the skills they need."
    factIds={['PX-03', 'PX-05']}
  >
    <GainsPains
      slot="lead"
      gains={['Graduates who start work', 'A stronger employment story for your institution', 'Students with credentials employers recognize']}
      pains={[
        { q: 'Why do degree holders struggle to find work?', text: 'A degree alone is not producing job offers.' },
        { q: 'Why can’t employers find the skills they need?', text: 'Employers report difficulty finding the talent they need.' },
        { q: 'Where are your placement results?', text: 'Institutions lack placement results they can publish.' },
      ]}
    />
  </ProblemBand>

  <!-- C3 · Agitation -->
  <div class="pp-two">
    <CostSection
      title="Every Cohort Without Placement Evidence Weakens Your Employment Story"
      transition="It doesn’t have to be this way."
      blocks={[
        { claim: 'Jobs Requiring AI Skills Are Growing and Paying More.', factId: 'PX-08', scope: 'Globally', implication: 'Students who graduate without those skills start behind.' },
        { claim: CLAIM_PX06, factId: 'PX-06', implication: 'A degree alone does not show employers what a graduate can do.' },
      ]}
    />
  </div>

  <!-- C4 · Future state -->
  <FutureBand
    photos={futurePhotos('partners-universities')}
    title="What Your Students Leave With"
    lead="Illustrative, not case studies."
    vignettes={[
      { kind: 'Functional', title: 'A Certification Beside the Degree', text: 'Students who pass the exam add an industry certification beside their degree. Certification is not guaranteed; eligibility, exam fees, attempts and retakes are agreed in the program scope.' },
      { kind: 'Emotional', title: 'Placement Results You Can Discuss', text: `Tracer results at ${TRACER_MONTHS} show where students work.` },
      { kind: 'Social', title: 'Capacity That Stays', text: 'Campus labs become blended-learning centers run by certified local facilitators.' },
    ]}
  />

  <!-- C5 · Guide (empathy first) -->
  <PartnerGuideBand
    empathy={EMPATHY.universities}
    statements={[
      { facts: ['SC-04'], markers: [], text: 'CodersTrust has been National University’s official training partner for digital career skills and credentials since 2023.' },
    ]}
    method={{ text: 'JobReady@Campus runs training in parallel with academic studies, and TalentLEAP organizes skills into career paths with progressive levels.', link: { label: 'How TalentLEAP Works', href: LINKS.talentleap } }}
    partnerGroup="academic"
  />

  <!-- C6 · Mechanism (JobReady@Campus) -->
  <MechanismBand
    title="JobReady@Campus: Training Alongside the Degree"
    positioning={POSITIONING.universities}
    blocks={[
      { label: 'Set Up', title: 'Campus Labs as Learning Centers', text: 'On-campus labs become blended-learning centers with certified local facilitators; faculty members act as coordinators.', icon: 'landmark' },
      { label: 'Prepare for Certification', title: 'Industry Certification Tracks', text: `${HOURS} training hours per certification, with certification exam preparation; exam eligibility, attempts and terms are agreed in the program scope.`, icon: 'award' },
      { label: 'Mentor and Place', title: 'Mentoring and Placement', text: `Three months of milestone-based mentoring and placement support, with outcome tracking for ${TRACKING_MONTHS} months.`, icon: 'users' },
      { label: 'Alongside Studies', title: 'In Parallel with the Degree', text: 'Training runs in parallel with academic studies, with professional internships where employer placements are available.', icon: 'graduation-cap' },
    ]}
    link={{ label: 'About JobReady@Campus', href: LINKS.campus }}
  />
  <!-- C7 · Proof: the National University partnership first, then the broader evidence from the youth programs -->
  <PairedEvidence
    title="The National University Partnership"
    lead="These figures describe National University’s size and the learners being onboarded; they are not learners trained by CodersTrust."
    items={[
      { id: 'SC-04', label: 'Official Training Partner' },
      { id: 'SC-05', label: 'National University' },
      { id: 'PA-05', label: 'University Partners' },
    ]}
  />
  <ProofBand
    title="Independent Evidence and Survey Results"
    headlineFact="RC-01"
    statIds={['RC-02', 'RC-04']}
    chartId="OC-01"
    links={[
      { label: 'The Randomized Trial', href: LINKS.trial },
      { label: 'Outcomes 2026', href: LINKS.outcomes },
    ]}
  >
    <EvidenceList
      heading="What Surveyed Completers Report"
      items={[
        { facts: ['OC-09'], text: `Among surveyed completers, ${degreeShare}; university graduates are a central audience for CodersTrust programs.` },
        { facts: ['OC-03'] },
      ]}
    />
  </ProofBand>

  <!-- C8 · Features to benefits -->
  <FeaturesTable
    title="What You Get, and What It Means for Your Students"
    rows={[
      {
        feature: 'Industry Certifications by Track and Three Months of Milestone-Based Mentoring',
        means: 'each track prepares students for an industry certification, with mentoring toward a first client or a first job.',
        outcome: 'A supported route to a recognized credential',
        relieves: 'Degree holders struggle to find work',
      },
      {
        feature: 'Tracks set from employer demand; an AI-ready curriculum',
        means: 'training matches what employers say they cannot find.',
        outcome: 'Skills employers ask for',
        relieves: 'Employers cannot find the skills they need',
      },
      {
        feature: 'Tracers, Documentary Evidence of Earnings and Monthly Reports',
        means: 'your institution has outcome data it can report.',
        outcome: 'Placement results you can discuss',
        relieves: 'No placement results to publish',
      },
      {
        feature: 'Certified Local Facilitators, with Campus Labs as Blended-Learning Centers',
        means: 'capacity stays on your campus.',
        outcome: 'Campus labs that serve as learning centers',
      },
    ]}
  />

  <!-- C9 · Objections -->
  <FAQBand
    audience="universities"
    ids={FAQ_IDS}
    title="Questions Universities Ask"
    allLink={{ label: 'Safeguarding, Governance and Due Diligence', href: LINKS.governance }}
  />

  <!-- C10 · Differentiation -->
  <ComparisonBand
    title="Compare the Approaches."
    lead="Preparation for a recognized credential is built into each track, and delivery uses infrastructure that already exists: campus labs, certified local facilitators and Training of Trainers. Provision varies by provider and program."
  />

  <!-- C11 · Offer -->
  <OfferCards
    title="Choose Where to Start."
    cards={options.map((o, i) => ({ eyebrow: `Option ${i + 1}`, title: o.name, headline: o.volume, meta: offerDurationText(o.name, o.duration), text: optionText[o.name], facts: ['PD-05'] }))}
    inclusions
    recommended={0}
  />

  <!-- C12 · Risk reversal (immediately before C13) -->
  <RiskReversalBand
    title="Start with a Pilot. Decide on Evidence."
    lead={SCORECARD.text.replace('expansion is the funder’s decision', 'expansion is your institution’s decision')}
    points={[
      { icon: 'rocket', title: 'A Pilot Comes First', text: 'Start with a first campus program and see its results.' },
      { icon: 'target', title: 'Scorecard Thresholds', text: 'If a threshold is missed, a corrective plan is triggered.' },
      { icon: 'handshake', title: 'Expansion Is Your Decision', text: 'Expansion is your institution’s decision.' },
      { icon: 'shield', title: 'Independent Evaluation Welcome', text: 'We support third-party evaluation of outcomes.' },
    ]}
  />

  <!-- C13 · Call to action -->
  <CTABand
    id="cta"
    heading="Let’s Bring JobReady@Campus to Your Students."
    cta={{ label: primary.label, href: primary.href }}
    secondary={{ label: 'Read the evidence', href: LINKS.evidence }}
    urgency={SPEED_UNIVERSITIES.text}
  />

  <!-- C14 · Next steps -->
  <StepsBand
    title="What Happens After You Say Yes"
    steps={[
      { title: 'Discovery Session', text: 'A conversation about your students, programs and timeline.' },
      { title: 'Co-Design', text: 'Tracks and campus labs are shaped with you.' },
      { title: 'Agreement', text: 'Scope, schedule and success measures are agreed.' },
      { title: 'First cohort in training', text: 'Certified facilitators begin the first cohort in your labs.' },
      { title: 'Monthly Reports', text: 'Enrollment, completion, certification and placements follow each month.' },
    ]}
  />
  <Reinforcement logos={false} reminder={false} validate={C14.validateFor.universities} />

  <PageEnhancements />
</LandingLayout>
