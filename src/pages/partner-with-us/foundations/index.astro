---
/**
 * P5 Foundations and CSR: /partner-with-us/foundations/ (T3, implements doc 04 matrix 4.3).
 * C1 to C14 in order, as the numbered table in doc 06 P5.
 * WP30c (owner direction 2026-10-14, "less is more"): every CMF band stays, each states its point once. Gone: the In Short summary, the fit check, the evidence-and-fit brief,
 * the reporting-and-recognition paragraph (the features row carries it), the full review cycle (it lives on the partnership overview, as on the Development Partners page)
 * and the restated three-step mechanism. The two inquiry links now sit directly under the two-route comparison they belong to (cycle-7 IA review).
 * WP35 (cycle-12 review): the trial and the survey are shown once, as tiles in Results at a Glance; the proof band that restated them is a one-line strip of links (#proof-band). The WSDFM tile is gone
 * from the glance (its 71% is program records, read beside the trial's 63.1%; the Kosovo program result takes its place), the evaluator is spelled out where the page first names it, the independent-evidence
 * row says the evidence is on the predecessor program, and the meta description is a complete sentence.
 * WP36 (cycle-13 reviews): the +$27 tile reads "estimated monthly income gain for women offered a place in a predecessor program, versus a control mean of about $66" (RC-04's stat label); the three pains are
 * statements; the cost and safeguarding questions have the one-line route answers, each with a link to the full answer.
 * WP37 (cycle-14 review): the Funding Route 2 passage under the offer cards no longer retells the platform and its live and pre-launch list (the comparison above it has them); it says what a platform grant
 * supports in one sentence and links the platform-grant inquiry.
 */
import PartnerGlance from '../../../components/pages/partners/PartnerGlance.astro';
import PairedEvidence from '../../../components/pages/partners/PairedEvidence.astro';
import DueDiligenceView from '../../../components/pages/hub/DueDiligenceView.astro';
import LearnerVoice from '../../../components/pages/impact/LearnerVoice.astro';
import LandingLayout from '../../../layouts/LandingLayout.astro';
import HeroBand from '../../../components/sections/HeroBand.astro';
import DefinitionBand from '../../../components/sections/DefinitionBand.astro';
import ProblemBand from '../../../components/sections/ProblemBand.astro';
import CostSection from '../../../components/pages/programs/CostSection.astro';
import FutureBand from '../../../components/sections/FutureBand.astro';
import { futurePhotos } from '../../../data/photos';
import MechanismBand from '../../../components/sections/MechanismBand.astro';
import CaseStudyCarousel from '../../../components/sections/CaseStudyCarousel.astro';
import FeaturesTable from '../../../components/sections/FeaturesTable.astro';
import FAQBand from '../../../components/sections/FAQBand.astro';
import NextStepsBand from '../../../components/sections/NextStepsBand.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import SessionAgenda from '../../../components/ui/SessionAgenda.astro';
import Icon from '../../../components/system/Icon.astro';
import GainsPains from '../../../components/pages/partners/GainsPains.astro';
import PartnerGuideBand from '../../../components/pages/partners/PartnerGuideBand.astro';
import SubBand from '../../../components/pages/partners/SubBand.astro';
import Callout from '../../../components/pages/partners/Callout.astro';
import OfferCards from '../../../components/pages/partners/OfferCards.astro';
import FundingRoutes from '../../../components/pages/partners/FundingRoutes.astro';
import Reinforcement from '../../../components/pages/partners/Reinforcement.astro';
import PageEnhancements from '../../../components/pages/partners/PageEnhancements.astro';
import { LINKS, TRACKING_MONTHS, factPart, funderOptionCards, meta } from '../../../components/pages/partners/partners';
import { BIGD_NAME, C14, EMPATHY, HEADLINE, POSITIONING, PROGRAM_SIZES_NOTE, SPEED, VALUE_PROPOSITION } from '../../../data/copy';
import { CLAIM_RC06 } from '../../../components/sections/copyText';
import { faqJsonLd } from '../../../lib/faq';
import { cta } from '../../../lib/mailto';
import { linkAttrs, url } from '../../../lib/url';
import { webPage } from '../../../lib/schema';

const PATH = '/partner-with-us/foundations/';
const primary = cta('funding');
// WP27: the two funding routes each get a text link with its own prefilled subject, under the one primary button; WP30c: they sit under the two-route comparison.
const routeYouthwide = cta('fundingYouthwide');
const routePlatform = cta('fundingPlatform');
// WP37: the Funding Route 2 passage under the offer cards links the same inquiry as the comparison above it.
const platformInquiry = linkAttrs(routePlatform.href);
// The partner-edition report request (doc 04 §7), straight from the shared CTA library.
const reportCta = cta('report');
const report = { label: reportCta.label, href: reportCta.href };

const { title, description } = meta(
  'Fund Youth Employment: Foundations and CSR',
  `Fund a supported path to earnings. A randomized trial of a predecessor program found women offered a place had an estimated ${factPart('RC-04', /\+(\$\d+) a month/)} higher monthly income.`,
);

// Q8-route and Q9-route: the one-line cost and safeguarding answers, each with a link to where the full answer lives (the partner hub FAQ, the governance page) (WP36).
const FAQ_IDS = ['Q3', 'Q8-route', 'Q9-route', 'Q10'];
const sixMonth = factPart('PD-09', /surveys at \d+, (\d+) and \d+ months/);
---

<LandingLayout
  title={title}
  description={description}
  path={PATH}
  breadcrumbs={[{ label: 'Partner with Us', href: LINKS.hub }, { label: 'Foundations and CSR' }]}
  jsonLd={[webPage({ path: PATH, name: title, description }), faqJsonLd('foundations', PATH, FAQ_IDS)]}
  stickyCta={{ label: primary.label, href: primary.href }}
>
  <!-- C1 · Identity hook -->
  <HeroBand
    audience="For Foundations and CSR Leaders"
    title={HEADLINE.foundations}
    lead={VALUE_PROPOSITION.foundations}
    cta={{ label: primary.label, href: primary.href }}
    artSeed="partners-foundations"
  />
  <!-- GEO · What is CodersTrust? -->
  <DefinitionBand />
  <PartnerGlance
    lead={[{ id: 'RC-04', href: '/impact/independent-evaluation/' }, { id: 'OC-03', href: '/impact/outcomes-2026/' }, { id: 'PR-02', href: '/impact/case-studies/kosovo-women-in-online-work/' }]}
    more={[{ id: 'RC-02', href: '/impact/independent-evaluation/' }]}
  />
  <LearnerVoice story="samina-tasneem-chowdhury" excerpt="She has completed 90+ projects on Fiverr so far." program="WSDFM" tone="white" />

  <!-- C2 · Problem -->
  <ProblemBand
    title="Grants Buy Hours. You Want Earnings"
    bluf="You want to know what your grant changed, not only how many hours it paid for."
    factIds={[]}
  >
    <GainsPains
      slot="lead"
      pains={[
        { q: 'Grants buy training hours, but rarely earnings', text: 'Attendance is easy to count; a change in income is harder to show.' },
        { q: 'Independent evidence is hard to find', text: 'Independent evidence on youth-employment programs is thin.' },
        { q: 'Scalable, accountable implementers are hard to find' },
      ]}
    />
  </ProblemBand>

  <!-- C3 · Agitation -->
  <div class="pp-two">
    <CostSection
      title="Every Year of Delay Leaves a Cohort Without a Route to Work"
      transition="It doesn’t have to be this way."
      blocks={[
        { claim: 'Educated Young People Are Waiting', factId: 'PX-01', implication: 'Every year of delay is a cohort without a path.' },
        { claim: CLAIM_RC06, factId: 'RC-06', implication: 'Look for programs that build in placement, tracking and evaluation.' },
      ]}
    />
  </div>

  <!-- C5 · Guide (empathy first). WP31: credibility comes before the vision, as on Home. -->
  <PartnerGuideBand
    empathy={EMPATHY.foundations}
    statements={[
      { facts: ['PR-01', 'RC-01'], markers: ['RC-01'], text: `The ${BIGD_NAME} separately evaluated the predecessor WSDFM program, commissioned by Porticus, in a randomized trial.` },
    ]}
    method={{ text: 'Our TalentLEAP method organizes skills into career paths with progressive levels.', link: { label: 'How TalentLEAP Works', href: LINKS.talentleap } }}
    partnerGroup="development"
  />

  <!-- C4 · Future state -->
  <FutureBand
    photos={futurePhotos('partners-foundations')}
    title="What a Funded Cohort Could Show"
    lead="Illustrative, not case studies."
    vignettes={[
      { kind: 'Functional', title: 'Monthly Reports from Cohort One', text: 'Enrollment, certification, placements and first earnings arrive in your monthly reports.' },
      { kind: 'Emotional', title: 'Who Started Earning', text: `The ${sixMonth}-month follow-up survey shows who started earning, from jobs, freelance clients and businesses of their own.` },
      { kind: 'Social', title: 'Results by Group', text: 'Women’s and priority-group shares are reported alongside the headline results.' },
    ]}
  />

  <!-- C6 · Mechanism (two funding routes). WP25s: one chooser, one naming scheme: Funding Route 1 (YouthWIDE Cohort Grants) and Funding Route 2 (JobReady Platform Grants), in the same order here, in the jump links and in the two offer bands below. -->
  <div class="pp-two">
    <MechanismBand
      title="Two Ways to Fund the Path"
      positioning={POSITIONING.foundations}
      diagram={false}
      moreLinks={[
        { label: 'See Funding Route 1', href: '#cohort-grants' },
        { label: 'See Funding Route 2', href: '#platform-grants' },
      ]}
      link={{ label: 'About the JobReady Platform', href: LINKS.platform }}
    >
      <!-- WP29 (benchmark review): the two routes as a two-row comparison (What It Supports, Evidence Relationship), in place of the two route cards. Their sentences moved into it; nothing was added. -->
      <!-- WP30c (cycle-7 IA review): the two inquiry links sit directly under the comparison they belong to, not in the hero before the routes are explained. -->
      <FundingRoutes inquiries={[routeYouthwide, routePlatform]} />
    </MechanismBand>
  </div>

  <!-- C7 · Proof: the trial and survey results are the tiles above; this strip links the full evidence (WP35, cycle-12 review) -->
  <PairedEvidence
    id="proof-band"
    eyebrow="The Evidence"
    title="See the Evidence Behind the Results"
    items={[]}
    broader={[
      { label: 'Read the Trial Results', href: LINKS.trial },
      { label: 'Impact Survey 2026', href: LINKS.outcomes },
    ]}
    broaderLabel="The evidence behind the results"
  />
  <CaseStudyCarousel
    title="Proof in Practice"
    items={[
      { title: 'Women’s Skill Development for Freelancing Marketplace (WSDFM)', program: 'Commissioned by Porticus', factId: 'PR-01', href: LINKS.caseWsdfm },
      { title: 'Her Power', program: 'ICT Division / Department of ICT (DoICT)', factId: 'PR-05', href: LINKS.caseHerPower },
    ]}
  />

  <!-- C8 · Features to benefits -->
  <FeaturesTable
    title="What Your Cohort Grant Gets"
    concernLabel="Funder Concern Addressed"
    rows={[
      {
        feature: `Mentoring, Placement Support and Outcome Tracking for ${TRACKING_MONTHS} Months, in the Standard Inclusions`,
        means: 'Results are measured against first paid work, not attendance, using the agreed scorecard.',
        outcome: 'A grant measured against first paid work',
        relieves: 'Grants buy hours, rarely earnings',
      },
      {
        feature: 'A randomized trial by BIGD on the predecessor WSDFM program',
        means: 'Independent evaluation of your cohort is welcome.',
        outcome: 'Independent evidence on the predecessor program',
        relieves: 'Independent evidence is thin',
      },
      {
        feature: 'Monthly reports, a quarterly steering review and a pilot scorecard; contracting entity and due-diligence documents confirmed in co-design',
        means: 'You see progress monthly, know who you are contracting with, and can decide expansion on evidence.',
        outcome: 'Progress you can see every month',
        relieves: 'Accountable implementers are hard to find',
      },
      {
        feature: 'SDG-Mapped Reporting Tailored to Your CSR Framework and Co-Branded Certificates and Events, Where Agreed in the Program Scope',
        means: 'Reporting that fits your framework.',
        outcome: 'Reports mapped to the SDGs',
      },
    ]}
  />

  <!-- C9 · Objections -->
  <FAQBand
    audience="foundations"
    ids={FAQ_IDS}
    title="Questions About Cohort Grants"
    allLink={{ label: 'Safeguarding, Governance and Due Diligence', href: LINKS.governance }}
  />

  <!-- C10 · Differentiation: the positioning statement opens C6; the comparison table is on Home and Investors only (WP30c). -->

  <!-- C11 · Offer -->
  <OfferCards
    id="cohort-grants"
    eyebrow="Funding Route 1 · YouthWIDE Cohort Grants"
    title="Choose Where to Start Your Cohort Grant"
    lead={`${PROGRAM_SIZES_NOTE} Pricing is set per program, and we share an indicative budget in the discovery session. Prefer to fund the platform? See JobReady Platform Grants below.`}
    cards={funderOptionCards()}
    recommended={0}
  />
  <SubBand tone="airy" pull id="platform-grants">
    <Callout eyebrow="Funding Route 2 · JobReady Platform Grants">
      <p data-fact="IN-04">A platform grant supports JobReady’s infrastructure and staged rollout, not cohorts.</p>
      <p>
        <a class="link" href={platformInquiry.href}>
          {routePlatform.label}
          {platformInquiry.srText && <span class="sr-only"> {platformInquiry.srText}</span>}
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </Callout>
    <Callout eyebrow="Accountability"><p data-fact="PD-11">For cohort grants, every pilot is judged on cost per completer and per verified outcome, with thresholds agreed with you before the first cohort starts.</p></Callout>
  </SubBand>

  <!-- C12 · Risk reversal (immediately before C13): the full reporting and review cycle lives on the partnership overview; WP34 (cycle-11 review): the four diligence cards repeated what this page's bands state, so one item and a link stand in -->
  <DueDiligenceView brief id="due-diligence" />
  <SubBand>
    <Callout eyebrow="Reporting and Review">
      <p>Monthly reports and quarterly reviews are set out once, on the partnership overview.</p>
      <a class="link" href={url('/partner-with-us/#review-cycle')}>See Reporting and Review<Icon name="arrow-right" size={16} /></a>
    </Callout>
  </SubBand>

  <!-- C13 · Call to action -->
  <CTABand
    id="cta"
    heading="Let’s Explore a Funding Partnership"
    cta={{ label: primary.label, href: primary.href }}
    secondary={report}
    urgency={SPEED.text}
  >
    <!-- WP34 (cycle-11 review): the funders here choose a cohort grant or a platform grant, so the line says what is discussed for each (the cohort-only discovery-session agenda is on the pages that sell cohorts). It is said once; the band below does not repeat it. -->
    <SessionAgenda lead="foundations" />
  </CTABand>

  <!-- C14 · Next steps -->
  <!-- WP32 (cycle-9 review): the two funding routes do not share one process, so the band shows no week-by-week steps. A cohort grant's timing (6–8 weeks after signing) stays in the C13 urgency line above, where it
       is labeled as grant-funded pilot timing. WP34 (cycle-11 review): what is discussed for each route is said once, in the C13 band above, so this band keeps only the introductory-call line. -->
  <NextStepsBand title="What Happens After You Say Yes" lead="Details of what the grant delivers are discussed in the introductory call." stepless />
  <Reinforcement logos={false} reminder={false} validate={C14.validateFor.foundations} />

  <PageEnhancements />
</LandingLayout>
