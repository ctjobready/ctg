---
/**
 * P5 Foundations and CSR: /partner-with-us/foundations/ (T3, implements doc 04 matrix 4.3).
 * C1 to C14 in order, as the numbered table in doc 06 P5.
 */
import PartnerGlance from '../../../components/pages/partners/PartnerGlance.astro';
import DueDiligenceView from '../../../components/pages/hub/DueDiligenceView.astro';
import CategoryCard from '../../../components/system/CategoryCard.astro';
import InShort from '../../../components/pages/partners/InShort.astro';
import LearnerVoice from '../../../components/pages/impact/LearnerVoice.astro';
import ReviewCycle from '../../../components/pages/hub/ReviewCycle.astro';
import LandingLayout from '../../../layouts/LandingLayout.astro';
import HeroBand from '../../../components/sections/HeroBand.astro';
import DefinitionBand from '../../../components/sections/DefinitionBand.astro';
import ProblemBand from '../../../components/sections/ProblemBand.astro';
import CostSection from '../../../components/pages/programs/CostSection.astro';
import FutureBand from '../../../components/sections/FutureBand.astro';
import { futurePhotos } from '../../../data/photos';
import MechanismBand from '../../../components/sections/MechanismBand.astro';
import ProofBand from '../../../components/sections/ProofBand.astro';
import CaseStudyCarousel from '../../../components/sections/CaseStudyCarousel.astro';
import FeaturesTable from '../../../components/sections/FeaturesTable.astro';
import FAQBand from '../../../components/sections/FAQBand.astro';
import ComparisonBand from '../../../components/sections/ComparisonBand.astro';
import OfferBand from '../../../components/sections/OfferBand.astro';
import NextStepsBand from '../../../components/sections/NextStepsBand.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import SessionAgenda from '../../../components/ui/SessionAgenda.astro';
import Fact from '../../../components/facts/Fact.astro';
import Section from '../../../components/ui/Section.astro';
import Icon from '../../../components/system/Icon.astro';
import Badge from '../../../components/system/Badge.astro';
import GainsPains from '../../../components/pages/partners/GainsPains.astro';
import PartnerGuideBand from '../../../components/pages/partners/PartnerGuideBand.astro';
import SubBand from '../../../components/pages/partners/SubBand.astro';
import Callout from '../../../components/pages/partners/Callout.astro';
import CopyText from '../../../components/pages/partners/CopyText.astro';
import EvidenceList from '../../../components/pages/partners/EvidenceList.astro';
import FitBrief from '../../../components/pages/partners/FitBrief.astro';
import HowItWorks from '../../../components/pages/partners/HowItWorks.astro';
import ForNotFor from '../../../components/pages/partners/ForNotFor.astro';
import Reinforcement from '../../../components/pages/partners/Reinforcement.astro';
import PageEnhancements from '../../../components/pages/partners/PageEnhancements.astro';
import { LINKS, TRACKING_MONTHS, factPart, meta } from '../../../components/pages/partners/partners';
import { ACCOUNTABILITY, C14, EMPATHY, HEADLINE, POSITIONING, SPEED, STEPS, VALUE_PROPOSITION } from '../../../data/copy';
import { fact } from '../../../data/facts';
import { CLAIM_PX06, CLAIM_RC06, endSentence } from '../../../components/sections/copyText';
import { faqJsonLd } from '../../../lib/faq';
import { cta } from '../../../lib/mailto';
import { webPage } from '../../../lib/schema';

const PATH = '/partner-with-us/foundations/';
const primary = cta('funding');
// The partner-edition report request (doc 04 §7), straight from the shared CTA library.
const reportCta = cta('report');
const report = { label: reportCta.label, href: reportCta.href };

const { title, description } = meta(
  'Fund Youth Employment: Foundations and CSR',
  `Fund a supported path from learning to earning. A BIGD trial of a predecessor program: women offered a place had an estimated ${factPart('RC-04', /\+(\$\d+) a month/)} higher monthly income`,
);

const FAQ_IDS = ['Q2', 'Q3', 'Q4', 'Q8', 'Q9', 'Q10'];
// PD-18 names SDG-mapped reporting and co-branded certificates and events; neither is in the standard inclusions (PD-02), so they are part of a funder's program only where the scope agrees them (WP21).
// WP24a: scope-aware and without the "pipeline" wording: the SDG-mapped reporting and the co-branded items are part of a funder's program only where the scope agrees them,
// and what a funder gains is reporting on how the funded cohort progressed into work.
const pd18 = endSentence(fact('PD-18').text)
  .replace(/^What funders gain: /, 'Funders receive ')
  .replace('SDG-mapped reporting tailored to their CSR framework, co-branded certificates and events, and a pipeline of job-ready talent', 'SDG-mapped reporting tailored to their CSR framework and co-branded certificates and events, where agreed in the program scope, and reporting that shows how the funded cohort progressed into work');
if (!pd18.includes('where agreed in the program scope') || !pd18.includes('how the funded cohort progressed into work')) throw new Error('Foundations: PD-18 wording changed; update the scope-aware rewrite');
const sixMonth = factPart('PD-09', /surveys at \d+, (\d+) and \d+ months/);
---

<LandingLayout
  title={title}
  description={description}
  path={PATH}
  breadcrumbs={[{ label: 'Partner with Us', href: LINKS.hub }, { label: 'Foundations and CSR' }]}
  jsonLd={[webPage({ path: PATH, name: title, description }), faqJsonLd('foundations', PATH, FAQ_IDS)]}
  stickyCta={{ label: primary.label, href: primary.href }}
>
  <!-- C1 · Identity hook -->
  <HeroBand
    audience="For Foundations and CSR Leaders"
    title={HEADLINE.foundations}
    lead={VALUE_PROPOSITION.foundations}
    cta={{ label: primary.label, href: primary.href }}
    artSeed="partners-foundations"
  />
  <InShort
    bullets={[
      'Fund a supported path from learning to earning: training with certification preparation, mentoring and placement support.',
      'Independent evidence: a randomized trial of a predecessor program, shown apart from survey results among completers.',
      'Reporting that fits your framework: monthly reports, a quarterly steering review and, where agreed in the program scope, SDG-mapped reporting.',
      'Two ways to fund: YouthWIDE Cohort Grants or JobReady Platform Grants. Expansion is always your decision.',
    ]}
    links={[
      { label: 'How It Works', href: '#mechanism' },
      { label: 'Evidence', href: '#proof-band' },
      { label: 'What You Receive', href: '#features' },
      { label: 'Options', href: '#cohort-grants' },
      { label: 'Next Steps', href: '#next-steps' },
    ]}
  />
  <!-- GEO · What is CodersTrust? -->
  <DefinitionBand />
  <ForNotFor
    forText="You want to fund outcomes you can see."
    notText="You want a one-off donation with no reporting."
  />
  <PartnerGlance
    lead={[{ id: 'RC-04', href: '/impact/independent-evaluation/' }, { id: 'OC-03', href: '/impact/outcomes-2026/' }, { id: 'PR-01', href: '/impact/case-studies/wsdfm-women-freelancers/' }]}
    more={[
      { id: 'RC-02', href: '/impact/independent-evaluation/' },
      { id: 'RC-13', href: '/impact/independent-evaluation/' },
      { id: 'RC-06a', href: '/impact/independent-evaluation/' },
      { id: 'OC-01', href: '/impact/outcomes-2026/' },
      { id: 'PR-02', href: '/impact/case-studies/kosovo-women-in-online-work/' },
      { id: 'PR-03', href: '/impact/case-studies/undp-yes-korail/' },
    ]}
  />
  <LearnerVoice story="samina-tasneem-chowdhury" excerpt="She has completed 90+ projects on Fiverr so far." program="WSDFM" tone="white" />

  <!-- C2 · Problem -->
  <ProblemBand
    title="Grants Buy Hours. You Want Earnings"
    bluf="You want to know what your grant changed, not only how many hours it paid for."
    factIds={[]}
  >
    <GainsPains
      slot="lead"
      gains={['Documented outcomes for your grant', 'Confidence in the implementer', 'Reporting that fits your framework']}
      pains={[
        { q: 'Why do grants buy training hours, but rarely earnings?', text: 'Attendance is easy to count; a change in income is harder to show.' },
        { q: 'Where is the independent evidence?', text: 'Independent evidence on youth-employment programs is thin.' },
        { q: 'Who can you trust to implement and report?', text: 'Scalable, accountable implementers are hard to find.' },
      ]}
    />
  </ProblemBand>

  <!-- C3 · Agitation -->
  <div class="pp-two">
    <CostSection
      title="Every Year of Delay Leaves a Cohort Without a Route to Work"
      transition="It doesn’t have to be this way."
      blocks={[
        { claim: 'AI Is Reshaping Entry Work', factId: 'PX-07', scope: 'Globally', implication: 'Programs have to track where entry-level work is going.' },
        { claim: CLAIM_PX06, factId: 'PX-06', implication: 'Tracks chosen from current employer demand keep pace.' },
        { claim: 'Educated Young People Are Waiting', factId: 'PX-01', implication: 'Every year of delay is a cohort without a path.' },
        { claim: CLAIM_RC06, factId: 'RC-06', implication: 'Look for programs that build in placement, tracking and evaluation.' },
      ]}
    />
  </div>

  <!-- C4 · Future state -->
  <FutureBand
    photos={futurePhotos('partners-foundations')}
    title="What a Funded Cohort Could Show"
    lead="Illustrative, not case studies."
    vignettes={[
      { kind: 'Functional', title: 'Monthly Reports from Cohort One', text: 'Enrollment, certification, placements and first earnings arrive in your monthly reports.' },
      { kind: 'Emotional', title: 'Who Started Earning', text: `The ${sixMonth}-month tracer shows who started earning, from jobs, freelance clients and businesses of their own.` },
      { kind: 'Social', title: 'Results by Group', text: 'Women’s and priority-group shares are reported alongside the headline results.' },
    ]}
  />

  <!-- C5 · Guide (empathy first) -->
  <PartnerGuideBand
    empathy={EMPATHY.foundations}
    statements={[
      { facts: ['PR-01', 'RC-01'], markers: ['RC-01'], text: 'BIGD separately evaluated the predecessor WSDFM program, commissioned by Porticus, in a randomized trial.' },
    ]}
    method={{ text: 'Our TalentLEAP method organizes skills into career paths with progressive levels.', link: { label: 'How TalentLEAP Works', href: LINKS.talentleap } }}
    partnerGroup="development"
  />

  <!-- C6 · Mechanism (two funding vehicles) -->
  <div class="pp-two">
    <MechanismBand
      title="Two Ways to Fund the Path"
      positioning={POSITIONING.foundations}
      blocks={[
        { label: 'Funding Vehicle 1', title: 'JobReady Platform Grant', text: 'A grant toward platform infrastructure, not toward cohorts. The outcome evidence on this page comes from the youth programs, not from the platform. Live today: partner portals, marketing automation, CRM and AI chat. In pre-launch: the employer and gig-work (Earn) marketplace.', icon: 'layers' },
        { label: 'Funding Vehicle 2', title: 'YouthWIDE Cohort Grants', text: 'Co-fundable country programs designed for South Asia, MENA and Sub-Saharan Africa; current outcome evidence comes from Bangladesh and Kosovo.', icon: 'globe' },
      ]}
      link={{ label: 'About the JobReady Platform', href: LINKS.platform }}
    />
  </div>
  <Section id="route-chooser" pad="sm" aria-labelledby="route-h">
    <h2 class="rc__title" id="route-h">Choose Your Route</h2>
    <div class="grid-cards grid-cards--2">
      <CategoryCard title="YouthWIDE Cohort Grants" icon="globe" text="Co-fund country programs, cohort by cohort." href="#cohort-grants" />
      <CategoryCard title="JobReady Platform Grants" icon="layers" text="Fund platform infrastructure, not cohorts." href="#platform-grants" />
    </div>
  </Section>
  <SubBand>
    <Callout eyebrow="Reporting and Recognition">
      <p data-fact="PD-18">{pd18}</p>
      <ul class="cluster" role="list" data-fact="ID-09">
        <li><Badge tone="eyebrow">SDG 4: Quality Education</Badge></li>
        <li><Badge tone="eyebrow">SDG 5: Gender Equality</Badge></li>
        <li><Badge tone="eyebrow">SDG 8: Decent Work and Economic Growth</Badge></li>
      </ul>
    </Callout>
  </SubBand>

  <!-- C7 · Proof -->
  <ProofBand
    title="Independent Evidence and Survey Results"
    headlineFact="RC-01"
    statIds={['RC-02', 'RC-03']}
    chartId="OC-01"
    links={[
      { label: 'The Randomized Trial', href: LINKS.trial },
      { label: 'Outcomes 2026', href: LINKS.outcomes },
      { label: 'Conducting Due Diligence? See Our Governance and Evidence', href: LINKS.governance },
    ]}
  >
    <EvidenceList heading="More from the Trial, and from Surveyed Completers" items={[{ facts: ['RC-05'] }, { facts: ['OC-03'] }]} />
    <FitBrief />
  </ProofBand>
  <CaseStudyCarousel
    title="Program Results, with the Case Studies Behind Them"
    items={[
      { title: 'Women’s Skill Development for Freelancing Marketplace (WSDFM)', program: 'Commissioned by Porticus', factId: 'PR-01', href: LINKS.caseWsdfm },
      { title: 'Her Power', program: 'ICT Division / Department of ICT (DoICT)', factId: 'PR-05', href: LINKS.caseHerPower },
    ]}
  />

  <!-- C8 · Features to benefits -->
  <FeaturesTable
    title="What You Get, and What It Means for Your Grant"
    concernLabel="Funder Concern Addressed"
    rows={[
      {
        feature: `Mentoring, Placement Support and Outcome Tracking for ${TRACKING_MONTHS} Months, in the Standard Inclusions`,
        means: 'results are measured against first paid work, not attendance, using the agreed scorecard.',
        outcome: 'A grant followed through to first paid work',
        relieves: 'Grants buy hours, rarely earnings',
      },
      {
        feature: 'A randomized trial by BIGD on WSDFM; independent evaluation welcome on new programs',
        means: 'you can fund a model with independent evidence and add your own evaluation.',
        outcome: 'Independent evidence on a CodersTrust program',
        relieves: 'Independent evidence is thin',
      },
      {
        feature: 'Monthly reports, a quarterly steering review and a pilot scorecard; contracting entity and due-diligence documents confirmed in co-design',
        means: 'you see progress monthly, know who you are contracting with, and can decide expansion on evidence.',
        outcome: 'Progress you can see every month',
        relieves: 'Accountable implementers are hard to find',
      },
      {
        feature: 'SDG-Mapped Reporting Tailored to Your CSR Framework and Co-Branded Certificates and Events, Where Agreed in the Program Scope',
        means: 'reporting that fits your framework.',
        outcome: 'Reports mapped to the SDGs',
      },
    ]}
  />
  <HowItWorks steps={STEPS} />

  <!-- C9 · Objections -->
  <FAQBand
    audience="foundations"
    ids={FAQ_IDS}
    title="Questions Funders Ask"
    allLink={{ label: 'Safeguarding, Governance and Due Diligence', href: LINKS.governance }}
  />

  <!-- C10 · Differentiation -->
  <ComparisonBand
    title="Compare the Approaches"
    lead="A supported cohort pairs independent evidence on our own training with preparation for a recognized credential built into each track. Provision varies by provider and program."
  />

  <!-- C11 · Offer -->
  <OfferBand id="cohort-grants" eyebrow="Track 1 · YouthWIDE Cohort Grants" title="Choose a YouthWIDE Cohort Grants Starting Point" lead="Pricing is set per program, and we share an indicative budget in the discovery session. Prefer to fund the platform? See JobReady Platform Grants below." />
  <SubBand tone="airy" pull id="platform-grants">
    <Callout eyebrow="Track 2 · JobReady Platform Grants, an Alternative Funding Vehicle"><Fact id="IN-04" as="p" /><p>Details of what a platform grant delivers are discussed in the introduction call.</p></Callout>
    <Callout eyebrow="Accountability"><p data-fact="PD-11">For cohort grants, every pilot is judged on cost per completer and per verified outcome, with thresholds agreed with you before the first cohort starts. Platform-grant details are discussed in the introduction call.</p></Callout>
  </SubBand>

  <!-- C12 · Risk reversal (immediately before C13) -->
  <ReviewCycle scorecard />
  <DueDiligenceView compact id="due-diligence" />

  <!-- C13 · Call to action -->
  <CTABand
    id="cta"
    heading="Let’s Explore a Funding Partnership"
    cta={{ label: primary.label, href: primary.href }}
    secondary={report}
    urgency={SPEED.text}
  >
    <SessionAgenda />
  </CTABand>

  <!-- C14 · Next steps -->
  <!-- The 6–8 week statement appears twice on this page: in the C13 urgency line and in the C14 "First cohort" step (doc 04 §4). -->
  <NextStepsBand title="What Happens After You Say Yes" lead="Cohort grants follow these steps. A platform grant starts with the introduction call." timing={false} />
  <Reinforcement logos={false} reminder={false} validate={C14.validateFor.foundations} />

  <PageEnhancements />
</LandingLayout>

<style>
  .rc__title {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-heading-l);
    color: var(--secondary);
  }
</style>
