---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import HeroBand from '../../../components/sections/HeroBand.astro';
import ProblemBand from '../../../components/sections/ProblemBand.astro';
import GuideBand from '../../../components/sections/GuideBand.astro';
import CaseStudyCarousel from '../../../components/sections/CaseStudyCarousel.astro';
import IncludesBand from '../../../components/sections/IncludesBand.astro';
import FAQBand from '../../../components/sections/FAQBand.astro';
import RiskReversalBand from '../../../components/sections/RiskReversalBand.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import FeatureCard from '../../../components/ui/FeatureCard.astro';
import StepFlow from '../../../components/ui/StepFlow.astro';
import DefinitionPlus from '../../../components/pages/about/DefinitionPlus.astro';
import HomeMechanism from '../../../components/pages/home/HomeMechanism.astro';
import DueDiligenceView from '../../../components/pages/hub/DueDiligenceView.astro';
import LearnerVoice from '../../../components/pages/impact/LearnerVoice.astro';
import GainsPains from '../../../components/pages/partners/GainsPains.astro';
import PairedEvidence from '../../../components/pages/partners/PairedEvidence.astro';
import { LINKS } from '../../../components/pages/partners/partners';
import { localCta } from '../../../components/pages/about/routes';
import { LOCAL_PARTNER_EVIDENCE, LOCAL_PARTNER_PAINS, HEADLINE, MICRO_COMMITMENT, NEXT_STEPS_TITLE, POSITIONING, VALUE_PROPOSITION, painForList, painForRow } from '../../../data/copy';
import { faqJsonLd } from '../../../lib/faq';
import { webPage } from '../../../lib/schema';
import { BANGLADESH_HQ } from '../../../lib/site';

/**
 * Local Partners in Bangladesh (T3). WP30c (owner direction 2026-10-14, "less is more"): every CMF band stays, each states its point once. Gone: the In Short summary, the fit
 * check, the lab-access paragraph, the planned third-gender program sentence, the page-local copy of the comparison table (the shared one now has the corrected
 * rows), the restated three-step list and the second timing reminder. The H1 names the outcome; the page stays Bangladesh-specific because its audience is.
 * WP39 (cycle-16 review): "What Your Community Gets" is three short cards (IncludesBand), one for each ranked pain, not the concern / inclusion / benefit matrix.
 * WP42 (cycle-19 review): the full trial-and-survey band (the +41% and +54% income results, the 52.8% / 63.1% employment chart and its table, the survey chart and the median income) is a light strip, "Evidence from Our Wider
 * Youth Programs", as on Universities (WP38): one line for the trial, one for the survey's employment readings, and the two evidence links; the program-result cards stay. The strip keeps the band's anchor (#proof).
 * WP47 (owner decision 2026-10-15): the page opens with its own proof and goes straight to its offer. The Cost of Waiting band ("Cohorts That Train Without Placement Cost Community Trust", #cost) and the Imagine band
 * ("Imagine a Cohort in Your Community", #future) are gone; Home carries the shared versions. Nothing on this page depended on them (no link or gate pointed at either anchor): the placement, reporting and local-capacity claims
 * are in the problem band, "How a Local Partnership Works" and "What Your Community Gets".
 * WP48 (cycle-23 review): the definition block says the central-coordination arrangement as a design, as Our Model does ("Larger programs are designed to run through certified local facilitators ... coordinated centrally."), and the
 * support CodersTrust Bangladesh gives local partners is its own sentence.
 * WP49 (cycle-24 review): the comparison with national programs ("reach the young people national programs miss") was stated three times without a source, so it is gone from the problem heading ("Connect Your Community to Paid Digital Work"),
 * from the track-record band (its opening line is gone; the paragraph after it already names the Bangladesh team) and from the third partnership option ("Mobilize priority groups in your community, ..."); the problem band's lead names its subject
 * ("Local organizations often lack ...") because the heading no longer does; the steps band is "What Happens Next".
 * WP50 (cycle-25 review): the problem band's lead is "Connect your community reach with CodersTrust’s curriculum, mentoring, placement support and reporting." (it was "Local organizations often lack the curriculum, certification and placement links
 * to finish the job, and training is still measured by enrollment, not earnings.").
 * WP51 (cycle-26 review): Samina's excerpt is the story's own sentence about what she did, not generic praise ("Today, she is an inspiration to the young people in her community."): "During the training period, she began offering her services as
 * a graphic designer on the freelance marketplace Fiverr." LearnerVoice requires a verbatim passage of the story file, so the reviewer's shorter wording could not be used as written.
 * WP52 (cycle-27 review): the "Certified Facilitators and a Local Curriculum" card scopes what stays after funding ends ("Where included in the program scope, trained facilitators and localized curricula remain after funding ends, ..."; it said "Local capacity
 * stays after a funded cohort ends, ..."), as the "What Happens When Funding Ends?" answer does; the "Monthly Reporting" block says what the monthly reports cover and scopes them ("Where a funder is involved, monthly reports cover enrollment, completion,
 * certification, placements and first earnings, as agreed in the program scope."; it said the funder "sees" these "every month", which read as if each outcome happened monthly).
 * WP53 (owner follow-up, 2026-10-16): the "Supply Certified Facilitators" card scopes its promise as the "What Your Community Gets" card does: "... so delivery capacity can stay in your community where the program scope includes it." (it said "stays").
 * WP52 (cycle-27 review, Claude P4): the problem band's lead is "Pair your community reach with CodersTrust’s curriculum, mentoring, placement support and reporting." (it began "Connect your community reach with ...", the heading's own words).
 * WP60 (cycle-32 review, GPT-6.1 Sol G5): the "Certified Facilitators and a Local Curriculum" card no longer says what stays after funding ends (the "What Happens When Funding Ends?" answer on this page says it): "Certified-facilitator training, a localized curriculum and
 * preparation for industry certification. You do not have to build the curriculum or certification route yourself."
 */
const local = localCta();
// Q9-route: the one-line safeguarding answer with a link to the governance page, which keeps the full account (WP36).
const FAQ_IDS = ['Q1-local', 'Q9-route', 'Q10'];
const path = '/partner-with-us/local-partners/';
const description = 'Bangladeshi NGOs, colleges and chambers can deliver CodersTrust’s mentored digital-skills programs in their communities.';
const jsonLd = [
  webPage({ path, name: 'Local Implementing Partners', description, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Partner with Us', path: '/partner-with-us/' }, { name: 'Local Partners', path }] }),
  faqJsonLd('variants', path, FAQ_IDS),
];

const ways = [
  { icon: 'building-2', title: 'Host a Cohort', text: 'Open your labs or classrooms for blended training, so cohorts meet where young people already are.' },
  { icon: 'graduation-cap', title: 'Supply Certified Facilitators', text: 'Put trainers through certified facilitator training so delivery capacity can stay in your community where the program scope includes it.' },
  { icon: 'users', title: 'Mobilize Priority Groups', text: 'Reach the young people your community serves; women are a priority in every program.' },
];
---

<LandingLayout
  title="Local Implementing Partners"
  description={description}
  breadcrumbs={[{ label: 'Partner with Us', href: '/partner-with-us/' }, { label: 'Local Partners' }]}
  jsonLd={jsonLd}
  stickyCta={{ label: local.label, href: local.href }}
>
  <!-- C1 -->
  <HeroBand audience="For Bangladeshi NGOs, Colleges, Chambers and Associations" title={HEADLINE.localPartners} lead={VALUE_PROPOSITION.localPartners} cta={{ label: local.label, href: local.href }} artSeed="local-partners" />

  <!-- GEO definition + page BLUF (WP22: before the fit check, as on every other audience page) -->
  <DefinitionPlus id="definition">
    <p data-fact="PD-06 GV-09">Larger programs are designed to run through certified local facilitators in existing labs and colleges, coordinated centrally. CodersTrust Bangladesh supports local partners with curriculum, certification, mentoring, reporting and safeguarding.</p>
  </DefinitionPlus>

  <LearnerVoice story="samina-tasneem-chowdhury" excerpt="During the training period, she began offering her services as a graphic designer on the freelance marketplace Fiverr." program="WSDFM" tone="white" />

  <!-- C2 -->
  <ProblemBand id="problem" title="Connect Your Community to Paid Digital Work" bluf="Your organization reaches young people, but a curriculum, certification and links to paid work are hard to build alone." factIds={['PX-03']}>
    <GainsPains slot="lead" painsHeading="What Gets in the Way" pains={LOCAL_PARTNER_PAINS.map(painForList)} />
  </ProblemBand>

  <!-- C3 (Cost of Waiting) and C4 (Imagine) are left to Home since WP47 (owner decision 2026-10-15). -->

  <!-- C5 -->
  <div data-fact="ID-07 PA-01 PA-02 IN-06">
    <GuideBand
      id="guide"
      title="Delivered with a Bangladesh Team Beside You"
      authorityIds={['SC-11', 'GV-09']}
      partnerGroup={['government', 'development']}
      variant="grid"
      method={{
        text: `CodersTrust Bangladesh, our country office in ${BANGLADESH_HQ.city}, runs campuses in Mirpur and Agrabad, Chattogram. Our TalentLEAP method organizes skills into career paths.`,
        link: { label: 'How TalentLEAP Works', href: '/our-model/talentleap/' },
      }}
    />
  </div>

  <!-- C6: the light variant of the mechanism band (as on Home) -->
  <div data-fact="PD-01 PD-06 PD-07 PD-08">
    <HomeMechanism
      id="mechanism"
      tone="airy"
      title="How a Local Partnership Works"
      positioning={POSITIONING.localPartners}
      blocks={[
        { label: 'Your Organization', title: 'Mobilizes and Hosts', text: 'You reach young people and host cohorts in your labs, classrooms or centers.', icon: 'building-2' },
        { label: 'With CodersTrust', title: 'Trains and Prepares for Certification', text: 'Certified local facilitators, a localized curriculum and preparation for industry certification, delivered in blended classes.', icon: 'graduation-cap' },
        { label: 'Together', title: 'Mentoring and Placement', text: 'Three months of milestone-based mentoring, with placement support into local, remote and global work.', icon: 'handshake' },
        { label: 'Throughout', title: 'Monthly Reporting', text: 'Where a funder is involved, monthly reports cover enrollment, completion, certification, placements and first earnings, as agreed in the program scope.', icon: 'chart-bar' },
      ]}
      link={{ label: 'How Our Model Works', href: '/our-model/' }}
    />
  </div>

  <!-- C7 · Proof: the broader evidence from the youth programs, one line each for the trial and the survey (WP42, cycle-19 review; as Universities, WP38), in place of the full trial-and-survey band. The strip keeps the band's
       id (#proof) and sits on a white ground between the light mechanism band and the light program-result cards, so the rhythm is unchanged (there is no dark band on this page). -->
  <PairedEvidence
    id="proof"
    tone="white"
    eyebrow="The Evidence"
    title="Evidence from Our Wider Youth Programs"
    items={[]}
    statements={LOCAL_PARTNER_EVIDENCE}
    broader={[
      { label: 'The Randomized Trial', href: LINKS.trial },
      { label: 'Impact Survey 2026', href: LINKS.outcomes },
    ]}
    broaderLabel="Evidence from our wider youth programs"
  />
  <CaseStudyCarousel
    id="cases"
    title="Women-Focused Programs in Practice"
    items={[
      { title: 'Women’s Skill Development for Freelancing Marketplace (WSDFM)', program: 'Commissioned by Porticus', factId: 'PR-01', href: '/impact/case-studies/wsdfm-women-freelancers/' },
      { title: 'Her Power', program: 'ICT Division / Department of ICT (DoICT)', factId: 'PR-05', href: '/impact/case-studies/her-power/' },
    ]}
  />

  <!-- C8 (review round 14, M4): one card per ranked pain of C2, keyed to the C6 elements "Trains and certifies", "Mentoring and placement" and "Monthly reporting".
       WP39 (cycle-16 review): three short cards in place of the concern / inclusion / benefit matrix; each keeps its pain's id (`data-relieves`, held by scripts/check-facts.mjs) and its register facts, and its sentences keep
       the matrix rows' words (PD-06 and PD-02: certified local facilitators, a localized curriculum, preparation for industry certification; PD-01 and PD-15: mentoring with placement support alongside; PD-08: monthly reports). -->
  <IncludesBand
    id="features"
    title="What Your Community Gets"
    cards={[
      {
        painId: painForRow(LOCAL_PARTNER_PAINS, 'P1').painId,
        icon: 'graduation-cap',
        title: 'Certified Facilitators and a Local Curriculum',
        text: 'Certified-facilitator training, a localized curriculum and preparation for industry certification. You do not have to build the curriculum or certification route yourself.',
        facts: ['PD-06', 'PD-02'],
      },
      {
        painId: painForRow(LOCAL_PARTNER_PAINS, 'P2').painId,
        icon: 'handshake',
        title: 'Mentoring and Placement Support',
        text: 'Three months of milestone-based mentoring, with placement support alongside, gives your completers a route into work that your organization does not have to build alone.',
        facts: ['PD-01', 'PD-15'],
      },
      {
        painId: painForRow(LOCAL_PARTNER_PAINS, 'P3').painId,
        icon: 'chart-bar',
        title: 'Monthly Reports and Program Updates',
        text: 'Where a funder is involved, it receives monthly reports as agreed in the program scope, and your organization receives agreed program updates on enrollment, completion, certification and placement.',
        facts: ['PD-08'],
      },
    ]}
  />

  <!-- C9 -->
  <FAQBand id="faq" audience="variants" ids={FAQ_IDS} title="Questions Local Partners Ask" />

  <!-- C10: the positioning statement opens C6; the comparison table is on Home and Investors only (WP30c). -->

  <!-- C11 -->
  <Section id="offer" tone="airy" aria-labelledby="offer-h">
    <SectionHeader id="offer-h" eyebrow="Ways to Partner" title="Three Ways to Partner with Us" lead="Choose one or combine them; how a partnership is funded is agreed in the first conversations." />
    <div class="grid-cards grid-cards--stretch" data-fact="PD-06 PD-05">
      {ways.map((w) => <FeatureCard icon={w.icon} title={w.title} text={w.text} />)}
    </div>
  </Section>

  <!-- C12. WP34 (cycle-11 review): the four diligence cards repeated what this page's bands state, so one item and a link stand in -->
  <DueDiligenceView brief id="due-diligence" />
  <RiskReversalBand
    id="risk"
    title="Start with a Pilot Cohort, Then Decide on Evidence"
    points={[
      { icon: 'chart-bar', title: 'Expansion Review on Real Results', text: 'Review early progress at three months; any expansion decision uses the scorecard measures available then.' },
      { icon: 'target', title: 'Scorecard Thresholds', text: 'Thresholds are agreed before the first cohort; a missed threshold triggers a corrective plan.' },
      { icon: 'handshake', title: 'Your Participation Is Your Decision', text: 'You choose whether and how far to take part.' },
      { icon: 'shield', title: 'Independent Evaluation Welcome', text: 'We support third-party evaluation of outcomes.' },
    ]}
  />

  <!-- C13 -->
  <CTABand
    id="cta"
    heading="Let’s Plan Your First Local Cohort"
    text="Tell the Bangladesh team about your organization, your district and the groups you work with."
    cta={{ label: local.label, href: local.href }}
    fallbackLabel="the Bangladesh team at"
    micro={MICRO_COMMITMENT}
  />

  <!-- C14 -->
  <Section id="next-steps" aria-labelledby="next-h">
    <SectionHeader id="next-h" eyebrow="After You Write" title={NEXT_STEPS_TITLE} />
    <StepFlow steps={[
      { title: 'Discovery Session', text: 'A conversation about your organization and the young people you reach.' },
      { title: 'Fit Check and Co-Design', text: 'We shape the cohort, tracks, safeguarding, reporting and the pilot scorecard with you.' },
      { title: 'Agreement', text: 'Scope, schedule and the pilot scorecard are agreed.' },
      { title: 'First Cohort', text: 'Training begins at your site.' },
    ]} />
    <p class="lp-after">In your inquiry, include two suitable times for a discovery session.</p>
  </Section>

</LandingLayout>

<style>
  .lp-after {
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--outline-variant);
    max-width: var(--measure);
  }
</style>
