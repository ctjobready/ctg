---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import HeroBand from '../../../components/sections/HeroBand.astro';
import ProblemBand from '../../../components/sections/ProblemBand.astro';
import CostBand from '../../../components/sections/CostBand.astro';
import FutureBand from '../../../components/sections/FutureBand.astro';
import { futurePhotos } from '../../../data/photos';
import GuideBand from '../../../components/sections/GuideBand.astro';
import ProofBand from '../../../components/sections/ProofBand.astro';
import CaseStudyCarousel from '../../../components/sections/CaseStudyCarousel.astro';
import FeaturesTable from '../../../components/sections/FeaturesTable.astro';
import FAQBand from '../../../components/sections/FAQBand.astro';
import ComparisonBand from '../../../components/sections/ComparisonBand.astro';
import RiskReversalBand from '../../../components/sections/RiskReversalBand.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import FeatureCard from '../../../components/ui/FeatureCard.astro';
import StepFlow from '../../../components/ui/StepFlow.astro';
import DefinitionPlus from '../../../components/pages/about/DefinitionPlus.astro';
import HomeMechanism from '../../../components/pages/home/HomeMechanism.astro';
import CopyBlock from '../../../components/pages/about/CopyBlock.astro';
import InShort from '../../../components/pages/partners/InShort.astro';
import DueDiligenceView from '../../../components/pages/hub/DueDiligenceView.astro';
import LearnerVoice from '../../../components/pages/impact/LearnerVoice.astro';
import ForNotFor from '../../../components/pages/partners/ForNotFor.astro';
import GainsPains from '../../../components/pages/partners/GainsPains.astro';
import { localCta } from '../../../components/pages/about/routes';
import { FIRST_COHORT_REMINDER, HOURS, TRACER_MONTHS } from '../../../components/pages/partners/partners';
import { C14, EMPATHY, HEADLINE, LOCAL_PARTNER_PAINS, MICRO_COMMITMENT, POSITIONING, VALUE_PROPOSITION, painForList, painForRow } from '../../../data/copy';
import { fact } from '../../../data/facts';
import { CLAIM_PX06, CLAIM_RC06 } from '../../../components/sections/copyText';
import { linkAttrs } from '../../../lib/url';
import { faqJsonLd } from '../../../lib/faq';
import { webPage } from '../../../lib/schema';
import { BANGLADESH_HQ } from '../../../lib/site';

const local = localCta();
const FAQ_IDS = ['Q1-local', 'Q9', 'Q10'];
const path = '/partner-with-us/local-partners/';
const description = 'Bangladeshi NGOs, colleges and chambers can deliver CodersTrust’s mentored digital-skills programs in their communities.';
// GV-07 in the third-gender program wording the register uses ("program ... to provide digital-skills training to 5,000 third-gender people").
const thirdGender = fact('GV-07').text.match(/[\d,]+ third-gender people/)?.[0];
if (!thirdGender) throw new Error('GV-07 no longer names the number of third-gender people');
const jsonLd = [
  webPage({ path, name: 'Local Implementing Partners', description, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Partner with Us', path: '/partner-with-us/' }, { name: 'Local Partners', path }] }),
  faqJsonLd('variants', path, FAQ_IDS),
];

// C10: the [CMP] table with the rows that apply to an organization choosing how to deliver; cells verbatim, no verdict icons for other approaches.
const cmpRows = [
  { label: 'Track Choice', cells: [{ text: 'Set from current employer demand; work-entry plan approved before enrollment', included: true }, 'Varies by program design', 'Learner chooses', 'Learner looks for work directly', 'No training'] },
  { label: 'Certification', cells: [{ text: 'Certification Exam Preparation (Exam Fee Included)', included: true }, 'Varies', 'Often sold separately', 'Varies by platform', 'No credential'] },
  { label: 'Mentoring', cells: [{ text: 'Three Months of Milestone-Based Mentoring', included: true }, 'Varies', 'Varies; often self-directed', 'Marketplace matching is the core service; additional support varies.', 'No mentoring'] },
  { label: 'Work Entry', cells: [{ text: 'Placement support into local, remote and global work', included: true }, 'Varies', 'Work-entry support depends on the provider and package.', 'Marketplace matching is the core service; additional support varies.', 'No new connections'] },
  { label: 'Outcome Tracking', cells: [{ text: 'Planned for every cohort: tracers at 3, 6 and 12 months; monthly reports' }, 'Varies', 'Reporting emphasis varies; check whether employment outcomes are included.', 'Platform activity', 'No tracking'] },
  {
    label: 'Independent Evidence',
    cells: [
      { text: 'Available: one randomized trial of a predecessor program (200 hours, women in Dhaka); independent evaluation of your cohort is welcome; where a program needs one, it is budgeted separately from the standard inclusions', factId: 'RC-01' },
      { text: 'Varies — a review of nine randomized trials of vocational training found only three with significant employment impacts', factId: 'RC-06' },
      'Varies',
      'Varies',
      'None',
    ],
  },
  { label: 'Cost', cells: ['Pricing set per program', 'Varies', 'Content-only access can cost less than a supported cohort; actual prices vary', 'Varies', 'No fee — but forgone earnings'] },
];

// C8d "How it works in three steps", written for a local partner (built from the page's own CTA, ways to partner and next steps).
const localSteps = [
  { title: 'Tell the Bangladesh Team', text: 'Describe your organization, your district and the groups you work with, and we shape the cohort, tracks, safeguarding and reporting together.' },
  { title: 'Host, Train and Mentor', text: `Certified local facilitators deliver the localized curriculum in your labs, classrooms or centers: ${HOURS} training hours per certification, then three months of milestone-based mentoring.` },
  { title: 'Place and Report', text: `Placement support into local, remote and global work, then tracer surveys at ${TRACER_MONTHS}.` },
];

const ways = [
  { icon: 'building-2', title: 'Host a Cohort', text: 'Open your labs or classrooms for blended training, so cohorts meet where young people already are.' },
  { icon: 'graduation-cap', title: 'Supply Certified Facilitators', text: 'Put trainers through certified facilitator training so delivery capacity stays in your community.' },
  { icon: 'users', title: 'Mobilize Priority Groups', text: 'Reach the young people national programs miss, with women a priority in every group.' },
];
---

<LandingLayout
  title="Local Implementing Partners"
  description={description}
  breadcrumbs={[{ label: 'Partner with Us', href: '/partner-with-us/' }, { label: 'Local Partners' }]}
  jsonLd={jsonLd}
  stickyCta={{ label: local.label, href: local.href }}
>
  <!-- C1 -->
  <HeroBand audience="For Bangladeshi NGOs, Colleges, Chambers and Associations" title={HEADLINE.localPartners} lead={VALUE_PROPOSITION.localPartners} cta={{ label: local.label, href: local.href }} artSeed="local-partners" />

  <InShort
    bullets={[
      'Delivery through certified local facilitators, in your own labs, classrooms or centers.',
      'Training, preparation for industry certification and three months of milestone-based mentoring, with placement support alongside.',
      'Where a funder is involved, monthly reports go to the funder; tracer surveys follow at 3, 6 and 12 months.',
      'Start with a pilot cohort; how far you take part is your decision.',
    ]}
    links={[
      { label: 'How It Works', href: '#mechanism' },
      { label: 'Evidence', href: '#proof' },
      { label: 'What You Receive', href: '#features' },
      { label: 'Ways to Partner', href: '#offer' },
      { label: 'Next Steps', href: '#next-steps' },
    ]}
  />
  <!-- GEO definition + page BLUF (WP22: before the fit check, as on every other audience page) -->
  <DefinitionPlus id="definition">
    <p data-fact="PD-06 GV-09">Larger programs run hub-and-spoke through certified local facilitators and existing labs and colleges, and CodersTrust Bangladesh supports local partners with curriculum, certification, mentoring, reporting and safeguarding.</p>
    <p data-fact="GV-09">Where government lab access is confirmed, cohorts can run in public digital labs; your organization can also host cohorts in its own labs, classrooms or centers.</p>
  </DefinitionPlus>
  <ForNotFor
    forText="You are a Bangladeshi NGO, college, chamber or association that reaches young people national programs miss."
    notText="Your organization works outside Bangladesh; see the Development Partners and Governments pages for other countries."
  />

  <LearnerVoice story="samina-tasneem-chowdhury" excerpt="Today, she is an inspiration to the young people in her community." program="WSDFM" tone="white" />

  <!-- C2 -->
  <ProblemBand id="problem" title="Local Organizations Reach the Young People National Programs Miss" bluf="They often lack the curriculum, certification and placement links to finish the job, and training is still measured by enrollment, not earnings." factIds={['PX-03', 'PX-05', 'IN-03']}>
    <GainsPains slot="lead" painsHeading="What Gets in the Way" pains={LOCAL_PARTNER_PAINS.map(painForList)} />
  </ProblemBand>

  <!-- C3 -->
  <CostBand
    id="cost"
    title="Cohorts That Train Without Placement Cost Community Trust"
    blocks={[
      { claim: CLAIM_PX06, factId: 'PX-06', implication: 'Skills that were enough last year may not open doors next year, so tracks have to follow current demand.' },
      { claim: CLAIM_RC06, factId: 'RC-06', implication: 'Placement and tracking have to be built into the program, not added afterward.' },
    ]}
  />

  <!-- C4 -->
  <FutureBand
    photos={futurePhotos('local-partners')}
    id="future"
    title="Imagine a Cohort in Your Community"
    lead="Illustrative, not case studies."
    vignettes={[
      { kind: 'Functional', title: 'A Cohort in Your Own Lab', text: 'A college computer lab or an NGO center runs a cohort led by certified local facilitators.' },
      { kind: 'Emotional', title: 'Reports That Show Earnings', text: 'Reports show who is earning, not only who completed.' },
      { kind: 'Social', title: 'Completers in Paid Digital Work', text: 'Young people from your district move into paid digital work, and the skills stay in the community.' },
    ]}
  />

  <!-- C5 -->
  <div data-fact="ID-07 PA-01 PA-02 IN-06 GV-07">
    <GuideBand
      id="guide"
      title="Delivered with a Bangladesh Team Beside You"
      empathy={EMPATHY.localPartners}
      authorityIds={['SC-11', 'GV-09']}
      partnerGroup={['government', 'development']}
      variant="grid"
      method={{
        text: `CodersTrust Bangladesh works from its headquarters in ${BANGLADESH_HQ.city} and campuses in Mirpur and Agrabad, Chattogram. ${C14.validate.text} A planned program with the Bangladesh Computer Council and Bandhu Welfare Society aims to train ${thirdGender}. Our TalentLEAP method organizes skills into career paths with progressive levels.`,
        link: { label: 'How TalentLEAP Works', href: '/our-model/talentleap/' },
      }}
    />
  </div>

  <!-- C6: the light variant of the mechanism band (as on Home), so it never touches the Klein proof band (C7) -->
  <div data-fact="PD-01 PD-06 PD-07 PD-08">
    <HomeMechanism
      id="mechanism"
      tone="airy"
      title="How a Local Partnership Works"
      positioning={POSITIONING.localPartners}
      blocks={[
        { label: 'Your Organization', title: 'Mobilizes and Hosts', text: 'You reach young people and host cohorts in your labs, classrooms or centers.', icon: 'building-2' },
        { label: 'With CodersTrust', title: 'Trains and Prepares for Certification', text: 'Certified local facilitators, a localized curriculum and preparation for industry certification, delivered in blended classes.', icon: 'graduation-cap' },
        { label: 'Together', title: 'Mentoring and Placement', text: 'Three months of milestone-based mentoring, with placement support alongside into local, remote and global work.', icon: 'handshake' },
        { label: 'Throughout', title: 'Monthly Reporting', text: 'Where a funder is involved, it sees enrollment, completion, certification, placements and first earnings every month.', icon: 'chart-bar' },
      ]}
      link={{ label: 'How Our Model Works', href: '/our-model/' }}
    />
  </div>

  <!-- C7 -->
  <ProofBand id="proof" title="Independent Evidence and Survey Results" headlineFact="RC-01" statIds={['RC-01', 'RC-02', 'OC-03']} links={[{ label: 'Outcomes 2026', href: '/impact/outcomes-2026/' }, { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' }]} />
  <CaseStudyCarousel
    id="cases"
    title="Women-Focused Programs in Practice"
    items={[
      { title: 'Women’s Skill Development for Freelancing Marketplace (WSDFM)', program: 'Commissioned by Porticus', factId: 'PR-01', href: '/impact/case-studies/wsdfm-women-freelancers/' },
      { title: 'Her Power', program: 'ICT Division / Department of ICT (DoICT)', factId: 'PR-05', href: '/impact/case-studies/her-power/' },
    ]}
  />

  <!-- C8 (review round 14, M4): one row per ranked pain of C2, keyed to the C6 elements "Trains and certifies", "Mentoring and placement" and "Monthly reporting"; then the gain creators -->
  <FeaturesTable
    id="features"
    title="What You Get, and What It Means for Your Community"
    rows={[
      {
        ...painForRow(LOCAL_PARTNER_PAINS, 'P1'),
        feature: 'Certified-Facilitator Training, a Localized Curriculum and Preparation for Industry Certification',
        means: 'local capacity that stays after a funded cohort ends, with a curriculum and a certification route you do not have to build yourself.',
        outcome: 'Certified facilitators from your community',
        facts: ['PD-06', 'PD-02'],
      },
      {
        ...painForRow(LOCAL_PARTNER_PAINS, 'P2'),
        feature: 'Three Months of Milestone-Based Mentoring, Then Placement Support into Local, Remote and Global Work',
        means: 'your completers get a route into work that your organization does not have to build alone.',
        outcome: 'Work-entry connections for your completers',
        facts: ['PD-01', 'PD-15'],
      },
      {
        ...painForRow(LOCAL_PARTNER_PAINS, 'P3'),
        feature: 'Monthly Reports to the Funder, Where One Is Involved',
        means: 'where a funder is involved, it receives monthly reports, and your organization receives agreed program updates on enrollment, completion, certification and placement.',
        outcome: 'Progress you and the funder can both see',
        facts: ['PD-08'],
      },
      { feature: 'Blended Delivery in Existing Labs and Colleges', means: 'it uses labs or classrooms you already have.', outcome: 'A cohort in a lab or classroom you already have' },
      { feature: 'Connectivity-Light Delivery', means: 'young people outside big cities can take part.', outcome: 'Lessons that run on a basic connection' },
      { feature: 'Consent-Based Data Practice and Safeguarding Agreed per Program', means: 'a program your community can trust.', outcome: 'Safeguarding agreed before enrollment' },
    ]}
  />
  <Section id="steps" tone="airy" pad="sm" aria-labelledby="steps-h">
    <div data-fact="ID-07 PD-06 PD-01 PD-15 PD-08 PD-09">
      <SectionHeader id="steps-h" level={2} title="How It Works in Three Steps" />
      <StepFlow steps={localSteps} />
    </div>
  </Section>

  <!-- C9 -->
  <FAQBand id="faq" audience="variants" ids={FAQ_IDS} title="Questions Local Partners Ask" allLink={{ label: 'Safeguarding, Governance and Due Diligence', href: '/about/governance/' }} />

  <!-- C10 -->
  <ComparisonBand id="compare" rows={cmpRows} facts={['PD-02', 'PD-02a', 'PD-01', 'PD-15', 'PD-08', 'PD-09', 'RC-01', 'RC-06']} />

  <!-- C11 -->
  <Section id="offer" tone="airy" aria-labelledby="offer-h">
    <SectionHeader id="offer-h" eyebrow="Ways to Partner" title="Three Ways to Partner with Us" lead="Choose one or combine them. How a partnership is structured and funded is agreed in the first conversations." />
    <div class="grid-cards grid-cards--stretch" data-fact="PD-06 PD-05">
      {ways.map((w) => <FeatureCard icon={w.icon} title={w.title} text={w.text} />)}
    </div>
  </Section>

  <!-- C12 -->
  <DueDiligenceView compact audience="partners" id="due-diligence" />
  <RiskReversalBand
    id="risk"
    title="Start with a Pilot Cohort. Decide on Evidence"
    points={[
      { icon: 'chart-bar', title: 'Expansion Review on Real Results', text: 'Review early results at three months; any expansion decision uses the scorecard measures available then.' },
      { icon: 'target', title: 'Scorecard Thresholds', text: 'If a threshold is missed, a corrective plan is triggered.' },
      { icon: 'handshake', title: 'Your Participation Is Your Decision', text: 'You choose whether and how far to take part.' },
      { icon: 'shield', title: 'Independent Evaluation Welcome', text: 'We support third-party evaluation of outcomes.' },
    ]}
  />

  <!-- C13 -->
  <CTABand
    id="cta"
    heading="Let’s Plan Your First Local Cohort"
    text="Tell the Bangladesh team about your organization, your district and the groups you work with."
    cta={{ label: local.label, href: local.href }}
    fallbackLabel="the Bangladesh team at"
    micro={MICRO_COMMITMENT}
  />

  <!-- C14 -->
  <Section id="next-steps" aria-labelledby="next-h">
    <SectionHeader id="next-h" eyebrow="After You Write" title="What Happens After You Say Yes" />
    <StepFlow steps={[
      { title: 'Discovery Session', text: 'A conversation about your organization and the young people you reach.' },
      { title: 'Fit Check and Co-Design', text: 'We shape the cohort, tracks, safeguarding and reporting with you.' },
      { title: 'Agreement', text: 'Scope, schedule and success measures are agreed.' },
      { title: 'First Cohort', text: 'Training begins at your site.' },
    ]} />
    <div class="lp-after">
      <p>In your inquiry, include two suitable times for a discovery session.</p>
      <CopyBlock block={FIRST_COHORT_REMINDER} />
    </div>
  </Section>

</LandingLayout>

<style>
  .lp-after {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--outline-variant);
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }
  .lp-after :global(p) {
    margin: 0;
  }
</style>
