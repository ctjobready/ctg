---
// P8 Investors (doc 06 P8; matrix 4.4; D2): thesis + results only. C1 → C14 in order with the declared C2–C3
// compression. For impact investors only (owner, 2026-10-14). No market-size figures, valuation, raise, revenue, growth or pipeline; no partner references
// or reply-time promises (confirm list #13, #17).
// WP30c (owner direction 2026-10-14, "less is more"): the In Short summary is gone (the hero lead and the bands say it), the thesis is three cards without a lead line,
// the path-to-scale paragraph is gone (the scale FAQ answers it), three FAQs, not four. The H1 is the owner's wording.
// WP34 (cycle-11 review): the approaches comparison is gone from this page (it compared supported youth cohorts, on a page about backing the platform; Home keeps it); a short band says how
// JobReady builds on that delivery and that youth-program outcomes are not platform outcomes.
// WP36 (cycle-13 reviews): "Independent Evidence" is three sentences (the trial, the survey, the line that these are youth-program outcomes, not platform outcomes) and three links (the survey, the trial, the case
// studies); the trial explanation, the +10.3 pp chart and table and the three case-study cards are on the Impact pages. The sector taxonomy ("The Sectors Involved") is gone from the mechanism band. The platform band
// keeps its first sentence: the youth-program line now sits beside the figures it qualifies, and is said once.
import LandingLayout from '../../../layouts/LandingLayout.astro';
import HeroBand from '../../../components/sections/HeroBand.astro';
import FeaturesTable from '../../../components/sections/FeaturesTable.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Tone from '../../../components/pages/home/Tone.astro';
import HomeMechanism from '../../../components/pages/home/HomeMechanism.astro';
import InvestorDefinition from '../../../components/pages/investors/InvestorDefinition.astro';
import InvestorThesis from '../../../components/pages/investors/InvestorThesis.astro';
import InvestorVision from '../../../components/pages/investors/InvestorVision.astro';
import InvestorGuide from '../../../components/pages/investors/InvestorGuide.astro';
import InvestorEvidence from '../../../components/pages/investors/InvestorEvidence.astro';
import InvestorReach from '../../../components/pages/investors/InvestorReach.astro';
import InvestorFit from '../../../components/pages/investors/InvestorFit.astro';
import InvestorOffer from '../../../components/pages/investors/InvestorOffer.astro';
import FaqBlock from '../../../components/pages/hub/FaqBlock.astro';
import { HEADLINE, POSITIONING, VALUE_PROPOSITION } from '../../../data/copy';
import { cta } from '../../../lib/mailto';
import { faqJsonLd } from '../../../lib/faq';
import { webPage } from '../../../lib/schema';

const path = '/partner-with-us/investors/';
const title = 'Investors';
// Meta description (≤ 155): the plan's P8 wording, a BLUF without a count. SC-01 carries a mandatory composition footnote, which a meta
// description cannot show, so the headline count stays in the page body ("Reach to Date", InvestorReach) beside its note. WP38: the definition band no longer repeats it.
const description = 'For impact investors: back JobReady’s staged rollout. Request an introduction call; the deck follows under NDA.';
if (description.length > 155) throw new Error(`Investors meta description is ${description.length} characters (max 155)`);
const investor = cta('investor');
const FAQ_IDS = ['Q11', 'Q5', 'Q2-investor'];
const jsonLd = [webPage({ path, name: `${title} | CodersTrust`, description }), faqJsonLd('investors', path, FAQ_IDS)];

const featureRows = [
  { feature: 'Employer Marketplace and Gig-Work (Earn) Marketplace — Pre-Launch', means: 'The platform is designed to connect youth to work and supply employers with job-ready talent.', outcome: 'Until it launches, placement runs through CodersTrust’s placement team and marketplaces such as Upwork and Fiverr.', relieves: 'Youth cannot find work; employers cannot find skills' },
  { feature: 'TalentLEAP competency units: Competent is the first level, with Proficient and Expert planned', means: 'Mentoring, certification exam preparation and placement support in every supported cohort guide learners from skills to income.', outcome: 'Career paths, with higher levels planned', relieves: 'Online learning sells content, not earnings' },
  { feature: 'AI-Ready Curriculum, with Tracks Chosen from Employer Demand and Each Track’s AI Content and Work-Entry Plan Agreed Before Enrollment', means: 'Courses are designed to keep pace with employer demand as AI changes entry-level tasks.', outcome: 'Curriculum that follows demand', relieves: 'AI is raising the bar for entry work' },
  { feature: 'AI-Driven Adaptive Learning — on the Roadmap', means: 'The platform is designed to personalize each learner’s path.', outcome: 'Roadmap; not yet live', relieves: 'Learners need different support as they progress' },
  { feature: 'Partner Portals, Marketing Automation, Customer Relationship Management and AI Chat — Live', means: 'Institutions get a digital delivery platform.', outcome: 'Distribution through institutions' },
];
const mechanismBlocks = [
  { label: 'Learn', title: 'Courses, Bootcamps and University Programs', text: 'AI-ready digital skills, with preparation for industry certification.', icon: 'graduation-cap' },
  { label: 'Earn', title: 'Jobs, Freelance Work and Gigs', text: 'Placement support and mentoring into paid work.', icon: 'briefcase' },
  { label: 'Prosper', title: 'Career Paths and Continuing Development', text: 'TalentLEAP career paths; progressive levels are planned beyond the first published level.', icon: 'trending-up' },
  { label: 'Institutions', title: 'A Digital Delivery Platform', text: 'Partner portals for governments, universities and partners.', icon: 'building-2' },
];
---

<LandingLayout title={title} description={description} jsonLd={jsonLd} breadcrumbs={[{ label: 'Partner with Us', href: '/partner-with-us/' }, { label: 'Investors' }]} stickyCta={{ label: investor.label, href: investor.href }}>
  <Tone cmf="C1">
    <HeroBand
      variant="inner"
      audience="For Impact Investors"
      title={HEADLINE.investors}
      lead={VALUE_PROPOSITION.investors}
      leadFacts={['IN-04']}
      cta={{ label: investor.label, href: investor.href }}
      artSeed="investors"
    />
  </Tone>

  <Tone cmf="GEO"><InvestorDefinition id="definition" /></Tone>

  <Tone cmf="C2-C3 (compressed)"><InvestorThesis id="thesis" /></Tone>

  <Tone cmf="C5"><InvestorGuide id="guide" /></Tone>

  <Tone cmf="C4"><InvestorVision id="vision" /></Tone>

  <Tone cmf="C6">
    <HomeMechanism id="mechanism" tone="airy" statementFirst eyebrow="The Model" title="A Multi-Sided Model: Learn, Earn, Prosper" positioning={POSITIONING.investors} blocks={mechanismBlocks} link={{ label: 'How Our Model Works', href: '/our-model/' }} />
  </Tone>

  <Tone cmf="C7"><InvestorReach id="reach" /></Tone>
  <!-- WP36 (cycle-13 review): the evidence is three sentences and the links; the case studies are one link, "Case Studies", in the same row. -->
  <Tone cmf="C7">
    <InvestorEvidence
      id="proof-band"
      links={[
        { label: 'Impact Survey 2026', href: '/impact/outcomes-2026/' },
        { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' },
        { label: 'Case Studies', href: '/impact/case-studies/' },
      ]}
    />
  </Tone>

  <Tone cmf="C8" join>
    <FeaturesTable id="features" title="What JobReady Does" lead="Status is stated exactly: what is live, what is pre-launch and what is on the roadmap." rows={featureRows} />
  </Tone>

  <Tone cmf="C9"><FaqBlock id="faq" audience="investors" ids={FAQ_IDS} tone="ice" title="Questions Investors Ask" eyebrow="Fit and Objections"><InvestorFit /></FaqBlock></Tone>

  <!-- C10 · Differentiation: WP34 (cycle-11 review) swapped the approaches comparison for one statement. It rests on IN-04 (what is live and what is in pre-launch) and keeps the wording of the hero lead. -->
  <Tone cmf="C10">
    <Section id="platform" pad="sm" aria-labelledby="platform-h">
      <SectionHeader id="platform-h" eyebrow="The Platform" title="How JobReady Builds on Delivery" flush>
        <p class="lead" data-fact="IN-04">JobReady adds live partner portals and pre-launch work marketplaces to CodersTrust’s training and mentoring programs.</p>
      </SectionHeader>
    </Section>
  </Tone>

  <Tone cmf="C11"><InvestorOffer id="offer" /></Tone>

  <Tone cmf="C13">
    <CTABand
      id="cta"
      tone="klein"
      heading="Let’s Talk About Backing the Platform"
      cta={{ label: investor.label, href: investor.href }}
      secondary={{ label: 'Meet the Leadership Team', href: '/about/team/' }}
    />
  </Tone>

</LandingLayout>
