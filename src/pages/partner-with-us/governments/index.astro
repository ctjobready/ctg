---
/**
 * P3 Governments: /partner-with-us/governments/ (T3, implements doc 04 matrix 4.2).
 * C1 to C14 in order, as the numbered table in doc 06 P3.
 * WP30c (owner direction 2026-10-14, "less is more"): the page keeps every CMF band and states each point once. Gone: the In Short summary and its jump links,
 * the fit check, the "Outside Bangladesh?", national-target, scale and coastal-context callouts, the survey callout, the second Her Power card set, the three-step
 * restatement of the mechanism, the standard-inclusions list and the four-point restatement of the scorecard. The H1 is the owner's wording.
 * WP35 (cycle-12 review): the trial and the survey are shown once, as tiles in Results at a Glance; the proof band that restated them is a one-line strip of links (#proof-band). The WSDFM tile is gone
 * from the glance (its 71% is program records, read beside the trial's 63.1%), and the plain-words fixes are in the contracts table and the services line.
 * WP36 (cycle-13 reviews): the 31,200+ is stated once, in Results at a Glance (the Track Record band's tile is gone; the contracts table below keeps each contract's own scope); the glance tile reads "People in the Scopes
 * of Six Government Contracts"; "What Your Agency Gets" speaks of spending "measured against outcomes" and a budget "assessed against the agreed scorecard"; the three pains are statements; the cost question has the
 * one-line route answer and a link to the hub FAQ.
 */
import PartnerGlance from '../../../components/pages/partners/PartnerGlance.astro';
import PairedEvidence from '../../../components/pages/partners/PairedEvidence.astro';
import DueDiligenceView from '../../../components/pages/hub/DueDiligenceView.astro';
import MinistrySees from '../../../components/pages/partners/MinistrySees.astro';
import LearnerVoice from '../../../components/pages/impact/LearnerVoice.astro';
import LandingLayout from '../../../layouts/LandingLayout.astro';
import HeroBand from '../../../components/sections/HeroBand.astro';
import DefinitionBand from '../../../components/sections/DefinitionBand.astro';
import ProblemBand from '../../../components/sections/ProblemBand.astro';
import CostSection from '../../../components/pages/programs/CostSection.astro';
import FutureBand from '../../../components/sections/FutureBand.astro';
import { futurePhotos } from '../../../data/photos';
import MechanismBand from '../../../components/sections/MechanismBand.astro';
import FeaturesTable from '../../../components/sections/FeaturesTable.astro';
import FAQBand from '../../../components/sections/FAQBand.astro';
import RiskReversalBand from '../../../components/sections/RiskReversalBand.astro';
import CTABand from '../../../components/ui/CTABand.astro';
import SessionAgenda from '../../../components/ui/SessionAgenda.astro';
import GainsPains from '../../../components/pages/partners/GainsPains.astro';
import PartnerGuideBand from '../../../components/pages/partners/PartnerGuideBand.astro';
import SubBand from '../../../components/pages/partners/SubBand.astro';
import EvidenceList from '../../../components/pages/partners/EvidenceList.astro';
import ContractTable from '../../../components/pages/partners/ContractTable.astro';
import ModelPartnership from '../../../components/pages/partners/ModelPartnership.astro';
import RouteLink from '../../../components/pages/partners/RouteLink.astro';
import OfferCards from '../../../components/pages/partners/OfferCards.astro';
import StepsBand from '../../../components/pages/partners/StepsBand.astro';
import Reinforcement from '../../../components/pages/partners/Reinforcement.astro';
import PageEnhancements from '../../../components/pages/partners/PageEnhancements.astro';
import { LINKS, factPart, funderOptionCards, meta } from '../../../components/pages/partners/partners';
import { C14, EMPATHY, HEADLINE, POSITIONING, PROGRAM_SIZES_NOTE, VALUE_PROPOSITION } from '../../../data/copy';
import { CLAIM_PX06, CLAIM_RC06 } from '../../../components/sections/copyText';
import { caseStudyItems } from '../../../components/pages/home/caseStudies';
import { faqJsonLd } from '../../../lib/faq';
import { cta } from '../../../lib/mailto';
import { webPage } from '../../../lib/schema';

const PATH = '/partner-with-us/governments/';
const primary = cta('briefing');

const { title, description } = meta(
  'Digital Skills Training for Governments',
  // Doc 06 P3 meta (R10/WP11 F17): the value proposition, with no count. SC-06's 31,200+ needs its footnote, which a meta description cannot carry.
  VALUE_PROPOSITION.governments,
);

// The Her Power tile reads as the Home and Investors cards do: the result first, then its base (built from PR-05's own label in caseStudies.ts).
const herPowerLabel = caseStudyItems.find((i) => i.factId === 'PR-05')?.statLabel;
// Q8-route: the one-line cost answer with a link to the partner hub FAQ, which keeps the full answer (WP36).
const FAQ_IDS = ['Q7-government', 'Q2-government', 'Q1-government', 'Q10', 'Q8-route'];
const manuals = factPart('GV-11', /[\d,]+ manuals and guidelines distributed/);
---

<LandingLayout
  title={title}
  description={description}
  path={PATH}
  breadcrumbs={[{ label: 'Partner with Us', href: LINKS.hub }, { label: 'Governments' }]}
  jsonLd={[webPage({ path: PATH, name: title, description }), faqJsonLd('governments', PATH, FAQ_IDS)]}
  stickyCta={{ label: primary.label, href: primary.href }}
>
  <!-- C1 · Identity hook -->
  <HeroBand
    audience="For Ministries and Public Agencies"
    title={HEADLINE.governments}
    lead={VALUE_PROPOSITION.governments}
    cta={{ label: primary.label, href: primary.href }}
    artSeed="partners-governments"
  />
  <RouteLink kicker="See the Program" label="How YouthWIDE Works" href={LINKS.youthwide} />
  <!-- GEO · What is CodersTrust? -->
  <DefinitionBand />
  <PartnerGlance
    lead={[
      { id: 'GV-12', href: '/partner-with-us/governments/#contracts', label: 'People in the Scopes of Six Government Contracts', also: ['SC-06', 'GV-10'] },
      { id: 'PR-05', href: '/impact/case-studies/her-power/', label: herPowerLabel },
      { id: 'RC-02', href: '/impact/independent-evaluation/' },
    ]}
    more={[{ id: 'PR-02', href: '/impact/case-studies/kosovo-women-in-online-work/' }]}
  />
  <LearnerVoice story="maria-dewan" excerpt="She showed her skills by winning a company logo design on Freelancer.com, and thus began her journey of earning on her own." program="Her Power" tone="white" />

  <!-- C2 · Problem. WP31: the heading speaks to any ministry. WP34 (cycle-11 review): so does the tile, the global PX-01 figure as on Home; the Bangladesh 13.5% (PX-03) stays on the Bangladesh pages. -->
  <ProblemBand
    title="Training Budgets Need Employment Results"
    bluf="Budgets that count enrollment cannot show who is earning."
    factIds={['PX-01']}
  >
    <GainsPains
      slot="lead"
      pains={[
        { q: 'Graduates struggle to find work', text: 'A degree alone is not producing job offers.' },
        { q: 'Training budgets do not show up as earnings', text: 'Budgets are measured by enrollment, not by who is earning afterward.' },
        { q: 'Trainer and curriculum capacity is thin' },
      ]}
    />
  </ProblemBand>

  <!-- C3 · Agitation -->
  <CostSection
    title="Without Tracking, Agencies Cannot See What Training Delivers"
    transition="It doesn’t have to be this way."
    blocks={[
      { claim: CLAIM_RC06, factId: 'RC-06', implication: 'Placement and tracking have to be built into the national program from the start, not added afterward.' },
      { claim: CLAIM_PX06, factId: 'PX-06', implication: 'Training has to follow current employer demand.' },
    ]}
  />

  <!-- C5 · Guide (empathy first). WP31: credibility comes before the vision, as on Home. -->
  <PartnerGuideBand
    empathy={EMPATHY.governments}
    statements={[{ facts: ['SC-04'], markers: [], text: 'CodersTrust has been National University’s official training partner for digital career skills and credentials since 2023.' }]}
    method={{ text: 'Our TalentLEAP method organizes skills into career paths with progressive levels.', link: { label: 'How TalentLEAP Works', href: LINKS.talentleap } }}
    partnerGroup={['government', 'academic']}
  />

  <!-- C4 · Future state -->
  <FutureBand
    photos={futurePhotos('partners-governments')}
    title="What Your Next Budget Cycle Could Show"
    lead="Illustrative, not case studies."
    vignettes={[
      { kind: 'Functional', title: 'Young People in Work', text: 'Monthly reports will show young people moving into work, with certification results reported separately.' },
      { kind: 'Emotional', title: 'Employers Find Job-Ready Talent', text: 'Employers find job-ready talent, including young people prepared for industry certification exams.' },
      { kind: 'Social', title: 'Capacity That Stays', text: 'Trained facilitators and localized curricula stay in your system after the program.' },
    ]}
  />

  <!-- C6 · Mechanism (YouthWIDE-style delivery) -->
  <MechanismBand
    title="A National Delivery Model, Built on Labs That Already Exist"
    positioning={POSITIONING.governments}
    blocks={[
      { label: 'Who We Reach', title: 'Vulnerable and Unemployed Youth', text: 'Unemployed graduates and other priority groups, with women a priority in every group.', icon: 'users' },
      { label: 'How We Reach Them', title: 'Government Digital Labs', text: 'Blended learning in government labs you already run; lab access and seats are confirmed per program.', icon: 'landmark' },
      { label: 'What We Deliver', title: 'Capacity That Stays', text: `Training of Trainers, curriculum and manuals (${manuals} for Her Power), then preparation for industry certification.`, icon: 'award' },
      { label: 'Where They Work', title: 'Placement and Monthly Reports', text: 'Placement support into local, remote and global work, with monthly reports to the agency.', icon: 'globe' },
    ]}
    link={{ label: 'See How YouthWIDE Works', href: LINKS.youthwide }}
  />

  <!-- C7 · Proof: the trial and survey results are the tiles above; this strip links the full evidence (WP35, cycle-12 review) -->
  <PairedEvidence
    id="proof-band"
    eyebrow="The Evidence"
    title="See the Evidence Behind the Results"
    items={[]}
    broader={[
      { label: 'Read the Trial Results', href: LINKS.trial },
      { label: 'Impact Survey 2026', href: LINKS.outcomes },
    ]}
    broaderLabel="The evidence behind the results"
  />
  <ContractTable title="Six Government Contracts, Scope by Scope" lead="What CodersTrust does under each contract, and the training scope it covers." />
  <!-- WP29 (benchmark review): one government partnership as a card of separate fields (partner, role, direct training, tracked outcome, national reach), all from registered facts. -->
  <ModelPartnership />

  <!-- C8 · Features to benefits -->
  <FeaturesTable
    title="What Your Agency Gets"
    rows={[
      {
        feature: 'Certification Tracks Chosen from Employer Demand, Then Mentoring and Placement Support',
        means: 'Certification, mentoring and placement support point them toward paid work.',
        outcome: 'Graduates prepared for work',
        relieves: 'Graduates struggle to find work',
      },
      {
        feature: 'A pilot scorecard with cost per completer and per verified outcome; monthly reports',
        means: 'Your budget is assessed against the agreed scorecard.',
        outcome: 'Spending measured against outcomes',
        relieves: 'Budgets are measured by enrollment, not earnings',
      },
      {
        feature: 'Training of Trainers, curriculum and manuals; certified local facilitators; blended learning in existing labs; connectivity-light delivery',
        means: 'Capacity stays in your system and rural labs can take part.',
        outcome: 'Trainers and curricula designed to stay in your system',
        relieves: 'Trainer and curriculum capacity is thin',
      },
    ]}
  />
  <MinistrySees />

  <!-- C9 · Objections -->
  <FAQBand
    audience="governments"
    ids={FAQ_IDS}
    title="Questions Ministries Ask"
    allLink={{ label: 'Safeguarding, Governance and Due Diligence', href: LINKS.governance }}
  />

  <!-- C10 · Differentiation: the positioning statement opens C6; the comparison table is on Home and Investors only (WP30c). -->

  <!-- C11 · Offer -->
  <OfferCards title="Choose Where to Start" lead={`${PROGRAM_SIZES_NOTE} Pricing is set per program, and we share an indicative budget in the discovery session.`} cards={funderOptionCards()} recommended={0} />
  <SubBand tone="airy" pull>
    <EvidenceList
      heading="Services We Can Scope for an Agency"
      items={[
        { facts: ['GV-11'], text: 'Curriculum development, manuals and Training of Trainers.' },
        { facts: ['GV-05'], text: 'Training for staff on the learning platform and lab operations.' },
      ]}
    />
  </SubBand>

  <!-- C12 · Risk reversal (immediately before C13). WP34 (cycle-11 review): the four diligence cards repeated what this page's bands state, so one item and a link stand in -->
  <DueDiligenceView brief id="due-diligence" />
  <RiskReversalBand
    title="Phased Rollout, with Review Gates"
    points={[
      { icon: 'rocket', title: 'Pilot First', text: 'We start with a pilot, not a national rollout.' },
      { icon: 'target', title: 'Review Gates', text: 'Thresholds are agreed with the agency before the first cohort; a missed threshold triggers a corrective plan.' },
      { icon: 'handshake', title: 'The Agency Decides on Expansion', text: 'You choose whether and how far to scale.' },
      { icon: 'shield', title: 'Independent Evaluation Welcome', text: 'We support third-party evaluation of outcomes.' },
    ]}
  />

  <!-- C13 · Call to action -->
  <CTABand
    id="cta"
    heading="Let’s Plan a First Phase with Your Ministry"
    cta={{ label: primary.label, href: primary.href }}
    secondary={{ label: 'See government programs', href: LINKS.nationwide }}
    urgency="Public procurement follows the agency’s own timeline — we start with a briefing that fits it."
  >
    <SessionAgenda lead="governments" />
  </CTABand>

  <!-- C14 · Next steps -->
  <StepsBand
    title="What Happens After You Say Yes"
    steps={[
      { title: 'Briefing', text: 'A briefing for your ministry or agency, shaped to its procurement timeline.' },
      { title: 'Co-design with the agency', text: 'Priority groups, tracks, labs and the pilot scorecard are agreed together.' },
      { title: 'Agreement', text: 'Scope and schedule follow the agency’s own procurement timeline.' },
      { title: 'Launch in Existing Labs', text: 'Seats are confirmed per program.' },
    ]}
  />
  <Reinforcement firstAction={C14.variants.governments} logos={false} reminder={false} validate={C14.validateFor.governments} />

  <PageEnhancements />
</LandingLayout>
