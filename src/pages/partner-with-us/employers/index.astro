---
/**
 * P7 Employers: /partner-with-us/employers/ (T3, implements doc 04 matrix 4.6).
 * C1 to C14 in order, as the numbered table in doc 06 P7.
 * WP30c (owner direction 2026-10-14, "less is more"): every CMF band stays, each states its point once. Gone: the In Short summary, the fit check, the second statement of the
 * placement-team sentence (the hiring band says it), the restated "measures you set" card and the fifth next step. Three FAQs, not five.
 * WP31 (cycle-8 review): the youth programs' trial, survey and paid-work pathway blocks are gone from this corporate offer page; "Broader Evidence from Our Youth Programs" is a two-link
 * group to the evidence pages (no figure from the youth programs is shown here).
 * WP32 (cycle-9 review): the employer credentials (Grameenphone Academy enrollments, AWS Authorized Training Partner, AIvolve) are stated once, in "Our Track Record"; the delivery-record cards that repeated them are gone.
 */
import DueDiligenceView from '../../../components/pages/hub/DueDiligenceView.astro';
import LearnerVoice from '../../../components/pages/impact/LearnerVoice.astro';
import LandingLayout from '../../../layouts/LandingLayout.astro';
import HeroBand from '../../../components/sections/HeroBand.astro';
import DefinitionBand from '../../../components/sections/DefinitionBand.astro';
import ProblemBand from '../../../components/sections/ProblemBand.astro';
import CostSection from '../../../components/pages/programs/CostSection.astro';
import FutureBand from '../../../components/sections/FutureBand.astro';
import { futurePhotos } from '../../../data/photos';
import MechanismBand from '../../../components/sections/MechanismBand.astro';
import FeaturesTable from '../../../components/sections/FeaturesTable.astro';
import FAQBand from '../../../components/sections/FAQBand.astro';
import RiskReversalBand from '../../../components/sections/RiskReversalBand.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import PairedEvidence from '../../../components/pages/partners/PairedEvidence.astro';
import Icon from '../../../components/system/Icon.astro';
import GainsPains from '../../../components/pages/partners/GainsPains.astro';
import PartnerGuideBand from '../../../components/pages/partners/PartnerGuideBand.astro';
import SubBand from '../../../components/pages/partners/SubBand.astro';
import Callout from '../../../components/pages/partners/Callout.astro';
import RouteLink from '../../../components/pages/partners/RouteLink.astro';
import OfferCards from '../../../components/pages/partners/OfferCards.astro';
import DualCtaBand from '../../../components/pages/partners/DualCtaBand.astro';
import StepsBand from '../../../components/pages/partners/StepsBand.astro';
import RouteBlock from '../../../components/ui/RouteBlock.astro';
import Reinforcement from '../../../components/pages/partners/Reinforcement.astro';
import PageEnhancements from '../../../components/pages/partners/PageEnhancements.astro';
import { LINKS, meta } from '../../../components/pages/partners/partners';
import { C14, EMPATHY, EMPLOYER_HIRING_ROUTE, EMPLOYER_PRICING, HEADLINE, MICRO_COMMITMENT, POSITIONING, VALUE_PROPOSITION } from '../../../data/copy';
import { contractScope } from '../../../components/sections/copyText';
import { faqJsonLd } from '../../../lib/faq';
import { cta } from '../../../lib/mailto';
import { webPage } from '../../../lib/schema';

const PATH = '/partner-with-us/employers/';
const primary = cta('work');
const talent = cta('talent');

const { title, description } = meta(
  'Corporate AI Training and Digital Talent',
  'Upskill teams for AI and digital work, and hire job-ready digital talent through CodersTrust’s employer training and placement support.',
);

// Q8-employer: the employer pricing answer (the same variant JobReady@Work uses), not the youth-cohort pricing answer.
const FAQ_IDS = ['Q1-employer', 'Q8-employer', 'Q11'];
---

<LandingLayout
  title={title}
  description={description}
  path={PATH}
  breadcrumbs={[{ label: 'Partner with Us', href: LINKS.hub }, { label: 'Employers' }]}
  jsonLd={[webPage({ path: PATH, name: title, description }), faqJsonLd('employers', PATH, FAQ_IDS)]}
  stickyCta={{ label: primary.label, href: primary.href }}
>
  <!-- C1 · Identity hook -->
  <HeroBand
    audience="For Employers"
    title={HEADLINE.employers}
    lead={VALUE_PROPOSITION.employers}
    cta={{ label: primary.label, href: primary.href }}
    artSeed="partners-employers"
  />
  <!-- Routes under the hero: the two offers, one per need (WP24a). Hiring sits near the top (the employer's own decision); training is detailed further down. -->
  <SubBand>
    <Callout eyebrow="Your Next Step">
      <p class="cluster">
        <span>Need training? <a class="link" href="#train-your-team">Train Your Team<Icon name="arrow-right" size={16} /></a></span>
        <span>Need talent? <a class="link" href="#hire-talent">Hire Talent<Icon name="arrow-right" size={16} /></a></span>
      </p>
    </Callout>
  </SubBand>
  <RouteLink kicker="See the Program" label="See the Training Delivery Details" href={LINKS.work} />
  <!-- GEO · What is CodersTrust? -->
  <DefinitionBand />

  <Section id="hire-talent" tone="airy" pad="sm" aria-labelledby="hire-h">
    <SectionHeader id="hire-h" eyebrow="Hire Talent" title="Job-Ready Talent Through the Placement Team" lead="Job-ready candidates are introduced through CodersTrust’s placement team. Talent requests are scoped against the experience and credentials available in the candidate pool." />
    <p data-fact="IN-04"><a class="link" href={talent.href}>{talent.label}<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <LearnerVoice story="mysha-k-diya" excerpt="A paying job after only two months of Digital Accounting training is a huge accomplishment for me, made possible by the mentorship of CodersTrust." program="Digital Accounting course, CodersTrust Bangladesh" tone="white" />

  <!-- C2 · Problem -->
  <ProblemBand
    title="The Talent You Need Is Hard to Find"
    bluf="Your roles need digital skills, and your teams need AI skills now."
    factIds={['PX-05']}
  >
    <GainsPains
      slot="lead"
      pains={[
        { q: 'Why can’t you find the digital talent you need?', text: 'Employers worldwide report difficulty finding talent, and AI skills are the hardest to find.' },
        { q: 'Why does hiring alone not close the gap?', text: 'Hiring adds people, but your current teams still need the skills their own tasks now require.' },
        { q: 'How do you upskill your teams for AI workflows?', text: 'Your teams need upskilling on tasks from their own roles.' },
      ]}
    />
  </ProblemBand>

  <!-- C3 · Agitation -->
  <div class="pp-two">
    <CostSection
      title="AI Is Changing the Skills Your Teams Need"
      transition="It doesn’t have to be this way."
      blocks={[
        { claim: 'Jobs Requiring AI Skills Are Growing and Paying More', factId: 'PX-08', scope: 'Globally', implication: 'Waiting means competing for the same scarce talent.' },
        { claim: 'AI Is Reshaping the Workforce', factId: 'PX-07', scope: 'Globally', implication: 'Training plans need to keep pace with how roles are changing.' },
      ]}
    />
  </div>

  <!-- C5 · Guide (empathy first). WP31: credibility comes before the vision, as on Home. -->
  <PartnerGuideBand
    empathy={EMPATHY.employers}
    stats={['SC-15']}
    statements={[{ facts: ['GV-06'], text: contractScope('GV-06') }, { facts: ['PA-06'] }, { facts: ['PA-07'] }]}
    method={{ text: 'Our TalentLEAP method organizes skills into career paths with progressive levels.', link: { label: 'How TalentLEAP Works', href: LINKS.talentleap } }}
    partnerGroup="private"
  />

  <!-- C4 · Future state -->
  <FutureBand
    photos={futurePhotos('partners-employers')}
    title="What Changes for Your Team"
    lead="Illustrative, not case studies."
    vignettes={[
      { kind: 'Functional', title: 'A Team Fluent in AI Workflows', text: 'Your team applies AI tools in daily work.' },
      { kind: 'Emotional', title: 'Certification for Candidates Who Pass the Exam', text: 'Candidates who pass the exam hold the industry certification for their track.' },
      { kind: 'Social', title: 'A Reliable Pipeline', text: 'Digital talent is introduced through CodersTrust’s placement team.' },
    ]}
  />

  <!-- C6 · Mechanism (JobReady@Work) -->
  <MechanismBand
    title="JobReady@Work: Built Around Your Roles"
    positioning={POSITIONING.employers}
    blocks={[
      { label: 'Assess', title: 'Needs Assessment', text: 'Scopes the skills and the team size before anything is built.', icon: 'search' },
      { label: 'Design', title: 'Customized Solution and Curriculum', text: 'A curriculum built from your roles, tasks and required tools.', icon: 'pen' },
      { label: 'Deliver', title: 'Interactive Workshops', text: 'Soft-skills and hard-skills tracks, including preparation for an industry certification where a track offers one.', icon: 'users' },
      { label: 'Measure', title: 'Progress Evaluation and Support', text: 'Post-training support and a progress evaluation, so outcomes are measurable.', icon: 'chart-bar' },
    ]}
    link={{ label: 'About JobReady@Work', href: LINKS.work }}
  />

  <!-- C7 · Proof: the employer credentials (the 23,000+ Grameenphone Academy enrollments, AWS Authorized Training Partner, the AIvolve partnership) are stated once, in "Our Track Record" above
       (WP32, cycle-9 review: they were repeated here); this strip is two links to the youth programs' evidence (WP31: no trial, survey or pathway figure is shown on this corporate page).
       WP25s: proof comes before the features table (C8), as on every other audience page. -->
  <PairedEvidence
    title="Broader Evidence from Our Youth Programs"
    eyebrow=""
    items={[]}
    broader={[
      { label: 'The Randomized Trial', href: LINKS.trial },
      { label: 'Impact Survey 2026', href: LINKS.outcomes },
    ]}
  />

  <!-- C8 · Features to benefits -->
  <FeaturesTable
    title="What Your Business Gets"
    rows={[
      {
        feature: 'A Placement Team, Plus Trainees from Employer-Demand Certification Tracks',
        means: 'Access to candidates from CodersTrust’s placement team for your roles.',
        outcome: 'Job-ready candidates for your roles',
        relieves: 'You cannot find the digital talent you need',
      },
      {
        feature: 'An AI-Ready Curriculum, with Each Track’s AI Content and Work-Entry Plan Agreed Before Enrollment',
        means: 'Your training includes AI content agreed before enrollment.',
        outcome: 'People ready to work with AI tools',
        relieves: 'Hiring alone does not close the gap',
      },
      {
        feature: 'JobReady@Work Customized Curriculum and Interactive Workshops',
        means: 'Your team learns on tasks from your own roles.',
        outcome: 'A team trained on its own tasks',
        relieves: 'Your teams need upskilling for AI workflows',
      },
    ]}
  />

  <!-- C9 · Objections -->
  <FAQBand
    audience="employers"
    ids={FAQ_IDS}
    title="Questions Employers Ask"
  />

  <!-- C11 · Offer: the two in-page routes (Train Your Team, Hire Talent) -->
  <OfferCards
    title="Choose How to Work with Us"
    lead={EMPLOYER_PRICING}
    cards={[
      { id: 'train-your-team', eyebrow: 'Option 1', title: 'A Training Program Scoped to Your Team', text: 'Custom curriculum and interactive workshops, built from a needs assessment of your roles.', facts: ['IN-10'] },
      { eyebrow: 'Option 2', title: 'Talent Through the Placement Team', text: 'Access to job-ready candidates introduced through CodersTrust’s placement team.', facts: ['IN-04'] },
    ]}
  />

  <!-- C12 · Risk reversal (immediately before C13) -->
  <DueDiligenceView compact audience="employers" id="due-diligence" />
  <RiskReversalBand
    title="Start with a Pilot Team, Then Decide on Evidence"
    lead="Success measures are agreed before you start (completion, certification and the role-specific skills you prioritize) and checked in the progress evaluation."
    points={[
      { icon: 'rocket', title: 'Pilot Team First', text: 'Start with one team and see what changes.' },
      { icon: 'handshake', title: 'Scaling Up Is Your Decision', text: 'You choose whether and how far to scale.' },
      { icon: 'shield', title: 'Independent Evaluation Welcome', text: 'We support third-party evaluation of outcomes.' },
    ]}
  />

  <!-- C13 · Call to action: one solid primary, one outline -->
  <DualCtaBand
    id="cta"
    heading="Let’s Plan Your First Team Program"
    primary={{ label: primary.label, href: primary.href }}
    secondary={{ label: talent.label, href: talent.href }}
    micro={MICRO_COMMITMENT}
  />

  <!-- C14 · Next steps. WP34 (cycle-11 review): the offer is training and hiring, so the steps are labeled "For Team Training" and hiring has its own short route; the "Hire JobReady Talent" link stays in the C13 band above. -->
  <StepsBand
    title="What Happens After You Say Yes"
    route="For Team Training"
    steps={[
      { title: 'Discovery Session', text: 'A conversation about your roles, team size and timeline.' },
      { title: 'Needs Assessment', text: 'We scope the skills your roles need.' },
      { title: 'Agreement', text: 'Scope, schedule and success measures are agreed.' },
      { title: 'First Workshop or Cohort', text: 'Training starts with your pilot team, and results are checked against the measures you set.' },
    ]}
  >
    <RouteBlock label="For Hiring">
      <p class="lead" data-fact="IN-04" data-reveal>{EMPLOYER_HIRING_ROUTE}</p>
    </RouteBlock>
  </StepsBand>
  <Reinforcement firstAction={C14.variants.employers} logos={false} reminder={false} validate={C14.validateFor.employers} />

  <PageEnhancements />
</LandingLayout>
