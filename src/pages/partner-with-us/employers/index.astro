---
/**
 * P7 Employers: /partner-with-us/employers/ (T3, implements doc 04 matrix 4.6).
 * C1 to C14 in order, as the numbered table in doc 06 P7.
 */
import LandingLayout from '../../../layouts/LandingLayout.astro';
import HeroBand from '../../../components/sections/HeroBand.astro';
import DefinitionBand from '../../../components/sections/DefinitionBand.astro';
import ProblemBand from '../../../components/sections/ProblemBand.astro';
import CostSection from '../../../components/pages/programs/CostSection.astro';
import FutureBand from '../../../components/sections/FutureBand.astro';
import { futurePhotos } from '../../../data/photos';
import MechanismBand from '../../../components/sections/MechanismBand.astro';
import ProofBand from '../../../components/sections/ProofBand.astro';
import FeaturesTable from '../../../components/sections/FeaturesTable.astro';
import FAQBand from '../../../components/sections/FAQBand.astro';
import ComparisonBand from '../../../components/sections/ComparisonBand.astro';
import RiskReversalBand from '../../../components/sections/RiskReversalBand.astro';
import Sources from '../../../components/facts/Sources.astro';
import Section from '../../../components/ui/Section.astro';
import GainsPains from '../../../components/pages/partners/GainsPains.astro';
import PartnerGuideBand from '../../../components/pages/partners/PartnerGuideBand.astro';
import SubBand from '../../../components/pages/partners/SubBand.astro';
import Callout from '../../../components/pages/partners/Callout.astro';
import EvidenceList from '../../../components/pages/partners/EvidenceList.astro';
import HowItWorks from '../../../components/pages/partners/HowItWorks.astro';
import OfferCards from '../../../components/pages/partners/OfferCards.astro';
import DualCtaBand from '../../../components/pages/partners/DualCtaBand.astro';
import StepsBand from '../../../components/pages/partners/StepsBand.astro';
import Reinforcement from '../../../components/pages/partners/Reinforcement.astro';
import PageEnhancements from '../../../components/pages/partners/PageEnhancements.astro';
import { LINKS, factPart, meta } from '../../../components/pages/partners/partners';
import { EMPATHY, HEADLINE, MICRO_COMMITMENT, POSITIONING, SURVEY_EMPLOYMENT, TRIAL_SCOPE, VALUE_PROPOSITION } from '../../../data/copy';
import { fact } from '../../../data/facts';
import { contractScope } from '../../../components/sections/copyText';
import { faqJsonLd } from '../../../lib/faq';
import { cta } from '../../../lib/mailto';
import { webPage } from '../../../lib/schema';

const PATH = '/partner-with-us/employers/';
const primary = cta('work');
const talent = cta('talent');

const { title, description } = meta(
  'Corporate AI Training & Digital Talent',
  'Upskill teams for AI and digital work, and hire job-ready digital talent through CodersTrust’s employer training and placement support.',
);

// Q8-employer: the employer pricing answer (the same variant JobReady@Work uses), not the youth-cohort pricing answer.
const FAQ_IDS = ['Q5', 'Q1', 'Q12', 'Q8-employer', 'Q11'];
const mainIncome = factPart('OC-07', /78\.0% named work as their main income source/);
const steps = [
  { title: 'Assess', text: 'A needs assessment scopes the skills and team size.' },
  { title: 'Train and Certify', text: 'Custom curriculum and workshops, including preparation for an industry certification where a track offers one; exam eligibility and attempts are agreed in the program scope.' },
  { title: 'Support and Measure', text: 'Post-training support and a progress evaluation against the measures you set.' },
];
---

<LandingLayout
  title={title}
  description={description}
  path={PATH}
  breadcrumbs={[{ label: 'Partner with Us', href: LINKS.hub }, { label: 'Employers' }]}
  jsonLd={[webPage({ path: PATH, name: title, description }), faqJsonLd('employers', PATH, FAQ_IDS)]}
  stickyCta={{ label: primary.label, href: primary.href }}
>
  <!-- C1 · Identity hook -->
  <HeroBand
    audience="For employers"
    title={HEADLINE.employers}
    lead={VALUE_PROPOSITION.employers}
    cta={{ label: primary.label, href: primary.href }}
    artSeed="partners-employers"
  />
  <!-- GEO · What is CodersTrust? -->
  <DefinitionBand />

  <!-- C2 · Problem -->
  <ProblemBand
    title="The Talent You Need Is Hard to Find."
    bluf="Your roles need digital skills, and your teams need AI skills now."
    factIds={['PX-05']}
  >
    <GainsPains
      slot="lead"
      gains={['Teams fluent in AI workflows', 'A reliable pipeline of digital talent']}
      pains={[
        { q: 'Why can’t you find the digital talent you need?', text: 'Employers report difficulty finding the talent they need.' },
        { q: 'Why does hiring alone not close the gap?', text: `${fact('PX-05').stat?.value} of employers worldwide report difficulty finding the talent they need, so hiring alone does not close the gap.` },
        { q: 'How do you upskill your teams for AI workflows?', text: 'Your teams need upskilling on tasks from their own roles.' },
      ]}
    />
  </ProblemBand>

  <!-- C3 · Agitation -->
  <div class="pp-two">
    <CostSection
      title="AI Is Changing the Skills Your Teams Need."
      transition="It doesn’t have to be this way."
      blocks={[
        { claim: 'Jobs Requiring AI Skills Are Growing and Paying More.', factId: 'PX-08', scope: 'Globally', implication: 'Waiting means competing for the same scarce talent.' },
        { claim: 'AI Is Reshaping the Workforce.', factId: 'PX-07', scope: 'Globally', implication: 'Training plans need to keep pace with how roles are changing.' },
      ]}
    />
  </div>

  <!-- C4 · Future state -->
  <FutureBand
    photos={futurePhotos('partners-employers')}
    title="What Changes for Your Team"
    lead="Illustrative, not case studies."
    vignettes={[
      { kind: 'Functional', title: 'A Team Fluent in AI Workflows', text: 'Your team applies AI tools in daily work.' },
      { kind: 'Emotional', title: 'Candidates Scoped to Your Roles', text: 'Candidates are scoped against the experience and credentials available for each role; those who pass an exam hold the industry certification.' },
      { kind: 'Social', title: 'A Reliable Pipeline', text: 'Digital talent comes through CodersTrust’s placement team.' },
    ]}
  />

  <!-- C5 · Guide (empathy first) -->
  <PartnerGuideBand
    empathy={EMPATHY.employers}
    stats={['SC-15']}
    statements={[{ facts: ['GV-06'], text: contractScope('GV-06') }, { facts: ['PA-06'] }]}
    method={{ text: 'JobReady@Work is CodersTrust’s employer training offer: a needs assessment, a customized curriculum, interactive workshops and progress evaluation for a defined team. TalentLEAP organizes skills into career paths with progressive levels.', link: { label: 'How TalentLEAP works', href: LINKS.talentleap } }}
    partnerGroup="private"
  />

  <!-- C6 · Mechanism (JobReady@Work) -->
  <MechanismBand
    title="JobReady@Work: Built Around Your Roles"
    positioning={POSITIONING.employers}
    lead="JobReady@Work is corporate training custom-developed for each organization."
    blocks={[
      { label: 'Assess', title: 'Needs Assessment', text: 'Scopes the skills and the team size before anything is built.', icon: 'search' },
      { label: 'Design', title: 'Customized Solution and Curriculum', text: 'A comprehensive curriculum built for your organization.', icon: 'pen' },
      { label: 'Deliver', title: 'Interactive Workshops', text: 'Soft-skills and hard-skills tracks, including preparation for an industry certification where a track offers one.', icon: 'users' },
      { label: 'Measure', title: 'Progress Evaluation and Support', text: 'Post-training support and a progress evaluation, so outcomes are measurable.', icon: 'chart-bar' },
    ]}
    link={{ label: 'About JobReady@Work', href: LINKS.work }}
  />
  <SubBand>
    <Callout eyebrow="Talent">
      <p data-fact="IN-04">Job-ready candidates are supplied through CodersTrust’s placement team. The employer and gig-work (Earn) marketplace is in pre-launch and will add a self-serve hiring channel.</p>
    </Callout>
  </SubBand>

  <!-- C8 · Features to benefits -->
  <FeaturesTable
    title="What You Get, and What It Means for Your Business"
    rows={[
      {
        feature: 'A placement team, plus trainees from employer-demand certification tracks',
        means: 'a short route to job-ready candidates.',
        outcome: 'Job-ready candidates for your roles',
        relieves: 'You cannot find the digital talent you need',
      },
      {
        feature: 'An AI-ready curriculum, with each track’s AI content and work-entry plan agreed before enrollment',
        means: 'hires and trainees already work with AI tools.',
        outcome: 'People ready to work with AI tools',
        relieves: 'Hiring alone does not close the gap',
      },
      {
        feature: 'JobReady@Work customized curriculum and interactive workshops',
        means: 'your team learns on tasks from your own roles.',
        outcome: 'A team trained on its own tasks',
        relieves: 'Your teams need upskilling for AI workflows',
      },
    ]}
  />
  <HowItWorks steps={steps} />

  <!-- C9 · Objections -->
  <FAQBand
    audience="employers"
    ids={FAQ_IDS}
    title="Questions Employers Ask"
    lead="Right for you if you want tracks built around the skills your roles need. Talent requests are scoped against the experience and credentials available in the candidate pool."
  />

  <!-- C10 · Differentiation -->
  <ComparisonBand
    title="Compare the Approaches."
    lead="Preparation for a recognized credential is built into each track, and delivery uses infrastructure that already exists. Provision varies by provider and program."
  />

  <!-- C11 · Offer -->
  <OfferCards
    title="Choose How to Work with Us."
    cards={[
      { eyebrow: 'Option 1', title: 'A Training Program Scoped to Your Team', text: 'Custom curriculum and interactive workshops, built from a needs assessment of your roles.', facts: ['IN-10'] },
      { eyebrow: 'Option 2', title: 'Talent Through the Placement Team', text: 'Job-ready candidates through CodersTrust’s placement team. Requests are scoped against the experience and credentials available in the candidate pool.', facts: ['IN-04'] },
    ]}
  />

  <!-- C7 · Proof, moved below the employer offer (as on JobReady@Work); the youth-program evidence keeps its own label. -->
  <ProofBand
    title="Independent Evidence and Survey Results"
    eyebrow="From CodersTrust’s Youth Programs (Not Corporate Training)"
    headlineFact="RC-01"
    trialScope={TRIAL_SCOPE.work.text}
    statIds={['RC-02', 'RC-04']}
    chartId="OC-01"
    links={[
      { label: 'The randomized trial', href: LINKS.trial },
      { label: 'Outcomes 2026', href: LINKS.outcomes },
    ]}
  >
    <EvidenceList
      heading="What Surveyed Completers Report"
      items={[
        { facts: ['OC-01'], lead: 'From CodersTrust’s youth programs:', text: SURVEY_EMPLOYMENT.text },
        { facts: ['OC-07'], lead: 'From CodersTrust’s youth programs:', text: `Among valid respondents, ${mainIncome}.` },
        { facts: ['PD-10'], text: 'Certification tracks are set from employer demand, per country.' },
      ]}
    />
  </ProofBand>

  <!-- C12 · Risk reversal (immediately before C13) -->
  <RiskReversalBand
    title="Start with a Pilot Team. Decide on Evidence."
    lead="Success measures are agreed before you start (completion, certification and the skills you name) and checked in the progress evaluation."
    points={[
      { icon: 'rocket', title: 'Pilot Team First', text: 'Start with one team and see what changes.' },
      { icon: 'target', title: 'Measures You Set', text: 'Completion, certification and the skills you name are agreed before you start.' },
      { icon: 'handshake', title: 'Scaling Up Is Your Decision', text: 'You choose whether and how far to scale.' },
      { icon: 'shield', title: 'Independent Evaluation Welcome', text: 'We support third-party evaluation of outcomes.' },
    ]}
  />

  <!-- C13 · Call to action: one solid primary, one outline -->
  <DualCtaBand
    id="cta"
    heading="Let’s Plan Your First Team Program."
    primary={{ label: primary.label, href: primary.href }}
    secondary={{ label: talent.label, href: talent.href }}
    micro={MICRO_COMMITMENT}
  />

  <!-- C14 · Next steps -->
  <StepsBand
    title="What Happens After You Say Yes"
    steps={[
      { title: 'Discovery Session', text: 'A conversation about your roles, team size and timeline.' },
      { title: 'Needs Assessment', text: 'We scope the skills your roles need.' },
      { title: 'Agreement', text: 'Scope, schedule and success measures are agreed.' },
      { title: 'First Workshop or Cohort', text: 'Training starts with your pilot team.' },
      { title: 'Progress Evaluation', text: 'Results are checked against the measures you set.' },
    ]}
  />
  <Reinforcement reminder={false} />

  <Section pad="sm" aria-label="Notes and sources"><Sources /></Section>
  <PageEnhancements />
</LandingLayout>
