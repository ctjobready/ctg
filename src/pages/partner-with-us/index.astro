---
// P2 Partner with us hub (doc 06 P2, T2): audience cards → why partner → how partnering works (StepFlow) → due diligence (governance) → FAQ → CTA band.
// WP30c (owner direction 2026-10-14, "less is more"): the hub chooses a route and does not repeat the route pages. The RACI table (an internal-report view of
// roles) and the "Protected by Design" band (the Due Diligence band already states safeguarding and links to Governance) are gone; four FAQs, not six.
// WP35 (cycle-12 review): the hero's one button jumps to the route cards ("Choose Your Route"), instead of opening an email that skips the chooser; the second email button ("Not Sure? Email Us Your Goals") and its
// helper line are gone, so the closing call to action holds the page's one email button; the reporting band is two sentences and a link (the route pages state their own reporting).
// WP36 (cycle-13 review): "Choose Your Route" is the hero button only; the route cards' section label is "Partnership Routes" (the H2 keeps "Which Route Is Yours?").
// WP51 (cycle-26 review): the hero button reads "See Partnership Routes" (a label for where it goes, as the route cards' section label is "Partnership Routes"); its anchor (#audiences) is unchanged.
// WP45 (cycle-21 review): the hub stacked reporting and safeguarding three times (the "Monthly Reports and Quarterly Reviews" band, the due-diligence cards and two FAQs). The band (#review-cycle) and the FAQs "How Do You Prove Outcomes?" and
// "What About Safeguarding and Data Protection?" are gone; the due-diligence view states both once and links to Governance, and every route page answers the rest. The FAQ block is two questions.
// WP48 (cycle-23 review, item 17): the Governments card no longer says "national programs for youth employment" (a 100,000+ national program is a design option CodersTrust has not yet delivered); it states what the route offers, as the nav.ts menu blurb does.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBand from '../../components/sections/HeroBand.astro';
import DefinitionBand from '../../components/sections/DefinitionBand.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import StepFlow from '../../components/ui/StepFlow.astro';
import CTABand from '../../components/ui/CTABand.astro';
import CategoryCard from '../../components/system/CategoryCard.astro';
import Icon from '../../components/system/Icon.astro';
import Tone from '../../components/pages/home/Tone.astro';
import WhyPartner from '../../components/pages/hub/WhyPartner.astro';
import { grantStartSteps } from '../../components/pages/partners/partners';
import FaqBlock from '../../components/pages/hub/FaqBlock.astro';
import { MICRO_COMMITMENT, READ_THE_EVIDENCE } from '../../data/copy';
import { cta } from '../../lib/mailto';
import DueDiligenceView from '../../components/pages/hub/DueDiligenceView.astro';
import { faqJsonLd } from '../../lib/faq';
import { pageUrl, ref, webPage, ORG_ID } from '../../lib/schema';
import { linkAttrs } from '../../lib/url';

// Compact cross-audience FAQ: the two questions every partner type asks before it starts (the country and the cost). The proof (Q3) and safeguarding (Q9) answers are in the due-diligence view below and on the route pages (WP45).
const HUB_FAQ = ['Q1', 'Q8'];
const path = '/partner-with-us/';
const title = 'Partner with Us';
// WP32 (cycle-9 review): the hub routes more than cohorts (campus skills, team training, hiring, the JobReady platform), so the hero asks for the choice of partnership and does not
// describe a cohort; each route page states what its own partnership delivers, with outcome tracking scope-conditional as agreed in the program scope (PD-02).
const BLUF = 'Choose a partnership for youth employment, campus skills, team training, hiring or JobReady’s staged rollout.';
const description = 'Partner with CodersTrust on youth employment, campus skills, team training, hiring or JobReady’s staged rollout. Pick your route and talk to us.';
if (description.length > 155) throw new Error(`Hub meta description is ${description.length} characters (max 155)`);
const discovery = cta('discovery');

// Seven decision-led route cards (a headline that names the decision, then who it is for), in the order of the nav menu (src/data/nav.ts). WP27: Investors is
// a peer route card (it was a link in the "Not sure where you fit?" helper), and the seventh card takes the last row on its own (see .hub__routes).
const audiences = [
  { title: 'Prove Delivery in Your Portfolio', icon: 'globe', href: '/partner-with-us/development-partners/', text: 'For development partners and NGOs: evidence-led delivery for your portfolio.' },
  { title: 'Turn Existing Labs into a Workforce Pipeline', icon: 'landmark', href: '/partner-with-us/governments/', text: 'For ministries and public agencies: curriculum, trainer training and phased delivery.' },
  { title: 'Fund Tracked Paths to Earnings', icon: 'heart-handshake', href: '/partner-with-us/foundations/', text: 'For foundations and CSR teams: fund outcomes you can track.' },
  { title: 'Prepare Students and Graduates for Work', icon: 'graduation-cap', href: '/partner-with-us/universities/', text: 'For universities and colleges: JobReady@Campus alongside the degree.' },
  { title: 'Build AI-Ready Teams and Hire Talent', icon: 'briefcase', href: '/partner-with-us/employers/', text: 'For employers: train your team or hire job-ready talent.' },
  { title: 'Deliver Programs in Your Community', icon: 'map-pin', href: '/partner-with-us/local-partners/', text: 'For Bangladeshi NGOs, colleges, chambers and associations delivering locally.' },
  { title: 'Back JobReady’s Staged Rollout', icon: 'trending-up', href: '/partner-with-us/investors/', text: 'For impact investors: JobReady, CodersTrust’s digital learning and earning platform.' },
];

// Partnering steps: the weeks and the cohort window are read from PD-04 (never retyped); WP29: each step heading names its starting point. WP49 (cycle-24 review): the four steps and their one-line descriptions are grantStartSteps(), the source Home's closing band reads too.
const steps = grantStartSteps();

const jsonLd = [
  webPage({ path, name: `${title} | CodersTrust`, description, type: 'CollectionPage' }),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl(path)}#audiences`,
    name: 'Partnership routes',
    itemListElement: audiences.map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.title, url: pageUrl(a.href) })),
    isPartOf: ref(ORG_ID),
  },
  faqJsonLd('all', path, HUB_FAQ),
];
---

<BaseLayout title={title} description={description} breadcrumbs={[{ label: 'Partner with Us' }]} jsonLd={jsonLd}>
  <Tone cmf="HERO">
    <HeroBand variant="inner" audience="Partnerships" title="Partner with Us to Turn Training into Paid Work" lead={BLUF} cta={{ label: 'See Partnership Routes', href: '#audiences', icon: 'arrow-down' }} artSeed="partner-hub" />
  </Tone>

  <DefinitionBand />

  <Tone cmf="AUDIENCES">
    <Section id="audiences" aria-labelledby="audiences-h">
      <SectionHeader id="audiences-h" eyebrow="Partnership Routes" title="Which Route Is Yours?" lead="Each route has its own evidence, offer and next step." />
      <div class="grid-cards hub__routes">
        {audiences.map((a) => <CategoryCard title={a.title} icon={a.icon} text={a.text} href={a.href} />)}
      </div>
      <p class="hub__programs" data-reveal>
        <span>Already know the program you need? </span><a class="link" href={linkAttrs('/programs/').href}>See Programs<Icon name="arrow-right" size={16} /></a>
      </p>
    </Section>
  </Tone>

  <WhyPartner />

  <Tone cmf="HOW" tone="airy">
    <Section id="how-partnering-works" aria-labelledby="how-h">
      <SectionHeader id="how-h" eyebrow="For Grant-Funded Supported Cohorts" title="Your First 90 Days" lead="Four steps from first conversation to first cohort. This timing is for grant-funded pilots; public procurement follows the agency’s own timeline." />
      <div data-fact="PD-04">
        <StepFlow steps={steps} />
      </div>
    </Section>
  </Tone>

  <Tone cmf="DILIGENCE" tone="ice"><DueDiligenceView /></Tone>

  <Tone cmf="FAQ">
    <FaqBlock id="faqs" audience="all" ids={HUB_FAQ} tone="white" title="Partner FAQs" lead="Two questions every partner asks. Each route page answers the rest." />
  </Tone>

  <Tone cmf="CTA">
    <CTABand
      id="cta"
      tone="klein"
      heading="Let’s Find the Right Partnership"
      text="Tell us your goals, and we will help you find the right partnership route."
      cta={{ label: discovery.label, href: discovery.href }}
      secondary={{ label: READ_THE_EVIDENCE, href: '/impact/' }}
      micro={MICRO_COMMITMENT}
    />
  </Tone>

</BaseLayout>

<style>
  /* Seven route cards: three columns (two from 768 px) would leave the seventh alone in its row beside empty cells, so it takes that row across as a
     wide card: icon beside the title and its line, the layout the card has on a phone. */
  @media (min-width: 768px) {
    .hub__routes > :global(.cat:last-child) {
      grid-column: 1 / -1;
      grid-row: auto;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'icon title'
        'icon text';
      grid-template-rows: auto auto;
      align-items: center;
      column-gap: var(--space-lg);
      row-gap: var(--space-xs);
      min-height: 0;
      padding: 24px 30px;
    }
    .hub__routes > :global(.cat:last-child .cat__icon) {
      align-self: center;
      margin-bottom: 0;
    }
    .hub__routes > :global(.cat:last-child .cat__title) {
      align-self: end;
    }
  }
  .hub__programs {
    margin: var(--space-md) 0 0;
    color: var(--on-surface-variant);
  }
</style>
