---
// P2 Partner with us hub (doc 06 P2, T2): audience cards → how partnering works (StepFlow + RACI) → what funders
// receive monthly → due diligence (governance) → full FAQ Q1–Q14 → CTA band.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBand from '../../components/sections/HeroBand.astro';
import DefinitionBand from '../../components/sections/DefinitionBand.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import StepFlow from '../../components/ui/StepFlow.astro';
import CTABand from '../../components/ui/CTABand.astro';
import CategoryCard from '../../components/system/CategoryCard.astro';
import Icon from '../../components/system/Icon.astro';
import Tone from '../../components/pages/home/Tone.astro';
import RaciTable from '../../components/pages/hub/RaciTable.astro';
import WhyPartner from '../../components/pages/hub/WhyPartner.astro';
import { TRACER_MONTHS, TRACKING_MONTHS } from '../../components/pages/partners/partners';
import ReviewCycle from '../../components/pages/hub/ReviewCycle.astro';
import FaqBlock from '../../components/pages/hub/FaqBlock.astro';
import { MICRO_COMMITMENT, SPEED } from '../../data/copy';
import { fact } from '../../data/facts';
import { cta } from '../../lib/mailto';
import DueDiligenceView from '../../components/pages/hub/DueDiligenceView.astro';
import ProtectedByDesign from '../../components/pages/hub/ProtectedByDesign.astro';
import { faqJsonLd } from '../../lib/faq';
import { pageUrl, ref, webPage, ORG_ID } from '../../lib/schema';
import { linkAttrs } from '../../lib/url';

// Compact cross-audience FAQ: the six questions every partner type asks.
const HUB_FAQ = ['Q1', 'Q3', 'Q4', 'Q8', 'Q9', 'Q10'];
const path = '/partner-with-us/';
const title = 'Partner with Us';
// Tracking is scope-conditional, as on the audience pages: it is part of each program's agreed scope (PD-02), not a blanket promise.
const BLUF = `We co-design youth-employment programs with governments, development partners, foundations, universities, employers and local implementing partners, with outcome tracking for ${TRACKING_MONTHS} months after each course, as agreed in each program’s scope.`;
const description = 'Co-design a youth-employment program with CodersTrust. Pick your route: governments, funders, universities, employers, local partners or impact investors.';
if (description.length > 155) throw new Error(`Hub meta description is ${description.length} characters (max 155)`);
const discovery = cta('discovery');

// Six decision-led route cards (a headline that names the decision, then who it is for), in the order of the nav menu (src/data/nav.ts). Investors
// sit with the "Not sure where you fit?" helper below the grid, so the grid is 3 × 2 with no orphan card.
const audiences = [
  { title: 'Prove Delivery in Your Portfolio', icon: 'globe', href: '/partner-with-us/development-partners/', text: 'For development partners and NGOs: evidence-led delivery for your portfolio.' },
  { title: 'Turn Existing Labs into a Workforce Pipeline', icon: 'landmark', href: '/partner-with-us/governments/', text: 'For ministries and public agencies: national programs for youth employment.' },
  { title: 'Fund Tracked Paths to Earnings', icon: 'heart-handshake', href: '/partner-with-us/foundations/', text: 'For foundations and CSR teams: fund outcomes you can verify.' },
  { title: 'Prepare Students and Graduates for Work', icon: 'graduation-cap', href: '/partner-with-us/universities/', text: 'For universities and colleges: JobReady@Campus alongside the degree.' },
  { title: 'Build AI-Ready Teams and Hire Talent', icon: 'briefcase', href: '/partner-with-us/employers/', text: 'For employers: train your team or hire job-ready talent.' },
  { title: 'Deliver Programs in Your Community', icon: 'map-pin', href: '/partner-with-us/local-partners/', text: 'For Bangladeshi NGOs, colleges, chambers and associations delivering locally.' },
];
const investors = { title: 'Investors', href: '/partner-with-us/investors/' };

// Partnering steps: the weeks and the cohort window are parsed from PD-04 (never retyped).
const pd04 = fact('PD-04');
const wk = [...pd04.text.matchAll(/(Discovery|Co-design|Agreement) wk (\d)/g)].map((m) => m[2]);
const steps = [
  { title: `Discovery · week ${wk[0]}`, text: 'A conversation about your goals, priority groups and timeline.' },
  { title: `Co-Design · week ${wk[1]}`, text: 'We shape tracks, cohorts, safeguarding and reporting with you; each track’s work-entry plan is approved before enrollment.' },
  { title: `Agreement · week ${wk[2]}`, text: 'Scope, schedule and the pilot scorecard are agreed.' },
  { title: `First Cohort Starting Training · ${pd04.stat?.value}`, text: 'Grant-funded pilots: training starts in this window after signing. Monthly reports follow.' },
];

const jsonLd = [
  webPage({ path, name: `${title} | CodersTrust`, description, type: 'CollectionPage' }),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl(path)}#audiences`,
    name: 'Partnership routes',
    itemListElement: [...audiences, investors].map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.title, url: pageUrl(a.href) })),
    isPartOf: ref(ORG_ID),
  },
  faqJsonLd('all', path, HUB_FAQ),
];
---

<BaseLayout title={title} description={description} breadcrumbs={[{ label: 'Partner with Us' }]} jsonLd={jsonLd}>
  <Tone cmf="HERO">
    <HeroBand variant="inner" audience="Partnerships" title="Partner with Us to Move Youth into Paid Digital Work" lead={BLUF} cta={{ label: discovery.label, href: discovery.href }} artSeed="partner-hub" />
  </Tone>

  <DefinitionBand />

  <Tone cmf="AUDIENCES">
    <Section id="audiences" aria-labelledby="audiences-h">
      <SectionHeader id="audiences-h" eyebrow="Choose Your Route" title="Who Are You Partnering As?" lead="Each route has its own evidence, offer and next step." />
      <div class="grid-cards">
        {audiences.map((a) => <CategoryCard title={a.title} icon={a.icon} text={a.text} href={a.href} />)}
      </div>
      <div class="hub__helper" data-reveal>
        <Icon name="message-circle" size={28} strokeWidth={1.5} class="hub__helper-icon" />
        <p class="hub__helper-text"><strong>Not sure where you fit?</strong> Tell us your goals and we will point you to the right route.</p>
        <p class="cluster hub__helper-links">
          <a class="link" href={linkAttrs('/contact/').href}>Talk to Us<Icon name="arrow-right" size={16} /></a>
          <a class="link" href={linkAttrs(investors.href).href}>Impact Investor? See Investors<Icon name="arrow-right" size={16} /></a>
        </p>
        <p class="hub__helper-programs">
          <span>Already know the program you need? </span><a class="link" href={linkAttrs('/programs/').href}>See Programs<Icon name="arrow-right" size={16} /></a>
        </p>
      </div>
    </Section>
  </Tone>

  <WhyPartner />

  <Tone cmf="HOW" tone="airy">
    <Section id="how-partnering-works" aria-labelledby="how-h">
      <SectionHeader id="how-h" eyebrow="How Partnering Works" title="Your First 90 Days" lead="From first conversation to first cohort in four steps, then monthly reports. This timing is for grant-funded pilots; public procurement follows the agency’s own timeline." />
      <div data-fact="PD-04">
        <StepFlow steps={steps} />
      </div>
    </Section>
  </Tone>

  <Tone cmf="REPORTS">
    <ReviewCycle title="Monthly Reports and Quarterly Reviews" scorecard sample={{ label: 'See the Sample Monthly Report on the YouthWIDE Page', href: '/programs/youthwide/' }} />
  </Tone>

  <Tone cmf="DILIGENCE" tone="ice"><DueDiligenceView /></Tone>

  <Tone cmf="SAFEGUARDING" tone="airy"><ProtectedByDesign /></Tone>

  <Tone cmf="FAQ">
    <FaqBlock id="faqs" audience="all" ids={HUB_FAQ} tone="white" title="Partner FAQs" lead="Six questions partners ask before they start. Each audience page answers the rest." />
  </Tone>

  <Tone cmf="ROLES" tone="airy">
    <Section id="who-does-what" aria-labelledby="raci-h">
      <SectionHeader id="raci-h" eyebrow="Roles" title="Who Does What" lead="Who is responsible, accountable, consulted and informed at each step of a partnership." />
      <RaciTable />
    </Section>
  </Tone>

  <Tone cmf="CTA">
    <CTABand
      id="cta"
      tone="klein"
      heading="Let’s Find the Right Partnership"
      text="Tell us your goals and your priority groups, and we will outline a first cohort with you."
      cta={{ label: discovery.label, href: discovery.href }}
      secondary={{ label: 'Read the evidence', href: '/impact/' }}
      urgency={SPEED.text}
      micro={MICRO_COMMITMENT}
    />
  </Tone>

</BaseLayout>

<style>
  .hub__helper {
    margin-top: var(--space-md);
    padding: var(--space-md) var(--space-gutter);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-xs) var(--space-md);
    align-items: center;
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
  }
  .hub__helper > p {
    margin: 0;
  }
  .hub__helper :global(.hub__helper-icon) {
    color: var(--primary);
  }
  .hub__helper-text {
    color: var(--on-surface);
  }
  .hub__helper-programs {
    grid-column: 2;
    color: var(--on-surface-variant);
  }
  .hub__helper-links {
    grid-column: 2;
    gap: var(--space-xs) var(--space-lg);
  }
  @media (min-width: 900px) {
    .hub__helper {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .hub__helper-links {
      grid-column: auto;
    }
    .hub__helper-programs {
      grid-column: 2 / -1;
    }
  }
</style>
