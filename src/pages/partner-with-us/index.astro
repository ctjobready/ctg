---
// P2 Partner with us hub (doc 06 P2, T2): audience cards → how partnering works (StepFlow + RACI) → what funders
// receive monthly → due diligence (governance) → full FAQ Q1–Q14 → CTA band.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBand from '../../components/sections/HeroBand.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import StepFlow from '../../components/ui/StepFlow.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Button from '../../components/system/Button.astro';
import CategoryCard from '../../components/system/CategoryCard.astro';
import Icon from '../../components/system/Icon.astro';
import Sources from '../../components/facts/Sources.astro';
import FootnoteMarker from '../../components/facts/FootnoteMarker.astro';
import Tone from '../../components/pages/home/Tone.astro';
import CopyBlock from '../../components/pages/home/CopyBlock.astro';
import RaciTable from '../../components/pages/hub/RaciTable.astro';
import MonthlyReports from '../../components/pages/hub/MonthlyReports.astro';
import FaqBlock from '../../components/pages/hub/FaqBlock.astro';
import { GOVERNANCE, MICRO_COMMITMENT, SPEED } from '../../data/copy';
import { navGroups } from '../../data/nav';
import { fact } from '../../data/facts';
import { cta } from '../../lib/mailto';
import { faqJsonLd } from '../../lib/faq';
import { pageUrl, ref, webPage, ORG_ID } from '../../lib/schema';
import { linkAttrs } from '../../lib/url';

const path = '/partner-with-us/';
const title = 'Partner with Us';
const BLUF =
  'We co-design youth-employment programs with governments, development partners, foundations, universities, employers and local implementing partners — and track every cohort’s outcomes for 12 months after each course.';
const description = 'Co-design a youth-employment program with CodersTrust. Choose your route: governments, funders, universities, employers, local partners or investors.';
if (description.length > 155) throw new Error(`Hub meta description is ${description.length} characters (max 155)`);
const discovery = cta('discovery');

// Audience cards in the order of doc 06 P2. Descriptions reuse nav.ts where the menu already says it.
const navText = (href: string) => navGroups.find((g) => g.id === 'partner')?.items.find((i) => i.href === href)?.description;
const audiences = [
  { title: 'Development partners & NGOs', icon: 'globe', href: '/partner-with-us/development-partners/' },
  { title: 'Governments', icon: 'landmark', href: '/partner-with-us/governments/' },
  { title: 'Foundations & CSR', icon: 'heart-handshake', href: '/partner-with-us/foundations/' },
  { title: 'Local partners (Bangladesh)', icon: 'map-pin', href: '/partner-with-us/local-partners/', text: 'NGOs, colleges and chambers delivering locally.' },
  { title: 'Universities & colleges', icon: 'graduation-cap', href: '/partner-with-us/universities/' },
  { title: 'Employers', icon: 'briefcase', href: '/partner-with-us/employers/' },
  { title: 'Investors', icon: 'trending-up', href: '/investors/' },
].map((a) => ({ ...a, text: a.text ?? navText(a.href) }));

// Partnering steps: the weeks and the cohort window are parsed from PD-04 (never retyped).
const pd04 = fact('PD-04');
const wk = [...pd04.text.matchAll(/(Discovery|Co-design|Agreement) wk (\d)/g)].map((m) => m[2]);
const steps = [
  { title: `Discovery · week ${wk[0]}`, text: 'A conversation about your goals, priority groups and timeline.' },
  { title: `Co-design · week ${wk[1]}`, text: 'We shape tracks, cohorts, safeguarding and reporting with you; each track’s work-entry plan is approved before enrollment.' },
  { title: `Agreement · week ${wk[2]}`, text: 'Scope, schedule and the pilot scorecard are agreed.' },
  { title: `First cohort · ${pd04.stat?.value}`, text: 'Grant-funded pilots: training starts in this window after signing. Monthly reports follow.' },
];

const diligence = cta('diligence');
const governance = linkAttrs('/about/governance/');

const jsonLd = [
  webPage({ path, name: `${title} | CodersTrust`, description, type: 'CollectionPage' }),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl(path)}#audiences`,
    name: 'Partnership routes',
    itemListElement: audiences.map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.title, url: pageUrl(a.href) })),
    isPartOf: ref(ORG_ID),
  },
  faqJsonLd('all', path),
];
---

<BaseLayout title={title} description={description} breadcrumbs={[{ label: 'Partner with us' }]} jsonLd={jsonLd}>
  <Tone cmf="HERO">
    <HeroBand variant="inner" audience="Partnerships" title="Partner with CodersTrust" lead={BLUF} cta={{ label: discovery.label, href: discovery.href }} artSeed="partner-hub" />
  </Tone>

  <Tone cmf="AUDIENCES">
    <Section id="audiences" aria-labelledby="audiences-h">
      <SectionHeader id="audiences-h" eyebrow="Choose your route" title="Who are you partnering as?" lead="Each route has its own evidence, offer and next step." />
      <div class="grid-cards grid-cards--4">
        {audiences.map((a) => <CategoryCard title={a.title} icon={a.icon} text={a.text} href={a.href} />)}
        <CategoryCard title="Not sure where you fit?" icon="message-circle" text="Tell us your goals and we will point you to the right route." href="/contact/" />
      </div>
    </Section>
  </Tone>

  <Tone cmf="HOW" tone="airy">
    <Section id="how-partnering-works" aria-labelledby="how-h">
      <SectionHeader id="how-h" eyebrow="How partnering works" title="From first conversation to first cohort" lead="Four steps, then monthly reports. Who does what is clear from the start." />
      <div data-fact="PD-04">
        <StepFlow steps={steps} />
      </div>
      <p class="hub__fn text-muted t-body-xs">Timing<FootnoteMarker id="PD-04" footnote={false} />: for grant-funded pilots. Public procurement follows the agency’s own timeline.</p>
      <h3 class="t-heading-xl hub__h3">Who does what</h3>
      <RaciTable />
    </Section>
  </Tone>

  <Tone cmf="REPORTS">
    <MonthlyReports sample={{ label: 'See the sample monthly report on the YouthWIDE page', href: '/programs/youthwide/' }} />
  </Tone>

  <Tone cmf="DILIGENCE" tone="ice">
    <Section id="due-diligence" aria-labelledby="dd-h">
      <div class="dd">
        <div class="dd__copy">
          <SectionHeader id="dd-h" eyebrow="Due diligence" title="Know who you are contracting with" />
          <CopyBlock block={GOVERNANCE} class="dd__text" />
          <div class="cluster dd__actions">
            <a class="link" href={governance.href}>Read about governance and accountability<Icon name="arrow-right" size={16} /></a>
            <Button variant="outline" size="sm" href={diligence.href}>{diligence.label}</Button>
          </div>
        </div>
        <Icon name="shield" size={96} strokeWidth={1} class="dd__icon" />
      </div>
    </Section>
  </Tone>

  <Tone cmf="FAQ">
    <FaqBlock id="faq" audience="all" tone="white" title="Partner FAQs" lead="Fourteen questions partners ask before they start, answered in full." />
  </Tone>

  <Tone cmf="CTA">
    <CTABand
      id="cta"
      tone="klein"
      heading="Let’s find the right partnership."
      text="Tell us your goals and your priority groups, and we will outline a first cohort with you."
      cta={{ label: discovery.label, href: discovery.href }}
      secondary={{ label: 'Read the evidence', href: '/impact/' }}
      urgency={SPEED.text}
      micro={MICRO_COMMITMENT}
    />
  </Tone>

  <Section pad="sm" aria-label="Notes and sources"><Sources /></Section>
</BaseLayout>

<style>
  .hub__fn {
    margin: var(--space-md) 0 0;
  }
  .hub__h3 {
    margin: var(--space-lg) 0 var(--space-md);
    color: var(--secondary);
  }
  .dd {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  .dd__copy {
    display: grid;
    gap: var(--space-md);
  }
  .dd__copy :global(.sh) {
    margin-bottom: 0;
  }
  .dd__text {
    margin: 0;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--on-surface);
    max-width: 44rem;
  }
  .dd__actions {
    gap: var(--space-md) var(--space-lg);
  }
  .dd :global(.dd__icon) {
    display: none;
    color: var(--primary);
  }
  @media (min-width: 900px) {
    .dd {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .dd :global(.dd__icon) {
      display: block;
    }
  }
</style>
