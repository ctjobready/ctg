---
// TalentLEAP /our-model/talentleap/. WP30d (owner direction 2026-10-14: less is more): the three "how it works" rows and the vendor-certification paragraph repeat the stage pipeline,
// the mentoring caveat box and the nine-trials context line are report-like, and the FAQ keeps the three questions that bear on the decision (how it differs from an online course
// platform, what happens when funding ends, whether there is independent evidence), with short answers.
import LongformLayout from '../../../layouts/LongformLayout.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import Icon from '../../../components/system/Icon.astro';
import { fact } from '../../../data/facts';
import Stat from '../../../components/system/Stat.astro';
import ReportSection from '../../../components/pages/impact/ReportSection.astro';
import NextStep from '../../../components/pages/impact/NextStep.astro';
import CompetencyLevels from '../../../components/pages/model/CompetencyLevels.astro';
import StagePipeline from '../../../components/pages/model/StagePipeline.astro';
import { STAGE_STEPS } from '../../../components/pages/model/stagePipeline';
import { articleNode, desc, title, discoveryCta } from '../../../components/pages/impact/page-utils';
import { describedList } from '../../../components/pages/impact/jsonld';
import { DISCOVERY_SESSION_ASK, MICRO_COMMITMENT } from '../../../data/copy';
import { faqItems } from '../../../lib/faq';
import { faqPage } from '../../../lib/schema';
import { linkAttrs } from '../../../lib/url';

const path = '/our-model/talentleap/';
const descriptor = 'CodersTrust’s Competency-Based Talent Development Model';
// WP36 (cycle-13 review): the opening no longer implies that several levels are taught. IN-06 and IN-08: Competent is the first level; Proficient and Expert are planned. The model's own description ("CodersTrust’s
// competency-based talent development model", IN-06) is the eyebrow above the heading, so the opening goes straight to what the model does.
// WP64 (cycle-36 review, Claude): "The first published TalentLEAP level is Competent; Proficient and Expert levels are planned." (it said "Competent is the published first level; Proficient and Expert are planned.", with no word that these are TalentLEAP's levels); IN-06 and IN-08 are unchanged.
const bluf = 'TalentLEAP organizes learning around assessed skill units and career paths. The first published TalentLEAP level is Competent; Proficient and Expert levels are planned. Learners move through three stages, Learn, Earn and Prosper, with three months of milestone-based mentoring after the course.';
const description = desc('TalentLEAP is CodersTrust’s competency-based model: assessed skill units, career paths and Learn, Earn, Prosper with three months of mentoring.');

// The steps of the visible stage pipeline (StagePipeline), for the structured data. WP50 (cycle-25 review): read from the pipeline's own source (components/pages/model/stagePipeline.ts), where they were restated by hand;
// the last one ends "Further TalentLEAP levels are planned."
const steps = STAGE_STEPS;
const levels = [
  { name: 'Level 1 · Competent', description: 'Introduction to Digital Marketing with Google and Meta Certifications: three months of mentorship by an experienced professional, three months of membership in a digital-marketing expertise community and bonus mini-courses in essential business and leadership skills. Proficient and Expert levels are planned.' },
];
// At a Glance tiles (WP22): each leads with its number; label and note are the register's own glance wording (OC-01) or stat label and detail (RC-02).
const stat = (id: string) => {
  const s = fact(id).stat;
  if (!s) throw new Error(`TalentLEAP: fact ${id} has no stat`);
  return s;
};
const glance = [
  { id: 'OC-01', value: stat('OC-01').value, label: stat('OC-01').glance?.label ?? stat('OC-01').label, note: stat('OC-01').glance?.note },
  { id: 'RC-02', value: stat('RC-02').value, label: stat('RC-02').label, note: stat('RC-02').detail },
];
// The shared answers for the three questions, with the page's own scope. The Independent Evidence answer already spells out the evaluator (faqs.ts, WP80), so this page checks that it still does rather than rewriting it.
const faq = faqItems('foundations', ['Q14', 'Q10', 'Q4']).map((f) => {
  if (f.q !== 'Is There Independent Evidence?') return f;
  if (!f.a.includes('The BRAC Institute of Governance and Development (BIGD) at BRAC University ran')) throw new Error('TalentLEAP: the Independent Evidence FAQ changed; keep the evaluator spelled out once');
  return f;
});
const jsonLd = [
  articleNode({ path, headline: 'TalentLEAP: A Skill-by-Skill Path from Learning to Earning', description, datePublished: '2026-10-08', dateModified: '2026-10-31', author: 'CodersTrust Learning Design', about: { '@type': 'Thing', name: 'TalentLEAP' } }),
  describedList('How TalentLEAP Works', steps.map((s) => ({ name: s.name, description: s.text })), `${path}#steps`),
  describedList('TalentLEAP example: Digital Marketing career path levels', levels, `${path}#levels`),
  faqPage(faq, path),
];
const toc = [
  { id: 'glance', label: 'At a Glance' },
  { id: 'how', label: 'How TalentLEAP Works' },
  { id: 'example', label: 'Example: The Digital Marketing Career Path' },
  { id: 'different', label: 'What Makes TalentLEAP Different' },
  { id: 'results', label: 'Results from CodersTrust Programs' },
  { id: 'faq', label: 'Questions About TalentLEAP' },
];
const d = discoveryCta();
---

<LongformLayout
  title={title('TalentLEAP Model')}
  heading="TalentLEAP: A Skill-by-Skill Path from Learning to Earning"
  eyebrow={`Our Model · ${descriptor}`}
  lead={bluf}
  description={description}
  path={path}
  updated="2026-10-31"
  toc={toc}
  breadcrumbs={[{ label: 'Our Model', href: '/our-model/' }, { label: 'TalentLEAP' }]}
  jsonLd={jsonLd}
>
  <ReportSection id="glance" title="At a Glance">
    <ul class="tl__tiles" role="list">
      {glance.map((g) => <li class="tl__tile" data-fact={g.id}><Stat value={g.value} label={g.label} note={g.note} count={false} /></li>)}
    </ul>
    <p class="tl__scope">These results describe CodersTrust programs, not TalentLEAP’s features on their own: neither the survey nor the trial isolates one part of the model.</p>
  </ReportSection>

  <ReportSection id="how" title="How TalentLEAP Works">
    <StagePipeline title="The Stage Pipeline" id="stage-pipeline" />
  </ReportSection>

  <ReportSection id="example" title="Example: The Digital Marketing Career Path">
    <p>TalentLEAP organizes skills into career paths with progressive levels. In this example, Level 1 is Competent; Proficient and Expert are the planned next levels.</p>
    <CompetencyLevels />
  </ReportSection>

  <ReportSection id="different" title="What Makes TalentLEAP Different">
    <ul class="tl__list">
      <li><strong>Competency-based rather than time-based.</strong> Learning is organized around individual skill units that are assessed, not around hours attended alone.</li>
      <li><strong>Milestone-based mentoring.</strong> Mentoring follows milestones toward each track’s agreed work-entry goal, with placement support alongside, and attendance is tracked.</li>
      <li><strong>Demand-led tracks.</strong> Tracks are set from current employer demand in each country, and each track’s work-entry plan is agreed before enrollment.</li>
    </ul>
  </ReportSection>

  <ReportSection id="results" title="Results from CodersTrust Programs">
    <!-- WP58 (cycle-30 review, GPT-6.1 Sol G7): the figures are in At a Glance, above this section, not below it ("The results below are for CodersTrust programs, each labeled with the evidence it rests on (see At a Glance)."). -->
    <p>Today’s 100-hour tracks have not yet been independently evaluated. A pilot scorecard tracks agreed outcomes; independent evaluation is welcome.</p>
    <p class="tl__links"><a class="link" href={linkAttrs('/impact/outcomes-2026/').href}>Impact Survey 2026<Icon name="arrow-right" size={16} /></a><a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>The Randomized Trial<Icon name="arrow-right" size={16} /></a></p>
  </ReportSection>

  <ReportSection id="faq" title="Questions About TalentLEAP">
    <Accordion items={faq} name="tl-faq" openFirst />
  </ReportSection>

  <NextStep heading="See How TalentLEAP Would Run in Your Program" text={DISCOVERY_SESSION_ASK} cta={{ label: d.label, href: d.href }} secondary={{ label: 'How the model works end to end', href: '/our-model/' }} micro={MICRO_COMMITMENT} />
</LongformLayout>

<style>
  .tl__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }
  .tl__list {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }
  .tl__list li::marker {
    color: var(--primary);
  }
  .tl__scope {
    margin: 0;
    font-size: var(--fs-body-xs);
    color: var(--outline);
  }
  .tl__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  .tl__tile {
    padding: var(--space-gutter);
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
  }
  @media (min-width: 720px) {
    .tl__tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  :global(.tl__sources) {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--outline-variant);
  }
</style>
