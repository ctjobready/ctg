---
import LongformLayout from '../../../layouts/LongformLayout.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import Icon from '../../../components/system/Icon.astro';
import Fact from '../../../components/facts/Fact.astro';
import { fact } from '../../../data/facts';
import CertNote from '../../../components/ui/CertNote.astro';
import Stat from '../../../components/system/Stat.astro';
import ReportSection from '../../../components/pages/impact/ReportSection.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import NextStep from '../../../components/pages/impact/NextStep.astro';
import CompetencyLevels from '../../../components/pages/model/CompetencyLevels.astro';
import StagePipeline from '../../../components/pages/model/StagePipeline.astro';
import { articleNode, desc, title, discoveryCta } from '../../../components/pages/impact/page-utils';
import { describedList } from '../../../components/pages/impact/jsonld';
import { MICRO_COMMITMENT } from '../../../data/copy';
import { faqItems } from '../../../lib/faq';
import { faqPage } from '../../../lib/schema';
import { linkAttrs } from '../../../lib/url';

const path = '/our-model/talentleap/';
const descriptor = 'CodersTrust’s Competency-Based Talent Development Model';
const bluf = 'TalentLEAP is CodersTrust’s competency-based talent development model. It breaks each career path into individual skill units aligned with industry expectations, and teaches and assesses them in graduated competency levels. Learners move through three stages, Learn, Earn and Prosper, with three months of milestone-based mentoring after the course.';
const lowerFirst = (t: string) => t.charAt(0).toLowerCase() + t.slice(1);
const context = `For context, ${lowerFirst(fact('RC-06').text)}.`;
const description = desc('TalentLEAP is CodersTrust’s competency-based model: skill units, graduated levels, and Learn, Earn, Prosper with three months of milestone-based mentoring.');

const steps = [
  { name: 'Assess and Place on a Track', text: 'An accessible readiness assessment (tests and an interview) routes each applicant to a career track or to a foundation track with extra support. A small number may not be selected, and the reasons are reported.' },
  { name: 'Learn Skill Units', text: 'Each track teaches individual skill units, assessed against common rubrics: 100 training hours per certification, half of them hands-on labs.' },
  { name: 'Certify', text: 'Certification exam preparation (exam fee included).' },
  { name: 'Earn', text: 'Three months of milestone-based one-to-one mentoring, with placement support alongside, toward each track’s agreed work-entry goal (for freelance tracks: profile live, first bids, first client).' },
  { name: 'Prosper', text: 'Career paths, continuing professional development and the alumni network. Progressive levels are planned beyond the first published level.' },
];
const levels = [
  { name: 'Level 1 · Competent', description: 'Introduction to Digital Marketing with Google and Meta Certifications: three months of mentorship by an experienced professional, three months of membership of a digital-marketing expertise community and bonus mini-courses in essential business and leadership skills. Proficient and Expert levels are planned.' },
];
// At a Glance tiles (WP22): each leads with its number; label and note are the register's own glance wording (OC-01, OC-05) or stat label and detail (RC-02).
const stat = (id: string) => {
  const s = fact(id).stat;
  if (!s) throw new Error(`TalentLEAP: fact ${id} has no stat`);
  return s;
};
const glance = [
  { id: 'OC-01', value: stat('OC-01').value, label: stat('OC-01').glance?.label ?? stat('OC-01').label, note: stat('OC-01').glance?.note },
  { id: 'OC-05', value: stat('OC-05').value, label: stat('OC-05').glance?.label ?? stat('OC-05').label, note: 'This is a timing measure only.' },
  { id: 'RC-02', value: stat('RC-02').value, label: stat('RC-02').label, note: stat('RC-02').detail },
];
const faqIds = ['Q14', 'Q10', 'Q3', 'Q4', 'Q12', 'Q13'];
// WP24c: the outcomes answer names the supported TalentLEAP cohort, so it reads as scoped (a plan agreed in the program scope), not as a promise for every cohort
const faq = faqItems('foundations', faqIds).map((f) =>
  f.q === 'How Do You Prove Outcomes?' ? { ...f, a: f.a.replace('For every cohort, as agreed in the program scope, we plan', 'For every supported TalentLEAP cohort, as agreed in the program scope, we plan') } : f,
);
const jsonLd = [
  articleNode({ path, headline: 'What Is TalentLEAP? CodersTrust’s Competency-Based Talent Development Model', description, datePublished: '2026-10-08', dateModified: '2026-10-14', author: 'CodersTrust Learning Design', about: { '@type': 'Thing', name: 'TalentLEAP' } }),
  describedList('How TalentLEAP Works', steps.map((s) => ({ name: s.name, description: s.text })), `${path}#steps`),
  describedList('TalentLEAP example: Digital Marketing career path levels', levels, `${path}#levels`),
  faqPage(faq, path),
];
const toc = [
  { id: 'glance', label: 'At a Glance' },
  { id: 'how', label: 'How TalentLEAP Works' },
  { id: 'example', label: 'Example: The Digital Marketing Career Path' },
  { id: 'different', label: 'What Makes TalentLEAP Different' },
  { id: 'results', label: 'Results from CodersTrust Programs' },
  { id: 'faq', label: 'Questions About TalentLEAP' },
];
const d = discoveryCta();
---

<LongformLayout
  title={title('TalentLEAP Model')}
  heading="What Is TalentLEAP?"
  eyebrow={`Our Model · ${descriptor}`}
  lead={bluf}
  description={description}
  path={path}
  updated="2026-10-14"
  toc={toc}
  breadcrumbs={[{ label: 'Our Model', href: '/our-model/' }, { label: 'TalentLEAP' }]}
  jsonLd={jsonLd}
>
  <ReportSection id="glance" title="At a Glance">
    <ul class="tl__tiles" role="list">
      {glance.map((g) => <li class="tl__tile" data-fact={g.id}><Stat value={g.value} label={g.label} note={g.note} count={false} /></li>)}
    </ul>
    <p class="tl__scope">These results describe CodersTrust programs, not TalentLEAP’s features on their own: neither the survey nor the trial isolates one part of the model.</p>
  </ReportSection>

  <ReportSection id="how" title="How TalentLEAP Works">
    <StagePipeline title="The Stage Pipeline" id="stage-pipeline" />
    <dl class="tl__rows">
      <div class="tl__row" data-fact="PD-14 PD-16"><dt>Assess</dt><dd>Applicants first take an accessible readiness assessment (tests and an interview); a small number may not be selected, and the reasons are reported.</dd></div>
      <div class="tl__row" data-fact="PD-01 PD-16"><dt>Learn and Certify</dt><dd>Each track teaches individual skill units, assessed against common rubrics, in 100 training hours per certification, half of them hands-on labs.</dd></div>
      <div class="tl__row" data-fact="PD-01 PD-15"><dt>Earn and Prosper</dt><dd>Three months of milestone-based one-to-one mentoring follow, with placement support alongside, toward each track’s agreed work-entry goal (for freelance tracks: profile live, first bids, first client), then career paths, continuing professional development and the alumni network.</dd></div>
    </dl>
    <p data-fact="PD-01 PD-03 PD-14 PD-15 ID-06">Certifications run by track, for example Meta Blueprint and Google Ads for digital marketing, Adobe Certified Professional for design and video, QuickBooks Online ProAdvisor for digital accounting, PCEP for Python and CWP for web.</p>
    <CertNote />
  </ReportSection>

  <ReportSection id="example" title="Example: The Digital Marketing Career Path">
    <p>TalentLEAP organizes skills into career paths with progressive levels. The Digital Marketing path is the example here: its levels are Competent, Proficient and Expert.</p>
    <CompetencyLevels />
  </ReportSection>

  <ReportSection id="different" title="What Makes TalentLEAP Different">
    <ul class="tl__list">
      <li><strong>Competency-based rather than time-based.</strong> Learning is organized around individual skill units that are assessed, not around hours attended alone.</li>
      <li><strong>Milestone-based mentoring.</strong> Mentoring follows milestones toward each track’s agreed work-entry goal, with placement support alongside, and attendance is tracked.</li>
      <li><strong>Demand-led tracks.</strong> Tracks are set from current employer demand in each country, and each track’s work-entry plan is approved before enrollment.</li>
    </ul>
    <Callout label="Why Mentoring Is Milestone-Based">
      <p data-fact="RC-11"><Fact id="RC-11" /></p>
      <p>The randomized trial’s program included three months of mentoring, but the trial did not isolate the effect of mentoring, so this page makes no claim that mentoring itself is proven.</p>
    </Callout>
    <p data-fact="RC-06">{context}</p>
  </ReportSection>

  <ReportSection id="results" title="Results from CodersTrust Programs">
    <p>The results below are for CodersTrust programs, each labeled with the evidence it rests on (see At a Glance). The current 100-hour track has not yet been independently evaluated. A pilot scorecard tracks agreed outcomes; independent evaluation is welcome.</p>
    <p class="tl__links"><a class="link" href={linkAttrs('/impact/outcomes-2026/').href}>Impact Survey 2026<Icon name="arrow-right" size={16} /></a><a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>The Randomized Trial<Icon name="arrow-right" size={16} /></a></p>
  </ReportSection>

  <ReportSection id="faq" title="Questions About TalentLEAP">
    <Accordion items={faq} name="tl-faq" openFirst />
  </ReportSection>

  <NextStep heading="See How TalentLEAP Would Run in Your Program" text="A discovery session sets priority groups, tracks and the pilot scorecard." cta={{ label: d.label, href: d.href }} secondary={{ label: 'How the model works end to end', href: '/our-model/' }} micro={MICRO_COMMITMENT} />
</LongformLayout>

<style>
  .tl__rows {
    margin: 0;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }
  .tl__row {
    display: grid;
    gap: 2px;
    padding: var(--space-sm) var(--space-md);
    border-left: 4px solid var(--primary);
    background: var(--surface-container-low);
    border-radius: 0 var(--radius-default) var(--radius-default) 0;
  }
  .tl__row dt {
    font-size: var(--fs-body-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-primary-container);
  }
  .tl__row dd {
    margin: 0;
  }
  .tl__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }
  .tl__list {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }
  .tl__list li::marker {
    color: var(--primary);
  }
  .tl__scope {
    margin: 0;
    font-size: var(--fs-body-xs);
    color: var(--outline);
  }
  .tl__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  .tl__tile {
    padding: var(--space-gutter);
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
    border-top: 4px solid var(--primary);
    border-radius: var(--radius-default);
  }
  @media (min-width: 720px) {
    .tl__tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  :global(.tl__sources) {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--outline-variant);
  }
</style>
