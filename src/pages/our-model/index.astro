---
// Our Model hub /our-model/. WP30d (owner direction 2026-10-14: less is more): In Short, the quality-assurance band, the two delivery sub-headings, the trial proof line under the definition,
// the safeguarding FAQ and the long card texts are cut; the delivery design choices are six one-sentence cards, and the FAQ keeps three decision questions with short answers.
// WP37 (cycle-14 review): the connectivity card is headed "Learning with Limited Connectivity" (the body is unchanged), and the timeline answer says the weeks once (a page variant of Q7).
// WP41 (cycle-18 review): the problem line under "What Is CodersTrust?" is PX-01 in its registered wording (young people aged 15–24 with higher-secondary education or more, and the 61–78 million range), as the other pages' tiles carry it;
// "CV writing" in the placement-support card reads "resume writing" (American English; register PD-15).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Button from '../../components/system/Button.astro';
import Icon from '../../components/system/Icon.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import FeatureCard from '../../components/ui/FeatureCard.astro';
import ProgramCard from '../../components/ui/ProgramCard.astro';
import DefinitionBlock from '../../components/pages/programs/DefinitionBlock.astro';
import Fact from '../../components/facts/Fact.astro';
import CopyText from '../../components/pages/impact/CopyText.astro';
import FaqSection from '../../components/pages/programs/FaqSection.astro';
import StagePipeline from '../../components/pages/model/StagePipeline.astro';
import { desc, title, val, discoveryCta } from '../../components/pages/impact/page-utils';
import { SAFEGUARDING, MICRO_COMMITMENT, RCT_HEADLINE } from '../../data/copy';
import type { FaqSource } from '../../components/pages/programs/faq';
import { linkAttrs } from '../../lib/url';

const path = '/our-model/';
const lead = 'One integrated path: assessment, certification-focused training, three months of milestone-based mentoring, placement support and tracked outcomes.';
const description = desc(lead);
// WP25s: the answer under the H1 is the lead above, scoped (as the path section below says) to every supported cohort.
const answer = `${lead.replace(/\.$/, '')}, agreed for each supported cohort.`;
// The trial's evaluator is spelled out once on this page, where the evidence first names it (the register's headline says "BIGD").
const BIGD = 'the BRAC Institute of Governance and Development (BIGD)';
if (!RCT_HEADLINE.text.includes('by BIGD')) throw new Error('Our Model: the RC-01 headline no longer says "by BIGD"; update the expansion');
// WP31: the evidence paragraph ends with the employment result (RC-01's first sentence); the income sentences and the survey result live on the evidence pages it links.
const trial = { ...RCT_HEADLINE, text: RCT_HEADLINE.text.replace('by BIGD', `by ${BIGD}`).split(/(?<=\.)\s+(?=[A-Z])/)[0] };
if (!/more likely to be employed\.$/.test(trial.text)) throw new Error('Our Model: the first sentence of the RC-01 headline no longer ends with the employment result');
// Each card states its register fact (PD-xx) in one or two plain sentences that do not repeat the card's own title. The wording follows the
// register entry; the figures come from it (val) or are copied from it unchanged.
// WP34 (cycle-11 review): "Each certification track includes …" (a certification does not take hours, a track includes them); the scale card is "Local Labs, Coordinated Delivery".
const cards = [
  { icon: 'clipboard-check', title: 'Accessible Readiness Assessment', id: 'PD-14', text: 'Tests and an interview route applicants to a career track or a foundation track. A small number may not be selected, and the reasons are reported.' },
  { icon: 'layers', title: 'Foundation Tracks', id: 'PD-17', text: 'Learners with limited computer or English skills get extra foundation hours and facilitators, scoped in co-design. Their outcomes are reported by track.' },
  { icon: 'wifi', title: 'Learning with Limited Connectivity', id: 'PD-07', text: 'Lessons run on a 1.5 Mbps connection, and 720p lessons can be downloaded for offline viewing.' },
  { icon: 'graduation-cap', title: 'Blended Training with Certification', id: 'PD-01', text: `Each certification track includes ${val('PD-01')} training hours over 3–6 months. Three months of milestone-based one-to-one mentoring follow, with placement support alongside, toward each track’s agreed work-entry goal.` },
  { icon: 'network', title: 'Local Labs, Coordinated Delivery', id: 'PD-06', text: 'From about month 5, programs can run up to 10 certification cohorts in parallel, using existing labs and certified local facilitators.' },
  { icon: 'briefcase', title: 'Placement Support', id: 'PD-15', text: 'Support includes assessment-based career advising, resume writing, job-application and interview preparation, industry internships and apprenticeships, job fairs, employer matching and freelance-marketplace onboarding.' },
];
const d = discoveryCta();

// Three decision questions with short answers; the timeline answer is this page's variant of Q7 (WP37, cycle-14 review: the shared answer's second sentence counted the weeks out again).
const faqSources: FaqSource[] = [
  { q: 'How Do You Prove Outcomes?', html: 'As agreed in the program scope, we plan a baseline at enrollment, follow-up surveys at 3, 6 and 12 months and monthly reports for every cohort, with documentary evidence of earnings where available. Independent evaluation is welcome.', evidence: ['PD-09', 'PD-08', 'RC-01'] },
  { audience: 'variants', id: 'Q7-model' },
  { q: 'What Does It Cost?', html: 'Pricing is set per program, and we share an indicative budget in the discovery session. Standard inclusions run from outreach and selection to placement support and 12 months of outcome tracking, with the exam fee included; devices, stipends, connectivity and independent evaluation are budgeted separately where a program needs them.', evidence: ['PD-02', 'PD-02a', 'PD-05'] },
];
---

<BaseLayout title={title('Our Model')} description={description} path={path} breadcrumbs={[{ label: 'Our Model' }]}>
  <Hero variant="inner" eyebrow="Our Model" title="One Path from Assessment to Career, with Outcomes Tracked" lead={answer} artSeed="our-model-hub">
    <Fragment slot="actions">
      <Button href={d.href} iconEnd="arrow-right">{d.label}</Button>
      <a class="link" href={linkAttrs('/impact/').href}>See the Evidence</a>
    </Fragment>
  </Hero>

  <DefinitionBlock>
    <Fact id="PX-01" as="p" />
  </DefinitionBlock>

  <Section id="path" tone="airy" aria-labelledby="path-h">
    <SectionHeader id="path-h" eyebrow="How It Works" title="Three Stages: Learn, Earn, Prosper" lead="Each stage prepares learners for the next, and every supported cohort agrees an outcome-tracking plan before delivery begins." />
    <p class="om__scope">
      For YouthWIDE and JobReady@Campus supported cohorts, this path is the delivery model. <a class="link" href={linkAttrs('/programs/jobready-work/').href}>JobReady@Work</a>, the <a class="link" href={linkAttrs('/programs/nu-postgraduate-diploma/').href}>NU Postgraduate Diploma</a> and <a class="link" href={linkAttrs('/programs/superkids/').href}>SuperKids</a> have their own delivery structures.
    </p>
    <StagePipeline id="stage-pipeline" />
    <p class="om__link"><a class="link" href={linkAttrs('/our-model/talentleap/').href}>How TalentLEAP Works<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <Section id="delivery" aria-labelledby="delivery-h">
    <SectionHeader id="delivery-h" eyebrow="Delivery Model" title="Designed for Learners Who Start from Different Places" />
    <div class="grid-cards">
      {cards.map((x) => (
        <FeatureCard icon={x.icon} title={x.title}>
          <p class="card__text" data-fact={x.id}>{x.text}</p>
        </FeatureCard>
      ))}
    </div>
  </Section>

  <Section tone="airy" aria-labelledby="safe-h">
    <SectionHeader id="safe-h" eyebrow="Safeguarding and Data" title="Safeguarding and Data Protection Are Agreed per Program" />
    <div class="om__text"><CopyText block={SAFEGUARDING} /></div>
    <p class="om__link"><a class="link" href={linkAttrs('/about/governance/').href}>Governance and Accountability<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <Section tone="ice" aria-labelledby="go-h">
    <SectionHeader id="go-h" eyebrow="Go Deeper" title="Explore TalentLEAP and the JobReady Platform" />
    <div class="grid-cards grid-cards--2">
      <ProgramCard icon="route" title="TalentLEAP" text="CodersTrust’s competency-based talent development model: skill units, career paths and mentoring, with progressive levels planned beyond the first published level." href="/our-model/talentleap/" linkLabel="How TalentLEAP Works" />
      <ProgramCard icon="layout-dashboard" title="JobReady Platform" text="The digital education and employment platform, being built as an AI-native platform and rolling out in stages." href="/our-model/jobready-platform/" linkLabel="See the Rollout Status" />
    </div>
  </Section>

  <Section id="evidence" aria-labelledby="evid-h">
    <SectionHeader id="evid-h" eyebrow="Evidence" title="Evidence Behind the Approach" />
    <div class="om__text"><CopyText block={trial} /></div>
    <p class="om__link"><a class="link" href={linkAttrs('/impact/independent-evaluation/').href}>The Randomized Trial<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <!-- WP24c: a compact partner Q&A band -->
  <FaqSection sources={faqSources} title="Questions Partners Ask" eyebrow="Partner Questions" />

  <CTABand id="cta" heading="Start with a First Cohort" cta={{ label: d.label, href: d.href }} secondary={{ label: 'Read the Evidence', href: '/impact/' }} micro={MICRO_COMMITMENT} />
</BaseLayout>

<style>
  .om__text {
    max-width: var(--measure);
    font-size: var(--fs-body-m);
    margin: 0;
  }
  .om__text > :global(*) {
    margin: 0;
  }
  .om__link {
    margin: var(--space-md) 0 0;
  }
  .om__scope {
    max-width: var(--measure);
    margin: 0 0 var(--space-lg);
    color: var(--on-surface-variant);
  }
</style>
