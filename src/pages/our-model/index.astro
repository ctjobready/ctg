---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Button from '../../components/system/Button.astro';
import Icon from '../../components/system/Icon.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import FeatureCard from '../../components/ui/FeatureCard.astro';
import ProgramCard from '../../components/ui/ProgramCard.astro';
import MechanismBand from '../../components/sections/MechanismBand.astro';
import FootnoteMarker from '../../components/facts/FootnoteMarker.astro';
import Sources from '../../components/facts/Sources.astro';
import CopyText from '../../components/pages/impact/CopyText.astro';
import { desc, title, val, discoveryCta } from '../../components/pages/impact/page-utils';
import { SAFEGUARDING, MICRO_COMMITMENT } from '../../data/copy';
import { linkAttrs } from '../../lib/url';

const path = '/our-model/';
const description = desc('One integrated path: assessment, training with certification preparation, three months of milestone-based mentoring and placement, with outcomes tracked.');
const lead = `One integrated path: an accessible assessment, ${val('PD-01')} training hours per certification, three months of milestone-based mentoring, placement support and outcome tracking after each course.`;
// Each card states its register fact (PD-xx) in plain sentences that do not repeat the card's own title. The wording follows the
// register entry; the figures come from it (val) or are copied from it unchanged.
const delivery = [
  { icon: 'clipboard-check', title: 'Accessible readiness assessment', id: 'PD-14', text: 'Tests and an interview route each applicant to a career track or a foundation track, rather than screening people out. Selection uses a customized psychometric analysis, a written test and an interview, and the reasons for non-selection are reported.' },
  { icon: 'layers', title: 'Foundation tracks', id: 'PD-17', text: 'Learners with limited computer or English skills get extra foundation hours and facilitators, scoped in co-design. Their outcomes are reported by track.' },
  { icon: 'graduation-cap', title: 'Blended training with certification', id: 'PD-01', text: `Each certification takes ${val('PD-01')} training hours (50 hours of lectures and 50 hours of hands-on labs) over 3–6 months. Three months of milestone-based one-to-one mentoring follow, from a live profile to first bids, a first client and the exam, and then learners join the alumni network.` },
  { icon: 'wifi', title: 'Connectivity-light delivery', id: 'PD-07', text: 'Lessons run on a 1.5 Mbps connection, and 720p lessons can be downloaded for offline viewing.' },
  { icon: 'network', title: 'Hub-and-spoke delivery at scale', id: 'PD-06', text: 'Up to 10 certification cohorts run in parallel from about month 5, in classes of 20 (labs) and 40 (lectures). Larger programs use hub-and-spoke delivery with certified local facilitators.' },
  { icon: 'briefcase', title: 'Placement support', id: 'PD-15', text: 'Placement support includes assessment-based career advising, CV writing, job-application and interview preparation, industry internships and apprenticeships, job fairs, employer matching and freelance-marketplace onboarding.' },
];
const qa = 'Programs use common practical-assessment rubrics, sampled moderation of portfolios and assessments, and trainer observation, with remediation before the next cohort. Completion, competency and external-exam results are reported separately.';
const d = discoveryCta();
---

<BaseLayout title={title('Our Model')} description={description} path={path} breadcrumbs={[{ label: 'Our model' }]}>
  <Hero variant="inner" eyebrow="Our model" title="How the CodersTrust model works" lead={lead} artSeed="our-model-hub">
    <Fragment slot="actions">
      <Button href="/impact/" iconEnd="arrow-right">See the evidence</Button>
    </Fragment>
  </Hero>

  <MechanismBand
    id="path"
    title="One integrated path, from assessment to career."
    lead="Learn. Earn. Prosper. Each stage hands the learner to the next, and every course is followed by tracked outcomes."
    blocks={[
      { label: 'Assess and place', title: 'Readiness assessment', text: 'Tests and an interview route each applicant to a career track or a foundation track.', icon: 'clipboard-check' },
      { label: 'Learn', title: 'Skill units and certification', text: 'Blended training on a track set from employer demand, with exam preparation and the exam fee for the learner’s track.', icon: 'graduation-cap' },
      { label: 'Earn', title: 'Mentoring and placement', text: 'Three months of milestone-based one-to-one mentoring, then placement support into local, remote and global work.', icon: 'briefcase' },
      { label: 'Prosper', title: 'Career paths', text: 'Progressive levels, continuing professional development and the alumni network.', icon: 'trending-up' },
    ]}
    link={{ label: 'How TalentLEAP works', href: '/our-model/talentleap/' }}
  />

  <Section aria-labelledby="delivery-h">
    <SectionHeader id="delivery-h" eyebrow="Delivery model" title="How a program is delivered" lead="The design choices that make the path work for learners who start from different places." />
    <div class="grid-cards">
      {delivery.map((x) => (
        <FeatureCard icon={x.icon} title={x.title}>
          <p class="card__text" data-fact={x.id}>{x.text}<FootnoteMarker id={x.id} /></p>
        </FeatureCard>
      ))}
    </div>
  </Section>

  <Section tone="airy" aria-labelledby="qa-h">
    <SectionHeader id="qa-h" eyebrow="Quality" title="Quality assurance" />
    <p class="om__text" data-fact="PD-16">{qa}<FootnoteMarker id="PD-16" /></p>
  </Section>

  <Section aria-labelledby="safe-h">
    <SectionHeader id="safe-h" eyebrow="Safeguarding and data" title="Safeguarding and data are agreed per program" />
    <div class="om__text"><CopyText block={SAFEGUARDING} /></div>
    <p class="om__link"><a class="link" href={linkAttrs('/about/governance/').href}>Governance and accountability<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <Section tone="ice" aria-labelledby="go-h">
    <SectionHeader id="go-h" eyebrow="Go deeper" title="The mechanism and the platform" />
    <div class="grid-cards grid-cards--2">
      <ProgramCard icon="route" title="TalentLEAP" text="CodersTrust’s competency-based talent development model: skill units, graduated levels and mentoring." href="/our-model/talentleap/" linkLabel="How TalentLEAP works" />
      <ProgramCard icon="layout-dashboard" title="JobReady platform" text="The digital education and employment platform, being built as an AI-native platform and rolling out in stages." href="/our-model/jobready-platform/" linkLabel="See the rollout status" />
    </div>
  </Section>

  <CTABand id="cta" heading="Talk to us about a first cohort." cta={{ label: d.label, href: d.href }} secondary={{ label: 'Read the evidence', href: '/impact/' }} micro={MICRO_COMMITMENT} />
  <Section pad="sm" aria-label="Notes and sources"><Sources /></Section>
</BaseLayout>

<style>
  .om__text {
    max-width: var(--measure);
    font-size: var(--fs-body-m);
    margin: 0;
  }
  .om__text > :global(*) {
    margin: 0;
  }
  .om__link {
    margin: var(--space-md) 0 0;
  }
</style>
