---
import LongformLayout from '../../../layouts/LongformLayout.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import Badge from '../../../components/system/Badge.astro';
import Button from '../../../components/system/Button.astro';
import Icon from '../../../components/system/Icon.astro';
import EmailFallback from '../../../components/ui/EmailFallback.astro';
import FactStat from '../../../components/facts/FactStat.astro';
import StatusTag from '../../../components/system/StatusTag.astro';
import EvidenceTag from '../../../components/system/EvidenceTag.astro';
import ReportSection from '../../../components/pages/impact/ReportSection.astro';
import { articleNode, desc, title, fundingCta, discoveryCta } from '../../../components/pages/impact/page-utils';
import { CONTRACT_TOTAL_NOTE_SHORT, MICRO_COMMITMENT, NU_NOT_TRAINED, withoutSince2014 } from '../../../data/copy';
import { fact } from '../../../data/facts';
import { faqItems, faqJsonLd } from '../../../lib/faq';
import { linkAttrs } from '../../../lib/url';

// WP30d (owner direction 2026-10-14: less is more): shorter table notes, one live-today summary, a single roadmap sentence and a shorter "why" line.
// WP49 (cycle-24 review): the "What Is Live Today" callout under the status table is gone: it said again what the table directly above it says (partner portals, marketing automation, customer relationship management and AI chat live; the course storefront
// operating in the first row; the two marketplaces in pre-launch), and adaptive learning is on the roadmap in "Planned Adaptive Learning" below. The table is the one statement of the rollout status.
// WP42 (cycle-19 review): "Planned Adaptive Learning" keeps its heading and says the capability once (the card that repeated it is gone). WP63 (cycle-35 review, GPT-6.1 Sol GP3, polish): it reads "Planned: personalized and adaptive learning based on TalentLEAP’s competency levels, not live yet." (it ended "... competency levels. This is roadmap, not live.").
const path = '/our-model/jobready-platform/';
const JOBREADY = 'https://jobready.global/';
// WP37 (cycle-14 review): "CRM" is written out wherever the live list is printed (the table row, the Q11 answer); the meta description names the two live modules the menu names, since the full list does not fit its 155 characters.
const description = desc('JobReady is CodersTrust’s digital learning and earning platform. Partner portals and AI chat are live; more modules follow.');
// WP41 (cycle-18 review): the answer points to "Rollout Status" (#status) above it instead of listing the status a second time (the table says it).
const faqIds = ['Q11-platform'];
const jsonLd = [
  articleNode({ path, headline: 'JobReady: A Platform Built to Connect Learning to Work', description, datePublished: '2026-10-08', dateModified: '2026-10-29', author: 'CodersTrust', about: { '@type': 'Thing', name: 'JobReady Platform' } }),
  faqJsonLd('foundations', path, faqIds),
];
const faq = faqItems('foundations', faqIds);

// WP60 (cycle-32 review, GLM L7): the course storefront's status is "Live", as the partner portals' and the "Across the Platform" row's are (it said "Operating", the one status in the table that was not Live, Pre-Launch or Roadmap); its note still says "CodersTrust’s course storefront operates at jobready.global."
type Status = 'Live' | 'Pre-Launch' | 'Roadmap';
const tone: Record<Status, 'success' | 'info' | 'eyebrow' | 'sale'> = { Live: 'success', 'Pre-Launch': 'info', Roadmap: 'sale' };
const rows: { job: string; capability: string; status: Status; note: string }[] = [
  { job: 'Train', capability: 'Course storefront at jobready.global', status: 'Live', note: 'CodersTrust’s course storefront operates at jobready.global.' },
  { job: 'Connect to Work', capability: 'Gig-work (Earn) marketplace', status: 'Pre-Launch', note: 'In pre-launch. Until then, placement support comes from CodersTrust’s placement team and marketplaces such as Upwork and Fiverr.' },
  { job: 'Supply Talent', capability: 'Employer marketplace', status: 'Pre-Launch', note: 'In pre-launch. Until then, employers are introduced to candidates through CodersTrust’s placement team.' },
  { job: 'Equip Institutions', capability: 'Partner portals', status: 'Live', note: 'Available to partner institutions for digital delivery.' },
  // The register (IN-04) names these three as live without assigning them to one of the four jobs, so they share one row.
  { job: 'Across the Platform', capability: 'Marketing automation, customer relationship management and AI chat', status: 'Live', note: 'Live as part of the staged rollout.' },
];
// Roadmap: only what the register names (IN-06: TalentLEAP is "the basis for AI-driven personalized and adaptive learning (roadmap)"), in one sentence under its heading (WP42, cycle-19 review: the card repeated the heading and the paragraph).
// Other AI modules (a tutor, a career coach, adaptive assessment, talent matching) are not registered and are not listed.
const toc = [
  { id: 'jobs', label: 'Four Jobs, One Platform' },
  { id: 'status', label: 'Rollout Status' },
  { id: 'why', label: 'The Record Behind JobReady' },
  { id: 'roadmap', label: 'Planned Adaptive Learning' },
  { id: 'faq', label: 'Questions About the Platform' },
];
// WP60 (cycle-32 review, Grok R4): the tile says the 1.5M+ are not CodersTrust's learners: SC-04's label plus NU_NOT_TRAINED (src/data/copy.ts). WP102: headed "Being Onboarded"; the label reads "National University learners being onboarded, not learners trained by CodersTrust".
const onboardBase = fact('SC-04').stat?.label;
if (!onboardBase) throw new Error('jobready-platform: SC-04 no longer has a stat label');
const onboardLabel = `${onboardBase}, ${NU_NOT_TRAINED}`;
// WP64 (cycle-36 review, Grok; the same repeat as the Programs hub's and Investors' tiles): the group is headed "Delivered Since 2014", so the learners tile reads "130,000+ learners trained" (SC-01's label without " since 2014", read from the register).
const learnersLabel = withoutSince2014(fact('SC-01').stat?.label ?? '');
const f = fundingCta();
const d = discoveryCta();
---

<LongformLayout
  title={title('JobReady Platform')}
  heading="JobReady: A Platform Built to Connect Learning to Work"
  eyebrow="Our Model"
  lead="JobReady is CodersTrust’s digital learning and earning platform. Modules are rolling out in stages."
  description={description}
  path={path}
  updated="2026-10-29"
  toc={toc}
  breadcrumbs={[{ label: 'Our Model', href: '/our-model/' }, { label: 'JobReady Platform' }]}
  jsonLd={jsonLd}
>
  <ReportSection id="jobs" title="Four Jobs, One Platform">
    <p data-fact="IN-04">JobReady is designed to do four jobs: train youth through courses that prepare for industry certification, connect learners to local, remote and global work, supply employers with job-ready talent, and give institutions a digital delivery platform. The table below says which capabilities are live today.</p>
  </ReportSection>

  <ReportSection id="status" title="Rollout Status">
    <p>Categories of capability and their status, as of this page’s last update.</p>
    <section class="jr__table" aria-label="Platform capabilities and status" tabindex="0" data-scroll data-stack>
      <table>
        <caption class="sr-only">Platform Capabilities and Their Rollout Status</caption>
        <thead><tr><th scope="col">Job</th><th scope="col">Capability</th><th scope="col">Status</th><th scope="col">Note</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.job}</th>
              <td data-label="Capability">{r.capability}</td>
              <td data-label="Status"><Badge tone={tone[r.status]}>{r.status}</Badge></td>
              <td data-label="Note">{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
    <p><a class="link" href={JOBREADY} rel={linkAttrs(JOBREADY).rel}>Visit jobready.global<Icon name="arrow-up-right" size={16} /><span class="sr-only"> (opens JobReady.global)</span></a></p>
  </ReportSection>

  <!-- WP46 (cycle-22 review): the band shows CodersTrust's record (delivered, being onboarded, contracted), not evidence that institutions adopt JobReady, so the heading says so. The id stays: tests and deep links use #why. -->
  <ReportSection id="why" title="The Record Behind JobReady">
    <p data-fact="IN-04">JobReady builds on CodersTrust’s delivery record, its role with National University and its institutional reach.</p>
    <!-- WP25s: three labelled groups, so the National University onboarding figure (not CodersTrust-trained learners) never reads as part of "Delivered". WP102: the middle group is "Being Onboarded". -->
    <div class="jr__why">
      <div class="jr__whystat"><h3 class="jr__whyh">Delivered Since 2014</h3><StatusTag status="Delivered" /><FactStat id="SC-01" label={learnersLabel} /></div>
      <div class="jr__whystat"><h3 class="jr__whyh">Being Onboarded</h3><FactStat id="SC-04" label={onboardLabel} /></div>
      <div class="jr__whystat"><h3 class="jr__whyh">Contracted Scope</h3><EvidenceTag type="Contract Scope" /><FactStat id="SC-06" /><p class="jr__whynote" data-fact={CONTRACT_TOTAL_NOTE_SHORT.facts.join(' ')}>{CONTRACT_TOTAL_NOTE_SHORT.text}</p></div>
    </div>
    <p class="jr__links">
      <a class="link" href={linkAttrs('/our-model/').href}>How the Model Works<Icon name="arrow-right" size={16} /></a>
      <a class="link" href={linkAttrs('/our-model/talentleap/').href}>How TalentLEAP Works<Icon name="arrow-right" size={16} /></a>
      <a class="link" href={linkAttrs('/impact/').href}>See the Evidence<Icon name="arrow-right" size={16} /></a>
    </p>
  </ReportSection>

  <ReportSection id="roadmap" title="Planned Adaptive Learning">
    <p data-fact="IN-06">Planned: personalized and adaptive learning based on TalentLEAP’s competency levels, not live yet.</p>
  </ReportSection>

  <ReportSection id="faq" title="Questions About the Platform">
    <Accordion items={faq} name="jr-faq" openFirst />
  </ReportSection>

  <aside class="jr__next" aria-label="Talk to us about JobReady">
    <h2 class="jr__nexttitle">Talk to Us About JobReady</h2>
    <p>A discovery session covers how JobReady fits your program. A platform grant helps CodersTrust roll out the remaining modules; details are shared in the discovery session.</p>
    <div class="jr__actions">
      <Button href={d.href} iconEnd="arrow-right">{d.label}</Button>
      <a class="link" href={f.href}>Discuss a Platform Grant for JobReady’s Next Stage</a>
      <!-- WP27: the one route for impact investors, beside the other next steps -->
      <a class="link" href={linkAttrs('/partner-with-us/investors/').href}>Backing the platform? See Investors</a>
    </div>
    <EmailFallback href={d.href} />
    <p class="jr__micro">{MICRO_COMMITMENT}</p>
  </aside>

</LongformLayout>

<script>
  import '../../../scripts/tablestack';
</script>

<style>
  .jr__why {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: minmax(0, 1fr);
  }
  .jr__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin: var(--space-lg) 0 0;
  }
  .jr__whystat {
    display: grid;
    gap: var(--stack-title);
    justify-items: start;
    align-content: start;
  }
  /* WP59 (cycle-31 review, GPT-6.1 Sol G1): the contract-scope note under the 30,000+, as Home and Governments print it (CONTRACT_TOTAL_NOTE), in the note type of the Governments tile */
  .jr__whynote {
    margin: 0;
    max-width: 44ch;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
    color: var(--on-surface-variant);
  }
  .jr__whyh {
    margin: 0;
    font-size: var(--fs-heading-m);
    line-height: var(--lh-heading-m);
    color: var(--secondary);
  }
  @media (min-width: 768px) {
    .jr__why {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .jr__table {
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
  }
  .jr__table table {
    width: 100%;
    min-width: 640px;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
  }
  .jr__table th,
  .jr__table td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
  }
  .jr__table thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
  }
  .jr__table tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
  }
  .jr__next {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    margin-top: var(--space-lg);
    padding: var(--space-lg) var(--space-gutter);
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-md);
  }
  .jr__next > :global(*) {
    margin: 0;
  }
  .jr__nexttitle {
    font-size: var(--fs-heading-2xl);
    line-height: var(--lh-heading-2xl);
    color: var(--secondary);
  }
  .jr__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
  .jr__micro {
    font-size: var(--fs-body-xs);
    color: var(--outline);
  }
  :global(.jr__sources) {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--outline-variant);
  }
</style>
