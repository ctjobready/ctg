---
import LongformLayout from '../../../layouts/LongformLayout.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import Badge from '../../../components/system/Badge.astro';
import Button from '../../../components/system/Button.astro';
import Icon from '../../../components/system/Icon.astro';
import FeatureCard from '../../../components/ui/FeatureCard.astro';
import FactStat from '../../../components/facts/FactStat.astro';
import StatusTag from '../../../components/system/StatusTag.astro';
import ReportSection from '../../../components/pages/impact/ReportSection.astro';
import Callout from '../../../components/pages/impact/Callout.astro';
import { articleNode, desc, title, fundingCta, discoveryCta } from '../../../components/pages/impact/page-utils';
import { fact } from '../../../data/facts';
import { MICRO_COMMITMENT } from '../../../data/copy';
import { faqItems, faqJsonLd } from '../../../lib/faq';
import { linkAttrs } from '../../../lib/url';

const path = '/our-model/jobready-platform/';
const JOBREADY = 'https://jobready.global/';
const description = desc('JobReady is CodersTrust’s digital education and employment platform, being built as an AI-native platform. Partner portals, CRM and AI chat are live.');
const faqIds = ['Q11'];
const jsonLd = [
  articleNode({ path, headline: 'JobReady: CodersTrust’s Digital Education and Employment Platform', description, datePublished: '2026-10-08', dateModified: '2026-10-14', author: 'CodersTrust', about: { '@type': 'Thing', name: 'JobReady Platform' } }),
  faqJsonLd('foundations', path, faqIds),
];
const faq = faqItems('foundations', faqIds);

type Status = 'Live' | 'Operating' | 'Pre-Launch' | 'Roadmap';
const tone: Record<Status, 'success' | 'info' | 'eyebrow' | 'sale'> = { Live: 'success', Operating: 'success', 'Pre-Launch': 'info', Roadmap: 'sale' };
const rows: { job: string; capability: string; status: Status; note: string }[] = [
  { job: 'Train', capability: 'Course storefront at jobready.global', status: 'Operating', note: 'CodersTrust’s course storefront operates at jobready.global.' },
  { job: 'Connect to Work and Supply Talent', capability: 'Employer and gig-work (Earn) marketplace', status: 'Pre-Launch', note: 'In pre-launch. Until it launches, placement support is provided by CodersTrust’s placement team, and marketplaces such as Upwork and Fiverr are also used.' },
  { job: 'Equip Institutions', capability: 'Partner portals', status: 'Live', note: 'Live today.' },
  // The register (IN-04) names these three as live without assigning them to one of the four jobs, so they share one row.
  { job: 'Across the Platform', capability: 'Marketing automation, CRM and AI chat', status: 'Live', note: 'Live as part of the staged rollout.' },
];
// Roadmap: only what the register names (IN-06: TalentLEAP is "the basis for AI-driven personalized and adaptive learning (roadmap)").
// Other AI modules (a tutor, a career coach, adaptive assessment, talent matching) are not registered and are not listed.
const roadmap = [
  { icon: 'route', title: 'Planned Personalized and Adaptive Learning', text: 'The platform is designed to personalize each learner’s path and to adapt learning as each learner moves through TalentLEAP’s competency levels.' },
];
const toc = [
  { id: 'jobs', label: 'Four jobs' },
  { id: 'status', label: 'Rollout status' },
  { id: 'why', label: 'Why JobReady' },
  { id: 'roadmap', label: 'Planned adaptive learning' },
  { id: 'faq', label: 'Questions' },
];
const f = fundingCta();
const d = discoveryCta();
---

<LongformLayout
  title={title('JobReady Platform')}
  heading="JobReady: CodersTrust’s Digital Education and Employment Platform"
  eyebrow="Our Model"
  lead="JobReady is CodersTrust’s digital education and employment platform, being built as an AI-native platform. Modules are rolling out in stages."
  description={description}
  path={path}
  updated="2026-10-14"
  toc={toc}
  breadcrumbs={[{ label: 'Our Model', href: '/our-model/' }, { label: 'JobReady Platform' }]}
  jsonLd={jsonLd}
>
  <ReportSection id="jobs" title="Four Jobs, One Platform">
    <p data-fact="IN-04">JobReady is built around four jobs. The table below says which capabilities are live today.</p>
    <div class="jr__cards">
      <FeatureCard icon="graduation-cap" title="Train" text="Trains youth through courses that prepare for industry certification." />
      <FeatureCard icon="briefcase" title="Connect to Work" text="Designed to connect learners to local, remote and global work." />
      <FeatureCard icon="users" title="Supply Talent" text="Designed to supply employers with job-ready talent." />
      <FeatureCard icon="landmark" title="Equip Institutions" text="Gives institutions a digital delivery platform." />
    </div>
  </ReportSection>

  <ReportSection id="status" title="Rollout Status">
    <p>Categories of capability and their status, as of this page’s last update.</p>
    <section class="jr__table" aria-label="Platform capabilities and status" tabindex="0" data-scroll data-stack>
      <table>
        <caption class="sr-only">Platform Capabilities and Their Rollout Status</caption>
        <thead><tr><th scope="col">Job</th><th scope="col">Capability</th><th scope="col">Status</th><th scope="col">Note</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.job}</th>
              <td data-label="Capability">{r.capability}</td>
              <td data-label="Status"><Badge tone={tone[r.status]}>{r.status}</Badge></td>
              <td data-label="Note">{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
    <Callout label="What Is Live Today">
      <p data-fact="IN-04">Partner portals, marketing automation, CRM and AI chat are live, and the course storefront operates. The employer and gig-work marketplace is in pre-launch, and the adaptive learning below is planned. AI chat is live; it is the only AI capability shown as live in the table above.</p>
    </Callout>
    <p><a class="link" href={JOBREADY} rel={linkAttrs(JOBREADY).rel}>Visit jobready.global<Icon name="arrow-up-right" size={16} /><span class="sr-only"> (opens jobready.global)</span></a></p>
  </ReportSection>

  <ReportSection id="why" title="Why JobReady">
    <p>JobReady builds on CodersTrust’s delivery record, its role with National University and its institutional reach.</p>
    <div class="jr__why">
      <div class="jr__whystat"><StatusTag status="Delivered" /><FactStat id="SC-01" /></div>
      <div class="jr__whystat"><FactStat id="SC-04" /></div>
      <div class="jr__whystat"><StatusTag status="Agreement" /><FactStat id="SC-06" /></div>
    </div>
  </ReportSection>

  <ReportSection id="roadmap" title="Planned Adaptive Learning">
    <p data-fact="IN-04 IN-06">JobReady is being built as an AI-native platform, with TalentLEAP as the basis for AI-driven personalized and adaptive learning. This is roadmap, described as what the platform is designed to do, and it is not live.</p>
    <div class="jr__cards jr__cards--roadmap" data-fact="IN-06">
      {roadmap.map((r) => (
        <FeatureCard icon={r.icon} title={r.title} text={r.text}>
          <Badge tone="sale">Roadmap</Badge>
        </FeatureCard>
      ))}
    </div>
  </ReportSection>

  <ReportSection id="faq" title="Questions About the Platform">
    <Accordion items={faq} name="jr-faq" openFirst />
  </ReportSection>

  <aside class="jr__next" aria-label="Talk to us about JobReady">
    <h2 class="jr__nexttitle">Talk to Us About JobReady.</h2>
    <p>A discovery session covers how JobReady fits your program. A platform grant helps CodersTrust roll out the remaining modules; details are shared in the introductory call.</p>
    <div class="jr__actions">
      <Button href={d.href} iconEnd="arrow-right">{d.label}</Button>
      <a class="link" href={f.href}>Discuss a Platform Grant for JobReady’s Next Stage</a>
      <a class="link" href={JOBREADY} rel={linkAttrs(JOBREADY).rel}>Visit jobready.global<Icon name="arrow-up-right" size={16} /><span class="sr-only"> (opens jobready.global)</span></a>
      <a class="link" href={linkAttrs('/investors/').href}>For Investors<Icon name="arrow-right" size={16} /></a>
    </div>
    <p class="jr__micro">{MICRO_COMMITMENT} <a class="link" href={linkAttrs('/our-model/talentleap/').href}>How TalentLEAP Works</a></p>
  </aside>

</LongformLayout>

<script>
  import '../../../scripts/tablestack';
</script>

<style>
  /* Four cards: 1 across on a phone, 2 × 2 on a tablet, 4 across from 1024 px (never 3 + 1). */
  .jr__cards {
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 560px) {
    .jr__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .jr__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .jr__why {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: minmax(0, 1fr);
  }
  .jr__whystat {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    align-content: start;
  }
  @media (min-width: 768px) {
    .jr__why {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .jr__table {
    overflow-x: auto;
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-default);
  }
  .jr__table table {
    width: 100%;
    min-width: 640px;
    font-size: var(--fs-body-xs);
    line-height: var(--lh-body-xs);
  }
  .jr__table th,
  .jr__table td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--outline-variant);
  }
  .jr__table thead th {
    background: var(--surface-container-low);
    color: var(--secondary);
  }
  .jr__table tbody th {
    color: var(--on-surface);
    font-weight: var(--fw-medium);
  }
  .jr__next {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    margin-top: var(--space-lg);
    padding: var(--space-lg) var(--space-gutter);
    background: var(--surface-container-low);
    border: 1px solid var(--primary-fixed);
    border-radius: var(--radius-md);
  }
  .jr__next > :global(*) {
    margin: 0;
  }
  .jr__nexttitle {
    font-size: var(--fs-heading-2xl);
    line-height: var(--lh-heading-2xl);
    color: var(--secondary);
  }
  .jr__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
  .jr__micro {
    font-size: var(--fs-body-xs);
    color: var(--outline);
  }
  :global(.jr__sources) {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--outline-variant);
  }
</style>
