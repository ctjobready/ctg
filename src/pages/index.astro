---
// P1 Home (doc 06 P1, CMF C1 → C14). Section order is fixed by the spec; rhythm between light, Airy Blue,
// Ice Cyan, Klein and Deep Ink bands is set with the page-local <Tone> wrapper (never two dark bands in a row).
import LandingLayout from '../layouts/LandingLayout.astro';
import HeroSlider from '../components/sections/HeroSlider.astro';
import HomeHero from '../components/pages/home/HomeHero.astro';
import HomeRecognition from '../components/pages/home/HomeRecognition.astro';
import LearnerVoice from '../components/pages/impact/LearnerVoice.astro';
import DefinitionBand from '../components/sections/DefinitionBand.astro';
import ProblemBand from '../components/sections/ProblemBand.astro';
import FutureBand from '../components/sections/FutureBand.astro';
import EvidenceBand from '../components/pages/home/EvidenceBand.astro';
import CaseStudyCarousel from '../components/sections/CaseStudyCarousel.astro';
import NewsTeaserBand from '../components/sections/NewsTeaserBand.astro';
import FeaturesTable from '../components/sections/FeaturesTable.astro';
import FAQBand from '../components/sections/FAQBand.astro';
import ComparisonBand from '../components/sections/ComparisonBand.astro';
import RiskReversalBand from '../components/sections/RiskReversalBand.astro';
import CTABand from '../components/ui/CTABand.astro';
import Section from '../components/ui/Section.astro';
import Tone from '../components/pages/home/Tone.astro';
import HomeRouter from '../components/pages/home/HomeRouter.astro';
import HomeCost from '../components/pages/home/HomeCost.astro';
import HomeGuide from '../components/pages/home/HomeGuide.astro';
import HomeMechanism from '../components/pages/home/HomeMechanism.astro';
import Icon from '../components/system/Icon.astro';
import EvidenceLadderCompact from '../components/pages/impact/EvidenceLadderCompact.astro';
import FeatureSteps from '../components/pages/home/FeatureSteps.astro';
import HomeOffer from '../components/pages/home/HomeOffer.astro';
import ConversionNextSteps from '../components/pages/home/ConversionNextSteps.astro';
import { caseStudyItems } from '../components/pages/home/caseStudies';
import { futurePhotos } from '../data/photos';
import { HOME_SLIDES } from '../data/heroSlides';
import GainsPains from '../components/pages/partners/GainsPains.astro';
import { BACKWARD_PLAN, C14, FUNDER_PAINS, HOME_META, MICRO_COMMITMENT, POSITIONING, PRICING, SCORECARD, painForList, painForRow } from '../data/copy';
import { fact } from '../data/facts';
import { endSentence, expandSsc } from '../components/sections/copyText';
import { cta } from '../lib/mailto';
import { faqJsonLd } from '../lib/faq';
import { webPage } from '../lib/schema';

const discovery = cta('discovery');
// Q2 (national scale), Q7 (speed) and Q8 (cost) are not asked here: the offer band states the scale and the pricing, and the call to action states the timing, each once (WP17).
const FAQ_IDS = ['Q1', 'Q15', 'Q3', 'Q5'];
// The pricing explainer without its AI-ready curriculum sentence, which FAQ Q5 states once on this page.
const pricing = { ...PRICING, text: PRICING.text.replace(/ AI-ready curriculum: each track.*$/, '') };
if (pricing.text === PRICING.text) throw new Error('index: PRICING no longer ends with the AI-ready curriculum sentence');
// WP19, item 20: the why-now line of the closing band is PX-06's first clause, in the register's own words.
const px06 = fact('PX-06').text;
const whyNow = endSentence(px06.slice(0, px06.indexOf(', and image-creation')));
if (!whyNow.startsWith('Within eight months of ChatGPT')) throw new Error('index: PX-06 no longer opens with the ChatGPT clause the closing band quotes');
const jsonLd = [webPage({ path: '/', name: HOME_META.title, description: HOME_META.description }), faqJsonLd('home', '/', FAQ_IDS)];

// C2 BLUF: PX-01 + PX-03 in one sentence, built from the register's wording (never retyped).
// WP19, item 10: two plain sentences (it was one of about 55 words), and the 62 million population is labelled the same way here and on its tile (PX-01).
const problemBluf = `${endSentence(fact('PX-01').text)} ${endSentence(expandSsc(fact('PX-03').text))}`;

// C2b / C8 (review round 14, M4): the three ranked pains (FUNDER_PAINS) and one C8 row for each, pain → how we relieve it → the registered
// feature behind it. The regional FactCards stay in C2 as context; they are not the pains. Rows without a pain are gain creators.
// Numbers inside feature rows come from the register.
const hours = fact('PD-01').stat?.value;
const featureRows = [
  {
    ...painForRow(FUNDER_PAINS, 'P1'),
    feature: 'Placement Support, Three Months of Milestone-Based Mentoring and a Work-Entry Plan per Track Approved Before Enrollment',
    means: 'Learners get structured support from first profile to first client, and are matched to local, remote and global work.',
    outcome: 'A Path to First Paid Work',
    facts: ['PD-15', 'PD-01', 'PD-19'],
  },
  {
    ...painForRow(FUNDER_PAINS, 'P2'),
    feature: 'Monthly Reports, Tracer Surveys at 3, 6 and 12 Months and Documentary Evidence of Earnings',
    means: 'You see enrollment, completion, placements and first earnings month by month, and can check results against documentary evidence where available, such as payslips, offer letters, platform logs or bank receipts.',
    outcome: 'Results You Can Check',
    facts: ['PD-08', 'PD-09'],
  },
  {
    ...painForRow(FUNDER_PAINS, 'P3'),
    feature: 'An AI-Ready Curriculum, with Entry-Level Tracks Chosen from Employer Demand',
    means: 'Courses keep pace with employer demand as AI changes entry-level tasks.',
    outcome: 'Tracks That Follow What Employers Ask For',
    facts: ['PD-02', 'PD-10'],
  },
  { feature: 'Accessible Readiness Assessment', means: 'Applicants are routed to a career or foundation track that fits them.', outcome: 'The Right Career or Foundation Track' },
  { feature: `${hours} Training Hours per Certification, with Hands-on Labs`, means: 'Learners practice on real tasks, not only lectures.', outcome: 'An Employer-Ready Portfolio' },
  { feature: 'Certification Exam Preparation (Exam Fee Included)', means: 'Each track prepares learners for an industry certification.', outcome: 'A Supported Route to a Recognized Credential' },
];
---

<LandingLayout title={HOME_META.title} titleSuffix={false} description={HOME_META.description} jsonLd={jsonLd} stickyCta={{ label: discovery.label, href: discovery.href }}>
  <Tone cmf="C1"><HomeHero id="hero" /></Tone>
  <!-- WP19, item 6: "What Is CodersTrust?" sits directly under the hero, before the Results and Programs carousel. -->
  <Tone cmf="GEO"><DefinitionBand id="definition" /></Tone>
  <Tone cmf="RESULTS">
    <HeroSlider id="results" label="Results and Programs" heading="Results and Programs" slides={HOME_SLIDES} />
  </Tone>

  <Tone cmf="ROUTER"><HomeRouter id="router" /></Tone>

  <Tone cmf="C2">
    <ProblemBand id="problem" title="For Too Many Graduates, a Degree Is Not Turning into a Job." bluf={problemBluf} factIds={['PX-01', 'PX-02', 'PX-03']}>
      <GainsPains slot="lead" painsHeading="What Gets in the Way" pains={FUNDER_PAINS.map(painForList)} />
    </ProblemBand>
  </Tone>

  <Tone cmf="C3">
    <HomeCost
      id="cost"
      title="Every Year of Waiting Costs a Cohort."
      blocks={[
        { icon: 'cpu', claim: 'Automation-Prone Freelance Postings Fell After ChatGPT', factId: 'PX-06', implication: 'Tracks have to follow current employer demand, not last year’s job market.' },
        { icon: 'users', claim: 'Most Employers Report Difficulty Finding Talent', factId: 'PX-05', implication: 'Delaying updates to tracks and work-entry support risks preparing learners for yesterday’s demand.' },
        { icon: 'trending-down', claim: 'Only Three of Nine Training Trials Showed an Employment Impact', factId: 'RC-06', implication: 'Without outcome tracking, funders cannot tell which programs reach earnings.' },
      ]}
      after="A first cohort can show who is earning, and you decide on the evidence."
    />
  </Tone>

  <!-- WP19, item 6 of the home order: credibility (the guide) comes before the vision (the next 12 months). Home only. -->
  <Tone cmf="C5" tone="white"><HomeGuide id="guide" /></Tone>

  <Tone cmf="C4" tone="airy">
    <FutureBand
      photos={futurePhotos('home')}
      id="future"
      title="Imagine the Next 12 Months."
      lead="Three illustrative scenarios, not case studies."
      vignettes={[
        { kind: 'Functional', title: 'A First Foreign Client, Billed from Home', text: 'You hear from a young woman outside Dhaka who invoices her first foreign client from her own laptop.' },
        { kind: 'Emotional', title: 'First Earnings, Not Just Certificates', text: 'You review monthly reports showing who is earning, not only who completed.' },
        { kind: 'Social', title: 'AI-Ready Talent', text: 'Employers hire AI-ready talent from your cohort, including completers prepared for an industry certification exam, without a long search.' },
      ]}
    />
  </Tone>

  <Tone cmf="C6"><HomeMechanism id="mechanism" title="One Path from Learning to Earning" tone="white" positioning={POSITIONING.home} ribbonLine="TalentLEAP carries each learner through these stages: we train, mentor, place and track." link={{ label: 'How Our Model Works', href: '/our-model/' }} /></Tone>

  <!-- WP19, item 8: the "At a Glance" band is gone. Every tile in it restated the hero strip or the carousel above, so no headline number appears more than twice. -->
  <Tone cmf="C7">
    <EvidenceBand
      id="proof-band"
      title="Trial and Survey Evidence"
      bandHeading="Trial and Survey Evidence"
      trialHeading="An Independent Randomized Trial"
      headlineFact="RC-01"
      chart="trial"
      chip={false}
      plainLine
      lead="Trial figures are for a predecessor program. Survey figures are among surveyed completers, from the October 2026 survey."
      statIds={[]}
      surveyStatIds={['OC-02']}
      links={[
        { label: 'Outcomes 2026', href: '/impact/outcomes-2026/' },
        { label: 'The Randomized Trial', href: '/impact/independent-evaluation/' },
      ]}
    >
      <EvidenceLadderCompact slot="ladder" />
    </EvidenceBand>
  </Tone>

  <Tone cmf="C7" join>
    <CaseStudyCarousel id="cases" title="Proof in Practice" lead="Three programs, with their partners." items={caseStudyItems} />
    <p class="proof__discuss"><a class="link" href={discovery.href}>Discuss the Evidence for Your Program<Icon name="arrow-right" size={16} /></a></p>
    <LearnerVoice story="maria-dewan" excerpt="She showed her skills by winning a company logo design on Freelancer.com, and thus began her journey of earning on her own." outcome="She won a company logo design on Freelancer.com, then took on more clients." program="Her Power" tone="airy" />
  </Tone>

  <Tone cmf="RECOGNITION"><HomeRecognition id="recognition" /></Tone>

  <Tone cmf="C8" tone="airy" join>
    <FeaturesTable id="features" title="What Your Partnership Includes" rows={featureRows} concernLabel="Funder Concern Addressed" />
    <FeatureSteps />
  </Tone>

  <Tone cmf="C9" tone="white">
    <FAQBand id="faq" audience="home" ids={FAQ_IDS} title="Questions Partners Ask" allLink={{ label: 'All Partner FAQs', href: '/partner-with-us/#faqs' }} />
  </Tone>

  <Tone cmf="C10" tone="ice"><ComparisonBand id="compare" title="Compare the Approaches." withoutDoingNothing onlyRows={['Mentoring', 'Work Entry', 'Outcome Tracking', 'Independent Evidence']} dropColumns={['Conventional Skills Programs']} note="Compare these approaches with your current program on track choice, mentoring, work-entry support and outcome tracking." /></Tone>

  <Tone cmf="C11"><HomeOffer id="offer" pricing={pricing} lead="Use the discovery session to choose a starting scope for your goals, country and delivery capacity. The options below are program sizes, not a commitment required to begin the conversation." /></Tone>

  <Tone cmf="C12" tone="airy"><RiskReversalBand id="risk" title="Start with a Multi-Cohort Pilot. Decide on Evidence." lead={SCORECARD.text} /></Tone>

  <Tone cmf="C13">
    <CTABand
      id="cta"
      tone="klein"
      heading="Let’s Design Your First Cohort."
      text={whyNow}
      plan={{ heading: 'Planning a Grant-Funded Cohort?', text: BACKWARD_PLAN.text }}
      cta={{ label: discovery.label, href: discovery.href }}
      secondary={{ label: 'Read the evidence', href: '/impact/' }}
      micro={MICRO_COMMITMENT}
    />
  </Tone>

  <Tone cmf="C14">
    <!-- The 6–8 week start is stated in the C13 plan line and in the "First cohort" step only (doc 04 §4, one statement per fact): no PD-04 timing line, no reminder. The micro-commitment is stated once, in C13. -->
    <ConversionNextSteps id="next-steps" title="What Happens After You Contact Us" lead="Here is what follows your inquiry, from the first conversation to the first cohort." timing={false} firstAction={C14.firstAction} />
  </Tone>

  <Tone cmf="NEWS"><NewsTeaserBand id="news" /></Tone>

</LandingLayout>

<style>
  .proof__discuss {
    margin: var(--space-lg) auto 0;
    padding-inline: var(--space-gutter);
    max-width: var(--container-max, 1200px);
    text-align: center;
  }
</style>
