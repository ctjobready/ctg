---
// P1 Home (doc 06 P1, CMF C1 → C14). Section order is fixed by the spec; rhythm between light, Airy Blue,
// Ice Cyan, Klein and Deep Ink bands is set with the page-local <Tone> wrapper (never two dark bands in a row).
// WP30c (owner direction 2026-10-14, "less is more"): the page is the hook for an intro call. Every band keeps its CMF place but states its point once:
// no methodology asides, no repeated explanations, no stat shown twice, FAQ answers of one to three sentences.
import LandingLayout from '../layouts/LandingLayout.astro';
import HeroSlider from '../components/sections/HeroSlider.astro';
import HomeHero from '../components/pages/home/HomeHero.astro';
import HomeRecognition from '../components/pages/home/HomeRecognition.astro';
import LearnerJourneys from '../components/pages/home/LearnerJourneys.astro';
import DefinitionBand from '../components/sections/DefinitionBand.astro';
import ProblemBand from '../components/sections/ProblemBand.astro';
import FutureBand from '../components/sections/FutureBand.astro';
import HomeEvidence from '../components/pages/home/HomeEvidence.astro';
import CaseStudyCarousel from '../components/sections/CaseStudyCarousel.astro';
import FeaturesTable from '../components/sections/FeaturesTable.astro';
import FAQBand from '../components/sections/FAQBand.astro';
import ComparisonBand from '../components/sections/ComparisonBand.astro';
import RiskReversalBand from '../components/sections/RiskReversalBand.astro';
import CTABand from '../components/ui/CTABand.astro';
import Tone from '../components/pages/home/Tone.astro';
import HomeRouter from '../components/pages/home/HomeRouter.astro';
import HomeCost from '../components/pages/home/HomeCost.astro';
import HomeGuide from '../components/pages/home/HomeGuide.astro';
import HomeMechanism from '../components/pages/home/HomeMechanism.astro';
import Icon from '../components/system/Icon.astro';
import HomeOffer from '../components/pages/home/HomeOffer.astro';
import ConversionNextSteps from '../components/pages/home/ConversionNextSteps.astro';
import { caseStudyItems } from '../components/pages/home/caseStudies';
import { grantStartTitles } from '../components/pages/partners/partners';
import { futurePhotos } from '../data/photos';
import { HOME_SLIDES } from '../data/heroSlides';
import GainsPains from '../components/pages/partners/GainsPains.astro';
import { BACKWARD_PLAN, C14, FUNDER_PAINS, HOME_META, MICRO_COMMITMENT, POSITIONING, PROGRAM_SIZES_NOTE, painForList, painForRow } from '../data/copy';
import { fact } from '../data/facts';
import { cta } from '../lib/mailto';
import { linkAttrs } from '../lib/url';
import { faqJsonLd } from '../lib/faq';
import { webPage } from '../lib/schema';

const discovery = cta('discovery');
const caseStudies = linkAttrs('/impact/case-studies/');
// Q2 (national scale), Q7 (speed) and Q8 (cost) are not asked here: the offer band states the scale and the pricing, and the call to action states the timing, each once (WP17).
// WP30c: three questions, the ones a funder decides on (the country, the trial's scope, the proof); the AI question is answered by the cost-of-waiting band and the curriculum row.
const FAQ_IDS = ['Q1', 'Q15', 'Q3'];
const jsonLd = [webPage({ path: '/', name: HOME_META.title, description: HOME_META.description }), faqJsonLd('home', '/', FAQ_IDS)];
// The other two funder routes sit beside the single discovery button as text links (PRD: one primary button per view).
const briefing = cta('briefing');
const introduction = cta('investor');

// C2 BLUF (WP30c): one plain sentence. The 62 million and 19M+ figures are the two cards under it, so the sentence does not state them a second time.
const problemBluf = 'Millions of educated young people are out of work and out of training, and training budgets rarely show who starts earning.';

// C8: the three ranked pains (FUNDER_PAINS) and one C8 row for each, pain → how we relieve it → the registered feature behind it. Numbers inside feature rows come from the register.
// WP30c: only the three rows that answer a ranked pain stay; the accessible readiness assessment, the 100 training hours and the exam preparation are stated in the program options and the comparison.
const hours = fact('PD-01').stat?.value;
// The comparison's "Independent Evidence" cell on Home (WP31): the trial in one clause, the predecessor program's length read from RC-07 (not retyped).
const trialHours = /was (\d+) hours/.exec(fact('RC-07').text)?.[1];
if (!trialHours) throw new Error('Home: RC-07 no longer reads "... was N hours"');
const independentEvidence = `One randomized trial of a predecessor program (${trialHours} hours, women in Dhaka); independent evaluation of your cohort welcome.`;
const featureRows = [
  {
    ...painForRow(FUNDER_PAINS, 'P1'),
    // WP23, item 5: placement support, not matching, toward local, remote and global work.
    feature: 'Placement Support and Three Months of Milestone-Based Mentoring',
    means: `${hours} training hours per certification; each track’s work-entry plan is approved before enrollment.`,
    outcome: 'A path to first paid work',
    facts: ['PD-15', 'PD-01', 'PD-19'],
  },
  {
    ...painForRow(FUNDER_PAINS, 'P2'),
    // WP28: scoped like the FAQ and the comparison ("as agreed in the program scope"; documentary evidence "where available"), not an unscoped inclusion.
    feature: 'Monthly Reports and Follow-Up Surveys, as Agreed in the Program Scope',
    means: 'You see enrollment, completion, placements and first earnings month by month, and can check results against documentary evidence where available.',
    outcome: 'Results you can check',
    facts: ['PD-08', 'PD-09'],
  },
  {
    ...painForRow(FUNDER_PAINS, 'P3'),
    feature: 'An AI-Ready Curriculum, with Entry-Level Tracks Chosen from Employer Demand',
    means: 'Courses are designed to keep pace with employer demand as AI changes entry-level tasks.',
    outcome: 'Tracks that follow what employers ask for',
    facts: ['PD-02', 'PD-10'],
  },
];
---

<LandingLayout title={HOME_META.title} titleSuffix={false} description={HOME_META.description} jsonLd={jsonLd} stickyCta={{ label: discovery.label, href: discovery.href }}>
  <Tone cmf="C1"><HomeHero id="hero" /></Tone>
  <!-- WP19, item 6: "What Is CodersTrust?" sits directly under the hero, before the Results and Programs carousel. -->
  <Tone cmf="GEO"><DefinitionBand id="definition" /></Tone>
  <Tone cmf="RESULTS">
    <HeroSlider id="results" label="Results and Programs" heading="Results and Programs" intro="Evidence first, then our programs." slides={HOME_SLIDES} />
  </Tone>

  <Tone cmf="C2">
    <ProblemBand id="problem" title="Education Is Not Turning into Jobs" bluf={problemBluf} factIds={['PX-01', 'PX-02']}>
      <GainsPains slot="lead" painsHeading="What Gets in the Way" pains={FUNDER_PAINS.map(painForList)} />
    </ProblemBand>
  </Tone>

  <Tone cmf="C3">
    <HomeCost
      id="cost"
      title="Training and Evidence Fall Behind While You Wait"
      blocks={[
        { icon: 'cpu', claim: 'Automation-Prone Freelance Postings Fell After ChatGPT', factId: 'PX-06', implication: 'Training has to follow current employer demand, not last year’s job market.' },
        { icon: 'trending-down', claim: 'Only Three of Nine Training Trials Showed a Significant Employment Impact', factId: 'RC-06', implication: 'Without outcome tracking, funders cannot tell which programs reach earnings.' },
      ]}
      after="A first cohort can show who is earning, and you decide on the evidence."
    />
  </Tone>

  <!-- WP19, item 6 of the home order: credibility (the guide) comes before the vision (the next 12 months). Home only. -->
  <Tone cmf="C5" tone="white"><HomeGuide id="guide" /></Tone>

  <Tone cmf="C4" tone="airy">
    <FutureBand
      photos={futurePhotos('home')}
      id="future"
      title="Imagine the Next 12 Months"
      lead="Three illustrative scenarios, not case studies."
      vignettes={[
        { kind: 'Functional', title: 'A First Foreign Client, Billed from Home', text: 'You hear from a young woman who invoices her first foreign client from her own laptop.' },
        { kind: 'Emotional', title: 'First Earnings, Not Just Certificates', text: 'You review monthly reports showing who is earning, not only who completed.' },
        { kind: 'Social', title: 'AI-Ready Talent', text: 'You see employers hire AI-ready talent from your cohort, including completers prepared for an industry certification exam.' },
      ]}
    />
  </Tone>

  <Tone cmf="C6"><HomeMechanism id="mechanism" title="One Path from Learning to Earning" tone="white" positioning={POSITIONING.home} link={{ label: 'How Our Model Works', href: '/our-model/' }} /></Tone>

  <!-- WP19, item 8: the "At a Glance" band is gone. WP25h: the band no longer retells the trial and the survey (the carousel states them). WP35 (cycle-12 review): nor the trial at all (the hero card and the first slide state it); the band keeps the paid-work pathways beside the 72.3% no-prior-income result (34 of 47), and a text link to the trial's results sits with the survey link. -->
  <Tone cmf="C7">
    <HomeEvidence
      id="proof-band"
      title="Evidence You Can Check"
      links={[
        { label: 'Read the Trial Results', href: '/impact/independent-evaluation/' },
        { label: 'Impact Survey 2026', href: '/impact/outcomes-2026/' },
      ]}
    />
  </Tone>

  <Tone cmf="C7" join>
    <!-- WP37 (cycle-14 review): slide 3 of the results carousel states the Kosovo and Her Power figures, so those two cards show delivery context instead (caseStudyItems); the WSDFM card keeps its figure. -->
    <CaseStudyCarousel id="cases" title="Proof in Practice" items={caseStudyItems}>
      <a slot="more" class="link" href={caseStudies.href}>See All Four Case Studies<Icon name="arrow-right" size={16} /></a>
    </CaseStudyCarousel>
    <!-- WP25h (benchmark review): three registered learner stories, one from each program above, replace the single Her Power learner voice (Maria Dewan is one of the three). -->
    <LearnerJourneys id="journeys" tone="airy" />
  </Tone>

  <Tone cmf="RECOGNITION"><HomeRecognition id="recognition" /></Tone>

  <Tone cmf="C8" tone="airy" join>
    <FeaturesTable id="features" title="What Your Partnership Includes" rows={featureRows} concernLabel="Funder Concern Addressed" />
  </Tone>

  <Tone cmf="C9" tone="white">
    <FAQBand id="faq" audience="home" ids={FAQ_IDS} title="Questions Partners Ask" allLink={{ label: 'All Partner FAQs', href: '/partner-with-us/#faqs' }} />
  </Tone>

  <Tone cmf="C10" tone="ice"><ComparisonBand id="compare" title="How the Approaches Compare" lead="What each approach typically includes." withoutDoingNothing onlyRows={['Mentoring', 'Work Entry', 'Outcome Tracking', 'Independent Evidence']} dropColumns={['Conventional Skills Programs', 'Freelance Marketplaces Alone']} ownCells={{ 'Independent Evidence': independentEvidence }} /></Tone>

  <Tone cmf="C11"><HomeOffer id="offer" lead={PROGRAM_SIZES_NOTE} /></Tone>

  <Tone cmf="C12" tone="airy"><RiskReversalBand id="risk" title="Start with a Multi-Cohort Pilot, Then Decide on Evidence" /></Tone>

  <!-- WP23, item 3: the role router sits just before the closing call to action (the hero's audience links and the menu route earlier). -->
  <Tone cmf="ROUTER" tone="white"><HomeRouter id="router" /></Tone>

  <Tone cmf="C13">
    <CTABand
      id="cta"
      tone="klein"
      heading="Let’s Design Your First Cohort"
      plan={{ heading: 'Planning a Grant-Funded Cohort?', text: BACKWARD_PLAN.text }}
      cta={{ label: discovery.label, href: discovery.href }}
      secondary={{ label: 'Read the evidence', href: '/impact/' }}
      routes={[
        { audience: 'Governments', label: briefing.label, href: briefing.href },
        { audience: 'Impact investors', label: introduction.label, href: introduction.href },
      ]}
      micro={MICRO_COMMITMENT}
    />
  </Tone>

  <Tone cmf="C14">
    <!-- The 6–8 week start is stated in the C13 plan line and in the "First cohort" step only (doc 04 §4, one statement per fact): no PD-04 timing line, no reminder. The micro-commitment is stated once, in C13. -->
    <!-- WP28: the week-by-week steps are labelled "For Grant-Funded Cohorts" (as on the hub), and one line names the audiences that get a route-specific next step. WP30c: the four steps are their headings alone (each names its week; the sentences under them restated the headings). -->
    <ConversionNextSteps
      id="next-steps"
      eyebrow="For Grant-Funded Cohorts"
      title="What Happens After You Contact Us"
      steps={grantStartTitles().map((title) => ({ title }))}
      timing={false}
      firstAction={C14.firstAction}
      otherRoutes={{
        audiences: [
          { label: 'Ministries', href: '/partner-with-us/governments/' },
          { label: 'employers', href: '/partner-with-us/employers/' },
          { label: 'impact investors', href: '/partner-with-us/investors/' },
        ],
        text: 'get a route-specific next step.',
      }}
    />
  </Tone>

  <!-- WP31 (cycle-8 review): the "Latest News" band (Bangladesh posts after the final call to action) is gone, so the page ends on its next steps. The News menu item stays. -->
</LandingLayout>

