---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Button from '../../components/system/Button.astro';
import Icon from '../../components/system/Icon.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PhotoGallery from '../../components/ui/PhotoGallery.astro';
import { galleryPhotos } from '../../data/photos';
import StepFlow from '../../components/ui/StepFlow.astro';
import Img from '../../components/ui/Img.astro';
import FactStat from '../../components/facts/FactStat.astro';
import RoleGrid from '../../components/pages/careers/RoleGrid.astro';
import { allRoles } from '../../components/pages/careers/careers';
import { cta } from '../../lib/mailto';
import { CAREERS_EMAIL } from '../../lib/site';
import { webPage } from '../../lib/schema';
import falgun from '../../assets/images/pages/about/careers-team-falgun-celebration.jpg';
import picnic from '../../assets/images/pages/about/careers-team-picnic.jpg';

const apply = cta('careers');
const roles = await allRoles();
// WP104 (Sonnet High run 1): the description names the full group ("educated, unemployed and underemployed young people"), in 152 characters: "How we work" and "a ... route" went to make room (WP63 had kept the short group, 172 characters with the full one).
// WP166-A (marketing review R7-39): the last sentence says what to do in American usage ("speculative applications" is British), as the page now asks for a resume.
// WP168-A (owner decision of 24 November 2026): the roles of the previous site are open, so the last sentence points to them (it read "Send your resume for when a role opens.").
const description = 'Join CodersTrust and help prepare educated, unemployed and underemployed young people for paid digital work. See our open roles and apply.';
// WP168-A: the page's text changed on 24 November 2026 (the Open Roles band, the hero's second button, the application steps), so it pins its own dateModified.
const UPDATED = '2026-11-25'; // WP169 (owner answers of 2026-11-25): the Chief Revenue Officer role was added to the list and role texts changed. Earlier: WP168-A (2026-11-24)
const jsonLd = [webPage({ path: '/careers/', name: 'Careers at CodersTrust', description, dateModified: UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'Careers', path: '/careers/' }] })];
/*
 * WP166-A (marketing review of 21 November 2026, R7):
 *   R7-19  the <title> is the page's H1 ("Careers: Help Put Young People into Paid Work | CodersTrust"), not the label "Careers".
 *   R7-25  the hero leads with the page's one distinctive line, moved verbatim from the "Work That Is Measured" card (which is gone), and the second line is a plain "no" followed by the next step; the button is
 *          "Send Your Resume" (src/data/ctas.ts).
 *   R7-26  the button is repeated directly after the three steps, where a reader who has read them looks for it, and the closing line gives the address in one short sentence.
 * WP168-A (owner decision of 24 November 2026: preserve the old site's job posts, all considered open, the redundant re-posts left out):
 *   the hero's "No open roles right now ..." line is gone; "See Open Roles" (to the band below) leads the hero's actions, with "Send Your Resume" beside it;
 *   the Open Roles band follows the hero (each role a card linking to /careers/<slug>/, filtered by the old site's job categories with a count each);
 *   the first two application steps no longer say a role has to open first.
 */
const expect = [
  { icon: 'users', title: 'Inclusive and Flexible', text: 'A diverse, inclusive and flexible workplace. We are active, socially responsible and open to new thinking.' },
  { icon: 'trophy', title: 'Wins Are Celebrated', text: 'Big or small, we celebrate the wins, because we know how hard the team works.' },
];
---

<BaseLayout title="Careers: Help Put Young People into Paid Work" description={description} breadcrumbs={[{ label: 'Careers' }]} jsonLd={jsonLd}>
  <Hero eyebrow="Careers" title="Help Put Young People into Paid Digital Work" lead="We judge youth-employment programs by whether young people end up working and earning, not by how many attended." artSeed="careers">
    <Fragment slot="actions">
      <Button href="#open-roles" iconEnd="arrow-down" data-see-roles>See Open Roles</Button>
      <Button href={apply.href} variant="secondary" icon="mail">{apply.label}</Button>
    </Fragment>
  </Hero>

  <Section id="open-roles" tone="airy" aria-labelledby="open-roles-h">
    <SectionHeader id="open-roles-h" eyebrow="Join Our Team" title="Open Roles" lead="Filter by category, then open a role to read it in full and apply." />
    <RoleGrid roles={roles} />
  </Section>

  <Section id="why" aria-labelledby="why-h">
    <SectionHeader id="why-h" eyebrow="Our Work" title="Why Join CodersTrust" />
    <div class="cr-stats">
      {['SC-01', 'SC-03', 'SC-11'].map((id) => <FactStat id={id} />)}
    </div>
  </Section>

  <Section id="how" tone="airy" aria-labelledby="how-h">
    <SectionHeader id="how-h" eyebrow="How We Work" title="What to Expect" />
    <div class="grid-cards grid-cards--stretch">
      {
        expect.map((e) => (
          <article class="card" data-reveal>
            <div class="card__body">
              <span class="cr-icon" aria-hidden="true"><Icon name={e.icon} size={22} /></span>
              <h3 class="card__title">{e.title}</h3>
              <p class="card__text">{e.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="team-photos" pad="sm" aria-label="The CodersTrust Bangladesh team">
    <div class="cr-photos">
      <figure data-reveal>
        <Img src={falgun} alt="The CodersTrust Bangladesh team gathered at the office entrance for a festival celebration" width={800} widths={[480, 800]} sizes="(min-width:900px) 580px, 100vw" assetId="careers-team-falgun" />
      </figure>
      <figure data-reveal>
        <Img src={picnic} alt="A group photo of the CodersTrust Bangladesh team outdoors at a company picnic" width={800} widths={[480, 800]} sizes="(min-width:900px) 580px, 100vw" assetId="careers-team-picnic" />
      </figure>
    </div>
  </Section>

  <PhotoGallery id="life" tone="white" eyebrow="Life at CodersTrust" title="Where We Work" lead="Our Dhaka country office and training labs. CodersTrust is headquartered in New York." photos={galleryPhotos('careers')} />

  <Section id="apply" tone="ice" aria-labelledby="apply-h">
    <SectionHeader id="apply-h" eyebrow="How to Apply" title="How Applications Work" lead="Applications go to the CodersTrust Bangladesh HR team." />
    <StepFlow steps={[
      { title: 'Your Application', text: 'Apply for an open role from its page, or send your resume and we keep it on file.' },
      { title: 'Application Review', text: 'We review the applications and invite shortlisted candidates to interview.' },
      { title: 'Employment Offer', text: 'The selected candidate receives an offer letter and package details.' },
    ]} />
    <p class="cr-apply"><Button href={apply.href} icon="mail">{apply.label}</Button></p>
    <p class="cr-mail">Or email your resume to <a href={apply.href}>{CAREERS_EMAIL}</a>.</p>
  </Section>

  <Section id="eoe" aria-labelledby="eoe-h">
    <SectionHeader id="eoe-h" eyebrow="Equal Opportunity" title="We Judge People on Merit" />
    <p class="cr-eoe">We believe every person is equal, and we judge people on their work and merit. Inclusion comes first in how we operate.</p>
  </Section>

</BaseLayout>

<style>
  .cr-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-gutter);
  }
  @media (min-width: 768px) {
    .cr-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cr-icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
  }
  .cr-photos {
    display: grid;
    gap: var(--space-gutter);
    margin-top: var(--space-lg);
  }
  .cr-photos figure {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .cr-photos :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 768px) {
    .cr-photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cr-roles {
    max-width: 46rem;
    height: auto;
  }
  .cr-apply {
    margin: var(--space-lg) 0 0;
  }
  .cr-mail {
    margin: var(--space-md) 0 0;
  }
  .cr-mail a {
    color: var(--primary);
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cr-eoe {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--on-surface-variant);
  }
</style>
