---
// P16–P17 — NU PGD course pages /nu-postgraduate-diploma/digital-marketing/ and /ict/ (T10), generated from the
// `nu-pgd` collection (kind: course). One H1 (the course name). Duration, fee, mode, eligibility, award and
// internship terms are withheld until NU and CodersTrust approve the admissions fact set; no `Offer` in JSON-LD.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/system/Hero.astro';
import Button from '../../components/system/Button.astro';
import Icon from '../../components/system/Icon.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Sources from '../../components/facts/Sources.astro';
import CopyP from '../../components/pages/programs/CopyP.astro';
import PhaseList from '../../components/pages/programs/PhaseList.astro';
import FaqSection from '../../components/pages/programs/FaqSection.astro';
import { anchor, faqNode, para, type FaqSource } from '../../components/pages/programs/faq';
import { PAGE_UPDATED } from '../../components/pages/programs/meta';
import { NU_APPLY, NU_CALL, NU_COURSE_COPY, NU_NAME, NU_PATH, nuCourses, nuOverview } from '../../components/pages/programs/nuPgd';
import { SURVEY_EMPLOYMENT } from '../../data/copy';
import { COURSES_URL } from '../../lib/site';
import { formatDate, isoDate } from '../../lib/format';
import { ORG_ID, course as courseNode, ref, webPage } from '../../lib/schema';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const courses = await nuCourses();
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}
const { course: c } = Astro.props;
const slug = c.slug;
const copy = NU_COURSE_COPY[slug];
const path = `${NU_PATH}${slug}/`;
const overview = await nuOverview();
const apply = { label: NU_APPLY.label, href: overview.data.applyUrl };
const LAST_UPDATED = PAGE_UPDATED.nuCourse;

const faqSources: FaqSource[] = [
  { q: 'Where do I find fees, schedule and eligibility?', html: `Fees, schedule, eligibility and recognition are confirmed with admissions before you apply. ${anchor(NU_CALL.href, NU_CALL.label)} to ask.` },
  ...c.faqs.map((f) => ({ q: f.q, html: para(f.a) })),
  { q: 'Is this the right course for me?', html: `Right for you if you hold a degree and want a digital career. Not right if you want a short self-paced course: see ${anchor(COURSES_URL, 'JobReady.global')}.` },
];

const jsonLd = [
  webPage({ path, name: c.title, description: copy.description, dateModified: LAST_UPDATED, breadcrumb: [{ name: 'Home', path: '/' }, { name: 'NU Postgraduate Diploma', path: NU_PATH }, { name: c.title, path }] }),
  {
    ...courseNode({ path, name: c.title, description: copy.description }),
    provider: [ref(ORG_ID), { '@type': 'EducationalOrganization', name: 'National University, Bangladesh', url: 'https://www.nu.ac.bd' }],
  },
  faqNode(faqSources, path),
];
---

<BaseLayout title={copy.titleTag} description={copy.description} path={path} breadcrumbs={[{ label: 'NU Postgraduate Diploma', href: NU_PATH }, { label: c.title }]} jsonLd={jsonLd}>
  <Hero eyebrow={NU_NAME} title={c.title} lead={copy.lead} artSeed={`nu-${slug}`}>
    <Fragment slot="actions">
      <Button href={apply.href} iconEnd="arrow-right">{apply.label}</Button>
      <Button variant="outline" href={NU_CALL.href} icon="phone">{NU_CALL.label}</Button>
    </Fragment>
  </Hero>

  <Section id="who" aria-labelledby="who-h">
    <SectionHeader id="who-h" eyebrow="Who it is for" title="For degree holders who want a digital career" lead="Right for you if you hold a degree and want to add practical digital skills. If you want a short self-paced course instead, see JobReady.global." />
    {
      c.roles.length > 0 && (
        <div class="roles" data-reveal>
          <h3 class="t-heading-l">Roles this diploma relates to</h3>
          <ul role="list">
            {c.roles.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      )
    }
  </Section>

  <Section id="curriculum" tone="airy" aria-labelledby="curriculum-h">
    <SectionHeader id="curriculum-h" eyebrow="Curriculum" title="What you study" lead="Modules, in order. The final module combines internship, project work and a seminar; internship arrangements are confirmed with admissions." />
    <PhaseList items={c.modules.map((m) => ({ title: m }))} cols={5} label={`${c.title} modules`} />
    <p class="mentors" data-reveal>Meet the people who teach and mentor at CodersTrust: <a class="link" href={url('/about/mentors/')}>Instructors and mentors<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <Section id="outcomes" aria-labelledby="outcomes-h">
    <SectionHeader id="outcomes-h" eyebrow="Outcomes" title="What CodersTrust training has achieved" lead="These results come from CodersTrust’s wider training programs, not from this diploma." />
    <CopyP block={SURVEY_EMPLOYMENT} class="outcome-note" />
    <p class="outcome-link"><a class="link" href={url('/impact/outcomes-2026/')}>Read the full findings<Icon name="arrow-right" size={16} /></a></p>
  </Section>

  <FaqSection sources={faqSources} title="Questions about this course" />

  <CTABand id="cta" heading={`Apply for the ${c.title}.`} cta={apply} secondary={NU_CALL} />

  <Section pad="sm" aria-label="Notes and sources">
    <p class="updated">Last updated <time datetime={isoDate(LAST_UPDATED)}>{formatDate(LAST_UPDATED)}</time></p>
    <Sources />
  </Section>
</BaseLayout>

<style>
  .roles h3 {
    margin: 0 0 var(--space-sm);
    color: var(--secondary);
  }
  .roles ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .roles li {
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
    font-weight: var(--fw-medium);
    font-size: var(--fs-body-base);
  }
  .mentors {
    margin: var(--space-lg) 0 0;
    color: var(--on-surface-variant);
  }
  .outcome-note {
    margin: 0;
    max-width: 52rem;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    color: var(--on-surface);
  }
  .outcome-link {
    margin: var(--space-md) 0 0;
  }
  .updated {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-body-xs);
    color: var(--on-surface-variant);
  }
</style>
