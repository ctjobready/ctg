---
import BaseLayout from './BaseLayout.astro';
import Button from '../components/system/Button.astro';
import type { BaseLayoutProps } from '../lib/layout';

/**
 * T3 Landing (CMF): BaseLayout + optional sticky in-page CTA bar on mobile. The bar steps aside (and goes inert) while
 * the hero's primary CTA or an in-flow CTA band is in view, so a viewport region never holds two solid primaries
 * (src/scripts/stickycta.ts); without JavaScript it stays visible.
 */
interface Props extends BaseLayoutProps {
  stickyCta?: { label: string; href: string };
}
const { stickyCta, ...base } = Astro.props;
---

<BaseLayout {...base} bodyClass={[base.bodyClass, stickyCta && 'has-sticky-cta'].filter(Boolean).join(' ')}>
  <slot name="head" slot="head" />
  <slot />
  {
    stickyCta && (
      <div class="sticky-cta">
        <Button href={stickyCta.href} iconEnd="arrow-right">{stickyCta.label}</Button>
      </div>
    )
  }
</BaseLayout>

<script>
  // Self-guarding: does nothing on a page without the bar.
  import '../scripts/stickycta';
</script>

<style is:global>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 80;
    padding: var(--space-sm) var(--space-gutter) calc(var(--space-sm) + env(safe-area-inset-bottom));
    background: var(--surface);
    box-shadow: 0 -2px 8px color-mix(in srgb, var(--inverse-surface) 8%, transparent);
  }
  .sticky-cta .btn {
    width: 100%;
  }
  /* Stepped aside: out of sight and (with the inert attribute) out of the tab order. With JavaScript the bar starts
     hidden until the script has worked out whether a hero or band CTA is in view (no flash at load); without
     JavaScript none of these rules match and the bar stays visible. */
  .sticky-cta[data-hidden],
  html.js .sticky-cta:not([data-ready]) {
    visibility: hidden;
    transform: translateY(110%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sticky-cta[data-ready] {
      transition: transform var(--dur-base) var(--ease-standard), visibility 0s linear;
    }
    .sticky-cta[data-ready][data-hidden] {
      transition: transform var(--dur-base) var(--ease-standard), visibility 0s linear var(--dur-base);
    }
  }
  .has-sticky-cta {
    padding-bottom: 72px;
  }
  /* keep the back-to-top button clear of the bar */
  .has-sticky-cta .btt {
    bottom: calc(var(--space-gutter) + 64px);
  }
  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
    .has-sticky-cta {
      padding-bottom: 0;
    }
    .has-sticky-cta .btt {
      bottom: var(--space-gutter);
    }
  }
</style>
