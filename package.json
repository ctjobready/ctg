{
  "name": "ctg-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "node scripts/build-tokens.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-tokens.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:base": "node scripts/check-base-links.mjs",
    "check:facts": "node --experimental-strip-types scripts/check-facts.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "a11y": "node scripts/a11y-smoke.mjs",
    "test:html": "node scripts/check-html.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:budget": "node scripts/check-budget.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "test:content": "node scripts/check-content-rules.mjs",
    "test:static": "node -e \"const {spawnSync}=require('node:child_process');let failed=0;for(const c of ['html','links','budget','seo','content']){const r=spawnSync(process.execPath,['scripts/check-'+(c==='content'?'content-rules':c)+'.mjs'],{stdio:'inherit'});if(r.status!==0)failed++}console.log('\\ntest:static: '+(failed?failed+' of 5 checks failed':'all 5 checks passed'));process.exit(failed?1:0)\"",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.7",
    "lucide-static": "1.52.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "html-validate": "11.16.0",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "world-atlas": "2.0.2"
  }
}
